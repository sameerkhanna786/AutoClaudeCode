xcept (ValueError, IndexError):\n   254→                                pass\n   255→                        elif \"Pages free:\" in line:\n   256→                            try:\n   257→                                free_pages += int(line.split()[-1].rstrip(\".\"))\n   258→                            except (ValueError, IndexError):\n   259→                                pass\n   260→                        elif \"Pages speculative:\" in line or \"Pages purgeable:\" in line:\n   261→                            try:\n   262→                                free_pages += int(line.split()[-1].rstrip(\".\"))\n   263→                            except (ValueError, IndexError):\n   264→                                pass\n   265→                    available_mb = (free_pages * page_size) / (1024 * 1024)\n   266→            except (OSError, subprocess.TimeoutExpired):\n   267→                logger.debug(\"Could not run vm_stat, skipping memory check\")\n   268→                return\n   269→        else:\n   270→            logger.debug(\"Memory check not supported on %s\", system)\n   271→            return\n   272→\n   273→        if available_mb is None:\n   274→            logger.debug(\"Could not determine available memory, skipping check\")"}]},"parent_tool_use_id":null,"session_id":"34d76759-79c7-49b8-9000-bfaad6737f36","uuid":"01e3d0f6-4815-46ff-993f-09f9f39fa34a","tool_use_result":{"type":"text","file":{"filePath":"/Users/sameertkhanna/Documents/auto_claude_code/safety.py","content":"    def check_memory(self) -> None:\n        \"\"\"Ensure sufficient RAM is available.\n\n        Uses /proc/meminfo on Linux and vm_stat on macOS.\n        Skips the check gracefully on unsupported platforms.\n        \"\"\"\n        import platform\n        min_mb = self.config.safety.min_memory_mb\n        if min_mb <= 0:\n            return\n\n        available_mb: Optional[float] = None\n\n        system = platform.system()\n        if system == \"Linux\":\n            try:\n                with open(\"/proc/meminfo\", \"r\") as f:\n                    for line in f:\n                        if line.startswith(\"MemAvailable:\"):\n                            parts = line.split()\n                            available_mb = int(parts[1]) / 1024  # kB -> MB\n                            break\n            except (OSError, ValueError, IndexError):\n                logger.debug(\"Could not read /proc/meminfo, skipping memory check\")\n                return\n        elif system == \"Darwin\":\n            try:\n                import subprocess\n                result = subprocess.run(\n                    [\"vm_stat\"], capture_output=True, text=True, timeout=5,\n                )\n                if result.returncode == 0:\n                    page_size = 4096  # default macOS page size\n                    free_pages = 0\n                    for line in result.stdout.splitlines():\n                        if \"page size of\" in line:\n                            try:\n                                page_size = int(line.split()[-2])\n                            except (ValueError, IndexError):\n                                pass\n                        elif \"Pages free:\" in line:\n                            try:\n                                free_pages += int(line.split()[-1].rstrip(\".\"))\n                            except (ValueError, IndexError):\n                                pass\n                        elif \"Pages speculative:\" in line or \"Pages purgeable:\" in line:\n                            try:\n                                free_pages += int(line.split()[-1].rstrip(\".\"))\n                            except (ValueError, IndexError):\n                                pass\n                    available_mb = (free_pages * page_size) / (1024 * 1024)\n            except (OSError, subprocess.TimeoutExpired):\n                logger.debug(\"Could not run vm_stat, skipping memory check\")\n                return\n        else:\n            logger.debug(\"Memory check not supported on %s\", system)\n            return\n\n        if available_mb is None:\n            logger.debug(\"Could not determine available memory, skipping check\")","numLines":60,"startLine":215,"totalLines":546}}}
