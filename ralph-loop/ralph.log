{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_vrtx_01DV9VyuGPeNmCEACndwdjop","type":"tool_result","content":"     1→\"\"\"Safety guards: lock file, disk space, rate limits, protected files, failure counter.\"\"\"\n     2→\n     3→from __future__ import annotations\n     4→\n     5→import atexit\n     6→import fcntl\n     7→import logging\n     8→import os\n     9→import shutil\n    10→import time\n    11→from pathlib import Path\n    12→from typing import List, Optional\n    13→\n    14→from config_schema import Config\n    15→from state import StateManager\n    16→\n    17→logger = logging.getLogger(__name__)\n    18→\n    19→# Module-level list of SafetyGuard instances that hold locks, for atexit cleanup.\n    20→_active_guards: List[SafetyGuard] = []\n    21→\n    22→\n    23→def _atexit_release_locks() -> None:\n    24→    \"\"\"Release all held locks on normal interpreter exit.\"\"\"\n    25→    for guard in list(_active_guards):\n    26→        try:\n    27→            guard.release_lock()\n    28→        except Exception:\n    29→            pass\n    30→\n    31→\n    32→atexit.register(_atexit_release_locks)\n    33→\n    34→\n    35→class SafetyError(Exception):\n    36→    \"\"\"Raised when a safety check fails.\"\"\"\n    37→    pass\n    38→\n    39→\n    40→class GracefulDegradation:\n    41→    \"\"\"Manages graceful degradation when approaching rate or cost limits.\n    42→\n    43→    Instead of hard-stopping, this reduces batch size and increases sleep\n    44→    intervals to allow the system to continue operating at reduced capacity.\n    45→    \"\"\"\n    46→\n    47→    def __init__(self, config: Config):\n    48→        self.config = config\n    49→        self._degraded = False\n    50→        self._degradation_level = 0  # 0=normal, 1=mild, 2=moderate, 3=severe\n    51→\n    52→    @property\n    53→    def is_degraded(self) -> bool:\n    54→        return self._degraded\n    55→\n    56→    @property\n    57→    def degradation_level(self) -> int:\n    58→        return self._degradation_level\n    59→\n    60→    def check_and_adjust(\n    61→        self,\n    62→        cycles_per_hour: int,\n    63→        cost_per_hour: float,\n    64→    ) -> dict:\n    65→        \"\"\"Check proximity to limits and compute adjustments.\n    66→\n    67→        Returns a dict with:\n    68→            - degraded: whether we're in degraded mode\n    69→            - level: 0-3 severity level\n    70→            - batch_size_factor: multiplier for batch size (0.25-1.0)\n    71→            - sleep_multiplier: multiplier for sleep interval (1.0-4.0)\n    72→            - reason: human-readable reason for degradation\n    73→        \"\"\"\n    74→        rate_limit = self.config.safety.max_cycles_per_hour\n    75→        cost_limit = self.config.safety.max_cost_usd_per_hour\n    76→\n    77→        rate_pct = (cycles_per_hour / rate_limit * 100) if rate_limit > 0 else 0\n    78→        cost_pct = (cost_per_hour / cost_limit * 100) if cost_limit > 0 else 0\n    79→\n    80→        max_pct = max(rate_pct, cost_pct)\n    81→\n    82→        reasons = []\n    83→        if rate_pct >= 70:\n    84→            reasons.append(f\"rate at {rate_pct:.0f}% of limit ({cycles_per_hour}/{rate_limit})\")\n    85→        if cost_pct >= 70:\n    86→            reasons.append(f\"cost at {cost_pct:.0f}% of limit (${cost_per_hour:.2f}/${cost_limit:.2f})\")\n    87→\n    88→        if max_pct >= 95:\n    89→            self._degradation_level = 3\n    90→            self._degraded = True\n    91→            return {\n    92→                \"degraded\": True,\n    93→                \"level\": 3,\n    94→                \"batch_size_factor\": 0.25,\n    95→                \"sleep_multiplier\": 4.0,\n    96→                \"reason\": \"Severe: \" + \"; \".join(reasons),\n    97→            }\n    98→        elif max_pct >= 85:\n    99→            self._degradation_level = 2\n   100→            self._degraded = True\n   101→            return {\n   102→                \"degraded\": True,\n   103→                \"level\": 2,\n   104→                \"batch_size_factor\": 0.5,\n   105→                \"sleep_multiplier\": 3.0,\n   106→                \"reason\": \"Moderate: \" + \"; \".join(reasons),\n   107→            }\n   108→        elif max_pct >= 70:\n   109→            self._degradation_level = 1\n   110→            self._degraded = True\n   111→            return {\n   112→                \"degraded\": True,\n   113→                \"level\": 1,\n   114→                \"batch_size_factor\": 0.75,\n   115→                \"sleep_multiplier\": 2.0,\n   116→                \"reason\": \"Mild: \" + \"; \".join(reasons),\n   117→            }\n   118→        else:\n   119→            self._degradation_level = 0\n   120→            self._degraded = False\n   121→            return {\n   122→                \"degraded\": False,\n   123→                \"level\": 0,\n   124→                \"batch_size_factor\": 1.0,\n   125→                \"sleep_multiplier\": 1.0,\n   126→                \"reason\": \"\",\n   127→            }\n   128→\n   129→\n   130→class SafetyGuard:\n   131→    def __init__(self, config: Config, state_manager: StateManager):\n   132→        self.config = config\n   133→        self.state = state_manager\n   134→        self._lock_fd: Optional[int] = None\n   135→        self.lock_path = Path(config.paths.lock_file)\n   136→\n   137→    def acquire_lock(self) -> None:\n   138→        \"\"\"Acquire an exclusive file lock to prevent concurrent runs.\n   139→\n   140→        Uses flock() on the existing lock file inode, avoiding the race\n   141→        condition of unlink-then-recreate where two processes could each\n   142→        hold exclusive flocks on different inodes.\n   143→        \"\"\"\n   144→        self.lock_path.parent.mkdir(parents=True, exist_ok=True)\n   145→        fd = os.open(str(self.lock_path), os.O_CREAT | os.O_RDWR)\n   146→        try:\n   147→            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)\n   148→        except OSError:\n   149→            # Check if the PID in the lock file is still alive\n   150→            stale = False\n   151→            existing_pid_str = \"\"\n   152→            try:\n   153→                os.lseek(fd, 0, os.SEEK_SET)\n   154→                existing_pid_bytes = os.read(fd, 64)\n   155→                existing_pid_str = existing_pid_bytes.decode(errors=\"replace\").strip()\n   156→                existing_pid = int(existing_pid_str)\n   157→                os.kill(existing_pid, 0)\n   158→            except (ValueError, ProcessLookupError):\n   159→                stale = True\n   160→            except PermissionError:\n   161→                # Process exists but we can't signal it\n   162→                stale = False\n   163→\n   164→            if not stale:\n   165→                os.close(fd)\n   166→                raise SafetyError(\"Another instance is already running (lock file held)\")\n   167→\n   168→            # Stale lock: the PID is dead. Retry flock on the SAME file\n   169→            # descriptor (same inode) — don't unlink and recreate.\n   170→            logger.warning(\n   171→                \"Cleaning up stale lock file from dead process (PID %s)\",\n   172→                existing_pid_str,\n   173→            )\n   174→            try:\n   175→                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)\n   176→            except OSError:\n   177→                os.close(fd)\n   178→                raise SafetyError(\"Another instance is already running (lock file held)\")\n   179→\n   180→        # Lock acquired — store the fd and write our PID\n   181→        self._lock_fd = fd\n   182→        _active_guards.append(self)\n   183→        os.ftruncate(self._lock_fd, 0)\n   184→        os.lseek(self._lock_fd, 0, os.SEEK_SET)\n   185→        os.write(self._lock_fd, str(os.getpid()).encode())\n   186→\n   187→    def release_lock(self) -> None:\n   188→        \"\"\"Release the file lock.\"\"\"\n   189→        if self._lock_fd is not None:\n   190→            try:\n   191→                fcntl.flock(self._lock_fd, fcntl.LOCK_UN)\n   192→            except OSError:\n   193→                pass\n   194→            try:\n   195→                os.close(self._lock_fd)\n   196→            except OSError:\n   197→                pass\n   198→            self._lock_fd = None\n   199→            try:\n   200→                _active_guards.remove(self)\n   201→            except ValueError:\n   202→                pass\n   203→\n   204→    def check_disk_space(self) -> None:\n   205→        \"\"\"Ensure sufficient disk space is available.\"\"\"\n   206→        target = self.config.target_dir\n   207→        usage = shutil.disk_usage(target)\n   208→        free_mb = usage.free / (1024 * 1024)\n   209→        if free_mb < self.config.safety.min_disk_space_mb:\n   210→            raise SafetyError(\n   211→                f\"Low disk space: {free_mb:.0f} MB free, \"\n   212→                f\"minimum {self.config.safety.min_disk_space_mb} MB required\"\n   213→            )\n   214→\n   215→    def check_memory(self) -> None:\n   216→        \"\"\"Ensure sufficient RAM is available.\n   217→\n   218→        Uses /proc/meminfo on Linux and vm_stat on macOS.\n   219→        Skips the check gracefully on unsupported platforms.\n   220→        \"\"\"\n   221→        import platform\n   222→        min_mb = self.config.safety.min_memory_mb\n   223→        if min_mb <= 0:\n   224→            return\n   225→\n   226→        available_mb: Optional[float] = None\n   227→\n   228→        system = platform.system()\n   229→        if system == \"Linux\":\n   230→            try:\n   231→                with open(\"/proc/meminfo\", \"r\") as f:\n   232→                    for line in f:\n   233→                        if line.startswith(\"MemAvailable:\"):\n   234→                            parts = line.split()\n   235→                            available_mb = int(parts[1]) / 1024  # kB -> MB\n   236→                            break\n   237→            except (OSError, ValueError, IndexError):\n   238→                logger.debug(\"Could not read /proc/meminfo, skipping memory check\")\n   239→                return\n   240→        elif system == \"Darwin\":\n   241→            try:\n   242→                import subprocess\n   243→                result = subprocess.run(\n   244→                    [\"vm_stat\"], capture_output=True, text=True, timeout=5,\n   245→                )\n   246→                if result.returncode == 0:\n   247→                    page_size = 4096  # default macOS page size\n   248→                    free_pages = 0\n   249→                    for line in result.stdout.splitlines():\n   250→                        if \"page size of\" in line:\n   251→                            try:\n   252→                                page_size = int(line.split()[-2])\n   253→                            except (ValueError, IndexError):\n   254→                                pass\n   255→                        elif \"Pages free:\" in line:\n   256→                            try:\n   257→                                free_pages += int(line.split()[-1].rstrip(\".\"))\n   258→                            except (ValueError, IndexError):\n   259→                                pass\n   260→                        elif \"Pages inactive:\" in line or \"Pages speculative:\" in line or \"Pages purgeable:\" in line:\n   261→                            try:\n   262→                                free_pages += int(line.split()[-1].rstrip(\".\"))\n   263→                            except (ValueError, IndexError):\n   264→                                pass\n   265→                    available_mb = (free_pages * page_size) / (1024 * 1024)\n   266→            except (OSError, subprocess.TimeoutExpired):\n   267→                logger.debug(\"Could not run vm_stat, skipping memory check\")\n   268→                return\n   269→        else:\n   270→            logger.debug(\"Memory check not supported on %s\", system)\n   271→            return\n   272→\n   273→        if available_mb is None:\n   274→            logger.debug(\"Could not determine available memory, skipping check\")\n   275→            return\n   276→\n   277→        if available_mb < min_mb:\n   278→            raise SafetyError(\n   279→                f\"Low memory: {available_mb:.0f} MB available, \"\n   280→                f\"minimum {min_mb} MB required\"\n   281→            )\n   282→        elif available_mb < min_mb * 1.5:\n   283→            logger.warning(\n   284→                \"Memory approaching minimum: %.0f MB available (minimum: %d MB)\",\n   285→                available_mb, min_mb,\n   286→            )\n   287→\n   288→    def check_rate_limit(self) -> None:\n   289→        \"\"\"Ensure we haven't exceeded the cycles-per-hour limit.\"\"\"\n   290→        count = self.state.get_cycle_count_last_hour()\n   291→        limit = self.config.safety.max_cycles_per_hour\n   292→        if count >= limit:\n   293→            raise SafetyError(\n   294→                f\"Rate limit reached: {count} cycles in the last hour (limit: {limit})\"\n   295→            )\n   296→\n   297→    def check_cost_limit(self) -> None:\n   298→        \"\"\"Ensure we haven't exceeded the cost-per-hour limit.\"\"\"\n   299→        cost = self.state.get_total_cost(lookback_seconds=3600)\n   300→        limit = self.config.safety.max_cost_usd_per_hour\n   301→        if cost >= limit:\n   302→            raise SafetyError(\n   303→                f\"Cost limit reached: ${cost:.2f} in the last hour (limit: ${limit:.2f})\"\n   304→            )\n   305→\n   306→    def check_consecutive_failures(self) -> None:\n   307→        \"\"\"Pause if too many consecutive failures, with reset support.\"\"\"\n   308→        failures = self.state.get_consecutive_failures()\n   309→        limit = self.config.safety.max_consecutive_failures\n   310→        if failures < limit:\n   311→            return\n   312→\n   313→        # Check for file-based reset trigger\n   314→        reset_file = Path(self.config.paths.state_dir) / \"reset_failures\"\n   315→        if reset_file.exists():\n   316→            logger.info(\"Found reset_failures file, resetting consecutive failures\")\n   317→            self.state.reset_consecutive_failures(\"file-based trigger (state/reset_failures)\")\n   318→            reset_file.unlink(missing_ok=True)\n   319→            return\n   320→\n   321→        # Check for time-based auto-reset (idle for 1+ hour)\n   322→        if self.state.should_auto_reset_failures(min_idle_seconds=3600):\n   323→            logger.info(\"System idle for 1+ hour, auto-resetting consecutive failures\")\n   324→            self.state.reset_consecutive_failures(\"auto-reset after idle period\")\n   325→            return\n   326→\n   327→        raise SafetyError(\n   328→            f\"Too many consecutive failures: {failures} (limit: {limit}). \"\n   329→            \"Pausing until a successful cycle or manual intervention. \"\n   330→            \"To reset: touch state/reset_failures\"\n   331→        )\n   332→\n   333→    def check_protected_files(self, changed_files: List[str]) -> None:\n   334→        \"\"\"Ensure no protected files have been modified.\"\"\"\n   335→        target_dir = self.config.target_dir\n   336→        violations = []\n   337→        for f in changed_files:\n   338→            changed_path = os.path.join(target_dir, f)\n   339→            for p in self.config.safety.protected_files:\n   340→                protected_path = os.path.join(target_dir, p)\n   341→                # Use samefile when both paths exist (avoids unnecessary exceptions)\n   342→                if os.path.exists(changed_path) and os.path.exists(protected_path):\n   343→                    try:\n   344→                        if os.path.samefile(changed_path, protected_path):\n   345→                            violations.append(f)\n   346→                            break\n   347→                    except OSError:\n   348→                        pass\n   349→                    else:\n   350→                        # samefile returned False — paths are definitively different\n   351→                        continue\n   352→                # Fall back to realpath + normpath comparison (e.g. when file doesn't exist yet)\n   353→                if os.path.normpath(os.path.realpath(changed_path)) == os.path.normpath(os.path.realpath(protected_path)):\n   354→                    violations.append(f)\n   355→                    break\n   356→        if violations:\n   357→            raise SafetyError(\n   358→                f\"Protected files modified: {', '.join(violations)}\"\n   359→            )\n   360→\n   361→    def check_file_count(self, changed_files: List[str]) -> None:\n   362→        \"\"\"Ensure number of changed files is within limit.\"\"\"\n   363→        limit = self.config.orchestrator.max_changed_files\n   364→        if limit <= 0:\n   365→            if limit == 0:\n   366→                raise SafetyError(\n   367→                    \"max_changed_files is zero; no files can be changed\"\n   368→                )\n   369→            raise SafetyError(\n   370→                f\"max_changed_files must be positive (got {limit})\"\n   371→            )\n   372→        count = len(changed_files)\n   373→        if count > limit:\n   374→            raise SafetyError(\n   375→                f\"Too many files changed: {count} (limit: {limit})\"\n   376→            )\n   377→        warning_threshold = int(limit * 0.8)\n   378→        if warning_threshold > 0 and count > warning_threshold:\n   379→            logger.warning(\"Changed file count (%d) approaching limit (%d)\", count, limit)\n   380→\n   381→    def check_backup_dir_size(self) -> None:\n   382→        \"\"\"Monitor backup directory size and clean up old files when threshold is exceeded.\n   383→\n   384→        Removes oldest backup files first until directory size is below threshold.\n   385→        This prevents unbounded growth from syntax-check backups and corruption backups.\n   386→        \"\"\"\n   387→        backup_dir = Path(self.config.paths.backup_dir)\n   388→        if not backup_dir.exists():\n   389→            return\n   390→\n   391→        max_mb = self.config.safety.max_backup_dir_mb\n   392→        if max_mb <= 0:\n   393→            return\n   394→\n   395→        max_bytes = max_mb * 1024 * 1024\n   396→\n   397→        # Calculate total size and collect files with their sizes and mtimes\n   398→        files_info = []\n   399→        total_size = 0\n   400→        try:\n   401→            for entry in backup_dir.iterdir():\n   402→                if entry.is_file():\n   403→                    try:\n   404→                        stat = entry.stat()\n   405→                        files_info.append((entry, stat.st_size, stat.st_mtime))\n   406→                        total_size += stat.st_size\n   407→                    except OSError:\n   408→                        continue\n   409→        except OSError as e:\n   410→            logger.debug(\"Could not scan backup directory %s: %s\", backup_dir, e)\n   411→            return\n   412→\n   413→        if total_size <= max_bytes:\n   414→            return\n   415→\n   416→        logger.warning(\n   417→            \"Backup directory %s size %.1f MB exceeds threshold %d MB, cleaning up\",\n   418→            backup_dir, total_size / (1024 * 1024), max_mb,\n   419→        )\n   420→\n   421→        # Sort by mtime ascending (oldest first)\n   422→        files_info.sort(key=lambda x: x[2])\n   423→\n   424→        cleaned_count = 0\n   425→        cleaned_bytes = 0\n   426→        for fpath, fsize, _ in files_info:\n   427→            if total_size <= max_bytes:\n   428→                break\n   429→            try:\n   430→                fpath.unlink()\n   431→                total_size -= fsize\n   432→                cleaned_count += 1\n   433→                cleaned_bytes += fsize\n   434→            except OSError:\n   435→                continue\n   436→\n   437→        if cleaned_count > 0:\n   438→            logger.info(\n   439→                \"Cleaned %d backup files (%.1f MB freed), \"\n   440→                \"directory now %.1f MB\",\n   441→                cleaned_count, cleaned_bytes / (1024 * 1024),\n   442→                total_size / (1024 * 1024),\n   443→            )\n   444→\n   445→        # Also clean up old .corrupt files in state directory\n   446→        state_dir = Path(self.config.paths.state_dir)\n   447→        if state_dir.exists():\n   448→            cutoff = time.time() - (7 * 86400)  # 7 days\n   449→            for entry in state_dir.iterdir():\n   450→                if entry.is_file() and \".corrupt\" in entry.name:\n   451→                    try:\n   452→                        if entry.stat().st_mtime < cutoff:\n   453→                            entry.unlink()\n   454→                            logger.debug(\"Removed old corrupt backup: %s\", entry.name)\n   455→                    except OSError:\n   456→                        continue\n   457→\n   458→    def check_git_object_growth(self) -> None:\n   459→        \"\"\"Monitor .git/objects directory size to detect repository bloat.\n   460→\n   461→        Repeated commits and rollbacks can cause unbounded growth in the git\n   462→        object store. This check warns when the objects directory exceeds\n   463→        the configured threshold and attempts a 'git gc' to reclaim space.\n   464→        Raises SafetyError if objects exceed 2x the threshold after gc.\n   465→        \"\"\"\n   466→        target = self.config.target_dir\n   467→        max_mb = self.config.safety.max_git_objects_mb\n   468→        if max_mb <= 0:\n   469→            return\n   470→\n   471→        git_objects_dir = Path(target) / \".git\" / \"objects\"\n   472→        if not git_objects_dir.exists():\n   473→            return\n   474→\n   475→        total_size = 0\n   476→        try:\n   477→            for dirpath, _dirnames, filenames in os.walk(str(git_objects_dir)):\n   478→                for fname in filenames:\n   479→                    try:\n   480→                        total_size += os.path.getsize(os.path.join(dirpath, fname))\n   481→                    except OSError:\n   482→                        continue\n   483→        except OSError as e:\n   484→            logger.debug(\"Could not scan .git/objects: %s\", e)\n   485→            return\n   486→\n   487→        size_mb = total_size / (1024 * 1024)\n   488→\n   489→        if size_mb >= max_mb:\n   490→            logger.warning(\n   491→                \"Git objects directory %.1f MB exceeds threshold %d MB, running git gc\",\n   492→                size_mb, max_mb,\n   493→            )\n   494→            import subprocess\n   495→            try:\n   496→                subprocess.run(\n   497→                    [\"git\", \"gc\", \"--auto\"],\n   498→                    cwd=target,\n   499→                    capture_output=True,\n   500→                    timeout=120,\n   501→                )\n   502→            except (subprocess.TimeoutExpired, OSError) as e:\n   503→                logger.warning(\"git gc failed: %s\", e)\n   504→\n   505→            # Re-measure after gc\n   506→            post_gc_size = 0\n   507→            try:\n   508→                for dirpath, _dirnames, filenames in os.walk(str(git_objects_dir)):\n   509→                    for fname in filenames:\n   510→                        try:\n   511→                            post_gc_size += os.path.getsize(\n   512→                                os.path.join(dirpath, fname)\n   513→                            )\n   514→                        except OSError:\n   515→                            continue\n   516→            except OSError:\n   517→                return\n   518→\n   519→            post_gc_mb = post_gc_size / (1024 * 1024)\n   520→            if post_gc_mb >= max_mb * 2:\n   521→                raise SafetyError(\n   522→                    f\"Git objects directory still {post_gc_mb:.0f} MB after gc \"\n   523→                    f\"(limit: {max_mb} MB). Repository may need manual cleanup.\"\n   524→                )\n   525→            elif post_gc_mb >= max_mb:\n   526→                logger.warning(\n   527→                    \"Git objects still %.1f MB after gc (threshold: %d MB)\",\n   528→                    post_gc_mb, max_mb,\n   529→                )\n   530→\n   531→    def pre_flight_checks(self) -> None:\n   532→        \"\"\"Run all pre-cycle safety checks.\"\"\"\n   533→        self.check_disk_space()\n   534→        self.check_memory()\n   535→        self.check_rate_limit()\n   536→        self.check_cost_limit()\n   537→        self.check_consecutive_failures()\n   538→        self.check_backup_dir_size()\n   539→        self.check_git_object_growth()\n   540→        logger.debug(\"All pre-flight checks passed\")\n   541→\n   542→    def post_claude_checks(self, changed_files: List[str]) -> None:\n   543→        \"\"\"Run safety checks after Claude has made changes.\"\"\"\n   544→        self.check_protected_files(changed_files)\n   545→        self.check_file_count(changed_files)\n   546→"}]},"parent_tool_use_id":null,"session_id":"683cb910-ec92-4e9d-966c-acfa8b13ef01","uuid":"db4b587e-ccbf-47be-a93c-ae26de56d09a","tool_use_result":{"type":"text","file":{"filePath":"/Users/sameertkhanna/Documents/auto_claude_code/safety.py","content":"\"\"\"Safety guards: lock file, disk space, rate limits, protected files, failure counter.\"\"\"\n\nfrom __future__ import annotations\n\nimport atexit\nimport fcntl\nimport logging\nimport os\nimport shutil\nimport time\nfrom pathlib import Path\nfrom typing import List, Optional\n\nfrom config_schema import Config\nfrom state import StateManager\n\nlogger = logging.getLogger(__name__)\n\n# Module-level list of SafetyGuard instances that hold locks, for atexit cleanup.\n_active_guards: List[SafetyGuard] = []\n\n\ndef _atexit_release_locks() -> None:\n    \"\"\"Release all held locks on normal interpreter exit.\"\"\"\n    for guard in list(_active_guards):\n        try:\n            guard.release_lock()\n        except Exception:\n            pass\n\n\natexit.register(_atexit_release_locks)\n\n\nclass SafetyError(Exception):\n    \"\"\"Raised when a safety check fails.\"\"\"\n    pass\n\n\nclass GracefulDegradation:\n    \"\"\"Manages graceful degradation when approaching rate or cost limits.\n\n    Instead of hard-stopping, this reduces batch size and increases sleep\n    intervals to allow the system to continue operating at reduced capacity.\n    \"\"\"\n\n    def __init__(self, config: Config):\n        self.config = config\n        self._degraded = False\n        self._degradation_level = 0  # 0=normal, 1=mild, 2=moderate, 3=severe\n\n    @property\n    def is_degraded(self) -> bool:\n        return self._degraded\n\n    @property\n    def degradation_level(self) -> int:\n        return self._degradation_level\n\n    def check_and_adjust(\n        self,\n        cycles_per_hour: int,\n        cost_per_hour: float,\n    ) -> dict:\n        \"\"\"Check proximity to limits and compute adjustments.\n\n        Returns a dict with:\n            - degraded: whether we're in degraded mode\n            - level: 0-3 severity level\n            - batch_size_factor: multiplier for batch size (0.25-1.0)\n            - sleep_multiplier: multiplier for sleep interval (1.0-4.0)\n            - reason: human-readable reason for degradation\n        \"\"\"\n        rate_limit = self.config.safety.max_cycles_per_hour\n        cost_limit = self.config.safety.max_cost_usd_per_hour\n\n        rate_pct = (cycles_per_hour / rate_limit * 100) if rate_limit > 0 else 0\n        cost_pct = (cost_per_hour / cost_limit * 100) if cost_limit > 0 else 0\n\n        max_pct = max(rate_pct, cost_pct)\n\n        reasons = []\n        if rate_pct >= 70:\n            reasons.append(f\"rate at {rate_pct:.0f}% of limit ({cycles_per_hour}/{rate_limit})\")\n        if cost_pct >= 70:\n            reasons.append(f\"cost at {cost_pct:.0f}% of limit (${cost_per_hour:.2f}/${cost_limit:.2f})\")\n\n        if max_pct >= 95:\n            self._degradation_level = 3\n            self._degraded = True\n            return {\n                \"degraded\": True,\n                \"level\": 3,\n                \"batch_size_factor\": 0.25,\n                \"sleep_multiplier\": 4.0,\n                \"reason\": \"Severe: \" + \"; \".join(reasons),\n            }\n        elif max_pct >= 85:\n            self._degradation_level = 2\n            self._degraded = True\n            return {\n                \"degraded\": True,\n                \"level\": 2,\n                \"batch_size_factor\": 0.5,\n                \"sleep_multiplier\": 3.0,\n                \"reason\": \"Moderate: \" + \"; \".join(reasons),\n            }\n        elif max_pct >= 70:\n            self._degradation_level = 1\n            self._degraded = True\n            return {\n                \"degraded\": True,\n                \"level\": 1,\n                \"batch_size_factor\": 0.75,\n                \"sleep_multiplier\": 2.0,\n                \"reason\": \"Mild: \" + \"; \".join(reasons),\n            }\n        else:\n            self._degradation_level = 0\n            self._degraded = False\n            return {\n                \"degraded\": False,\n                \"level\": 0,\n                \"batch_size_factor\": 1.0,\n                \"sleep_multiplier\": 1.0,\n                \"reason\": \"\",\n            }\n\n\nclass SafetyGuard:\n    def __init__(self, config: Config, state_manager: StateManager):\n        self.config = config\n        self.state = state_manager\n        self._lock_fd: Optional[int] = None\n        self.lock_path = Path(config.paths.lock_file)\n\n    def acquire_lock(self) -> None:\n        \"\"\"Acquire an exclusive file lock to prevent concurrent runs.\n\n        Uses flock() on the existing lock file inode, avoiding the race\n        condition of unlink-then-recreate where two processes could each\n        hold exclusive flocks on different inodes.\n        \"\"\"\n        self.lock_path.parent.mkdir(parents=True, exist_ok=True)\n        fd = os.open(str(self.lock_path), os.O_CREAT | os.O_RDWR)\n        try:\n            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)\n        except OSError:\n            # Check if the PID in the lock file is still alive\n            stale = False\n            existing_pid_str = \"\"\n            try:\n                os.lseek(fd, 0, os.SEEK_SET)\n                existing_pid_bytes = os.read(fd, 64)\n                existing_pid_str = existing_pid_bytes.decode(errors=\"replace\").strip()\n                existing_pid = int(existing_pid_str)\n                os.kill(existing_pid, 0)\n            except (ValueError, ProcessLookupError):\n                stale = True\n            except PermissionError:\n                # Process exists but we can't signal it\n                stale = False\n\n            if not stale:\n                os.close(fd)\n                raise SafetyError(\"Another instance is already running (lock file held)\")\n\n            # Stale lock: the PID is dead. Retry flock on the SAME file\n            # descriptor (same inode) — don't unlink and recreate.\n            logger.warning(\n                \"Cleaning up stale lock file from dead process (PID %s)\",\n                existing_pid_str,\n            )\n            try:\n                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)\n            except OSError:\n                os.close(fd)\n                raise SafetyError(\"Another instance is already running (lock file held)\")\n\n        # Lock acquired — store the fd and write our PID\n        self._lock_fd = fd\n        _active_guards.append(self)\n        os.ftruncate(self._lock_fd, 0)\n        os.lseek(self._lock_fd, 0, os.SEEK_SET)\n        os.write(self._lock_fd, str(os.getpid()).encode())\n\n    def release_lock(self) -> None:\n        \"\"\"Release the file lock.\"\"\"\n        if self._lock_fd is not None:\n            try:\n                fcntl.flock(self._lock_fd, fcntl.LOCK_UN)\n            except OSError:\n                pass\n            try:\n                os.close(self._lock_fd)\n            except OSError:\n                pass\n            self._lock_fd = None\n            try:\n                _active_guards.remove(self)\n            except ValueError:\n                pass\n\n    def check_disk_space(self) -> None:\n        \"\"\"Ensure sufficient disk space is available.\"\"\"\n        target = self.config.target_dir\n        usage = shutil.disk_usage(target)\n        free_mb = usage.free / (1024 * 1024)\n        if free_mb < self.config.safety.min_disk_space_mb:\n            raise SafetyError(\n                f\"Low disk space: {free_mb:.0f} MB free, \"\n                f\"minimum {self.config.safety.min_disk_space_mb} MB required\"\n            )\n\n    def check_memory(self) -> None:\n        \"\"\"Ensure sufficient RAM is available.\n\n        Uses /proc/meminfo on Linux and vm_stat on macOS.\n        Skips the check gracefully on unsupported platforms.\n        \"\"\"\n        import platform\n        min_mb = self.config.safety.min_memory_mb\n        if min_mb <= 0:\n            return\n\n        available_mb: Optional[float] = None\n\n        system = platform.system()\n        if system == \"Linux\":\n            try:\n                with open(\"/proc/meminfo\", \"r\") as f:\n                    for line in f:\n                        if line.startswith(\"MemAvailable:\"):\n                            parts = line.split()\n                            available_mb = int(parts[1]) / 1024  # kB -> MB\n                            break\n            except (OSError, ValueError, IndexError):\n                logger.debug(\"Could not read /proc/meminfo, skipping memory check\")\n                return\n        elif system == \"Darwin\":\n            try:\n                import subprocess\n                result = subprocess.run(\n                    [\"vm_stat\"], capture_output=True, text=True, timeout=5,\n                )\n                if result.returncode == 0:\n                    page_size = 4096  # default macOS page size\n                    free_pages = 0\n                    for line in result.stdout.splitlines():\n                        if \"page size of\" in line:\n                            try:\n                                page_size = int(line.split()[-2])\n                            except (ValueError, IndexError):\n                                pass\n                        elif \"Pages free:\" in line:\n                            try:\n                                free_pages += int(line.split()[-1].rstrip(\".\"))\n                            except (ValueError, IndexError):\n                                pass\n                        elif \"Pages inactive:\" in line or \"Pages speculative:\" in line or \"Pages purgeable:\" in line:\n                            try:\n                                free_pages += int(line.split()[-1].rstrip(\".\"))\n                            except (ValueError, IndexError):\n                                pass\n                    available_mb = (free_pages * page_size) / (1024 * 1024)\n            except (OSError, subprocess.TimeoutExpired):\n                logger.debug(\"Could not run vm_stat, skipping memory check\")\n                return\n        else:\n            logger.debug(\"Memory check not supported on %s\", system)\n            return\n\n        if available_mb is None:\n            logger.debug(\"Could not determine available memory, skipping check\")\n            return\n\n        if available_mb < min_mb:\n            raise SafetyError(\n                f\"Low memory: {available_mb:.0f} MB available, \"\n                f\"minimum {min_mb} MB required\"\n            )\n        elif available_mb < min_mb * 1.5:\n            logger.warning(\n                \"Memory approaching minimum: %.0f MB available (minimum: %d MB)\",\n                available_mb, min_mb,\n            )\n\n    def check_rate_limit(self) -> None:\n        \"\"\"Ensure we haven't exceeded the cycles-per-hour limit.\"\"\"\n        count = self.state.get_cycle_count_last_hour()\n        limit = self.config.safety.max_cycles_per_hour\n        if count >= limit:\n            raise SafetyError(\n                f\"Rate limit reached: {count} cycles in the last hour (limit: {limit})\"\n            )\n\n    def check_cost_limit(self) -> None:\n        \"\"\"Ensure we haven't exceeded the cost-per-hour limit.\"\"\"\n        cost = self.state.get_total_cost(lookback_seconds=3600)\n        limit = self.config.safety.max_cost_usd_per_hour\n        if cost >= limit:\n            raise SafetyError(\n                f\"Cost limit reached: ${cost:.2f} in the last hour (limit: ${limit:.2f})\"\n            )\n\n    def check_consecutive_failures(self) -> None:\n        \"\"\"Pause if too many consecutive failures, with reset support.\"\"\"\n        failures = self.state.get_consecutive_failures()\n        limit = self.config.safety.max_consecutive_failures\n        if failures < limit:\n            return\n\n        # Check for file-based reset trigger\n        reset_file = Path(self.config.paths.state_dir) / \"reset_failures\"\n        if reset_file.exists():\n            logger.info(\"Found reset_failures file, resetting consecutive failures\")\n            self.state.reset_consecutive_failures(\"file-based trigger (state/reset_failures)\")\n            reset_file.unlink(missing_ok=True)\n            return\n\n        # Check for time-based auto-reset (idle for 1+ hour)\n        if self.state.should_auto_reset_failures(min_idle_seconds=3600):\n            logger.info(\"System idle for 1+ hour, auto-resetting consecutive failures\")\n            self.state.reset_consecutive_failures(\"auto-reset after idle period\")\n            return\n\n        raise SafetyError(\n            f\"Too many consecutive failures: {failures} (limit: {limit}). \"\n            \"Pausing until a successful cycle or manual intervention. \"\n            \"To reset: touch state/reset_failures\"\n        )\n\n    def check_protected_files(self, changed_files: List[str]) -> None:\n        \"\"\"Ensure no protected files have been modified.\"\"\"\n        target_dir = self.config.target_dir\n        violations = []\n        for f in changed_files:\n            changed_path = os.path.join(target_dir, f)\n            for p in self.config.safety.protected_files:\n                protected_path = os.path.join(target_dir, p)\n                # Use samefile when both paths exist (avoids unnecessary exceptions)\n                if os.path.exists(changed_path) and os.path.exists(protected_path):\n                    try:\n                        if os.path.samefile(changed_path, protected_path):\n                            violations.append(f)\n                            break\n                    except OSError:\n                        pass\n                    else:\n                        # samefile returned False — paths are definitively different\n                        continue\n                # Fall back to realpath + normpath comparison (e.g. when file doesn't exist yet)\n                if os.path.normpath(os.path.realpath(changed_path)) == os.path.normpath(os.path.realpath(protected_path)):\n                    violations.append(f)\n                    break\n        if violations:\n            raise SafetyError(\n                f\"Protected files modified: {', '.join(violations)}\"\n            )\n\n    def check_file_count(self, changed_files: List[str]) -> None:\n        \"\"\"Ensure number of changed files is within limit.\"\"\"\n        limit = self.config.orchestrator.max_changed_files\n        if limit <= 0:\n            if limit == 0:\n                raise SafetyError(\n                    \"max_changed_files is zero; no files can be changed\"\n                )\n            raise SafetyError(\n                f\"max_changed_files must be positive (got {limit})\"\n            )\n        count = len(changed_files)\n        if count > limit:\n            raise SafetyError(\n                f\"Too many files changed: {count} (limit: {limit})\"\n            )\n        warning_threshold = int(limit * 0.8)\n        if warning_threshold > 0 and count > warning_threshold:\n            logger.warning(\"Changed file count (%d) approaching limit (%d)\", count, limit)\n\n    def check_backup_dir_size(self) -> None:\n        \"\"\"Monitor backup directory size and clean up old files when threshold is exceeded.\n\n        Removes oldest backup files first until directory size is below threshold.\n        This prevents unbounded growth from syntax-check backups and corruption backups.\n        \"\"\"\n        backup_dir = Path(self.config.paths.backup_dir)\n        if not backup_dir.exists():\n            return\n\n        max_mb = self.config.safety.max_backup_dir_mb\n        if max_mb <= 0:\n            return\n\n        max_bytes = max_mb * 1024 * 1024\n\n        # Calculate total size and collect files with their sizes and mtimes\n        files_info = []\n        total_size = 0\n        try:\n            for entry in backup_dir.iterdir():\n                if entry.is_file():\n                    try:\n                        stat = entry.stat()\n                        files_info.append((entry, stat.st_size, stat.st_mtime))\n                        total_size += stat.st_size\n                    except OSError:\n                        continue\n        except OSError as e:\n            logger.debug(\"Could not scan backup directory %s: %s\", backup_dir, e)\n            return\n\n        if total_size <= max_bytes:\n            return\n\n        logger.warning(\n            \"Backup directory %s size %.1f MB exceeds threshold %d MB, cleaning up\",\n            backup_dir, total_size / (1024 * 1024), max_mb,\n        )\n\n        # Sort by mtime ascending (oldest first)\n        files_info.sort(key=lambda x: x[2])\n\n        cleaned_count = 0\n        cleaned_bytes = 0\n        for fpath, fsize, _ in files_info:\n            if total_size <= max_bytes:\n                break\n            try:\n                fpath.unlink()\n                total_size -= fsize\n                cleaned_count += 1\n                cleaned_bytes += fsize\n            except OSError:\n                continue\n\n        if cleaned_count > 0:\n            logger.info(\n                \"Cleaned %d backup files (%.1f MB freed), \"\n                \"directory now %.1f MB\",\n                cleaned_count, cleaned_bytes / (1024 * 1024),\n                total_size / (1024 * 1024),\n            )\n\n        # Also clean up old .corrupt files in state directory\n        state_dir = Path(self.config.paths.state_dir)\n        if state_dir.exists():\n            cutoff = time.time() - (7 * 86400)  # 7 days\n            for entry in state_dir.iterdir():\n                if entry.is_file() and \".corrupt\" in entry.name:\n                    try:\n                        if entry.stat().st_mtime < cutoff:\n                            entry.unlink()\n                            logger.debug(\"Removed old corrupt backup: %s\", entry.name)\n                    except OSError:\n                        continue\n\n    def check_git_object_growth(self) -> None:\n        \"\"\"Monitor .git/objects directory size to detect repository bloat.\n\n        Repeated commits and rollbacks can cause unbounded growth in the git\n        object store. This check warns when the objects directory exceeds\n        the configured threshold and attempts a 'git gc' to reclaim space.\n        Raises SafetyError if objects exceed 2x the threshold after gc.\n        \"\"\"\n        target = self.config.target_dir\n        max_mb = self.config.safety.max_git_objects_mb\n        if max_mb <= 0:\n            return\n\n        git_objects_dir = Path(target) / \".git\" / \"objects\"\n        if not git_objects_dir.exists():\n            return\n\n        total_size = 0\n        try:\n            for dirpath, _dirnames, filenames in os.walk(str(git_objects_dir)):\n                for fname in filenames:\n                    try:\n                        total_size += os.path.getsize(os.path.join(dirpath, fname))\n                    except OSError:\n                        continue\n        except OSError as e:\n            logger.debug(\"Could not scan .git/objects: %s\", e)\n            return\n\n        size_mb = total_size / (1024 * 1024)\n\n        if size_mb >= max_mb:\n            logger.warning(\n                \"Git objects directory %.1f MB exceeds threshold %d MB, running git gc\",\n                size_mb, max_mb,\n            )\n            import subprocess\n            try:\n                subprocess.run(\n                    [\"git\", \"gc\", \"--auto\"],\n                    cwd=target,\n                    capture_output=True,\n                    timeout=120,\n                )\n            except (subprocess.TimeoutExpired, OSError) as e:\n                logger.warning(\"git gc failed: %s\", e)\n\n            # Re-measure after gc\n            post_gc_size = 0\n            try:\n                for dirpath, _dirnames, filenames in os.walk(str(git_objects_dir)):\n                    for fname in filenames:\n                        try:\n                            post_gc_size += os.path.getsize(\n                                os.path.join(dirpath, fname)\n                            )\n                        except OSError:\n                            continue\n            except OSError:\n                return\n\n            post_gc_mb = post_gc_size / (1024 * 1024)\n            if post_gc_mb >= max_mb * 2:\n                raise SafetyError(\n                    f\"Git objects directory still {post_gc_mb:.0f} MB after gc \"\n                    f\"(limit: {max_mb} MB). Repository may need manual cleanup.\"\n                )\n            elif post_gc_mb >= max_mb:\n                logger.warning(\n                    \"Git objects still %.1f MB after gc (threshold: %d MB)\",\n                    post_gc_mb, max_mb,\n                )\n\n    def pre_flight_checks(self) -> None:\n        \"\"\"Run all pre-cycle safety checks.\"\"\"\n        self.check_disk_space()\n        self.check_memory()\n        self.check_rate_limit()\n        self.check_cost_limit()\n        self.check_consecutive_failures()\n        self.check_backup_dir_size()\n        self.check_git_object_growth()\n        logger.debug(\"All pre-flight checks passed\")\n\n    def post_claude_checks(self, changed_files: List[str]) -> None:\n        \"\"\"Run safety checks after Claude has made changes.\"\"\"\n        self.check_protected_files(changed_files)\n        self.check_file_count(changed_files)\n","numLines":546,"startLine":1,"totalLines":546}}}
