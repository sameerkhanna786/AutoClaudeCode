{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_vrtx_01L6cn7xgAGDAqx17S96kLxE","type":"tool_result","content":"     1→\"\"\"Shared utility functions used across orchestrator, coordinator, and worker.\"\"\"\n     2→\n     3→from __future__ import annotations\n     4→\n     5→import ast\n     6→import logging\n     7→import re\n     8→from pathlib import Path\n     9→from typing import List, Optional\n    10→\n    11→from task_discovery import Task\n    12→\n    13→logger = logging.getLogger(__name__)\n    14→\n    15→\n    16→# ------------------------------------------------------------------\n    17→# Task dependency ordering (DAG topological sort)\n    18→# ------------------------------------------------------------------\n    19→\n    20→def topological_sort_tasks(tasks: List[Task]) -> List[Task]:\n    21→    \"\"\"Topological sort using Kahn's algorithm with priority tie-breaking.\n    22→\n    23→    Raises ValueError if a dependency cycle is detected.\n    24→    \"\"\"\n    25→    task_map = {t.task_id: t for t in tasks}\n    26→    in_degree = {t.task_id: 0 for t in tasks}\n    27→    for t in tasks:\n    28→        for dep in t.depends_on:\n    29→            if dep in task_map:\n    30→                in_degree[t.task_id] += 1\n    31→    queue = sorted(\n    32→        [t for t in tasks if in_degree[t.task_id] == 0],\n    33→        key=lambda t: t.priority,\n    34→    )\n    35→    result: List[Task] = []\n    36→    while queue:\n    37→        task = queue.pop(0)\n    38→        result.append(task)\n    39→        for t in tasks:\n    40→            if task.task_id in t.depends_on:\n    41→                in_degree[t.task_id] -= 1\n    42→                if in_degree[t.task_id] == 0:\n    43→                    queue.append(t)\n    44→                    queue.sort(key=lambda x: x.priority)\n    45→    if len(result) != len(tasks):\n    46→        raise ValueError(\"Cycle detected in task dependencies\")\n    47→    return result\n    48→\n    49→\n    50→# ------------------------------------------------------------------"}]},"parent_tool_use_id":null,"session_id":"61828eb2-a493-4985-82af-e320e1ef1deb","uuid":"dec021df-18ae-43ff-98c5-8ac3aacaadc1","tool_use_result":{"type":"text","file":{"filePath":"/Users/sameertkhanna/Documents/auto_claude_code/shared.py","content":"\"\"\"Shared utility functions used across orchestrator, coordinator, and worker.\"\"\"\n\nfrom __future__ import annotations\n\nimport ast\nimport logging\nimport re\nfrom pathlib import Path\nfrom typing import List, Optional\n\nfrom task_discovery import Task\n\nlogger = logging.getLogger(__name__)\n\n\n# ------------------------------------------------------------------\n# Task dependency ordering (DAG topological sort)\n# ------------------------------------------------------------------\n\ndef topological_sort_tasks(tasks: List[Task]) -> List[Task]:\n    \"\"\"Topological sort using Kahn's algorithm with priority tie-breaking.\n\n    Raises ValueError if a dependency cycle is detected.\n    \"\"\"\n    task_map = {t.task_id: t for t in tasks}\n    in_degree = {t.task_id: 0 for t in tasks}\n    for t in tasks:\n        for dep in t.depends_on:\n            if dep in task_map:\n                in_degree[t.task_id] += 1\n    queue = sorted(\n        [t for t in tasks if in_degree[t.task_id] == 0],\n        key=lambda t: t.priority,\n    )\n    result: List[Task] = []\n    while queue:\n        task = queue.pop(0)\n        result.append(task)\n        for t in tasks:\n            if task.task_id in t.depends_on:\n                in_degree[t.task_id] -= 1\n                if in_degree[t.task_id] == 0:\n                    queue.append(t)\n                    queue.sort(key=lambda x: x.priority)\n    if len(result) != len(tasks):\n        raise ValueError(\"Cycle detected in task dependencies\")\n    return result\n\n\n# ------------------------------------------------------------------","numLines":50,"startLine":1,"total