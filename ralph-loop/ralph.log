f worktree_base.exists() and not any(worktree_base.iterdir()):\n                        worktree_base.rmdir()\n                except OSError:\n                    pass\n\n            try:\n                self.git.prune_worktrees()\n            except Exception:\n                logger.warning(\"Failed to prune worktrees during cleanup\")\n\n        thread = threading.Thread(target=_do_cleanup, daemon=True)\n        thread.start()\n        thread.join(timeout=self.config.parallel.cleanup_timeout)\n        if thread.is_alive():\n            logger.warning(\n                \"Worktree cleanup timed out after %ds, abandoning remaining cleanup\",\n                self.config.parallel.cleanup_timeout,\n            )\n        else:\n            logger.info(\"Cleaned up all worktrees\")\n","structuredPatch":[{"oldStart":233,"oldLines":6,"newStart":233,"newLines":7,"lines":["             finally:","                 self._cleanup_worker_with_timeout(worker)"," ","+        self._log_cycle_summary(results, cycle_start)","         self._workers.clear()","         self.git.prune_worktrees()"," "]}],"userModified":false,"replaceAll":false}}
