l_use_id":null,"session_id":"cdc88a14-e661-4229-849a-8b4c75790bc7","uuid":"71ccd4b3-2627-4cd7-9ec8-b6a807c82257","tool_use_result":{"type":"text","file":{"filePath":"/Users/sameertkhanna/Documents/auto_claude_code/tests/test_shared.py","content":"\"\"\"Tests for shared.py — shared utility functions.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport textwrap\nimport unittest\nfrom pathlib import Path\nfrom unittest.mock import MagicMock, patch\n\nfrom task_discovery import Task\nfrom shared import (\n    format_task_list,\n    syntax_check_files,\n    gather_tasks,\n    clean_description,\n    build_commit_message,\n    build_batch_commit_message,\n    extract_file_names,\n    build_task_prompt,\n    build_plan_prompt,\n    build_execute_prompt,\n    build_retry_prompt,\n    _derive_todo_subject,\n    TASK_TYPE_INSTRUCTIONS,\n)\n\n\n# ---------------------------------------------------------------------------\n# format_task_list\n# ---------------------------------------------------------------------------\n\nclass TestFormatTaskList(unittest.TestCase):\n\n    def test_single_task(self):\n        task = Task(description=\"Fix bug in foo.py\", priority=1, source=\"test_failure\")\n        result = format_task_list([task])\n        self.assertIn(\"1. Fix bug in foo.py [test_failure]\", result)\n\n    def test_multiple_tasks(self):\n        tasks = [\n            Task(description=\"Fix A\", priority=1, source=\"lint\"),\n            Task(description=\"Fix B\", priority=2, source=\"todo\"),\n        ]\n        result = format_task_list(tasks)\n        self.assertIn(\"1. Fix A [lint]\", result)\n        self.assertIn(\"2. Fix B [todo]\", result)\n\n    def test_task_with_context(self):\n        task = Task(","numLines":50,"startLine":1,"totalLines":617}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_vrtx_01VKcqGjp7SrQP5ac6LbNdKw","type":"tool_result","content":"     1→\"\"\"Tests for state module.\"\"\"\n     2→\n     3→import errno\n     4→import json\n     5→import os\n     6→import tempfile\n     7→import time\n     8→from pathlib import Path\n     9→from unittest.mock import patch\n    10→\n    11→import pytest\n    12→\n    13→from config_schema import Config\n    14→from state import CycleRecord, StateManager\n    15→\n    16→\n    17→@pytest.fixture\n    18→def state_mgr(tmp_path, default_config):\n    19→    default_config.paths.history_file = str(tmp_path / \"history.json\")\n    20→    return StateManager(default_config)\n    21→\n    22→\n    23→class TestStateManager:\n    24→    def test_record_and_load(self, state_mgr):\n    25→        record = CycleRecord(\n    26→            timestamp=time.time(),\n    27→            task_description=\"Fix bug\",\n    28→            success=True,\n    29→            cost_usd=0.05,\n    30→        )\n    31→        state_mgr.record_cycle(record)\n    32→        # Verify file was created\n    33→        assert Path(state_mgr.history_file).exists()\n    34→        data = json.loads(Path(state_mgr.history_file).read_text())\n    35→        assert len(data) == 1\n    36→        assert data[0][\"task_description\"] == \"Fix bug\"\n    37→        assert data[0][\"success\"] is True\n    38→\n    39→    def test_multiple_records(self, state_mgr):\n    40→        for i in range(3):\n    41→            state_mgr.record_cycle(CycleRecord(\n    42→                timestamp=time.time(),\n    43→                task_description=f\"Task {i}\",\n    44→                success=i % 2 == 0,\n    45→            ))\n    46→        data = json.loads(Path(state_mgr.history_file).read_text())\n    47→        assert len(data) == 3\n    48→\n    49→    def test_was_recently_attempted(self, state_mgr):\n    50→        state_mgr.record_cycle(CycleRecord(\n    51→            timestamp=time.time(),\n    52→            task_description=\"Fix bug\",\n    53→        ))\n    54→        assert state_mgr.was_recently_attempted(\"Fix bug\") is True\n    55→        assert state_mgr.was_recently_attempted(\"Other task\") is False\n    56→\n    57→    def test_was_recently_attempted_respects_lookback(self, state_mgr):\n    58→        state_mgr.record_cycle(CycleRecord(\n    59→            timestamp=time.time() - 7200,  # 2 hours ago\n    60→            task_description=\"Old task\",\n    61→        ))\n    62→        assert state_mgr.was_recently_attempted(\"Old task\", lookback_seconds=3600) is False\n    63→\n    64→    def test_get_cycle_count_last_hour(self, state_mgr):\n    65→        now = time.time()\n    66→        for i in range(5):\n    67→            state_mgr.record_cycle(CycleRecord(\n    68→                timestamp=now - i * 60,\n    69→                task_description=f\"Task {i}\",\n    70→            ))\n    71→        # Add one old record\n    72→        state_mgr.record_cycle(CycleRecord(\n    73→            timestamp=now - 7200,\n    74→            task_description=\"Old\",\n    75→        ))\n    76→        assert state_mgr.get_cycle_count_last_hour() == 5\n    77→\n    78→    def test_get_total_cost(self, state_mgr):\n    79→        now = time.time()\n    80→        state_mgr.record_cycle(CycleRecord(\n    81→            timestamp=now, task_description=\"A\", cost_usd=0.10,\n    82→        ))\n    83→        state_mgr.record_cycle(CycleRecord(\n    84→            timestamp=now, task_description=\"B\", cost_usd=0.20,\n    85→        ))\n    86→        assert abs(state_mgr.get_total_cost() - 0.30) < 0.001\n    87→\n    88→    def test_get_consecutive_failures(self, state_mgr):\n    89→        now = time.time()\n    90→        state_mgr.record_cycle(CycleRecord(\n    91→            timestamp=now, task_description=\"A\", success=True,\n    92→        ))\n    93→        state_mgr.record_cycle(CycleRecord(\n    94→            timestamp=now, task_description=\"B\", success=False,\n    95→        ))\n    96→        state_mgr.record_cycle(CycleRecord(\n    97→            timestamp=now, task_description=\"C\", success=False,\n    98→        ))\n    99→        assert state_mgr.get_consecutive_failures() == 2\n   100→\n   101→    def test_consecutive_failures_reset_on_success(self, state_mgr):\n   102→        now = time.time()\n   103→        state_mgr.record_cycle(CycleRecord(\n   104→            timestamp=now, task_description=\"A\", success=False,\n   105→        ))\n   106→        state_mgr.record_cycle(CycleRecord(\n   107→            timestamp=now, task_description=\"B\", success=True,\n   108→        ))\n   109→        assert state_mgr.get_consecutive_failures() == 0\n   110→\n   111→    def test_empty_history(self, state_mgr):\n   112→        assert state_mgr.get_cycle_count_last_hour() == 0\n   113→        assert state_mgr.get_total_cost() == 0.0\n   114→        assert state_mgr.get_consecutive_failures() == 0\n   115→        assert state_mgr.was_recently_attempted(\"anything\") is False\n   116→\n   117→    def test_history_pruning(self, tmp_path, default_config):\n   118→        \"\"\"Verify history is pruned to max_history_records.\"\"\"\n   119→        default_config.paths.history_file = str(tmp_path / \"history.json\")\n   120→        default_config.safety.max_history_records = 10\n   121→        mgr = StateManager(default_config)\n   122→\n   123→        now = time.time()\n   124→        for i in range(25):\n   125→            mgr.record_cycle(CycleRecord(\n   126→                timestamp=now + i,\n   127→                task_description=f\"Task {i}\",\n   128→            ))\n   129→\n   130→        # On-disk file should have at most 10 records\n   131→        data = json.loads(Path(mgr.history_file).read_text())\n   132→        assert len(data) == 10\n   133→        # The most recent records should be preserved (Task 15..24)\n   134→        assert data[0][\"task_description\"] == \"Task 15\"\n   135→        assert data[-1][\"task_description\"] == \"Task 24\"\n   136→\n   137→    def test_cache_invalidation(self, state_mgr):\n   138→        \"\"\"Verify cache is invalidated when file is externally modified.\"\"\"\n   139→        state_mgr.record_cycle(CycleRecord(\n   140→            timestamp=time.time(),\n   141→            task_description=\"Original\",\n   142→        ))\n   143→        assert state_mgr.was_recently_attempted(\"Original\") is True\n   144→\n   145→        # Externally overwrite the history file with different content\n   146→        new_records = [{\"timestamp\": time.time(), \"task_description\": \"External\", \"success\": True}]\n   147→        Path(state_mgr.history_file).write_text(json.dumps(new_records))\n   148→\n   149→        # The cache should detect the mtime change and reload\n   150→        assert state_mgr.was_recently_attempted(\"External\") is True\n   151→        assert state_mgr.was_recently_attempted(\"Original\") is False\n   152→\n   153→    def test_cache_avoids_reread(self, state_mgr):\n   154→        \"\"\"Verify that repeated reads use the cache instead of re-reading from disk.\"\"\"\n   155→        state_mgr.record_cycle(CycleRecord(\n   156→            timestamp=time.time(),\n   157→            task_description=\"Cached task\",\n   158→            success=True,\n   159→            cost_usd=0.05,\n   160→        ))\n   161→\n   162→        # After record_cycle, the cache is populated via _save_history.\n   163→        # Subsequent calls should not re-read the file.\n   164→        with patch.object(Path, 'read_text', wraps=state_mgr.history_file.read_text) as mock_read:\n   165→            state_mgr.was_recently_attempted(\"Cached task\")\n   166→            state_mgr.get_cycle_count_last_hour()\n   167→            state_mgr.get_total_cost()\n   168→            state_mgr.get_consecutive_failures()\n   169→            # None of these should have triggered a file read\n   170→            mock_read.assert_not_called()\n   171→\n   172→    def test_get_task_failure_count_empty(self, state_mgr):\n   173→        assert state_mgr.get_task_failure_count(\"anything\") == 0\n   174→\n   175→    def test_get_task_failure_count_counts_failures(self, state_mgr):\n   176→        now = time.time()\n   177→        state_mgr.record_cycle(CycleRecord(\n   178→            timestamp=now, task_description=\"Fix bug\", task_type=\"feedback\", success=False,\n   179→        ))\n   180→        state_mgr.record_cycle(CycleRecord(\n   181→            timestamp=now, task_description=\"Fix bug\", task_type=\"feedback\", success=False,\n   182→        ))\n   183→        state_mgr.record_cycle(CycleRecord(\n   184→            timestamp=now, task_description=\"Fix bug\", task_type=\"feedback\", success=True,\n   185→        ))\n   186→        assert state_mgr.get_task_failure_count(\"Fix bug\") == 2\n   187→\n   188→    def test_get_task_failure_count_filters_by_type(self, state_mgr):\n   189→        now = time.time()\n   190→        state_mgr.record_cycle(CycleRecord(\n   191→            timestamp=now, task_description=\"Fix bug\", task_type=\"feedback\", success=False,\n   192→        ))\n   193→        state_mgr.record_cycle(CycleRecord(\n   194→            timestamp=now, task_description=\"Fix bug\", task_type=\"test_failure\", success=False,\n   195→        ))\n   196→        assert state_mgr.get_task_failure_count(\"Fix bug\", \"feedback\") == 1\n   197→        assert state_mgr.get_task_failure_count(\"Fix bug\", \"test_failure\") == 1\n   198→        assert state_mgr.get_task_failure_count(\"Fix bug\") == 2\n   199→\n   200→    def test_get_task_failure_count_ignores_other_tasks(self, state_mgr):\n   201→        now = time.time()\n   202→        state_mgr.record_cycle(CycleRecord(\n   203→            timestamp=now, task_description=\"Task A\", task_type=\"feedback\", success=False,\n   204→        ))\n   205→        state_mgr.record_cycle(CycleRecord(\n   206→            timestamp=now, task_description=\"Task B\", task_type=\"feedback\", success=False,\n   207→        ))\n   208→        assert state_mgr.get_task_failure_count(\"Task A\", \"feedback\") == 1\n   209→\n   210→\n   211→class TestBatchCycleRecord:\n   212→    def test_batch_record_stores_descriptions(self, state_mgr):\n   213→        record = CycleRecord(\n   214→            timestamp=time.time(),\n   215→            task_description=\"Fix bug in foo.py\",\n   216→            task_type=\"test_failure\",\n   217→            success=True,\n   218→            task_descriptions=[\"Fix bug in foo.py\", \"Address TODO in bar.py\"],\n   219→            task_types=[\"test_failure\", \"todo\"],\n   220→        )\n   221→        state_mgr.record_cycle(record)\n   222→        data = json.loads(Path(state_mgr.history_file).read_text())\n   223→        assert len(data) == 1\n   224→        assert data[0][\"task_descriptions\"] == [\"Fix bug in foo.py\", \"Address TODO in bar.py\"]\n   225→        assert data[0][\"task_types\"] == [\"test_failure\", \"todo\"]\n   226→\n   227→    def test_was_recently_attempted_checks_batch_descriptions(self, state_mgr):\n   228→        record = CycleRecord(\n   229→            timestamp=time.time(),\n   230→            task_description=\"Fix bug in foo.py\",\n   231→            task_type=\"test_failure\",\n   232→            task_descriptions=[\"Fix bug in foo.py\", \"Address TODO in bar.py\"],\n   233→            task_types=[\"test_failure\", \"todo\"],\n   234→        )\n   235→        state_mgr.record_cycle(record)\n   236→        assert state_mgr.was_recently_attempted(\"Fix bug in foo.py\") is True\n   237→        assert state_mgr.was_recently_attempted(\"Address TODO in bar.py\") is True\n   238→        assert state_mgr.was_recently_attempted(\"Unrelated task\") is False\n   239→\n   240→    def test_backward_compat_old_records(self, state_mgr):\n   241→        \"\"\"Old records without list fields still work correctly.\"\"\"\n   242→        old_record = {\n   243→            \"timestamp\": time.time(),\n   244→            \"task_description\": \"Legacy task\",\n   245→            \"task_type\": \"test_failure\",\n   246→            \"success\": False,\n   247→        }\n   248→        Path(state_mgr.history_file).write_text(json.dumps([old_record]))\n   249→        assert state_mgr.was_recently_attempted(\"Legacy task\") is True\n   250→        assert state_mgr.get_task_failure_count(\"Legacy task\") == 1\n   251→\n   252→    def test_get_task_failure_count_checks_batch(self, state_mgr):\n   253→        record = CycleRecord(\n   254→            timestamp=time.time(),\n   255→            task_description=\"Fix bug in foo.py\",\n   256→            task_type=\"test_failure\",\n   257→            success=False,\n   258→            task_descriptions=[\"Fix bug in foo.py\", \"Address TODO in bar.py\"],\n   259→            task_types=[\"test_failure\", \"todo\"],\n   260→        )\n   261→        state_mgr.record_cycle(record)\n   262→        assert state_mgr.get_task_failure_count(\"Address TODO in bar.py\") == 1\n   263→        assert state_mgr.get_task_failure_count(\"Address TODO in bar.py\", \"todo\") == 1\n   264→        assert state_mgr.get_task_failure_count(\"Address TODO in bar.py\", \"lint\") == 0\n   265→\n   266→    def test_save_history_retries_on_replace_failure(self, state_mgr):\n   267→        \"\"\"_save_history should retry os.replace with exponential backoff.\"\"\"\n   268→        call_count = 0\n   269→        original_replace = os.replace\n   270→\n   271→        def failing_replace(src, dst):\n   272→            nonlocal call_count\n   273→            call_count += 1\n   274→            if call_count < 3:\n   275→                raise OSError(\"file is locked\")\n   276→            return original_replace(src, dst)\n   277→\n   278→        with patch(\"state.os.replace\", side_effect=failing_replace):\n   279→            with patch(\"state.time.sleep\") as mock_sleep:\n   280→                with patch(\"state.random.random\", return_value=0.5):\n   281→                    state_mgr.record_cycle(CycleRecord(\n   282→                        timestamp=time.time(),\n   283→                        task_description=\"Retry test\",\n   284→                        success=True,\n   285→                    ))\n   286→\n   287→        # Should have retried and eventually succeeded\n   288→        assert call_count == 3\n   289→        # Should have slept between retries with exponential backoff + jitter\n   290→        assert mock_sleep.call_count == 2\n   291→        # With random()=0.5, jitter factor is 0.5 + 0.5*0.5 = 0.75\n   292→        # delay0 = 0.1 * 3^0 * 0.75 = 0.075\n   293→        # delay1 = 0.1 * 3^1 * 0.75 = 0.225\n   294→        assert abs(mock_sleep.call_args_list[0][0][0] - 0.075) < 0.01\n   295→        assert abs(mock_sleep.call_args_list[1][0][0] - 0.225) < 0.01\n   296→        # Data should be persisted correctly\n   297→        data = json.loads(Path(state_mgr.history_file).read_text())\n   298→        assert len(data) == 1\n   299→        assert data[0][\"task_description\"] == \"Retry test\"\n   300→\n   301→    def test_save_history_all_retries_fail(self, state_mgr):\n   302→        \"\"\"_save_history should raise OSError when all retries fail.\"\"\"\n   303→        call_count = 0\n   304→\n   305→        def always_fail(src, dst):\n   306→            nonlocal call_count\n   307→            call_count += 1\n   308→            raise OSError(\"permanently locked\")\n   309→\n   310→        with patch(\"state.os.replace\", side_effect=always_fail):\n   311→            with patch(\"state.time.sleep\"):\n   312→                with pytest.raises(OSError, match=\"permanently locked\"):\n   313→                    state_mgr.record_cycle(CycleRecord(\n   314→                        timestamp=time.time(),\n   315→                        task_description=\"Doomed task\",\n   316→                        success=True,\n   317→                    ))\n   318→        # Should have attempted all 7 retries (exponential backoff)\n   319→        assert call_count == 7\n   320→\n   321→\n   322→class TestAdaptiveBatchSize:\n   323→    def test_empty_history_returns_initial(self, state_mgr):\n   324→        assert state_mgr.compute_adaptive_batch_size() == 3\n   325→\n   326→    def test_all_successes_grows_to_max(self, state_mgr):\n   327→        now = time.time()\n   328→        for i in range(20):\n   329→            state_mgr.record_cycle(CycleRecord(\n   330→                timestamp=now + i,\n   331→                task_description=f\"Task {i}\",\n   332→                success=True,\n   333→            ))\n   334→        assert state_mgr.compute_adaptive_batch_size() == 10\n   335→\n   336→    def test_all_failures_shrinks_to_min(self, state_mgr):\n   337→        now = time.time()\n   338→        for i in range(20):\n   339→            state_mgr.record_cycle(CycleRecord(\n   340→                timestamp=now + i,\n   341→                task_description=f\"Task {i}\",\n   342→                success=False,\n   343→            ))\n   344→        assert state_mgr.compute_adaptive_batch_size() == 1\n   345→\n   346→    def test_mixed_results(self, state_mgr):\n   347→        \"\"\"Starting from initial=3: +1(S), +1(S), -2(F), +1(S) -> 3+1+1-2+1=4\"\"\"\n   348→        now = time.time()\n   349→        results = [True, True, False, True]\n   350→        for i, success in enumerate(results):\n   351→            state_mgr.record_cycle(CycleRecord(\n   352→                timestamp=now + i,\n   353→                task_description=f\"Task {i}\",\n   354→                success=success,\n   355→            ))\n   356→        assert state_mgr.compute_adaptive_batch_size() == 4\n   357→\n   358→    def test_window_limits_history(self, tmp_path, default_config):\n   359→        \"\"\"Only the last adaptive_batch_window records should matter.\"\"\"\n   360→        default_config.paths.history_file = str(tmp_path / \"history.json\")\n   361→        default_config.orchestrator.adaptive_batch_window = 3\n   362→        mgr = StateManager(default_config)\n   363→\n   364→        now = time.time()\n   365→        # Write 5 failures (old), then 3 successes (recent)\n   366→        for i in range(5):\n   367→            mgr.record_cycle(CycleRecord(\n   368→                timestamp=now + i,\n   369→                task_description=f\"Fail {i}\",\n   370→                success=False,\n   371→            ))\n   372→        for i in range(3):\n   373→            mgr.record_cycle(CycleRecord(\n   374→                timestamp=now + 5 + i,\n   375→                task_description=f\"Success {i}\",\n   376→                success=True,\n   377→            ))\n   378→        # Window=3 means only the last 3 (all successes) are considered\n   379→        # initial=3 + 1 + 1 + 1 = 6\n   380→        assert mgr.compute_adaptive_batch_size() == 6\n   381→\n   382→    def test_cost_aware_no_grow_above_ceiling(self, tmp_path, default_config):\n   383→        \"\"\"Batch size should not grow when cost exceeds batch_cost_ceiling.\"\"\"\n   384→        default_config.paths.history_file = str(tmp_path / \"history.json\")\n   385→        default_config.orchestrator.batch_cost_ceiling = 5.0\n   386→        mgr = StateManager(default_config)\n   387→\n   388→        now = time.time()\n   389→        # Record successes with high cost\n   390→        for i in range(5):\n   391→            mgr.record_cycle(CycleRecord(\n   392→                timestamp=now + i,\n   393→                task_description=f\"Expensive task {i}\",\n   394→                success=True,\n   395→                cost_usd=6.0,  # Above ceiling\n   396→            ))\n   397→        # initial=3, no growth for any of these (all above ceiling)\n   398→        assert mgr.compute_adaptive_batch_size() == 3\n   399→\n   400→    def test_cost_aware_grows_below_ceiling(self, tmp_path, default_config):\n   401→        \"\"\"Batch size should grow when cost is below batch_cost_ceiling.\"\"\"\n   402→        default_config.paths.history_file = str(tmp_path / \"history.json\")\n   403→        default_config.orchestrator.batch_cost_ceiling = 10.0\n   404→        mgr = StateManager(default_config)\n   405→\n   406→        now = time.time()\n   407→        for i in range(5):\n   408→            mgr.record_cycle(CycleRecord(\n   409→                timestamp=now + i,\n   410→                task_description=f\"Cheap task {i}\",\n   411→                success=True,\n   412→                cost_usd=2.0,  # Below ceiling\n   413→            ))\n   414→        # initial=3 + 5*1 = 8\n   415→        assert mgr.compute_adaptive_batch_size() == 8\n   416→\n   417→    def test_cost_aware_mixed_costs(self, tmp_path, default_config):\n   418→        \"\"\"Mixed cost cycles: cheap ones grow, expensive ones hold steady.\"\"\"\n   419→        default_config.paths.history_file = str(tmp_path / \"history.json\")\n   420→        default_config.orchestrator.batch_cost_ceiling = 5.0\n   421→        mgr = StateManager(default_config)\n   422→\n   423→        now = time.time()\n   424→        # Cheap success (+1), expensive success (hold), cheap success (+1)\n   425→        mgr.record_cycle(CycleRecord(\n   426→            timestamp=now, task_description=\"Cheap\", success=True, cost_usd=2.0,\n   427→        ))\n   428→        mgr.record_cycle(CycleRecord(\n   429→            timestamp=now + 1, task_description=\"Expensive\", success=True, cost_usd=7.0,\n   430→        ))\n   431→        mgr.record_cycle(CycleRecord(\n   432→            timestamp=now + 2, task_description=\"Cheap again\", success=True, cost_usd=1.0,\n   433→        ))\n   434→        # initial=3 + 1 (cheap) + 0 (expensive, held) + 1 (cheap) = 5\n   435→        assert mgr.compute_adaptive_batch_size() == 5\n   436→\n   437→\n   438→class TestKeyBasedDedup:\n   439→    def test_was_recently_attempted_by_key(self, state_mgr):\n   440→        record = CycleRecord(\n   441→            timestamp=time.time(),\n   442→            task_description=\"Fix error handling in safety.py\",\n   443→            task_type=\"claude_idea\",\n   444→            task_keys=[\"claude_idea:safety.py\"],\n   445→        )\n   446→        state_mgr.record_cycle(record)\n   447→        # Different description but same key should match\n   448→        assert state_mgr.was_recently_attempted(\n   449→            \"Improve error handling in safety.py\",\n   450→            task_key=\"claude_idea:safety.py\",\n   451→        ) is True\n   452→        # Same description, no key match\n   453→        assert state_mgr.was_recently_attempted(\"Unrelated task\") is False\n   454→\n   455→    def test_backward_compat_old_records_no_task_keys(self, state_mgr):\n   456→        \"\"\"Old records without task_keys field still work correctly.\"\"\"\n   457→        old_record = {\n   458→            \"timestamp\": time.time(),\n   459→            \"task_description\": \"Legacy task\",\n   460→            \"task_type\": \"test_failure\",\n   461→            \"success\": False,\n   462→        }\n   463→        Path(state_mgr.history_file).write_text(json.dumps([old_record]))\n   464→        assert state_mgr.was_recently_attempted(\"Legacy task\") is True\n   465→        assert state_mgr.was_recently_attempted(\n   466→            \"Different desc\", task_key=\"test_failure:foo.py\"\n   467→        ) is False\n   468→\n   469→    def test_get_task_failure_count_by_key(self, state_mgr):\n   470→        now = time.time()\n   471→        state_mgr.record_cycle(CycleRecord(\n   472→            timestamp=now,\n   473→            task_description=\"Fix bug version 1\",\n   474→            task_type=\"claude_idea\",\n   475→            success=False,\n   476→            task_keys=[\"claude_idea:safety.py\"],\n   477→        ))\n   478→        state_mgr.record_cycle(CycleRecord(\n   479→            timestamp=now + 1,\n   480→            task_description=\"Fix bug version 2\",\n   481→            task_type=\"claude_idea\",\n   482→            success=False,\n   483→            task_keys=[\"claude_idea:safety.py\"],\n   484→        ))\n   485→        # Neither description matches, but key does\n   486→        assert state_mgr.get_task_failure_count(\n   487→            \"Fix bug version 3\", task_key=\"claude_idea:safety.py\"\n   488→        ) == 2\n   489→\n   490→    def test_get_task_failure_count_by_key_with_type_filter(self, state_mgr):\n   491→        now = time.time()\n   492→        state_mgr.record_cycle(CycleRecord(\n   493→            timestamp=now,\n   494→            task_description=\"Some task\",\n   495→            task_type=\"claude_idea\",\n   496→            success=False,\n   497→            task_keys=[\"claude_idea:safety.py\"],\n   498→            task_types=[\"claude_idea\"],\n   499→        ))\n   500→        assert state_mgr.get_task_failure_count(\n   501→            \"Different desc\", \"claude_idea\", task_key=\"claude_idea:safety.py\"\n   502→        ) == 1\n   503→        assert state_mgr.get_task_failure_count(\n   504→            \"Different desc\", \"feedback\", task_key=\"claude_idea:safety.py\"\n   505→        ) == 0\n   506→\n   507→\n   508→class TestFailureRecovery:\n   509→    def test_reset_consecutive_failures(self, state_mgr):\n   510→        \"\"\"Injecting a synthetic success resets the consecutive failure counter.\"\"\"\n   511→        now = time.time()\n   512→        for i in range(5):\n   513→            state_mgr.record_cycle(CycleRecord(\n   514→                timestamp=now + i,\n   515→                task_description=f\"Fail {i}\",\n   516→                success=False,\n   517→            ))\n   518→        assert state_mgr.get_consecutive_failures() == 5\n   519→\n   520→        state_mgr.reset_consecutive_failures(\"test reset\")\n   521→        assert state_mgr.get_consecutive_failures() == 0\n   522→\n   523→        # Verify the synthetic record exists\n   524→        data = json.loads(Path(state_mgr.history_file).read_text())\n   525→        last = data[-1]\n   526→        assert last[\"task_type\"] == \"system_reset\"\n   527→        assert last[\"success\"] is True\n   528→        assert \"test reset\" in last[\"task_description\"]\n   529→\n   530→    def test_auto_reset_after_idle(self, state_mgr):\n   531→        \"\"\"Auto-reset triggers when system has been idle for over min_idle_seconds.\"\"\"\n   532→        old_time = time.time() - 7200  # 2 hours ago\n   533→        for i in range(5):\n   534→            state_mgr.record_cycle(CycleRecord(\n   535→                timestamp=old_time + i,\n   536→                task_description=f\"Fail {i}\",\n   537→                success=False,\n   538→            ))\n   539→        assert state_mgr.get_consecutive_failures() == 5\n   540→        assert state_mgr.should_auto_reset_failures(min_idle_seconds=3600) is True\n   541→\n   542→    def test_no_reset_when_recently_active(self, state_mgr):\n   543→        \"\"\"Auto-reset does NOT trigger when last cycle was recent.\"\"\"\n   544→        now = time.time()\n   545→        for i in range(5):\n   546→            state_mgr.record_cycle(CycleRecord(\n   547→                timestamp=now - 60 + i,  # Very recent\n   548→                task_description=f\"Fail {i}\",\n   549→                success=False,\n   550→            ))\n   551→        assert state_mgr.get_consecutive_failures() == 5\n   552→        assert state_mgr.should_auto_reset_failures(min_idle_seconds=3600) is False\n   553→\n   554→    def test_no_auto_reset_below_limit(self, state_mgr):\n   555→        \"\"\"Auto-reset does NOT trigger when failures are below the limit.\"\"\"\n   556→        old_time = time.time() - 7200\n   557→        for i in range(2):\n   558→            state_mgr.record_cycle(CycleRecord(\n   559→                timestamp=old_time + i,\n   560→                task_description=f\"Fail {i}\",\n   561→                success=False,\n   562→            ))\n   563→        assert state_mgr.get_consecutive_failures() == 2\n   564→        assert state_mgr.should_auto_reset_failures(min_idle_seconds=3600) is False\n   565→\n   566→\n   567→class TestCorruptHistoryBackup:\n   568→    def test_corrupt_history_backed_up(self, state_mgr):\n   569→        \"\"\"Corrupted JSON history file is backed up before returning empty.\"\"\"\n   570→        corrupted_content = \"{this is not valid json!!\"\n   571→        Path(state_mgr.history_file).write_text(corrupted_content)\n   572→\n   573→        result = state_mgr._load_history()\n   574→\n   575→        assert result == []\n   576→        assert state_mgr.get_consecutive_failures() == 0\n   577→        backup_path = Path(str(state_mgr.history_file) + \".corrupt\")\n   578→        assert backup_path.exists()\n   579→        assert backup_path.read_text() == corrupted_content\n   580→\n   581→    def test_corrupt_history_not_destroyed_by_record_cycle(self, state_mgr):\n   582→        \"\"\"record_cycle after corruption preserves the backup and writes new data.\"\"\"\n   583→        corrupted_content = \"{this is not valid json!!\"\n   584→        Path(state_mgr.history_file).write_text(corrupted_content)\n   585→\n   586→        state_mgr.record_cycle(CycleRecord(\n   587→            timestamp=time.time(),\n   588→            task_description=\"New record after corruption\",\n   589→            success=True,\n   590→        ))\n   591→\n   592→        backup_path = Path(str(state_mgr.history_file) + \".corrupt\")\n   593→        assert backup_path.exists()\n   594→        assert backup_path.read_text() == corrupted_content\n   595→\n   596→        data = json.loads(Path(state_mgr.history_file).read_text())\n   597→        assert len(data) == 1\n   598→        assert data[0][\"task_description\"] == \"New record after corruption\"\n   599→\n   600→    def test_corrupt_history_cache_prevents_repeated_backup(self, state_mgr):\n   601→        \"\"\"After first load of corrupted file, cache prevents re-reading on second call.\"\"\"\n   602→        corrupted_content = \"{this is not valid json!!\"\n   603→        Path(state_mgr.history_file).write_text(corrupted_content)\n   604→\n   605→        # First call: triggers backup\n   606→        state_mgr._load_history()\n   607→        backup_path = Path(str(state_mgr.history_file) + \".corrupt\")\n   608→        assert backup_path.exists()\n   609→\n   610→        # Remove backup to verify second call doesn't recreate it\n   611→        backup_path.unlink()\n   612→\n   613→        # Second call: should use cache, not re-read file\n   614→        result = state_mgr._load_history()\n   615→        assert result == []\n   616→        assert not backup_path.exists()  # backup was NOT recreated\n   617→\n   618→\n   619→class TestSaveHistoryFdLeak:\n   620→    def test_save_history_fd_leak_on_fdopen_failure(self, state_mgr):\n   621→        \"\"\"If os.fdopen raises, the raw fd should be explicitly closed.\"\"\"\n   622→        original_mkstemp = tempfile.mkstemp\n   623→\n   624→        # Track the fd allocated by mkstemp\n   625→        allocated_fd = None\n   626→\n   627→        def tracking_mkstemp(**kwargs):\n   628→            nonlocal allocated_fd\n   629→            fd, path = original_mkstemp(**kwargs)\n   630→            allocated_fd = fd\n   631→            return fd, path\n   632→\n   633→        with patch(\"state.tempfile.mkstemp\", side_effect=tracking_mkstemp):\n   634→            with patch(\"state.os.fdopen\", side_effect=OSError(\"fdopen failed\")):\n   635→                with patch(\"state.os.close\") as mock_close:\n   636→                    with pytest.raises(OSError, match=\"fdopen failed\"):\n   637→                        state_mgr._save_history([{\"test\": True}])\n   638→                    # os.close should have been called with the raw fd\n   639→                    mock_close.assert_called_once_with(allocated_fd)\n   640→\n   641→    def test_save_history_json_dump_failure_cleans_up(self, state_mgr):\n   642→        \"\"\"If json.dump raises, temp file is cleaned up and exception propagates.\"\"\"\n   643→        with patch(\"state.json.dump\", side_effect=TypeError(\"not serializable\")):\n   644→            with pytest.raises(TypeError, match=\"not serializable\"):\n   645→                state_mgr._save_history([{\"test\": True}])\n   646→\n   647→        # Verify no leftover .tmp files in the history directory\n   648→        tmp_files = list(Path(state_mgr.history_file).parent.glob(\"*.tmp\"))\n   649→        assert tmp_files == []\n   650→\n   651→\n   652→class TestSaveHistoryENOSPC:\n   653→    def test_save_history_enospc_logs_warning(self, state_mgr, caplog):\n   654→        \"\"\"ENOSPC during save should log a warning and not raise.\"\"\"\n   655→        import logging\n   656→\n   657→        enospc_err = OSError(errno.ENOSPC, \"No space left on device\")\n   658→\n   659→        with patch(\"state.json.dump\", side_effect=enospc_err):\n   660→            with caplog.at_level(logging.WARNING):\n   661→                # Should NOT raise\n   662→                state_mgr._save_history([{\"test\": True}])\n   663→\n   664→        assert any(\"Disk full\" in r.message for r in caplog.records)\n   665→\n   666→    def test_save_history_enospc_cleans_temp_file(self, state_mgr):\n   667→        \"\"\"ENOSPC should clean up the temp file.\"\"\"\n   668→        enospc_err = OSError(errno.ENOSPC, \"No space left on device\")\n   669→\n   670→        with patch(\"state.json.dump\", side_effect=enospc_err):\n   671→            state_mgr._save_history([{\"test\": True}])\n   672→\n   673→        # No temp files should remain\n   674→        tmp_files = list(Path(state_mgr.history_file).parent.glob(\"*.tmp\"))\n   675→        assert tmp_files == []\n   676→\n   677→    def test_save_history_non_enospc_oserror_still_raises(self, state_mgr):\n   678→        \"\"\"Non-ENOSPC OSError should still propagate.\"\"\"\n   679→        perm_err = OSError(errno.EACCES, \"Permission denied\")\n   680→\n   681→        with patch(\"state.json.dump\", side_effect=perm_err):\n   682→            with pytest.raises(OSError, match=\"Permission denied\"):\n   683→                state_mgr._save_history([{\"test\": True}])\n   684→\n   685→\n   686→class TestDiskSpacePreCheck:\n   687→    def test_low_disk_space_skips_save(self, state_mgr, caplog):\n   688→        \"\"\"When disk space is below 10 MB, save should be skipped with a warning.\"\"\"\n   689→        import logging\n   690→        from collections import namedtuple\n   691→\n   692→        DiskUsage = namedtuple(\"DiskUsage\", [\"total\", \"used\", \"free\"])\n   693→        low_space = DiskUsage(total=100 * 1024 * 1024, used=95 * 1024 * 1024, free=5 * 1024 * 1024)\n   694→\n   695→        with patch(\"state.shutil.disk_usage\", return_value=low_space):\n   696→            with caplog.at_level(logging.WARNING):\n   697→                state_mgr._save_history([{\"test\": True}])\n   698→\n   699→        assert any(\"Low disk space\" in r.message for r in caplog.records)\n   700→        # File should NOT have been written\n   701→        assert not Path(state_mgr.history_file).exists()\n   702→\n   703→    def test_sufficient_disk_space_proceeds(self, state_mgr):\n   704→        \"\"\"When disk space is above 10 MB, save should proceed normally.\"\"\"\n   705→        from collections import namedtuple\n   706→\n   707→        DiskUsage = namedtuple(\"DiskUsage\", [\"total\", \"used\", \"free\"])\n   708→        plenty = DiskUsage(total=100 * 1024 * 1024, used=50 * 1024 * 1024, free=50 * 1024 * 1024)\n   709→\n   710→        with patch(\"state.shutil.disk_usage\", return_value=plenty):\n   711→            state_mgr._save_history([{\"task\": \"test\", \"success\": True}])\n   712→\n   713→        assert Path(state_mgr.history_file).exists()\n   714→        data = json.loads(Path(state_mgr.history_file).read_text())\n   715→        assert len(data) == 1\n   716→\n   717→    def test_disk_check_failure_continues(self, state_mgr, caplog):\n   718→        \"\"\"If shutil.disk_usage itself raises, save should still proceed.\"\"\"\n   719→        import logging\n   720→\n   721→        with patch(\"state.shutil.disk_usage\", side_effect=OSError(\"no mount\")):\n   722→            with caplog.at_level(logging.DEBUG):\n   723→                state_mgr._save_history([{\"task\": \"test\", \"success\": True}])\n   724→\n   725→        # Save should have completed despite the disk check failure\n   726→        assert Path(state_mgr.history_file).exists()\n   727→        data = json.loads(Path(state_mgr.history_file).read_text())\n   728→        assert len(data) == 1\n   729→\n   730→\n   731→class TestSaveHistoryRaceDetection:\n   732→    def test_external_modification_logs_warning(self, state_mgr, caplog):\n   733→        \"\"\"Writing after external file modification should log a warning.\"\"\"\n   734→        import logging\n   735→\n   736→        # Write initial record to populate cache and mtime\n   737→        state_mgr.record_cycle(CycleRecord(\n   738→            timestamp=time.time(),\n   739→            task_description=\"First record\",\n   740→            success=True,\n   741→        ))\n   742→\n   743→        # Externally modify the file to change its mtime without going\n   744→        # through StateManager (simulates another process writing)\n   745→        time.sleep(0.05)  # Ensure mtime differs\n   746→        Path(state_mgr.history_file).write_text(\n   747→            json.dumps([{\"timestamp\": time.time(), \"task_description\": \"External\", \"success\": True}])\n   748→        )\n   749→\n   750→        # Directly call _save_history to bypass _load_history (which would\n   751→        # update _cache_mtime). This simulates the race: read happened\n   752→        # before the external modification, write happens after.\n   753→        with caplog.at_level(logging.WARNING):\n   754→            state_mgr._save_history([{\"timestamp\": time.time(), \"task_description\": \"Second\", \"success\": True}])\n   755→\n   756→        assert any(\n   757→            \"modified externally\" in r.message for r in caplog.records\n   758→        )\n   759→\n   760→    def test_no_warning_on_normal_write(self, state_mgr, caplog):\n   761→        \"\"\"Sequential writes without external modification should not warn.\"\"\"\n   762→        import logging\n   763→\n   764→        with caplog.at_level(logging.WARNING):\n   765→            state_mgr.record_cycle(CycleRecord(\n   766→                timestamp=time.time(),\n   767→                task_description=\"Record A\",\n   768→                success=True,\n   769→            ))\n   770→            state_mgr.record_cycle(CycleRecord(\n   771→                timestamp=time.time(),\n   772→                task_description=\"Record B\",\n   773→                success=True,\n   774→            ))\n   775→\n   776→        assert not any(\n   777→            \"modified externally\" in r.message for r in caplog.records\n   778→        )\n   779→\n   780→\n   781→class TestRecentTaskSummaries:\n   782→    def test_empty_history(self, state_mgr):\n   783→        assert state_mgr.get_recent_task_summaries() == []\n   784→\n   785→    def test_returns_recent_tasks(self, state_mgr):\n   786→        now = time.time()\n   787→        state_mgr.record_cycle(CycleRecord(\n   788→            timestamp=now, task_description=\"Fix bug A\", success=True,\n   789→        ))\n   790→        state_mgr.record_cycle(CycleRecord(\n   791→            timestamp=now, task_description=\"Fix bug B\", success=False,\n   792→        ))\n   793→        summaries = state_mgr.get_recent_task_summaries()\n   794→        assert len(summaries) == 2\n   795→        assert \"- Fix bug A (succeeded)\" in summaries[0]\n   796→        assert \"- Fix bug B (failed)\" in summaries[1]\n   797→\n   798→    def test_respects_lookback(self, state_mgr):\n   799→        now = time.time()\n   800→        state_mgr.record_cycle(CycleRecord(\n   801→            timestamp=now - 200000, task_description=\"Old task\", success=True,\n   802→        ))\n   803→        state_mgr.record_cycle(CycleRecord(\n   804→            timestamp=now, task_description=\"Recent task\", success=True,\n   805→        ))\n   806→        summaries = state_mgr.get_recent_task_summaries(lookback_seconds=3600)\n   807→        assert len(summaries) == 1\n   808→        assert \"Recent task\" in summaries[0]\n   809→\n   810→    def test_respects_max_items(self, state_mgr):\n   811→        now = time.time()\n   812→        for i in range(10):\n   813→            state_mgr.record_cycle(CycleRecord(\n   814→                timestamp=now + i, task_description=f\"Task {i}\", success=True,\n   815→            ))\n   816→        summaries = state_mgr.get_recent_task_summaries(max_items=3)\n   817→        assert len(summaries) == 3\n   818→        # Should be the most recent 3\n   819→        assert \"Task 7\" in summaries[0]\n   820→        assert \"Task 8\" in summaries[1]\n   821→        assert \"Task 9\" in summaries[2]\n   822→\n   823→    def test_truncates_long_descriptions(self, state_mgr):\n   824→        now = time.time()\n   825→        long_desc = \"A\" * 150\n   826→        state_mgr.record_cycle(CycleRecord(\n   827→            timestamp=now, task_description=long_desc, success=True,\n   828→        ))\n   829→        summaries = state_mgr.get_recent_task_summaries()\n   830→        assert len(summaries) == 1\n   831→        assert summaries[0].endswith(\"... (succeeded)\")\n   832→        # 97 chars of description + \"...\"\n   833→        assert \"A\" * 97 + \"...\" in summaries[0]\n   834→\n   835→\n   836→class TestSuccessRateByType:\n   837→    def test_empty_history(self, state_mgr):\n   838→        assert state_mgr.get_success_rate_by_type() == {}\n   839→\n   840→    def test_mixed_success_fail(self, state_mgr):\n   841→        now = time.time()\n   842→        for i in range(3):\n   843→            state_mgr.record_cycle(CycleRecord(\n   844→                timestamp=now + i, task_description=f\"Test {i}\",\n   845→                task_type=\"test_failure\", success=(i < 2),\n   846→            ))\n   847→        for i in range(4):\n   848→            state_mgr.record_cycle(CycleRecord(\n   849→                timestamp=now + 10 + i, task_description=f\"Lint {i}\",\n   850→                task_type=\"lint\", success=(i == 0),\n   851→            ))\n   852→        rates = state_mgr.get_success_rate_by_type()\n   853→        assert abs(rates[\"test_failure\"] - 2 / 3) < 0.01\n   854→        assert abs(rates[\"lint\"] - 1 / 4) < 0.01\n   855→\n   856→    def test_respects_lookback(self, state_mgr):\n   857→        now = time.time()\n   858→        # Old record outside lookback window\n   859→        state_mgr.record_cycle(CycleRecord(\n   860→            timestamp=now - 200000, task_description=\"Old\",\n   861→            task_type=\"todo\", success=True,\n   862→        ))\n   863→        state_mgr.record_cycle(CycleRecord(\n   864→            timestamp=now - 200001, task_description=\"Old2\",\n   865→            task_type=\"todo\", success=False,\n   866→        ))\n   867→        # Recent records\n   868→        state_mgr.record_cycle(CycleRecord(\n   869→            timestamp=now, task_description=\"Recent A\",\n   870→            task_type=\"feedback\", success=True,\n   871→        ))\n   872→        state_mgr.record_cycle(CycleRecord(\n   873→            timestamp=now + 1, task_description=\"Recent B\",\n   874→            task_type=\"feedback\", success=True,\n   875→        ))\n   876→        rates = state_mgr.get_success_rate_by_type(lookback_seconds=3600)\n   877→        # Old \"todo\" records should be excluded (outside lookback)\n   878→        assert \"todo\" not in rates\n   879→        assert abs(rates[\"feedback\"] - 1.0) < 0.01\n   880→\n   881→    def test_skips_types_with_fewer_than_two_attempts(self, state_mgr):\n   882→        now = time.time()\n   883→        state_mgr.record_cycle(CycleRecord(\n   884→            timestamp=now, task_description=\"Solo\",\n   885→            task_type=\"rare_type\", success=True,\n   886→        ))\n   887→        state_mgr.record_cycle(CycleRecord(\n   888→            timestamp=now + 1, task_description=\"A\",\n   889→            task_type=\"common_type\", success=True,\n   890→        ))\n   891→        state_mgr.record_cycle(CycleRecord(\n   892→            timestamp=now + 2, task_description=\"B\",\n   893→            task_type=\"common_type\", success=False,\n   894→        ))\n   895→        rates = state_mgr.get_success_rate_by_type()\n   896→        assert \"rare_type\" not in rates\n   897→        assert \"common_type\" in rates\n   898→\n   899→\n   900→class TestStrategyPerformance:\n   901→    def test_empty_history(self, state_mgr):\n   902→        assert state_mgr.get_strategy_performance() == {}\n   903→\n   904→    def test_computes_avg_cost_duration_success_rate(self, state_mgr):\n   905→        now = time.time()\n   906→        state_mgr.record_cycle(CycleRecord(\n   907→            timestamp=now, task_description=\"A\", task_type=\"feedback\",\n   908→            success=True, cost_usd=1.0, duration_seconds=100.0,\n   909→        ))\n   910→        state_mgr.record_cycle(CycleRecord(\n   911→            timestamp=now + 1, task_description=\"B\", task_type=\"feedback\",\n   912→            success=False, cost_usd=3.0, duration_seconds=200.0,\n   913→        ))\n   914→        perf = state_mgr.get_strategy_performance()\n   915→        fb = perf[\"feedback\"]\n   916→        assert fb[\"total\"] == 2\n   917→        assert fb[\"successes\"] == 1\n   918→        assert abs(fb[\"success_rate\"] - 0.5) < 0.01\n   919→        assert abs(fb[\"avg_cost\"] - 2.0) < 0.01\n   920→        assert abs(fb[\"avg_duration\"] - 150.0) < 0.01\n   921→\n   922→    def test_respects_lookback(self, state_mgr):\n   923→        now = time.time()\n   924→        state_mgr.record_cycle(CycleRecord(\n   925→            timestamp=now - 200000, task_description=\"Old\",\n   926→            task_type=\"test_failure\", success=True, cost_usd=5.0,\n   927→        ))\n   928→        state_mgr.record_cycle(CycleRecord(\n   929→            timestamp=now, task_description=\"Recent\",\n   930→            task_type=\"feedback\", success=True, cost_usd=1.0,\n   931→        ))\n   932→        perf = state_mgr.get_strategy_performance(lookback_seconds=3600)\n   933→        assert \"test_failure\" not in perf\n   934→        assert \"feedback\" in perf\n   935→\n   936→    def test_multiple_sources(self, state_mgr):\n   937→        now = time.time()\n   938→        state_mgr.record_cycle(CycleRecord(\n   939→            timestamp=now, task_description=\"A\", task_type=\"feedback\",\n   940→            success=True, cost_usd=1.0, duration_seconds=60.0,\n   941→        ))\n   942→        state_mgr.record_cycle(CycleRecord(\n   943→            timestamp=now + 1, task_description=\"B\", task_type=\"lint\",\n   944→            success=False, cost_usd=0.5, duration_seconds=30.0,\n   945→        ))\n   946→        perf = state_mgr.get_strategy_performance()\n   947→        assert \"feedback\" in perf\n   948→        assert \"lint\" in perf\n   949→        assert perf[\"feedback\"][\"success_rate\"] == 1.0\n   950→        assert perf[\"lint\"][\"success_rate\"] == 0.0\n   951→\n   952→\n   953→class TestProductiveFiles:\n   954→    def test_empty_history(self, state_mgr):\n   955→        assert state_mgr.get_productive_files() == []\n   956→\n   957→    def test_extracts_files_from_descriptions(self, state_mgr):\n   958→        now = time.time()\n   959→        state_mgr.record_cycle(CycleRecord(\n   960→            timestamp=now, task_description=\"Fix bug in safety.py and state.py\",\n   961→            success=True,\n   962→            task_descriptions=[\"Fix bug in safety.py and state.py\"],\n   963→        ))\n   964→        state_mgr.record_cycle(CycleRecord(\n   965→            timestamp=now + 1, task_description=\"Update safety.py error handling\",\n   966→            success=True,\n   967→            task_descriptions=[\"Update safety.py error handling\"],\n   968→        ))\n   969→        files = state_mgr.get_productive_files()\n   970→        assert files[0] == \"safety.py\"  # Most frequent\n   971→        assert \"state.py\" in files\n   972→\n   973→    def test_ignores_failed_cycles(self, state_mgr):\n   974→        now = time.time()\n   975→        state_mgr.record_cycle(CycleRecord(\n   976→            timestamp=now, task_description=\"Fix bug in never_seen.py\",\n   977→            success=False,\n   978→            task_descriptions=[\"Fix bug in never_seen.py\"],\n   979→        ))\n   980→        state_mgr.record_cycle(CycleRecord(\n   981→            timestamp=now + 1, task_description=\"Fix bug in seen.py\",\n   982→            success=True,\n   983→            task_descriptions=[\"Fix bug in seen.py\"],\n   984→        ))\n   985→        files = state_mgr.get_productive_files()\n   986→        assert \"never_seen.py\" not in files\n   987→        assert \"seen.py\" in files\n   988→\n   989→    def test_sorted_by_frequency(self, state_mgr):\n   990→        now = time.time()\n   991→        # a.py mentioned 3 times, b.py mentioned 1 time\n   992→        for i in range(3):\n   993→            state_mgr.record_cycle(CycleRecord(\n   994→                timestamp=now + i, task_description=\"Work on a.py\",\n   995→                success=True,\n   996→                task_descriptions=[\"Work on a.py\"],\n   997→            ))\n   998→        state_mgr.record_cycle(CycleRecord(\n   999→            timestamp=now + 10, task_description=\"Work on b.py\",\n  1000→            success=True,\n  1001→            task_descriptions=[\"Work on b.py\"],\n  1002→        ))\n  1003→        files = state_mgr.get_productive_files()\n  1004→        assert files.index(\"a.py\") < files.index(\"b.py\")\n  1005→\n  1006→    def test_respects_lookback(self, state_mgr):\n  1007→        now = time.time()\n  1008→        state_mgr.record_cycle(CycleRecord(\n  1009→            timestamp=now - 200000, task_description=\"Fix old.py\",\n  1010→            success=True,\n  1011→            task_descriptions=[\"Fix old.py\"],\n  1012→        ))\n  1013→        state_mgr.record_cycle(CycleRecord(\n  1014→            timestamp=now, task_description=\"Fix recent.py\",\n  1015→            success=True,\n  1016→            task_descriptions=[\"Fix recent.py\"],\n  1017→        ))\n  1018→        files = state_mgr.get_productive_files(lookback_seconds=3600)\n  1019→        assert \"old.py\" not in files\n  1020→        assert \"recent.py\" in files\n  1021→"}]},"parent_tool_use_id":null,"session_id":"cdc88a14-e661-4229-849a-8b4c75790bc7","uuid":"dc20d525-37f3-43a4-ba6d-b06d36348b73","tool_use_result":{"type":"text","file":{"filePath":"/Users/sameertkhanna/Documents/auto_claude_code/tests/test_state.py","content":"\"\"\"Tests for state module.\"\"\"\n\nimport errno\nimport json\nimport os\nimport tempfile\nimport time\nfrom pathlib import Path\nfrom unittest.mock import patch\n\nimport pytest\n\nfrom config_schema import Config\nfrom state import CycleRecord, StateManager\n\n\n@pytest.fixture\ndef state_mgr(tmp_path, default_config):\n    default_config.paths.history_file = str(tmp_path / \"history.json\")\n    return StateManager(default_config)\n\n\nclass TestStateManager:\n    def test_record_and_load(self, state_mgr):\n        record = CycleRecord(\n            timestamp=time.time(),\n            task_description=\"Fix bug\",\n            success=True,\n            cost_usd=0.05,\n        )\n        state_mgr.record_cycle(record)\n        # Verify file was created\n        assert Path(state_mgr.history_file).exists()\n        data = json.loads(Path(state_mgr.history_file).read_text())\n        assert len(data) == 1\n        assert data[0][\"task_description\"] == \"Fix bug\"\n        assert data[0][\"success\"] is True\n\n    def test_multiple_records(self, state_mgr):\n        for i in range(3):\n            state_mgr.record_cycle(CycleRecord(\n                timestamp=time.time(),\n                task_description=f\"Task {i}\",\n                success=i % 2 == 0,\n            ))\n        data = json.loads(Path(state_mgr.history_file).read_text())\n        assert len(data) == 3\n\n    def test_was_recently_attempted(self, state_mgr):\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=time.time(),\n            task_description=\"Fix bug\",\n        ))\n        assert state_mgr.was_recently_attempted(\"Fix bug\") is True\n        assert state_mgr.was_recently_attempted(\"Other task\") is False\n\n    def test_was_recently_attempted_respects_lookback(self, state_mgr):\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=time.time() - 7200,  # 2 hours ago\n            task_description=\"Old task\",\n        ))\n        assert state_mgr.was_recently_attempted(\"Old task\", lookback_seconds=3600) is False\n\n    def test_get_cycle_count_last_hour(self, state_mgr):\n        now = time.time()\n        for i in range(5):\n            state_mgr.record_cycle(CycleRecord(\n                timestamp=now - i * 60,\n                task_description=f\"Task {i}\",\n            ))\n        # Add one old record\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now - 7200,\n            task_description=\"Old\",\n        ))\n        assert state_mgr.get_cycle_count_last_hour() == 5\n\n    def test_get_total_cost(self, state_mgr):\n        now = time.time()\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now, task_description=\"A\", cost_usd=0.10,\n        ))\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now, task_description=\"B\", cost_usd=0.20,\n        ))\n        assert abs(state_mgr.get_total_cost() - 0.30) < 0.001\n\n    def test_get_consecutive_failures(self, state_mgr):\n        now = time.time()\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now, task_description=\"A\", success=True,\n        ))\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now, task_description=\"B\", success=False,\n        ))\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now, task_description=\"C\", success=False,\n        ))\n        assert state_mgr.get_consecutive_failures() == 2\n\n    def test_consecutive_failures_reset_on_success(self, state_mgr):\n        now = time.time()\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now, task_description=\"A\", success=False,\n        ))\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now, task_description=\"B\", success=True,\n        ))\n        assert state_mgr.get_consecutive_failures() == 0\n\n    def test_empty_history(self, state_mgr):\n        assert state_mgr.get_cycle_count_last_hour() == 0\n        assert state_mgr.get_total_cost() == 0.0\n        assert state_mgr.get_consecutive_failures() == 0\n        assert state_mgr.was_recently_attempted(\"anything\") is False\n\n    def test_history_pruning(self, tmp_path, default_config):\n        \"\"\"Verify history is pruned to max_history_records.\"\"\"\n        default_config.paths.history_file = str(tmp_path / \"history.json\")\n        default_config.safety.max_history_records = 10\n        mgr = StateManager(default_config)\n\n        now = time.time()\n        for i in range(25):\n            mgr.record_cycle(CycleRecord(\n                timestamp=now + i,\n                task_description=f\"Task {i}\",\n            ))\n\n        # On-disk file should have at most 10 records\n        data = json.loads(Path(mgr.history_file).read_text())\n        assert len(data) == 10\n        # The most recent records should be preserved (Task 15..24)\n        assert data[0][\"task_description\"] == \"Task 15\"\n        assert data[-1][\"task_description\"] == \"Task 24\"\n\n    def test_cache_invalidation(self, state_mgr):\n        \"\"\"Verify cache is invalidated when file is externally modified.\"\"\"\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=time.time(),\n            task_description=\"Original\",\n        ))\n        assert state_mgr.was_recently_attempted(\"Original\") is True\n\n        # Externally overwrite the history file with different content\n        new_records = [{\"timestamp\": time.time(), \"task_description\": \"External\", \"success\": True}]\n        Path(state_mgr.history_file).write_text(json.dumps(new_records))\n\n        # The cache should detect the mtime change and reload\n        assert state_mgr.was_recently_attempted(\"External\") is True\n        assert state_mgr.was_recently_attempted(\"Original\") is False\n\n    def test_cache_avoids_reread(self, state_mgr):\n        \"\"\"Verify that repeated reads use the cache instead of re-reading from disk.\"\"\"\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=time.time(),\n            task_description=\"Cached task\",\n            success=True,\n            cost_usd=0.05,\n        ))\n\n        # After record_cycle, the cache is populated via _save_history.\n        # Subsequent calls should not re-read the file.\n        with patch.object(Path, 'read_text', wraps=state_mgr.history_file.read_text) as mock_read:\n            state_mgr.was_recently_attempted(\"Cached task\")\n            state_mgr.get_cycle_count_last_hour()\n            state_mgr.get_total_cost()\n            state_mgr.get_consecutive_failures()\n            # None of these should have triggered a file read\n            mock_read.assert_not_called()\n\n    def test_get_task_failure_count_empty(self, state_mgr):\n        assert state_mgr.get_task_failure_count(\"anything\") == 0\n\n    def test_get_task_failure_count_counts_failures(self, state_mgr):\n        now = time.time()\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now, task_description=\"Fix bug\", task_type=\"feedback\", success=False,\n        ))\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now, task_description=\"Fix bug\", task_type=\"feedback\", success=False,\n        ))\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now, task_description=\"Fix bug\", task_type=\"feedback\", success=True,\n        ))\n        assert state_mgr.get_task_failure_count(\"Fix bug\") == 2\n\n    def test_get_task_failure_count_filters_by_type(self, state_mgr):\n        now = time.time()\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now, task_description=\"Fix bug\", task_type=\"feedback\", success=False,\n        ))\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now, task_description=\"Fix bug\", task_type=\"test_failure\", success=False,\n        ))\n        assert state_mgr.get_task_failure_count(\"Fix bug\", \"feedback\") == 1\n        assert state_mgr.get_task_failure_count(\"Fix bug\", \"test_failure\") == 1\n        assert state_mgr.get_task_failure_count(\"Fix bug\") == 2\n\n    def test_get_task_failure_count_ignores_other_tasks(self, state_mgr):\n        now = time.time()\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now, task_description=\"Task A\", task_type=\"feedback\", success=False,\n        ))\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now, task_description=\"Task B\", task_type=\"feedback\", success=False,\n        ))\n        assert state_mgr.get_task_failure_count(\"Task A\", \"feedback\") == 1\n\n\nclass TestBatchCycleRecord:\n    def test_batch_record_stores_descriptions(self, state_mgr):\n        record = CycleRecord(\n            timestamp=time.time(),\n            task_description=\"Fix bug in foo.py\",\n            task_type=\"test_failure\",\n            success=True,\n            task_descriptions=[\"Fix bug in foo.py\", \"Address TODO in bar.py\"],\n            task_types=[\"test_failure\", \"todo\"],\n        )\n        state_mgr.record_cycle(record)\n        data = json.loads(Path(state_mgr.history_file).read_text())\n        assert len(data) == 1\n        assert data[0][\"task_descriptions\"] == [\"Fix bug in foo.py\", \"Address TODO in bar.py\"]\n        assert data[0][\"task_types\"] == [\"test_failure\", \"todo\"]\n\n    def test_was_recently_attempted_checks_batch_descriptions(self, state_mgr):\n        record = CycleRecord(\n            timestamp=time.time(),\n            task_description=\"Fix bug in foo.py\",\n            task_type=\"test_failure\",\n            task_descriptions=[\"Fix bug in foo.py\", \"Address TODO in bar.py\"],\n            task_types=[\"test_failure\", \"todo\"],\n        )\n        state_mgr.record_cycle(record)\n        assert state_mgr.was_recently_attempted(\"Fix bug in foo.py\") is True\n        assert state_mgr.was_recently_attempted(\"Address TODO in bar.py\") is True\n        assert state_mgr.was_recently_attempted(\"Unrelated task\") is False\n\n    def test_backward_compat_old_records(self, state_mgr):\n        \"\"\"Old records without list fields still work correctly.\"\"\"\n        old_record = {\n            \"timestamp\": time.time(),\n            \"task_description\": \"Legacy task\",\n            \"task_type\": \"test_failure\",\n            \"success\": False,\n        }\n        Path(state_mgr.history_file).write_text(json.dumps([old_record]))\n        assert state_mgr.was_recently_attempted(\"Legacy task\") is True\n        assert state_mgr.get_task_failure_count(\"Legacy task\") == 1\n\n    def test_get_task_failure_count_checks_batch(self, state_mgr):\n        record = CycleRecord(\n            timestamp=time.time(),\n            task_description=\"Fix bug in foo.py\",\n            task_type=\"test_failure\",\n            success=False,\n            task_descriptions=[\"Fix bug in foo.py\", \"Address TODO in bar.py\"],\n            task_types=[\"test_failure\", \"todo\"],\n        )\n        state_mgr.record_cycle(record)\n        assert state_mgr.get_task_failure_count(\"Address TODO in bar.py\") == 1\n        assert state_mgr.get_task_failure_count(\"Address TODO in bar.py\", \"todo\") == 1\n        assert state_mgr.get_task_failure_count(\"Address TODO in bar.py\", \"lint\") == 0\n\n    def test_save_history_retries_on_replace_failure(self, state_mgr):\n        \"\"\"_save_history should retry os.replace with exponential backoff.\"\"\"\n        call_count = 0\n        original_replace = os.replace\n\n        def failing_replace(src, dst):\n            nonlocal call_count\n            call_count += 1\n            if call_count < 3:\n                raise OSError(\"file is locked\")\n            return original_replace(src, dst)\n\n        with patch(\"state.os.replace\", side_effect=failing_replace):\n            with patch(\"state.time.sleep\") as mock_sleep:\n                with patch(\"state.random.random\", return_value=0.5):\n                    state_mgr.record_cycle(CycleRecord(\n                        timestamp=time.time(),\n                        task_description=\"Retry test\",\n                        success=True,\n                    ))\n\n        # Should have retried and eventually succeeded\n        assert call_count == 3\n        # Should have slept between retries with exponential backoff + jitter\n        assert mock_sleep.call_count == 2\n        # With random()=0.5, jitter factor is 0.5 + 0.5*0.5 = 0.75\n        # delay0 = 0.1 * 3^0 * 0.75 = 0.075\n        # delay1 = 0.1 * 3^1 * 0.75 = 0.225\n        assert abs(mock_sleep.call_args_list[0][0][0] - 0.075) < 0.01\n        assert abs(mock_sleep.call_args_list[1][0][0] - 0.225) < 0.01\n        # Data should be persisted correctly\n        data = json.loads(Path(state_mgr.history_file).read_text())\n        assert len(data) == 1\n        assert data[0][\"task_description\"] == \"Retry test\"\n\n    def test_save_history_all_retries_fail(self, state_mgr):\n        \"\"\"_save_history should raise OSError when all retries fail.\"\"\"\n        call_count = 0\n\n        def always_fail(src, dst):\n            nonlocal call_count\n            call_count += 1\n            raise OSError(\"permanently locked\")\n\n        with patch(\"state.os.replace\", side_effect=always_fail):\n            with patch(\"state.time.sleep\"):\n                with pytest.raises(OSError, match=\"permanently locked\"):\n                    state_mgr.record_cycle(CycleRecord(\n                        timestamp=time.time(),\n                        task_description=\"Doomed task\",\n                        success=True,\n                    ))\n        # Should have attempted all 7 retries (exponential backoff)\n        assert call_count == 7\n\n\nclass TestAdaptiveBatchSize:\n    def test_empty_history_returns_initial(self, state_mgr):\n        assert state_mgr.compute_adaptive_batch_size() == 3\n\n    def test_all_successes_grows_to_max(self, state_mgr):\n        now = time.time()\n        for i in range(20):\n            state_mgr.record_cycle(CycleRecord(\n                timestamp=now + i,\n                task_description=f\"Task {i}\",\n                success=True,\n            ))\n        assert state_mgr.compute_adaptive_batch_size() == 10\n\n    def test_all_failures_shrinks_to_min(self, state_mgr):\n        now = time.time()\n        for i in range(20):\n            state_mgr.record_cycle(CycleRecord(\n                timestamp=now + i,\n                task_description=f\"Task {i}\",\n                success=False,\n            ))\n        assert state_mgr.compute_adaptive_batch_size() == 1\n\n    def test_mixed_results(self, state_mgr):\n        \"\"\"Starting from initial=3: +1(S), +1(S), -2(F), +1(S) -> 3+1+1-2+1=4\"\"\"\n        now = time.time()\n        results = [True, True, False, True]\n        for i, success in enumerate(results):\n            state_mgr.record_cycle(CycleRecord(\n                timestamp=now + i,\n                task_description=f\"Task {i}\",\n                success=success,\n            ))\n        assert state_mgr.compute_adaptive_batch_size() == 4\n\n    def test_window_limits_history(self, tmp_path, default_config):\n        \"\"\"Only the last adaptive_batch_window records should matter.\"\"\"\n        default_config.paths.history_file = str(tmp_path / \"history.json\")\n        default_config.orchestrator.adaptive_batch_window = 3\n        mgr = StateManager(default_config)\n\n        now = time.time()\n        # Write 5 failures (old), then 3 successes (recent)\n        for i in range(5):\n            mgr.record_cycle(CycleRecord(\n                timestamp=now + i,\n                task_description=f\"Fail {i}\",\n                success=False,\n            ))\n        for i in range(3):\n            mgr.record_cycle(CycleRecord(\n                timestamp=now + 5 + i,\n                task_description=f\"Success {i}\",\n                success=True,\n            ))\n        # Window=3 means only the last 3 (all successes) are considered\n        # initial=3 + 1 + 1 + 1 = 6\n        assert mgr.compute_adaptive_batch_size() == 6\n\n    def test_cost_aware_no_grow_above_ceiling(self, tmp_path, default_config):\n        \"\"\"Batch size should not grow when cost exceeds batch_cost_ceiling.\"\"\"\n        default_config.paths.history_file = str(tmp_path / \"history.json\")\n        default_config.orchestrator.batch_cost_ceiling = 5.0\n        mgr = StateManager(default_config)\n\n        now = time.time()\n        # Record successes with high cost\n        for i in range(5):\n            mgr.record_cycle(CycleRecord(\n                timestamp=now + i,\n                task_description=f\"Expensive task {i}\",\n                success=True,\n                cost_usd=6.0,  # Above ceiling\n            ))\n        # initial=3, no growth for any of these (all above ceiling)\n        assert mgr.compute_adaptive_batch_size() == 3\n\n    def test_cost_aware_grows_below_ceiling(self, tmp_path, default_config):\n        \"\"\"Batch size should grow when cost is below batch_cost_ceiling.\"\"\"\n        default_config.paths.history_file = str(tmp_path / \"history.json\")\n        default_config.orchestrator.batch_cost_ceiling = 10.0\n        mgr = StateManager(default_config)\n\n        now = time.time()\n        for i in range(5):\n            mgr.record_cycle(CycleRecord(\n                timestamp=now + i,\n                task_description=f\"Cheap task {i}\",\n                success=True,\n                cost_usd=2.0,  # Below ceiling\n            ))\n        # initial=3 + 5*1 = 8\n        assert mgr.compute_adaptive_batch_size() == 8\n\n    def test_cost_aware_mixed_costs(self, tmp_path, default_config):\n        \"\"\"Mixed cost cycles: cheap ones grow, expensive ones hold steady.\"\"\"\n        default_config.paths.history_file = str(tmp_path / \"history.json\")\n        default_config.orchestrator.batch_cost_ceiling = 5.0\n        mgr = StateManager(default_config)\n\n        now = time.time()\n        # Cheap success (+1), expensive success (hold), cheap success (+1)\n        mgr.record_cycle(CycleRecord(\n            timestamp=now, task_description=\"Cheap\", success=True, cost_usd=2.0,\n        ))\n        mgr.record_cycle(CycleRecord(\n            timestamp=now + 1, task_description=\"Expensive\", success=True, cost_usd=7.0,\n        ))\n        mgr.record_cycle(CycleRecord(\n            timestamp=now + 2, task_description=\"Cheap again\", success=True, cost_usd=1.0,\n        ))\n        # initial=3 + 1 (cheap) + 0 (expensive, held) + 1 (cheap) = 5\n        assert mgr.compute_adaptive_batch_size() == 5\n\n\nclass TestKeyBasedDedup:\n    def test_was_recently_attempted_by_key(self, state_mgr):\n        record = CycleRecord(\n            timestamp=time.time(),\n            task_description=\"Fix error handling in safety.py\",\n            task_type=\"claude_idea\",\n            task_keys=[\"claude_idea:safety.py\"],\n        )\n        state_mgr.record_cycle(record)\n        # Different description but same key should match\n        assert state_mgr.was_recently_attempted(\n            \"Improve error handling in safety.py\",\n            task_key=\"claude_idea:safety.py\",\n        ) is True\n        # Same description, no key match\n        assert state_mgr.was_recently_attempted(\"Unrelated task\") is False\n\n    def test_backward_compat_old_records_no_task_keys(self, state_mgr):\n        \"\"\"Old records without task_keys field still work correctly.\"\"\"\n        old_record = {\n            \"timestamp\": time.time(),\n            \"task_description\": \"Legacy task\",\n            \"task_type\": \"test_failure\",\n            \"success\": False,\n        }\n        Path(state_mgr.history_file).write_text(json.dumps([old_record]))\n        assert state_mgr.was_recently_attempted(\"Legacy task\") is True\n        assert state_mgr.was_recently_attempted(\n            \"Different desc\", task_key=\"test_failure:foo.py\"\n        ) is False\n\n    def test_get_task_failure_count_by_key(self, state_mgr):\n        now = time.time()\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now,\n            task_description=\"Fix bug version 1\",\n            task_type=\"claude_idea\",\n            success=False,\n            task_keys=[\"claude_idea:safety.py\"],\n        ))\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now + 1,\n            task_description=\"Fix bug version 2\",\n            task_type=\"claude_idea\",\n            success=False,\n            task_keys=[\"claude_idea:safety.py\"],\n        ))\n        # Neither description matches, but key does\n        assert state_mgr.get_task_failure_count(\n            \"Fix bug version 3\", task_key=\"claude_idea:safety.py\"\n        ) == 2\n\n    def test_get_task_failure_count_by_key_with_type_filter(self, state_mgr):\n        now = time.time()\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now,\n            task_description=\"Some task\",\n            task_type=\"claude_idea\",\n            success=False,\n            task_keys=[\"claude_idea:safety.py\"],\n            task_types=[\"claude_idea\"],\n        ))\n        assert state_mgr.get_task_failure_count(\n            \"Different desc\", \"claude_idea\", task_key=\"claude_idea:safety.py\"\n        ) == 1\n        assert state_mgr.get_task_failure_count(\n            \"Different desc\", \"feedback\", task_key=\"claude_idea:safety.py\"\n        ) == 0\n\n\nclass TestFailureRecovery:\n    def test_reset_consecutive_failures(self, state_mgr):\n        \"\"\"Injecting a synthetic success resets the consecutive failure counter.\"\"\"\n        now = time.time()\n        for i in range(5):\n            state_mgr.record_cycle(CycleRecord(\n                timestamp=now + i,\n                task_description=f\"Fail {i}\",\n                success=False,\n            ))\n        assert state_mgr.get_consecutive_failures() == 5\n\n        state_mgr.reset_consecutive_failures(\"test reset\")\n        assert state_mgr.get_consecutive_failures() == 0\n\n        # Verify the synthetic record exists\n        data = json.loads(Path(state_mgr.history_file).read_text())\n        last = data[-1]\n        assert last[\"task_type\"] == \"system_reset\"\n        assert last[\"success\"] is True\n        assert \"test reset\" in last[\"task_description\"]\n\n    def test_auto_reset_after_idle(self, state_mgr):\n        \"\"\"Auto-reset triggers when system has been idle for over min_idle_seconds.\"\"\"\n        old_time = time.time() - 7200  # 2 hours ago\n        for i in range(5):\n            state_mgr.record_cycle(CycleRecord(\n                timestamp=old_time + i,\n                task_description=f\"Fail {i}\",\n                success=False,\n            ))\n        assert state_mgr.get_consecutive_failures() == 5\n        assert state_mgr.should_auto_reset_failures(min_idle_seconds=3600) is True\n\n    def test_no_reset_when_recently_active(self, state_mgr):\n        \"\"\"Auto-reset does NOT trigger when last cycle was recent.\"\"\"\n        now = time.time()\n        for i in range(5):\n            state_mgr.record_cycle(CycleRecord(\n                timestamp=now - 60 + i,  # Very recent\n                task_description=f\"Fail {i}\",\n                success=False,\n            ))\n        assert state_mgr.get_consecutive_failures() == 5\n        assert state_mgr.should_auto_reset_failures(min_idle_seconds=3600) is False\n\n    def test_no_auto_reset_below_limit(self, state_mgr):\n        \"\"\"Auto-reset does NOT trigger when failures are below the limit.\"\"\"\n        old_time = time.time() - 7200\n        for i in range(2):\n            state_mgr.record_cycle(CycleRecord(\n                timestamp=old_time + i,\n                task_description=f\"Fail {i}\",\n                success=False,\n            ))\n        assert state_mgr.get_consecutive_failures() == 2\n        assert state_mgr.should_auto_reset_failures(min_idle_seconds=3600) is False\n\n\nclass TestCorruptHistoryBackup:\n    def test_corrupt_history_backed_up(self, state_mgr):\n        \"\"\"Corrupted JSON history file is backed up before returning empty.\"\"\"\n        corrupted_content = \"{this is not valid json!!\"\n        Path(state_mgr.history_file).write_text(corrupted_content)\n\n        result = state_mgr._load_history()\n\n        assert result == []\n        assert state_mgr.get_consecutive_failures() == 0\n        backup_path = Path(str(state_mgr.history_file) + \".corrupt\")\n        assert backup_path.exists()\n        assert backup_path.read_text() == corrupted_content\n\n    def test_corrupt_history_not_destroyed_by_record_cycle(self, state_mgr):\n        \"\"\"record_cycle after corruption preserves the backup and writes new data.\"\"\"\n        corrupted_content = \"{this is not valid json!!\"\n        Path(state_mgr.history_file).write_text(corrupted_content)\n\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=time.time(),\n            task_description=\"New record after corruption\",\n            success=True,\n        ))\n\n        backup_path = Path(str(state_mgr.history_file) + \".corrupt\")\n        assert backup_path.exists()\n        assert backup_path.read_text() == corrupted_content\n\n        data = json.loads(Path(state_mgr.history_file).read_text())\n        assert len(data) == 1\n        assert data[0][\"task_description\"] == \"New record after corruption\"\n\n    def test_corrupt_history_cache_prevents_repeated_backup(self, state_mgr):\n        \"\"\"After first load of corrupted file, cache prevents re-reading on second call.\"\"\"\n        corrupted_content = \"{this is not valid json!!\"\n        Path(state_mgr.history_file).write_text(corrupted_content)\n\n        # First call: triggers backup\n        state_mgr._load_history()\n        backup_path = Path(str(state_mgr.history_file) + \".corrupt\")\n        assert backup_path.exists()\n\n        # Remove backup to verify second call doesn't recreate it\n        backup_path.unlink()\n\n        # Second call: should use cache, not re-read file\n        result = state_mgr._load_history()\n        assert result == []\n        assert not backup_path.exists()  # backup was NOT recreated\n\n\nclass TestSaveHistoryFdLeak:\n    def test_save_history_fd_leak_on_fdopen_failure(self, state_mgr):\n        \"\"\"If os.fdopen raises, the raw fd should be explicitly closed.\"\"\"\n        original_mkstemp = tempfile.mkstemp\n\n        # Track the fd allocated by mkstemp\n        allocated_fd = None\n\n        def tracking_mkstemp(**kwargs):\n            nonlocal allocated_fd\n            fd, path = original_mkstemp(**kwargs)\n            allocated_fd = fd\n            return fd, path\n\n        with patch(\"state.tempfile.mkstemp\", side_effect=tracking_mkstemp):\n            with patch(\"state.os.fdopen\", side_effect=OSError(\"fdopen failed\")):\n                with patch(\"state.os.close\") as mock_close:\n                    with pytest.raises(OSError, match=\"fdopen failed\"):\n                        state_mgr._save_history([{\"test\": True}])\n                    # os.close should have been called with the raw fd\n                    mock_close.assert_called_once_with(allocated_fd)\n\n    def test_save_history_json_dump_failure_cleans_up(self, state_mgr):\n        \"\"\"If json.dump raises, temp file is cleaned up and exception propagates.\"\"\"\n        with patch(\"state.json.dump\", side_effect=TypeError(\"not serializable\")):\n            with pytest.raises(TypeError, match=\"not serializable\"):\n                state_mgr._save_history([{\"test\": True}])\n\n        # Verify no leftover .tmp files in the history directory\n        tmp_files = list(Path(state_mgr.history_file).parent.glob(\"*.tmp\"))\n        assert tmp_files == []\n\n\nclass TestSaveHistoryENOSPC:\n    def test_save_history_enospc_logs_warning(self, state_mgr, caplog):\n        \"\"\"ENOSPC during save should log a warning and not raise.\"\"\"\n        import logging\n\n        enospc_err = OSError(errno.ENOSPC, \"No space left on device\")\n\n        with patch(\"state.json.dump\", side_effect=enospc_err):\n            with caplog.at_level(logging.WARNING):\n                # Should NOT raise\n                state_mgr._save_history([{\"test\": True}])\n\n        assert any(\"Disk full\" in r.message for r in caplog.records)\n\n    def test_save_history_enospc_cleans_temp_file(self, state_mgr):\n        \"\"\"ENOSPC should clean up the temp file.\"\"\"\n        enospc_err = OSError(errno.ENOSPC, \"No space left on device\")\n\n        with patch(\"state.json.dump\", side_effect=enospc_err):\n            state_mgr._save_history([{\"test\": True}])\n\n        # No temp files should remain\n        tmp_files = list(Path(state_mgr.history_file).parent.glob(\"*.tmp\"))\n        assert tmp_files == []\n\n    def test_save_history_non_enospc_oserror_still_raises(self, state_mgr):\n        \"\"\"Non-ENOSPC OSError should still propagate.\"\"\"\n        perm_err = OSError(errno.EACCES, \"Permission denied\")\n\n        with patch(\"state.json.dump\", side_effect=perm_err):\n            with pytest.raises(OSError, match=\"Permission denied\"):\n                state_mgr._save_history([{\"test\": True}])\n\n\nclass TestDiskSpacePreCheck:\n    def test_low_disk_space_skips_save(self, state_mgr, caplog):\n        \"\"\"When disk space is below 10 MB, save should be skipped with a warning.\"\"\"\n        import logging\n        from collections import namedtuple\n\n        DiskUsage = namedtuple(\"DiskUsage\", [\"total\", \"used\", \"free\"])\n        low_space = DiskUsage(total=100 * 1024 * 1024, used=95 * 1024 * 1024, free=5 * 1024 * 1024)\n\n        with patch(\"state.shutil.disk_usage\", return_value=low_space):\n            with caplog.at_level(logging.WARNING):\n                state_mgr._save_history([{\"test\": True}])\n\n        assert any(\"Low disk space\" in r.message for r in caplog.records)\n        # File should NOT have been written\n        assert not Path(state_mgr.history_file).exists()\n\n    def test_sufficient_disk_space_proceeds(self, state_mgr):\n        \"\"\"When disk space is above 10 MB, save should proceed normally.\"\"\"\n        from collections import namedtuple\n\n        DiskUsage = namedtuple(\"DiskUsage\", [\"total\", \"used\", \"free\"])\n        plenty = DiskUsage(total=100 * 1024 * 1024, used=50 * 1024 * 1024, free=50 * 1024 * 1024)\n\n        with patch(\"state.shutil.disk_usage\", return_value=plenty):\n            state_mgr._save_history([{\"task\": \"test\", \"success\": True}])\n\n        assert Path(state_mgr.history_file).exists()\n        data = json.loads(Path(state_mgr.history_file).read_text())\n        assert len(data) == 1\n\n    def test_disk_check_failure_continues(self, state_mgr, caplog):\n        \"\"\"If shutil.disk_usage itself raises, save should still proceed.\"\"\"\n        import logging\n\n        with patch(\"state.shutil.disk_usage\", side_effect=OSError(\"no mount\")):\n            with caplog.at_level(logging.DEBUG):\n                state_mgr._save_history([{\"task\": \"test\", \"success\": True}])\n\n        # Save should have completed despite the disk check failure\n        assert Path(state_mgr.history_file).exists()\n        data = json.loads(Path(state_mgr.history_file).read_text())\n        assert len(data) == 1\n\n\nclass TestSaveHistoryRaceDetection:\n    def test_external_modification_logs_warning(self, state_mgr, caplog):\n        \"\"\"Writing after external file modification should log a warning.\"\"\"\n        import logging\n\n        # Write initial record to populate cache and mtime\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=time.time(),\n            task_description=\"First record\",\n            success=True,\n        ))\n\n        # Externally modify the file to change its mtime without going\n        # through StateManager (simulates another process writing)\n        time.sleep(0.05)  # Ensure mtime differs\n        Path(state_mgr.history_file).write_text(\n            json.dumps([{\"timestamp\": time.time(), \"task_description\": \"External\", \"success\": True}])\n        )\n\n        # Directly call _save_history to bypass _load_history (which would\n        # update _cache_mtime). This simulates the race: read happened\n        # before the external modification, write happens after.\n        with caplog.at_level(logging.WARNING):\n            state_mgr._save_history([{\"timestamp\": time.time(), \"task_description\": \"Second\", \"success\": True}])\n\n        assert any(\n            \"modified externally\" in r.message for r in caplog.records\n        )\n\n    def test_no_warning_on_normal_write(self, state_mgr, caplog):\n        \"\"\"Sequential writes without external modification should not warn.\"\"\"\n        import logging\n\n        with caplog.at_level(logging.WARNING):\n            state_mgr.record_cycle(CycleRecord(\n                timestamp=time.time(),\n                task_description=\"Record A\",\n                success=True,\n            ))\n            state_mgr.record_cycle(CycleRecord(\n                timestamp=time.time(),\n                task_description=\"Record B\",\n                success=True,\n            ))\n\n        assert not any(\n            \"modified externally\" in r.message for r in caplog.records\n        )\n\n\nclass TestRecentTaskSummaries:\n    def test_empty_history(self, state_mgr):\n        assert state_mgr.get_recent_task_summaries() == []\n\n    def test_returns_recent_tasks(self, state_mgr):\n        now = time.time()\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now, task_description=\"Fix bug A\", success=True,\n        ))\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now, task_description=\"Fix bug B\", success=False,\n        ))\n        summaries = state_mgr.get_recent_task_summaries()\n        assert len(summaries) == 2\n        assert \"- Fix bug A (succeeded)\" in summaries[0]\n        assert \"- Fix bug B (failed)\" in summaries[1]\n\n    def test_respects_lookback(self, state_mgr):\n        now = time.time()\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now - 200000, task_description=\"Old task\", success=True,\n        ))\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now, task_description=\"Recent task\", success=True,\n        ))\n        summaries = state_mgr.get_recent_task_summaries(lookback_seconds=3600)\n        assert len(summaries) == 1\n        assert \"Recent task\" in summaries[0]\n\n    def test_respects_max_items(self, state_mgr):\n        now = time.time()\n        for i in range(10):\n            state_mgr.record_cycle(CycleRecord(\n                timestamp=now + i, task_description=f\"Task {i}\", success=True,\n            ))\n        summaries = state_mgr.get_recent_task_summaries(max_items=3)\n        assert len(summaries) == 3\n        # Should be the most recent 3\n        assert \"Task 7\" in summaries[0]\n        assert \"Task 8\" in summaries[1]\n        assert \"Task 9\" in summaries[2]\n\n    def test_truncates_long_descriptions(self, state_mgr):\n        now = time.time()\n        long_desc = \"A\" * 150\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now, task_description=long_desc, success=True,\n        ))\n        summaries = state_mgr.get_recent_task_summaries()\n        assert len(summaries) == 1\n        assert summaries[0].endswith(\"... (succeeded)\")\n        # 97 chars of description + \"...\"\n        assert \"A\" * 97 + \"...\" in summaries[0]\n\n\nclass TestSuccessRateByType:\n    def test_empty_history(self, state_mgr):\n        assert state_mgr.get_success_rate_by_type() == {}\n\n    def test_mixed_success_fail(self, state_mgr):\n        now = time.time()\n        for i in range(3):\n            state_mgr.record_cycle(CycleRecord(\n                timestamp=now + i, task_description=f\"Test {i}\",\n                task_type=\"test_failure\", success=(i < 2),\n            ))\n        for i in range(4):\n            state_mgr.record_cycle(CycleRecord(\n                timestamp=now + 10 + i, task_description=f\"Lint {i}\",\n                task_type=\"lint\", success=(i == 0),\n            ))\n        rates = state_mgr.get_success_rate_by_type()\n        assert abs(rates[\"test_failure\"] - 2 / 3) < 0.01\n        assert abs(rates[\"lint\"] - 1 / 4) < 0.01\n\n    def test_respects_lookback(self, state_mgr):\n        now = time.time()\n        # Old record outside lookback window\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now - 200000, task_description=\"Old\",\n            task_type=\"todo\", success=True,\n        ))\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now - 200001, task_description=\"Old2\",\n            task_type=\"todo\", success=False,\n        ))\n        # Recent records\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now, task_description=\"Recent A\",\n            task_type=\"feedback\", success=True,\n        ))\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now + 1, task_description=\"Recent B\",\n            task_type=\"feedback\", success=True,\n        ))\n        rates = state_mgr.get_success_rate_by_type(lookback_seconds=3600)\n        # Old \"todo\" records should be excluded (outside lookback)\n        assert \"todo\" not in rates\n        assert abs(rates[\"feedback\"] - 1.0) < 0.01\n\n    def test_skips_types_with_fewer_than_two_attempts(self, state_mgr):\n        now = time.time()\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now, task_description=\"Solo\",\n            task_type=\"rare_type\", success=True,\n        ))\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now + 1, task_description=\"A\",\n            task_type=\"common_type\", success=True,\n        ))\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now + 2, task_description=\"B\",\n            task_type=\"common_type\", success=False,\n        ))\n        rates = state_mgr.get_success_rate_by_type()\n        assert \"rare_type\" not in rates\n        assert \"common_type\" in rates\n\n\nclass TestStrategyPerformance:\n    def test_empty_history(self, state_mgr):\n        assert state_mgr.get_strategy_performance() == {}\n\n    def test_computes_avg_cost_duration_success_rate(self, state_mgr):\n        now = time.time()\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now, task_description=\"A\", task_type=\"feedback\",\n            success=True, cost_usd=1.0, duration_seconds=100.0,\n        ))\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now + 1, task_description=\"B\", task_type=\"feedback\",\n            success=False, cost_usd=3.0, duration_seconds=200.0,\n        ))\n        perf = state_mgr.get_strategy_performance()\n        fb = perf[\"feedback\"]\n        assert fb[\"total\"] == 2\n        assert fb[\"successes\"] == 1\n        assert abs(fb[\"success_rate\"] - 0.5) < 0.01\n        assert abs(fb[\"avg_cost\"] - 2.0) < 0.01\n        assert abs(fb[\"avg_duration\"] - 150.0) < 0.01\n\n    def test_respects_lookback(self, state_mgr):\n        now = time.time()\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now - 200000, task_description=\"Old\",\n            task_type=\"test_failure\", success=True, cost_usd=5.0,\n        ))\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now, task_description=\"Recent\",\n            task_type=\"feedback\", success=True, cost_usd=1.0,\n        ))\n        perf = state_mgr.get_strategy_performance(lookback_seconds=3600)\n        assert \"test_failure\" not in perf\n        assert \"feedback\" in perf\n\n    def test_multiple_sources(self, state_mgr):\n        now = time.time()\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now, task_description=\"A\", task_type=\"feedback\",\n            success=True, cost_usd=1.0, duration_seconds=60.0,\n        ))\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now + 1, task_description=\"B\", task_type=\"lint\",\n            success=False, cost_usd=0.5, duration_seconds=30.0,\n        ))\n        perf = state_mgr.get_strategy_performance()\n        assert \"feedback\" in perf\n        assert \"lint\" in perf\n        assert perf[\"feedback\"][\"success_rate\"] == 1.0\n        assert perf[\"lint\"][\"success_rate\"] == 0.0\n\n\nclass TestProductiveFiles:\n    def test_empty_history(self, state_mgr):\n        assert state_mgr.get_productive_files() == []\n\n    def test_extracts_files_from_descriptions(self, state_mgr):\n        now = time.time()\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now, task_description=\"Fix bug in safety.py and state.py\",\n            success=True,\n            task_descriptions=[\"Fix bug in safety.py and state.py\"],\n        ))\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now + 1, task_description=\"Update safety.py error handling\",\n            success=True,\n            task_descriptions=[\"Update safety.py error handling\"],\n        ))\n        files = state_mgr.get_productive_files()\n        assert files[0] == \"safety.py\"  # Most frequent\n        assert \"state.py\" in files\n\n    def test_ignores_failed_cycles(self, state_mgr):\n        now = time.time()\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now, task_description=\"Fix bug in never_seen.py\",\n            success=False,\n            task_descriptions=[\"Fix bug in never_seen.py\"],\n        ))\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now + 1, task_description=\"Fix bug in seen.py\",\n            success=True,\n            task_descriptions=[\"Fix bug in seen.py\"],\n        ))\n        files = state_mgr.get_productive_files()\n        assert \"never_seen.py\" not in files\n        assert \"seen.py\" in files\n\n    def test_sorted_by_frequency(self, state_mgr):\n        now = time.time()\n        # a.py mentioned 3 times, b.py mentioned 1 time\n        for i in range(3):\n            state_mgr.record_cycle(CycleRecord(\n                timestamp=now + i, task_description=\"Work on a.py\",\n                success=True,\n                task_descriptions=[\"Work on a.py\"],\n            ))\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now + 10, task_description=\"Work on b.py\",\n            success=True,\n            task_descriptions=[\"Work on b.py\"],\n        ))\n        files = state_mgr.get_productive_files()\n        assert files.index(\"a.py\") < files.index(\"b.py\")\n\n    def test_respects_lookback(self, state_mgr):\n        now = time.time()\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now - 200000, task_description=\"Fix old.py\",\n            success=True,\n            task_descriptions=[\"Fix old.py\"],\n        ))\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now, task_description=\"Fix recent.py\",\n            success=True,\n            task_descriptions=[\"Fix recent.py\"],\n        ))\n        files = state_mgr.get_productive_files(lookback_seconds=3600)\n        assert \"old.py\" not in files\n        assert \"recent.py\" in files\n","numLines":1021,"startLine":1,"totalLines":1021}}}
