{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_vrtx_01KgWVDsrytDLd9waPVHs8Ht","type":"tool_result","content":"     1→\"\"\"Load and validate configuration from YAML with sensible defaults.\"\"\"\n     2→\n     3→from __future__ import annotations\n     4→\n     5→import dataclasses\n     6→import logging\n     7→import os\n     8→import subprocess\n     9→from dataclasses import dataclass, field\n    10→from pathlib import Path\n    11→from typing import List, Optional, get_type_hints\n    12→\n    13→import yaml\n    14→\n    15→logger = logging.getLogger(__name__)\n    16→\n    17→\n    18→@dataclass\n    19→class ClaudeConfig:\n    20→    model: str = \"opus\"\n    21→    resolved_model: str = \"\"   # Populated at startup by Orchestrator\n    22→    max_turns: int = 25\n    23→    timeout_seconds: int = 14400\n    24→    command: str = \"claude\"\n    25→    max_retries: int = 3\n    26→    retry_delays: List[int] = field(default_factory=lambda: [2, 8, 32])\n    27→    rate_limit_base_delay: int = 5\n    28→    rate_limit_multiplier: int = 3\n    29→    provider: str = \"claude\"      # \"claude\" | \"openai\" | \"gemini\"\n    30→    api_key_env: str = \"\"         # env var name for API key\n    31→\n    32→\n    33→@dataclass\n    34→class OrchestratorConfig:\n    35→    loop_interval_seconds: int = 30\n    36→    max_changed_files: int = 20\n    37→    self_improve: bool = False\n    38→    push_after_commit: bool = False\n    39→    plan_changes: bool = False\n    40→    planning_max_turns: int = 8\n    41→    max_feedback_retries: int = 3\n    42→    max_tasks_per_cycle: int = 10\n    43→    batch_mode: bool = True\n    44→    cycle_timeout_seconds: int = 43200\n    45→    # Adaptive batch sizing\n    46→    min_batch_size: int = 1\n    47→    max_batch_size: int = 10\n    48→    initial_batch_size: int = 3\n    49→    batch_grow_step: int = 1\n    50→    batch_shrink_step: int = 2\n    51→    adaptive_batch_window: int = 10\n    52→    batch_cost_ceiling: float = 8.0\n    53→    # Task priority decay: hours before a skipped task is promoted by 1 level\n    54→    priority_decay_hours: float = 24.0\n    55→    # Validation retry — re-invoke Claude with failure output to fix in-place\n    56→    max_validation_retries: int = 5\n    57→    retry_include_full_output: bool = True\n    58→    gc_interval: int = 10\n    59→    # Context isolation: warn/split when context window usage is high\n    60→    max_context_pct: float = 80.0\n    61→    context_isolation: bool = True\n    62→    # Smart zone: auto-split tasks when context is exhausted\n    63→    smart_split: bool = True\n    64→    max_split_depth: int = 3\n    65→    # Session recovery: resume after crashes\n    66→    session_recovery: bool = True\n    67→    # Task approval gate: when True and dashboard is connected, auto-discovered\n    68→    # tasks are queued for user approval before execution\n    69→    task_approval: bool = True\n    70→\n    71→\n    72→@dataclass\n    73→class ValidationConfig:\n    74→    test_command: str = \"python3 -m pytest tests/ -x -q\"\n    75→    lint_command: str = \"\"\n    76→    build_command: str = \"\"\n    77→    test_timeout: int = 7200\n    78→    lint_timeout: int = 7200\n    79→    build_timeout: int = 7200\n    80→    incremental_tests: bool = False  # Run only tests affected by changed files\n    81→\n    82→\n    83→@dataclass\n    84→class DiscoveryConfig:\n    85→    enable_test_failures: bool = True\n    86→    enable_lint_errors: bool = True\n    87→    enable_todos: bool = True\n    88→    enable_coverage: bool = False\n    89→    enable_quality_review: bool = False\n    90→    enable_complexity_check: bool = False\n    91→    enable_import_check: bool = False\n    92→    enable_claude_ideas: bool = False\n    93→    todo_patterns: List[str] = field(default_factory=lambda: [\"TODO\", \"FIXME\", \"HACK\"])\n    94→    exclude_dirs: List[str] = field(default_factory=lambda: [\n    95→        \"__pycache__\", \".git\", \"node_modules\", \".venv\", \"venv\",\n    96→    ])\n    97→    max_todo_tasks: int = 20\n    98→    discovery_model: str = \"opus\"\n    99→    discovery_timeout: int = 7200\n   100→    discovery_max_turns: int = 15\n   101→    discovery_prompt: str = \"\"  # Custom prompt for claude_ideas; empty = use default\n   102→    idea_cooldown_seconds: int = 600  # Minimum seconds between claude_ideas runs; 0 = no limit\n   103→    adaptive_priority: bool = False  # Boost priority of high-success-rate task types\n   104→    enable_feasibility_filter: bool = False  # Filter out low-feasibility tasks (score < 0.3)\n   105→\n   106→\n   107→@dataclass\n   108→class SafetyConfig:\n   109→    max_consecutive_failures: int = 5\n   110→    max_cycles_per_hour: int = 30\n   111→    max_cost_usd_per_hour: float = 10.0\n   112→    min_disk_space_mb: int = 500\n   113→    min_memory_mb: int = 256\n   114→    max_history_records: int = 1000\n   115→    protected_files: List[str] = field(default_factory=lambda: [\"main.py\", \"config.yaml\"])\n   116→    max_backup_dir_mb: int = 200  # Max size of state/backups directory before cleanup\n   117→    max_git_objects_mb: int = 500  # Max size of .git/objects before warning/gc trigger\n   118→\n   119→\n   120→@dataclass\n   121→class AgentRoleConfig:\n   122→    \"\"\"Per-agent settings.\"\"\"\n   123→    enabled: bool = True\n   124→    model: str = \"opus\"\n   125→    max_turns: int = 25\n   126→    timeout_seconds: int = 7200\n   127→\n   128→\n   129→@dataclass\n   130→class AgentPipelineConfig:\n   131→    \"\"\"Multi-agent pipeline settings.\"\"\"\n   132→    enabled: bool = False\n   133→    max_revisions: int = 2\n   134→    max_pipeline_cost_usd: float = 0.0  # 0 = use safety.max_cost_usd_per_hour * 0.5\n   135→    review_detail: str = \"standard\"  # \"minimal\" | \"standard\" | \"thorough\"\n   136→    review_confidence_threshold: float = 0.70  # min confidence for findings to surface\n   137→    planner: AgentRoleConfig = field(default_factory=lambda: AgentRoleConfig(\n   138→        model=\"opus\", max_turns=10, timeout_seconds=7200))\n   139→    coder: AgentRoleConfig = field(default_factory=lambda: AgentRoleConfig(\n   140→        model=\"opus\", max_turns=25, timeout_seconds=14400))\n   141→    tester: AgentRoleConfig = field(default_factory=lambda: AgentRoleConfig(\n   142→        model=\"opus\", max_turns=15, timeout_seconds=7200))\n   143→    reviewer: AgentRoleConfig = field(default_factory=lambda: AgentRoleConfig(\n   144→        model=\"opus\", max_turns=10, timeout_seconds=7200))\n   145→\n   146→\n   147→@dataclass\n   148→class ParallelConfig:\n   149→    enabled: bool = False\n   150→    max_workers: int = 3\n   151→    worktree_base_dir: str = \".worktrees\"\n   152→    merge_strategy: str = \"rebase\"  # \"rebase\" or \"merge\"\n   153→    max_merge_retries: int = 2\n   154→    cleanup_on_exit: bool = True\n   155→    cleanup_timeout: int = 60\n   156→    ai_conflict_resolution: bool = True\n   157→    conflict_resolution_max_cost: float = 2.0\n   158→\n   159→\n   160→@dataclass\n   161→class PathsConfig:\n   162→    feedback_dir: str = \"feedback\"\n   163→    feedback_done_dir: str = \"feedback/done\"\n   164→    state_dir: str = \"state\"\n   165→    history_file: str = \"state/history.json\"\n   166→    lock_file: str = \"state/lock.pid\"\n   167→    backup_dir: str = \"state/backups\"\n   168→    feedback_failed_dir: str = \"feedback/failed\"\n   169→    agent_workspace_dir: str = \"state/agent_workspace\"\n   170→\n   171→\n   172→@dataclass\n   173→class LoggingConfig:\n   174→    level: str = \"INFO\"\n   175→    file: str = \"state/auto_claude.log\"\n   176→    max_bytes: int = 5_000_000\n   177→    backup_count: int = 3\n   178→    format: str = \"text\"  # \"text\" or \"json\"\n   179→\n   180→\n   181→@dataclass\n   182→class WebhookConfig:\n   183→    \"\"\"Configuration for a single webhook endpoint.\"\"\"\n   184→    url: str = \"\"\n   185→    type: str = \"generic\"  # \"slack\", \"discord\", \"generic\"\n   186→    name: str = \"\"\n   187→\n   188→\n   189→@dataclass\n   190→class NotificationEventsConfig:\n   191→    \"\"\"Which events trigger notifications.\"\"\"\n   192→    on_cycle_success: bool = True\n   193→    on_cycle_failure: bool = True\n   194→    on_consecutive_failure_threshold: bool = True\n   195→    on_cost_limit_exceeded: bool = True\n   196→    on_safety_error: bool = True\n   197→    summary_interval_cycles: int = 0  # Send periodic summary every N cycles; 0 = disabled\n   198→\n   199→\n   200→@dataclass\n   201→class NotificationsConfig:\n   202→    \"\"\"Top-level notification configuration.\"\"\"\n   203→    enabled: bool = False\n   204→    webhooks: List[WebhookConfig] = field(default_factory=list)\n   205→    events: NotificationEventsConfig = field(default_factory=NotificationEventsConfig)\n   206→    nl_summaries: bool = False\n   207→\n   208→\n   209→@dataclass\n   210→class PricingConfig:\n   211→    \"\"\"Pricing configuration for cost prediction.\"\"\"\n   212→    cost_per_million_input_tokens: dict = field(default_factory=lambda: {\n   213→        \"opus\": 15.0,\n   214→        \"sonnet\": 3.0,\n   215→        \"haiku\": 0.25,\n   216→    })\n   217→    output_cost_multiplier: float = 5.0\n   218→\n   219→\n   220→@dataclass\n   221→class GitHubConfig:\n   222→    \"\"\"Configuration for GitHub integration.\"\"\"\n   223→    enabled: bool = False\n   224→    token: str = \"\"\n   225→    repo_owner: str = \"\"\n   226→    repo_name: str = \"\"\n   227→    base_branch: str = \"main\"\n   228→    create_prs: bool = True\n   229→    auto_merge: bool = False\n   230→    label: str = \"auto-claude\"\n   231→\n   232→\n   233→@dataclass\n   234→class JudgeConfig:\n   235→    \"\"\"Configuration for a single LLM judge.\"\"\"\n   236→    enabled: bool = True\n   237→    model: str = \"sonnet\"\n   238→    max_turns: int = 5\n   239→    timeout_seconds: int = 300\n   240→    max_cost_usd: float = 0.50\n   241→\n   242→\n   243→@dataclass\n   244→class JudgesConfig:\n   245→    \"\"\"Configuration for the LLM judges panel.\"\"\"\n   246→    enabled: bool = False\n   247→    security: JudgeConfig = field(default_factory=lambda: JudgeConfig(enabled=True))\n   248→    quality: JudgeConfig = field(default_factory=lambda: JudgeConfig(enabled=True))\n   249→    architecture: JudgeConfig = field(default_factory=lambda: JudgeConfig(enabled=False))\n   250→    max_total_cost_usd: float = 2.0\n   251→    fail_action: str = \"retry\"   # \"retry\" | \"rollback\" | \"warn\"\n   252→\n   253→\n   254→@dataclass\n   255→class Config:\n   256→    target_dir: str = \".\"\n   257→    claude: ClaudeConfig = field(default_factory=ClaudeConfig)\n   258→    orchestrator: OrchestratorConfig = field(default_factory=OrchestratorConfig)\n   259→    validation: ValidationConfig = field(default_factory=ValidationConfig)\n   260→    discovery: DiscoveryConfig = field(default_factory=DiscoveryConfig)\n   261→    safety: SafetyConfig = field(default_factory=SafetyConfig)\n   262→    paths: PathsConfig = field(default_factory=PathsConfig)\n   263→    logging: LoggingConfig = field(default_factory=LoggingConfig)\n   264→    agent_pipeline: AgentPipelineConfig = field(default_factory=AgentPipelineConfig)\n   265→    parallel: ParallelConfig = field(default_factory=ParallelConfig)\n   266→    notifications: NotificationsConfig = field(default_factory=NotificationsConfig)\n   267→    pricing: PricingConfig = field(default_factory=PricingConfig)\n   268→    github: GitHubConfig = field(default_factory=GitHubConfig)\n   269→    judges: JudgesConfig = field(default_factory=JudgesConfig)\n   270→\n   271→\n   272→def _get_expected_type(dc_class, field_name: str):\n   273→    \"\"\"Return the expected primitive type for a dataclass field, or None if unknown.\"\"\"\n   274→    try:\n   275→        hints = get_type_hints(dc_class)\n   276→    except Exception:\n   277→        return None\n   278→    hint = hints.get(field_name)\n   279→    if hint is None:\n   280→        return None\n   281→    # Unwrap Optional[X] -> X\n   282→    origin = getattr(hint, \"__origin__\", None)\n   283→    # Handle Union (Optional is Union[X, None])\n   284→    import typing\n   285→    if origin is getattr(typing, \"Union\", None):\n   286→        args = [a for a in hint.__args__ if a is not type(None)]\n   287→        if len(args) == 1:\n   288→            hint = args[0]\n   289→            origin = getattr(hint, \"__origin__\", None)\n   290→        else:\n   291→            return None\n   292→    # For List[X], accept list\n   293→    if origin is list:\n   294→        return list\n   295→    # For simple types\n   296→    if isinstance(hint, type):\n   297→        return hint\n   298→    return None\n   299→\n   300→\n   301→def _merge_dataclass(dc_instance, overrides: dict):\n   302→    \"\"\"Merge a dict of overrides into a dataclass instance.\n   303→\n   304→    Validates each value's type against the dataclass field annotation.\n   305→    Invalid types are logged and skipped.\n   306→    \"\"\"\n   307→    if not overrides:\n   308→        return dc_instance\n   309→    dc_class = type(dc_instance)\n   310→    for key, value in overrides.items():\n   311→        if not hasattr(dc_instance, key):\n   312→            logger.warning(\"Unknown config key '%s.%s' — ignoring (typo?)\", dc_class.__name__, key)\n   313→            continue\n   314→        expected = _get_expected_type(dc_class, key)\n   315→        if expected is not None and value is not None:\n   316→            # Allow int where float is expected (YAML often produces int for \"10.0\")\n   317→            if expected is float and isinstance(value, int):\n   318→                value = float(value)\n   319→            elif not isinstance(value, expected):\n   320→                logger.warning(\n   321→                    \"Config field '%s.%s' expects %s but got %s (%r) — skipping\",\n   322→                    dc_class.__name__, key, expected.__name__,\n   323→                    type(value).__name__, value,\n   324→                )\n   325→                continue\n   326→        setattr(dc_instance, key, value)\n   327→    return dc_instance\n   328→\n   329→\n   330→def load_config(path: Optional[str] = None) -> Config:\n   331→    \"\"\"Load configuration from a YAML file, merging with defaults.\n   332→\n   333→    If path is None, returns a Config with all defaults.\n   334→    \"\"\"\n   335→    config = Config()\n   336→\n   337→    if path is None:\n   338→        return config\n   339→\n   340→    config_path = Path(path)\n   341→    if not config_path.exists():\n   342→        return config\n   343→\n   344→    with open(config_path, \"r\") as f:\n   345→        raw = yaml.safe_load(f)\n   346→\n   347→    if not raw or not isinstance(raw, dict):\n   348→        return config\n   349→\n   350→    if \"target_dir\" in raw:\n   351→        config.target_dir = raw[\"target_dir\"]\n   352→\n   353→    section_map = {\n   354→        \"claude\": config.claude,\n   355→        \"orchestrator\": config.orchestrator,\n   356→        \"validation\": config.validation,\n   357→        \"discovery\": config.discovery,\n   358→        \"safety\": config.safety,\n   359→        \"paths\": config.paths,\n   360→        \"logging\": config.logging,\n   361→        \"parallel\": config.parallel,\n   362→        \"pricing\": config.pricing,\n   363→        \"github\": config.github,\n   364→    }\n   365→\n   366→    for section_name, dc_instance in section_map.items():\n   367→        if section_name in raw and isinstance(raw[section_name], dict):\n   368→            _merge_dataclass(dc_instance, raw[section_name])\n   369→\n   370→    # Legacy migration: max_tasks_per_cycle -> max_batch_size\n   371→    if \"orchestrator\" in raw and isinstance(raw[\"orchestrator\"], dict):\n   372→        if \"max_tasks_per_cycle\" in raw[\"orchestrator\"] and \"max_batch_size\" not in raw[\"orchestrator\"]:\n   373→            config.orchestrator.max_batch_size = config.orchestrator.max_tasks_per_cycle\n   374→\n   375→    # Nested agent pipeline config\n   376→    if \"agent_pipeline\" in raw and isinstance(raw[\"agent_pipeline\"], dict):\n   377→        ap_raw = raw[\"agent_pipeline\"]\n   378→        _merge_dataclass(config.agent_pipeline, {\n   379→            k: v for k, v in ap_raw.items()\n   380→            if k not in (\"planner\", \"coder\", \"tester\", \"reviewer\")\n   381→        })\n   382→        for agent_name in (\"planner\", \"coder\", \"tester\", \"reviewer\"):\n   383→            if agent_name in ap_raw and isinstance(ap_raw[agent_name], dict):\n   384→                _merge_dataclass(getattr(config.agent_pipeline, agent_name), ap_raw[agent_name])\n   385→\n   386→    # Nested notifications config\n   387→    if \"notifications\" in raw and isinstance(raw[\"notifications\"], dict):\n   388→        notif_raw = raw[\"notifications\"]\n   389→        _merge_dataclass(config.notifications, {\n   390→            k: v for k, v in notif_raw.items()\n   391→            if k not in (\"webhooks\", \"events\")\n   392→        })\n   393→        if \"events\" in notif_raw and isinstance(notif_raw[\"events\"], dict):\n   394→            _merge_dataclass(config.notifications.events, notif_raw[\"events\"])\n   395→        if \"webhooks\" in notif_raw and isinstance(notif_raw[\"webhooks\"], list):\n   396→            config.notifications.webhooks = [\n   397→                WebhookConfig(**wh) for wh in notif_raw[\"webhooks\"]\n   398→                if isinstance(wh, dict) and wh.get(\"url\")\n   399→            ]\n   400→\n   401→    # Nested judges config\n   402→    if \"judges\" in raw and isinstance(raw[\"judges\"], dict):\n   403→        judges_raw = raw[\"judges\"]\n   404→        _merge_dataclass(config.judges, {\n   405→            k: v for k, v in judges_raw.items()\n   406→            if k not in (\"security\", \"quality\", \"architecture\")\n   407→        })\n   408→        for judge_name in (\"security\", \"quality\", \"architecture\"):\n   409→            if judge_name in judges_raw and isinstance(judges_raw[judge_name], dict):\n   410→                _merge_dataclass(getattr(config.judges, judge_name), judges_raw[judge_name])\n   411→\n   412→    validate_config(config)\n   413→    return config\n   414→\n   415→\n   416→def validate_config(config: Config) -> None:\n   417→    \"\"\"Validate cross-field configuration constraints.\n   418→\n   419→    Raises ValueError if configuration is invalid.\n   420→    \"\"\"\n   421→    # Validate model names are non-empty strings without whitespace\n   422→    _KNOWN_MODEL_ALIASES = {\n   423→        \"opus\", \"sonnet\", \"haiku\",\n   424→        \"claude-opus-4-6\", \"claude-sonnet-4-20250514\",\n   425→        \"claude-haiku-3-5-20241022\",\n   426→    }\n   427→    if not config.claude.model or not config.claude.model.strip():\n   428→        raise ValueError(\n   429→            \"claude.model must be a non-empty string\"\n   430→        )\n   431→    model = config.claude.model.strip()\n   432→    if \" \" in model or \"\\t\" in model:\n   433→        raise ValueError(\n   434→            f\"claude.model contains whitespace: {model!r}\"\n   435→        )\n   436→    if model not in _KNOWN_MODEL_ALIASES and not model.startswith(\"claude-\"):\n   437→        logger.warning(\n   438→            \"claude.model '%s' is not a recognized alias or model ID. \"\n   439→            \"Known aliases: %s. If this is intentional, ignore this warning.\",\n   440→            model, \", \".join(sorted(_KNOWN_MODEL_ALIASES)),\n   441→        )\n   442→\n   443→    # Validate discovery model\n   444→    if config.discovery.discovery_model:\n   445→        dm = config.discovery.discovery_model.strip()\n   446→        if \" \" in dm or \"\\t\" in dm:\n   447→            raise ValueError(\n   448→                f\"discovery.discovery_model contains whitespace: {dm!r}\"\n   449→            )\n   450→\n   451→    # Validate timeout values are positive integers\n   452→    if config.claude.timeout_seconds <= 0:\n   453→        raise ValueError(\n   454→            f\"claude.timeout_seconds must be a positive integer, got {config.claude.timeout_seconds}\"\n   455→        )\n   456→    if config.validation.test_timeout <= 0:\n   457→        raise ValueError(\n   458→            f\"validation.test_timeout must be a positive integer, got {config.validation.test_timeout}\"\n   459→        )\n   460→    if config.validation.lint_timeout <= 0:\n   461→        raise ValueError(\n   462→            f\"validation.lint_timeout must be a positive integer, got {config.validation.lint_timeout}\"\n   463→        )\n   464→    if config.validation.build_timeout <= 0:\n   465→        raise ValueError(\n   466→            f\"validation.build_timeout must be a positive integer, got {config.validation.build_timeout}\"\n   467→        )\n   468→    if config.orchestrator.cycle_timeout_seconds <= 0:\n   469→        raise ValueError(\n   470→            f\"orchestrator.cycle_timeout_seconds must be a positive integer, \"\n   471→            f\"got {config.orchestrator.cycle_timeout_seconds}\"\n   472→        )\n   473→\n   474→    # Validate max_retries is non-negative\n   475→    if config.claude.max_retries < 0:\n   476→        raise ValueError(\n   477→            f\"claude.max_retries must be non-negative, got {config.claude.max_retries}\"\n   478→        )\n   479→    if config.claude.max_turns <= 0:\n   480→        raise ValueError(\n   481→            f\"claude.max_turns must be positive, got {config.claude.max_turns}\"\n   482→        )\n   483→\n   484→    # Cross-field: Claude timeout must exceed test timeout\n   485→    if config.claude.timeout_seconds <= config.validation.test_timeout:\n   486→        raise ValueError(\n   487→            f\"claude.timeout_seconds ({config.claude.timeout_seconds}) must be greater than \"\n   488→            f\"validation.test_timeout ({config.validation.test_timeout}) to ensure tests \"\n   489→            f\"can complete before Claude times out\"\n   490→        )\n   491→\n   492→    # Validate orchestrator fields\n   493→    if config.orchestrator.loop_interval_seconds <= 0:\n   494→        raise ValueError(\n   495→            f\"orchestrator.loop_interval_seconds must be positive, \"\n   496→            f\"got {config.orchestrator.loop_interval_seconds}\"\n   497→        )\n   498→\n   499→    # Validate discovery timeout\n   500→    if config.discovery.discovery_timeout <= 0:\n   501→        raise ValueError(\n   502→            f\"discovery.discovery_timeout must be positive, \"\n   503→            f\"got {config.discovery.discovery_timeout}\"\n   504→        )\n   505→\n   506→    # Validate file paths: ensure critical path fields are non-empty\n   507→    _PATH_FIELDS = [\n   508→        (\"paths.history_file\", config.paths.history_file),\n   509→        (\"paths.lock_file\", config.paths.lock_file),\n   510→        (\"paths.state_dir\", config.paths.state_dir),\n   511→        (\"paths.feedback_dir\", config.paths.feedback_dir),\n   512→    ]\n   513→    for field_name, field_value in _PATH_FIELDS:\n   514→        if not field_value or not field_value.strip():\n   515→            raise ValueError(\n   516→                f\"{field_name} must be a non-empty path\"\n   517→            )\n   518→\n   519→    # Validate safety fields\n   520→    if config.safety.max_consecutive_failures <= 0:\n   521→        raise ValueError(\n   522→            f\"safety.max_consecutive_failures must be positive, \"\n   523→            f\"got {config.safety.max_consecutive_failures}\"\n   524→        )\n   525→    if config.safety.max_cycles_per_hour <= 0:\n   526→        raise ValueError(\n   527→            f\"safety.max_cycles_per_hour must be positive, \"\n   528→            f\"got {config.safety.max_cycles_per_hour}\"\n   529→        )\n   530→    if config.safety.max_cost_usd_per_hour <= 0:\n   531→        raise ValueError(\n   532→            f\"safety.max_cost_usd_per_hour must be positive, \"\n   533→            f\"got {config.safety.max_cost_usd_per_hour}\"\n   534→        )\n   535→    if config.safety.min_disk_space_mb <= 0:\n   536→        raise ValueError(\n   537→            f\"safety.min_disk_space_mb must be positive, \"\n   538→            f\"got {config.safety.min_disk_space_mb}\"\n   539→        )\n   540→    if config.safety.min_memory_mb < 0:\n   541→        raise ValueError(\n   542→            f\"safety.min_memory_mb must be non-negative, \"\n   543→            f\"got {config.safety.min_memory_mb}\"\n   544→        )\n   545→\n   546→    # Validate parallel config\n   547→    if config.parallel.enabled and config.parallel.max_workers <= 0:\n   548→        raise ValueError(\n   549→            f\"parallel.max_workers must be positive when parallel is enabled, \"\n   550→            f\"got {config.parallel.max_workers}\"\n   551→        )\n   552→\n   553→    # Validate agent pipeline role configs when enabled\n   554→    if config.agent_pipeline.enabled:\n   555→        _REQUIRED_ROLE_ATTRS = (\"model\", \"max_turns\", \"timeout_seconds\")\n   556→        for agent_name in (\"planner\", \"coder\", \"tester\", \"reviewer\"):\n   557→            agent_cfg = getattr(config.agent_pipeline, agent_name)\n   558→            missing = [a for a in _REQUIRED_ROLE_ATTRS if not hasattr(agent_cfg, a)]\n   559→            if missing:\n   560→                raise ValueError(\n   561→                    f\"agent_pipeline.{agent_name} is missing required attributes: \"\n   562→                    f\"{', '.join(missing)}. Each role needs: {', '.join(_REQUIRED_ROLE_ATTRS)}\"\n   563→                )\n   564→            if agent_cfg.timeout_seconds <= 0:\n   565→                raise ValueError(\n   566→                    f\"agent_pipeline.{agent_name}.timeout_seconds must be positive \"\n   567→                    f\"when agent_pipeline is enabled, got {agent_cfg.timeout_seconds}\"\n   568→                )\n   569→            if agent_cfg.max_turns <= 0:\n   570→                raise ValueError(\n   571→                    f\"agent_pipeline.{agent_name}.max_turns must be positive \"\n   572→                    f\"when agent_pipeline is enabled, got {agent_cfg.max_turns}\"\n   573→                )\n   574→            if not agent_cfg.model or not agent_cfg.model.strip():\n   575→                raise ValueError(\n   576→                    f\"agent_pipeline.{agent_name}.model must be a non-empty string \"\n   577→                    f\"when agent_pipeline is enabled\"\n   578→                )\n   579→\n   580→    # Validate target_dir exists and is a git repository\n   581→    target = config.target_dir\n   582→    if not os.path.isdir(target):\n   583→        raise ValueError(\n   584→            f\"target_dir does not exist or is not a directory: {target}\"\n   585→        )\n   586→    git_check = subprocess.run(\n   587→        [\"git\", \"rev-parse\", \"--git-dir\"],\n   588→        cwd=target, capture_output=True, text=True, timeout=10,\n   589→    )\n   590→    if git_check.returncode != 0:\n   591→        raise ValueError(\n   592→            f\"target_dir is not a git repository: {target}\"\n   593→        )\n   594→\n   595→    # Validate batch size ordering: min <= initial <= max\n   596→    orch = config.orchestrator\n   597→    if orch.min_batch_size > orch.initial_batch_size:\n   598→        raise ValueError(\n   599→            f\"orchestrator.min_batch_size ({orch.min_batch_size}) must be <= \"\n   600→            f\"orchestrator.initial_batch_size ({orch.initial_batch_size})\"\n   601→        )\n   602→    if orch.initial_batch_size > orch.max_batch_size:\n   603→        raise ValueError(\n   604→            f\"orchestrator.initial_batch_size ({orch.initial_batch_size}) must be <= \"\n   605→            f\"orchestrator.max_batch_size ({orch.max_batch_size})\"\n   606→        )\n   607→\n   608→    # Validate notifications config\n   609→    _KNOWN_WEBHOOK_TYPES = {\"slack\", \"discord\", \"generic\"}\n   610→    if config.notifications.enabled:\n   611→        for i, wh in enumerate(config.notifications.webhooks):\n   612→            if not wh.url:\n   613→                logger.warning(\"notifications.webhooks[%d] has empty URL — will be skipped\", i)\n   614→            if wh.type not in _KNOWN_WEBHOOK_TYPES:\n   615→                logger.warning(\n   616→                    \"notifications.webhooks[%d].type '%s' is not recognized. \"\n   617→                    \"Known types: %s\",\n   618→                    i, wh.type, \", \".join(sorted(_KNOWN_WEBHOOK_TYPES)),\n   619→                )\n   620→\n   621→    # Validate enum-like config fields (warn, don't raise)\n   622→    _ENUM_VALIDATIONS = [\n   623→        (config.claude.provider, (\"claude\", \"openai\", \"gemini\"), \"claude.provider\"),\n   624→        (config.parallel.merge_strategy, (\"rebase\", \"merge\"), \"parallel.merge_strategy\"),\n   625→        (config.judges.fail_action, (\"retry\", \"rollback\", \"warn\"), \"judges.fail_action\"),\n   626→        (config.logging.format, (\"text\", \"json\"), \"logging.format\"),\n   627→        (config.agent_pipeline.review_detail, (\"minimal\", \"standard\", \"thorough\"), \"agent_pipeline.review_detail\"),\n   628→    ]\n   629→    for value, allowed, field_name in _ENUM_VALIDATIONS:\n   630→        if value not in allowed:\n   631→            logger.warning(\n   632→                \"Config field '%s' has unrecognized value '%s'. \"\n   633→                \"Expected one of: %s\",\n   634→                field_name, value, \", \".join(sorted(allowed)),\n   635→            )\n   636→"}]},"parent_tool_use_id":null,"session_id":"8d82d89c-1e3e-44f1-8b61-542209a31f5e","uuid":"0e56f425-144e-435f-87be-ee776238bf67","tool_use_result":{"type":"text","file":{"filePath":"/Users/sameertkhanna/Documents/auto_claude_code/config_schema.py","content":"\"\"\"Load and validate configuration from YAML with sensible defaults.\"\"\"\n\nfrom __future__ import annotations\n\nimport dataclasses\nimport logging\nimport os\nimport subprocess\nfrom dataclasses import dataclass, field\nfrom pathlib import Path\nfrom typing import List, Optional, get_type_hints\n\nimport yaml\n\nlogger = logging.getLogger(__name__)\n\n\n@dataclass\nclass ClaudeConfig:\n    model: str = \"opus\"\n    resolved_model: str = \"\"   # Populated at startup by Orchestrator\n    max_turns: int = 25\n    timeout_seconds: int = 14400\n    command: str = \"claude\"\n    max_retries: int = 3\n    retry_delays: List[int] = field(default_factory=lambda: [2, 8, 32])\n    rate_limit_base_delay: int = 5\n    rate_limit_multiplier: int = 3\n    provider: str = \"claude\"      # \"claude\" | \"openai\" | \"gemini\"\n    api_key_env: str = \"\"         # env var name for API key\n\n\n@dataclass\nclass OrchestratorConfig:\n    loop_interval_seconds: int = 30\n    max_changed_files: int = 20\n    self_improve: bool = False\n    push_after_commit: bool = False\n    plan_changes: bool = False\n    planning_max_turns: int = 8\n    max_feedback_retries: int = 3\n    max_tasks_per_cycle: int = 10\n    batch_mode: bool = True\n    cycle_timeout_seconds: int = 43200\n    # Adaptive batch sizing\n    min_batch_size: int = 1\n    max_batch_size: int = 10\n    initial_batch_size: int = 3\n    batch_grow_step: int = 1\n    batch_shrink_step: int = 2\n    adaptive_batch_window: int = 10\n    batch_cost_ceiling: float = 8.0\n    # Task priority decay: hours before a skipped task is promoted by 1 level\n    priority_decay_hours: float = 24.0\n    # Validation retry — re-invoke Claude with failure output to fix in-place\n    max_validation_retries: int = 5\n    retry_include_full_output: bool = True\n    gc_interval: int = 10\n    # Context isolation: warn/split when context window usage is high\n    max_context_pct: float = 80.0\n    context_isolation: bool = True\n    # Smart zone: auto-split tasks when context is exhausted\n    smart_split: bool = True\n    max_split_depth: int = 3\n    # Session recovery: resume after crashes\n    session_recovery: bool = True\n    # Task approval gate: when True and dashboard is connected, auto-discovered\n    # tasks are queued for user approval before execution\n    task_approval: bool = True\n\n\n@dataclass\nclass ValidationConfig:\n    test_command: str = \"python3 -m pytest tests/ -x -q\"\n    lint_command: str = \"\"\n    build_command: str = \"\"\n    test_timeout: int = 7200\n    lint_timeout: int = 7200\n    build_timeout: int = 7200\n    incremental_tests: bool = False  # Run only tests affected by changed files\n\n\n@dataclass\nclass DiscoveryConfig:\n    enable_test_failures: bool = True\n    enable_lint_errors: bool = True\n    enable_todos: bool = True\n    enable_coverage: bool = False\n    enable_quality_review: bool = False\n    enable_complexity_check: bool = False\n    enable_import_check: bool = False\n    enable_claude_ideas: bool = False\n    todo_patterns: List[str] = field(default_factory=lambda: [\"TODO\", \"FIXME\", \"HACK\"])\n    exclude_dirs: List[str] = field(default_factory=lambda: [\n        \"__pycache__\", \".git\", \"node_modules\", \".venv\", \"venv\",\n    ])\n    max_todo_tasks: int = 20\n    discovery_model: str = \"opus\"\n    discovery_timeout: int = 7200\n    discovery_max_turns: int = 15\n    discovery_prompt: str = \"\"  # Custom prompt for claude_ideas; empty = use default\n    idea_cooldown_seconds: int = 600  # Minimum seconds between claude_ideas runs; 0 = no limit\n    adaptive_priority: bool = False  # Boost priority of high-success-rate task types\n    enable_feasibility_filter: bool = False  # Filter out low-feasibility tasks (score < 0.3)\n\n\n@dataclass\nclass SafetyConfig:\n    max_consecutive_failures: int = 5\n    max_cycles_per_hour: int = 30\n    max_cost_usd_per_hour: float = 10.0\n    min_disk_space_mb: int = 500\n    min_memory_mb: int = 256\n    max_history_records: int = 1000\n    protected_files: List[str] = field(default_factory=lambda: [\"main.py\", \"config.yaml\"])\n    max_backup_dir_mb: int = 200  # Max size of state/backups directory before cleanup\n    max_git_objects_mb: int = 500  # Max size of .git/objects before warning/gc trigger\n\n\n@dataclass\nclass AgentRoleConfig:\n    \"\"\"Per-agent settings.\"\"\"\n    enabled: bool = True\n    model: str = \"opus\"\n    max_turns: int = 25\n    timeout_seconds: int = 7200\n\n\n@dataclass\nclass AgentPipelineConfig:\n    \"\"\"Multi-agent pipeline settings.\"\"\"\n    enabled: bool = False\n    max_revisions: int = 2\n    max_pipeline_cost_usd: float = 0.0  # 0 = use safety.max_cost_usd_per_hour * 0.5\n    review_detail: str = \"standard\"  # \"minimal\" | \"standard\" | \"thorough\"\n    review_confidence_threshold: float = 0.70  # min confidence for findings to surface\n    planner: AgentRoleConfig = field(default_factory=lambda: AgentRoleConfig(\n        model=\"opus\", max_turns=10, timeout_seconds=7200))\n    coder: AgentRoleConfig = field(default_factory=lambda: AgentRoleConfig(\n        model=\"opus\", max_turns=25, timeout_seconds=14400))\n    tester: AgentRoleConfig = field(default_factory=lambda: AgentRoleConfig(\n        model=\"opus\", max_turns=15, timeout_seconds=7200))\n    reviewer: AgentRoleConfig = field(default_factory=lambda: AgentRoleConfig(\n        model=\"opus\", max_turns=10, timeout_seconds=7200))\n\n\n@dataclass\nclass ParallelConfig:\n    enabled: bool = False\n    max_workers: int = 3\n    worktree_base_dir: str = \".worktrees\"\n    merge_strategy: str = \"rebase\"  # \"rebase\" or \"merge\"\n    max_merge_retries: int = 2\n    cleanup_on_exit: bool = True\n    cleanup_timeout: int = 60\n    ai_conflict_resolution: bool = True\n    conflict_resolution_max_cost: float = 2.0\n\n\n@dataclass\nclass PathsConfig:\n    feedback_dir: str = \"feedback\"\n    feedback_done_dir: str = \"feedback/done\"\n    state_dir: str = \"state\"\n    history_file: str = \"state/history.json\"\n    lock_file: str = \"state/lock.pid\"\n    backup_dir: str = \"state/backups\"\n    feedback_failed_dir: str = \"feedback/failed\"\n    agent_workspace_dir: str = \"state/agent_workspace\"\n\n\n@dataclass\nclass LoggingConfig:\n    level: str = \"INFO\"\n    file: str = \"state/auto_claude.log\"\n    max_bytes: int = 5_000_000\n    backup_count: int = 3\n    format: str = \"text\"  # \"text\" or \"json\"\n\n\n@dataclass\nclass WebhookConfig:\n    \"\"\"Configuration for a single webhook endpoint.\"\"\"\n    url: str = \"\"\n    type: str = \"generic\"  # \"slack\", \"discord\", \"generic\"\n    name: str = \"\"\n\n\n@dataclass\nclass NotificationEventsConfig:\n    \"\"\"Which events trigger notifications.\"\"\"\n    on_cycle_success: bool = True\n    on_cycle_failure: bool = True\n    on_consecutive_failure_threshold: bool = True\n    on_cost_limit_exceeded: bool = True\n    on_safety_error: bool = True\n    summary_interval_cycles: int = 0  # Send periodic summary every N cycles; 0 = disabled\n\n\n@dataclass\nclass NotificationsConfig:\n    \"\"\"Top-level notification configuration.\"\"\"\n    enabled: bool = False\n    webhooks: List[WebhookConfig] = field(default_factory=list)\n    events: NotificationEventsConfig = field(default_factory=NotificationEventsConfig)\n    nl_summaries: bool = False\n\n\n@dataclass\nclass PricingConfig:\n    \"\"\"Pricing configuration for cost prediction.\"\"\"\n    cost_per_million_input_tokens: dict = field(default_factory=lambda: {\n        \"opus\": 15.0,\n        \"sonnet\": 3.0,\n        \"haiku\": 0.25,\n    })\n    output_cost_multiplier: float = 5.0\n\n\n@dataclass\nclass GitHubConfig:\n    \"\"\"Configuration for GitHub integration.\"\"\"\n    enabled: bool = False\n    token: str = \"\"\n    repo_owner: str = \"\"\n    repo_name: str = \"\"\n    base_branch: str = \"main\"\n    create_prs: bool = True\n    auto_merge: bool = False\n    label: str = \"auto-claude\"\n\n\n@dataclass\nclass JudgeConfig:\n    \"\"\"Configuration for a single LLM judge.\"\"\"\n    enabled: bool = True\n    model: str = \"sonnet\"\n    max_turns: int = 5\n    timeout_seconds: int = 300\n    max_cost_usd: float = 0.50\n\n\n@dataclass\nclass JudgesConfig:\n    \"\"\"Configuration for the LLM judges panel.\"\"\"\n    enabled: bool = False\n    security: JudgeConfig = field(default_factory=lambda: JudgeConfig(enabled=True))\n    quality: JudgeConfig = field(default_factory=lambda: JudgeConfig(enabled=True))\n    architecture: JudgeConfig = field(default_factory=lambda: JudgeConfig(enabled=False))\n    max_total_cost_usd: float = 2.0\n    fail_action: str = \"retry\"   # \"retry\" | \"rollback\" | \"warn\"\n\n\n@dataclass\nclass Config:\n    target_dir: str = \".\"\n    claude: ClaudeConfig = field(default_factory=ClaudeConfig)\n    orchestrator: OrchestratorConfig = field(default_factory=OrchestratorConfig)\n    validation: ValidationConfig = field(default_factory=ValidationConfig)\n    discovery: DiscoveryConfig = field(default_factory=DiscoveryConfig)\n    safety: SafetyConfig = field(default_factory=SafetyConfig)\n    paths: PathsConfig = field(default_factory=PathsConfig)\n    logging: LoggingConfig = field(default_factory=LoggingConfig)\n    agent_pipeline: AgentPipelineConfig = field(default_factory=AgentPipelineConfig)\n    parallel: ParallelConfig = field(default_factory=ParallelConfig)\n    notifications: NotificationsConfig = field(default_factory=NotificationsConfig)\n    pricing: PricingConfig = field(default_factory=PricingConfig)\n    github: GitHubConfig = field(default_factory=GitHubConfig)\n    judges: JudgesConfig = field(default_factory=JudgesConfig)\n\n\ndef _get_expected_type(dc_class, field_name: str):\n    \"\"\"Return the expected primitive type for a dataclass field, or None if unknown.\"\"\"\n    try:\n        hints = get_type_hints(dc_class)\n    except Exception:\n        return None\n    hint = hints.get(field_name)\n    if hint is None:\n        return None\n    # Unwrap Optional[X] -> X\n    origin = getattr(hint, \"__origin__\", None)\n    # Handle Union (Optional is Union[X, None])\n    import typing\n    if origin is getattr(typing, \"Union\", None):\n        args = [a for a in hint.__args__ if a is not type(None)]\n        if len(args) == 1:\n            hint = args[0]\n            origin = getattr(hint, \"__origin__\", None)\n        else:\n            return None\n    # For List[X], accept list\n    if origin is list:\n        return list\n    # For simple types\n    if isinstance(hint, type):\n        return hint\n    return None\n\n\ndef _merge_dataclass(dc_instance, overrides: dict):\n    \"\"\"Merge a dict of overrides into a dataclass instance.\n\n    Validates each value's type against the dataclass field annotation.\n    Invalid types are logged and skipped.\n    \"\"\"\n    if not overrides:\n        return dc_instance\n    dc_class = type(dc_instance)\n    for key, value in overrides.items():\n        if not hasattr(dc_instance, key):\n            logger.warning(\"Unknown config key '%s.%s' — ignoring (typo?)\", dc_class.__name__, key)\n            continue\n        expected = _get_expected_type(dc_class, key)\n        if expected is not None and value is not None:\n            # Allow int where float is expected (YAML often produces int for \"10.0\")\n            if expected is float and isinstance(value, int):\n                value = float(value)\n            elif not isinstance(value, expected):\n                logger.warning(\n                    \"Config field '%s.%s' expects %s but got %s (%r) — skipping\",\n                    dc_class.__name__, key, expected.__name__,\n                    type(value).__name__, value,\n                )\n                continue\n        setattr(dc_instance, key, value)\n    return dc_instance\n\n\ndef load_config(path: Optional[str] = None) -> Config:\n    \"\"\"Load configuration from a YAML file, merging with defaults.\n\n    If path is None, returns a Config with all defaults.\n    \"\"\"\n    config = Config()\n\n    if path is None:\n        return config\n\n    config_path = Path(path)\n    if not config_path.exists():\n        return config\n\n    with open(config_path, \"r\") as f:\n        raw = yaml.safe_load(f)\n\n    if not raw or not isinstance(raw, dict):\n        return config\n\n    if \"target_dir\" in raw:\n        config.target_dir = raw[\"target_dir\"]\n\n    section_map = {\n        \"claude\": config.claude,\n        \"orchestrator\": config.orchestrator,\n        \"validation\": config.validation,\n        \"discovery\": config.discovery,\n        \"safety\": config.safety,\n        \"paths\": config.paths,\n        \"logging\": config.logging,\n        \"parallel\": config.parallel,\n        \"pricing\": config.pricing,\n        \"github\": config.github,\n    }\n\n    for section_name, dc_instance in section_map.items():\n        if section_name in raw and isinstance(raw[section_name], dict):\n            _merge_dataclass(dc_instance, raw[section_name])\n\n    # Legacy migration: max_tasks_per_cycle -> max_batch_size\n    if \"orchestrator\" in raw and isinstance(raw[\"orchestrator\"], dict):\n        if \"max_tasks_per_cycle\" in raw[\"orchestrator\"] and \"max_batch_size\" not in raw[\"orchestrator\"]:\n            config.orchestrator.max_batch_size = config.orchestrator.max_tasks_per_cycle\n\n    # Nested agent pipeline config\n    if \"agent_pipeline\" in raw and isinstance(raw[\"agent_pipeline\"], dict):\n        ap_raw = raw[\"agent_pipeline\"]\n        _merge_dataclass(config.agent_pipeline, {\n            k: v for k, v in ap_raw.items()\n            if k not in (\"planner\", \"coder\", \"tester\", \"reviewer\")\n        })\n        for agent_name in (\"planner\", \"coder\", \"tester\", \"reviewer\"):\n            if agent_name in ap_raw and isinstance(ap_raw[agent_name], dict):\n                _merge_dataclass(getattr(config.agent_pipeline, agent_name), ap_raw[agent_name])\n\n    # Nested notifications config\n    if \"notifications\" in raw and isinstance(raw[\"notifications\"], dict):\n        notif_raw = raw[\"notifications\"]\n        _merge_dataclass(config.notifications, {\n            k: v for k, v in notif_raw.items()\n            if k not in (\"webhooks\", \"events\")\n        })\n        if \"events\" in notif_raw and isinstance(notif_raw[\"events\"], dict):\n            _merge_dataclass(config.notifications.events, notif_raw[\"events\"])\n        if \"webhooks\" in notif_raw and isinstance(notif_raw[\"webhooks\"], list):\n            config.notifications.webhooks = [\n                WebhookConfig(**wh) for wh in notif_raw[\"webhooks\"]\n                if isinstance(wh, dict) and wh.get(\"url\")\n            ]\n\n    # Nested judges config\n    if \"judges\" in raw and isinstance(raw[\"judges\"], dict):\n        judges_raw = raw[\"judges\"]\n        _merge_dataclass(config.judges, {\n            k: v for k, v in judges_raw.items()\n            if k not in (\"security\", \"quality\", \"architecture\")\n        })\n        for judge_name in (\"security\", \"quality\", \"architecture\"):\n            if judge_name in judges_raw and isinstance(judges_raw[judge_name], dict):\n                _merge_dataclass(getattr(config.judges, judge_name), judges_raw[judge_name])\n\n    validate_config(config)\n    return config\n\n\ndef validate_config(config: Config) -> None:\n    \"\"\"Validate cross-field configuration constraints.\n\n    Raises ValueError if configuration is invalid.\n    \"\"\"\n    # Validate model names are non-empty strings without whitespace\n    _KNOWN_MODEL_ALIASES = {\n        \"opus\", \"sonnet\", \"haiku\",\n        \"claude-opus-4-6\", \"claude-sonnet-4-20250514\",\n        \"claude-haiku-3-5-20241022\",\n    }\n    if not config.claude.model or not config.claude.model.strip():\n        raise ValueError(\n            \"claude.model must be a non-empty string\"\n        )\n    model = config.claude.model.strip()\n    if \" \" in model or \"\\t\" in model:\n        raise ValueError(\n            f\"claude.model contains whitespace: {model!r}\"\n        )\n    if model not in _KNOWN_MODEL_ALIASES and not model.startswith(\"claude-\"):\n        logger.warning(\n            \"claude.model '%s' is not a recognized alias or model ID. \"\n            \"Known aliases: %s. If this is intentional, ignore this warning.\",\n            model, \", \".join(sorted(_KNOWN_MODEL_ALIASES)),\n        )\n\n    # Validate discovery model\n    if config.discovery.discovery_model:\n        dm = config.discovery.discovery_model.strip()\n        if \" \" in dm or \"\\t\" in dm:\n            raise ValueError(\n                f\"discovery.discovery_model contains whitespace: {dm!r}\"\n            )\n\n    # Validate timeout values are positive integers\n    if config.claude.timeout_seconds <= 0:\n        raise ValueError(\n            f\"claude.timeout_seconds must be a positive integer, got {config.claude.timeout_seconds}\"\n        )\n    if config.validation.test_timeout <= 0:\n        raise ValueError(\n            f\"validation.test_timeout must be a positive integer, got {config.validation.test_timeout}\"\n        )\n    if config.validation.lint_timeout <= 0:\n        raise ValueError(\n            f\"validation.lint_timeout must be a positive integer, got {config.validation.lint_timeout}\"\n        )\n    if config.validation.build_timeout <= 0:\n        raise ValueError(\n            f\"validation.build_timeout must be a positive integer, got {config.validation.build_timeout}\"\n        )\n    if config.orchestrator.cycle_timeout_seconds <= 0:\n        raise ValueError(\n            f\"orchestrator.cycle_timeout_seconds must be a positive integer, \"\n            f\"got {config.orchestrator.cycle_timeout_seconds}\"\n        )\n\n    # Validate max_retries is non-negative\n    if config.claude.max_retries < 0:\n        raise ValueError(\n            f\"claude.max_retries must be non-negative, got {config.claude.max_retries}\"\n        )\n    if config.claude.max_turns <= 0:\n        raise ValueError(\n            f\"claude.max_turns must be positive, got {config.claude.max_turns}\"\n        )\n\n    # Cross-field: Claude timeout must exceed test timeout\n    if config.claude.timeout_seconds <= config.validation.test_timeout:\n        raise ValueError(\n            f\"claude.timeout_seconds ({config.claude.timeout_seconds}) must be greater than \"\n            f\"validation.test_timeout ({config.validation.test_timeout}) to ensure tests \"\n            f\"can complete before Claude times out\"\n        )\n\n    # Validate orchestrator fields\n    if config.orchestrator.loop_interval_seconds <= 0:\n        raise ValueError(\n            f\"orchestrator.loop_interval_seconds must be positive, \"\n            f\"got {config.orchestrator.loop_interval_seconds}\"\n        )\n\n    # Validate discovery timeout\n    if config.discovery.discovery_timeout <= 0:\n        raise ValueError(\n            f\"discovery.discovery_timeout must be positive, \"\n            f\"got {config.discovery.discovery_timeout}\"\n        )\n\n    # Validate file paths: ensure critical path fields are non-empty\n    _PATH_FIELDS = [\n        (\"paths.history_file\", config.paths.history_file),\n        (\"paths.lock_file\", config.paths.lock_file),\n        (\"paths.state_dir\", config.paths.state_dir),\n        (\"paths.feedback_dir\", config.paths.feedback_dir),\n    ]\n    for field_name, field_value in _PATH_FIELDS:\n        if not field_value or not field_value.strip():\n            raise ValueError(\n                f\"{field_name} must be a non-empty path\"\n            )\n\n    # Validate safety fields\n    if config.safety.max_consecutive_failures <= 0:\n        raise ValueError(\n            f\"safety.max_consecutive_failures must be positive, \"\n            f\"got {config.safety.max_consecutive_failures}\"\n        )\n    if config.safety.max_cycles_per_hour <= 0:\n        raise ValueError(\n            f\"safety.max_cycles_per_hour must be positive, \"\n            f\"got {config.safety.max_cycles_per_hour}\"\n        )\n    if config.safety.max_cost_usd_per_hour <= 0:\n        raise ValueError(\n            f\"safety.max_cost_usd_per_hour must be positive, \"\n            f\"got {config.safety.max_cost_usd_per_hour}\"\n        )\n    if config.safety.min_disk_space_mb <= 0:\n        raise ValueError(\n            f\"safety.min_disk_space_mb must be positive, \"\n            f\"got {config.safety.min_disk_space_mb}\"\n        )\n    if config.safety.min_memory_mb < 0:\n        raise ValueError(\n            f\"safety.min_memory_mb must be non-negative, \"\n            f\"got {config.safety.min_memory_mb}\"\n        )\n\n    # Validate parallel config\n    if config.parallel.enabled and config.parallel.max_workers <= 0:\n        raise ValueError(\n            f\"parallel.max_workers must be positive when parallel is enabled, \"\n            f\"got {config.parallel.max_workers}\"\n        )\n\n    # Validate agent pipeline role configs when enabled\n    if config.agent_pipeline.enabled:\n        _REQUIRED_ROLE_ATTRS = (\"model\", \"max_turns\", \"timeout_seconds\")\n        for agent_name in (\"planner\", \"coder\", \"tester\", \"reviewer\"):\n            agent_cfg = getattr(config.agent_pipeline, agent_name)\n            missing = [a for a in _REQUIRED_ROLE_ATTRS if not hasattr(agent_cfg, a)]\n            if missing:\n                raise ValueError(\n                    f\"agent_pipeline.{agent_name} is missing required attributes: \"\n                    f\"{', '.join(missing)}. Each role needs: {', '.join(_REQUIRED_ROLE_ATTRS)}\"\n                )\n            if agent_cfg.timeout_seconds <= 0:\n                raise ValueError(\n                    f\"agent_pipeline.{agent_name}.timeout_seconds must be positive \"\n                    f\"when agent_pipeline is enabled, got {agent_cfg.timeout_seconds}\"\n                )\n            if agent_cfg.max_turns <= 0:\n                raise ValueError(\n                    f\"agent_pipeline.{agent_name}.max_turns must be positive \"\n                    f\"when agent_pipeline is enabled, got {agent_cfg.max_turns}\"\n                )\n            if not agent_cfg.model or not agent_cfg.model.strip():\n                raise ValueError(\n                    f\"agent_pipeline.{agent_name}.model must be a non-empty string \"\n                    f\"when agent_pipeline is enabled\"\n                )\n\n    # Validate target_dir exists and is a git repository\n    target = config.target_dir\n    if not os.path.isdir(target):\n        raise ValueError(\n            f\"target_dir does not exist or is not a directory: {target}\"\n        )\n    git_check = subprocess.run(\n        [\"git\", \"rev-parse\", \"--git-dir\"],\n        cwd=target, capture_output=True, text=True, timeout=10,\n    )\n    if git_check.returncode != 0:\n        raise ValueError(\n            f\"target_dir is not a git repository: {target}\"\n        )\n\n    # Validate batch size ordering: min <= initial <= max\n    orch = config.orchestrator\n    if orch.min_batch_size > orch.initial_batch_size:\n        raise ValueError(\n            f\"orchestrator.min_batch_size ({orch.min_batch_size}) must be <= \"\n            f\"orchestrator.initial_batch_size ({orch.initial_batch_size})\"\n        )\n    if orch.initial_batch_size > orch.max_batch_size:\n        raise ValueError(\n            f\"orchestrator.initial_batch_size ({orch.initial_batch_size}) must be <= \"\n            f\"orchestrator.max_batch_size ({orch.max_batch_size})\"\n        )\n\n    # Validate notifications config\n    _KNOWN_WEBHOOK_TYPES = {\"slack\", \"discord\", \"generic\"}\n    if config.notifications.enabled:\n        for i, wh in enumerate(config.notifications.webhooks):\n            if not wh.url:\n                logger.warning(\"notifications.webhooks[%d] has empty URL — will be skipped\", i)\n            if wh.type not in _KNOWN_WEBHOOK_TYPES:\n                logger.warning(\n                    \"notifications.webhooks[%d].type '%s' is not recognized. \"\n                    \"Known types: %s\",\n                    i, wh.type, \", \".join(sorted(_KNOWN_WEBHOOK_TYPES)),\n                )\n\n    # Validate enum-like config fields (warn, don't raise)\n    _ENUM_VALIDATIONS = [\n        (config.claude.provider, (\"claude\", \"openai\", \"gemini\"), \"claude.provider\"),\n        (config.parallel.merge_strategy, (\"rebase\", \"merge\"), \"parallel.merge_strategy\"),\n        (config.judges.fail_action, (\"retry\", \"rollback\", \"warn\"), \"judges.fail_action\"),\n        (config.logging.format, (\"text\", \"json\"), \"logging.format\"),\n        (config.agent_pipeline.review_detail, (\"minimal\", \"standard\", \"thorough\"), \"agent_pipeline.review_detail\"),\n    ]\n    for value, allowed, field_name in _ENUM_VALIDATIONS:\n        if value not in allowed:\n            logger.warning(\n                \"Config field '%s' has unrecognized value '%s'. \"\n                \"Expected one of: %s\",\n                field_name, value, \", \".join(sorted(allowed)),\n            )\n","numLines":636,"startLine":1,"totalLines":636}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_vrtx_011RV62Aa7Fotossn7HmMY5Y","type":"tool_result","content":"     1→\"\"\"Multi-agent pipeline: Planner -> Coder -> Tester -> Reviewer with revision loops.\"\"\"\n     2→\n     3→from __future__ import annotations\n     4→\n     5→import copy\n     6→import json\n     7→import logging\n     8→import re\n     9→import threading\n    10→from dataclasses import dataclass, field\n    11→from enum import Enum\n    12→from pathlib import Path\n    13→from typing import Callable, Dict, List, Optional\n    14→\n    15→from claude_runner import ClaudeResult, ClaudeRunner\n    16→from config_schema import Config\n    17→\n    18→logger = logging.getLogger(__name__)\n    19→\n    20→# Import CycleStateWriter optionally to avoid circular deps\n    21→try:\n    22→    from cycle_state import CycleStateWriter\n    23→except ImportError:\n    24→    CycleStateWriter = None  # type: ignore[assignment,misc]\n    25→\n    26→\n    27→class AgentRole(Enum):\n    28→    PLANNER = \"planner\"\n    29→    CODER = \"coder\"\n    30→    TESTER = \"tester\"\n    31→    REVIEWER = \"reviewer\"\n    32→\n    33→\n    34→@dataclass\n    35→class AgentResult:\n    36→    role: AgentRole\n    37→    success: bool\n    38→    output_text: str = \"\"\n    39→    cost_usd: float = 0.0\n    40→    duration_seconds: float = 0.0\n    41→    error: str = \"\"\n    42→\n    43→\n    44→@dataclass\n    45→class AgentCostSummary:\n    46→    \"\"\"Aggregated cost/duration for a single agent role across all invocations.\"\"\"\n    47→    role: str\n    48→    total_cost_usd: float = 0.0\n    49→    total_duration_seconds: float = 0.0\n    50→    invocation_count: int = 0\n    51→\n    52→\n    53→@dataclass\n    54→class ReviewFinding:\n    55→    \"\"\"A single structured finding from the reviewer.\"\"\"\n    56→    filepath: str\n    57→    line_number: int = 0\n    58→    severity: str = \"warning\"       # \"error\" | \"warning\" | \"information\"\n    59→    category: str = \"\"              # \"quality\" | \"security\" | \"testing\" | \"architecture\"\n    60→    description: str = \"\"\n    61→    suggestion: str = \"\"\n    62→    confidence: float = 0.8\n    63→\n    64→\n    65→@dataclass\n    66→class ReviewReport:\n    67→    \"\"\"Structured review output with categorized findings.\"\"\"\n    68→    approved: bool\n    69→    findings: List[ReviewFinding] = field(default_factory=list)\n    70→    summary: str = \"\"\n    71→    test_suggestions: List[str] = field(default_factory=list)\n    72→\n    73→\n    74→@dataclass\n    75→class PipelineResult:\n    76→    success: bool\n    77→    agent_results: List[AgentResult] = field(default_factory=list)\n    78→    total_cost_usd: float = 0.0\n    79→    total_duration_seconds: float = 0.0\n    80→    revision_count: int = 0\n    81→    final_review_approved: bool = False\n    82→    error: str = \"\"\n    83→    agent_cost_summary: Dict[str, AgentCostSummary] = field(default_factory=dict)\n    84→\n    85→    def format_cost_report(self) -> str:\n    86→        \"\"\"Format a human-readable cost breakdown by agent role.\"\"\"\n    87→        if not self.agent_cost_summary:\n    88→            return \"No agent cost data available.\"\n    89→        lines = [\"Agent Cost Breakdown:\"]\n    90→        for role_name in (\"planner\", \"coder\", \"tester\", \"reviewer\"):\n    91→            if role_name in self.agent_cost_summary:\n    92→                s = self.agent_cost_summary[role_name]\n    93→                pct = (s.total_cost_usd / self.total_cost_usd * 100) if self.total_cost_usd > 0 else 0\n    94→                lines.append(\n    95→                    f\"  {role_name}: ${s.total_cost_usd:.4f} \"\n    96→                    f\"({pct:.1f}%) | {s.total_duration_seconds:.1f}s \"\n    97→                    f\"| {s.invocation_count} invocation(s)\"\n    98→                )\n    99→        lines.append(f\"  TOTAL: ${self.total_cost_usd:.4f} | {self.total_duration_seconds:.1f}s\")\n   100→        return \"\\n\".join(lines)\n   101→\n   102→\n   103→class AgentWorkspace:\n   104→    \"\"\"Simple file-based workspace for inter-agent communication.\"\"\"\n   105→\n   106→    def __init__(self, root: str):\n   107→        self._root = Path(root)\n   108→\n   109→    def clean(self) -> None:\n   110→        \"\"\"Remove all files in the workspace, tolerating permission errors.\"\"\"\n   111→        if self._root.exists():\n   112→            for child in self._root.iterdir():\n   113→                try:\n   114→                    if child.is_file():\n   115→                        child.unlink()\n   116→                    elif child.is_dir():\n   117→                        import shutil\n   118→                        shutil.rmtree(child)\n   119→                except (PermissionError, OSError) as e:\n   120→                    logger.warning(\"Could not remove workspace entry %s: %s\", child, e)\n   121→        self._root.mkdir(parents=True, exist_ok=True)\n   122→\n   123→    def write(self, name: str, content: str) -> None:\n   124→        self._root.mkdir(parents=True, exist_ok=True)\n   125→        (self._root / name).write_text(content)\n   126→\n   127→    def read(self, name: str) -> Optional[str]:\n   128→        path = self._root / name\n   129→        if path.exists():\n   130→            return path.read_text()\n   131→        return None\n   132→\n   133→    def exists(self, name: str) -> bool:\n   134→        return (self._root / name).exists()\n   135→\n   136→\n   137→class AgentPipeline:\n   138→    \"\"\"Orchestrates a Planner -> Coder -> Tester -> Reviewer pipeline.\"\"\"\n   139→\n   140→    def __init__(self, config: Config, cycle_state: Optional[\"CycleStateWriter\"] = None):\n   141→        self.config = config\n   142→        self._ws_dir = str(\n   143→            Path(config.target_dir) / config.paths.agent_workspace_dir\n   144→        )\n   145→        self._active_runner: Optional[ClaudeRunner] = None\n   146→        self._runner_lock = threading.Lock()\n   147→        self._terminated = False\n   148→        self._cycle_state = cycle_state\n   149→\n   150→    def terminate(self) -> None:\n   151→        \"\"\"Terminate the currently running agent subprocess.\n   152→\n   153→        Thread-safe: can be called from a timeout handler in another thread.\n   154→        \"\"\"\n   155→        self._terminated = True\n   156→        with self._runner_lock:\n   157→            runner = self._active_runner\n   158→        if runner is not None:\n   159→            logger.warning(\"Terminating active pipeline agent subprocess\")\n   160→            runner.terminate()\n   161→\n   162→    def _build_runner_for_agent(self, role: AgentRole) -> ClaudeRunner:\n   163→        \"\"\"Build a runner with per-agent model/timeout overrides.\"\"\"\n   164→        agent_config = copy.deepcopy(self.config)\n   165→        role_cfg = getattr(self.config.agent_pipeline, role.value)\n   166→        required_attrs = (\"model\", \"max_turns\", \"timeout_seconds\")\n   167→        missing = [a for a in required_attrs if not hasattr(role_cfg, a)]\n   168→        if missing:\n   169→            raise ValueError(\n   170→                f\"Agent role '{role.value}' config is missing required attributes: \"\n   171→                f\"{', '.join(missing)}. Check agent_pipeline.{role.value} in config.\"\n   172→            )\n   173→        agent_config.claude.model = role_cfg.model\n   174→        agent_config.claude.resolved_model = \"\"\n   175→        agent_config.claude.max_turns = role_cfg.max_turns\n   176→        agent_config.claude.timeout_seconds = role_cfg.timeout_seconds\n   177→        from provider_runner import create_runner\n   178→        return create_runner(agent_config)\n   179→\n   180→    @staticmethod\n   181→    def _parse_review_verdict(review_text: str) -> bool:\n   182→        \"\"\"Parse VERDICT from reviewer output. Defaults to REVISE (conservative).\"\"\"\n   183→        if not review_text:\n   184→            return False\n   185→        for line in review_text.splitlines():\n   186→            match = re.match(r\"\\s*VERDICT:\\s*(APPROVED|REVISE)\\s*\", line, re.IGNORECASE)\n   187→            if match:\n   188→                return match.group(1).upper() == \"APPROVED\"\n   189→        return False\n   190→\n   191→    @staticmethod\n   192→    def _parse_structured_review(review_text: str) -> Optional[ReviewReport]:\n   193→        \"\"\"Parse structured review JSON from reviewer output.\n   194→\n   195→        Looks for a ```json ... ``` block containing a review report with\n   196→        findings. Returns None if no structured review is found (caller\n   197→        should fall back to _parse_review_verdict).\n   198→        \"\"\"\n   199→        if not review_text:\n   200→            return None\n   201→\n   202→        # Extract JSON block from markdown code fence\n   203→        json_match = re.search(\n   204→            r\"```json\\s*\\n(.*?)\\n\\s*```\", review_text, re.DOTALL\n   205→        )\n   206→        if not json_match:\n   207→            return None\n   208→\n   209→        try:\n   210→            data = json.loads(json_match.group(1))\n   211→        except (json.JSONDecodeError, ValueError):\n   212→            return None\n   213→\n   214→        if not isinstance(data, dict):\n   215→            return None\n   216→\n   217→        # Must have \"findings\" key to be considered structured\n   218→        if \"findings\" not in data:\n   219→            return None\n   220→\n   221→        findings = []\n   222→        for f in data.get(\"findings\", []):\n   223→            if not isinstance(f, dict):\n   224→                continue\n   225→            findings.append(ReviewFinding(\n   226→                filepath=str(f.get(\"filepath\", \"\")),\n   227→                line_number=int(f.get(\"line_number\", 0)),\n   228→                severity=str(f.get(\"severity\", \"warning\")).lower(),\n   229→                category=str(f.get(\"category\", \"\")),\n   230→                description=str(f.get(\"description\", \"\")),\n   231→                suggestion=str(f.get(\"suggestion\", \"\")),\n   232→                confidence=float(f.get(\"confidence\", 0.8)),\n   233→            ))\n   234→\n   235→        # Parse verdict from the JSON or fall back to text\n   236→        approved = bool(data.get(\"approved\", False))\n   237→        if \"approved\" not in data:\n   238→            approved = AgentPipeline._parse_review_verdict(review_text)\n   239→\n   240→        return ReviewReport(\n   241→            approved=approved,\n   242→            findings=findings,\n   243→            summary=str(data.get(\"summary\", \"\")),\n   244→            test_suggestions=[\n   245→                str(s) for s in data.get(\"test_suggestions\", [])\n   246→                if isinstance(s, str)\n   247→            ],\n   248→        )\n   249→\n   250→    @staticmethod\n   251→    def _filter_findings(\n   252→        findings: List[ReviewFinding],\n   253→        confidence_threshold: float = 0.70,\n   254→    ) -> List[ReviewFinding]:\n   255→        \"\"\"Filter findings by severity-dependent confidence thresholds.\n   256→\n   257→        - error: keep if confidence >= max(0.85, threshold)\n   258→        - warning: keep if confidence >= threshold\n   259→        - information: keep if confidence >= 0.25\n   260→        Deduplicates by (filepath, line_number).\n   261→        \"\"\"\n   262→        severity_thresholds = {\n   263→            \"error\": max(0.85, confidence_threshold),\n   264→            \"warning\": confidence_threshold,\n   265→            \"information\": 0.25,\n   266→        }\n   267→\n   268→        seen = set()\n   269→        filtered = []\n   270→        for f in findings:\n   271→            threshold = severity_thresholds.get(f.severity, confidence_threshold)\n   272→            if f.confidence < threshold:\n   273→                continue\n   274→            key = (f.filepath, f.line_number)\n   275→            if key in seen and f.line_number != 0:\n   276→                continue\n   277→            if f.line_number != 0:\n   278→                seen.add(key)\n   279→            filtered.append(f)\n   280→        return filtered\n   281→\n   282→    @staticmethod\n   283→    def _format_structured_feedback(report: ReviewReport) -> str:\n   284→        \"\"\"Format a ReviewReport into structured text for the Coder revision prompt.\n   285→\n   286→        Groups findings by file, includes severity and line numbers,\n   287→        and only surfaces error/warning items.\n   288→        \"\"\"\n   289→        lines = [\"## Review Findings (address in priority order)\\n\"]\n   290→\n   291→        # Group by file\n   292→        by_file: Dict[str, List[ReviewFinding]] = {}\n   293→        for f in report.findings:\n   294→            if f.severity not in (\"error\", \"warning\"):\n   295→                continue\n   296→            by_file.setdefault(f.filepath or \"(general)\", []).append(f)\n   297→\n   298→        if not by_file:\n   299→            return report.summary or \"No actionable findings.\"\n   300→\n   301→        # Sort: errors first within each file\n   302→        severity_order = {\"error\": 0, \"warning\": 1}\n   303→        for filepath in sorted(by_file.keys()):\n   304→            lines.append(f\"### {filepath}\")\n   305→            file_findings = sorted(\n   306→                by_file[filepath],\n   307→                key=lambda x: (severity_order.get(x.severity, 2), x.line_number),\n   308→            )\n   309→            for f in file_findings:\n   310→                loc = f\"line {f.line_number}\" if f.line_number else \"general\"\n   311→                lines.append(\n   312→                    f\"- [{f.severity.upper()}] ({loc}) {f.description}\"\n   313→                )\n   314→                if f.suggestion:\n   315→                    lines.append(f\"  Suggestion: {f.suggestion}\")\n   316→            lines.append(\"\")\n   317→\n   318→        return \"\\n\".join(lines)\n   319→\n   320→    @staticmethod\n   321→    def _format_test_suggestions(report: ReviewReport) -> str:\n   322→        \"\"\"Format test suggestions from a ReviewReport for the Tester agent.\"\"\"\n   323→        parts = []\n   324→        if report.test_suggestions:\n   325→            parts.append(\"## Reviewer Test Suggestions\\n\")\n   326→            for i, s in enumerate(report.test_suggestions, 1):\n   327→                parts.append(f\"{i}. {s}\")\n   328→            parts.append(\"\")\n   329→\n   330→        # Also include testing-category findings\n   331→        test_findings = [\n   332→            f for f in report.findings if f.category == \"testing\"\n   333→        ]\n   334→        if test_findings:\n   335→            parts.append(\"## Testing Gaps Identified by Reviewer\\n\")\n   336→            for f in test_findings:\n   337→                loc = f\"{f.filepath}:{f.line_number}\" if f.line_number else f.filepath\n   338→                parts.append(f\"- {loc}: {f.description}\")\n   339→            parts.append(\"\")\n   340→\n   341→        return \"\\n\".join(parts) if parts else \"\"\n   342→\n   343→    def _build_task_description(self, tasks: list) -> str:\n   344→        \"\"\"Combine task descriptions into a single prompt block.\"\"\"\n   345→        if len(tasks) == 1:\n   346→            return tasks[0].description\n   347→        lines = []\n   348→        for i, t in enumerate(tasks, 1):\n   349→            lines.append(f\"{i}. {t.description}\")\n   350→        return \"\\n\".join(lines)\n   351→\n   352→    @staticmethod\n   353→    def _update_cost_summary(\n   354→        result: PipelineResult, agent_result: AgentResult\n   355→    ) -> None:\n   356→        \"\"\"Update the per-agent cost summary with a new agent result.\"\"\"\n   357→        role_name = agent_result.role.value\n   358→        if role_name not in result.agent_cost_summary:\n   359→            result.agent_cost_summary[role_name] = AgentCostSummary(role=role_name)\n   360→        summary = result.agent_cost_summary[role_name]\n   361→        summary.total_cost_usd += agent_result.cost_usd\n   362→        summary.total_duration_seconds += agent_result.duration_seconds\n   363→        summary.invocation_count += 1\n   364→\n   365→    def run(\n   366→        self,\n   367→        tasks: list,\n   368→        rollback_fn: Callable[[str], None],\n   369→        snapshot,\n   370→    ) -> PipelineResult:\n   371→        \"\"\"Execute the full pipeline, returning a PipelineResult.\"\"\"\n   372→        ap = self.config.agent_pipeline\n   373→        workspace = AgentWorkspace(self._ws_dir)\n   374→        task_desc = self._build_task_description(tasks)\n   375→\n   376→        result = PipelineResult(success=False)\n   377→\n   378→        def _run_agent(role: AgentRole, prompt: str) -> AgentResult:\n   379→            role_cfg = getattr(ap, role.value)\n   380→            if not role_cfg.enabled:\n   381→                return AgentResult(\n   382→                    role=role, success=True, output_text=\"(skipped)\",\n   383→                )\n   384→            # Update live cycle state\n   385→            if self._cycle_state is not None:\n   386→                self._cycle_state.update(\n   387→                    pipeline_agent=role.value,\n   388→                    accumulated_cost=result.total_cost_usd,\n   389→                )\n   390→            agent_runner = self._build_runner_for_agent(role)\n   391→            with self._runner_lock:\n   392→                self._active_runner = agent_runner\n   393→            try:\n   394→                if self._terminated:\n   395→                    return AgentResult(\n   396→                        role=role, success=False, error=\"Pipeline was terminated\",\n   397→                    )\n   398→                cr = agent_runner.run(prompt)\n   399→            finally:\n   400→                with self._runner_lock:\n   401→                    self._active_runner = None\n   402→            return AgentResult(\n   403→                role=role,\n   404→                success=cr.success,\n   405→                output_text=cr.result_text,\n   406→                cost_usd=cr.cost_usd,\n   407→                duration_seconds=cr.duration_seconds,\n   408→                error=cr.error,\n   409→            )\n   410→\n   411→        max_revisions = ap.max_revisions\n   412→        revision = 0\n   413→\n   414→        # --- Planner (runs once, not on revisions) ---\n   415→        planner_prompt = (\n   416→            f\"You are the PLANNER agent.\\n\\n\"\n   417→            f\"TASK:\\n{task_desc}\\n\\n\"\n   418→            f\"Create a detailed plan for implementing the above task. \"\n   419→            f\"Write the plan to {self._ws_dir}/plan.md\"\n   420→        )\n   421→        planner_result = _run_agent(AgentRole.PLANNER, planner_prompt)\n   422→        result.agent_results.append(planner_result)\n   423→        result.total_cost_usd += planner_result.cost_usd\n   424→        result.total_duration_seconds += planner_result.duration_seconds\n   425→        self._update_cost_summary(result, planner_result)\n   426→\n   427→        if not planner_result.success:\n   428→            result.error = f\"Planner failed: {planner_result.error}\"\n   429→            logger.info(result.format_cost_report())\n   430→            return result\n   431→\n   432→        # Rollback any file changes from planner\n   433→        rollback_fn(snapshot)\n   434→\n   435→        plan_text = workspace.read(\"plan.md\") or planner_result.output_text\n   436→\n   437→        while True:\n   438→            # Cost guard: abort if accumulated cost exceeds pipeline budget\n   439→            pipeline_cost_limit = ap.max_pipeline_cost_usd\n   440→            if pipeline_cost_limit <= 0:\n   441→                pipeline_cost_limit = self.config.safety.max_cost_usd_per_hour * 0.5\n   442→            if result.total_cost_usd >= pipeline_cost_limit:\n   443→                logger.warning(\n   444→                    \"Pipeline cost guard: $%.2f accumulated (limit $%.2f), aborting\",\n   445→                    result.total_cost_usd, pipeline_cost_limit,\n   446→                )\n   447→                result.error = (\n   448→                    f\"Pipeline cost limit exceeded \"\n   449→                    f\"(${result.total_cost_usd:.2f} >= ${pipeline_cost_limit:.2f})\"\n   450→                )\n   451→                logger.info(result.format_cost_report())\n   452→                return result\n   453→\n   454→            if self._terminated:\n   455→                result.error = \"Pipeline was terminated\"\n   456→                return result\n   457→\n   458→            # Read review feedback before cleaning workspace (reviewer wrote it last iteration)\n   459→            review_text = workspace.read(\"review.md\") or \"\"\n   460→            last_review_report: Optional[ReviewReport] = None\n   461→            if revision > 0 and review_text:\n   462→                last_review_report = self._parse_structured_review(review_text)\n   463→                if last_review_report is not None:\n   464→                    confidence_threshold = getattr(\n   465→                        ap, \"review_confidence_threshold\", 0.70\n   466→                    )\n   467→                    last_review_report.findings = self._filter_findings(\n   468→                        last_review_report.findings, confidence_threshold\n   469→                    )\n   470→            workspace.clean()\n   471→\n   472→            # --- Coder ---\n   473→\n   474→            revision_context = \"\"\n   475→            if revision > 0 and review_text:\n   476→                if last_review_report is not None and last_review_report.findings:\n   477→                    structured_feedback = self._format_structured_feedback(\n   478→                        last_review_report\n   479→                    )\n   480→                    revision_context = (\n   481→                        f\"\\n\\nPREVIOUS REVIEW FEEDBACK (revision {revision}):\\n\"\n   482→                        f\"{structured_feedback}\\n\"\n   483→                        f\"Address the reviewer's findings above, prioritizing \"\n   484→                        f\"errors first, then warnings.\"\n   485→                    )\n   486→                else:\n   487→                    revision_context = (\n   488→                        f\"\\n\\nPREVIOUS REVIEW FEEDBACK (revision {revision}):\\n\"\n   489→                        f\"{review_text}\\n\"\n   490→                        f\"Address the reviewer's feedback in your implementation.\"\n   491→                    )\n   492→\n   493→            coder_prompt = (\n   494→                f\"You are the CODER agent.\\n\\n\"\n   495→                f\"TASK:\\n{task_desc}\\n\\n\"\n   496→                f\"PLAN:\\n{plan_text}\\n\"\n   497→                f\"{revision_context}\\n\"\n   498→                f\"Implement the changes described in the plan.\"\n   499→            )\n   500→            coder_result = _run_agent(AgentRole.CODER, coder_prompt)\n   501→            result.agent_results.append(coder_result)\n   502→            result.total_cost_usd += coder_result.cost_usd\n   503→            result.total_duration_seconds += coder_result.duration_seconds\n   504→            self._update_cost_summary(result, coder_result)\n   505→\n   506→            if not coder_result.success:\n   507→                result.error = f\"Coder failed: {coder_result.error}\"\n   508→                logger.info(result.format_cost_report())\n   509→                return result\n   510→\n   511→            # --- Tester ---\n   512→            test_suggestion_context = \"\"\n   513→            if last_review_report is not None:\n   514→                test_suggestions_text = self._format_test_suggestions(\n   515→                    last_review_report\n   516→                )\n   517→                if test_suggestions_text:\n   518→                    test_suggestion_context = f\"\\n\\n{test_suggestions_text}\"\n   519→\n   520→            tester_prompt = (\n   521→                f\"You are the TESTER agent.\\n\\n\"\n   522→                f\"TASK:\\n{task_desc}\\n\\n\"\n   523→                f\"Run the test suite and report any failures.\"\n   524→                f\"{test_suggestion_context}\"\n   525→            )\n   526→            tester_result = _run_agent(AgentRole.TESTER, tester_prompt)\n   527→            result.agent_results.append(tester_result)\n   528→            result.total_cost_usd += tester_result.cost_usd\n   529→            result.total_duration_seconds += tester_result.duration_seconds\n   530→            self._update_cost_summary(result, tester_result)\n   531→\n   532→            # Fix 7: Check tester result — if the tester CLI crashed, treat\n   533→            # it as a revision-needed signal rather than silently continuing.\n   534→            if not tester_result.success:\n   535→                logger.warning(\n   536→                    \"Tester agent failed: %s — treating as revision needed\",\n   537→                    tester_result.error,\n   538→                )\n   539→                if revision < max_revisions:\n   540→                    revision += 1\n   541→                    result.revision_count = revision\n   542→                    rollback_fn(snapshot)\n   543→                    workspace.write(\"review.md\", f\"VERDICT: REVISE\\nTester failed: {tester_result.error}\")\n   544→                    continue\n   545→                else:\n   546→                    result.error = f\"Tester failed after exhausting revisions: {tester_result.error}\"\n   547→                    result.revision_count = revision\n   548→                    logger.info(result.format_cost_report())\n   549→                    return result\n   550→\n   551→            # --- Reviewer ---\n   552→            review_detail = getattr(ap, \"review_detail\", \"standard\")\n   553→\n   554→            if review_detail == \"minimal\":\n   555→                reviewer_instructions = (\n   556→                    f\"Review the code changes. Write your review to \"\n   557→                    f\"{self._ws_dir}/review.md.\\n\"\n   558→                    f\"End your review with either:\\n\"\n   559→                    f\"VERDICT: APPROVED\\n\"\n   560→                    f\"or:\\n\"\n   561→                    f\"VERDICT: REVISE\"\n   562→                )\n   563→            else:\n   564→                detail_guidance = \"\"\n   565→                if review_detail == \"thorough\":\n   566→                    detail_guidance = (\n   567→                        \"Be thorough: examine every changed file, check edge \"\n   568→                        \"cases, and verify error handling.\\n\\n\"\n   569→                    )\n   570→\n   571→                reviewer_instructions = (\n   572→                    f\"Review the code changes across these categories:\\n\"\n   573→                    f\"1. **Code Quality & Performance** — unnecessary code, \"\n   574→                    f\"resource leaks, N+1 patterns, missing error handling\\n\"\n   575→                    f\"2. **Best Practices** — anti-patterns, deprecated usage, \"\n   576→                    f\"naming conventions, framework compliance\\n\"\n   577→                    f\"3. **Test Coverage** — untested code paths, missing edge \"\n   578→                    f\"cases, suggest specific test cases\\n\"\n   579→                    f\"4. **Architectural Concerns** — circular deps, tight \"\n   580→                    f\"coupling, layer violations\\n\\n\"\n   581→                    f\"{detail_guidance}\"\n   582→                    f\"Write your review to {self._ws_dir}/review.md.\\n\\n\"\n   583→                    f\"Include a structured JSON block in your review with this format:\\n\"\n   584→                    f\"```json\\n\"\n   585→                    f'{{\\n'\n   586→                    f'  \"approved\": false,\\n'\n   587→                    f'  \"summary\": \"Brief overall assessment\",\\n'\n   588→                    f'  \"findings\": [\\n'\n   589→                    f'    {{\\n'\n   590→                    f'      \"filepath\": \"path/to/file.py\",\\n'\n   591→                    f'      \"line_number\": 42,\\n'\n   592→                    f'      \"severity\": \"error\",\\n'\n   593→                    f'      \"category\": \"quality\",\\n'\n   594→                    f'      \"description\": \"What is wrong\",\\n'\n   595→                    f'      \"suggestion\": \"How to fix it\",\\n'\n   596→                    f'      \"confidence\": 0.95\\n'\n   597→                    f'    }}\\n'\n   598→                    f'  ],\\n'\n   599→                    f'  \"test_suggestions\": [\\n'\n   600→                    f'    \"Test that X handles empty input\"\\n'\n   601→                    f'  ]\\n'\n   602→                    f'}}\\n'\n   603→                    f\"```\\n\\n\"\n   604→                    f\"Severity levels: \\\"error\\\" (must fix), \\\"warning\\\" \"\n   605→                    f\"(should fix), \\\"information\\\" (nice to have).\\n\"\n   606→                    f\"Categories: \\\"quality\\\", \\\"security\\\", \\\"testing\\\", \"\n   607→                    f\"\\\"architecture\\\".\\n\"\n   608→                    f\"Confidence: 0.0 to 1.0 — how certain you are this is a \"\n   609→                    f\"real issue.\\n\\n\"\n   610→                    f\"After the JSON block, end your review with:\\n\"\n   611→                    f\"VERDICT: APPROVED\\n\"\n   612→                    f\"or:\\n\"\n   613→                    f\"VERDICT: REVISE\"\n   614→                )\n   615→\n   616→            reviewer_prompt = (\n   617→                f\"You are the REVIEWER agent.\\n\\n\"\n   618→                f\"TASK:\\n{task_desc}\\n\\n\"\n   619→                f\"{reviewer_instructions}\"\n   620→            )\n   621→            reviewer_result = _run_agent(AgentRole.REVIEWER, reviewer_prompt)\n   622→            result.agent_results.append(reviewer_result)\n   623→            result.total_cost_usd += reviewer_result.cost_usd\n   624→            result.total_duration_seconds += reviewer_result.duration_seconds\n   625→            self._update_cost_summary(result, reviewer_result)\n   626→\n   627→            # Determine verdict\n   628→            if not getattr(ap.reviewer, \"enabled\", True):\n   629→                # Reviewer disabled -> auto-approve\n   630→                result.success = True\n   631→                result.final_review_approved = True\n   632→                logger.info(result.format_cost_report())\n   633→                return result\n   634→\n   635→            # If the reviewer CLI crashed, abort rather than wasting revisions\n   636→            if not reviewer_result.success:\n   637→                result.error = f\"Reviewer agent failed: {reviewer_result.error}\"\n   638→                logger.warning(result.error)\n   639→                logger.info(result.format_cost_report())\n   640→                return result\n   641→\n   642→            review_content = workspace.read(\"review.md\") or reviewer_result.output_text\n   643→\n   644→            # If the reviewer produced no VERDICT line, abort rather than\n   645→            # defaulting to REVISE and wasting costly revision iterations\n   646→            if not review_content or \"VERDICT:\" not in review_content.upper():\n   647→                result.error = (\n   648→                    \"Reviewer produced no VERDICT line — aborting to avoid \"\n   649→                    \"wasteful revision loop\"\n   650→                )\n   651→                logger.warning(result.error)\n   652→                logger.info(result.format_cost_report())\n   653→                return result\n   654→\n   655→            # Try structured review parsing first, fall back to simple verdict\n   656→            structured_report = self._parse_structured_review(review_content)\n   657→            if structured_report is not None:\n   658→                approved = structured_report.approved\n   659→            else:\n   660→                approved = self._parse_review_verdict(review_content)\n   661→\n   662→            if approved:\n   663→                result.success = True\n   664→                result.final_review_approved = True\n   665→                logger.info(result.format_cost_report())\n   666→                return result\n   667→\n   668→            # Reviewer rejected — try revision if budget allows\n   669→            if revision < max_revisions:\n   670→                revision += 1\n   671→                result.revision_count = revision\n   672→                if self._cycle_state is not None:\n   673→                    self._cycle_state.update(pipeline_revision=revision)\n   674→                rollback_fn(snapshot)\n   675→                # Restore review feedback so the next iteration can read it\n   676→                # (rollback's git clean -fd deletes untracked workspace files)\n   677→                workspace.write(\"review.md\", review_content)\n   678→                # Loop continues with new iteration\n   679→            else:\n   680→                # Exhausted revisions\n   681→                result.success = False\n   682→                result.error = \"Reviewer rejected after exhausting all revisions\"\n   683→                result.final_review_approved = False\n   684→                result.revision_count = revision\n   685→                logger.info(result.format_cost_report())\n   686→                return result\n   687→"}]},"parent_tool_use_id":null,"session_id":"8d82d89c-1e3e-44f1-8b61-542209a31f5e","uuid":"e439b885-77b2-43c0-a7af-e93403d216a3","tool_use_result":{"type":"text","file":{"filePath":"/Users/sameertkhanna/Documents/auto_claude_code/agent_pipeline.py","content":"\"\"\"Multi-agent pipeline: Planner -> Coder -> Tester -> Reviewer with revision loops.\"\"\"\n\nfrom __future__ import annotations\n\nimport copy\nimport json\nimport logging\nimport re\nimport threading\nfrom dataclasses import dataclass, field\nfrom enum import Enum\nfrom pathlib import Path\nfrom typing import Callable, Dict, List, Optional\n\nfrom claude_runner import ClaudeResult, ClaudeRunner\nfrom config_schema import Config\n\nlogger = logging.getLogger(__name__)\n\n# Import CycleStateWriter optionally to avoid circular deps\ntry:\n    from cycle_state import CycleStateWriter\nexcept ImportError:\n    CycleStateWriter = None  # type: ignore[assignment,misc]\n\n\nclass AgentRole(Enum):\n    PLANNER = \"planner\"\n    CODER = \"coder\"\n    TESTER = \"tester\"\n    REVIEWER = \"reviewer\"\n\n\n@dataclass\nclass AgentResult:\n    role: AgentRole\n    success: bool\n    output_text: str = \"\"\n    cost_usd: float = 0.0\n    duration_seconds: float = 0.0\n    error: str = \"\"\n\n\n@dataclass\nclass AgentCostSummary:\n    \"\"\"Aggregated cost/duration for a single agent role across all invocations.\"\"\"\n    role: str\n    total_cost_usd: float = 0.0\n    total_duration_seconds: float = 0.0\n    invocation_count: int = 0\n\n\n@dataclass\nclass ReviewFinding:\n    \"\"\"A single structured finding from the reviewer.\"\"\"\n    filepath: str\n    line_number: int = 0\n    severity: str = \"warning\"       # \"error\" | \"warning\" | \"information\"\n    category: str = \"\"              # \"quality\" | \"security\" | \"testing\" | \"architecture\"\n    description: str = \"\"\n    suggestion: str = \"\"\n    confidence: float = 0.8\n\n\n@dataclass\nclass ReviewReport:\n    \"\"\"Structured review output with categorized findings.\"\"\"\n    approved: bool\n    findings: List[ReviewFinding] = field(default_factory=list)\n    summary: str = \"\"\n    test_suggestions: List[str] = field(default_factory=list)\n\n\n@dataclass\nclass PipelineResult:\n    success: bool\n    agent_results: List[AgentResult] = field(default_factory=list)\n    total_cost_usd: float = 0.0\n    total_duration_seconds: float = 0.0\n    revision_count: int = 0\n    final_review_approved: bool = False\n    error: str = \"\"\n    agent_cost_summary: Dict[str, AgentCostSummary] = field(default_factory=dict)\n\n    def format_cost_report(self) -> str:\n        \"\"\"Format a human-readable cost breakdown by agent role.\"\"\"\n        if not self.agent_cost_summary:\n            return \"No agent cost data available.\"\n        lines = [\"Agent Cost Breakdown:\"]\n        for role_name in (\"planner\", \"coder\", \"tester\", \"reviewer\"):\n            if role_name in self.agent_cost_summary:\n                s = self.agent_cost_summary[role_name]\n                pct = (s.total_cost_usd / self.total_cost_usd * 100) if self.total_cost_usd > 0 else 0\n                lines.append(\n                    f\"  {role_name}: ${s.total_cost_usd:.4f} \"\n                    f\"({pct:.1f}%) | {s.total_duration_seconds:.1f}s \"\n                    f\"| {s.invocation_count} invocation(s)\"\n                )\n        lines.append(f\"  TOTAL: ${self.total_cost_usd:.4f} | {self.total_duration_seconds:.1f}s\")\n        return \"\\n\".join(lines)\n\n\nclass AgentWorkspace:\n    \"\"\"Simple file-based workspace for inter-agent communication.\"\"\"\n\n    def __init__(self, root: str):\n        self._root = Path(root)\n\n    def clean(self) -> None:\n        \"\"\"Remove all files in the workspace, tolerating permission errors.\"\"\"\n        if self._root.exists():\n            for child in self._root.iterdir():\n                try:\n                    if child.is_file():\n                        child.unlink()\n                    elif child.is_dir():\n                        import shutil\n                        shutil.rmtree(child)\n                except (PermissionError, OSError) as e:\n                    logger.warning(\"Could not remove workspace entry %s: %s\", child, e)\n        self._root.mkdir(parents=True, exist_ok=True)\n\n    def write(self, name: str, content: str) -> None:\n        self._root.mkdir(parents=True, exist_ok=True)\n        (self._root / name).write_text(content)\n\n    def read(self, name: str) -> Optional[str]:\n        path = self._root / name\n        if path.exists():\n            return path.read_text()\n        return None\n\n    def exists(self, name: str) -> bool:\n        return (self._root / name).exists()\n\n\nclass AgentPipeline:\n    \"\"\"Orchestrates a Planner -> Coder -> Tester -> Reviewer pipeline.\"\"\"\n\n    def __init__(self, config: Config, cycle_state: Optional[\"CycleStateWriter\"] = None):\n        self.config = config\n        self._ws_dir = str(\n            Path(config.target_dir) / config.paths.agent_workspace_dir\n        )\n        self._active_runner: Optional[ClaudeRunner] = None\n        self._runner_lock = threading.Lock()\n        self._terminated = False\n        self._cycle_state = cycle_state\n\n    def terminate(self) -> None:\n        \"\"\"Terminate the currently running agent subprocess.\n\n        Thread-safe: can be called from a timeout handler in another thread.\n        \"\"\"\n        self._terminated = True\n        with self._runner_lock:\n            runner = self._active_runner\n        if runner is not None:\n            logger.warning(\"Terminating active pipeline agent subprocess\")\n            runner.terminate()\n\n    def _build_runner_for_agent(self, role: AgentRole) -> ClaudeRunner:\n        \"\"\"Build a runner with per-agent model/timeout overrides.\"\"\"\n        agent_config = copy.deepcopy(self.config)\n        role_cfg = getattr(self.config.agent_pipeline, role.value)\n        required_attrs = (\"model\", \"max_turns\", \"timeout_seconds\")\n        missing = [a for a in required_attrs if not hasattr(role_cfg, a)]\n        if missing:\n            raise ValueError(\n                f\"Agent role '{role.value}' config is missing required attributes: \"\n                f\"{', '.join(missing)}. Check agent_pipeline.{role.value} in config.\"\n            )\n        agent_config.claude.model = role_cfg.model\n        agent_config.claude.resolved_model = \"\"\n        agent_config.claude.max_turns = role_cfg.max_turns\n        agent_config.claude.timeout_seconds = role_cfg.timeout_seconds\n        from provider_runner import create_runner\n        return create_runner(agent_config)\n\n    @staticmethod\n    def _parse_review_verdict(review_text: str) -> bool:\n        \"\"\"Parse VERDICT from reviewer output. Defaults to REVISE (conservative).\"\"\"\n        if not review_text:\n            return False\n        for line in review_text.splitlines():\n            match = re.match(r\"\\s*VERDICT:\\s*(APPROVED|REVISE)\\s*\", line, re.IGNORECASE)\n            if match:\n                return match.group(1).upper() == \"APPROVED\"\n        return False\n\n    @staticmethod\n    def _parse_structured_review(review_text: str) -> Optional[ReviewReport]:\n        \"\"\"Parse structured review JSON from reviewer output.\n\n        Looks for a ```json ... ``` block containing a review report with\n        findings. Returns None if no structured review is found (caller\n        should fall back to _parse_review_verdict).\n        \"\"\"\n        if not review_text:\n            return None\n\n        # Extract JSON block from markdown code fence\n        json_match = re.search(\n            r\"```json\\s*\\n(.*?)\\n\\s*```\", review_text, re.DOTALL\n        )\n        if not json_match:\n            return None\n\n        try:\n            data = json.loads(json_match.group(1))\n        except (json.JSONDecodeError, ValueError):\n            return None\n\n        if not isinstance(data, dict):\n            return None\n\n        # Must have \"findings\" key to be considered structured\n        if \"findings\" not in data:\n            return None\n\n        findings = []\n        for f in data.get(\"findings\", []):\n            if not isinstance(f, dict):\n                continue\n            findings.append(ReviewFinding(\n                filepath=str(f.get(\"filepath\", \"\")),\n                line_number=int(f.get(\"line_number\", 0)),\n                severity=str(f.get(\"severity\", \"warning\")).lower(),\n                category=str(f.get(\"category\", \"\")),\n                description=str(f.get(\"description\", \"\")),\n                suggestion=str(f.get(\"suggestion\", \"\")),\n                confidence=float(f.get(\"confidence\", 0.8)),\n            ))\n\n        # Parse verdict from the JSON or fall back to text\n        approved = bool(data.get(\"approved\", False))\n        if \"approved\" not in data:\n            approved = AgentPipeline._parse_review_verdict(review_text)\n\n        return ReviewReport(\n            approved=approved,\n            findings=findings,\n            summary=str(data.get(\"summary\", \"\")),\n            test_suggestions=[\n                str(s) for s in data.get(\"test_suggestions\", [])\n                if isinstance(s, str)\n            ],\n        )\n\n    @staticmethod\n    def _filter_findings(\n        findings: List[ReviewFinding],\n        confidence_threshold: float = 0.70,\n    ) -> List[ReviewFinding]:\n        \"\"\"Filter findings by severity-dependent confidence thresholds.\n\n        - error: keep if confidence >= max(0.85, threshold)\n        - warning: keep if confidence >= threshold\n        - information: keep if confidence >= 0.25\n        Deduplicates by (filepath, line_number).\n        \"\"\"\n        severity_thresholds = {\n            \"error\": max(0.85, confidence_threshold),\n            \"warning\": confidence_threshold,\n            \"information\": 0.25,\n        }\n\n        seen = set()\n        filtered = []\n        for f in findings:\n            threshold = severity_thresholds.get(f.severity, confidence_threshold)\n            if f.confidence < threshold:\n                continue\n            key = (f.filepath, f.line_number)\n            if key in seen and f.line_number != 0:\n                continue\n            if f.line_number != 0:\n                seen.add(key)\n            filtered.append(f)\n        return filtered\n\n    @staticmethod\n    def _format_structured_feedback(report: ReviewReport) -> str:\n        \"\"\"Format a ReviewReport into structured text for the Coder revision prompt.\n\n        Groups findings by file, includes severity and line numbers,\n        and only surfaces error/warning items.\n        \"\"\"\n        lines = [\"## Review Findings (address in priority order)\\n\"]\n\n        # Group by file\n        by_file: Dict[str, List[ReviewFinding]] = {}\n        for f in report.findings:\n            if f.severity not in (\"error\", \"warning\"):\n                continue\n            by_file.setdefault(f.filepath or \"(general)\", []).append(f)\n\n        if not by_file:\n            return report.summary or \"No actionable findings.\"\n\n        # Sort: errors first within each file\n        severity_order = {\"error\": 0, \"warning\": 1}\n        for filepath in sorted(by_file.keys()):\n            lines.append(f\"### {filepath}\")\n            file_findings = sorted(\n                by_file[filepath],\n                key=lambda x: (severity_order.get(x.severity, 2), x.line_number),\n            )\n            for f in file_findings:\n                loc = f\"line {f.line_number}\" if f.line_number else \"general\"\n                lines.append(\n                    f\"- [{f.severity.upper()}] ({loc}) {f.description}\"\n                )\n                if f.suggestion:\n                    lines.append(f\"  Suggestion: {f.suggestion}\")\n            lines.append(\"\")\n\n        return \"\\n\".join(lines)\n\n    @staticmethod\n    def _format_test_suggestions(report: ReviewReport) -> str:\n        \"\"\"Format test suggestions from a ReviewReport for the Tester agent.\"\"\"\n        parts = []\n        if report.test_suggestions:\n            parts.append(\"## Reviewer Test Suggestions\\n\")\n            for i, s in enumerate(report.test_suggestions, 1):\n                parts.append(f\"{i}. {s}\")\n            parts.append(\"\")\n\n        # Also include testing-category findings\n        test_findings = [\n            f for f in report.findings if f.category == \"testing\"\n        ]\n        if test_findings:\n            parts.append(\"## Testing Gaps Identified by Reviewer\\n\")\n            for f in test_findings:\n                loc = f\"{f.filepath}:{f.line_number}\" if f.line_number else f.filepath\n                parts.append(f\"- {loc}: {f.description}\")\n            parts.append(\"\")\n\n        return \"\\n\".join(parts) if parts else \"\"\n\n    def _build_task_description(self, tasks: list) -> str:\n        \"\"\"Combine task descriptions into a single prompt block.\"\"\"\n        if len(tasks) == 1:\n            return tasks[0].description\n        lines = []\n        for i, t in enumerate(tasks, 1):\n            lines.append(f\"{i}. {t.description}\")\n        return \"\\n\".join(lines)\n\n    @staticmethod\n    def _update_cost_summary(\n        result: PipelineResult, agent_result: AgentResult\n    ) -> None:\n        \"\"\"Update the per-agent cost summary with a new agent result.\"\"\"\n        role_name = agent_result.role.value\n        if role_name not in result.agent_cost_summary:\n            result.agent_cost_summary[role_name] = AgentCostSummary(role=role_name)\n        summary = result.agent_cost_summary[role_name]\n        summary.total_cost_usd += agent_result.cost_usd\n        summary.total_duration_seconds += agent_result.duration_seconds\n        summary.invocation_count += 1\n\n    def run(\n        self,\n        tasks: list,\n        rollback_fn: Callable[[str], None],\n        snapshot,\n    ) -> PipelineResult:\n        \"\"\"Execute the full pipeline, returning a PipelineResult.\"\"\"\n        ap = self.config.agent_pipeline\n        workspace = AgentWorkspace(self._ws_dir)\n        task_desc = self._build_task_description(tasks)\n\n        result = PipelineResult(success=False)\n\n        def _run_agent(role: AgentRole, prompt: str) -> AgentResult:\n            role_cfg = getattr(ap, role.value)\n            if not role_cfg.enabled:\n                return AgentResult(\n                    role=role, success=True, output_text=\"(skipped)\",\n                )\n            # Update live cycle state\n            if self._cycle_state is not None:\n                self._cycle_state.update(\n                    pipeline_agent=role.value,\n                    accumulated_cost=result.total_cost_usd,\n                )\n            agent_runner = self._build_runner_for_agent(role)\n            with self._runner_lock:\n                self._active_runner = agent_runner\n            try:\n                if self._terminated:\n                    return AgentResult(\n                        role=role, success=False, error=\"Pipeline was terminated\",\n                    )\n                cr = agent_runner.run(prompt)\n            finally:\n                with self._runner_lock:\n                    self._active_runner = None\n            return AgentResult(\n                role=role,\n                success=cr.success,\n                output_text=cr.result_text,\n                cost_usd=cr.cost_usd,\n                duration_seconds=cr.duration_seconds,\n                error=cr.error,\n            )\n\n        max_revisions = ap.max_revisions\n        revision = 0\n\n        # --- Planner (runs once, not on revisions) ---\n        planner_prompt = (\n            f\"You are the PLANNER agent.\\n\\n\"\n            f\"TASK:\\n{task_desc}\\n\\n\"\n            f\"Create a detailed plan for implementing the above task. \"\n            f\"Write the plan to {self._ws_dir}/plan.md\"\n        )\n        planner_result = _run_agent(AgentRole.PLANNER, planner_prompt)\n        result.agent_results.append(planner_result)\n        result.total_cost_usd += planner_result.cost_usd\n        result.total_duration_seconds += planner_result.duration_seconds\n        self._update_cost_summary(result, planner_result)\n\n        if not planner_result.success:\n            result.error = f\"Planner failed: {planner_result.error}\"\n            logger.info(result.format_cost_report())\n            return result\n\n        # Rollback any file changes from planner\n        rollback_fn(snapshot)\n\n        plan_text = workspace.read(\"plan.md\") or planner_result.output_text\n\n        while True:\n            # Cost guard: abort if accumulated cost exceeds pipeline budget\n            pipeline_cost_limit = ap.max_pipeline_cost_usd\n            if pipeline_cost_limit <= 0:\n                pipeline_cost_limit = self.config.safety.max_cost_usd_per_hour * 0.5\n            if result.total_cost_usd >= pipeline_cost_limit:\n                logger.warning(\n                    \"Pipeline cost guard: $%.2f accumulated (limit $%.2f), aborting\",\n                    result.total_cost_usd, pipeline_cost_limit,\n                )\n                result.error = (\n                    f\"Pipeline cost limit exceeded \"\n                    f\"(${result.total_cost_usd:.2f} >= ${pipeline_cost_limit:.2f})\"\n                )\n                logger.info(result.format_cost_report())\n                return result\n\n            if self._terminated:\n                result.error = \"Pipeline was terminated\"\n                return result\n\n            # Read review feedback before cleaning workspace (reviewer wrote it last iteration)\n            review_text = workspace.read(\"review.md\") or \"\"\n            last_review_report: Optional[ReviewReport] = None\n            if revision > 0 and review_text:\n                last_review_report = self._parse_structured_review(review_text)\n                if last_review_report is not None:\n                    confidence_threshold = getattr(\n                        ap, \"review_confidence_threshold\", 0.70\n                    )\n                    last_review_report.findings = self._filter_findings(\n                        last_review_report.findings, confidence_threshold\n                    )\n            workspace.clean()\n\n            # --- Coder ---\n\n            revision_context = \"\"\n            if revision > 0 and review_text:\n                if last_review_report is not None and last_review_report.findings:\n                    structured_feedback = self._format_structured_feedback(\n                        last_review_report\n                    )\n                    revision_context = (\n                        f\"\\n\\nPREVIOUS REVIEW FEEDBACK (revision {revision}):\\n\"\n                        f\"{structured_feedback}\\n\"\n                        f\"Address the reviewer's findings above, prioritizing \"\n                        f\"errors first, then warnings.\"\n                    )\n                else:\n                    revision_context = (\n                        f\"\\n\\nPREVIOUS REVIEW FEEDBACK (revision {revision}):\\n\"\n                        f\"{review_text}\\n\"\n                        f\"Address the reviewer's feedback in your implementation.\"\n                    )\n\n            coder_prompt = (\n                f\"You are the CODER agent.\\n\\n\"\n                f\"TASK:\\n{task_desc}\\n\\n\"\n                f\"PLAN:\\n{plan_text}\\n\"\n                f\"{revision_context}\\n\"\n                f\"Implement the changes described in the plan.\"\n            )\n            coder_result = _run_agent(AgentRole.CODER, coder_prompt)\n            result.agent_results.append(coder_result)\n            result.total_cost_usd += coder_result.cost_usd\n            result.total_duration_seconds += coder_result.duration_seconds\n            self._update_cost_summary(result, coder_result)\n\n            if not coder_result.success:\n                result.error = f\"Coder failed: {coder_result.error}\"\n                logger.info(result.format_cost_report())\n                return result\n\n            # --- Tester ---\n            test_suggestion_context = \"\"\n            if last_review_report is not None:\n                test_suggestions_text = self._format_test_suggestions(\n                    last_review_report\n                )\n                if test_suggestions_text:\n                    test_suggestion_context = f\"\\n\\n{test_suggestions_text}\"\n\n            tester_prompt = (\n                f\"You are the TESTER agent.\\n\\n\"\n                f\"TASK:\\n{task_desc}\\n\\n\"\n                f\"Run the test suite and report any failures.\"\n                f\"{test_suggestion_context}\"\n            )\n            tester_result = _run_agent(AgentRole.TESTER, tester_prompt)\n            result.agent_results.append(tester_result)\n            result.total_cost_usd += tester_result.cost_usd\n            result.total_duration_seconds += tester_result.duration_seconds\n            self._update_cost_summary(result, tester_result)\n\n            # Fix 7: Check tester result — if the tester CLI crashed, treat\n            # it as a revision-needed signal rather than silently continuing.\n            if not tester_result.success:\n                logger.warning(\n                    \"Tester agent failed: %s — treating as revision needed\",\n                    tester_result.error,\n                )\n                if revision < max_revisions:\n                    revision += 1\n                    result.revision_count = revision\n                    rollback_fn(snapshot)\n                    workspace.write(\"review.md\", f\"VERDICT: REVISE\\nTester failed: {tester_result.error}\")\n                    continue\n                else:\n                    result.error = f\"Tester failed after exhausting revisions: {tester_result.error}\"\n                    result.revision_count = revision\n                    logger.info(result.format_cost_report())\n                    return result\n\n            # --- Reviewer ---\n            review_detail = getattr(ap, \"review_detail\", \"standard\")\n\n            if review_detail == \"minimal\":\n                reviewer_instructions = (\n                    f\"Review the code changes. Write your review to \"\n                    f\"{self._ws_dir}/review.md.\\n\"\n                    f\"End your review with either:\\n\"\n                    f\"VERDICT: APPROVED\\n\"\n                    f\"or:\\n\"\n                    f\"VERDICT: REVISE\"\n                )\n            else:\n                detail_guidance = \"\"\n                if review_detail == \"thorough\":\n                    detail_guidance = (\n                        \"Be thorough: examine every changed file, check edge \"\n                        \"cases, and verify error handling.\\n\\n\"\n                    )\n\n                reviewer_instructions = (\n                    f\"Review the code changes across these categories:\\n\"\n                    f\"1. **Code Quality & Performance** — unnecessary code, \"\n                    f\"resource leaks, N+1 patterns, missing error handling\\n\"\n                    f\"2. **Best Practices** — anti-patterns, deprecated usage, \"\n                    f\"naming conventions, framework compliance\\n\"\n                    f\"3. **Test Coverage** — untested code paths, missing edge \"\n                    f\"cases, suggest specific test cases\\n\"\n                    f\"4. **Architectural Concerns** — circular deps, tight \"\n                    f\"coupling, layer violations\\n\\n\"\n                    f\"{detail_guidance}\"\n                    f\"Write your review to {self._ws_dir}/review.md.\\n\\n\"\n                    f\"Include a structured JSON block in your review with this format:\\n\"\n                    f\"```json\\n\"\n                    f'{{\\n'\n                    f'  \"approved\": false,\\n'\n                    f'  \"summary\": \"Brief overall assessment\",\\n'\n                    f'  \"findings\": [\\n'\n                    f'    {{\\n'\n                    f'      \"filepath\": \"path/to/file.py\",\\n'\n                    f'      \"line_number\": 42,\\n'\n                    f'      \"severity\": \"error\",\\n'\n                    f'      \"category\": \"quality\",\\n'\n                    f'      \"description\": \"What is wrong\",\\n'\n                    f'      \"suggestion\": \"How to fix it\",\\n'\n                    f'      \"confidence\": 0.95\\n'\n                    f'    }}\\n'\n                    f'  ],\\n'\n                    f'  \"test_suggestions\": [\\n'\n                    f'    \"Test that X handles empty input\"\\n'\n                    f'  ]\\n'\n                    f'}}\\n'\n                    f\"```\\n\\n\"\n                    f\"Severity levels: \\\"error\\\" (must fix), \\\"warning\\\" \"\n                    f\"(should fix), \\\"information\\\" (nice to have).\\n\"\n                    f\"Categories: \\\"quality\\\", \\\"security\\\", \\\"testing\\\", \"\n                    f\"\\\"architecture\\\".\\n\"\n                    f\"Confidence: 0.0 to 1.0 — how certain you are this is a \"\n                    f\"real issue.\\n\\n\"\n                    f\"After the JSON block, end your review with:\\n\"\n                    f\"VERDICT: APPROVED\\n\"\n                    f\"or:\\n\"\n                    f\"VERDICT: REVISE\"\n                )\n\n            reviewer_prompt = (\n                f\"You are the REVIEWER agent.\\n\\n\"\n                f\"TASK:\\n{task_desc}\\n\\n\"\n                f\"{reviewer_instructions}\"\n            )\n            reviewer_result = _run_agent(AgentRole.REVIEWER, reviewer_prompt)\n            result.agent_results.append(reviewer_result)\n            result.total_cost_usd += reviewer_result.cost_usd\n            result.total_duration_seconds += reviewer_result.duration_seconds\n            self._update_cost_summary(result, reviewer_result)\n\n            # Determine verdict\n            if not getattr(ap.reviewer, \"enabled\", True):\n                # Reviewer disabled -> auto-approve\n                result.success = True\n                result.final_review_approved = True\n                logger.info(result.format_cost_report())\n                return result\n\n            # If the reviewer CLI crashed, abort rather than wasting revisions\n            if not reviewer_result.success:\n                result.error = f\"Reviewer agent failed: {reviewer_result.error}\"\n                logger.warning(result.error)\n                logger.info(result.format_cost_report())\n                return result\n\n            review_content = workspace.read(\"review.md\") or reviewer_result.output_text\n\n            # If the reviewer produced no VERDICT line, abort rather than\n            # defaulting to REVISE and wasting costly revision iterations\n            if not review_content or \"VERDICT:\" not in review_content.upper():\n                result.error = (\n                    \"Reviewer produced no VERDICT line — aborting to avoid \"\n                    \"wasteful revision loop\"\n                )\n                logger.warning(result.error)\n                logger.info(result.format_cost_report())\n                return result\n\n            # Try structured review parsing first, fall back to simple verdict\n            structured_report = self._parse_structured_review(review_content)\n            if structured_report is not None:\n                approved = structured_report.approved\n            else:\n                approved = self._parse_review_verdict(review_content)\n\n            if approved:\n                result.success = True\n                result.final_review_approved = True\n                logger.info(result.format_cost_report())\n                return result\n\n            # Reviewer rejected — try revision if budget allows\n            if revision < max_revisions:\n                revision += 1\n                result.revision_count = revision\n                if self._cycle_state is not None:\n                    self._cycle_state.update(pipeline_revision=revision)\n                rollback_fn(snapshot)\n                # Restore review feedback so the next iteration can read it\n                # (rollback's git clean -fd deletes untracked workspace files)\n                workspace.write(\"review.md\", review_content)\n                # Loop continues with new iteration\n            else:\n                # Exhausted revisions\n                result.success = False\n                result.error = \"Reviewer rejected after exhausting all revisions\"\n                result.final_review_approved = False\n                result.revision_count = revision\n                logger.info(result.format_cost_report())\n                return result\n","numLines":687,"startLine":1,"totalLines":687}}}
