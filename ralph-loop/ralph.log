{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_vrtx_016M3v2kAM7raDnDj6QrneCK","type":"tool_result","content":"   594→    def _cycle(self) -> None:\n   595→        \"\"\"Run a single orchestration cycle.\"\"\"\n   596→        # 1. Pre-flight safety checks\n   597→        try:\n   598→            self.safety.pre_flight_checks()\n   599→        except SafetyError as e:\n   600→            logger.warning(\"Pre-flight check failed: %s\", e)\n   601→            self.notifier.notify(\"safety_error\", {\"error\": str(e)})\n   602→            return\n   603→\n   604→        # Check for graceful degradation (throttle instead of hard-stop)\n   605→        cycles_per_hour = self.state.get_cycle_count_last_hour()\n   606→        cost_per_hour = self.state.get_total_cost(lookback_seconds=3600)\n   607→        degradation = self._degradation.check_and_adjust(cycles_per_hour, cost_per_hour)\n   608→        if degradation[\"degraded\"]:\n   609→            logger.warning(\n   610→                \"Graceful degradation active (level %d): %s\",\n   611→                degradation[\"level\"], degradation[\"reason\"],\n   612→            )\n   613→\n   614→        # 2-5. Gather tasks\n   615→        # Clean up stale pending approval tasks periodically\n   616→        self._task_queue.clear_stale(max_age=3600)\n   617→\n   618→        tasks = self._gather_tasks()\n   619→        if not tasks:\n   620→            # Check if tasks are pending approval\n   621→            pending_count = self._task_queue.pending_count()\n   622→            if pending_count > 0:\n   623→                logger.info(\n   624→                    \"Waiting for task approval (%d tasks pending)\", pending_count,\n   625→                )\n   626→                self.cycle_state.update(\n   627→                    phase=\"waiting_approval\",\n   628→                    pending_approval_count=pending_count,\n   629→                )\n   630→                return\n   631→\n   632→            dc = self.config.discovery\n   633→            enabled_methods = []\n   634→            if dc.enable_test_failures:\n   635→                enabled_methods.append(\"test_failures\")\n   636→            if dc.enable_lint_errors:\n   637→                enabled_methods.append(\"lint_errors\")\n   638→            if dc.enable_todos:\n   639→                enabled_methods.append(\"todos\")\n   640→            if dc.enable_coverage:\n   641→                enabled_methods.append(\"coverage\")\n   642→            if dc.enable_claude_ideas:\n   643→                enabled_methods.append(\"claude_ideas\")\n   644→            if dc.enable_quality_review:\n   645→                enabled_methods.append(\"quality_review\")\n   646→            has_feedback = bool(self.feedback.get_pending_feedback())\n   647→            if not enabled_methods and not has_feedback:\n   648→                logger.warning(\n   649→                    \"No tasks found: no discovery methods enabled and no pending feedback\"\n   650→                )\n   651→            else:\n   652→                logger.info(\n   653→                    \"No actionable tasks found (all may have been recently attempted). \"\n   654→                    \"Enabled methods: %s, pending feedback: %s\",\n   655→                    \", \".join(enabled_methods) if enabled_methods else \"none\",\n   656→                    \"yes\" if has_feedback else \"no\",\n   657→                )\n   658→            return\n   659→\n   660→        is_batch = len(tasks) > 1 and self.config.orchestrator.batch_mode\n   661→\n   662→        if is_batch:\n   663→            logger.info(\"Selected %d tasks for batch processing\", len(tasks))\n   664→            for i, t in enumerate(tasks, 1):\n   665→                logger.info(\"  Task %d [priority=%d]: %s\", i, t.priority, t.description)\n   666→        else:\n   667→            task = tasks[0]\n   668→            logger.info(\"Selected task [priority=%d]: %s\", task.priority, task.description)\n   669→\n   670→        # Write cycle state: task selected\n   671→        self.cycle_state.write(CycleState(\n   672→            phase=\"task_selected\",\n   673→            task_description=tasks[0].description,\n   674→            task_type=tasks[0].source,\n   675→            task_descriptions=[t.description for t in tasks],\n   676→            started_at=time.time(),\n   677→            batch_size=len(tasks),\n   678→        ))\n   679→\n   680→        # Save session state for crash recovery\n   681→        if self._session_manager:\n   682→            from session_manager import SessionState\n   683→            session = SessionState(\n   684→                session_id=self._session_manager.create_session_id(),\n   685→                started_at=time.time(),\n   686→                tasks=[{\"task_key\": t.task_key, \"task_id\": t.task_id,\n   687→                        \"description\": t.description, \"source\": t.source}\n   688→                       for t in tasks],\n   689→                phase=\"task_selected\",\n   690→            )\n   691→            self._session_manager.save_session(session)\n   692→\n   693→        try:\n   694→            # Backup orchestrator files if self-improving\n   695→            self._backup_orchestrator_files()\n   696→\n   697→            # 6. Record git snapshot\n   698→            snapshot = self.git.create_snapshot()\n   699→            pre_existing_files = self.git.capture_worktree_state()\n   700→\n   701→            # Cost prediction: estimate whether we can afford this cycle\n   702→            cost_ok, est_cost, remaining = check_cost_budget(\n   703→                tasks, self.config, self.state,\n   704→            )\n   705→            if not cost_ok:\n   706→                logger.warning(\n   707→                    \"Skipping cycle: estimated cost $%.4f exceeds remaining \"\n   708→                    \"budget $%.4f\",\n   709→                    est_cost, remaining,\n   710→                )\n   711→                self.notifier.notify(\"cost_limit_exceeded\", {\n   712→                    \"estimated_cost\": est_cost,\n   713→                    \"remaining_budget\": remaining,\n   714→                })\n   715→                return\n   716→\n   717→            # Multi-agent pipeline dispatch\n   718→            if self.config.agent_pipeline.enabled:\n   719→                self._cycle_multi_agent(tasks, snapshot, pre_existing_files, is_batch)\n   720→                return\n   721→\n   722→            # 7. Invoke Claude (with optional plan-then-execute)\n   723→            total_cost = 0.0\n   724→            total_duration = 0.0\n   725→\n   726→            # Skip planning if it has failed consecutively — go straight to\n   727→            # direct execution to avoid wasting API calls on empty plans.\n   728→            use_planning = self.config.orchestrator.plan_changes\n   729→            if use_planning and self._consecutive_empty_plans >= 3:\n   730→                logger.info(\n   731→                    \"Skipping planning phase: %d consecutive empty plans — \"\n   732→                    \"using direct execution this cycle\",\n   733→                    self._consecutive_empty_plans,\n   734→                )\n   735→                use_planning = False\n   736→\n   737→            if use_planning:\n   738→                # Phase 1: Plan (scale turns with batch size)\n   739→                self.cycle_state.update(phase=\"planning\")\n   740→                base_planning_turns = self.config.orchestrator.planning_max_turns\n   741→                if is_batch and len(tasks) > 1:\n   742→                    # Extra turns per additional task to give Claude time to\n   743→                    # read files and formulate a plan for each task.\n   744→                    effective_turns = base_planning_turns + (len(tasks) - 1) * 2\n   745→                    # Cap at the main max_turns to avoid runaway\n   746→                    effective_turns = min(effective_turns, self.config.claude.max_turns)\n   747→                else:\n   748→                    effective_turns = base_planning_turns\n   749→                # Create a separate config/runner for planning to avoid\n   750→                # mutating self.config.claude.max_turns (race condition).\n   751→                plan_config = copy.deepcopy(self.config)\n   752→                plan_config.claude.max_turns = effective_turns\n   753→                from provider_runner import create_runner\n   754→                plan_runner = create_runner(plan_config)\n   755→                logger.debug(\n   756→                    \"Planning with max_turns=%d (base=%d, batch_size=%d)\",\n   757→                    effective_turns, base_planning_turns, len(tasks),\n   758→                )\n   759→                if is_batch:\n   760→                    plan_prompt = self._build_batch_plan_prompt(tasks)\n   761→                else:\n   762→                    plan_prompt = self._build_plan_prompt(tasks[0])\n   763→                plan_result = self._run_claude_with_timeout(plan_prompt, runner=plan_runner)\n   764→                total_cost += plan_result.cost_usd\n   765→                total_duration += plan_result.duration_seconds\n   766→                self.cycle_state.update(accumulated_cost=total_cost)\n   767→\n   768→                if not plan_result.success:\n   769→                    logger.warning(\"Claude planning failed: %s\", plan_result.error)\n   770→                    self.git.rollback(snapshot, allowed_dirty=pre_existing_files)\n   771→                    self.state.record_cycle(self._make_cycle_record(\n   772→                        tasks,\n   773→                        success=False,\n   774→                        cost_usd=total_cost,\n   775→                        duration_seconds=total_duration,\n   776→                        error=f\"Planning failed: {plan_result.error}\",\n   777→                    ))\n   778→                    return\n   779→\n   780→                # Clean any accidental changes from planning phase\n   781→                self.git.rollback(snapshot, allowed_dirty=pre_existing_files)\n   782→\n   783→                # Check if planning produced a usable plan text.  When the\n   784→                # Claude response has subtype=error_max_turns or is missing\n   785→                # the \"result\" field, result_text is empty.  Fall back to\n   786→                # direct execution without a plan to avoid wasting an API\n   787→                # call on an empty PLAN TO EXECUTE section.\n   788→                if not plan_result.result_text.strip():\n   789→                    self._consecutive_empty_plans += 1\n   790→                    logger.warning(\n   791→                        \"Planning phase returned empty result_text \"\n   792→                        \"(error=%s, consecutive=%d) — falling back to direct execution\",\n   793→                        plan_result.error or \"none\",\n   794→                        self._consecutive_empty_plans,\n   795→                    )\n   796→                    self.cycle_state.update(phase=\"executing\")\n   797→                    if is_batch:\n   798→                        exec_prompt = self._build_batch_prompt(tasks)\n   799→                    else:\n   800→                        exec_prompt = self._build_prompt(tasks[0])\n   801→                else:\n   802→                    self._consecutive_empty_plans = 0  # Reset on successful plan\n   803→                    logger.info(\"Plan created, auto-accepting and executing...\")\n   804→\n   805→                    # Phase 2: Execute the plan\n   806→                    self.cycle_state.update(phase=\"executing\")\n   807→                    if is_batch:\n   808→                        exec_prompt = self._build_batch_execute_prompt(tasks, plan_result.result_text)\n   809→                    else:\n   810→                        exec_prompt = self._build_execute_prompt(tasks[0], plan_result.result_text)\n   811→\n   812→                claude_result = self._run_claude_with_timeout(exec_prompt)\n   813→                total_cost += claude_result.cost_usd\n   814→                total_duration += claude_result.duration_seconds\n   815→                self.cycle_state.update(accumulated_cost=total_cost)\n   816→            else:\n   817→                self.cycle_state.update(phase=\"executing\")\n   818→                if is_batch:\n   819→                    prompt = self._build_batch_prompt(tasks)\n   820→                else:\n   821→                    prompt = self._build_prompt(tasks[0])\n   822→                claude_result = self._run_claude_with_timeout(prompt)\n   823→                total_cost = claude_result.cost_usd\n   824→                total_duration = claude_result.duration_seconds\n   825→                self.cycle_state.update(accumulated_cost=total_cost)\n   826→\n   827→            if not claude_result.success:\n   828→                logger.warning(\"Claude failed: %s\", claude_result.error)\n   829→                self.git.rollback(snapshot, allowed_dirty=pre_existing_files)\n   830→                self.state.record_cycle(self._make_cycle_record(\n   831→                    tasks,\n   832→                    success=False,\n   833→                    cost_usd=total_cost,\n   834→                    duration_seconds=total_duration,\n   835→                    error=claude_result.error,\n   836→                ))\n   837→                return\n   838→\n   839→            # Context isolation: warn if context window usage is high\n   840→            if self.config.orchestrator.context_isolation and claude_result.success:\n   841→                if claude_result.context_window_pct > self.config.orchestrator.max_context_pct:\n   842→                    logger.warning(\n   843→                        \"Context window %.1f%% used (threshold %.1f%%)\",\n   844→                        claude_result.context_window_pct,\n   845→                        self.config.orchestrator.max_context_pct,\n   846→                    )\n   847→\n   848→            # Smart zone: auto-split tasks when context is exhausted\n   849→            if self.config.orchestrator.smart_split and claude_result.success:\n   850→                from context_monitor import ContextMonitor, write_split_tasks_as_feedback\n   851→                monitor = ContextMonitor(self.config)\n   852→                signals = monitor.extract_signals(claude_result)\n   853→                if monitor.should_split(signals):\n   854→                    split_tasks = monitor.generate_split_tasks(tasks[0], claude_result)\n   855→                    if split_tasks:\n   856→                        written = write_split_tasks_as_feedback(\n   857→                            split_tasks, self.config.paths.feedback_dir,\n   858→                        )\n   859→                        logger.info(\n   860→                            \"Smart split: wrote %d follow-up tasks to feedback/\",\n   861→                            written,\n   862→                        )\n   863→\n   864→            # 8-11. Validate with retries, commit or rollback\n   865→            self.cycle_state.update(phase=\"validating\")\n   866→            self._validate_with_retries(\n   867→                tasks=tasks, snapshot=snapshot,\n   868→                pre_existing_files=pre_existing_files,\n   869→                total_cost=total_cost, total_duration=total_duration,\n   870→                is_batch=is_batch,\n   871→            )\n   872→        finally:\n   873→            self.cycle_state.clear()\n   874→\n   875→    def _cycle_multi_agent(\n   876→        self, tasks: List[Task], snapshot: Snapshot,\n   877→        pre_existing_files: set, is_batch: bool,\n   878→    ) -> None:\n   879→        \"\"\"Run a cycle using the multi-agent pipeline.\"\"\"\n   880→        logger.info(\"Running multi-agent pipeline\")\n   881→        self.cycle_state.update(phase=\"pipeline\")\n   882→        pipeline = AgentPipeline(self.config, cycle_state=self.cycle_state)\n   883→        self._active_pipeline = pipeline\n   884→\n   885→        # Wrap pipeline.run() in a thread pool with cycle-level timeout\n   886→        timeout = self.config.orchestrator.cycle_timeout_seconds\n   887→        executor = concurrent.futures.ThreadPoolExecutor(max_workers=1)\n   888→        try:\n   889→            future = executor.submit(pipeline.run, tasks, self.git.rollback, snapshot)\n   890→            try:\n   891→                pipeline_result = future.result(timeout=timeout)\n   892→            except concurrent.futures.TimeoutError:\n   893→                logger.warning(\n   894→                    \"Multi-agent pipeline cycle timeout fired after %ds\", timeout,\n   895→                )\n   896→                # Fix 1: Terminate the active agent subprocess\n   897→                pipeline.terminate()\n   898→                future.cancel()\n   899→                # Short secondary wait\n   900→                try:\n   901→                    future.result(timeout=30)\n   902→                except (concurrent.futures.TimeoutError, concurrent.futures.CancelledError, Exception):\n   903→                    logger.error(\n   904→                        \"Pipeline thread still alive 30s after terminate — \"\n   905→                        \"continuing without blocking\"\n   906→                    )\n   907→                self.git.rollback(snapshot, allowed_dirty=pre_existing_files)\n   908→                self.state.record_cycle(self._make_cycle_record(\n   909→                    tasks,\n   910→                    success=False,\n   911→                    cost_usd=0.0,\n   912→                    duration_seconds=float(timeout),\n   913→                    error=f\"Pipeline cycle timeout after {timeout}s\",\n   914→                    pipeline_mode=\"multi_agent\",\n   915→                ))\n   916→                return\n   917→        finally:\n   918→            executor.shutdown(wait=False)\n   919→            self._active_pipeline = None\n   920→\n   921→        total_cost = pipeline_result.total_cost_usd\n   922→        total_duration = pipeline_result.total_duration_seconds\n   923→\n   924→        if not pipeline_result.success:\n   925→            logger.warning(\"Multi-agent pipeline failed: %s\", pipeline_result.error)\n   926→            self.git.rollback(snapshot, allowed_dirty=pre_existing_files)\n   927→            self.state.record_cycle(self._make_cycle_record(\n   928→                tasks,\n   929→                success=False,\n   930→                cost_usd=total_cost,\n   931→                duration_seconds=total_duration,\n   932→                error=pipeline_result.error,\n   933→                pipeline_mode=\"multi_agent\",\n   934→                pipeline_revision_count=pipeline_result.revision_count,\n   935→                pipeline_review_approved=pipeline_result.final_review_approved,\n   936→            ))\n   937→            return\n   938→\n   939→        # Steps 8-11: validate with retries, commit or rollback\n   940→        self._validate_with_retries(\n   941→            tasks=tasks, snapshot=snapshot,\n   942→            pre_existing_files=pre_existing_files,\n   943→            total_cost=total_cost, total_duration=total_duration,\n   944→            is_batch=is_batch,\n   945→            extra_record_kwargs={\n   946→                \"pipeline_mode\": \"multi_agent\",\n   947→                \"pipeline_revision_count\": pipeline_result.revision_count,\n   948→                \"pipeline_review_approved\": pipeline_result.final_review_approved,\n   949→            },\n   950→        )\n   951→\n   952→    def _send_periodic_summary(self) -> None:\n   953→        \"\"\"Send a periodic summary notification every N cycles.\n   954→\n   955→        Uses telemetry.compute_metrics() to generate a structured report\n   956→        of recent orchestrator performance.\n   957→        \"\"\"\n   958→        interval = self.config.notifications.events.summary_interval_cycles\n   959→        if interval <= 0 or self._cycle_counter % interval != 0:\n   960→            return\n   961→\n   962→        records = self.state.load_history()\n   963→        metrics = compute_metrics(records, lookback_seconds=interval * 3600)\n   964→\n   965→        summary = {\n   966→            \"total_cycles\": metrics[\"total_cycles\"],\n   967→            \"successes\": metrics[\"successes\"],\n   968→            \"failures\": metrics[\"failures\"],\n   969→            \"success_rate\": f\"{metrics['success_rate']}%\",\n   970→            \"total_cost_usd\": f\"${metrics['cost']['total']:.2f}\",\n   971→            \"top_task_types\": list(metrics.get(\"type_breakdown\", {}).keys())[:5],\n   972→            \"degradation_level\": self._degradation.degradation_level,\n   973→        }\n   974→        self.notifier.notify(\"periodic_summary\", summary)\n   975→        logger.info(\n   976→            \"Periodic summary (cycle %d): %d cycles, %d/%d pass/fail, $%.2f cost\",\n   977→            self._cycle_counter, metrics[\"total_cycles\"],\n   978→            metrics[\"successes\"], metrics[\"failures\"],\n   979→            metrics[\"cost\"][\"total\"],\n   980→        )\n   981→\n   982→    def run(self, once: bool = False) -> None:\n   983→        \"\"\"Run the main loop. If once=True, run a single cycle and exit.\"\"\"\n   984→        if self.config.parallel.enabled:\n   985→            from coordinator import ParallelCoordinator\n   986→            coordinator = ParallelCoordinator(self.config)\n   987→            coordinator.run(once=once)\n   988→            return\n   989→\n   990→        self._setup_signals()\n   991→\n   992→        try:\n   993→            self.safety.acquire_lock()\n   994→        except SafetyError as e:\n   995→            logger.error(\"Cannot start: %s\", e)\n   996→            return\n   997→\n   998→        try:\n   999→            logger.info(\"Orchestrator started (once=%s)\", once)\n  1000→\n  1001→            # Check for incomplete session from a previous crash\n  1002→            if self._session_manager and self._session_manager.has_incomplete_session():\n  1003→                prev_session = self._session_manager.load_session()\n  1004→                if prev_session:\n  1005→                    logger.info(\n  1006→                        \"Resuming incomplete session %s (phase=%s, cost=$%.2f)\",\n  1007→                        prev_session.session_id, prev_session.phase,\n  1008→                        prev_session.total_cost_usd,\n  1009→                    )\n  1010→                    self._session_manager.clear_session()\n  1011→\n  1012→            while self._running:\n  1013→                try:\n  1014→                    self._cycle()\n  1015→                    self._cycle_counter += 1\n  1016→                    self._send_periodic_summary()\n  1017→                    # Reset backoff on successful cycle (no exception)\n  1018→                    self._consecutive_exceptions = 0\n  1019→                    self._backoff_seconds = 0\n  1020→                except (FileNotFoundError, PermissionError) as e:\n  1021→                    # Likely permanent errors — don't retry at normal pace\n  1022→                    self._consecutive_exceptions += 1\n  1023→                    logger.error(\n  1024→                        \"Likely permanent error in cycle (%s): %s \"\n  1025→                        \"(consecutive errors: %d)\",\n  1026→                        type(e).__name__, e, self._consecutive_exceptions,\n  1027→                    )\n  1028→                    if self._consecutive_exceptions >= 3:\n  1029→                        logger.error(\n  1030→                            \"Pausing after %d consecutive %s errors — \"\n  1031→                            \"check config and permissions\",\n  1032→                            self._consecutive_exceptions, type(e).__name__,\n  1033→                        )\n  1034→                        self._backoff_seconds = min(\n  1035→                            self._backoff_seconds * 2 if self._backoff_seconds else 60,\n  1036→                            600,\n  1037→                        )\n  1038→                except Exception:\n  1039→                    self._consecutive_exceptions += 1\n  1040→                    self._backoff_seconds = min(\n  1041→                        self._backoff_seconds * 2 if self._backoff_seconds else 30,\n  1042→                        600,\n  1043→                    )\n  1044→                    logger.exception(\n  1045→                        \"Unexpected error in cycle (consecutive: %d, backoff: %ds)\",\n  1046→                        self._consecutive_exceptions, self._backoff_seconds,\n  1047→                    )\n  1048→\n  1049→                if once:\n  1050→                    break\n  1051→\n  1052→                # 13. Sleep (with exponential backoff if exceptions are recurring)\n  1053→                sleep_total = self.config.orchestrator.loop_interval_seconds + self._backoff_seconds\n  1054→                # Apply graceful degradation sleep multiplier\n  1055→                if self._degradation.is_degraded:\n  1056→                    deg = self._degradation.check_and_adjust(\n  1057→                        self.state.get_cycle_count_last_hour(),\n  1058→                        self.state.get_total_cost(lookback_seconds=3600),\n  1059→                    )\n  1060→                    sleep_total = int(sleep_total * deg[\"sleep_multiplier\"])\n  1061→                if self._backoff_seconds > 0:\n  1062→                    logger.info(\n  1063→                        \"Sleeping %ds (includes %ds backoff after %d consecutive errors)\",\n  1064→                        sleep_total, self._backoff_seconds, self._consecutive_exceptions,\n  1065→                    )\n  1066→                else:\n  1067→                    logger.debug(\"Sleeping %ds...\", sleep_total)\n  1068→                # Sleep in small increments so we can respond to signals\n  1069→                while sleep_total > 0 and self._running:\n  1070→                    time.sleep(min(1, sleep_total))\n  1071→                    sleep_total -= 1\n  1072→\n  1073→            logger.info(\"Orchestrator stopped\")\n  1074→        finally:\n  1075→            self.safety.release_lock()\n  1076→"}]},"parent_tool_use_id":null,"session_id":"1a03c01c-3a23-4305-af58-24656a1d085b","uuid":"845c2969-fa30-4108-8dc9-457baf2a69dc","tool_use_result":{"type":"text","file":{"filePath":"/Users/sameertkhanna/Documents/auto_claude_code/orchestrator.py","content":"    def _cycle(self) -> None:\n        \"\"\"Run a single orchestration cycle.\"\"\"\n        # 1. Pre-flight safety checks\n        try:\n            self.safety.pre_flight_checks()\n        except SafetyError as e:\n            logger.warning(\"Pre-flight check failed: %s\", e)\n            self.notifier.notify(\"safety_error\", {\"error\": str(e)})\n            return\n\n        # Check for graceful degradation (throttle instead of hard-stop)\n        cycles_per_hour = self.state.get_cycle_count_last_hour()\n        cost_per_hour = self.state.get_total_cost(lookback_seconds=3600)\n        degradation = self._degradation.check_and_adjust(cycles_per_hour, cost_per_hour)\n        if degradation[\"degraded\"]:\n            logger.warning(\n                \"Graceful degradation active (level %d): %s\",\n                degradation[\"level\"], degradation[\"reason\"],\n            )\n\n        # 2-5. Gather tasks\n        # Clean up stale pending approval tasks periodically\n        self._task_queue.clear_stale(max_age=3600)\n\n        tasks = self._gather_tasks()\n        if not tasks:\n            # Check if tasks are pending approval\n            pending_count = self._task_queue.pending_count()\n            if pending_count > 0:\n                logger.info(\n                    \"Waiting for task approval (%d tasks pending)\", pending_count,\n                )\n                self.cycle_state.update(\n                    phase=\"waiting_approval\",\n                    pending_approval_count=pending_count,\n                )\n                return\n\n            dc = self.config.discovery\n            enabled_methods = []\n            if dc.enable_test_failures:\n                enabled_methods.append(\"test_failures\")\n            if dc.enable_lint_errors:\n                enabled_methods.append(\"lint_errors\")\n            if dc.enable_todos:\n                enabled_methods.append(\"todos\")\n            if dc.enable_coverage:\n                enabled_methods.append(\"coverage\")\n            if dc.enable_claude_ideas:\n                enabled_methods.append(\"claude_ideas\")\n            if dc.enable_quality_review:\n                enabled_methods.append(\"quality_review\")\n            has_feedback = bool(self.feedback.get_pending_feedback())\n            if not enabled_methods and not has_feedback:\n                logger.warning(\n                    \"No tasks found: no discovery methods enabled and no pending feedback\"\n                )\n            else:\n                logger.info(\n                    \"No actionable tasks found (all may have been recently attempted). \"\n                    \"Enabled methods: %s, pending feedback: %s\",\n                    \", \".join(enabled_methods) if enabled_methods else \"none\",\n                    \"yes\" if has_feedback else \"no\",\n                )\n            return\n\n        is_batch = len(tasks) > 1 and self.config.orchestrator.batch_mode\n\n        if is_batch:\n            logger.info(\"Selected %d tasks for batch processing\", len(tasks))\n            for i, t in enumerate(tasks, 1):\n                logger.info(\"  Task %d [priority=%d]: %s\", i, t.priority, t.description)\n        else:\n            task = tasks[0]\n            logger.info(\"Selected task [priority=%d]: %s\", task.priority, task.description)\n\n        # Write cycle state: task selected\n        self.cycle_state.write(CycleState(\n            phase=\"task_selected\",\n            task_description=tasks[0].description,\n            task_type=tasks[0].source,\n            task_descriptions=[t.description for t in tasks],\n            started_at=time.time(),\n            batch_size=len(tasks),\n        ))\n\n        # Save session state for crash recovery\n        if self._session_manager:\n            from session_manager import SessionState\n            session = SessionState(\n                session_id=self._session_manager.create_session_id(),\n                started_at=time.time(),\n                tasks=[{\"task_key\": t.task_key, \"task_id\": t.task_id,\n                        \"description\": t.description, \"source\": t.source}\n                       for t in tasks],\n                phase=\"task_selected\",\n            )\n            self._session_manager.save_session(session)\n\n        try:\n            # Backup orchestrator files if self-improving\n            self._backup_orchestrator_files()\n\n            # 6. Record git snapshot\n            snapshot = self.git.create_snapshot()\n            pre_existing_files = self.git.capture_worktree_state()\n\n            # Cost prediction: estimate whether we can afford this cycle\n            cost_ok, est_cost, remaining = check_cost_budget(\n                tasks, self.config, self.state,\n            )\n            if not cost_ok:\n                logger.warning(\n                    \"Skipping cycle: estimated cost $%.4f exceeds remaining \"\n                    \"budget $%.4f\",\n                    est_cost, remaining,\n                )\n                self.notifier.notify(\"cost_limit_exceeded\", {\n                    \"estimated_cost\": est_cost,\n                    \"remaining_budget\": remaining,\n                })\n                return\n\n            # Multi-agent pipeline dispatch\n            if self.config.agent_pipeline.enabled:\n                self._cycle_multi_agent(tasks, snapshot, pre_existing_files, is_batch)\n                return\n\n            # 7. Invoke Claude (with optional plan-then-execute)\n            total_cost = 0.0\n            total_duration = 0.0\n\n            # Skip planning if it has failed consecutively — go straight to\n            # direct execution to avoid wasting API calls on empty plans.\n            use_planning = self.config.orchestrator.plan_changes\n            if use_planning and self._consecutive_empty_plans >= 3:\n                logger.info(\n                    \"Skipping planning phase: %d consecutive empty plans — \"\n                    \"using direct execution this cycle\",\n                    self._consecutive_empty_plans,\n                )\n                use_planning = False\n\n            if use_planning:\n                # Phase 1: Plan (scale turns with batch size)\n                self.cycle_state.update(phase=\"planning\")\n                base_planning_turns = self.config.orchestrator.planning_max_turns\n                if is_batch and len(tasks) > 1:\n                    # Extra turns per additional task to give Claude time to\n                    # read files and formulate a plan for each task.\n                    effective_turns = base_planning_turns + (len(tasks) - 1) * 2\n                    # Cap at the main max_turns to avoid runaway\n                    effective_turns = min(effective_turns, self.config.claude.max_turns)\n                else:\n                    effective_turns = base_planning_turns\n                # Create a separate config/runner for planning to avoid\n                # mutating self.config.claude.max_turns (race condition).\n                plan_config = copy.deepcopy(self.config)\n                plan_config.claude.max_turns = effective_turns\n                from provider_runner import create_runner\n                plan_runner = create_runner(plan_config)\n                logger.debug(\n                    \"Planning with max_turns=%d (base=%d, batch_size=%d)\",\n                    effective_turns, base_planning_turns, len(tasks),\n                )\n                if is_batch:\n                    plan_prompt = self._build_batch_plan_prompt(tasks)\n                else:\n                    plan_prompt = self._build_plan_prompt(tasks[0])\n                plan_result = self._run_claude_with_timeout(plan_prompt, runner=plan_runner)\n                total_cost += plan_result.cost_usd\n                total_duration += plan_result.duration_seconds\n                self.cycle_state.update(accumulated_cost=total_cost)\n\n                if not plan_result.success:\n                    logger.warning(\"Claude planning failed: %s\", plan_result.error)\n                    self.git.rollback(snapshot, allowed_dirty=pre_existing_files)\n                    self.state.record_cycle(self._make_cycle_record(\n                        tasks,\n                        success=False,\n                        cost_usd=total_cost,\n                        duration_seconds=total_duration,\n                        error=f\"Planning failed: {plan_result.error}\",\n                    ))\n                    return\n\n                # Clean any accidental changes from planning phase\n                self.git.rollback(snapshot, allowed_dirty=pre_existing_files)\n\n                # Check if planning produced a usable plan text.  When the\n                # Claude response has subtype=error_max_turns or is missing\n                # the \"result\" field, result_text is empty.  Fall back to\n                # direct execution without a plan to avoid wasting an API\n                # call on an empty PLAN TO EXECUTE section.\n                if not plan_result.result_text.strip():\n                    self._consecutive_empty_plans += 1\n                    logger.warning(\n                        \"Planning phase returned empty result_text \"\n                        \"(error=%s, consecutive=%d) — falling back to direct execution\",\n                        plan_result.error or \"none\",\n                        self._consecutive_empty_plans,\n                    )\n                    self.cycle_state.update(phase=\"executing\")\n                    if is_batch:\n                        exec_prompt = self._build_batch_prompt(tasks)\n                    else:\n                        exec_prompt = self._build_prompt(tasks[0])\n                else:\n                    self._consecutive_empty_plans = 0  # Reset on successful plan\n                    logger.info(\"Plan created, auto-accepting and executing...\")\n\n                    # Phase 2: Execute the plan\n                    self.cycle_state.update(phase=\"executing\")\n                    if is_batch:\n                        exec_prompt = self._build_batch_execute_prompt(tasks, plan_result.result_text)\n                    else:\n                        exec_prompt = self._build_execute_prompt(tasks[0], plan_result.result_text)\n\n                claude_result = self._run_claude_with_timeout(exec_prompt)\n                total_cost += claude_result.cost_usd\n                total_duration += claude_result.duration_seconds\n                self.cycle_state.update(accumulated_cost=total_cost)\n            else:\n                self.cycle_state.update(phase=\"executing\")\n                if is_batch:\n                    prompt = self._build_batch_prompt(tasks)\n                else:\n                    prompt = self._build_prompt(tasks[0])\n                claude_result = self._run_claude_with_timeout(prompt)\n                total_cost = claude_result.cost_usd\n                total_duration = claude_result.duration_seconds\n                self.cycle_state.update(accumulated_cost=total_cost)\n\n            if not claude_result.success:\n                logger.warning(\"Claude failed: %s\", claude_result.error)\n                self.git.rollback(snapshot, allowed_dirty=pre_existing_files)\n                self.state.record_cycle(self._make_cycle_record(\n                    tasks,\n                    success=False,\n                    cost_usd=total_cost,\n                    duration_seconds=total_duration,\n                    error=claude_result.error,\n                ))\n                return\n\n            # Context isolation: warn if context window usage is high\n            if self.config.orchestrator.context_isolation and claude_result.success:\n                if claude_result.context_window_pct > self.config.orchestrator.max_context_pct:\n                    logger.warning(\n                        \"Context window %.1f%% used (threshold %.1f%%)\",\n                        claude_result.context_window_pct,\n                        self.config.orchestrator.max_context_pct,\n                    )\n\n            # Smart zone: auto-split tasks when context is exhausted\n            if self.config.orchestrator.smart_split and claude_result.success:\n                from context_monitor import ContextMonitor, write_split_tasks_as_feedback\n                monitor = ContextMonitor(self.config)\n                signals = monitor.extract_signals(claude_result)\n                if monitor.should_split(signals):\n                    split_tasks = monitor.generate_split_tasks(tasks[0], claude_result)\n                    if split_tasks:\n                        written = write_split_tasks_as_feedback(\n                            split_tasks, self.config.paths.feedback_dir,\n                        )\n                        logger.info(\n                            \"Smart split: wrote %d follow-up tasks to feedback/\",\n                            written,\n                        )\n\n            # 8-11. Validate with retries, commit or rollback\n            self.cycle_state.update(phase=\"validating\")\n            self._validate_with_retries(\n                tasks=tasks, snapshot=snapshot,\n                pre_existing_files=pre_existing_files,\n                total_cost=total_cost, total_duration=total_duration,\n                is_batch=is_batch,\n            )\n        finally:\n            self.cycle_state.clear()\n\n    def _cycle_multi_agent(\n        self, tasks: List[Task], snapshot: Snapshot,\n        pre_existing_files: set, is_batch: bool,\n    ) -> None:\n        \"\"\"Run a cycle using the multi-agent pipeline.\"\"\"\n        logger.info(\"Running multi-agent pipeline\")\n        self.cycle_state.update(phase=\"pipeline\")\n        pipeline = AgentPipeline(self.config, cycle_state=self.cycle_state)\n        self._active_pipeline = pipeline\n\n        # Wrap pipeline.run() in a thread pool with cycle-level timeout\n        timeout = self.config.orchestrator.cycle_timeout_seconds\n        executor = concurrent.futures.ThreadPoolExecutor(max_workers=1)\n        try:\n            future = executor.submit(pipeline.run, tasks, self.git.rollback, snapshot)\n            try:\n                pipeline_result = future.result(timeout=timeout)\n            except concurrent.futures.TimeoutError:\n                logger.warning(\n                    \"Multi-agent pipeline cycle timeout fired after %ds\", timeout,\n                )\n                # Fix 1: Terminate the active agent subprocess\n                pipeline.terminate()\n                future.cancel()\n                # Short secondary wait\n                try:\n                    future.result(timeout=30)\n                except (concurrent.futures.TimeoutError, concurrent.futures.CancelledError, Exception):\n                    logger.error(\n                        \"Pipeline thread still alive 30s after terminate — \"\n                        \"continuing without blocking\"\n                    )\n                self.git.rollback(snapshot, allowed_dirty=pre_existing_files)\n                self.state.record_cycle(self._make_cycle_record(\n                    tasks,\n                    success=False,\n                    cost_usd=0.0,\n                    duration_seconds=float(timeout),\n                    error=f\"Pipeline cycle timeout after {timeout}s\",\n                    pipeline_mode=\"multi_agent\",\n                ))\n                return\n        finally:\n            executor.shutdown(wait=False)\n            self._active_pipeline = None\n\n        total_cost = pipeline_result.total_cost_usd\n        total_duration = pipeline_result.total_duration_seconds\n\n        if not pipeline_result.success:\n            logger.warning(\"Multi-agent pipeline failed: %s\", pipeline_result.error)\n            self.git.rollback(snapshot, allowed_dirty=pre_existing_files)\n            self.state.record_cycle(self._make_cycle_record(\n                tasks,\n                success=False,\n                cost_usd=total_cost,\n                duration_seconds=total_duration,\n                error=pipeline_result.error,\n                pipeline_mode=\"multi_agent\",\n                pipeline_revision_count=pipeline_result.revision_count,\n                pipeline_review_approved=pipeline_result.final_review_approved,\n            ))\n            return\n\n        # Steps 8-11: validate with retries, commit or rollback\n        self._validate_with_retries(\n            tasks=tasks, snapshot=snapshot,\n            pre_existing_files=pre_existing_files,\n            total_cost=total_cost, total_duration=total_duration,\n            is_batch=is_batch,\n            extra_record_kwargs={\n                \"pipeline_mode\": \"multi_agent\",\n                \"pipeline_revision_count\": pipeline_result.revision_count,\n                \"pipeline_review_approved\": pipeline_result.final_review_approved,\n            },\n        )\n\n    def _send_periodic_summary(self) -> None:\n        \"\"\"Send a periodic summary notification every N cycles.\n\n        Uses telemetry.compute_metrics() to generate a structured report\n        of recent orchestrator performance.\n        \"\"\"\n        interval = self.config.notifications.events.summary_interval_cycles\n        if interval <= 0 or self._cycle_counter % interval != 0:\n            return\n\n        records = self.state.load_history()\n        metrics = compute_metrics(records, lookback_seconds=interval * 3600)\n\n        summary = {\n            \"total_cycles\": metrics[\"total_cycles\"],\n            \"successes\": metrics[\"successes\"],\n            \"failures\": metrics[\"failures\"],\n            \"success_rate\": f\"{metrics['success_rate']}%\",\n            \"total_cost_usd\": f\"${metrics['cost']['total']:.2f}\",\n            \"top_task_types\": list(metrics.get(\"type_breakdown\", {}).keys())[:5],\n            \"degradation_level\": self._degradation.degradation_level,\n        }\n        self.notifier.notify(\"periodic_summary\", summary)\n        logger.info(\n            \"Periodic summary (cycle %d): %d cycles, %d/%d pass/fail, $%.2f cost\",\n            self._cycle_counter, metrics[\"total_cycles\"],\n            metrics[\"successes\"], metrics[\"failures\"],\n            metrics[\"cost\"][\"total\"],\n        )\n\n    def run(self, once: bool = False) -> None:\n        \"\"\"Run the main loop. If once=True, run a single cycle and exit.\"\"\"\n        if self.config.parallel.enabled:\n            from coordinator import ParallelCoordinator\n            coordinator = ParallelCoordinator(self.config)\n            coordinator.run(once=once)\n            return\n\n        self._setup_signals()\n\n        try:\n            self.safety.acquire_lock()\n        except SafetyError as e:\n            logger.error(\"Cannot start: %s\", e)\n            return\n\n        try:\n            logger.info(\"Orchestrator started (once=%s)\", once)\n\n            # Check for incomplete session from a previous crash\n            if self._session_manager and self._session_manager.has_incomplete_session():\n                prev_session = self._session_manager.load_session()\n                if prev_session:\n                    logger.info(\n                        \"Resuming incomplete session %s (phase=%s, cost=$%.2f)\",\n                        prev_session.session_id, prev_session.phase,\n                        prev_session.total_cost_usd,\n                    )\n                    self._session_manager.clear_session()\n\n            while self._running:\n                try:\n                    self._cycle()\n                    self._cycle_counter += 1\n                    self._send_periodic_summary()\n                    # Reset backoff on successful cycle (no exception)\n                    self._consecutive_exceptions = 0\n                    self._backoff_seconds = 0\n                except (FileNotFoundError, PermissionError) as e:\n                    # Likely permanent errors — don't retry at normal pace\n                    self._consecutive_exceptions += 1\n                    logger.error(\n                        \"Likely permanent error in cycle (%s): %s \"\n                        \"(consecutive errors: %d)\",\n                        type(e).__name__, e, self._consecutive_exceptions,\n                    )\n                    if self._consecutive_exceptions >= 3:\n                        logger.error(\n                            \"Pausing after %d consecutive %s errors — \"\n                            \"check config and permissions\",\n                            self._consecutive_exceptions, type(e).__name__,\n                        )\n                        self._backoff_seconds = min(\n                            self._backoff_seconds * 2 if self._backoff_seconds else 60,\n                            600,\n                        )\n                except Exception:\n                    self._consecutive_exceptions += 1\n                    self._backoff_seconds = min(\n                        self._backoff_seconds * 2 if self._backoff_seconds else 30,\n                        600,\n                    )\n                    logger.exception(\n                        \"Unexpected error in cycle (consecutive: %d, backoff: %ds)\",\n                        self._consecutive_exceptions, self._backoff_seconds,\n                    )\n\n                if once:\n                    break\n\n                # 13. Sleep (with exponential backoff if exceptions are recurring)\n                sleep_total = self.config.orchestrator.loop_interval_seconds + self._backoff_seconds\n                # Apply graceful degradation sleep multiplier\n                if self._degradation.is_degraded:\n                    deg = self._degradation.check_and_adjust(\n                        self.state.get_cycle_count_last_hour(),\n                        self.state.get_total_cost(lookback_seconds=3600),\n                    )\n                    sleep_total = int(sleep_total * deg[\"sleep_multiplier\"])\n                if self._backoff_seconds > 0:\n                    logger.info(\n                        \"Sleeping %ds (includes %ds backoff after %d consecutive errors)\",\n                        sleep_total, self._backoff_seconds, self._consecutive_exceptions,\n                    )\n                else:\n                    logger.debug(\"Sleeping %ds...\", sleep_total)\n                # Sleep in small increments so we can respond to signals\n                while sleep_total > 0 and self._running:\n                    time.sleep(min(1, sleep_total))\n                    sleep_total -= 1\n\n            logger.info(\"Orchestrator stopped\")\n        finally:\n            self.safety.release_lock()\n","numLines":483,"startLine":594,"totalLines":1076}}}
