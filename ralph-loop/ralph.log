baseline(\"/tmp\", None)\n        assert result.passed is True\n\n    @patch(\"validator.run_with_group_kill\")\n    def test_validate_with_baseline_empty_set_falls_back(self, mock_run, default_config):","numLines":50,"startLine":231,"totalLines":322}}}
