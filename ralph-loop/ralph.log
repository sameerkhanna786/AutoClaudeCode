\"\n                            f\"`{rel_path}:{start}` ({line_count} lines)\"\n                        )\n                        tasks.append(Task(\n                            description=desc,\n                            priority=5,\n                            source=\"quality\",\n                            source_file=rel_path,\n                            line_number=start,\n                        ))\n\n                if len(tasks) >= 5:\n                    return tasks[:5]\n\n        return tasks[:5]\n","numLines":48,"startLine":1115,"totalLines":1162}}}
