{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_vrtx_011PFvSDoqrN1fu78MXssGDu","type":"tool_result","content":"     1→\"\"\"Auto-discover tasks from the target project (test failures, lint, TODOs, etc.).\"\"\"\n     2→\n     3→from __future__ import annotations\n     4→\n     5→import json\n     6→import logging\n     7→import os\n     8→import re\n     9→import time\n    10→from dataclasses import dataclass, field\n    11→from pathlib import Path\n    12→from typing import List, Optional\n    13→\n    14→from config_schema import Config\n    15→from process_utils import run_with_group_kill\n    16→\n    17→logger = logging.getLogger(__name__)\n    18→\n    19→# Map file extensions to their comment prefix styles\n    20→_COMMENT_PREFIXES = {\n    21→    \".py\": (\"#\",), \".rb\": (\"#\",),\n    22→    \".js\": (\"//\", \"/*\"), \".ts\": (\"//\", \"/*\"),\n    23→    \".jsx\": (\"//\", \"/*\"), \".tsx\": (\"//\", \"/*\"),\n    24→    \".go\": (\"//\", \"/*\"), \".rs\": (\"//\", \"/*\"),\n    25→    \".java\": (\"//\", \"/*\"),\n    26→}\n    27→\n    28→# Regex to match string literals (double-quoted and single-quoted, with escapes)\n    29→_STRING_LITERAL_RE = re.compile(r'''\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^'\\\\]|\\\\.)*' '''.strip())\n    30→\n    31→MAX_TASK_DESCRIPTION_LENGTH = 2000\n    32→MAX_TASK_CONTEXT_LENGTH = 12000\n    33→\n    34→# Default timeout for _discover_todos file walk (seconds)\n    35→TODO_SCAN_TIMEOUT = 60\n    36→\n    37→_FILE_REF_RE = re.compile(\n    38→    r'`([a-zA-Z0-9_/.\\-]+\\.(?:py|js|ts|tsx|jsx|go|rs|java|rb|sh|yaml|yml|json|md|txt))'\n    39→    r'(?::(\\d+))?(?:-\\d+)?`'\n    40→)\n    41→_FILE_REF_FALLBACK_RE = re.compile(\n    42→    r'(?:in\\s+|for\\s+)([a-zA-Z0-9_/.\\-]+\\.(?:py|js|ts|tsx|jsx|go|rs|java|rb|sh|yaml|yml|json|md|txt))'\n    43→    r'(?::(\\d+))?'\n    44→)\n    45→\n    46→\n    47→def _sanitize_description(desc: str) -> str:\n    48→    \"\"\"Sanitize a task description: strip, collapse newlines, and truncate.\"\"\"\n    49→    desc = desc.strip()\n    50→    desc = desc.replace(\"\\n\", \" \").replace(\"\\r\", \" \")\n    51→    if len(desc) > MAX_TASK_DESCRIPTION_LENGTH:\n    52→        desc = desc[:MAX_TASK_DESCRIPTION_LENGTH] + \"...\"\n    53→    return desc\n    54→\n    55→\n    56→def _extract_comment_text(line: str, ext: str) -> Optional[str]:\n    57→    \"\"\"Strip string literals from *line*, then return the comment body if a\n    58→    comment prefix for *ext* is found.  Returns ``None`` when no comment is\n    59→    detected.\"\"\"\n    60→    prefixes = _COMMENT_PREFIXES.get(ext)\n    61→    if not prefixes:\n    62→        return None\n    63→\n    64→    # Remove string literals so that a '#' or '//' inside a string is ignored\n    65→    stripped = _STRING_LITERAL_RE.sub(\"\", line)\n    66→\n    67→    # Find the earliest comment prefix in the stripped line\n    68→    earliest_pos = None\n    69→    earliest_prefix = None\n    70→    for pfx in prefixes:\n    71→        pos = stripped.find(pfx)\n    72→        if pos != -1 and (earliest_pos is None or pos < earliest_pos):\n    73→            earliest_pos = pos\n    74→            earliest_prefix = pfx\n    75→\n    76→    if earliest_pos is None:\n    77→        return None\n    78→\n    79→    # Return the text after the comment prefix\n    80→    return stripped[earliest_pos + len(earliest_prefix):]\n    81→\n    82→\n    83→@dataclass\n    84→class Task:\n    85→    description: str\n    86→    priority: int  # 1 = highest (feedback), 5 = lowest (quality review)\n    87→    source: str  # \"test_failure\", \"lint\", \"todo\", \"coverage\", \"quality\", \"feedback\"\n    88→    source_file: Optional[str] = None  # file path for feedback tasks\n    89→    line_number: Optional[int] = None\n    90→    context: str = \"\"  # rich context: tracebacks, file snippets, error details\n    91→    task_id: str = \"\"\n    92→    depends_on: List[str] = field(default_factory=list)\n    93→\n    94→    def __post_init__(self):\n    95→        self.description = _sanitize_description(self.description)\n    96→        if len(self.context) > MAX_TASK_CONTEXT_LENGTH:\n    97→            self.context = self.context[:MAX_TASK_CONTEXT_LENGTH] + \"\\n... (truncated)\"\n    98→        if not self.task_id:\n    99→            self.task_id = self.task_key\n   100→\n   101→    @property\n   102→    def task_key(self) -> str:\n   103→        \"\"\"Stable dedup key — same underlying issue produces the same key.\"\"\"\n   104→        if self.source == \"todo\" and self.source_file:\n   105→            if self.line_number is not None:\n   106→                return f\"todo:{self.source_file}:{self.line_number}\"\n   107→            return f\"todo:{self.source_file}\"\n   108→\n   109→        if self.source in (\"lint\", \"test_failure\", \"quality\", \"coverage\") and self.source_file:\n   110→            return f\"{self.source}:{self.source_file}\"\n   111→\n   112→        if self.source == \"coverage\":\n   113→            match = re.search(r'for\\s+(\\S+)', self.description)\n   114→            if match:\n   115→                return f\"coverage:{match.group(1)}\"\n   116→\n   117→        if self.source == \"claude_idea\":\n   118→            match = _FILE_REF_RE.search(self.description)\n   119→            if match:\n   120→                return f\"claude_idea:{match.group(1)}\"\n   121→            match = _FILE_REF_FALLBACK_RE.search(self.description)\n   122→            if match:\n   123→                return f\"claude_idea:{match.group(1)}\"\n   124→            return f\"claude_idea:{self.description[:60]}\"\n   125→\n   126→        if self.source == \"feedback\" and self.source_file:\n   127→            return f\"feedback:{self.source_file}\"\n   128→\n   129→        if self.source == \"test_failure\":\n   130→            match = re.search(r'FAILED\\s+(\\S+)', self.description)\n   131→            if match:\n   132→                return f\"test_failure:{match.group(1)}\"\n   133→\n   134→        return f\"{self.source}:{self.description}\"\n   135→\n   136→\n   137→class TaskDiscovery:\n   138→    def __init__(self, config: Config, state_manager=None):\n   139→        self.config = config\n   140→        self.target_dir = config.target_dir\n   141→        self.state_manager = state_manager\n   142→        self._last_idea_discovery_time: float = 0.0\n   143→\n   144→    def discover_all(self) -> List[Task]:\n   145→        \"\"\"Run all enabled discovery strategies and return sorted tasks.\"\"\"\n   146→        tasks: List[Task] = []\n   147→        dc = self.config.discovery\n   148→\n   149→        if dc.enable_test_failures:\n   150→            tasks.extend(self._discover_test_failures())\n   151→\n   152→        if dc.enable_lint_errors:\n   153→            tasks.extend(self._discover_lint_errors())\n   154→\n   155→        if dc.enable_todos:\n   156→            tasks.extend(self._discover_todos())\n   157→\n   158→        if dc.enable_coverage:\n   159→            tasks.extend(self._discover_coverage_gaps())\n   160→\n   161→        if dc.enable_claude_ideas:\n   162→            tasks.extend(self._discover_claude_ideas())\n   163→\n   164→        if dc.enable_quality_review:\n   165→            tasks.extend(self._discover_quality_issues())\n   166→\n   167→        # Group related tasks to avoid duplicate work\n   168→        tasks = self._group_related_tasks(tasks)\n   169→\n   170→        # Boost priority for historically high-success-rate sources\n   171→        if self.state_manager and dc.adaptive_priority and tasks:\n   172→            try:\n   173→                performance = self.state_manager.get_strategy_performance(lookback_seconds=86400)\n   174→                if performance:\n   175→                    for task in tasks:\n   176→                        perf = performance.get(task.source)\n   177→                        if perf and perf.get(\"total\", 0) >= 2:\n   178→                            success_rate = perf.get(\"success_rate\", 0.0)\n   179→                            if success_rate > 0.5:\n   180→                                # Higher success rate -> lower priority number (higher priority)\n   181→                                # e.g., 90% success -> priority reduced by 2\n   182→                                boost = int(success_rate * 3)  # 0-3 boost\n   183→                                task.priority = max(1, task.priority - boost)\n   184→            except Exception as e:\n   185→                logger.debug(\"Strategy performance boosting failed: %s\", e)\n   186→\n   187→        # Sort by priority (lower number = higher priority)\n   188→        tasks.sort(key=lambda t: t.priority)\n   189→        return tasks\n   190→\n   191→    def _group_related_tasks(self, tasks: List[Task]) -> List[Task]:\n   192→        \"\"\"Group related tasks by file path to avoid duplicate work.\n   193→\n   194→        When multiple tasks share the same source file (e.g., multiple test\n   195→        failures in the same file, or multiple lint errors in the same file),\n   196→        they likely share a root cause. This method keeps only the first\n   197→        (highest-priority) task per file for each source type, reducing\n   198→        wasted cycles on tasks that will auto-resolve when the root cause\n   199→        is fixed.\n   200→\n   201→        Tasks without a source_file are always kept.\n   202→        \"\"\"\n   203→        from collections import defaultdict\n   204→\n   205→        # Group by (source, source_file) — only group when source_file is set\n   206→        grouped: dict = defaultdict(list)\n   207→        ungrouped: List[Task] = []\n   208→\n   209→        for task in tasks:\n   210→            if task.source_file and task.source in (\"test_failure\", \"lint\", \"todo\"):\n   211→                key = (task.source, task.source_file)\n   212→                grouped[key].append(task)\n   213→            else:\n   214→                ungrouped.append(task)\n   215→\n   216→        result: List[Task] = list(ungrouped)\n   217→        for key, group in grouped.items():\n   218→            # Sort by priority (lower = better), keep the representative task\n   219→            group.sort(key=lambda t: t.priority)\n   220→            representative = group[0]\n   221→            if len(group) > 1:\n   222→                # Enrich the representative's description with count\n   223→                representative.description = (\n   224→                    f\"{representative.description} \"\n   225→                    f\"(+{len(group) - 1} related in {key[1]})\"\n   226→                )\n   227→            result.append(representative)\n   228→\n   229→        return result\n   230→\n   231→    def _extract_test_traceback(self, full_output: str, test_id: str) -> str:\n   232→        \"\"\"Extract the traceback section for a specific test from pytest output.\"\"\"\n   233→        if not test_id:\n   234→            return \"\"\n   235→        lines = full_output.split(\"\\n\")\n   236→        collecting = False\n   237→        result_lines: List[str] = []\n   238→        for line in lines:\n   239→            if test_id in line and (\"FAILED\" in line or \"ERROR\" in line or \"___\" in line):\n   240→                collecting = True\n   241→                result_lines = [line]\n   242→                continue\n   243→            if collecting:\n   244→                if (line.startswith(\"___\") and test_id not in line) or \\\n   245→                   line.startswith(\"=\") or \\\n   246→                   (line.startswith(\"FAILED \") and test_id not in line):\n   247→                    break\n   248→                result_lines.append(line)\n   249→        return \"\\n\".join(result_lines)\n   250→\n   251→    def _read_file_snippet(self, filepath: str, line_num: int, context_lines: int = 5) -> str:\n   252→        \"\"\"Read a snippet of a file around the given line number.\"\"\"\n   253→        try:\n   254→            fpath = Path(filepath)\n   255→            if not fpath.is_absolute():\n   256→                fpath = Path(self.target_dir) / filepath\n   257→            if not fpath.exists():\n   258→                return \"\"\n   259→            content = fpath.read_text(errors=\"ignore\")\n   260→            lines = content.split(\"\\n\")\n   261→            start = max(0, line_num - context_lines - 1)\n   262→            end = min(len(lines), line_num + context_lines)\n   263→            numbered = []\n   264→            for i, line in enumerate(lines[start:end], start + 1):\n   265→                marker = \" >> \" if i == line_num else \"    \"\n   266→                numbered.append(f\"{marker}{i:4d} | {line}\")\n   267→            return \"\\n\".join(numbered)\n   268→        except OSError:\n   269→            return \"\"\n   270→\n   271→    def _discover_test_failures(self) -> List[Task]:\n   272→        \"\"\"Run pytest and parse failures.\"\"\"\n   273→        test_cmd = self.config.validation.test_command\n   274→        if not test_cmd.strip():\n   275→            return []\n   276→\n   277→        try:\n   278→            result = run_with_group_kill(\n   279→                test_cmd,\n   280→                shell=True,\n   281→                cwd=self.target_dir,\n   282→                timeout=self.config.validation.test_timeout,\n   283→            )\n   284→        except OSError as e:\n   285→            logger.warning(\"Test discovery failed: %s\", e)\n   286→            return []\n   287→\n   288→        if result.timed_out:\n   289→            logger.warning(\"Test discovery timed out after %ds\", self.config.validation.test_timeout)\n   290→            return []\n   291→\n   292→        if result.returncode == 0:\n   293→            return []\n   294→\n   295→        # Capture full output for context\n   296→        full_output = result.stdout\n   297→        if result.stderr.strip():\n   298→            full_output += \"\\n\" + result.stderr\n   299→\n   300→        # Parse pytest output for FAILED lines\n   301→        tasks = []\n   302→        for line in result.stdout.split(\"\\n\"):\n   303→            line = line.strip()\n   304→            if line.startswith(\"FAILED\"):\n   305→                # e.g. \"FAILED tests/test_foo.py::test_bar - AssertionError: ...\"\n   306→                desc = f\"Fix test failure: {line}\"\n   307→                # Extract test identifier for per-test traceback\n   308→                parts = line.split()\n   309→                test_id = parts[1] if len(parts) > 1 else \"\"\n   310→                per_test_ctx = self._extract_test_traceback(full_output, test_id)\n   311→                tasks.append(Task(\n   312→                    description=desc,\n   313→                    priority=2,\n   314→                    source=\"test_failure\",\n   315→                    context=per_test_ctx if per_test_ctx else full_output,\n   316→                ))\n   317→\n   318→        # If we got failures but couldn't parse individual ones, create a generic task\n   319→        if result.returncode != 0 and not tasks:\n   320→            tasks.append(Task(\n   321→                description=f\"Fix test failures (exit code {result.returncode})\",\n   322→                priority=2,\n   323→                source=\"test_failure\",\n   324→                context=full_output,\n   325→            ))\n   326→\n   327→        return tasks\n   328→\n   329→    def _discover_lint_errors(self) -> List[Task]:\n   330→        \"\"\"Run lint command and parse errors.\"\"\"\n   331→        lint_cmd = self.config.validation.lint_command\n   332→        if not lint_cmd.strip():\n   333→            return []\n   334→\n   335→        try:\n   336→            result = run_with_group_kill(\n   337→                lint_cmd,\n   338→                shell=True,\n   339→                cwd=self.target_dir,\n   340→                timeout=self.config.validation.lint_timeout,\n   341→            )\n   342→        except OSError as e:\n   343→            logger.warning(\"Lint discovery failed: %s\", e)\n   344→            return []\n   345→\n   346→        if result.timed_out:\n   347→            logger.warning(\"Lint discovery timed out after %ds\", self.config.validation.lint_timeout)\n   348→            return []\n   349→\n   350→        if result.returncode == 0:\n   351→            return []\n   352→\n   353→        # Try to parse ruff JSON output\n   354→        output = result.stdout.strip()\n   355→        try:\n   356→            errors = json.loads(output)\n   357→            if isinstance(errors, list):\n   358→                tasks = []\n   359→                for err in errors[:10]:  # Cap at 10 lint errors\n   360→                    filename = err.get(\"filename\", \"unknown\")\n   361→                    message = err.get(\"message\", \"lint error\")\n   362→                    code = err.get(\"code\", \"\")\n   363→                    line_num = err.get(\"location\", {}).get(\"row\", 0)\n   364→                    desc = f\"Fix lint error in {filename}: [{code}] {message}\"\n   365→                    # Build context: snippet around the error line\n   366→                    context = \"\"\n   367→                    if line_num > 0:\n   368→                        context = self._read_file_snippet(filename, line_num, context_lines=5)\n   369→                    tasks.append(Task(\n   370→                        description=desc,\n   371→                        priority=2,\n   372→                        source=\"lint\",\n   373→                        source_file=filename,\n   374→                        line_number=line_num if line_num > 0 else None,\n   375→                        context=context,\n   376→                    ))\n   377→                return tasks\n   378→        except (json.JSONDecodeError, TypeError):\n   379→            pass\n   380→\n   381→        # Fallback: generic lint error task\n   382→        return [Task(\n   383→            description=\"Fix lint errors\",\n   384→            priority=2,\n   385→            source=\"lint\",\n   386→        )]\n   387→\n   388→    def _discover_todos(self, timeout: int = TODO_SCAN_TIMEOUT) -> List[Task]:\n   389→        \"\"\"Scan source files for TODO/FIXME/HACK comments.\n   390→\n   391→        Args:\n   392→            timeout: Maximum time in seconds for the file walk operation.\n   393→                     If exceeded, returns whatever tasks were found so far.\n   394→        \"\"\"\n   395→        tasks = []\n   396→        patterns = self.config.discovery.todo_patterns\n   397→        exclude_dirs = set(self.config.discovery.exclude_dirs)\n   398→\n   399→        if not patterns:\n   400→            return []\n   401→\n   402→        escaped = \"|\".join(re.escape(p) for p in patterns)\n   403→        keyword_pat = r\"^\\s*(\" + escaped + r\")\\b\"\n   404→        keyword_re = re.compile(keyword_pat, re.IGNORECASE)\n   405→\n   406→        target = Path(self.target_dir)\n   407→        deadline = time.monotonic() + timeout\n   408→        timed_out = False\n   409→        files_scanned = 0\n   410→        for root, dirs, files in os.walk(target):\n   411→            # Check deadline at the start of each directory\n   412→            if time.monotonic() > deadline:\n   413→                timed_out = True\n   414→                break\n   415→\n   416→            # Filter out excluded directories\n   417→            dirs[:] = [d for d in dirs if d not in exclude_dirs]\n   418→\n   419→            for fname in files:\n   420→                # Check deadline periodically (every file)\n   421→                if time.monotonic() > deadline:\n   422→                    timed_out = True\n   423→                    break\n   424→\n   425→                ext = Path(fname).suffix\n   426→                if ext not in _COMMENT_PREFIXES:\n   427→                    continue\n   428→\n   429→                fpath = Path(root) / fname\n   430→                rel_path = str(fpath.relative_to(target))\n   431→\n   432→                try:\n   433→                    content = fpath.read_text(errors=\"ignore\")\n   434→                except OSError:\n   435→                    continue\n   436→\n   437→                files_scanned += 1\n   438→\n   439→                for i, line in enumerate(content.split(\"\\n\"), 1):\n   440→                    comment_text = _extract_comment_text(line, ext)\n   441→                    if comment_text is None:\n   442→                        continue\n   443→                    match = keyword_re.search(comment_text)\n   444→                    if match:\n   445→                        comment = line.strip()\n   446→                        if len(comment) > 120:\n   447→                            comment = comment[:120] + \"...\"\n   448→                        desc = f\"Address {match.group(1)} in {rel_path}:{i}: {comment}\"\n   449→                        context = self._read_file_snippet(str(fpath), i, context_lines=5)\n   450→                        tasks.append(Task(\n   451→                            description=desc,\n   452→                            priority=3,\n   453→                            source=\"todo\",\n   454→                            source_file=rel_path,\n   455→                            line_number=i,\n   456→                            context=context,\n   457→                        ))\n   458→\n   459→            if timed_out:\n   460→                break\n   461→\n   462→        if timed_out:\n   463→            logger.warning(\n   464→                \"TODO scan timed out after %ds (scanned %d files, found %d tasks)\",\n   465→                timeout, files_scanned, len(tasks),\n   466→            )\n   467→\n   468→        return tasks[:self.config.discovery.max_todo_tasks]\n   469→\n   470→    def _discover_claude_ideas(self) -> List[Task]:\n   471→        \"\"\"Use Claude to analyze the codebase and suggest improvement ideas.\n   472→\n   473→        Invokes Claude CLI in read-only analysis mode with a low max-turns\n   474→        to keep cost down. Parses the response for actionable improvement tasks.\n   475→        \"\"\"\n   476→        # Enforce idea generation cooldown to prevent excessive API costs\n   477→        cooldown = self.config.discovery.idea_cooldown_seconds\n   478→        if cooldown > 0:\n   479→            elapsed = time.time() - self._last_idea_discovery_time\n   480→            if self._last_idea_discovery_time > 0 and elapsed < cooldown:\n   481→                logger.debug(\n   482→                    \"Skipping claude_ideas discovery: %.0fs since last run, \"\n   483→                    \"cooldown is %ds\",\n   484→                    elapsed, cooldown,\n   485→                )\n   486→                return []\n   487→\n   488→        cc = self.config.claude\n   489→        if self.config.discovery.discovery_prompt:\n   490→            focus_section = self.config.discovery.discovery_prompt\n   491→        else:\n   492→            focus_section = (\n   493→                \"- New features or functionality that would add value\\n\"\n   494→                \"- Missing tests for important functionality\\n\"\n   495→                \"- Bug risks or edge cases that could cause failures\\n\"\n   496→                \"- Performance improvements\\n\"\n   497→                \"- Code clarity or maintainability improvements\\n\"\n   498→            )\n   499→\n   500→        history_section = \"\"\n   501→        if self.state_manager:\n   502→            recent = self.state_manager.get_recent_task_summaries(\n   503→                lookback_seconds=86400, max_items=15,\n   504→            )\n   505→            if recent:\n   506→                history_section = (\n   507→                    \"\\nRECENTLY COMPLETED TASKS (do NOT suggest similar improvements):\\n\"\n   508→                    + \"\\n\".join(recent)\n   509→                    + \"\\n\\nFocus on NEW areas that haven't been addressed recently.\\n\"\n   510→                )\n   511→\n   512→        prompt = (\n   513→            \"Analyze the codebase in the current directory. Identify up to 5 concrete, \"\n   514→            \"actionable improvements. Focus on:\\n\"\n   515→            + focus_section\n   516→            + history_section\n   517→            + \"\\nFor each improvement, output EXACTLY one line in this format:\\n\"\n   518→            \"IDEA: <one-sentence description of the improvement>\\n\\n\"\n   519→            \"Do NOT make any changes. Do NOT run git commands. Only analyze and output IDEA lines.\"\n   520→        )\n   521→\n   522→        cmd = [\n   523→            cc.command, \"-p\", prompt,\n   524→            \"--model\", self.config.discovery.discovery_model or self.config.claude.resolved_model,\n   525→            \"--max-turns\", str(self.config.discovery.discovery_max_turns),\n   526→            \"--output-format\", \"json\",\n   527→        ]\n   528→\n   529→        try:\n   530→            result = run_with_group_kill(\n   531→                cmd,\n   532→                cwd=self.target_dir,\n   533→                timeout=self.config.discovery.discovery_timeout,\n   534→            )\n   535→        except (FileNotFoundError, OSError) as e:\n   536→            logger.warning(\"Claude idea discovery failed: %s\", e)\n   537→            return []\n   538→\n   539→        if result is None:\n   540→            logger.warning(\"Claude idea discovery returned no result\")\n   541→            return []\n   542→\n   543→        if result.timed_out:\n   544→            logger.warning(\"Claude idea discovery timed out after %ds\",\n   545→                           self.config.discovery.discovery_timeout)\n   546→            return []\n   547→\n   548→        if result.returncode != 0:\n   549→            logger.warning(\"Claude idea discovery exited with code %d\", result.returncode)\n   550→            return []\n   551→\n   552→        # Parse JSON response to get result text\n   553→        result_text = result.stdout\n   554→        try:\n   555→            # Helper: extract text content from a parsed JSON dict.\n   556→            # The Claude CLI uses \"result\" for successful runs and may use\n   557→            # \"result_text\" in some versions.\n   558→            def _extract_text(d: dict) -> str:\n   559→                for key in (\"result\", \"result_text\"):\n   560→                    val = d.get(key)\n   561→                    if isinstance(val, str) and val.strip():\n   562→                        return val\n   563→                return \"\"\n   564→\n   565→            # Strategy 1: Try each line individually as a complete JSON object\n   566→            for line in result_text.strip().split(\"\\n\"):\n   567→                line = line.strip()\n   568→                if not line.startswith(\"{\"):\n   569→                    continue\n   570→                try:\n   571→                    data = json.loads(line)\n   572→                    if isinstance(data, dict):\n   573→                        # Check for error_max_turns — Claude ran out of turns\n   574→                        if data.get(\"subtype\") == \"error_max_turns\":\n   575→                            logger.warning(\n   576→                                \"Claude idea discovery hit max turns (%d); \"\n   577→                                \"increase discovery.discovery_max_turns\",\n   578→                                self.config.discovery.discovery_max_turns,\n   579→                            )\n   580→                            text = _extract_text(data)\n   581→                            if text:\n   582→                                result_text = text\n   583→                            break\n   584→                        text = _extract_text(data)\n   585→                        if text:\n   586→                            result_text = text\n   587→                            break\n   588→                except (json.JSONDecodeError, TypeError):\n   589→                    continue\n   590→            else:\n   591→                # Strategy 2: Try multi-line JSON joining from each '{'-starting line\n   592→                lines = result_text.strip().split(\"\\n\")\n   593→                for i, line in enumerate(lines):\n   594→                    if not line.strip().startswith(\"{\"):\n   595→                        continue\n   596→                    try:\n   597→                        data = json.loads(\"\\n\".join(lines[i:]))\n   598→                        if isinstance(data, dict):\n   599→                            if data.get(\"subtype\") == \"error_max_turns\":\n   600→                                logger.warning(\n   601→                                    \"Claude idea discovery hit max turns (%d); \"\n   602→                                    \"increase discovery.discovery_max_turns\",\n   603→                                    self.config.discovery.discovery_max_turns,\n   604→                                )\n   605→                                text = _extract_text(data)\n   606→                                if text:\n   607→                                    result_text = text\n   608→                                break\n   609→                            text = _extract_text(data)\n   610→                            if text:\n   611→                                result_text = text\n   612→                                break\n   613→                    except (json.JSONDecodeError, TypeError):\n   614→                        continue\n   615→                else:\n   616→                    # Strategy 3: Use raw_decode to find JSON anywhere in the output\n   617→                    decoder = json.JSONDecoder()\n   618→                    for i, ch in enumerate(result_text):\n   619→                        if ch != \"{\":\n   620→                            continue\n   621→                        try:\n   622→                            obj, end = decoder.raw_decode(result_text, i)\n   623→                            if isinstance(obj, dict):\n   624→                                text = _extract_text(obj)\n   625→                                if text:\n   626→                                    result_text = text\n   627→                                    break\n   628→                        except (json.JSONDecodeError, TypeError):\n   629→                            continue\n   630→        except Exception:\n   631→            pass\n   632→\n   633→        # Warn if we couldn't extract text from a JSON response\n   634→        if result_text is result.stdout and result.stdout.strip()[:1] in (\"{\", \"[\"):\n   635→            logger.warning(\n   636→                \"Claude idea response contained JSON but no text content \"\n   637→                \"could be extracted — falling back to raw text extraction\"\n   638→            )\n   639→\n   640→        # Extract IDEA lines\n   641→        MIN_IDEA_LENGTH = 10\n   642→        tasks = []\n   643→        for line in result_text.split(\"\\n\"):\n   644→            line = line.strip()\n   645→            if line.upper().startswith(\"IDEA:\"):\n   646→                desc = line[5:].strip()\n   647→                if desc and len(desc) >= MIN_IDEA_LENGTH:\n   648→                    tasks.append(Task(\n   649→                        description=desc,\n   650→                        priority=4,\n   651→                        source=\"claude_idea\",\n   652→                    ))\n   653→                elif desc:\n   654→                    logger.debug(\"Skipping short IDEA line: %r\", desc)\n   655→\n   656→        logger.info(\"Claude discovered %d improvement ideas\", len(tasks))\n   657→        if not tasks and result_text.strip():\n   658→            # Attempt fallback extraction from analysis-format text\n   659→            lines = [l.strip() for l in result_text.split(\"\\n\") if l.strip()]\n   660→            for line in lines:\n   661→                # Match numbered items: \"1. ...\", \"2) ...\"\n   662→                m = re.match(r'^\\d+[.)]\\s+(.+)', line)\n   663→                if not m:\n   664→                    # Match bullet items: \"- ...\", \"* ...\", \"• ...\"\n   665→                    m = re.match(r'^[-*•]\\s+(.+)', line)\n   666→                if m:\n   667→                    desc = m.group(1).strip()\n   668→                    if desc and len(desc) >= MIN_IDEA_LENGTH:\n   669→                        tasks.append(Task(\n   670→                            description=desc,\n   671→                            priority=4,\n   672→                            source=\"claude_idea\",\n   673→                        ))\n   674→            if tasks:\n   675→                logger.info(\n   676→                    \"Extracted %d tasks from analysis-format text \"\n   677→                    \"(no IDEA: prefixed lines found, used numbered/bullet fallback).\",\n   678→                    len(tasks),\n   679→                )\n   680→            else:\n   681→                logger.debug(\n   682→                    \"Claude response contained no IDEA lines and no extractable \"\n   683→                    \"analysis-format items (%d non-empty lines)\",\n   684→                    len(lines),\n   685→                )\n   686→        self._last_idea_discovery_time = time.time()\n   687→        return tasks[:5]\n   688→\n   689→    def _discover_coverage_gaps(self) -> List[Task]:\n   690→        \"\"\"Discover files with low test coverage (optional, requires pytest-cov).\"\"\"\n   691→        try:\n   692→            result = run_with_group_kill(\n   693→                \"python3 -m pytest --cov --cov-report=json --cov-report=term -q\",\n   694→                shell=True,\n   695→                cwd=self.target_dir,\n   696→                timeout=self.config.validation.test_timeout,\n   697→            )\n   698→        except OSError:\n   699→            return []\n   700→\n   701→        if result.timed_out:\n   702→            return []\n   703→\n   704→        cov_file = Path(self.target_dir) / \"coverage.json\"\n   705→        if not cov_file.exists():\n   706→            return []\n   707→\n   708→        try:\n   709→            data = json.loads(cov_file.read_text())\n   710→            files = data.get(\"files\", {})\n   711→            tasks = []\n   712→            for fname, info in files.items():\n   713→                pct = info.get(\"summary\", {}).get(\"percent_covered\", 100)\n   714→                if pct < 50:\n   715→                    desc = f\"Improve test coverage for {fname} (currently {pct:.0f}%)\"\n   716→                    tasks.append(Task(\n   717→                        description=desc,\n   718→                        priority=4,\n   719→                        source=\"coverage\",\n   720→                        source_file=fname,\n   721→                    ))\n   722→            return tasks[:10]\n   723→        except (json.JSONDecodeError, OSError):\n   724→            return []\n   725→\n   726→    def _discover_quality_issues(self) -> List[Task]:\n   727→        \"\"\"Review source files for general quality issues.\"\"\"\n   728→        tasks = []\n   729→        target = Path(self.target_dir)\n   730→        exclude_dirs = set(self.config.discovery.exclude_dirs)\n   731→\n   732→        for root, dirs, files in os.walk(target):\n   733→            dirs[:] = [d for d in dirs if d not in exclude_dirs]\n   734→\n   735→            for fname in files:\n   736→                if not fname.endswith(\".py\"):\n   737→                    continue\n   738→\n   739→                fpath = Path(root) / fname\n   740→                rel_path = str(fpath.relative_to(target))\n   741→\n   742→                try:\n   743→                    content = fpath.read_text(errors=\"ignore\")\n   744→                except OSError:\n   745→                    continue\n   746→\n   747→                lines = content.split(\"\\n\")\n   748→                # Flag very long files\n   749→                if len(lines) > 500:\n   750→                    tasks.append(Task(\n   751→                        description=f\"Review and potentially refactor {rel_path} ({len(lines)} lines)\",\n   752→                        priority=5,\n   753→                        source=\"quality\",\n   754→                        source_file=rel_path,\n   755→                    ))\n   756→\n   757→        return tasks[:5]\n   758→"}]},"parent_tool_use_id":null,"session_id":"49c99b86-4be3-464a-a24b-94401b602357","uuid":"d6ba46ff-49cd-4eea-99d8-f948290b66f8","tool_use_result":{"type":"text","file":{"filePath":"/Users/sameertkhanna/Documents/auto_claude_code/task_discovery.py","content":"\"\"\"Auto-discover tasks from the target project (test failures, lint, TODOs, etc.).\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport logging\nimport os\nimport re\nimport time\nfrom dataclasses import dataclass, field\nfrom pathlib import Path\nfrom typing import List, Optional\n\nfrom config_schema import Config\nfrom process_utils import run_with_group_kill\n\nlogger = logging.getLogger(__name__)\n\n# Map file extensions to their comment prefix styles\n_COMMENT_PREFIXES = {\n    \".py\": (\"#\",), \".rb\": (\"#\",),\n    \".js\": (\"//\", \"/*\"), \".ts\": (\"//\", \"/*\"),\n    \".jsx\": (\"//\", \"/*\"), \".tsx\": (\"//\", \"/*\"),\n    \".go\": (\"//\", \"/*\"), \".rs\": (\"//\", \"/*\"),\n    \".java\": (\"//\", \"/*\"),\n}\n\n# Regex to match string literals (double-quoted and single-quoted, with escapes)\n_STRING_LITERAL_RE = re.compile(r'''\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^'\\\\]|\\\\.)*' '''.strip())\n\nMAX_TASK_DESCRIPTION_LENGTH = 2000\nMAX_TASK_CONTEXT_LENGTH = 12000\n\n# Default timeout for _discover_todos file walk (seconds)\nTODO_SCAN_TIMEOUT = 60\n\n_FILE_REF_RE = re.compile(\n    r'`([a-zA-Z0-9_/.\\-]+\\.(?:py|js|ts|tsx|jsx|go|rs|java|rb|sh|yaml|yml|json|md|txt))'\n    r'(?::(\\d+))?(?:-\\d+)?`'\n)\n_FILE_REF_FALLBACK_RE = re.compile(\n    r'(?:in\\s+|for\\s+)([a-zA-Z0-9_/.\\-]+\\.(?:py|js|ts|tsx|jsx|go|rs|java|rb|sh|yaml|yml|json|md|txt))'\n    r'(?::(\\d+))?'\n)\n\n\ndef _sanitize_description(desc: str) -> str:\n    \"\"\"Sanitize a task description: strip, collapse newlines, and truncate.\"\"\"\n    desc = desc.strip()\n    desc = desc.replace(\"\\n\", \" \").replace(\"\\r\", \" \")\n    if len(desc) > MAX_TASK_DESCRIPTION_LENGTH:\n        desc = desc[:MAX_TASK_DESCRIPTION_LENGTH] + \"...\"\n    return desc\n\n\ndef _extract_comment_text(line: str, ext: str) -> Optional[str]:\n    \"\"\"Strip string literals from *line*, then return the comment body if a\n    comment prefix for *ext* is found.  Returns ``None`` when no comment is\n    detected.\"\"\"\n    prefixes = _COMMENT_PREFIXES.get(ext)\n    if not prefixes:\n        return None\n\n    # Remove string literals so that a '#' or '//' inside a string is ignored\n    stripped = _STRING_LITERAL_RE.sub(\"\", line)\n\n    # Find the earliest comment prefix in the stripped line\n    earliest_pos = None\n    earliest_prefix = None\n    for pfx in prefixes:\n        pos = stripped.find(pfx)\n        if pos != -1 and (earliest_pos is None or pos < earliest_pos):\n            earliest_pos = pos\n            earliest_prefix = pfx\n\n    if earliest_pos is None:\n        return None\n\n    # Return the text after the comment prefix\n    return stripped[earliest_pos + len(earliest_prefix):]\n\n\n@dataclass\nclass Task:\n    description: str\n    priority: int  # 1 = highest (feedback), 5 = lowest (quality review)\n    source: str  # \"test_failure\", \"lint\", \"todo\", \"coverage\", \"quality\", \"feedback\"\n    source_file: Optional[str] = None  # file path for feedback tasks\n    line_number: Optional[int] = None\n    context: str = \"\"  # rich context: tracebacks, file snippets, error details\n    task_id: str = \"\"\n    depends_on: List[str] = field(default_factory=list)\n\n    def __post_init__(self):\n        self.description = _sanitize_description(self.description)\n        if len(self.context) > MAX_TASK_CONTEXT_LENGTH:\n            self.context = self.context[:MAX_TASK_CONTEXT_LENGTH] + \"\\n... (truncated)\"\n        if not self.task_id:\n            self.task_id = self.task_key\n\n    @property\n    def task_key(self) -> str:\n        \"\"\"Stable dedup key — same underlying issue produces the same key.\"\"\"\n        if self.source == \"todo\" and self.source_file:\n            if self.line_number is not None:\n                return f\"todo:{self.source_file}:{self.line_number}\"\n            return f\"todo:{self.source_file}\"\n\n        if self.source in (\"lint\", \"test_failure\", \"quality\", \"coverage\") and self.source_file:\n            return f\"{self.source}:{self.source_file}\"\n\n        if self.source == \"coverage\":\n            match = re.search(r'for\\s+(\\S+)', self.description)\n            if match:\n                return f\"coverage:{match.group(1)}\"\n\n        if self.source == \"claude_idea\":\n            match = _FILE_REF_RE.search(self.description)\n            if match:\n                return f\"claude_idea:{match.group(1)}\"\n            match = _FILE_REF_FALLBACK_RE.search(self.description)\n            if match:\n                return f\"claude_idea:{match.group(1)}\"\n            return f\"claude_idea:{self.description[:60]}\"\n\n        if self.source == \"feedback\" and self.source_file:\n            return f\"feedback:{self.source_file}\"\n\n        if self.source == \"test_failure\":\n            match = re.search(r'FAILED\\s+(\\S+)', self.description)\n            if match:\n                return f\"test_failure:{match.group(1)}\"\n\n        return f\"{self.source}:{self.description}\"\n\n\nclass TaskDiscovery:\n    def __init__(self, config: Config, state_manager=None):\n        self.config = config\n        self.target_dir = config.target_dir\n        self.state_manager = state_manager\n        self._last_idea_discovery_time: float = 0.0\n\n    def discover_all(self) -> List[Task]:\n        \"\"\"Run all enabled discovery strategies and return sorted tasks.\"\"\"\n        tasks: List[Task] = []\n        dc = self.config.discovery\n\n        if dc.enable_test_failures:\n            tasks.extend(self._discover_test_failures())\n\n        if dc.enable_lint_errors:\n            tasks.extend(self._discover_lint_errors())\n\n        if dc.enable_todos:\n            tasks.extend(self._discover_todos())\n\n        if dc.enable_coverage:\n            tasks.extend(self._discover_coverage_gaps())\n\n        if dc.enable_claude_ideas:\n            tasks.extend(self._discover_claude_ideas())\n\n        if dc.enable_quality_review:\n            tasks.extend(self._discover_quality_issues())\n\n        # Group related tasks to avoid duplicate work\n        tasks = self._group_related_tasks(tasks)\n\n        # Boost priority for historically high-success-rate sources\n        if self.state_manager and dc.adaptive_priority and tasks:\n            try:\n                performance = self.state_manager.get_strategy_performance(lookback_seconds=86400)\n                if performance:\n                    for task in tasks:\n                        perf = performance.get(task.source)\n                        if perf and perf.get(\"total\", 0) >= 2:\n                            success_rate = perf.get(\"success_rate\", 0.0)\n                            if success_rate > 0.5:\n                                # Higher success rate -> lower priority number (higher priority)\n                                # e.g., 90% success -> priority reduced by 2\n                                boost = int(success_rate * 3)  # 0-3 boost\n                                task.priority = max(1, task.priority - boost)\n            except Exception as e:\n                logger.debug(\"Strategy performance boosting failed: %s\", e)\n\n        # Sort by priority (lower number = higher priority)\n        tasks.sort(key=lambda t: t.priority)\n        return tasks\n\n    def _group_related_tasks(self, tasks: List[Task]) -> List[Task]:\n        \"\"\"Group related tasks by file path to avoid duplicate work.\n\n        When multiple tasks share the same source file (e.g., multiple test\n        failures in the same file, or multiple lint errors in the same file),\n        they likely share a root cause. This method keeps only the first\n        (highest-priority) task per file for each source type, reducing\n        wasted cycles on tasks that will auto-resolve when the root cause\n        is fixed.\n\n        Tasks without a source_file are always kept.\n        \"\"\"\n        from collections import defaultdict\n\n        # Group by (source, source_file) — only group when source_file is set\n        grouped: dict = defaultdict(list)\n        ungrouped: List[Task] = []\n\n        for task in tasks:\n            if task.source_file and task.source in (\"test_failure\", \"lint\", \"todo\"):\n                key = (task.source, task.source_file)\n                grouped[key].append(task)\n            else:\n                ungrouped.append(task)\n\n        result: List[Task] = list(ungrouped)\n        for key, group in grouped.items():\n            # Sort by priority (lower = better), keep the representative task\n            group.sort(key=lambda t: t.priority)\n            representative = group[0]\n            if len(group) > 1:\n                # Enrich the representative's description with count\n                representative.description = (\n                    f\"{representative.description} \"\n                    f\"(+{len(group) - 1} related in {key[1]})\"\n                )\n            result.append(representative)\n\n        return result\n\n    def _extract_test_traceback(self, full_output: str, test_id: str) -> str:\n        \"\"\"Extract the traceback section for a specific test from pytest output.\"\"\"\n        if not test_id:\n            return \"\"\n        lines = full_output.split(\"\\n\")\n        collecting = False\n        result_lines: List[str] = []\n        for line in lines:\n            if test_id in line and (\"FAILED\" in line or \"ERROR\" in line or \"___\" in line):\n                collecting = True\n                result_lines = [line]\n                continue\n            if collecting:\n                if (line.startswith(\"___\") and test_id not in line) or \\\n                   line.startswith(\"=\") or \\\n                   (line.startswith(\"FAILED \") and test_id not in line):\n                    break\n                result_lines.append(line)\n        return \"\\n\".join(result_lines)\n\n    def _read_file_snippet(self, filepath: str, line_num: int, context_lines: int = 5) -> str:\n        \"\"\"Read a snippet of a file around the given line number.\"\"\"\n        try:\n            fpath = Path(filepath)\n            if not fpath.is_absolute():\n                fpath = Path(self.target_dir) / filepath\n            if not fpath.exists():\n                return \"\"\n            content = fpath.read_text(errors=\"ignore\")\n            lines = content.split(\"\\n\")\n            start = max(0, line_num - context_lines - 1)\n            end = min(len(lines), line_num + context_lines)\n            numbered = []\n            for i, line in enumerate(lines[start:end], start + 1):\n                marker = \" >> \" if i == line_num else \"    \"\n                numbered.append(f\"{marker}{i:4d} | {line}\")\n            return \"\\n\".join(numbered)\n        except OSError:\n            return \"\"\n\n    def _discover_test_failures(self) -> List[Task]:\n        \"\"\"Run pytest and parse failures.\"\"\"\n        test_cmd = self.config.validation.test_command\n        if not test_cmd.strip():\n            return []\n\n        try:\n            result = run_with_group_kill(\n                test_cmd,\n                shell=True,\n                cwd=self.target_dir,\n                timeout=self.config.validation.test_timeout,\n            )\n        except OSError as e:\n            logger.warning(\"Test discovery failed: %s\", e)\n            return []\n\n        if result.timed_out:\n            logger.warning(\"Test discovery timed out after %ds\", self.config.validation.test_timeout)\n            return []\n\n        if result.returncode == 0:\n            return []\n\n        # Capture full output for context\n        full_output = result.stdout\n        if result.stderr.strip():\n            full_output += \"\\n\" + result.stderr\n\n        # Parse pytest output for FAILED lines\n        tasks = []\n        for line in result.stdout.split(\"\\n\"):\n            line = line.strip()\n            if line.startswith(\"FAILED\"):\n                # e.g. \"FAILED tests/test_foo.py::test_bar - AssertionError: ...\"\n                desc = f\"Fix test failure: {line}\"\n                # Extract test identifier for per-test traceback\n                parts = line.split()\n                test_id = parts[1] if len(parts) > 1 else \"\"\n                per_test_ctx = self._extract_test_traceback(full_output, test_id)\n                tasks.append(Task(\n                    description=desc,\n                    priority=2,\n                    source=\"test_failure\",\n                    context=per_test_ctx if per_test_ctx else full_output,\n                ))\n\n        # If we got failures but couldn't parse individual ones, create a generic task\n        if result.returncode != 0 and not tasks:\n            tasks.append(Task(\n                description=f\"Fix test failures (exit code {result.returncode})\",\n                priority=2,\n                source=\"test_failure\",\n                context=full_output,\n            ))\n\n        return tasks\n\n    def _discover_lint_errors(self) -> List[Task]:\n        \"\"\"Run lint command and parse errors.\"\"\"\n        lint_cmd = self.config.validation.lint_command\n        if not lint_cmd.strip():\n            return []\n\n        try:\n            result = run_with_group_kill(\n                lint_cmd,\n                shell=True,\n                cwd=self.target_dir,\n                timeout=self.config.validation.lint_timeout,\n            )\n        except OSError as e:\n            logger.warning(\"Lint discovery failed: %s\", e)\n            return []\n\n        if result.timed_out:\n            logger.warning(\"Lint discovery timed out after %ds\", self.config.validation.lint_timeout)\n            return []\n\n        if result.returncode == 0:\n            return []\n\n        # Try to parse ruff JSON output\n        output = result.stdout.strip()\n        try:\n            errors = json.loads(output)\n            if isinstance(errors, list):\n                tasks = []\n                for err in errors[:10]:  # Cap at 10 lint errors\n                    filename = err.get(\"filename\", \"unknown\")\n                    message = err.get(\"message\", \"lint error\")\n                    code = err.get(\"code\", \"\")\n                    line_num = err.get(\"location\", {}).get(\"row\", 0)\n                    desc = f\"Fix lint error in {filename}: [{code}] {message}\"\n                    # Build context: snippet around the error line\n                    context = \"\"\n                    if line_num > 0:\n                        context = self._read_file_snippet(filename, line_num, context_lines=5)\n                    tasks.append(Task(\n                        description=desc,\n                        priority=2,\n                        source=\"lint\",\n                        source_file=filename,\n                        line_number=line_num if line_num > 0 else None,\n                        context=context,\n                    ))\n                return tasks\n        except (json.JSONDecodeError, TypeError):\n            pass\n\n        # Fallback: generic lint error task\n        return [Task(\n            description=\"Fix lint errors\",\n            priority=2,\n            source=\"lint\",\n        )]\n\n    def _discover_todos(self, timeout: int = TODO_SCAN_TIMEOUT) -> List[Task]:\n        \"\"\"Scan source files for TODO/FIXME/HACK comments.\n\n        Args:\n            timeout: Maximum time in seconds for the file walk operation.\n                     If exceeded, returns whatever tasks were found so far.\n        \"\"\"\n        tasks = []\n        patterns = self.config.discovery.todo_patterns\n        exclude_dirs = set(self.config.discovery.exclude_dirs)\n\n        if not patterns:\n            return []\n\n        escaped = \"|\".join(re.escape(p) for p in patterns)\n        keyword_pat = r\"^\\s*(\" + escaped + r\")\\b\"\n        keyword_re = re.compile(keyword_pat, re.IGNORECASE)\n\n        target = Path(self.target_dir)\n        deadline = time.monotonic() + timeout\n        timed_out = False\n        files_scanned = 0\n        for root, dirs, files in os.walk(target):\n            # Check deadline at the start of each directory\n            if time.monotonic() > deadline:\n                timed_out = True\n                break\n\n            # Filter out excluded directories\n            dirs[:] = [d for d in dirs if d not in exclude_dirs]\n\n            for fname in files:\n                # Check deadline periodically (every file)\n                if time.monotonic() > deadline:\n                    timed_out = True\n                    break\n\n                ext = Path(fname).suffix\n                if ext not in _COMMENT_PREFIXES:\n                    continue\n\n                fpath = Path(root) / fname\n                rel_path = str(fpath.relative_to(target))\n\n                try:\n                    content = fpath.read_text(errors=\"ignore\")\n                except OSError:\n                    continue\n\n                files_scanned += 1\n\n                for i, line in enumerate(content.split(\"\\n\"), 1):\n                    comment_text = _extract_comment_text(line, ext)\n                    if comment_text is None:\n                        continue\n                    match = keyword_re.search(comment_text)\n                    if match:\n                        comment = line.strip()\n                        if len(comment) > 120:\n                            comment = comment[:120] + \"...\"\n                        desc = f\"Address {match.group(1)} in {rel_path}:{i}: {comment}\"\n                        context = self._read_file_snippet(str(fpath), i, context_lines=5)\n                        tasks.append(Task(\n                            description=desc,\n                            priority=3,\n                            source=\"todo\",\n                            source_file=rel_path,\n                            line_number=i,\n                            context=context,\n                        ))\n\n            if timed_out:\n                break\n\n        if timed_out:\n            logger.warning(\n                \"TODO scan timed out after %ds (scanned %d files, found %d tasks)\",\n                timeout, files_scanned, len(tasks),\n            )\n\n        return tasks[:self.config.discovery.max_todo_tasks]\n\n    def _discover_claude_ideas(self) -> List[Task]:\n        \"\"\"Use Claude to analyze the codebase and suggest improvement ideas.\n\n        Invokes Claude CLI in read-only analysis mode with a low max-turns\n        to keep cost down. Parses the response for actionable improvement tasks.\n        \"\"\"\n        # Enforce idea generation cooldown to prevent excessive API costs\n        cooldown = self.config.discovery.idea_cooldown_seconds\n        if cooldown > 0:\n            elapsed = time.time() - self._last_idea_discovery_time\n            if self._last_idea_discovery_time > 0 and elapsed < cooldown:\n                logger.debug(\n                    \"Skipping claude_ideas discovery: %.0fs since last run, \"\n                    \"cooldown is %ds\",\n                    elapsed, cooldown,\n                )\n                return []\n\n        cc = self.config.claude\n        if self.config.discovery.discovery_prompt:\n            focus_section = self.config.discovery.discovery_prompt\n        else:\n            focus_section = (\n                \"- New features or functionality that would add value\\n\"\n                \"- Missing tests for important functionality\\n\"\n                \"- Bug risks or edge cases that could cause failures\\n\"\n                \"- Performance improvements\\n\"\n                \"- Code clarity or maintainability improvements\\n\"\n            )\n\n        history_section = \"\"\n        if self.state_manager:\n            recent = self.state_manager.get_recent_task_summaries(\n                lookback_seconds=86400, max_items=15,\n            )\n            if recent:\n                history_section = (\n                    \"\\nRECENTLY COMPLETED TASKS (do NOT suggest similar improvements):\\n\"\n                    + \"\\n\".join(recent)\n                    + \"\\n\\nFocus on NEW areas that haven't been addressed recently.\\n\"\n                )\n\n        prompt = (\n            \"Analyze the codebase in the current directory. Identify up to 5 concrete, \"\n            \"actionable improvements. Focus on:\\n\"\n            + focus_section\n            + history_section\n            + \"\\nFor each improvement, output EXACTLY one line in this format:\\n\"\n            \"IDEA: <one-sentence description of the improvement>\\n\\n\"\n            \"Do NOT make any changes. Do NOT run git commands. Only analyze and output IDEA lines.\"\n        )\n\n        cmd = [\n            cc.command, \"-p\", prompt,\n            \"--model\", self.config.discovery.discovery_model or self.config.claude.resolved_model,\n            \"--max-turns\", str(self.config.discovery.discovery_max_turns),\n            \"--output-format\", \"json\",\n        ]\n\n        try:\n            result = run_with_group_kill(\n                cmd,\n                cwd=self.target_dir,\n                timeout=self.config.discovery.discovery_timeout,\n            )\n        except (FileNotFoundError, OSError) as e:\n            logger.warning(\"Claude idea discovery failed: %s\", e)\n            return []\n\n        if result is None:\n            logger.warning(\"Claude idea discovery returned no result\")\n            return []\n\n        if result.timed_out:\n            logger.warning(\"Claude idea discovery timed out after %ds\",\n                           self.config.discovery.discovery_timeout)\n            return []\n\n        if result.returncode != 0:\n            logger.warning(\"Claude idea discovery exited with code %d\", result.returncode)\n            return []\n\n        # Parse JSON response to get result text\n        result_text = result.stdout\n        try:\n            # Helper: extract text content from a parsed JSON dict.\n            # The Claude CLI uses \"result\" for successful runs and may use\n            # \"result_text\" in some versions.\n            def _extract_text(d: dict) -> str:\n                for key in (\"result\", \"result_text\"):\n                    val = d.get(key)\n                    if isinstance(val, str) and val.strip():\n                        return val\n                return \"\"\n\n            # Strategy 1: Try each line individually as a complete JSON object\n            for line in result_text.strip().split(\"\\n\"):\n                line = line.strip()\n                if not line.startswith(\"{\"):\n                    continue\n                try:\n                    data = json.loads(line)\n                    if isinstance(data, dict):\n                        # Check for error_max_turns — Claude ran out of turns\n                        if data.get(\"subtype\") == \"error_max_turns\":\n                            logger.warning(\n                                \"Claude idea discovery hit max turns (%d); \"\n                                \"increase discovery.discovery_max_turns\",\n                                self.config.discovery.discovery_max_turns,\n                            )\n                            text = _extract_text(data)\n                            if text:\n                                result_text = text\n                            break\n                        text = _extract_text(data)\n                        if text:\n                            result_text = text\n                            break\n                except (json.JSONDecodeError, TypeError):\n                    continue\n            else:\n                # Strategy 2: Try multi-line JSON joining from each '{'-starting line\n                lines = result_text.strip().split(\"\\n\")\n                for i, line in enumerate(lines):\n                    if not line.strip().startswith(\"{\"):\n                        continue\n                    try:\n                        data = json.loads(\"\\n\".join(lines[i:]))\n                        if isinstance(data, dict):\n                            if data.get(\"subtype\") == \"error_max_turns\":\n                                logger.warning(\n                                    \"Claude idea discovery hit max turns (%d); \"\n                                    \"increase discovery.discovery_max_turns\",\n                                    self.config.discovery.discovery_max_turns,\n                                )\n                                text = _extract_text(data)\n                                if text:\n                                    result_text = text\n                                break\n                            text = _extract_text(data)\n                            if text:\n                                result_text = text\n                                break\n                    except (json.JSONDecodeError, TypeError):\n                        continue\n                else:\n                    # Strategy 3: Use raw_decode to find JSON anywhere in the output\n                    decoder = json.JSONDecoder()\n                    for i, ch in enumerate(result_text):\n                        if ch != \"{\":\n                            continue\n                        try:\n                            obj, end = decoder.raw_decode(result_text, i)\n                            if isinstance(obj, dict):\n                                text = _extract_text(obj)\n                                if text:\n                                    result_text = text\n                                    break\n                        except (json.JSONDecodeError, TypeError):\n                            continue\n        except Exception:\n            pass\n\n        # Warn if we couldn't extract text from a JSON response\n        if result_text is result.stdout and result.stdout.strip()[:1] in (\"{\", \"[\"):\n            logger.warning(\n                \"Claude idea response contained JSON but no text content \"\n                \"could be extracted — falling back to raw text extraction\"\n            )\n\n        # Extract IDEA lines\n        MIN_IDEA_LENGTH = 10\n        tasks = []\n        for line in result_text.split(\"\\n\"):\n            line = line.strip()\n            if line.upper().startswith(\"IDEA:\"):\n                desc = line[5:].strip()\n                if desc and len(desc) >= MIN_IDEA_LENGTH:\n                    tasks.append(Task(\n                        description=desc,\n                        priority=4,\n                        source=\"claude_idea\",\n                    ))\n                elif desc:\n                    logger.debug(\"Skipping short IDEA line: %r\", desc)\n\n        logger.info(\"Claude discovered %d improvement ideas\", len(tasks))\n        if not tasks and result_text.strip():\n            # Attempt fallback extraction from analysis-format text\n            lines = [l.strip() for l in result_text.split(\"\\n\") if l.strip()]\n            for line in lines:\n                # Match numbered items: \"1. ...\", \"2) ...\"\n                m = re.match(r'^\\d+[.)]\\s+(.+)', line)\n                if not m:\n                    # Match bullet items: \"- ...\", \"* ...\", \"• ...\"\n                    m = re.match(r'^[-*•]\\s+(.+)', line)\n                if m:\n                    desc = m.group(1).strip()\n                    if desc and len(desc) >= MIN_IDEA_LENGTH:\n                        tasks.append(Task(\n                            description=desc,\n                            priority=4,\n                            source=\"claude_idea\",\n                        ))\n            if tasks:\n                logger.info(\n                    \"Extracted %d tasks from analysis-format text \"\n                    \"(no IDEA: prefixed lines found, used numbered/bullet fallback).\",\n                    len(tasks),\n                )\n            else:\n                logger.debug(\n                    \"Claude response contained no IDEA lines and no extractable \"\n                    \"analysis-format items (%d non-empty lines)\",\n                    len(lines),\n                )\n        self._last_idea_discovery_time = time.time()\n        return tasks[:5]\n\n    def _discover_coverage_gaps(self) -> List[Task]:\n        \"\"\"Discover files with low test coverage (optional, requires pytest-cov).\"\"\"\n        try:\n            result = run_with_group_kill(\n                \"python3 -m pytest --cov --cov-report=json --cov-report=term -q\",\n                shell=True,\n                cwd=self.target_dir,\n                timeout=self.config.validation.test_timeout,\n            )\n        except OSError:\n            return []\n\n        if result.timed_out:\n            return []\n\n        cov_file = Path(self.target_dir) / \"coverage.json\"\n        if not cov_file.exists():\n            return []\n\n        try:\n            data = json.loads(cov_file.read_text())\n            files = data.get(\"files\", {})\n            tasks = []\n            for fname, info in files.items():\n                pct = info.get(\"summary\", {}).get(\"percent_covered\", 100)\n                if pct < 50:\n                    desc = f\"Improve test coverage for {fname} (currently {pct:.0f}%)\"\n                    tasks.append(Task(\n                        description=desc,\n                        priority=4,\n                        source=\"coverage\",\n                        source_file=fname,\n                    ))\n            return tasks[:10]\n        except (json.JSONDecodeError, OSError):\n            return []\n\n    def _discover_quality_issues(self) -> List[Task]:\n        \"\"\"Review source files for general quality issues.\"\"\"\n        tasks = []\n        target = Path(self.target_dir)\n        exclude_dirs = set(self.config.discovery.exclude_dirs)\n\n        for root, dirs, files in os.walk(target):\n            dirs[:] = [d for d in dirs if d not in exclude_dirs]\n\n            for fname in files:\n                if not fname.endswith(\".py\"):\n                    continue\n\n                fpath = Path(root) / fname\n                rel_path = str(fpath.relative_to(target))\n\n                try:\n                    content = fpath.read_text(errors=\"ignore\")\n                except OSError:\n                    continue\n\n                lines = content.split(\"\\n\")\n                # Flag very long files\n                if len(lines) > 500:\n                    tasks.append(Task(\n                        description=f\"Review and potentially refactor {rel_path} ({len(lines)} lines)\",\n                        priority=5,\n                        source=\"quality\",\n                        source_file=rel_path,\n                    ))\n\n        return tasks[:5]\n","numLines":758,"startLine":1,"totalLines":758}}}
