{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_vrtx_01ReyzqSsEXiix7ncX4bSLo9","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_vrtx_017BD3o8NwTJTZAYy7YMVUzw","name":"Write","input":{"file_path":"/Users/sameertkhanna/Documents/auto_claude_code/tests/test_conflict_resolver.py","content":"\"\"\"Tests for conflict_resolver.py.\"\"\"\n\nimport re\nfrom pathlib import Path\nfrom unittest.mock import MagicMock, patch\n\nimport pytest\n\nfrom claude_runner import ClaudeResult\nfrom conflict_resolver import CONFLICT_MARKER_RE, ConflictResolver\n\n\n@pytest.fixture\ndef resolver(default_config):\n    \"\"\"Create a ConflictResolver with mocked ClaudeRunner.\"\"\"\n    with patch(\"conflict_resolver.ClaudeRunner\") as MockRunner:\n        mock_runner_instance = MagicMock()\n        MockRunner.return_value = mock_runner_instance\n        cr = ConflictResolver(default_config)\n        # Expose the mock for tests to configure\n        cr._mock_runner = mock_runner_instance\n        yield cr\n\n\nclass TestResolveConflictsSuccess:\n    \"\"\"Tests for successful conflict resolution.\"\"\"\n\n    def test_single_file_resolved(self, resolver, tmp_path):\n        conflicted = (\n            \"<<<<<<< HEAD\\nline from main\\n=======\\nline from worker\\n>>>>>>> worker\\n\"\n        )\n        resolved_code = \"line from main\\nline from worker\\n\"\n\n        f = tmp_path / \"file.py\"\n        f.write_text(conflicted)\n\n        resolver._mock_runner.run.return_value = ClaudeResult(\n            success=True,\n            result_text=f\"```python\\n{resolved_code}```\",\n            cost_usd=0.01,\n        )\n\n        success, cost = resolver.resolve_conflicts(\n            str(tmp_path), [\"file.py\"], \"worker-branch\", \"main\",\n        )\n\n        assert success is True\n        assert cost == 0.01\n        assert f.read_text() == resolved_code\n\n    def test_multiple_files_resolved(self, resolver, tmp_path):\n        for name in [\"a.py\", \"b.py\"]:\n            p = tmp_path / name\n            p.write_text(\"<<<<<<< HEAD\\nA\\n=======\\nB\\n>>>>>>> worker\\n\")\n\n        resolver._mock_runner.run.side_effect = [\n            ClaudeResult(success=True, result_text=\"```\\nresolved a\\n```\", cost_usd=0.01),\n            ClaudeResult(success=True, result_text=\"```\\nresolved b\\n```\", cost_usd=0.02),\n        ]\n\n        success, cost = resolver.resolve_conflicts(\n            str(tmp_path), [\"a.py\", \"b.py\"], \"worker\", \"main\",\n        )\n\n        assert success is True\n        assert cost == pytest.approx(0.03)\n        assert (tmp_path / \"a.py\").read_text() == \"resolved a\\n\"\n        assert (tmp_path / \"b.py\").read_text() == \"resolved b\\n\"\n\n    def test_empty_conflict_list(self, resolver, tmp_path):\n        success, cost = resolver.resolve_conflicts(\n            str(tmp_path), [], \"worker\", \"main\",\n        )\n\n        assert success is True\n        assert cost == 0.0\n        resolver._mock_runner.run.assert_not_called()\n\n\nclass TestResolveConflictsFailure:\n    \"\"\"Tests for failed conflict resolution.\"\"\"\n\n    def test_claude_returns_failure(self, resolver, tmp_path):\n        f = tmp_path / \"file.py\"\n        f.write_text(\"<<<<<<< HEAD\\nA\\n=======\\nB\\n>>>>>>> worker\\n\")\n\n        resolver._mock_runner.run.return_value = ClaudeResult(\n            success=False, result_text=\"\", cost_usd=0.005, error=\"API error\",\n        )\n\n        success, cost = resolver.resolve_conflicts(\n            str(tmp_path), [\"file.py\"], \"worker\", \"main\",\n        )\n\n        assert success is False\n        assert cost == 0.005\n\n    def test_claude_returns_empty_response(self, resolver, tmp_path):\n        f = tmp_path / \"file.py\"\n        f.write_text(\"<<<<<<< HEAD\\nA\\n=======\\nB\\n>>>>>>> worker\\n\")\n\n        resolver._mock_runner.run.return_value = ClaudeResult(\n            success=True, result_text=\"\", cost_usd=0.01,\n        )\n\n        success, cost = resolver.resolve_conflicts(\n            str(tmp_path), [\"file.py\"], \"worker\", \"main\",\n        )\n\n        assert success is False\n\n    def test_resolved_still_has_conflict_markers(self, resolver, tmp_path):\n        f = tmp_path / \"file.py\"\n        f.write_text(\"<<<<<<< HEAD\\nA\\n=======\\nB\\n>>>>>>> worker\\n\")\n\n        # Claude returns content that still contains markers\n        bad_resolved = \"some code\\n<<<<<<< HEAD\\nstill conflicted\\n=======\\nother\\n>>>>>>> worker\\n\"\n        resolver._mock_runner.run.return_value = ClaudeResult(\n            success=True, result_text=f\"```\\n{bad_resolved}```\", cost_usd=0.01,\n        )\n\n        success, cost = resolver.resolve_conflicts(\n            str(tmp_path), [\"file.py\"], \"worker\", \"main\",\n        )\n\n        assert success is False\n\n    def test_file_not_found(self, resolver, tmp_path):\n        success, cost = resolver.resolve_conflicts(\n            str(tmp_path), [\"nonexistent.py\"], \"worker\", \"main\",\n        )\n\n        assert success is False\n        resolver._mock_runner.run.assert_not_called()\n\n    def test_cost_limit_reached(self, resolver, tmp_path):\n        # Set a very low cost limit\n        resolver.config.parallel.conflict_resolution_max_cost = 0.01\n\n        for name in [\"a.py\", \"b.py\"]:\n            (tmp_path / name).write_text(\"<<<<<<< HEAD\\nA\\n=======\\nB\\n>>>>>>> w\\n\")\n\n        resolver._mock_runner.run.return_value = ClaudeResult(\n            success=True, result_text=\"```\\nresolved\\n```\", cost_usd=0.02,\n        )\n\n        success, cost = resolver.resolve_conflicts(\n            str(tmp_path), [\"a.py\", \"b.py\"], \"worker\", \"main\",\n        )\n\n        # First file resolves but pushes cost above limit; second file is skipped\n        # Actually: first file costs 0.02, which is written. Then for second file,\n        # _total_cost (0.02) >= max_cost (0.01), so it aborts.\n        assert success is False\n        assert resolver._mock_runner.run.call_count == 1\n\n\nclass TestExtractResolvedContent:\n    \"\"\"Tests for _extract_resolved_content static method.\"\"\"\n\n    def test_extracts_from_code_block(self):\n        text = \"Here is the resolved file:\\n```python\\nprint('hello')\\n```\\n\"\n        result = ConflictResolver._extract_resolved_content(text)\n        assert result == \"print('hello')\\n\"\n\n    def test_falls_back_to_raw_text(self):\n        text = \"print('hello')\"\n        result = ConflictResolver._extract_resolved_content(text)\n        assert result == \"print('hello')\"\n\n    def test_returns_none_for_empty(self):\n        assert ConflictResolver._extract_resolved_content(\"\") is None\n        assert ConflictResolver._extract_resolved_content(\"   \") is None\n        assert ConflictResolver._extract_resolved_content(None) is None\n\n\nclass TestBuildResolvePrompt:\n    \"\"\"Tests for _build_resolve_prompt static method.\"\"\"\n\n    def test_prompt_contains_file_and_branch_info(self):\n        prompt = ConflictResolver._build_resolve_prompt(\n            \"src/foo.py\", \"conflicted content\", \"feature-branch\", \"main\",\n        )\n        assert \"src/foo.py\" in prompt\n        assert \"feature-branch\" in prompt\n        assert \"main\" in prompt\n        assert \"conflicted content\" in prompt\n\n\nclass TestConflictMarkerRegex:\n    \"\"\"Tests for CONFLICT_MARKER_RE.\"\"\"\n\n    def test_detects_conflict_markers(self):\n        assert CONFLICT_MARKER_RE.search(\"<<<<<<< HEAD\\n\")\n        assert CONFLICT_MARKER_RE.search(\"=======\\n\")\n        assert CONFLICT_MARKER_RE.search(\">>>>>>> branch\\n\")\n\n    def test_clean_content_has_no_markers(self):\n        assert CONFLICT_MARKER_RE.search(\"normal code\\nmore code\\n\") is None\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1293,"cache_read_input_tokens":25935,"cache_creation":{"ephemeral_5m_input_tokens":1293,"ephemeral_1h_input_tokens":0},"output_tokens":1},"context_management":null},"parent_tool_use_id":null,"session_id":"280e0b4d-1be2-481e-8af2-461e3680d862","uuid":"de56a205-ffd8-4475-9ce4-22f72ac03d6d"}
