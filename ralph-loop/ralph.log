{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_vrtx_01Kdz4WPuPv7ME6HpGQY3r3g","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_vrtx_014hpZp7r44FjXtfk46ZRd6g","name":"Write","input":{"file_path":"/Users/sameertkhanna/Documents/auto_claude_code/tests/test_session_manager.py","content":"\"\"\"Tests for session_manager.py.\"\"\"\n\nimport json\nimport os\nimport subprocess\nfrom unittest.mock import patch, MagicMock\n\nimport pytest\n\nfrom session_manager import SessionManager, SessionState, SESSION_FILE\n\n\n@pytest.fixture\ndef session_mgr(tmp_path):\n    \"\"\"Return a SessionManager using a temporary directory.\"\"\"\n    return SessionManager(str(tmp_path))\n\n\n@pytest.fixture\ndef sample_state():\n    \"\"\"Return a sample SessionState for testing.\"\"\"\n    return SessionState(\n        session_id=\"session-12345-99\",\n        started_at=1700000000.0,\n        tasks=[\n            {\"task_id\": \"t1\", \"description\": \"Fix bug\"},\n            {\"task_id\": \"t2\", \"description\": \"Add feature\"},\n        ],\n        completed_task_ids=[\"t1\"],\n        worker_states={0: {\"status\": \"idle\"}, 1: {\"status\": \"busy\"}},\n        total_cost_usd=0.42,\n        phase=\"running\",\n    )\n\n\n# --- SessionState dataclass tests ---\n\nclass TestSessionState:\n    def test_to_dict_roundtrip(self, sample_state):\n        data = sample_state.to_dict()\n        restored = SessionState.from_dict(data)\n        assert restored.session_id == sample_state.session_id\n        assert restored.started_at == sample_state.started_at\n        assert restored.tasks == sample_state.tasks\n        assert restored.completed_task_ids == sample_state.completed_task_ids\n        assert restored.worker_states == sample_state.worker_states\n        assert restored.total_cost_usd == sample_state.total_cost_usd\n        assert restored.phase == sample_state.phase\n\n    def test_from_dict_defaults(self):\n        state = SessionState.from_dict({})\n        assert state.session_id == \"\"\n        assert state.started_at == 0.0\n        assert state.tasks == []\n        assert state.completed_task_ids == []\n        assert state.worker_states == {}\n        assert state.total_cost_usd == 0.0\n        assert state.phase == \"starting\"\n\n    def test_worker_states_keys_become_int(self):\n        data = {\"session_id\": \"s1\", \"started_at\": 0,\n                \"worker_states\": {\"0\": {\"x\": 1}, \"3\": {\"x\": 2}}}\n        state = SessionState.from_dict(data)\n        assert set(state.worker_states.keys()) == {0, 3}\n\n\n# --- Session file creation / loading ---\n\nclass TestSaveAndLoad:\n    def test_save_creates_file(self, session_mgr, sample_state, tmp_path):\n        session_mgr.save_session(sample_state)\n        assert (tmp_path / SESSION_FILE).exists()\n\n    def test_load_returns_saved_state(self, session_mgr, sample_state):\n        session_mgr.save_session(sample_state)\n        loaded = session_mgr.load_session()\n        assert loaded is not None\n        assert loaded.session_id == sample_state.session_id\n        assert loaded.tasks == sample_state.tasks\n        assert loaded.completed_task_ids == sample_state.completed_task_ids\n        assert loaded.total_cost_usd == sample_state.total_cost_usd\n\n    def test_load_no_file_returns_none(self, session_mgr):\n        assert session_mgr.load_session() is None\n\n    def test_load_corrupt_json_returns_none(self, session_mgr, tmp_path):\n        (tmp_path / SESSION_FILE).write_text(\"not json {{{\")\n        assert session_mgr.load_session() is None\n\n    def test_load_non_dict_json_returns_none(self, session_mgr, tmp_path):\n        (tmp_path / SESSION_FILE).write_text(\"[1, 2, 3]\")\n        assert session_mgr.load_session() is None\n\n    def test_save_atomic_replaces_existing(self, session_mgr, sample_state):\n        session_mgr.save_session(sample_state)\n        updated = SessionState(\n            session_id=\"session-99999-1\",\n            started_at=1700001000.0,\n            phase=\"done\",\n        )\n        session_mgr.save_session(updated)\n        loaded = session_mgr.load_session()\n        assert loaded.session_id == \"session-99999-1\"\n        assert loaded.phase == \"done\"\n\n\n# --- clear_session ---\n\nclass TestClearSession:\n    def test_clear_removes_file(self, session_mgr, sample_state, tmp_path):\n        session_mgr.save_session(sample_state)\n        assert (tmp_path / SESSION_FILE).exists()\n        session_mgr.clear_session()\n        assert not (tmp_path / SESSION_FILE).exists()\n\n    def test_clear_no_file_is_noop(self, session_mgr):\n        session_mgr.clear_session()  # should not raise\n\n\n# --- has_incomplete_session ---\n\nclass TestHasIncompleteSession:\n    def test_no_file_returns_false(self, session_mgr):\n        assert session_mgr.has_incomplete_session() is False\n\n    def test_no_tasks_returns_false(self, session_mgr):\n        state = SessionState(session_id=\"s1\", started_at=0)\n        session_mgr.save_session(state)\n        assert session_mgr.has_incomplete_session() is False\n\n    def test_all_tasks_completed_returns_false(self, session_mgr):\n        state = SessionState(\n            session_id=\"s1\",\n            started_at=0,\n            tasks=[{\"task_id\": \"t1\"}, {\"task_id\": \"t2\"}],\n            completed_task_ids=[\"t1\", \"t2\"],\n        )\n        session_mgr.save_session(state)\n        assert session_mgr.has_incomplete_session() is False\n\n    def test_some_tasks_incomplete_returns_true(self, session_mgr, sample_state):\n        # sample_state has tasks t1,t2 but only t1 completed\n        session_mgr.save_session(sample_state)\n        assert session_mgr.has_incomplete_session() is True\n\n    def test_task_key_fallback(self, session_mgr):\n        \"\"\"Tasks without task_id fall back to task_key.\"\"\"\n        state = SessionState(\n            session_id=\"s1\",\n            started_at=0,\n            tasks=[{\"task_key\": \"k1\"}],\n            completed_task_ids=[\"k1\"],\n        )\n        session_mgr.save_session(state)\n        assert session_mgr.has_incomplete_session() is False\n\n\n# --- recover_orphaned_worktrees ---\n\nclass TestRecoverOrphanedWorktrees:\n    def test_detects_auto_claude_branches(self, tmp_path):\n        porcelain_output = (\n            \"worktree /main/repo\\n\"\n            \"branch refs/heads/main\\n\"\n            \"\\n\"\n            \"worktree /tmp/wt1\\n\"\n            \"branch refs/heads/auto-claude/task-1\\n\"\n            \"\\n\"\n            \"worktree /tmp/wt2\\n\"\n            \"branch refs/heads/feature/foo\\n\"\n            \"\\n\"\n        )\n        mgr = SessionManager(str(tmp_path))\n        with patch(\"subprocess.run\") as mock_run:\n            mock_run.return_value = MagicMock(\n                returncode=0, stdout=porcelain_output,\n            )\n            orphaned = mgr.recover_orphaned_worktrees(\"/fake/repo\")\n\n        assert len(orphaned) == 1\n        assert orphaned[0][\"path\"] == \"/tmp/wt1\"\n        assert orphaned[0][\"branch\"] == \"auto-claude/task-1\"\n\n    def test_no_orphans(self, tmp_path):\n        porcelain_output = (\n            \"worktree /main/repo\\n\"\n            \"branch refs/heads/main\\n\"\n            \"\\n\"\n        )\n        mgr = SessionManager(str(tmp_path))\n        with patch(\"subprocess.run\") as mock_run:\n            mock_run.return_value = MagicMock(returncode=0, stdout=porcelain_output)\n            orphaned = mgr.recover_orphaned_worktrees(\"/fake/repo\")\n        assert orphaned == []\n\n    def test_git_command_failure_returns_empty(self, tmp_path):\n        mgr = SessionManager(str(tmp_path))\n        with patch(\"subprocess.run\") as mock_run:\n            mock_run.return_value = MagicMock(returncode=1, stdout=\"\")\n            orphaned = mgr.recover_orphaned_worktrees(\"/fake/repo\")\n        assert orphaned == []\n\n    def test_timeout_returns_empty(self, tmp_path):\n        mgr = SessionManager(str(tmp_path))\n        with patch(\"subprocess.run\") as mock_run:\n            mock_run.side_effect = subprocess.TimeoutExpired(cmd=\"git\", timeout=30)\n            orphaned = mgr.recover_orphaned_worktrees(\"/fake/repo\")\n        assert orphaned == []\n\n    def test_os_error_returns_empty(self, tmp_path):\n        mgr = SessionManager(str(tmp_path))\n        with patch(\"subprocess.run\") as mock_run:\n            mock_run.side_effect = OSError(\"no git\")\n            orphaned = mgr.recover_orphaned_worktrees(\"/fake/repo\")\n        assert orphaned == []\n\n    def test_last_entry_without_trailing_newline(self, tmp_path):\n        \"\"\"The last worktree entry may not have a trailing blank line.\"\"\"\n        porcelain_output = (\n            \"worktree /tmp/wt1\\n\"\n            \"branch refs/heads/auto-claude/task-x\"\n        )\n        mgr = SessionManager(str(tmp_path))\n        with patch(\"subprocess.run\") as mock_run:\n            mock_run.return_value = MagicMock(returncode=0, stdout=porcelain_output)\n            orphaned = mgr.recover_orphaned_worktrees(\"/fake/repo\")\n        assert len(orphaned) == 1\n        assert orphaned[0][\"branch\"] == \"auto-claude/task-x\"\n\n\n# --- cleanup of stale sessions ---\n\nclass TestStaleSessionCleanup:\n    def test_clear_after_load_removes_stale(self, session_mgr, sample_state, tmp_path):\n        \"\"\"Simulate recovery flow: load stale session, process it, clear.\"\"\"\n        session_mgr.save_session(sample_state)\n        loaded = session_mgr.load_session()\n        assert loaded is not None\n        # After processing, clear the session\n        session_mgr.clear_session()\n        assert session_mgr.load_session() is None\n        assert session_mgr.has_incomplete_session() is False\n\n\n# --- create_session_id ---\n\nclass TestCreateSessionId:\n    def test_format(self, session_mgr):\n        sid = session_mgr.create_session_id()\n        assert sid.startswith(\"session-\")\n        parts = sid.split(\"-\")\n        assert len(parts) == 3\n        # timestamp and pid should be numeric\n        assert parts[1].isdigit()\n        assert parts[2].isdigit()\n\n    def test_uniqueness(self, session_mgr):\n        ids = {session_mgr.create_session_id() for _ in range(5)}\n        # All should contain the same PID, but may differ by timestamp\n        # At minimum they should all be valid format\n        for sid in ids:\n            assert sid.startswith(\"session-\")\n\n\n# --- state_dir creation ---\n\nclass TestStateDirCreation:\n    def test_creates_nested_dir(self, tmp_path):\n        nested = tmp_path / \"a\" / \"b\" / \"c\"\n        mgr = SessionManager(str(nested))\n        assert nested.exists()\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":258,"cache_read_input_tokens":27705,"cache_creation":{"ephemeral_5m_input_tokens":258,"ephemeral_1h_input_tokens":0},"output_tokens":1},"context_management":null},"parent_tool_use_id":null,"session_id":"640b52e8-d739-4f76-a84a-7189ed2a386a","uuid":"92f00279-776a-4076-a101-2f3b40e96dbf"}
