{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_vrtx_01AQqMV5YN3bypUc3GURRkk9","type":"tool_result","content":"     1→\"\"\"Auto-discover tasks from the target project (test failures, lint, TODOs, etc.).\"\"\"\n     2→\n     3→from __future__ import annotations\n     4→\n     5→import ast\n     6→import json\n     7→import logging\n     8→import os\n     9→import re\n    10→import time\n    11→from dataclasses import dataclass, field\n    12→from pathlib import Path\n    13→from typing import List, Optional\n    14→\n    15→from config_schema import Config\n    16→from process_utils import run_with_group_kill\n    17→\n    18→logger = logging.getLogger(__name__)\n    19→\n    20→\n    21→def _extract_json_text(raw_output: str) -> str:\n    22→    \"\"\"Extract text content from Claude CLI JSON output.\n    23→\n    24→    Parses JSON objects from the raw output using multiple strategies\n    25→    (line-by-line, multi-line, raw_decode) and extracts the 'result' or\n    26→    'result_text' field.  Returns the extracted text, or the original\n    27→    raw_output if extraction fails.\n    28→\n    29→    This is a shared utility that reduces duplication between\n    30→    task_discovery._discover_claude_ideas() and\n    31→    claude_runner._parse_json_response().\n    32→    \"\"\"\n    33→    def _text_from_dict(d: dict) -> str:\n    34→        for key in (\"result\", \"result_text\"):\n    35→            val = d.get(key)\n    36→            if isinstance(val, str) and val.strip():\n    37→                return val\n    38→        return \"\"\n    39→\n    40→    try:\n    41→        lines = raw_output.strip().splitlines()\n    42→\n    43→        # Strategy 1: Try each line individually as a complete JSON object\n    44→        for line in lines:\n    45→            stripped = line.strip()\n    46→            if not stripped.startswith(\"{\"):\n    47→                continue\n    48→            try:\n    49→                data = json.loads(stripped)\n    50→                if isinstance(data, dict):\n    51→                    text = _text_from_dict(data)\n    52→                    if text:\n    53→                        return text\n    54→            except (json.JSONDecodeError, TypeError):\n    55→                continue\n    56→\n    57→        # Strategy 2: Try multi-line JSON joining from each '{'-starting line\n    58→        for i, line in enumerate(lines):\n    59→            if not line.strip().startswith(\"{\"):\n    60→                continue\n    61→            try:\n    62→                data = json.loads(\"\\n\".join(lines[i:]))\n    63→                if isinstance(data, dict):\n    64→                    text = _text_from_dict(data)\n    65→                    if text:\n    66→                        return text\n    67→            except (json.JSONDecodeError, TypeError):\n    68→                continue\n    69→\n    70→        # Strategy 3: Use raw_decode to find JSON anywhere in the output\n    71→        decoder = json.JSONDecoder()\n    72→        for i, ch in enumerate(raw_output):\n    73→            if ch != \"{\":\n    74→                continue\n    75→            try:\n    76→                obj, _ = decoder.raw_decode(raw_output, i)\n    77→                if isinstance(obj, dict):\n    78→                    text = _text_from_dict(obj)\n    79→                    if text:\n    80→                        return text\n    81→            except (json.JSONDecodeError, TypeError):\n    82→                continue\n    83→    except Exception:\n    84→        pass\n    85→\n    86→    return raw_output\n    87→\n    88→\n    89→# Map file extensions to their comment prefix styles\n    90→_COMMENT_PREFIXES = {\n    91→    \".py\": (\"#\",), \".rb\": (\"#\",),\n    92→    \".js\": (\"//\", \"/*\"), \".ts\": (\"//\", \"/*\"),\n    93→    \".jsx\": (\"//\", \"/*\"), \".tsx\": (\"//\", \"/*\"),\n    94→    \".go\": (\"//\", \"/*\"), \".rs\": (\"//\", \"/*\"),\n    95→    \".java\": (\"//\", \"/*\"),\n    96→}\n    97→\n    98→# Regex to match string literals (double-quoted and single-quoted, with escapes)\n    99→_STRING_LITERAL_RE = re.compile(r'''\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^'\\\\]|\\\\.)*' '''.strip())\n   100→\n   101→MAX_TASK_DESCRIPTION_LENGTH = 2000\n   102→MAX_TASK_CONTEXT_LENGTH = 12000\n   103→\n   104→# Default timeout for _discover_todos file walk (seconds)\n   105→TODO_SCAN_TIMEOUT = 60\n   106→\n   107→_FILE_REF_RE = re.compile(\n   108→    r'`([a-zA-Z0-9_/.\\-]+\\.(?:py|js|ts|tsx|jsx|go|rs|java|rb|sh|yaml|yml|json|md|txt))'\n   109→    r'(?::(\\d+))?(?:-\\d+)?`'\n   110→)\n   111→_FILE_REF_FALLBACK_RE = re.compile(\n   112→    r'(?:in\\s+|for\\s+)([a-zA-Z0-9_/.\\-]+\\.(?:py|js|ts|tsx|jsx|go|rs|java|rb|sh|yaml|yml|json|md|txt))'\n   113→    r'(?::(\\d+))?'\n   114→)\n   115→\n   116→\n   117→def _sanitize_description(desc: str) -> str:\n   118→    \"\"\"Sanitize a task description: strip, collapse newlines, and truncate.\"\"\"\n   119→    desc = desc.strip()\n   120→    desc = desc.replace(\"\\n\", \" \").replace(\"\\r\", \" \")\n   121→    if len(desc) > MAX_TASK_DESCRIPTION_LENGTH:\n   122→        desc = desc[:MAX_TASK_DESCRIPTION_LENGTH] + \"...\"\n   123→    return desc\n   124→\n   125→\n   126→def _extract_comment_text(line: str, ext: str) -> Optional[str]:\n   127→    \"\"\"Strip string literals from *line*, then return the comment body if a\n   128→    comment prefix for *ext* is found.  Returns ``None`` when no comment is\n   129→    detected.\"\"\"\n   130→    prefixes = _COMMENT_PREFIXES.get(ext)\n   131→    if not prefixes:\n   132→        return None\n   133→\n   134→    # Remove string literals so that a '#' or '//' inside a string is ignored\n   135→    stripped = _STRING_LITERAL_RE.sub(\"\", line)\n   136→\n   137→    # Find the earliest comment prefix in the stripped line\n   138→    earliest_pos = None\n   139→    earliest_prefix = None\n   140→    for pfx in prefixes:\n   141→        pos = stripped.find(pfx)\n   142→        if pos != -1 and (earliest_pos is None or pos < earliest_pos):\n   143→            earliest_pos = pos\n   144→            earliest_prefix = pfx\n   145→\n   146→    if earliest_pos is None:\n   147→        return None\n   148→\n   149→    # Return the text after the comment prefix\n   150→    return stripped[earliest_pos + len(earliest_prefix):]\n   151→\n   152→\n   153→@dataclass\n   154→class Task:\n   155→    description: str\n   156→    priority: int  # 1 = highest (feedback), 5 = lowest (quality review)\n   157→    source: str  # \"test_failure\", \"lint\", \"todo\", \"coverage\", \"quality\", \"feedback\"\n   158→    source_file: Optional[str] = None  # file path for feedback tasks\n   159→    line_number: Optional[int] = None\n   160→    context: str = \"\"  # rich context: tracebacks, file snippets, error details\n   161→    task_id: str = \"\"\n   162→    depends_on: List[str] = field(default_factory=list)\n   163→\n   164→    def __post_init__(self):\n   165→        self.description = _sanitize_description(self.description)\n   166→        if len(self.context) > MAX_TASK_CONTEXT_LENGTH:\n   167→            self.context = self.context[:MAX_TASK_CONTEXT_LENGTH] + \"\\n... (truncated)\"\n   168→        if not self.task_id:\n   169→            self.task_id = self.task_key\n   170→\n   171→    @property\n   172→    def task_key(self) -> str:\n   173→        \"\"\"Stable dedup key — same underlying issue produces the same key.\"\"\"\n   174→        if self.source == \"todo\" and self.source_file:\n   175→            if self.line_number is not None:\n   176→                return f\"todo:{self.source_file}:{self.line_number}\"\n   177→            return f\"todo:{self.source_file}\"\n   178→\n   179→        if self.source in (\"lint\", \"test_failure\", \"quality\", \"coverage\") and self.source_file:\n   180→            return f\"{self.source}:{self.source_file}\"\n   181→\n   182→        if self.source == \"coverage\":\n   183→            match = re.search(r'for\\s+(\\S+)', self.description)\n   184→            if match:\n   185→                return f\"coverage:{match.group(1)}\"\n   186→\n   187→        if self.source == \"claude_idea\":\n   188→            match = _FILE_REF_RE.search(self.description)\n   189→            if match:\n   190→                return f\"claude_idea:{match.group(1)}\"\n   191→            match = _FILE_REF_FALLBACK_RE.search(self.description)\n   192→            if match:\n   193→                return f\"claude_idea:{match.group(1)}\"\n   194→            return f\"claude_idea:{self.description[:60]}\"\n   195→\n   196→        if self.source == \"feedback\" and self.source_file:\n   197→            return f\"feedback:{self.source_file}\"\n   198→\n   199→        if self.source == \"test_failure\":\n   200→            match = re.search(r'FAILED\\s+(\\S+)', self.description)\n   201→            if match:\n   202→                return f\"test_failure:{match.group(1)}\"\n   203→\n   204→        return f\"{self.source}:{self.description}\"\n   205→\n   206→\n   207→class TaskDiscovery:\n   208→    def __init__(self, config: Config, state_manager=None):\n   209→        self.config = config\n   210→        self.target_dir = config.target_dir\n   211→        self.state_manager = state_manager\n   212→        self._last_idea_discovery_time: float = 0.0\n   213→\n   214→    def discover_all(self) -> List[Task]:\n   215→        \"\"\"Run all enabled discovery strategies and return sorted tasks.\"\"\"\n   216→        tasks: List[Task] = []\n   217→        dc = self.config.discovery\n   218→\n   219→        if dc.enable_test_failures:\n   220→            tasks.extend(self._discover_test_failures())\n   221→\n   222→        if dc.enable_lint_errors:\n   223→            tasks.extend(self._discover_lint_errors())\n   224→\n   225→        if dc.enable_todos:\n   226→            tasks.extend(self._discover_todos())\n   227→\n   228→        if dc.enable_coverage:\n   229→            tasks.extend(self._discover_coverage_gaps())\n   230→\n   231→        if dc.enable_claude_ideas:\n   232→            tasks.extend(self._discover_claude_ideas())\n   233→\n   234→        if dc.enable_quality_review:\n   235→            tasks.extend(self._discover_quality_issues())\n   236→\n   237→        if dc.enable_complexity_check:\n   238→            tasks.extend(self._discover_complexity_issues())\n   239→\n   240→        # Group related tasks to avoid duplicate work\n   241→        tasks = self._group_related_tasks(tasks)\n   242→\n   243→        # Boost priority for historically high-success-rate sources\n   244→        if self.state_manager and dc.adaptive_priority and tasks:\n   245→            try:\n   246→                performance = self.state_manager.get_strategy_performance(lookback_seconds=86400)\n   247→                if performance:\n   248→                    for task in tasks:\n   249→                        perf = performance.get(task.source)\n   250→                        if perf and perf.get(\"total\", 0) >= 2:\n   251→                            success_rate = perf.get(\"success_rate\", 0.0)\n   252→                            if success_rate > 0.5:\n   253→                                # Higher success rate -> lower priority number (higher priority)\n   254→                                # e.g., 90% success -> priority reduced by 2\n   255→                                boost = int(success_rate * 3)  # 0-3 boost\n   256→                                task.priority = max(1, task.priority - boost)\n   257→            except Exception as e:\n   258→                logger.debug(\"Strategy performance boosting failed: %s\", e)\n   259→\n   260→        # Sort by priority (lower number = higher priority)\n   261→        tasks.sort(key=lambda t: t.priority)\n   262→        return tasks\n   263→\n   264→    def _group_related_tasks(self, tasks: List[Task]) -> List[Task]:\n   265→        \"\"\"Group related tasks by file path to avoid duplicate work.\n   266→\n   267→        When multiple tasks share the same source file (e.g., multiple test\n   268→        failures in the same file, or multiple lint errors in the same file),\n   269→        they likely share a root cause. This method keeps only the first\n   270→        (highest-priority) task per file for each source type, reducing\n   271→        wasted cycles on tasks that will auto-resolve when the root cause\n   272→        is fixed.\n   273→\n   274→        Tasks without a source_file are always kept.\n   275→        \"\"\"\n   276→        from collections import defaultdict\n   277→\n   278→        # Group by (source, source_file) — only group when source_file is set\n   279→        grouped: dict = defaultdict(list)\n   280→        ungrouped: List[Task] = []\n   281→\n   282→        for task in tasks:\n   283→            if task.source_file and task.source in (\"test_failure\", \"lint\", \"todo\"):\n   284→                key = (task.source, task.source_file)\n   285→                grouped[key].append(task)\n   286→            else:\n   287→                ungrouped.append(task)\n   288→\n   289→        result: List[Task] = list(ungrouped)\n   290→        for key, group in grouped.items():\n   291→            # Sort by priority (lower = better), keep the representative task\n   292→            group.sort(key=lambda t: t.priority)\n   293→            representative = group[0]\n   294→            if len(group) > 1:\n   295→                # Enrich the representative's description with count\n   296→                representative.description = (\n   297→                    f\"{representative.description} \"\n   298→                    f\"(+{len(group) - 1} related in {key[1]})\"\n   299→                )\n   300→            result.append(representative)\n   301→\n   302→        return result\n   303→\n   304→    # Regex to extract file path and line number from pytest traceback lines\n   305→    # Matches patterns like \"tests/test_foo.py:5: AssertionError\"\n   306→    _TRACEBACK_LOC_RE = re.compile(\n   307→        r'^(\\S+\\.py):(\\d+):\\s+\\w+(?:Error|Exception|Warning)'\n   308→    )\n   309→\n   310→    def _extract_test_traceback(self, full_output: str, test_id: str) -> str:\n   311→        \"\"\"Extract the traceback section for a specific test from pytest output.\n   312→\n   313→        Includes assertion details (lines starting with 'E') and ensures the\n   314→        last 5 lines of the traceback are always present.\n   315→        \"\"\"\n   316→        if not test_id:\n   317→            return \"\"\n   318→        lines = full_output.split(\"\\n\")\n   319→        collecting = False\n   320→        result_lines: List[str] = []\n   321→        assertion_lines: List[str] = []\n   322→        for line in lines:\n   323→            if test_id in line and (\"FAILED\" in line or \"ERROR\" in line or \"___\" in line):\n   324→                collecting = True\n   325→                result_lines = [line]\n   326→                assertion_lines = []\n   327→                continue\n   328→            if collecting:\n   329→                if (line.startswith(\"___\") and test_id not in line) or \\\n   330→                   line.startswith(\"=\") or \\\n   331→                   (line.startswith(\"FAILED \") and test_id not in line):\n   332→                    break\n   333→                result_lines.append(line)\n   334→                # Collect assertion detail lines (pytest prefixes them with 'E')\n   335→                stripped = line.lstrip()\n   336→                if stripped.startswith(\"E \") or stripped.startswith(\"E\\t\"):\n   337→                    assertion_lines.append(line)\n   338→\n   339→        if not result_lines:\n   340→            return \"\"\n   341→\n   342→        # Ensure the last 5 lines of the traceback are included\n   343→        # (they typically contain the assertion and location info)\n   344→        traceback_text = \"\\n\".join(result_lines)\n   345→        if len(result_lines) > 5:\n   346→            last_5 = \"\\n\".join(result_lines[-5:])\n   347→            # If assertion lines exist but aren't in last 5 lines, append them\n   348→            if assertion_lines:\n   349→                for aline in assertion_lines:\n   350→                    if aline not in result_lines[-5:]:\n   351→                        traceback_text += \"\\n\" + aline\n   352→\n   353→        return traceback_text\n   354→\n   355→    def _extract_traceback_location(self, traceback_text: str) -> tuple:\n   356→        \"\"\"Extract file path and line number from a pytest traceback.\n   357→\n   358→        Returns (source_file, line_number) or (None, None) if not found.\n   359→        \"\"\"\n   360→        if not traceback_text:\n   361→            return None, None\n   362→        # Search for the last file:line pattern in the traceback\n   363→        # (the last one is typically the failing assertion location)\n   364→        last_match = None\n   365→        for line in traceback_text.split(\"\\n\"):\n   366→            line = line.strip()\n   367→            m = self._TRACEBACK_LOC_RE.match(line)\n   368→            if m:\n   369→                last_match = m\n   370→        if last_match:\n   371→            return last_match.group(1), int(last_match.group(2))\n   372→        return None, None\n   373→\n   374→    def _read_file_snippet(self, filepath: str, line_num: int, context_lines: int = 5) -> str:\n   375→        \"\"\"Read a snippet of a file around the given line number.\"\"\"\n   376→        try:\n   377→            fpath = Path(filepath)\n   378→            if not fpath.is_absolute():\n   379→                fpath = Path(self.target_dir) / filepath\n   380→            if not fpath.exists():\n   381→                return \"\"\n   382→            content = fpath.read_text(errors=\"ignore\")\n   383→            lines = content.split(\"\\n\")\n   384→            start = max(0, line_num - context_lines - 1)\n   385→            end = min(len(lines), line_num + context_lines)\n   386→            numbered = []\n   387→            for i, line in enumerate(lines[start:end], start + 1):\n   388→                marker = \" >> \" if i == line_num else \"    \"\n   389→                numbered.append(f\"{marker}{i:4d} | {line}\")\n   390→            return \"\\n\".join(numbered)\n   391→        except OSError:\n   392→            return \"\"\n   393→\n   394→    def _enrich_task_context(self, task: 'Task') -> None:\n   395→        \"\"\"Populate a task's context with code snippets from file references in its description.\"\"\"\n   396→        # Try primary regex, then fallback\n   397→        match = _FILE_REF_RE.search(task.description)\n   398→        if not match:\n   399→            match = _FILE_REF_FALLBACK_RE.search(task.description)\n   400→        if not match:\n   401→            return\n   402→\n   403→        filepath = match.group(1)\n   404→        line_num = int(match.group(2)) if match.group(2) else 1\n   405→        snippet = self._read_file_snippet(filepath, line_num, context_lines=5)\n   406→        if snippet:\n   407→            task.context = f\"File: {filepath}\\n{snippet}\"\n   408→            task.source_file = filepath\n   409→            if match.group(2):\n   410→                task.line_number = line_num\n   411→\n   412→    def _discover_test_failures(self) -> List[Task]:\n   413→        \"\"\"Run pytest and parse failures.\"\"\"\n   414→        test_cmd = self.config.validation.test_command\n   415→        if not test_cmd.strip():\n   416→            return []\n   417→\n   418→        try:\n   419→            result = run_with_group_kill(\n   420→                test_cmd,\n   421→                shell=True,\n   422→                cwd=self.target_dir,\n   423→                timeout=self.config.validation.test_timeout,\n   424→            )\n   425→        except OSError as e:\n   426→            logger.warning(\"Test discovery failed: %s\", e)\n   427→            return []\n   428→\n   429→        if result.timed_out:\n   430→            logger.warning(\"Test discovery timed out after %ds\", self.config.validation.test_timeout)\n   431→            return []\n   432→\n   433→        if result.returncode == 0:\n   434→            return []\n   435→\n   436→        # Capture full output for context\n   437→        full_output = result.stdout\n   438→        if result.stderr.strip():\n   439→            full_output += \"\\n\" + result.stderr\n   440→\n   441→        # Parse pytest output for FAILED lines\n   442→        tasks = []\n   443→        for line in result.stdout.split(\"\\n\"):\n   444→            line = line.strip()\n   445→            if line.startswith(\"FAILED\"):\n   446→                # e.g. \"FAILED tests/test_foo.py::test_bar - AssertionError: ...\"\n   447→                desc = f\"Fix test failure: {line}\"\n   448→                # Extract test identifier for per-test traceback\n   449→                parts = line.split()\n   450→                test_id = parts[1] if len(parts) > 1 else \"\"\n   451→                per_test_ctx = self._extract_test_traceback(full_output, test_id)\n   452→                # Extract file path and line number from the traceback\n   453→                src_file, src_line = self._extract_traceback_location(per_test_ctx)\n   454→                tasks.append(Task(\n   455→                    description=desc,\n   456→                    priority=2,\n   457→                    source=\"test_failure\",\n   458→                    source_file=src_file,\n   459→                    line_number=src_line,\n   460→                    context=per_test_ctx if per_test_ctx else full_output,\n   461→                ))\n   462→\n   463→        # If we got failures but couldn't parse individual ones, create a generic task\n   464→        if result.returncode != 0 and not tasks:\n   465→            tasks.append(Task(\n   466→                description=f\"Fix test failures (exit code {result.returncode})\",\n   467→                priority=2,\n   468→                source=\"test_failure\",\n   469→                context=full_output,\n   470→            ))\n   471→\n   472→        return tasks\n   473→\n   474→    def _discover_lint_errors(self) -> List[Task]:\n   475→        \"\"\"Run lint command and parse errors.\"\"\"\n   476→        lint_cmd = self.config.validation.lint_command\n   477→        if not lint_cmd.strip():\n   478→            return []\n   479→\n   480→        try:\n   481→            result = run_with_group_kill(\n   482→                lint_cmd,\n   483→                shell=True,\n   484→                cwd=self.target_dir,\n   485→                timeout=self.config.validation.lint_timeout,\n   486→            )\n   487→        except OSError as e:\n   488→            logger.warning(\"Lint discovery failed: %s\", e)\n   489→            return []\n   490→\n   491→        if result.timed_out:\n   492→            logger.warning(\"Lint discovery timed out after %ds\", self.config.validation.lint_timeout)\n   493→            return []\n   494→\n   495→        if result.returncode == 0:\n   496→            return []\n   497→\n   498→        # Try to parse ruff JSON output\n   499→        output = result.stdout.strip()\n   500→        try:\n   501→            errors = json.loads(output)\n   502→            if isinstance(errors, list):\n   503→                tasks = []\n   504→                for err in errors[:10]:  # Cap at 10 lint errors\n   505→                    filename = err.get(\"filename\", \"unknown\")\n   506→                    message = err.get(\"message\", \"lint error\")\n   507→                    code = err.get(\"code\", \"\")\n   508→                    line_num = err.get(\"location\", {}).get(\"row\", 0)\n   509→                    desc = f\"Fix lint error in {filename}: [{code}] {message}\"\n   510→                    # Build context: snippet around the error line\n   511→                    context = \"\"\n   512→                    if line_num > 0:\n   513→                        context = self._read_file_snippet(filename, line_num, context_lines=5)\n   514→                    tasks.append(Task(\n   515→                        description=desc,\n   516→                        priority=2,\n   517→                        source=\"lint\",\n   518→                        source_file=filename,\n   519→                        line_number=line_num if line_num > 0 else None,\n   520→                        context=context,\n   521→                    ))\n   522→                return tasks\n   523→        except (json.JSONDecodeError, TypeError):\n   524→            pass\n   525→\n   526→        # Fallback: generic lint error task\n   527→        return [Task(\n   528→            description=\"Fix lint errors\",\n   529→            priority=2,\n   530→            source=\"lint\",\n   531→        )]\n   532→\n   533→    def _discover_todos(self, timeout: int = TODO_SCAN_TIMEOUT) -> List[Task]:\n   534→        \"\"\"Scan source files for TODO/FIXME/HACK comments.\n   535→\n   536→        Args:\n   537→            timeout: Maximum time in seconds for the file walk operation.\n   538→                     If exceeded, returns whatever tasks were found so far.\n   539→        \"\"\"\n   540→        tasks = []\n   541→        patterns = self.config.discovery.todo_patterns\n   542→        exclude_dirs = set(self.config.discovery.exclude_dirs)\n   543→\n   544→        if not patterns:\n   545→            return []\n   546→\n   547→        escaped = \"|\".join(re.escape(p) for p in patterns)\n   548→        keyword_pat = r\"^\\s*(\" + escaped + r\")\\b\"\n   549→        keyword_re = re.compile(keyword_pat, re.IGNORECASE)\n   550→\n   551→        target = Path(self.target_dir)\n   552→        deadline = time.monotonic() + timeout\n   553→        timed_out = False\n   554→        files_scanned = 0\n   555→        for root, dirs, files in os.walk(target):\n   556→            # Check deadline at the start of each directory\n   557→            if time.monotonic() > deadline:\n   558→                timed_out = True\n   559→                break\n   560→\n   561→            # Filter out excluded directories\n   562→            dirs[:] = [d for d in dirs if d not in exclude_dirs]\n   563→\n   564→            for fname in files:\n   565→                # Check deadline periodically (every file)\n   566→                if time.monotonic() > deadline:\n   567→                    timed_out = True\n   568→                    break\n   569→\n   570→                ext = Path(fname).suffix\n   571→                if ext not in _COMMENT_PREFIXES:\n   572→                    continue\n   573→\n   574→                fpath = Path(root) / fname\n   575→                rel_path = str(fpath.relative_to(target))\n   576→\n   577→                try:\n   578→                    content = fpath.read_text(errors=\"ignore\")\n   579→                except OSError:\n   580→                    continue\n   581→\n   582→                files_scanned += 1\n   583→\n   584→                for i, line in enumerate(content.split(\"\\n\"), 1):\n   585→                    comment_text = _extract_comment_text(line, ext)\n   586→                    if comment_text is None:\n   587→                        continue\n   588→                    match = keyword_re.search(comment_text)\n   589→                    if match:\n   590→                        comment = line.strip()\n   591→                        if len(comment) > 120:\n   592→                            comment = comment[:120] + \"...\"\n   593→                        desc = f\"Address {match.group(1)} in {rel_path}:{i}: {comment}\"\n   594→                        context = self._read_file_snippet(str(fpath), i, context_lines=5)\n   595→                        tasks.append(Task(\n   596→                            description=desc,\n   597→                            priority=3,\n   598→                            source=\"todo\",\n   599→                            source_file=rel_path,\n   600→                            line_number=i,\n   601→                            context=context,\n   602→                        ))\n   603→\n   604→            if timed_out:\n   605→                break\n   606→\n   607→        if timed_out:\n   608→            logger.warning(\n   609→                \"TODO scan timed out after %ds (scanned %d files, found %d tasks)\",\n   610→                timeout, files_scanned, len(tasks),\n   611→            )\n   612→\n   613→        return tasks[:self.config.discovery.max_todo_tasks]\n   614→\n   615→    def _discover_claude_ideas(self) -> List[Task]:\n   616→        \"\"\"Use Claude to analyze the codebase and suggest improvement ideas.\n   617→\n   618→        Invokes Claude CLI in read-only analysis mode with a low max-turns\n   619→        to keep cost down. Parses the response for actionable improvement tasks.\n   620→        \"\"\"\n   621→        # Enforce idea generation cooldown to prevent excessive API costs\n   622→        cooldown = self.config.discovery.idea_cooldown_seconds\n   623→        if cooldown > 0:\n   624→            elapsed = time.time() - self._last_idea_discovery_time\n   625→            if self._last_idea_discovery_time > 0 and elapsed < cooldown:\n   626→                logger.debug(\n   627→                    \"Skipping claude_ideas discovery: %.0fs since last run, \"\n   628→                    \"cooldown is %ds\",\n   629→                    elapsed, cooldown,\n   630→                )\n   631→                return []\n   632→\n   633→        cc = self.config.claude\n   634→        if self.config.discovery.discovery_prompt:\n   635→            focus_section = self.config.discovery.discovery_prompt\n   636→        else:\n   637→            focus_section = (\n   638→                \"- New features or functionality that would add value\\n\"\n   639→                \"- Missing tests for important functionality\\n\"\n   640→                \"- Bug risks or edge cases that could cause failures\\n\"\n   641→                \"- Performance improvements\\n\"\n   642→                \"- Code clarity or maintainability improvements\\n\"\n   643→            )\n   644→\n   645→        history_section = \"\"\n   646→        if self.state_manager:\n   647→            recent = self.state_manager.get_recent_task_summaries(\n   648→                lookback_seconds=86400, max_items=15,\n   649→            )\n   650→            if recent:\n   651→                history_section = (\n   652→                    \"\\nRECENTLY COMPLETED TASKS (do NOT suggest similar improvements):\\n\"\n   653→                    + \"\\n\".join(recent)\n   654→                    + \"\\n\\nFocus on NEW areas that haven't been addressed recently.\\n\"\n   655→                )\n   656→\n   657→        prompt = (\n   658→            \"Analyze the codebase in the current directory. Identify up to 5 concrete, \"\n   659→            \"actionable improvements. Focus on:\\n\"\n   660→            + focus_section\n   661→            + history_section\n   662→            + \"\\nFor each improvement, output EXACTLY one line in this format:\\n\"\n   663→            \"IDEA: <one-sentence description of the improvement>\\n\\n\"\n   664→            \"Do NOT make any changes. Do NOT run git commands. Only analyze and output IDEA lines.\"\n   665→        )\n   666→\n   667→        cmd = [\n   668→            cc.command, \"-p\", prompt,\n   669→            \"--model\", self.config.discovery.discovery_model or self.config.claude.resolved_model,\n   670→            \"--max-turns\", str(self.config.discovery.discovery_max_turns),\n   671→            \"--output-format\", \"json\",\n   672→        ]\n   673→\n   674→        try:\n   675→            result = run_with_group_kill(\n   676→                cmd,\n   677→                cwd=self.target_dir,\n   678→                timeout=self.config.discovery.discovery_timeout,\n   679→            )\n   680→        except (FileNotFoundError, OSError) as e:\n   681→            logger.warning(\"Claude idea discovery failed: %s\", e)\n   682→            return []\n   683→\n   684→        if result is None:\n   685→            logger.warning(\"Claude idea discovery returned no result\")\n   686→            return []\n   687→\n   688→        if result.timed_out:\n   689→            logger.warning(\"Claude idea discovery timed out after %ds\",\n   690→                           self.config.discovery.discovery_timeout)\n   691→            return []\n   692→\n   693→        if result.returncode != 0:\n   694→            logger.warning(\"Claude idea discovery exited with code %d\", result.returncode)\n   695→            return []\n   696→\n   697→        # Parse JSON response to get result text\n   698→        result_text = result.stdout\n   699→\n   700→        # Check for error_max_turns in any JSON line\n   701→        try:\n   702→            for line in result_text.strip().splitlines():\n   703→                stripped = line.strip()\n   704→                if not stripped.startswith(\"{\"):\n   705→                    continue\n   706→                try:\n   707→                    data = json.loads(stripped)\n   708→                    if isinstance(data, dict) and data.get(\"subtype\") == \"error_max_turns\":\n   709→                        logger.warning(\n   710→                            \"Claude idea discovery hit max turns (%d); \"\n   711→                            \"increase discovery.discovery_max_turns\",\n   712→                            self.config.discovery.discovery_max_turns,\n   713→                        )\n   714→                        break\n   715→                except (json.JSONDecodeError, TypeError):\n   716→                    continue\n   717→        except Exception:\n   718→            pass\n   719→\n   720→        # Extract text content from JSON response\n   721→        result_text = _extract_json_text(result_text)\n   722→\n   723→        # Warn if we couldn't extract text from a JSON response\n   724→        if result_text == result.stdout and result.stdout.strip()[:1] in (\"{\", \"[\"):\n   725→            logger.warning(\n   726→                \"Claude idea response contained JSON but no text content \"\n   727→                \"could be extracted — falling back to raw text extraction\"\n   728→            )\n   729→\n   730→        # Extract IDEA lines\n   731→        MIN_IDEA_LENGTH = 10\n   732→        tasks = []\n   733→        for line in result_text.split(\"\\n\"):\n   734→            line = line.strip()\n   735→            if line.upper().startswith(\"IDEA:\"):\n   736→                desc = line[5:].strip()\n   737→                if desc and len(desc) >= MIN_IDEA_LENGTH:\n   738→                    tasks.append(Task(\n   739→                        description=desc,\n   740→                        priority=4,\n   741→                        source=\"claude_idea\",\n   742→                    ))\n   743→                elif desc:\n   744→                    logger.debug(\"Skipping short IDEA line: %r\", desc)\n   745→\n   746→        # Enrich tasks with file context from their descriptions\n   747→        for task in tasks:\n   748→            self._enrich_task_context(task)\n   749→\n   750→        logger.info(\"Claude discovered %d improvement ideas\", len(tasks))\n   751→        if not tasks and result_text.strip():\n   752→            # Attempt fallback extraction from analysis-format text\n   753→            lines = [l.strip() for l in result_text.split(\"\\n\") if l.strip()]\n   754→            for line in lines:\n   755→                # Match numbered items: \"1. ...\", \"2) ...\"\n   756→                m = re.match(r'^\\d+[.)]\\s+(.+)', line)\n   757→                if not m:\n   758→                    # Match bullet items: \"- ...\", \"* ...\", \"• ...\"\n   759→                    m = re.match(r'^[-*•]\\s+(.+)', line)\n   760→                if m:\n   761→                    desc = m.group(1).strip()\n   762→                    if desc and len(desc) >= MIN_IDEA_LENGTH:\n   763→                        tasks.append(Task(\n   764→                            description=desc,\n   765→                            priority=4,\n   766→                            source=\"claude_idea\",\n   767→                        ))\n   768→            # Enrich fallback tasks with file context\n   769→            for task in tasks:\n   770→                self._enrich_task_context(task)\n   771→            if tasks:\n   772→                logger.info(\n   773→                    \"Extracted %d tasks from analysis-format text \"\n   774→                    \"(no IDEA: prefixed lines found, used numbered/bullet fallback).\",\n   775→                    len(tasks),\n   776→                )\n   777→            else:\n   778→                logger.debug(\n   779→                    \"Claude response contained no IDEA lines and no extractable \"\n   780→                    \"analysis-format items (%d non-empty lines)\",\n   781→                    len(lines),\n   782→                )\n   783→        self._last_idea_discovery_time = time.time()\n   784→        return tasks[:5]\n   785→\n   786→    def _discover_coverage_gaps(self) -> List[Task]:\n   787→        \"\"\"Discover files with low test coverage (optional, requires pytest-cov).\"\"\"\n   788→        try:\n   789→            result = run_with_group_kill(\n   790→                \"python3 -m pytest --cov --cov-report=json --cov-report=term -q\",\n   791→                shell=True,\n   792→                cwd=self.target_dir,\n   793→                timeout=self.config.validation.test_timeout,\n   794→            )\n   795→        except OSError:\n   796→            return []\n   797→\n   798→        if result.timed_out:\n   799→            return []\n   800→\n   801→        cov_file = Path(self.target_dir) / \"coverage.json\"\n   802→        if not cov_file.exists():\n   803→            return []\n   804→\n   805→        try:\n   806→            data = json.loads(cov_file.read_text())\n   807→            files = data.get(\"files\", {})\n   808→            tasks = []\n   809→            for fname, info in files.items():\n   810→                pct = info.get(\"summary\", {}).get(\"percent_covered\", 100)\n   811→                if pct < 50:\n   812→                    desc = f\"Improve test coverage for {fname} (currently {pct:.0f}%)\"\n   813→                    tasks.append(Task(\n   814→                        description=desc,\n   815→                        priority=4,\n   816→                        source=\"coverage\",\n   817→                        source_file=fname,\n   818→                    ))\n   819→            return tasks[:10]\n   820→        except (json.JSONDecodeError, OSError):\n   821→            return []\n   822→\n   823→    def _discover_quality_issues(self) -> List[Task]:\n   824→        \"\"\"Review source files for general quality issues.\"\"\"\n   825→        tasks = []\n   826→        target = Path(self.target_dir)\n   827→        exclude_dirs = set(self.config.discovery.exclude_dirs)\n   828→\n   829→        for root, dirs, files in os.walk(target):\n   830→            dirs[:] = [d for d in dirs if d not in exclude_dirs]\n   831→\n   832→            for fname in files:\n   833→                if not fname.endswith(\".py\"):\n   834→                    continue\n   835→\n   836→                fpath = Path(root) / fname\n   837→                rel_path = str(fpath.relative_to(target))\n   838→\n   839→                try:\n   840→                    content = fpath.read_text(errors=\"ignore\")\n   841→                except OSError:\n   842→                    continue\n   843→\n   844→                lines = content.split(\"\\n\")\n   845→                # Flag very long files\n   846→                if len(lines) > 500:\n   847→                    tasks.append(Task(\n   848→                        description=f\"Review and potentially refactor {rel_path} ({len(lines)} lines)\",\n   849→                        priority=5,\n   850→                        source=\"quality\",\n   851→                        source_file=rel_path,\n   852→                    ))\n   853→\n   854→        return tasks[:5]\n   855→\n   856→    def _discover_complexity_issues(self) -> List[Task]:\n   857→        \"\"\"Scan Python files for functions longer than 50 lines using ast.parse.\"\"\"\n   858→        tasks: List[Task] = []\n   859→        target = Path(self.target_dir)\n   860→        exclude_dirs = set(self.config.discovery.exclude_dirs)\n   861→\n   862→        for root, dirs, files in os.walk(target):\n   863→            dirs[:] = [d for d in dirs if d not in exclude_dirs]\n   864→\n   865→            for fname in files:\n   866→                if not fname.endswith(\".py\"):\n   867→                    continue\n   868→\n   869→                fpath = Path(root) / fname\n   870→                rel_path = str(fpath.relative_to(target))\n   871→\n   872→                try:\n   873→                    source = fpath.read_text(errors=\"ignore\")\n   874→                    tree = ast.parse(source, filename=rel_path)\n   875→                except (OSError, SyntaxError):\n   876→                    continue\n   877→\n   878→                for node in ast.walk(tree):\n   879→                    if not isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):\n   880→                        continue\n   881→                    start = node.lineno\n   882→                    end = node.end_lineno\n   883→                    if end is None:\n   884→                        continue\n   885→                    line_count = end - start + 1\n   886→                    if line_count > 50:\n   887→                        desc = (\n   888→                            f\"Refactor long function `{node.name}` in \"\n   889→                            f\"`{rel_path}:{start}` ({line_count} lines)\"\n   890→                        )\n   891→                        tasks.append(Task(\n   892→                            description=desc,\n   893→                            priority=5,\n   894→                            source=\"quality\",\n   895→                            source_file=rel_path,\n   896→                            line_number=start,\n   897→                        ))\n   898→\n   899→                if len(tasks) >= 5:\n   900→                    return tasks[:5]\n   901→\n   902→        return tasks[:5]\n   903→"}]},"parent_tool_use_id":null,"session_id":"88780ef9-89c7-4f24-bc8c-c264c3a55a21","uuid":"36fdbffc-f638-44a2-905f-d855e416eda7","tool_use_result":{"type":"text","file":{"filePath":"/Users/sameertkhanna/Documents/auto_claude_code/task_discovery.py","content":"\"\"\"Auto-discover tasks from the target project (test failures, lint, TODOs, etc.).\"\"\"\n\nfrom __future__ import annotations\n\nimport ast\nimport json\nimport logging\nimport os\nimport re\nimport time\nfrom dataclasses import dataclass, field\nfrom pathlib import Path\nfrom typing import List, Optional\n\nfrom config_schema import Config\nfrom process_utils import run_with_group_kill\n\nlogger = logging.getLogger(__name__)\n\n\ndef _extract_json_text(raw_output: str) -> str:\n    \"\"\"Extract text content from Claude CLI JSON output.\n\n    Parses JSON objects from the raw output using multiple strategies\n    (line-by-line, multi-line, raw_decode) and extracts the 'result' or\n    'result_text' field.  Returns the extracted text, or the original\n    raw_output if extraction fails.\n\n    This is a shared utility that reduces duplication between\n    task_discovery._discover_claude_ideas() and\n    claude_runner._parse_json_response().\n    \"\"\"\n    def _text_from_dict(d: dict) -> str:\n        for key in (\"result\", \"result_text\"):\n            val = d.get(key)\n            if isinstance(val, str) and val.strip():\n                return val\n        return \"\"\n\n    try:\n        lines = raw_output.strip().splitlines()\n\n        # Strategy 1: Try each line individually as a complete JSON object\n        for line in lines:\n            stripped = line.strip()\n            if not stripped.startswith(\"{\"):\n                continue\n            try:\n                data = json.loads(stripped)\n                if isinstance(data, dict):\n                    text = _text_from_dict(data)\n                    if text:\n                        return text\n            except (json.JSONDecodeError, TypeError):\n                continue\n\n        # Strategy 2: Try multi-line JSON joining from each '{'-starting line\n        for i, line in enumerate(lines):\n            if not line.strip().startswith(\"{\"):\n                continue\n            try:\n                data = json.loads(\"\\n\".join(lines[i:]))\n                if isinstance(data, dict):\n                    text = _text_from_dict(data)\n                    if text:\n                        return text\n            except (json.JSONDecodeError, TypeError):\n                continue\n\n        # Strategy 3: Use raw_decode to find JSON anywhere in the output\n        decoder = json.JSONDecoder()\n        for i, ch in enumerate(raw_output):\n            if ch != \"{\":\n                continue\n            try:\n                obj, _ = decoder.raw_decode(raw_output, i)\n                if isinstance(obj, dict):\n                    text = _text_from_dict(obj)\n                    if text:\n                        return text\n            except (json.JSONDecodeError, TypeError):\n                continue\n    except Exception:\n        pass\n\n    return raw_output\n\n\n# Map file extensions to their comment prefix styles\n_COMMENT_PREFIXES = {\n    \".py\": (\"#\",), \".rb\": (\"#\",),\n    \".js\": (\"//\", \"/*\"), \".ts\": (\"//\", \"/*\"),\n    \".jsx\": (\"//\", \"/*\"), \".tsx\": (\"//\", \"/*\"),\n    \".go\": (\"//\", \"/*\"), \".rs\": (\"//\", \"/*\"),\n    \".java\": (\"//\", \"/*\"),\n}\n\n# Regex to match string literals (double-quoted and single-quoted, with escapes)\n_STRING_LITERAL_RE = re.compile(r'''\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^'\\\\]|\\\\.)*' '''.strip())\n\nMAX_TASK_DESCRIPTION_LENGTH = 2000\nMAX_TASK_CONTEXT_LENGTH = 12000\n\n# Default timeout for _discover_todos file walk (seconds)\nTODO_SCAN_TIMEOUT = 60\n\n_FILE_REF_RE = re.compile(\n    r'`([a-zA-Z0-9_/.\\-]+\\.(?:py|js|ts|tsx|jsx|go|rs|java|rb|sh|yaml|yml|json|md|txt))'\n    r'(?::(\\d+))?(?:-\\d+)?`'\n)\n_FILE_REF_FALLBACK_RE = re.compile(\n    r'(?:in\\s+|for\\s+)([a-zA-Z0-9_/.\\-]+\\.(?:py|js|ts|tsx|jsx|go|rs|java|rb|sh|yaml|yml|json|md|txt))'\n    r'(?::(\\d+))?'\n)\n\n\ndef _sanitize_description(desc: str) -> str:\n    \"\"\"Sanitize a task description: strip, collapse newlines, and truncate.\"\"\"\n    desc = desc.strip()\n    desc = desc.replace(\"\\n\", \" \").replace(\"\\r\", \" \")\n    if len(desc) > MAX_TASK_DESCRIPTION_LENGTH:\n        desc = desc[:MAX_TASK_DESCRIPTION_LENGTH] + \"...\"\n    return desc\n\n\ndef _extract_comment_text(line: str, ext: str) -> Optional[str]:\n    \"\"\"Strip string literals from *line*, then return the comment body if a\n    comment prefix for *ext* is found.  Returns ``None`` when no comment is\n    detected.\"\"\"\n    prefixes = _COMMENT_PREFIXES.get(ext)\n    if not prefixes:\n        return None\n\n    # Remove string literals so that a '#' or '//' inside a string is ignored\n    stripped = _STRING_LITERAL_RE.sub(\"\", line)\n\n    # Find the earliest comment prefix in the stripped line\n    earliest_pos = None\n    earliest_prefix = None\n    for pfx in prefixes:\n        pos = stripped.find(pfx)\n        if pos != -1 and (earliest_pos is None or pos < earliest_pos):\n            earliest_pos = pos\n            earliest_prefix = pfx\n\n    if earliest_pos is None:\n        return None\n\n    # Return the text after the comment prefix\n    return stripped[earliest_pos + len(earliest_prefix):]\n\n\n@dataclass\nclass Task:\n    description: str\n    priority: int  # 1 = highest (feedback), 5 = lowest (quality review)\n    source: str  # \"test_failure\", \"lint\", \"todo\", \"coverage\", \"quality\", \"feedback\"\n    source_file: Optional[str] = None  # file path for feedback tasks\n    line_number: Optional[int] = None\n    context: str = \"\"  # rich context: tracebacks, file snippets, error details\n    task_id: str = \"\"\n    depends_on: List[str] = field(default_factory=list)\n\n    def __post_init__(self):\n        self.description = _sanitize_description(self.description)\n        if len(self.context) > MAX_TASK_CONTEXT_LENGTH:\n            self.context = self.context[:MAX_TASK_CONTEXT_LENGTH] + \"\\n... (truncated)\"\n        if not self.task_id:\n            self.task_id = self.task_key\n\n    @property\n    def task_key(self) -> str:\n        \"\"\"Stable dedup key — same underlying issue produces the same key.\"\"\"\n        if self.source == \"todo\" and self.source_file:\n            if self.line_number is not None:\n                return f\"todo:{self.source_file}:{self.line_number}\"\n            return f\"todo:{self.source_file}\"\n\n        if self.source in (\"lint\", \"test_failure\", \"quality\", \"coverage\") and self.source_file:\n            return f\"{self.source}:{self.source_file}\"\n\n        if self.source == \"coverage\":\n            match = re.search(r'for\\s+(\\S+)', self.description)\n            if match:\n                return f\"coverage:{match.group(1)}\"\n\n        if self.source == \"claude_idea\":\n            match = _FILE_REF_RE.search(self.description)\n            if match:\n                return f\"claude_idea:{match.group(1)}\"\n            match = _FILE_REF_FALLBACK_RE.search(self.description)\n            if match:\n                return f\"claude_idea:{match.group(1)}\"\n            return f\"claude_idea:{self.description[:60]}\"\n\n        if self.source == \"feedback\" and self.source_file:\n            return f\"feedback:{self.source_file}\"\n\n        if self.source == \"test_failure\":\n            match = re.search(r'FAILED\\s+(\\S+)', self.description)\n            if match:\n                return f\"test_failure:{match.group(1)}\"\n\n        return f\"{self.source}:{self.description}\"\n\n\nclass TaskDiscovery:\n    def __init__(self, config: Config, state_manager=None):\n        self.config = config\n        self.target_dir = config.target_dir\n        self.state_manager = state_manager\n        self._last_idea_discovery_time: float = 0.0\n\n    def discover_all(self) -> List[Task]:\n        \"\"\"Run all enabled discovery strategies and return sorted tasks.\"\"\"\n        tasks: List[Task] = []\n        dc = self.config.discovery\n\n        if dc.enable_test_failures:\n            tasks.extend(self._discover_test_failures())\n\n        if dc.enable_lint_errors:\n            tasks.extend(self._discover_lint_errors())\n\n        if dc.enable_todos:\n            tasks.extend(self._discover_todos())\n\n        if dc.enable_coverage:\n            tasks.extend(self._discover_coverage_gaps())\n\n        if dc.enable_claude_ideas:\n            tasks.extend(self._discover_claude_ideas())\n\n        if dc.enable_quality_review:\n            tasks.extend(self._discover_quality_issues())\n\n        if dc.enable_complexity_check:\n            tasks.extend(self._discover_complexity_issues())\n\n        # Group related tasks to avoid duplicate work\n        tasks = self._group_related_tasks(tasks)\n\n        # Boost priority for historically high-success-rate sources\n        if self.state_manager and dc.adaptive_priority and tasks:\n            try:\n                performance = self.state_manager.get_strategy_performance(lookback_seconds=86400)\n                if performance:\n                    for task in tasks:\n                        perf = performance.get(task.source)\n                        if perf and perf.get(\"total\", 0) >= 2:\n                            success_rate = perf.get(\"success_rate\", 0.0)\n                            if success_rate > 0.5:\n                                # Higher success rate -> lower priority number (higher priority)\n                                # e.g., 90% success -> priority reduced by 2\n                                boost = int(success_rate * 3)  # 0-3 boost\n                                task.priority = max(1, task.priority - boost)\n            except Exception as e:\n                logger.debug(\"Strategy performance boosting failed: %s\", e)\n\n        # Sort by priority (lower number = higher priority)\n        tasks.sort(key=lambda t: t.priority)\n        return tasks\n\n    def _group_related_tasks(self, tasks: List[Task]) -> List[Task]:\n        \"\"\"Group related tasks by file path to avoid duplicate work.\n\n        When multiple tasks share the same source file (e.g., multiple test\n        failures in the same file, or multiple lint errors in the same file),\n        they likely share a root cause. This method keeps only the first\n        (highest-priority) task per file for each source type, reducing\n        wasted cycles on tasks that will auto-resolve when the root cause\n        is fixed.\n\n        Tasks without a source_file are always kept.\n        \"\"\"\n        from collections import defaultdict\n\n        # Group by (source, source_file) — only group when source_file is set\n        grouped: dict = defaultdict(list)\n        ungrouped: List[Task] = []\n\n        for task in tasks:\n            if task.source_file and task.source in (\"test_failure\", \"lint\", \"todo\"):\n                key = (task.source, task.source_file)\n                grouped[key].append(task)\n            else:\n                ungrouped.append(task)\n\n        result: List[Task] = list(ungrouped)\n        for key, group in grouped.items():\n            # Sort by priority (lower = better), keep the representative task\n            group.sort(key=lambda t: t.priority)\n            representative = group[0]\n            if len(group) > 1:\n                # Enrich the representative's description with count\n                representative.description = (\n                    f\"{representative.description} \"\n                    f\"(+{len(group) - 1} related in {key[1]})\"\n                )\n            result.append(representative)\n\n        return result\n\n    # Regex to extract file path and line number from pytest traceback lines\n    # Matches patterns like \"tests/test_foo.py:5: AssertionError\"\n    _TRACEBACK_LOC_RE = re.compile(\n        r'^(\\S+\\.py):(\\d+):\\s+\\w+(?:Error|Exception|Warning)'\n    )\n\n    def _extract_test_traceback(self, full_output: str, test_id: str) -> str:\n        \"\"\"Extract the traceback section for a specific test from pytest output.\n\n        Includes assertion details (lines starting with 'E') and ensures the\n        last 5 lines of the traceback are always present.\n        \"\"\"\n        if not test_id:\n            return \"\"\n        lines = full_output.split(\"\\n\")\n        collecting = False\n        result_lines: List[str] = []\n        assertion_lines: List[str] = []\n        for line in lines:\n            if test_id in line and (\"FAILED\" in line or \"ERROR\" in line or \"___\" in line):\n                collecting = True\n                result_lines = [line]\n                assertion_lines = []\n                continue\n            if collecting:\n                if (line.startswith(\"___\") and test_id not in line) or \\\n                   line.startswith(\"=\") or \\\n                   (line.startswith(\"FAILED \") and test_id not in line):\n                    break\n                result_lines.append(line)\n                # Collect assertion detail lines (pytest prefixes them with 'E')\n                stripped = line.lstrip()\n                if stripped.startswith(\"E \") or stripped.startswith(\"E\\t\"):\n                    assertion_lines.append(line)\n\n        if not result_lines:\n            return \"\"\n\n        # Ensure the last 5 lines of the traceback are included\n        # (they typically contain the assertion and location info)\n        traceback_text = \"\\n\".join(result_lines)\n        if len(result_lines) > 5:\n            last_5 = \"\\n\".join(result_lines[-5:])\n            # If assertion lines exist but aren't in last 5 lines, append them\n            if assertion_lines:\n                for aline in assertion_lines:\n                    if aline not in result_lines[-5:]:\n                        traceback_text += \"\\n\" + aline\n\n        return traceback_text\n\n    def _extract_traceback_location(self, traceback_text: str) -> tuple:\n        \"\"\"Extract file path and line number from a pytest traceback.\n\n        Returns (source_file, line_number) or (None, None) if not found.\n        \"\"\"\n        if not traceback_text:\n            return None, None\n        # Search for the last file:line pattern in the traceback\n        # (the last one is typically the failing assertion location)\n        last_match = None\n        for line in traceback_text.split(\"\\n\"):\n            line = line.strip()\n            m = self._TRACEBACK_LOC_RE.match(line)\n            if m:\n                last_match = m\n        if last_match:\n            return last_match.group(1), int(last_match.group(2))\n        return None, None\n\n    def _read_file_snippet(self, filepath: str, line_num: int, context_lines: int = 5) -> str:\n        \"\"\"Read a snippet of a file around the given line number.\"\"\"\n        try:\n            fpath = Path(filepath)\n            if not fpath.is_absolute():\n                fpath = Path(self.target_dir) / filepath\n            if not fpath.exists():\n                return \"\"\n            content = fpath.read_text(errors=\"ignore\")\n            lines = content.split(\"\\n\")\n            start = max(0, line_num - context_lines - 1)\n            end = min(len(lines), line_num + context_lines)\n            numbered = []\n            for i, line in enumerate(lines[start:end], start + 1):\n                marker = \" >> \" if i == line_num else \"    \"\n                numbered.append(f\"{marker}{i:4d} | {line}\")\n            return \"\\n\".join(numbered)\n        except OSError:\n            return \"\"\n\n    def _enrich_task_context(self, task: 'Task') -> None:\n        \"\"\"Populate a task's context with code snippets from file references in its description.\"\"\"\n        # Try primary regex, then fallback\n        match = _FILE_REF_RE.search(task.description)\n        if not match:\n            match = _FILE_REF_FALLBACK_RE.search(task.description)\n        if not match:\n            return\n\n        filepath = match.group(1)\n        line_num = int(match.group(2)) if match.group(2) else 1\n        snippet = self._read_file_snippet(filepath, line_num, context_lines=5)\n        if snippet:\n            task.context = f\"File: {filepath}\\n{snippet}\"\n            task.source_file = filepath\n            if match.group(2):\n                task.line_number = line_num\n\n    def _discover_test_failures(self) -> List[Task]:\n        \"\"\"Run pytest and parse failures.\"\"\"\n        test_cmd = self.config.validation.test_command\n        if not test_cmd.strip():\n            return []\n\n        try:\n            result = run_with_group_kill(\n                test_cmd,\n                shell=True,\n                cwd=self.target_dir,\n                timeout=self.config.validation.test_timeout,\n            )\n        except OSError as e:\n            logger.warning(\"Test discovery failed: %s\", e)\n            return []\n\n        if result.timed_out:\n            logger.warning(\"Test discovery timed out after %ds\", self.config.validation.test_timeout)\n            return []\n\n        if result.returncode == 0:\n            return []\n\n        # Capture full output for context\n        full_output = result.stdout\n        if result.stderr.strip():\n            full_output += \"\\n\" + result.stderr\n\n        # Parse pytest output for FAILED lines\n        tasks = []\n        for line in result.stdout.split(\"\\n\"):\n            line = line.strip()\n            if line.startswith(\"FAILED\"):\n                # e.g. \"FAILED tests/test_foo.py::test_bar - AssertionError: ...\"\n                desc = f\"Fix test failure: {line}\"\n                # Extract test identifier for per-test traceback\n                parts = line.split()\n                test_id = parts[1] if len(parts) > 1 else \"\"\n                per_test_ctx = self._extract_test_traceback(full_output, test_id)\n                # Extract file path and line number from the traceback\n                src_file, src_line = self._extract_traceback_location(per_test_ctx)\n                tasks.append(Task(\n                    description=desc,\n                    priority=2,\n                    source=\"test_failure\",\n                    source_file=src_file,\n                    line_number=src_line,\n                    context=per_test_ctx if per_test_ctx else full_output,\n                ))\n\n        # If we got failures but couldn't parse individual ones, create a generic task\n        if result.returncode != 0 and not tasks:\n            tasks.append(Task(\n                description=f\"Fix test failures (exit code {result.returncode})\",\n                priority=2,\n                source=\"test_failure\",\n                context=full_output,\n            ))\n\n        return tasks\n\n    def _discover_lint_errors(self) -> List[Task]:\n        \"\"\"Run lint command and parse errors.\"\"\"\n        lint_cmd = self.config.validation.lint_command\n        if not lint_cmd.strip():\n            return []\n\n        try:\n            result = run_with_group_kill(\n                lint_cmd,\n                shell=True,\n                cwd=self.target_dir,\n                timeout=self.config.validation.lint_timeout,\n            )\n        except OSError as e:\n            logger.warning(\"Lint discovery failed: %s\", e)\n            return []\n\n        if result.timed_out:\n            logger.warning(\"Lint discovery timed out after %ds\", self.config.validation.lint_timeout)\n            return []\n\n        if result.returncode == 0:\n            return []\n\n        # Try to parse ruff JSON output\n        output = result.stdout.strip()\n        try:\n            errors = json.loads(output)\n            if isinstance(errors, list):\n                tasks = []\n                for err in errors[:10]:  # Cap at 10 lint errors\n                    filename = err.get(\"filename\", \"unknown\")\n                    message = err.get(\"message\", \"lint error\")\n                    code = err.get(\"code\", \"\")\n                    line_num = err.get(\"location\", {}).get(\"row\", 0)\n                    desc = f\"Fix lint error in {filename}: [{code}] {message}\"\n                    # Build context: snippet around the error line\n                    context = \"\"\n                    if line_num > 0:\n                        context = self._read_file_snippet(filename, line_num, context_lines=5)\n                    tasks.append(Task(\n                        description=desc,\n                        priority=2,\n                        source=\"lint\",\n                        source_file=filename,\n                        line_number=line_num if line_num > 0 else None,\n                        context=context,\n                    ))\n                return tasks\n        except (json.JSONDecodeError, TypeError):\n            pass\n\n        # Fallback: generic lint error task\n        return [Task(\n            description=\"Fix lint errors\",\n            priority=2,\n            source=\"lint\",\n        )]\n\n    def _discover_todos(self, timeout: int = TODO_SCAN_TIMEOUT) -> List[Task]:\n        \"\"\"Scan source files for TODO/FIXME/HACK comments.\n\n        Args:\n            timeout: Maximum time in seconds for the file walk operation.\n                     If exceeded, returns whatever tasks were found so far.\n        \"\"\"\n        tasks = []\n        patterns = self.config.discovery.todo_patterns\n        exclude_dirs = set(self.config.discovery.exclude_dirs)\n\n        if not patterns:\n            return []\n\n        escaped = \"|\".join(re.escape(p) for p in patterns)\n        keyword_pat = r\"^\\s*(\" + escaped + r\")\\b\"\n        keyword_re = re.compile(keyword_pat, re.IGNORECASE)\n\n        target = Path(self.target_dir)\n        deadline = time.monotonic() + timeout\n        timed_out = False\n        files_scanned = 0\n        for root, dirs, files in os.walk(target):\n            # Check deadline at the start of each directory\n            if time.monotonic() > deadline:\n                timed_out = True\n                break\n\n            # Filter out excluded directories\n            dirs[:] = [d for d in dirs if d not in exclude_dirs]\n\n            for fname in files:\n                # Check deadline periodically (every file)\n                if time.monotonic() > deadline:\n                    timed_out = True\n                    break\n\n                ext = Path(fname).suffix\n                if ext not in _COMMENT_PREFIXES:\n                    continue\n\n                fpath = Path(root) / fname\n                rel_path = str(fpath.relative_to(target))\n\n                try:\n                    content = fpath.read_text(errors=\"ignore\")\n                except OSError:\n                    continue\n\n                files_scanned += 1\n\n                for i, line in enumerate(content.split(\"\\n\"), 1):\n                    comment_text = _extract_comment_text(line, ext)\n                    if comment_text is None:\n                        continue\n                    match = keyword_re.search(comment_text)\n                    if match:\n                        comment = line.strip()\n                        if len(comment) > 120:\n                            comment = comment[:120] + \"...\"\n                        desc = f\"Address {match.group(1)} in {rel_path}:{i}: {comment}\"\n                        context = self._read_file_snippet(str(fpath), i, context_lines=5)\n                        tasks.append(Task(\n                            description=desc,\n                            priority=3,\n                            source=\"todo\",\n                            source_file=rel_path,\n                            line_number=i,\n                            context=context,\n                        ))\n\n            if timed_out:\n                break\n\n        if timed_out:\n            logger.warning(\n                \"TODO scan timed out after %ds (scanned %d files, found %d tasks)\",\n                timeout, files_scanned, len(tasks),\n            )\n\n        return tasks[:self.config.discovery.max_todo_tasks]\n\n    def _discover_claude_ideas(self) -> List[Task]:\n        \"\"\"Use Claude to analyze the codebase and suggest improvement ideas.\n\n        Invokes Claude CLI in read-only analysis mode with a low max-turns\n        to keep cost down. Parses the response for actionable improvement tasks.\n        \"\"\"\n        # Enforce idea generation cooldown to prevent excessive API costs\n        cooldown = self.config.discovery.idea_cooldown_seconds\n        if cooldown > 0:\n            elapsed = time.time() - self._last_idea_discovery_time\n            if self._last_idea_discovery_time > 0 and elapsed < cooldown:\n                logger.debug(\n                    \"Skipping claude_ideas discovery: %.0fs since last run, \"\n                    \"cooldown is %ds\",\n                    elapsed, cooldown,\n                )\n                return []\n\n        cc = self.config.claude\n        if self.config.discovery.discovery_prompt:\n            focus_section = self.config.discovery.discovery_prompt\n        else:\n            focus_section = (\n                \"- New features or functionality that would add value\\n\"\n                \"- Missing tests for important functionality\\n\"\n                \"- Bug risks or edge cases that could cause failures\\n\"\n                \"- Performance improvements\\n\"\n                \"- Code clarity or maintainability improvements\\n\"\n            )\n\n        history_section = \"\"\n        if self.state_manager:\n            recent = self.state_manager.get_recent_task_summaries(\n                lookback_seconds=86400, max_items=15,\n            )\n            if recent:\n                history_section = (\n                    \"\\nRECENTLY COMPLETED TASKS (do NOT suggest similar improvements):\\n\"\n                    + \"\\n\".join(recent)\n                    + \"\\n\\nFocus on NEW areas that haven't been addressed recently.\\n\"\n                )\n\n        prompt = (\n            \"Analyze the codebase in the current directory. Identify up to 5 concrete, \"\n            \"actionable improvements. Focus on:\\n\"\n            + focus_section\n            + history_section\n            + \"\\nFor each improvement, output EXACTLY one line in this format:\\n\"\n            \"IDEA: <one-sentence description of the improvement>\\n\\n\"\n            \"Do NOT make any changes. Do NOT run git commands. Only analyze and output IDEA lines.\"\n        )\n\n        cmd = [\n            cc.command, \"-p\", prompt,\n            \"--model\", self.config.discovery.discovery_model or self.config.claude.resolved_model,\n            \"--max-turns\", str(self.config.discovery.discovery_max_turns),\n            \"--output-format\", \"json\",\n        ]\n\n        try:\n            result = run_with_group_kill(\n                cmd,\n                cwd=self.target_dir,\n                timeout=self.config.discovery.discovery_timeout,\n            )\n        except (FileNotFoundError, OSError) as e:\n            logger.warning(\"Claude idea discovery failed: %s\", e)\n            return []\n\n        if result is None:\n            logger.warning(\"Claude idea discovery returned no result\")\n            return []\n\n        if result.timed_out:\n            logger.warning(\"Claude idea discovery timed out after %ds\",\n                           self.config.discovery.discovery_timeout)\n            return []\n\n        if result.returncode != 0:\n            logger.warning(\"Claude idea discovery exited with code %d\", result.returncode)\n            return []\n\n        # Parse JSON response to get result text\n        result_text = result.stdout\n\n        # Check for error_max_turns in any JSON line\n        try:\n            for line in result_text.strip().splitlines():\n                stripped = line.strip()\n                if not stripped.startswith(\"{\"):\n                    continue\n                try:\n                    data = json.loads(stripped)\n                    if isinstance(data, dict) and data.get(\"subtype\") == \"error_max_turns\":\n                        logger.warning(\n                            \"Claude idea discovery hit max turns (%d); \"\n                            \"increase discovery.discovery_max_turns\",\n                            self.config.discovery.discovery_max_turns,\n                        )\n                        break\n                except (json.JSONDecodeError, TypeError):\n                    continue\n        except Exception:\n            pass\n\n        # Extract text content from JSON response\n        result_text = _extract_json_text(result_text)\n\n        # Warn if we couldn't extract text from a JSON response\n        if result_text == result.stdout and result.stdout.strip()[:1] in (\"{\", \"[\"):\n            logger.warning(\n                \"Claude idea response contained JSON but no text content \"\n                \"could be extracted — falling back to raw text extraction\"\n            )\n\n        # Extract IDEA lines\n        MIN_IDEA_LENGTH = 10\n        tasks = []\n        for line in result_text.split(\"\\n\"):\n            line = line.strip()\n            if line.upper().startswith(\"IDEA:\"):\n                desc = line[5:].strip()\n                if desc and len(desc) >= MIN_IDEA_LENGTH:\n                    tasks.append(Task(\n                        description=desc,\n                        priority=4,\n                        source=\"claude_idea\",\n                    ))\n                elif desc:\n                    logger.debug(\"Skipping short IDEA line: %r\", desc)\n\n        # Enrich tasks with file context from their descriptions\n        for task in tasks:\n            self._enrich_task_context(task)\n\n        logger.info(\"Claude discovered %d improvement ideas\", len(tasks))\n        if not tasks and result_text.strip():\n            # Attempt fallback extraction from analysis-format text\n            lines = [l.strip() for l in result_text.split(\"\\n\") if l.strip()]\n            for line in lines:\n                # Match numbered items: \"1. ...\", \"2) ...\"\n                m = re.match(r'^\\d+[.)]\\s+(.+)', line)\n                if not m:\n                    # Match bullet items: \"- ...\", \"* ...\", \"• ...\"\n                    m = re.match(r'^[-*•]\\s+(.+)', line)\n                if m:\n                    desc = m.group(1).strip()\n                    if desc and len(desc) >= MIN_IDEA_LENGTH:\n                        tasks.append(Task(\n                            description=desc,\n                            priority=4,\n                            source=\"claude_idea\",\n                        ))\n            # Enrich fallback tasks with file context\n            for task in tasks:\n                self._enrich_task_context(task)\n            if tasks:\n                logger.info(\n                    \"Extracted %d tasks from analysis-format text \"\n                    \"(no IDEA: prefixed lines found, used numbered/bullet fallback).\",\n                    len(tasks),\n                )\n            else:\n                logger.debug(\n                    \"Claude response contained no IDEA lines and no extractable \"\n                    \"analysis-format items (%d non-empty lines)\",\n                    len(lines),\n                )\n        self._last_idea_discovery_time = time.time()\n        return tasks[:5]\n\n    def _discover_coverage_gaps(self) -> List[Task]:\n        \"\"\"Discover files with low test coverage (optional, requires pytest-cov).\"\"\"\n        try:\n            result = run_with_group_kill(\n                \"python3 -m pytest --cov --cov-report=json --cov-report=term -q\",\n                shell=True,\n                cwd=self.target_dir,\n                timeout=self.config.validation.test_timeout,\n            )\n        except OSError:\n            return []\n\n        if result.timed_out:\n            return []\n\n        cov_file = Path(self.target_dir) / \"coverage.json\"\n        if not cov_file.exists():\n            return []\n\n        try:\n            data = json.loads(cov_file.read_text())\n            files = data.get(\"files\", {})\n            tasks = []\n            for fname, info in files.items():\n                pct = info.get(\"summary\", {}).get(\"percent_covered\", 100)\n                if pct < 50:\n                    desc = f\"Improve test coverage for {fname} (currently {pct:.0f}%)\"\n                    tasks.append(Task(\n                        description=desc,\n                        priority=4,\n                        source=\"coverage\",\n                        source_file=fname,\n                    ))\n            return tasks[:10]\n        except (json.JSONDecodeError, OSError):\n            return []\n\n    def _discover_quality_issues(self) -> List[Task]:\n        \"\"\"Review source files for general quality issues.\"\"\"\n        tasks = []\n        target = Path(self.target_dir)\n        exclude_dirs = set(self.config.discovery.exclude_dirs)\n\n        for root, dirs, files in os.walk(target):\n            dirs[:] = [d for d in dirs if d not in exclude_dirs]\n\n            for fname in files:\n                if not fname.endswith(\".py\"):\n                    continue\n\n                fpath = Path(root) / fname\n                rel_path = str(fpath.relative_to(target))\n\n                try:\n                    content = fpath.read_text(errors=\"ignore\")\n                except OSError:\n                    continue\n\n                lines = content.split(\"\\n\")\n                # Flag very long files\n                if len(lines) > 500:\n                    tasks.append(Task(\n                        description=f\"Review and potentially refactor {rel_path} ({len(lines)} lines)\",\n                        priority=5,\n                        source=\"quality\",\n                        source_file=rel_path,\n                    ))\n\n        return tasks[:5]\n\n    def _discover_complexity_issues(self) -> List[Task]:\n        \"\"\"Scan Python files for functions longer than 50 lines using ast.parse.\"\"\"\n        tasks: List[Task] = []\n        target = Path(self.target_dir)\n        exclude_dirs = set(self.config.discovery.exclude_dirs)\n\n        for root, dirs, files in os.walk(target):\n            dirs[:] = [d for d in dirs if d not in exclude_dirs]\n\n            for fname in files:\n                if not fname.endswith(\".py\"):\n                    continue\n\n                fpath = Path(root) / fname\n                rel_path = str(fpath.relative_to(target))\n\n                try:\n                    source = fpath.read_text(errors=\"ignore\")\n                    tree = ast.parse(source, filename=rel_path)\n                except (OSError, SyntaxError):\n                    continue\n\n                for node in ast.walk(tree):\n                    if not isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):\n                        continue\n                    start = node.lineno\n                    end = node.end_lineno\n                    if end is None:\n                        continue\n                    line_count = end - start + 1\n                    if line_count > 50:\n                        desc = (\n                            f\"Refactor long function `{node.name}` in \"\n                            f\"`{rel_path}:{start}` ({line_count} lines)\"\n                        )\n                        tasks.append(Task(\n                            description=desc,\n                            priority=5,\n                            source=\"quality\",\n                            source_file=rel_path,\n                            line_number=start,\n                        ))\n\n                if len(tasks) >= 5:\n                    return tasks[:5]\n\n        return tasks[:5]\n","numLines":903,"startLine":1,"totalLines":903}}}
