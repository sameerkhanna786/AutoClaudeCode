{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_vrtx_01Saa99aKaLW6dLemD1YuWek","type":"tool_result","content":"   120→        assert all(t.source == \"claude_idea\" for t in tasks)\n   121→        assert \"input validation\" in tasks[0].description.lower()\n   122→        assert \"retry\" in tasks[1].description.lower()\n   123→\n   124→    @patch(\"task_discovery.run_with_group_kill\")\n   125→    def test_discover_claude_ideas_timeout(self, mock_run, discovery):\n   126→        discovery.config.discovery.enable_claude_ideas = True\n   127→        mock_run.return_value = _run_result(timed_out=True, returncode=-1)\n   128→        tasks = discovery._discover_claude_ideas()\n   129→        assert tasks == []\n   130→\n   131→    @patch(\"task_discovery.run_with_group_kill\")\n   132→    def test_discover_claude_ideas_failure(self, mock_run, discovery):\n   133→        discovery.config.discovery.enable_claude_ideas = True\n   134→        mock_run.return_value = _run_result(returncode=1, stderr=\"error\")\n   135→        tasks = discovery._discover_claude_ideas()\n   136→        assert tasks == []\n   137→\n   138→    @patch(\"task_discovery.run_with_group_kill\")\n   139→    def test_discover_claude_ideas_no_ideas(self, mock_run, discovery):\n   140→        discovery.config.discovery.enable_claude_ideas = True\n   141→        mock_run.return_value = _run_result(\n   142→            returncode=0,\n   143→            stdout='{\"result\": \"The codebase looks great, no improvements needed.\"}',\n   144→        )\n   145→        tasks = discovery._discover_claude_ideas()\n   146→        assert tasks == []\n   147→\n   148→    @patch(\"task_discovery.run_with_group_kill\")\n   149→    def test_discover_claude_ideas_caps_at_five(self, mock_run, discovery):\n   150→        discovery.config.discovery.enable_claude_ideas = True\n   151→        ideas = \"\\n\".join(f\"IDEA: Improvement {i}\" for i in range(10))\n   152→        mock_run.return_value = _run_result(\n   153→            returncode=0,\n   154→            stdout=f'{{\"result\": \"{ideas}\"}}',\n   155→        )\n   156→        tasks = discovery._discover_claude_ideas()\n   157→        assert len(tasks) <= 5\n   158→\n   159→    def test_discover_todos_ignores_string_literals(self, discovery, tmp_path):\n   160→        \"\"\"TODO inside a string literal should not be detected.\"\"\"\n   161→        (tmp_path / \"strings.py\").write_text('x = \"# TODO: not a comment\"\\n')\n   162→        tasks = discovery._discover_todos()\n   163→        assert tasks == []\n   164→\n   165→    def test_discover_todos_js_comments(self, discovery, tmp_path):\n   166→        \"\"\"// comments in JS files should be detected.\"\"\"\n   167→        (tmp_path / \"app.js\").write_text(\"// TODO: fix this\\n\")\n   168→        tasks = discovery._discover_todos()\n   169→        assert len(tasks) == 1\n   170→        assert \"TODO\" in tasks[0].description\n   171→\n   172→    def test_discover_todos_block_comment_prefix(self, discovery, tmp_path):\n   173→        \"\"\"/* FIXME ... */ in Java files should be detected.\"\"\"\n   174→        (tmp_path / \"App.java\").write_text(\"/* FIXME: broken */\\n\")\n   175→        tasks = discovery._discover_todos()\n   176→        assert len(tasks) == 1\n   177→        assert \"FIXME\" in tasks[0].description\n   178→\n   179→    def test_discover_todos_in_string_not_matched_js(self, discovery, tmp_path):\n   180→        \"\"\"TODO inside a JS string literal should not be detected.\"\"\"\n   181→        (tmp_path / \"app.js\").write_text('const s = \"// TODO: fake\";\\n')\n   182→        tasks = discovery._discover_todos()\n   183→        assert tasks == []\n   184→\n   185→    def test_discover_todos_real_comment_after_code(self, discovery, tmp_path):\n   186→        \"\"\"An inline comment after code should still be detected.\"\"\"\n   187→        (tmp_path / \"code.py\").write_text(\"x = 1  # TODO: real comment\\n\")\n   188→        tasks = discovery._discover_todos()\n   189→        assert len(tasks) == 1\n   190→        assert \"TODO\" in tasks[0].description\n   191→\n   192→    def test_discover_todos_respects_max_todo_tasks(self, discovery, tmp_path):\n   193→        \"\"\"TODO task count should be capped by config.discovery.max_todo_tasks.\"\"\"\n   194→        lines = \"\\n\".join(f\"# TODO: item {i}\" for i in range(5))\n   195→        (tmp_path / \"many.py\").write_text(lines + \"\\n\")\n   196→        discovery.config.discovery.max_todo_tasks = 2\n   197→        tasks = discovery._discover_todos()\n   198→        assert len(tasks) == 2\n   199→\n   200→    @patch(\"task_discovery.run_with_group_kill\")\n   201→    def test_discover_claude_ideas_uses_discovery_model(self, mock_run, discovery):\n   202→        \"\"\"Claude idea discovery should use discovery_model, not claude.model.\"\"\"\n   203→        discovery.config.discovery.enable_claude_ideas = True\n   204→        discovery.config.discovery.discovery_model = \"haiku\"\n   205→        discovery.config.claude.model = \"opus\"\n   206→        mock_run.return_value = _run_result(\n   207→            returncode=0,\n   208→            stdout='{\"result\": \"IDEA: Test improvement\"}',\n   209→        )\n   210→        discovery._discover_claude_ideas()\n   211→        call_args = mock_run.call_args\n   212→        cmd = call_args[0][0]\n   213→        model_idx = cmd.index(\"--model\")\n   214→        assert cmd[model_idx + 1] == \"haiku\"\n   215→\n   216→    @patch(\"task_discovery.run_with_group_kill\")\n   217→    def test_discover_claude_ideas_uses_discovery_timeout(self, mock_run, discovery):\n   218→        \"\"\"Claude idea discovery should use discovery_timeout, not claude.timeout_seconds.\"\"\"\n   219→        discovery.config.discovery.enable_claude_ideas = True\n   220→        discovery.config.discovery.discovery_timeout = 240\n   221→        discovery.config.claude.timeout_seconds = 300\n   222→        mock_run.return_value = _run_result(\n   223→            returncode=0,\n   224→            stdout='{\"result\": \"IDEA: Test\"}',\n   225→        )\n   226→        discovery._discover_claude_ideas()\n   227→        call_args = mock_run.call_args\n   228→        assert call_args[1][\"timeout\"] == 240\n   229→\n   230→    @patch(\"task_discovery.run_with_group_kill\")\n   231→    def test_discover_claude_ideas_ignores_unrelated_json(self, mock_run, discovery):\n   232→        \"\"\"If a line contains valid JSON without a 'result' field, parsing\n   233→        should continue and find the correct JSON later.\"\"\"\n   234→        discovery.config.discovery.enable_claude_ideas = True\n   235→        # First line is unrelated JSON, second line has the actual result\n   236→        stdout = '{\"status\": \"ok\"}\\n{\"result\": \"IDEA: Add input validation\"}'\n   237→        mock_run.return_value = _run_result(returncode=0, stdout=stdout)\n   238→        tasks = discovery._discover_claude_ideas()\n   239→        assert len(tasks) == 1\n   240→        assert \"input validation\" in tasks[0].description.lower()\n   241→\n   242→    @patch(\"task_discovery.run_with_group_kill\")\n   243→    def test_discover_claude_ideas_non_string_result(self, mock_run, discovery):\n   244→        \"\"\"If the JSON 'result' field is not a string, it should be ignored.\"\"\"\n   245→        discovery.config.discovery.enable_claude_ideas = True\n   246→        mock_run.return_value = _run_result(returncode=0, stdout='{\"result\": 42}')\n   247→        tasks = discovery._discover_claude_ideas()\n   248→        assert tasks == []\n   249→\n   250→    @patch(\"task_discovery.run_with_group_kill\")\n   251→    def test_discover_claude_ideas_null_result(self, mock_run, discovery):\n   252→        \"\"\"If the JSON 'result' field is null, it should be ignored.\"\"\"\n   253→        discovery.config.discovery.enable_claude_ideas = True\n   254→        mock_run.return_value = _run_result(returncode=0, stdout='{\"result\": null}')\n   255→        tasks = discovery._discover_claude_ideas()\n   256→        assert tasks == []\n   257→\n   258→    @patch(\"task_discovery.run_with_group_kill\")\n   259→    def test_discover_claude_ideas_unexpected_json_structure(self, mock_run, discovery):\n   260→        \"\"\"If JSON is a list instead of an object, it should be handled gracefully.\"\"\"\n   261→        discovery.config.discovery.enable_claude_ideas = True\n   262→        mock_run.return_value = _run_result(\n   263→            returncode=0,\n   264→            stdout='[{\"result\": \"IDEA: something\"}]',\n   265→        )\n   266→        tasks = discovery._discover_claude_ideas()\n   267→        assert tasks == []\n   268→\n   269→    @patch(\"task_discovery.run_with_group_kill\")\n   270→    def test_discover_claude_ideas_error_max_turns(self, mock_run, discovery, caplog):\n   271→        \"\"\"error_max_turns response should log a specific warning about max turns.\"\"\"\n   272→        import logging\n   273→        discovery.config.discovery.enable_claude_ideas = True\n   274→        mock_run.return_value = _run_result(\n   275→            returncode=0,\n   276→            stdout='{\"type\":\"result\",\"subtype\":\"error_max_turns\",\"is_error\":false,\"num_turns\":6}',\n   277→        )\n   278→        with caplog.at_level(logging.WARNING):\n   279→            tasks = discovery._discover_claude_ideas()\n   280→        assert tasks == []\n   281→        assert any(\"hit max turns\" in r.getMessage() for r in caplog.records)\n   282→\n   283→    @patch(\"task_discovery.run_with_group_kill\")\n   284→    def test_discover_claude_ideas_error_max_turns_with_partial_result(self, mock_run, discovery):\n   285→        \"\"\"error_max_turns with a result_text field should extract partial ideas.\"\"\"\n   286→        discovery.config.discovery.enable_claude_ideas = True\n   287→        mock_run.return_value = _run_result(\n   288→            returncode=0,\n   289→            stdout='{\"type\":\"result\",\"subtype\":\"error_max_turns\",\"result\":\"IDEA: Add input validation to parser\"}',\n   290→        )\n   291→        tasks = discovery._discover_claude_ideas()\n   292→        assert len(tasks) == 1\n   293→        assert \"input validation\" in tasks[0].description\n   294→\n   295→    @patch(\"task_discovery.run_with_group_kill\")\n   296→    def test_discover_claude_ideas_result_text_field(self, mock_run, discovery):\n   297→        \"\"\"Response using 'result_text' instead of 'result' should be extracted.\"\"\"\n   298→        discovery.config.discovery.enable_claude_ideas = True\n   299→        mock_run.return_value = _run_result(\n   300→            returncode=0,\n   301→            stdout='{\"type\":\"result\",\"result_text\":\"IDEA: Improve error messages in CLI\"}',\n   302→        )\n   303→        tasks = discovery._discover_claude_ideas()\n   304→        assert len(tasks) == 1\n   305→        assert \"error messages\" in tasks[0].description\n   306→\n   307→    @patch(\"task_discovery.run_with_group_kill\")\n   308→    def test_discover_claude_ideas_uses_config_max_turns(self, mock_run, discovery):\n   309→        \"\"\"discovery_max_turns config should be used in the CLI command.\"\"\"\n   310→        discovery.config.discovery.enable_claude_ideas = True\n   311→        discovery.config.discovery.discovery_max_turns = 20\n   312→        mock_run.return_value = _run_result(\n   313→            returncode=0,\n   314→            stdout='{\"result\": \"IDEA: Some improvement to make\"}',\n   315→        )\n   316→        discovery._discover_claude_ideas()\n   317→        cmd = mock_run.call_args[0][0]\n   318→        turns_idx = cmd.index(\"--max-turns\")\n   319→        assert cmd[turns_idx + 1] == \"20\"\n   320→\n   321→    @patch(\"task_discovery.run_with_group_kill\")\n   322→    def test_discover_claude_ideas_warns_on_unexpected_json_structure(self, mock_run, discovery, caplog):\n   323→        \"\"\"When JSON parses but lacks the expected structure, a warning is logged.\"\"\"\n   324→        import logging\n   325→        discovery.config.discovery.enable_claude_ideas = True\n   326→        mock_run.return_value = _run_result(\n   327→            returncode=0,\n   328→            stdout='{\"status\": \"ok\", \"data\": \"no result key here\"}',\n   329→        )\n   330→        with caplog.at_level(logging.WARNING):\n   331→            tasks = discovery._discover_claude_ideas()\n   332→        assert tasks == []\n   333→        assert any(\"no text content\" in r.getMessage().lower() or \"falling back\" in r.getMessage().lower()\n   334→                    for r in caplog.records)\n   335→\n   336→\n   337→class TestTaskDescriptionValidation:\n   338→    def test_task_description_truncation(self):\n   339→        \"\"\"Descriptions longer than MAX_TASK_DESCRIPTION_LENGTH are truncated.\"\"\"\n   340→        long_desc = \"x\" * (MAX_TASK_DESCRIPTION_LENGTH + 500)\n   341→        task = Task(description=long_desc, priority=1, source=\"test\")\n   342→        assert len(task.description) == MAX_TASK_DESCRIPTION_LENGTH + 3  # +3 for \"...\"\n   343→        assert task.description.endswith(\"...\")\n   344→\n   345→    def test_task_description_newline_replacement(self):\n   346→        \"\"\"Newlines in descriptions are replaced with spaces.\"\"\"\n   347→        task = Task(description=\"line one\\nline two\\nline three\", priority=1, source=\"test\")\n   348→        assert \"\\n\" not in task.description\n   349→        assert task.description == \"line one line two line three\"\n   350→\n   351→    def test_task_description_whitespace_stripped(self):\n   352→        \"\"\"Leading/trailing whitespace is stripped.\"\"\"\n   353→        task = Task(description=\"  hello world  \", priority=1, source=\"test\")\n   354→        assert task.description == \"hello world\"\n   355→\n   356→    def test_task_description_short_preserved(self):\n   357→        \"\"\"Short descriptions are preserved as-is (after strip).\"\"\"\n   358→        task = Task(description=\"Fix the bug\", priority=2, source=\"test_failure\")\n   359→        assert task.description == \"Fix the bug\"\n   360→\n   361→\n   362→class TestClaudeIdeasMinLength:\n   363→    @patch(\"task_discovery.run_with_group_kill\")\n   364→    def test_discover_claude_ideas_skips_short_descriptions(self, mock_run, discovery):\n   365→        \"\"\"IDEA lines with descriptions shorter than 10 chars are skipped.\"\"\"\n   366→        discovery.config.discovery.enable_claude_ideas = True\n   367→        ideas = \"IDEA: fix\\nIDEA: Add comprehensive input validation to config loader\"\n   368→        mock_run.return_value = _run_result(\n   369→            returncode=0,\n   370→            stdout=f'{{\"result\": \"{ideas}\"}}',\n   371→        )\n   372→        tasks = discovery._discover_claude_ideas()\n   373→        assert len(tasks) == 1\n   374→        assert \"comprehensive\" in tasks[0].description.lower()\n   375→\n   376→    @patch(\"task_discovery.run_with_group_kill\")\n   377→    def test_discover_claude_ideas_skips_empty_idea_lines(self, mock_run, discovery):\n   378→        \"\"\"IDEA lines with no description or only whitespace are skipped.\"\"\"\n   379→        discovery.config.discovery.enable_claude_ideas = True\n   380→        ideas = \"IDEA: \\\\nIDEA:\\\\nIDEA:   \"\n   381→        mock_run.return_value = _run_result(\n   382→            returncode=0,\n   383→            stdout=f'{{\"result\": \"{ideas}\"}}',\n   384→        )\n   385→        tasks = discovery._discover_claude_ideas()\n   386→        assert tasks == []\n   387→\n   388→    @patch(\"task_discovery.run_with_group_kill\")\n   389→    def test_discover_claude_ideas_accepts_long_enough_descriptions(self, mock_run, discovery):\n   390→        \"\"\"IDEA lines with descriptions >= 10 chars are accepted.\"\"\"\n   391→        discovery.config.discovery.enable_claude_ideas = True\n   392→        ideas = \"IDEA: Add retries to API calls\"\n   393→        mock_run.return_value = _run_result(\n   394→            returncode=0,\n   395→            stdout=f'{{\"result\": \"{ideas}\"}}',\n   396→        )\n   397→        tasks = discovery._discover_claude_ideas()\n   398→        assert len(tasks) == 1\n   399→\n   400→\n   401→class TestClaudeIdeasAnalysisFallback:\n   402→    @patch(\"task_discovery.run_with_group_kill\")\n   403→    def test_discover_claude_ideas_numbered_list_fallback(self, mock_run, discovery):\n   404→        \"\"\"Numbered list items should be extracted as tasks when no IDEA: lines exist.\"\"\"\n   405→        discovery.config.discovery.enable_claude_ideas = True\n   406→        mock_run.return_value = _run_result(\n   407→            returncode=0,\n   408→            stdout='{\"result\": \"1. Add input validation to config loader\\\\n2. Improve error handling in runner\"}',\n   409→        )\n   410→        tasks = discovery._discover_claude_ideas()\n   411→        assert len(tasks) == 2\n   412→        assert all(t.priority == 4 for t in tasks)\n   413→        assert all(t.source == \"claude_idea\" for t in tasks)\n   414→        assert \"input validation\" in tasks[0].description.lower()\n   415→        assert \"error handling\" in tasks[1].description.lower()\n   416→\n   417→    @patch(\"task_discovery.run_with_group_kill\")\n   418→    def test_discover_claude_ideas_bullet_list_fallback(self, mock_run, discovery):\n   419→        \"\"\"Dash-prefixed bullet items should be extracted as tasks.\"\"\"\n   420→        discovery.config.discovery.enable_claude_ideas = True\n   421→        mock_run.return_value = _run_result(\n   422→            returncode=0,\n   423→            stdout='{\"result\": \"- Add input validation to config loader\\\\n- Improve error handling in runner\"}',\n   424→        )\n   425→        tasks = discovery._discover_claude_ideas()\n   426→        assert len(tasks) == 2\n   427→        assert \"input validation\" in tasks[0].description.lower()\n   428→        assert \"error handling\" in tasks[1].description.lower()\n   429→\n   430→    @patch(\"task_discovery.run_with_group_kill\")\n   431→    def test_discover_claude_ideas_asterisk_list_fallback(self, mock_run, discovery):\n   432→        \"\"\"Asterisk-prefixed bullet items should be extracted as tasks.\"\"\"\n   433→        discovery.config.discovery.enable_claude_ideas = True\n   434→        mock_run.return_value = _run_result(\n   435→            returncode=0,\n   436→            stdout='{\"result\": \"* Add input validation to config loader\\\\n* Improve error handling in runner\"}',\n   437→        )\n   438→        tasks = discovery._discover_claude_ideas()\n   439→        assert len(tasks) == 2\n   440→        assert \"input validation\" in tasks[0].description.lower()\n   441→        assert \"error handling\" in tasks[1].description.lower()\n   442→\n   443→    @patch(\"task_discovery.run_with_group_kill\")\n   444→    def test_discover_claude_ideas_fallback_respects_min_length(self, mock_run, discovery):\n   445→        \"\"\"Short analysis lines (under 10 chars) should be skipped in fallback.\"\"\"\n   446→        discovery.config.discovery.enable_claude_ideas = True\n   447→        mock_run.return_value = _run_result(\n   448→            returncode=0,\n   449→            stdout='{\"result\": \"1. Fix bug\\\\n2. Add comprehensive input validation to config loader\"}',\n   450→        )\n   451→        tasks = discovery._discover_claude_ideas()\n   452→        # \"Fix bug\" is 7 chars, should be skipped\n   453→        assert len(tasks) == 1\n   454→        assert \"comprehensive\" in tasks[0].description.lower()\n   455→\n   456→    @patch(\"task_discovery.run_with_group_kill\")\n   457→    def test_discover_claude_ideas_fallback_caps_at_five(self, mock_run, discovery):\n   458→        \"\"\"Even in fallback mode, no more than 5 tasks should be returned.\"\"\"\n   459→        discovery.config.discovery.enable_claude_ideas = True\n   460→        items = \"\\\\n\".join(f\"{i}. Improvement number {i} for the project\" for i in range(1, 11))\n   461→        mock_run.return_value = _run_result(\n   462→            returncode=0,\n   463→            stdout='{\"result\": \"' + items + '\"}',\n   464→        )\n   465→        tasks = discovery._discover_claude_ideas()\n   466→        assert len(tasks) <= 5\n   467→\n   468→    @patch(\"task_discovery.run_with_group_kill\")\n   469→    def test_discover_claude_ideas_idea_format_preferred_over_fallback(self, mock_run, discovery):\n   470→        \"\"\"When both IDEA: lines and analysis-format lines exist, only IDEA: lines are used.\"\"\"\n   471→        discovery.config.discovery.enable_claude_ideas = True\n   472→        mock_run.return_value = _run_result(\n   473→            returncode=0,\n   474→            stdout='{\"result\": \"IDEA: Add retries to API calls\\\\n1. Improve error handling in runner\\\\n- Fix logging format\"}',\n   475→        )\n   476→        tasks = discovery._discover_claude_ideas()\n   477→        assert len(tasks) == 1\n   478→        assert \"retries\" in tasks[0].description.lower()\n   479→\n   480→    @patch(\"task_discovery.run_with_group_kill\")\n   481→    def test_discover_claude_ideas_raw_text_no_json_fallback(self, mock_run, discovery):\n   482→        \"\"\"When stdout contains no valid JSON but has analysis-format text, tasks are extracted.\"\"\"\n   483→        discovery.config.discovery.enable_claude_ideas = True\n   484→        raw_text = \"Here is my analysis:\\n1. Add input validation to config loader\\n2. Improve error handling in runner\\nDone.\"\n   485→        mock_run.return_value = _run_result(\n   486→            returncode=0,\n   487→            stdout=raw_text,\n   488→        )\n   489→        tasks = discovery._discover_claude_ideas()\n   490→        assert len(tasks) == 2\n   491→        assert \"input validation\" in tasks[0].description.lower()\n   492→        assert \"error handling\" in tasks[1].description.lower()\n   493→\n   494→\n   495→class TestTaskKey:\n   496→    def test_todo_task_key_with_file_and_line(self):\n   497→        task = Task(description=\"Address TODO in foo.py:10\", priority=3, source=\"todo\",\n   498→                    source_file=\"foo.py\", line_number=10)\n   499→        assert task.task_key == \"todo:foo.py:10\"\n   500→\n   501→    def test_todo_task_key_with_file_no_line(self):\n   502→        task = Task(description=\"Address TODO in foo.py\", priority=3, source=\"todo\",\n   503→                    source_file=\"foo.py\")\n   504→        assert task.task_key == \"todo:foo.py\"\n   505→\n   506→    def test_lint_task_key(self):\n   507→        task = Task(description=\"Fix lint error in foo.py: [F401] unused import\",\n   508→                    priority=2, source=\"lint\", source_file=\"foo.py\")\n   509→        assert task.task_key == \"lint:foo.py\"\n   510→\n   511→    def test_claude_idea_task_key_with_backtick_ref(self):\n   512→        task = Task(description=\"Improve error handling in `safety.py:98-105` for edge cases\",\n   513→                    priority=4, source=\"claude_idea\")\n   514→        assert task.task_key == \"claude_idea:safety.py\"\n   515→\n   516→    def test_claude_idea_task_key_with_in_ref(self):\n   517→        task = Task(description=\"Add validation in config_schema.py for negative values\",\n   518→                    priority=4, source=\"claude_idea\")\n   519→        assert task.task_key == \"claude_idea:config_schema.py\"\n   520→\n   521→    def test_claude_idea_task_key_no_file_ref(self):\n   522→        task = Task(description=\"Improve overall error handling across the codebase\",\n   523→                    priority=4, source=\"claude_idea\")\n   524→        assert task.task_key == \"claude_idea:Improve overall error handling across the codebase\"\n   525→\n   526→    def test_claude_idea_task_key_truncates_at_60(self):\n   527→        long_desc = \"A\" * 100\n   528→        task = Task(description=long_desc, priority=4, source=\"claude_idea\")\n   529→        assert task.task_key == f\"claude_idea:{long_desc[:60]}\"\n   530→\n   531→    def test_test_failure_task_key_with_failed_pattern(self):\n   532→        task = Task(description=\"Fix test failure: FAILED tests/test_foo.py::test_bar - AssertionError\",\n   533→                    priority=2, source=\"test_failure\")\n   534→        assert task.task_key == \"test_failure:tests/test_foo.py::test_bar\"\n   535→\n   536→    def test_test_failure_task_key_with_source_file(self):\n   537→        task = Task(description=\"Fix test failure\", priority=2, source=\"test_failure\",\n   538→                    source_file=\"tests/test_foo.py\")\n   539→        assert task.task_key == \"test_failure:tests/test_foo.py\"\n   540→\n   541→    def test_feedback_task_key(self):\n   542→        task = Task(description=\"Fix the login bug\", priority=1, source=\"feedback\",\n   543→                    source_file=\"/tmp/feedback/fix.md\")\n   544→        assert task.task_key == \"feedback:/tmp/feedback/fix.md\"\n   545→\n   546→    def test_coverage_task_key(self):\n   547→        task = Task(description=\"Improve test coverage for foo.py (currently 30%)\",\n   548→                    priority=4, source=\"coverage\", source_file=\"foo.py\")\n   549→        assert task.task_key == \"coverage:foo.py\"\n   550→\n   551→    def test_coverage_task_key_no_source_file(self):\n   552→        task = Task(description=\"Improve test coverage for bar.py (currently 20%)\",\n   553→                    priority=4, source=\"coverage\")\n   554→        assert task.task_key == \"coverage:bar.py\"\n   555→\n   556→    def test_quality_task_key(self):\n   557→        task = Task(description=\"Review big.py (600 lines)\", priority=5, source=\"quality\",\n   558→                    source_file=\"big.py\")\n   559→        assert task.task_key == \"quality:big.py\"\n   560→\n   561→    def test_fallback_task_key(self):\n   562→        task = Task(description=\"Some generic task\", priority=5, source=\"unknown_source\")\n   563→        assert task.task_key == \"unknown_source:Some generic task\"\n   564→\n   565→\n   566→class TestTaskContext:\n   567→    def test_context_preserved(self):\n   568→        \"\"\"Task context should be stored without sanitization.\"\"\"\n   569→        context = \"line 1\\nline 2\\nline 3\"\n   570→        task = Task(description=\"Fix bug\", priority=1, source=\"test\", context=context)\n   571→        assert task.context == context\n   572→\n   573→    def test_context_truncated_when_too_long(self):\n   574→        \"\"\"Context exceeding MAX_TASK_CONTEXT_LENGTH is truncated.\"\"\"\n   575→        long_ctx = \"x\" * (MAX_TASK_CONTEXT_LENGTH + 500)\n   576→        task = Task(description=\"Fix bug\", priority=1, source=\"test\", context=long_ctx)\n   577→        assert len(task.context) <= MAX_TASK_CONTEXT_LENGTH + 20  # +truncation suffix\n   578→        assert task.context.endswith(\"... (truncated)\")\n   579→\n   580→    def test_context_does_not_affect_task_key(self):\n   581→        \"\"\"Two tasks with same description but different context should have the same key.\"\"\"\n   582→        t1 = Task(description=\"Fix bug\", priority=1, source=\"feedback\",\n   583→                  source_file=\"fix.md\", context=\"context A\")\n   584→        t2 = Task(description=\"Fix bug\", priority=1, source=\"feedback\",\n   585→                  source_file=\"fix.md\", context=\"context B\")\n   586→        assert t1.task_key == t2.task_key\n   587→\n   588→    def test_empty_context_is_default(self):\n   589→        task = Task(description=\"Fix bug\", priority=1, source=\"test\")\n   590→        assert task.context == \"\"\n   591→\n   592→\n   593→class TestExtractTestTraceback:\n   594→    def test_extracts_traceback_for_test(self, discovery):\n   595→        output = (\n   596→            \"_____ test_foo _____\\n\"\n   597→            \"def test_foo():\\n\"\n   598→            \">       assert 1 == 2\\n\"\n   599→            \"E       AssertionError\\n\"\n   600→            \"===== 1 failed =====\"\n   601→        )\n   602→        result = discovery._extract_test_traceback(output, \"test_foo\")\n   603→        assert \"assert 1 == 2\" in result\n   604→        assert \"AssertionError\" in result\n   605→\n   606→    def test_returns_empty_for_no_match(self, discovery):\n   607→        output = \"some output without the test id\"\n   608→        result = discovery._extract_test_traceback(output, \"test_bar\")\n   609→        assert result == \"\"\n   610→\n   611→    def test_returns_empty_for_empty_test_id(self, discovery):\n   612→        output = \"some output\"\n   613→        result = discovery._extract_test_traceback(output, \"\")\n   614→        assert result == \"\"\n   615→\n   616→\n   617→class TestReadFileSnippet:\n   618→    def test_reads_snippet_around_line(self, discovery, tmp_path):\n   619→        content = \"\\n\".join(f\"line {i}\" for i in range(1, 21))\n   620→        (tmp_path / \"code.py\").write_text(content)\n   621→        snippet = discovery._read_file_snippet(\"code.py\", 10, context_lines=2)\n   622→        assert \" >> \" in snippet  # The target line has a marker\n   623→        assert \"line 10\" in snippet\n   624→        assert \"line 8\" in snippet\n   625→        assert \"line 12\" in snippet\n   626→\n   627→    def test_returns_empty_for_missing_file(self, discovery):\n   628→        snippet = discovery._read_file_snippet(\"nonexistent.py\", 5)\n   629→        assert snippet == \"\"\n   630→\n   631→    def test_handles_absolute_path(self, discovery, tmp_path):\n   632→        (tmp_path / \"abs.py\").write_text(\"hello\\nworld\\n\")\n   633→        snippet = discovery._read_file_snippet(str(tmp_path / \"abs.py\"), 1)\n   634→        assert \"hello\" in snippet\n   635→\n   636→    def test_clamps_to_file_boundaries(self, discovery, tmp_path):\n   637→        (tmp_path / \"short.py\").write_text(\"only\\ntwo\\n\")\n   638→        snippet = discovery._read_file_snippet(\"short.py\", 1, context_lines=10)\n   639→        assert \"only\" in snippet\n   640→        assert \"two\" in snippet\n   641→\n   642→\n   643→class TestDiscoveryAttachesContext:\n   644→    @patch(\"task_discovery.run_with_group_kill\")\n   645→    def test_test_failures_include_context(self, mock_run, discovery):\n   646→        mock_run.return_value = _run_result(\n   647→            returncode=1,\n   648→            stdout=\"FAILED tests/test_foo.py::test_bar - AssertionError\\n\",\n   649→        )\n   650→        tasks = discovery._discover_test_failures()\n   651→        assert len(tasks) == 1\n   652→        assert tasks[0].context != \"\"\n   653→\n   654→    @patch(\"task_discovery.run_with_group_kill\")\n   655→    def test_generic_test_failure_includes_full_output(self, mock_run, discovery):\n   656→        mock_run.return_value = _run_result(\n   657→            returncode=1,\n   658→            stdout=\"some error output\\n\",\n   659→        )\n   660→        tasks = discovery._discover_test_failures()\n   661→        assert len(tasks) == 1\n   662→        assert \"some error output\" in tasks[0].context\n   663→\n   664→    def test_todo_includes_file_snippet(self, discovery, tmp_path):\n   665→        (tmp_path / \"code.py\").write_text(\"x = 1\\n# TODO: fix this\\ny = 2\\n\")\n   666→        tasks = discovery._discover_todos()\n   667→        assert len(tasks) == 1\n   668→        assert tasks[0].context != \"\"\n   669→        assert \"TODO\" in tasks[0].context\n   670→\n   671→\n   672→class TestTodoFalsePositiveFiltering:\n   673→    def test_todo_mid_sentence_not_matched(self, discovery, tmp_path):\n   674→        \"\"\"A 'todo' keyword mid-sentence in a comment should not be matched.\"\"\"\n   675→        (tmp_path / \"report.py\").write_text(\"# lint: found 3 issues, todo: 2 tasks remaining\\n\")\n   676→        tasks = discovery._discover_todos()\n   677→        assert tasks == []\n   678→\n   679→    def test_todo_in_prose_not_matched(self, discovery, tmp_path):\n   680→        \"\"\"'todo' used as an ordinary word in prose should not be matched.\"\"\"\n   681→        (tmp_path / \"notes.py\").write_text(\"# There is a lot of work todo\\n\")\n   682→        tasks = discovery._discover_todos()\n   683→        assert tasks == []\n   684→\n   685→    def test_todo_at_start_matched(self, discovery, tmp_path):\n   686→        \"\"\"A TODO at the start of the comment text should be matched.\"\"\"\n   687→        (tmp_path / \"code.py\").write_text(\"# TODO: fix this\\n\")\n   688→        tasks = discovery._discover_todos()\n   689→        assert len(tasks) == 1\n   690→        assert \"TODO\" in tasks[0].description\n   691→\n   692→    def test_fixme_at_start_matched(self, discovery, tmp_path):\n   693→        \"\"\"FIXME at the start of comment text should be matched.\"\"\"\n   694→        (tmp_path / \"code.py\").write_text(\"# FIXME broken\\n\")\n   695→        tasks = discovery._discover_todos()\n   696→        assert len(tasks) == 1\n   697→        assert \"FIXME\" in tasks[0].description\n   698→\n   699→    def test_inline_todo_matched(self, discovery, tmp_path):\n   700→        \"\"\"An inline comment TODO after code should still be matched.\"\"\"\n   701→        (tmp_path / \"code.py\").write_text(\"x = 1  # TODO: refactor\\n\")\n   702→        tasks = discovery._discover_todos()\n   703→        assert len(tasks) == 1\n   704→        assert \"TODO\" in tasks[0].description\n   705→\n   706→\n   707→class TestDiscoverClaudeIdeasHistory:\n   708→    @patch(\"task_discovery.run_with_group_kill\")\n   709→    def test_history_injected_into_prompt(self, mock_run, tmp_path, default_config):\n   710→        \"\"\"When state_manager has recent tasks, prompt should include history.\"\"\"\n   711→        default_config.target_dir = str(tmp_path)\n   712→        mock_state = MagicMock()\n   713→        mock_state.get_recent_task_summaries.return_value = [\n   714→            \"- Add retry logic (succeeded)\",\n   715→            \"- Fix timeout handling (failed)\",\n   716→        ]\n   717→        disc = TaskDiscovery(default_config, state_manager=mock_state)\n   718→        mock_run.return_value = _run_result(\n   719→            returncode=0,\n   720→            stdout='{\"result\": \"IDEA: Add input validation to loader\"}',\n   721→        )\n   722→        disc._discover_claude_ideas()\n   723→        call_args = mock_run.call_args\n   724→        cmd = call_args[0][0]\n   725→        prompt_idx = cmd.index(\"-p\")\n   726→        prompt = cmd[prompt_idx + 1]\n   727→        assert \"RECENTLY COMPLETED TASKS\" in prompt\n   728→        assert \"Add retry logic\" in prompt\n   729→        assert \"Fix timeout handling\" in prompt\n   730→\n   731→    @patch(\"task_discovery.run_with_group_kill\")\n   732→    def test_no_history_when_state_manager_none(self, mock_run, tmp_path, default_config):\n   733→        \"\"\"Without state_manager, prompt should not include history section.\"\"\"\n   734→        default_config.target_dir = str(tmp_path)\n   735→        disc = TaskDiscovery(default_config, state_manager=None)\n   736→        mock_run.return_value = _run_result(\n   737→            returncode=0,\n   738→            stdout='{\"result\": \"IDEA: Add input validation to loader\"}',\n   739→        )\n   740→        disc._discover_claude_ideas()\n   741→        call_args = mock_run.call_args\n   742→        cmd = call_args[0][0]\n   743→        prompt_idx = cmd.index(\"-p\")\n   744→        prompt = cmd[prompt_idx + 1]\n   745→        assert \"RECENTLY COMPLETED\" not in prompt\n   746→\n   747→    @patch(\"task_discovery.run_with_group_kill\")\n   748→    def test_custom_discovery_prompt(self, mock_run, tmp_path, default_config):\n   749→        \"\"\"Custom discovery_prompt replaces default focus areas.\"\"\"\n   750→        default_config.target_dir = str(tmp_path)\n   751→        default_config.discovery.discovery_prompt = \"- Security vulnerabilities\\n- API design\\n\"\n   752→        disc = TaskDiscovery(default_config)\n   753→        mock_run.return_value = _run_result(\n   754→            returncode=0,\n   755→            stdout='{\"result\": \"IDEA: Fix SQL injection vulnerability\"}',\n   756→        )\n   757→        disc._discover_claude_ideas()\n   758→        call_args = mock_run.call_args\n   759→        cmd = call_args[0][0]\n   760→        prompt_idx = cmd.index(\"-p\")\n   761→        prompt = cmd[prompt_idx + 1]\n   762→        assert \"Security vulnerabilities\" in prompt\n   763→        assert \"API design\" in prompt\n   764→        # Default focus areas should not be present\n   765→        assert \"New features or functionality\" not in prompt\n   766→"}]},"parent_tool_use_id":null,"session_id":"88780ef9-89c7-4f24-bc8c-c264c3a55a21","uuid":"f1d9088d-6efb-42b6-a954-7d873fcbf309","tool_use_result":{"type":"text","file":{"filePath":"/Users/sameertkhanna/Documents/auto_claude_code/tests/test_task_discovery.py","content":"        assert all(t.source == \"claude_idea\" for t in tasks)\n        assert \"input validation\" in tasks[0].description.lower()\n        assert \"retry\" in tasks[1].description.lower()\n\n    @patch(\"task_discovery.run_with_group_kill\")\n    def test_discover_claude_ideas_timeout(self, mock_run, discovery):\n        discovery.config.discovery.enable_claude_ideas = True\n        mock_run.return_value = _run_result(timed_out=True, returncode=-1)\n        tasks = discovery._discover_claude_ideas()\n        assert tasks == []\n\n    @patch(\"task_discovery.run_with_group_kill\")\n    def test_discover_claude_ideas_failure(self, mock_run, discovery):\n        discovery.config.discovery.enable_claude_ideas = True\n        mock_run.return_value = _run_result(returncode=1, stderr=\"error\")\n        tasks = discovery._discover_claude_ideas()\n        assert tasks == []\n\n    @patch(\"task_discovery.run_with_group_kill\")\n    def test_discover_claude_ideas_no_ideas(self, mock_run, discovery):\n        discovery.config.discovery.enable_claude_ideas = True\n        mock_run.return_value = _run_result(\n            returncode=0,\n            stdout='{\"result\": \"The codebase looks great, no improvements needed.\"}',\n        )\n        tasks = discovery._discover_claude_ideas()\n        assert tasks == []\n\n    @patch(\"task_discovery.run_with_group_kill\")\n    def test_discover_claude_ideas_caps_at_five(self, mock_run, discovery):\n        discovery.config.discovery.enable_claude_ideas = True\n        ideas = \"\\n\".join(f\"IDEA: Improvement {i}\" for i in range(10))\n        mock_run.return_value = _run_result(\n            returncode=0,\n            stdout=f'{{\"result\": \"{ideas}\"}}',\n        )\n        tasks = discovery._discover_claude_ideas()\n        assert len(tasks) <= 5\n\n    def test_discover_todos_ignores_string_literals(self, discovery, tmp_path):\n        \"\"\"TODO inside a string literal should not be detected.\"\"\"\n        (tmp_path / \"strings.py\").write_text('x = \"# TODO: not a comment\"\\n')\n        tasks = discovery._discover_todos()\n        assert tasks == []\n\n    def test_discover_todos_js_comments(self, discovery, tmp_path):\n        \"\"\"// comments in JS files should be detected.\"\"\"\n        (tmp_path / \"app.js\").write_text(\"// TODO: fix this\\n\")\n        tasks = discovery._discover_todos()\n        assert len(tasks) == 1\n        assert \"TODO\" in tasks[0].description\n\n    def test_discover_todos_block_comment_prefix(self, discovery, tmp_path):\n        \"\"\"/* FIXME ... */ in Java files should be detected.\"\"\"\n        (tmp_path / \"App.java\").write_text(\"/* FIXME: broken */\\n\")\n        tasks = discovery._discover_todos()\n        assert len(tasks) == 1\n        assert \"FIXME\" in tasks[0].description\n\n    def test_discover_todos_in_string_not_matched_js(self, discovery, tmp_path):\n        \"\"\"TODO inside a JS string literal should not be detected.\"\"\"\n        (tmp_path / \"app.js\").write_text('const s = \"// TODO: fake\";\\n')\n        tasks = discovery._discover_todos()\n        assert tasks == []\n\n    def test_discover_todos_real_comment_after_code(self, discovery, tmp_path):\n        \"\"\"An inline comment after code should still be detected.\"\"\"\n        (tmp_path / \"code.py\").write_text(\"x = 1  # TODO: real comment\\n\")\n        tasks = discovery._discover_todos()\n        assert len(tasks) == 1\n        assert \"TODO\" in tasks[0].description\n\n    def test_discover_todos_respects_max_todo_tasks(self, discovery, tmp_path):\n        \"\"\"TODO task count should be capped by config.discovery.max_todo_tasks.\"\"\"\n        lines = \"\\n\".join(f\"# TODO: item {i}\" for i in range(5))\n        (tmp_path / \"many.py\").write_text(lines + \"\\n\")\n        discovery.config.discovery.max_todo_tasks = 2\n        tasks = discovery._discover_todos()\n        assert len(tasks) == 2\n\n    @patch(\"task_discovery.run_with_group_kill\")\n    def test_discover_claude_ideas_uses_discovery_model(self, mock_run, discovery):\n        \"\"\"Claude idea discovery should use discovery_model, not claude.model.\"\"\"\n        discovery.config.discovery.enable_claude_ideas = True\n        discovery.config.discovery.discovery_model = \"haiku\"\n        discovery.config.claude.model = \"opus\"\n        mock_run.return_value = _run_result(\n            returncode=0,\n            stdout='{\"result\": \"IDEA: Test improvement\"}',\n        )\n        discovery._discover_claude_ideas()\n        call_args = mock_run.call_args\n        cmd = call_args[0][0]\n        model_idx = cmd.index(\"--model\")\n        assert cmd[model_idx + 1] == \"haiku\"\n\n    @patch(\"task_discovery.run_with_group_kill\")\n    def test_discover_claude_ideas_uses_discovery_timeout(self, mock_run, discovery):\n        \"\"\"Claude idea discovery should use discovery_timeout, not claude.timeout_seconds.\"\"\"\n        discovery.config.discovery.enable_claude_ideas = True\n        discovery.config.discovery.discovery_timeout = 240\n        discovery.config.claude.timeout_seconds = 300\n        mock_run.return_value = _run_result(\n            returncode=0,\n            stdout='{\"result\": \"IDEA: Test\"}',\n        )\n        discovery._discover_claude_ideas()\n        call_args = mock_run.call_args\n        assert call_args[1][\"timeout\"] == 240\n\n    @patch(\"task_discovery.run_with_group_kill\")\n    def test_discover_claude_ideas_ignores_unrelated_json(self, mock_run, discovery):\n        \"\"\"If a line contains valid JSON without a 'result' field, parsing\n        should continue and find the correct JSON later.\"\"\"\n        discovery.config.discovery.enable_claude_ideas = True\n        # First line is unrelated JSON, second line has the actual result\n        stdout = '{\"status\": \"ok\"}\\n{\"result\": \"IDEA: Add input validation\"}'\n        mock_run.return_value = _run_result(returncode=0, stdout=stdout)\n        tasks = discovery._discover_claude_ideas()\n        assert len(tasks) == 1\n        assert \"input validation\" in tasks[0].description.lower()\n\n    @patch(\"task_discovery.run_with_group_kill\")\n    def test_discover_claude_ideas_non_string_result(self, mock_run, discovery):\n        \"\"\"If the JSON 'result' field is not a string, it should be ignored.\"\"\"\n        discovery.config.discovery.enable_claude_ideas = True\n        mock_run.return_value = _run_result(returncode=0, stdout='{\"result\": 42}')\n        tasks = discovery._discover_claude_ideas()\n        assert tasks == []\n\n    @patch(\"task_discovery.run_with_group_kill\")\n    def test_discover_claude_ideas_null_result(self, mock_run, discovery):\n        \"\"\"If the JSON 'result' field is null, it should be ignored.\"\"\"\n        discovery.config.discovery.enable_claude_ideas = True\n        mock_run.return_value = _run_result(returncode=0, stdout='{\"result\": null}')\n        tasks = discovery._discover_claude_ideas()\n        assert tasks == []\n\n    @patch(\"task_discovery.run_with_group_kill\")\n    def test_discover_claude_ideas_unexpected_json_structure(self, mock_run, discovery):\n        \"\"\"If JSON is a list instead of an object, it should be handled gracefully.\"\"\"\n        discovery.config.discovery.enable_claude_ideas = True\n        mock_run.return_value = _run_result(\n            returncode=0,\n            stdout='[{\"result\": \"IDEA: something\"}]',\n        )\n        tasks = discovery._discover_claude_ideas()\n        assert tasks == []\n\n    @patch(\"task_discovery.run_with_group_kill\")\n    def test_discover_claude_ideas_error_max_turns(self, mock_run, discovery, caplog):\n        \"\"\"error_max_turns response should log a specific warning about max turns.\"\"\"\n        import logging\n        discovery.config.discovery.enable_claude_ideas = True\n        mock_run.return_value = _run_result(\n            returncode=0,\n            stdout='{\"type\":\"result\",\"subtype\":\"error_max_turns\",\"is_error\":false,\"num_turns\":6}',\n        )\n        with caplog.at_level(logging.WARNING):\n            tasks = discovery._discover_claude_ideas()\n        assert tasks == []\n        assert any(\"hit max turns\" in r.getMessage() for r in caplog.records)\n\n    @patch(\"task_discovery.run_with_group_kill\")\n    def test_discover_claude_ideas_error_max_turns_with_partial_result(self, mock_run, discovery):\n        \"\"\"error_max_turns with a result_text field should extract partial ideas.\"\"\"\n        discovery.config.discovery.enable_claude_ideas = True\n        mock_run.return_value = _run_result(\n            returncode=0,\n            stdout='{\"type\":\"result\",\"subtype\":\"error_max_turns\",\"result\":\"IDEA: Add input validation to parser\"}',\n        )\n        tasks = discovery._discover_claude_ideas()\n        assert len(tasks) == 1\n        assert \"input validation\" in tasks[0].description\n\n    @patch(\"task_discovery.run_with_group_kill\")\n    def test_discover_claude_ideas_result_text_field(self, mock_run, discovery):\n        \"\"\"Response using 'result_text' instead of 'result' should be extracted.\"\"\"\n        discovery.config.discovery.enable_claude_ideas = True\n        mock_run.return_value = _run_result(\n            returncode=0,\n            stdout='{\"type\":\"result\",\"result_text\":\"IDEA: Improve error messages in CLI\"}',\n        )\n        tasks = discovery._discover_claude_ideas()\n        assert len(tasks) == 1\n        assert \"error messages\" in tasks[0].description\n\n    @patch(\"task_discovery.run_with_group_kill\")\n    def test_discover_claude_ideas_uses_config_max_turns(self, mock_run, discovery):\n        \"\"\"discovery_max_turns config should be used in the CLI command.\"\"\"\n        discovery.config.discovery.enable_claude_ideas = True\n        discovery.config.discovery.discovery_max_turns = 20\n        mock_run.return_value = _run_result(\n            returncode=0,\n            stdout='{\"result\": \"IDEA: Some improvement to make\"}',\n        )\n        discovery._discover_claude_ideas()\n        cmd = mock_run.call_args[0][0]\n        turns_idx = cmd.index(\"--max-turns\")\n        assert cmd[turns_idx + 1] == \"20\"\n\n    @patch(\"task_discovery.run_with_group_kill\")\n    def test_discover_claude_ideas_warns_on_unexpected_json_structure(self, mock_run, discovery, caplog):\n        \"\"\"When JSON parses but lacks the expected structure, a warning is logged.\"\"\"\n        import logging\n        discovery.config.discovery.enable_claude_ideas = True\n        mock_run.return_value = _run_result(\n            returncode=0,\n            stdout='{\"status\": \"ok\", \"data\": \"no result key here\"}',\n        )\n        with caplog.at_level(logging.WARNING):\n            tasks = discovery._discover_claude_ideas()\n        assert tasks == []\n        assert any(\"no text content\" in r.getMessage().lower() or \"falling back\" in r.getMessage().lower()\n                    for r in caplog.records)\n\n\nclass TestTaskDescriptionValidation:\n    def test_task_description_truncation(self):\n        \"\"\"Descriptions longer than MAX_TASK_DESCRIPTION_LENGTH are truncated.\"\"\"\n        long_desc = \"x\" * (MAX_TASK_DESCRIPTION_LENGTH + 500)\n        task = Task(description=long_desc, priority=1, source=\"test\")\n        assert len(task.description) == MAX_TASK_DESCRIPTION_LENGTH + 3  # +3 for \"...\"\n        assert task.description.endswith(\"...\")\n\n    def test_task_description_newline_replacement(self):\n        \"\"\"Newlines in descriptions are replaced with spaces.\"\"\"\n        task = Task(description=\"line one\\nline two\\nline three\", priority=1, source=\"test\")\n        assert \"\\n\" not in task.description\n        assert task.description == \"line one line two line three\"\n\n    def test_task_description_whitespace_stripped(self):\n        \"\"\"Leading/trailing whitespace is stripped.\"\"\"\n        task = Task(description=\"  hello world  \", priority=1, source=\"test\")\n        assert task.description == \"hello world\"\n\n    def test_task_description_short_preserved(self):\n        \"\"\"Short descriptions are preserved as-is (after strip).\"\"\"\n        task = Task(description=\"Fix the bug\", priority=2, source=\"test_failure\")\n        assert task.description == \"Fix the bug\"\n\n\nclass TestClaudeIdeasMinLength:\n    @patch(\"task_discovery.run_with_group_kill\")\n    def test_discover_claude_ideas_skips_short_descriptions(self, mock_run, discovery):\n        \"\"\"IDEA lines with descriptions shorter than 10 chars are skipped.\"\"\"\n        discovery.config.discovery.enable_claude_ideas = True\n        ideas = \"IDEA: fix\\nIDEA: Add comprehensive input validation to config loader\"\n        mock_run.return_value = _run_result(\n            returncode=0,\n            stdout=f'{{\"result\": \"{ideas}\"}}',\n        )\n        tasks = discovery._discover_claude_ideas()\n        assert len(tasks) == 1\n        assert \"comprehensive\" in tasks[0].description.lower()\n\n    @patch(\"task_discovery.run_with_group_kill\")\n    def test_discover_claude_ideas_skips_empty_idea_lines(self, mock_run, discovery):\n        \"\"\"IDEA lines with no description or only whitespace are skipped.\"\"\"\n        discovery.config.discovery.enable_claude_ideas = True\n        ideas = \"IDEA: \\\\nIDEA:\\\\nIDEA:   \"\n        mock_run.return_value = _run_result(\n            returncode=0,\n            stdout=f'{{\"result\": \"{ideas}\"}}',\n        )\n        tasks = discovery._discover_claude_ideas()\n        assert tasks == []\n\n    @patch(\"task_discovery.run_with_group_kill\")\n    def test_discover_claude_ideas_accepts_long_enough_descriptions(self, mock_run, discovery):\n        \"\"\"IDEA lines with descriptions >= 10 chars are accepted.\"\"\"\n        discovery.config.discovery.enable_claude_ideas = True\n        ideas = \"IDEA: Add retries to API calls\"\n        mock_run.return_value = _run_result(\n            returncode=0,\n            stdout=f'{{\"result\": \"{ideas}\"}}',\n        )\n        tasks = discovery._discover_claude_ideas()\n        assert len(tasks) == 1\n\n\nclass TestClaudeIdeasAnalysisFallback:\n    @patch(\"task_discovery.run_with_group_kill\")\n    def test_discover_claude_ideas_numbered_list_fallback(self, mock_run, discovery):\n        \"\"\"Numbered list items should be extracted as tasks when no IDEA: lines exist.\"\"\"\n        discovery.config.discovery.enable_claude_ideas = True\n        mock_run.return_value = _run_result(\n            returncode=0,\n            stdout='{\"result\": \"1. Add input validation to config loader\\\\n2. Improve error handling in runner\"}',\n        )\n        tasks = discovery._discover_claude_ideas()\n        assert len(tasks) == 2\n        assert all(t.priority == 4 for t in tasks)\n        assert all(t.source == \"claude_idea\" for t in tasks)\n        assert \"input validation\" in tasks[0].description.lower()\n        assert \"error handling\" in tasks[1].description.lower()\n\n    @patch(\"task_discovery.run_with_group_kill\")\n    def test_discover_claude_ideas_bullet_list_fallback(self, mock_run, discovery):\n        \"\"\"Dash-prefixed bullet items should be extracted as tasks.\"\"\"\n        discovery.config.discovery.enable_claude_ideas = True\n        mock_run.return_value = _run_result(\n            returncode=0,\n            stdout='{\"result\": \"- Add input validation to config loader\\\\n- Improve error handling in runner\"}',\n        )\n        tasks = discovery._discover_claude_ideas()\n        assert len(tasks) == 2\n        assert \"input validation\" in tasks[0].description.lower()\n        assert \"error handling\" in tasks[1].description.lower()\n\n    @patch(\"task_discovery.run_with_group_kill\")\n    def test_discover_claude_ideas_asterisk_list_fallback(self, mock_run, discovery):\n        \"\"\"Asterisk-prefixed bullet items should be extracted as tasks.\"\"\"\n        discovery.config.discovery.enable_claude_ideas = True\n        mock_run.return_value = _run_result(\n            returncode=0,\n            stdout='{\"result\": \"* Add input validation to config loader\\\\n* Improve error handling in runner\"}',\n        )\n        tasks = discovery._discover_claude_ideas()\n        assert len(tasks) == 2\n        assert \"input validation\" in tasks[0].description.lower()\n        assert \"error handling\" in tasks[1].description.lower()\n\n    @patch(\"task_discovery.run_with_group_kill\")\n    def test_discover_claude_ideas_fallback_respects_min_length(self, mock_run, discovery):\n        \"\"\"Short analysis lines (under 10 chars) should be skipped in fallback.\"\"\"\n        discovery.config.discovery.enable_claude_ideas = True\n        mock_run.return_value = _run_result(\n            returncode=0,\n            stdout='{\"result\": \"1. Fix bug\\\\n2. Add comprehensive input validation to config loader\"}',\n        )\n        tasks = discovery._discover_claude_ideas()\n        # \"Fix bug\" is 7 chars, should be skipped\n        assert len(tasks) == 1\n        assert \"comprehensive\" in tasks[0].description.lower()\n\n    @patch(\"task_discovery.run_with_group_kill\")\n    def test_discover_claude_ideas_fallback_caps_at_five(self, mock_run, discovery):\n        \"\"\"Even in fallback mode, no more than 5 tasks should be returned.\"\"\"\n        discovery.config.discovery.enable_claude_ideas = True\n        items = \"\\\\n\".join(f\"{i}. Improvement number {i} for the project\" for i in range(1, 11))\n        mock_run.return_value = _run_result(\n            returncode=0,\n            stdout='{\"result\": \"' + items + '\"}',\n        )\n        tasks = discovery._discover_claude_ideas()\n        assert len(tasks) <= 5\n\n    @patch(\"task_discovery.run_with_group_kill\")\n    def test_discover_claude_ideas_idea_format_preferred_over_fallback(self, mock_run, discovery):\n        \"\"\"When both IDEA: lines and analysis-format lines exist, only IDEA: lines are used.\"\"\"\n        discovery.config.discovery.enable_claude_ideas = True\n        mock_run.return_value = _run_result(\n            returncode=0,\n            stdout='{\"result\": \"IDEA: Add retries to API calls\\\\n1. Improve error handling in runner\\\\n- Fix logging format\"}',\n        )\n        tasks = discovery._discover_claude_ideas()\n        assert len(tasks) == 1\n        assert \"retries\" in tasks[0].description.lower()\n\n    @patch(\"task_discovery.run_with_group_kill\")\n    def test_discover_claude_ideas_raw_text_no_json_fallback(self, mock_run, discovery):\n        \"\"\"When stdout contains no valid JSON but has analysis-format text, tasks are extracted.\"\"\"\n        discovery.config.discovery.enable_claude_ideas = True\n        raw_text = \"Here is my analysis:\\n1. Add input validation to config loader\\n2. Improve error handling in runner\\nDone.\"\n        mock_run.return_value = _run_result(\n            returncode=0,\n            stdout=raw_text,\n        )\n        tasks = discovery._discover_claude_ideas()\n        assert len(tasks) == 2\n        assert \"input validation\" in tasks[0].description.lower()\n        assert \"error handling\" in tasks[1].description.lower()\n\n\nclass TestTaskKey:\n    def test_todo_task_key_with_file_and_line(self):\n        task = Task(description=\"Address TODO in foo.py:10\", priority=3, source=\"todo\",\n                    source_file=\"foo.py\", line_number=10)\n        assert task.task_key == \"todo:foo.py:10\"\n\n    def test_todo_task_key_with_file_no_line(self):\n        task = Task(description=\"Address TODO in foo.py\", priority=3, source=\"todo\",\n                    source_file=\"foo.py\")\n        assert task.task_key == \"todo:foo.py\"\n\n    def test_lint_task_key(self):\n        task = Task(description=\"Fix lint error in foo.py: [F401] unused import\",\n                    priority=2, source=\"lint\", source_file=\"foo.py\")\n        assert task.task_key == \"lint:foo.py\"\n\n    def test_claude_idea_task_key_with_backtick_ref(self):\n        task = Task(description=\"Improve error handling in `safety.py:98-105` for edge cases\",\n                    priority=4, source=\"claude_idea\")\n        assert task.task_key == \"claude_idea:safety.py\"\n\n    def test_claude_idea_task_key_with_in_ref(self):\n        task = Task(description=\"Add validation in config_schema.py for negative values\",\n                    priority=4, source=\"claude_idea\")\n        assert task.task_key == \"claude_idea:config_schema.py\"\n\n    def test_claude_idea_task_key_no_file_ref(self):\n        task = Task(description=\"Improve overall error handling across the codebase\",\n                    priority=4, source=\"claude_idea\")\n        assert task.task_key == \"claude_idea:Improve overall error handling across the codebase\"\n\n    def test_claude_idea_task_key_truncates_at_60(self):\n        long_desc = \"A\" * 100\n        task = Task(description=long_desc, priority=4, source=\"claude_idea\")\n        assert task.task_key == f\"claude_idea:{long_desc[:60]}\"\n\n    def test_test_failure_task_key_with_failed_pattern(self):\n        task = Task(description=\"Fix test failure: FAILED tests/test_foo.py::test_bar - AssertionError\",\n                    priority=2, source=\"test_failure\")\n        assert task.task_key == \"test_failure:tests/test_foo.py::test_bar\"\n\n    def test_test_failure_task_key_with_source_file(self):\n        task = Task(description=\"Fix test failure\", priority=2, source=\"test_failure\",\n                    source_file=\"tests/test_foo.py\")\n        assert task.task_key == \"test_failure:tests/test_foo.py\"\n\n    def test_feedback_task_key(self):\n        task = Task(description=\"Fix the login bug\", priority=1, source=\"feedback\",\n                    source_file=\"/tmp/feedback/fix.md\")\n        assert task.task_key == \"feedback:/tmp/feedback/fix.md\"\n\n    def test_coverage_task_key(self):\n        task = Task(description=\"Improve test coverage for foo.py (currently 30%)\",\n                    priority=4, source=\"coverage\", source_file=\"foo.py\")\n        assert task.task_key == \"coverage:foo.py\"\n\n    def test_coverage_task_key_no_source_file(self):\n        task = Task(description=\"Improve test coverage for bar.py (currently 20%)\",\n                    priority=4, source=\"coverage\")\n        assert task.task_key == \"coverage:bar.py\"\n\n    def test_quality_task_key(self):\n        task = Task(description=\"Review big.py (600 lines)\", priority=5, source=\"quality\",\n                    source_file=\"big.py\")\n        assert task.task_key == \"quality:big.py\"\n\n    def test_fallback_task_key(self):\n        task = Task(description=\"Some generic task\", priority=5, source=\"unknown_source\")\n        assert task.task_key == \"unknown_source:Some generic task\"\n\n\nclass TestTaskContext:\n    def test_context_preserved(self):\n        \"\"\"Task context should be stored without sanitization.\"\"\"\n        context = \"line 1\\nline 2\\nline 3\"\n        task = Task(description=\"Fix bug\", priority=1, source=\"test\", context=context)\n        assert task.context == context\n\n    def test_context_truncated_when_too_long(self):\n        \"\"\"Context exceeding MAX_TASK_CONTEXT_LENGTH is truncated.\"\"\"\n        long_ctx = \"x\" * (MAX_TASK_CONTEXT_LENGTH + 500)\n        task = Task(description=\"Fix bug\", priority=1, source=\"test\", context=long_ctx)\n        assert len(task.context) <= MAX_TASK_CONTEXT_LENGTH + 20  # +truncation suffix\n        assert task.context.endswith(\"... (truncated)\")\n\n    def test_context_does_not_affect_task_key(self):\n        \"\"\"Two tasks with same description but different context should have the same key.\"\"\"\n        t1 = Task(description=\"Fix bug\", priority=1, source=\"feedback\",\n                  source_file=\"fix.md\", context=\"context A\")\n        t2 = Task(description=\"Fix bug\", priority=1, source=\"feedback\",\n                  source_file=\"fix.md\", context=\"context B\")\n        assert t1.task_key == t2.task_key\n\n    def test_empty_context_is_default(self):\n        task = Task(description=\"Fix bug\", priority=1, source=\"test\")\n        assert task.context == \"\"\n\n\nclass TestExtractTestTraceback:\n    def test_extracts_traceback_for_test(self, discovery):\n        output = (\n            \"_____ test_foo _____\\n\"\n            \"def test_foo():\\n\"\n            \">       assert 1 == 2\\n\"\n            \"E       AssertionError\\n\"\n            \"===== 1 failed =====\"\n        )\n        result = discovery._extract_test_traceback(output, \"test_foo\")\n        assert \"assert 1 == 2\" in result\n        assert \"AssertionError\" in result\n\n    def test_returns_empty_for_no_match(self, discovery):\n        output = \"some output without the test id\"\n        result = discovery._extract_test_traceback(output, \"test_bar\")\n        assert result == \"\"\n\n    def test_returns_empty_for_empty_test_id(self, discovery):\n        output = \"some output\"\n        result = discovery._extract_test_traceback(output, \"\")\n        assert result == \"\"\n\n\nclass TestReadFileSnippet:\n    def test_reads_snippet_around_line(self, discovery, tmp_path):\n        content = \"\\n\".join(f\"line {i}\" for i in range(1, 21))\n        (tmp_path / \"code.py\").write_text(content)\n        snippet = discovery._read_file_snippet(\"code.py\", 10, context_lines=2)\n        assert \" >> \" in snippet  # The target line has a marker\n        assert \"line 10\" in snippet\n        assert \"line 8\" in snippet\n        assert \"line 12\" in snippet\n\n    def test_returns_empty_for_missing_file(self, discovery):\n        snippet = discovery._read_file_snippet(\"nonexistent.py\", 5)\n        assert snippet == \"\"\n\n    def test_handles_absolute_path(self, discovery, tmp_path):\n        (tmp_path / \"abs.py\").write_text(\"hello\\nworld\\n\")\n        snippet = discovery._read_file_snippet(str(tmp_path / \"abs.py\"), 1)\n        assert \"hello\" in snippet\n\n    def test_clamps_to_file_boundaries(self, discovery, tmp_path):\n        (tmp_path / \"short.py\").write_text(\"only\\ntwo\\n\")\n        snippet = discovery._read_file_snippet(\"short.py\", 1, context_lines=10)\n        assert \"only\" in snippet\n        assert \"two\" in snippet\n\n\nclass TestDiscoveryAttachesContext:\n    @patch(\"task_discovery.run_with_group_kill\")\n    def test_test_failures_include_context(self, mock_run, discovery):\n        mock_run.return_value = _run_result(\n            returncode=1,\n            stdout=\"FAILED tests/test_foo.py::test_bar - AssertionError\\n\",\n        )\n        tasks = discovery._discover_test_failures()\n        assert len(tasks) == 1\n        assert tasks[0].context != \"\"\n\n    @patch(\"task_discovery.run_with_group_kill\")\n    def test_generic_test_failure_includes_full_output(self, mock_run, discovery):\n        mock_run.return_value = _run_result(\n            returncode=1,\n            stdout=\"some error output\\n\",\n        )\n        tasks = discovery._discover_test_failures()\n        assert len(tasks) == 1\n        assert \"some error output\" in tasks[0].context\n\n    def test_todo_includes_file_snippet(self, discovery, tmp_path):\n        (tmp_path / \"code.py\").write_text(\"x = 1\\n# TODO: fix this\\ny = 2\\n\")\n        tasks = discovery._discover_todos()\n        assert len(tasks) == 1\n        assert tasks[0].context != \"\"\n        assert \"TODO\" in tasks[0].context\n\n\nclass TestTodoFalsePositiveFiltering:\n    def test_todo_mid_sentence_not_matched(self, discovery, tmp_path):\n        \"\"\"A 'todo' keyword mid-sentence in a comment should not be matched.\"\"\"\n        (tmp_path / \"report.py\").write_text(\"# lint: found 3 issues, todo: 2 tasks remaining\\n\")\n        tasks = discovery._discover_todos()\n        assert tasks == []\n\n    def test_todo_in_prose_not_matched(self, discovery, tmp_path):\n        \"\"\"'todo' used as an ordinary word in prose should not be matched.\"\"\"\n        (tmp_path / \"notes.py\").write_text(\"# There is a lot of work todo\\n\")\n        tasks = discovery._discover_todos()\n        assert tasks == []\n\n    def test_todo_at_start_matched(self, discovery, tmp_path):\n        \"\"\"A TODO at the start of the comment text should be matched.\"\"\"\n        (tmp_path / \"code.py\").write_text(\"# TODO: fix this\\n\")\n        tasks = discovery._discover_todos()\n        assert len(tasks) == 1\n        assert \"TODO\" in tasks[0].description\n\n    def test_fixme_at_start_matched(self, discovery, tmp_path):\n        \"\"\"FIXME at the start of comment text should be matched.\"\"\"\n        (tmp_path / \"code.py\").write_text(\"# FIXME broken\\n\")\n        tasks = discovery._discover_todos()\n        assert len(tasks) == 1\n        assert \"FIXME\" in tasks[0].description\n\n    def test_inline_todo_matched(self, discovery, tmp_path):\n        \"\"\"An inline comment TODO after code should still be matched.\"\"\"\n        (tmp_path / \"code.py\").write_text(\"x = 1  # TODO: refactor\\n\")\n        tasks = discovery._discover_todos()\n        assert len(tasks) == 1\n        assert \"TODO\" in tasks[0].description\n\n\nclass TestDiscoverClaudeIdeasHistory:\n    @patch(\"task_discovery.run_with_group_kill\")\n    def test_history_injected_into_prompt(self, mock_run, tmp_path, default_config):\n        \"\"\"When state_manager has recent tasks, prompt should include history.\"\"\"\n        default_config.target_dir = str(tmp_path)\n        mock_state = MagicMock()\n        mock_state.get_recent_task_summaries.return_value = [\n            \"- Add retry logic (succeeded)\",\n            \"- Fix timeout handling (failed)\",\n        ]\n        disc = TaskDiscovery(default_config, state_manager=mock_state)\n        mock_run.return_value = _run_result(\n            returncode=0,\n            stdout='{\"result\": \"IDEA: Add input validation to loader\"}',\n        )\n        disc._discover_claude_ideas()\n        call_args = mock_run.call_args\n        cmd = call_args[0][0]\n        prompt_idx = cmd.index(\"-p\")\n        prompt = cmd[prompt_idx + 1]\n        assert \"RECENTLY COMPLETED TASKS\" in prompt\n        assert \"Add retry logic\" in prompt\n        assert \"Fix timeout handling\" in prompt\n\n    @patch(\"task_discovery.run_with_group_kill\")\n    def test_no_history_when_state_manager_none(self, mock_run, tmp_path, default_config):\n        \"\"\"Without state_manager, prompt should not include history section.\"\"\"\n        default_config.target_dir = str(tmp_path)\n        disc = TaskDiscovery(default_config, state_manager=None)\n        mock_run.return_value = _run_result(\n            returncode=0,\n            stdout='{\"result\": \"IDEA: Add input validation to loader\"}',\n        )\n        disc._discover_claude_ideas()\n        call_args = mock_run.call_args\n        cmd = call_args[0][0]\n        prompt_idx = cmd.index(\"-p\")\n        prompt = cmd[prompt_idx + 1]\n        assert \"RECENTLY COMPLETED\" not in prompt\n\n    @patch(\"task_discovery.run_with_group_kill\")\n    def test_custom_discovery_prompt(self, mock_run, tmp_path, default_config):\n        \"\"\"Custom discovery_prompt replaces default focus areas.\"\"\"\n        default_config.target_dir = str(tmp_path)\n        default_config.discovery.discovery_prompt = \"- Security vulnerabilities\\n- API design\\n\"\n        disc = TaskDiscovery(default_config)\n        mock_run.return_value = _run_result(\n            returncode=0,\n            stdout='{\"result\": \"IDEA: Fix SQL injection vulnerability\"}',\n        )\n        disc._discover_claude_ideas()\n        call_args = mock_run.call_args\n        cmd = call_args[0][0]\n        prompt_idx = cmd.index(\"-p\")\n        prompt = cmd[prompt_idx + 1]\n        assert \"Security vulnerabilities\" in prompt\n        assert \"API design\" in prompt\n        # Default focus areas should not be present\n        assert \"New features or functionality\" not in prompt\n","numLines":647,"startLine":120,"totalLines":766}}}
