{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_vrtx_01UTyWUtDYbTz3Vzoe1638gM","type":"tool_result","content":"     1→\"\"\"Auto-discover tasks from the target project (test failures, lint, TODOs, etc.).\"\"\"\n     2→\n     3→from __future__ import annotations\n     4→\n     5→import ast\n     6→import json\n     7→import logging\n     8→import os\n     9→import re\n    10→import time\n    11→from dataclasses import dataclass, field\n    12→from pathlib import Path\n    13→from typing import List, Optional\n    14→\n    15→from config_schema import Config\n    16→from process_utils import run_with_group_kill\n    17→\n    18→logger = logging.getLogger(__name__)\n    19→\n    20→\n    21→def _extract_json_text(raw_output: str) -> str:\n    22→    \"\"\"Extract text content from Claude CLI JSON output.\n    23→\n    24→    Parses JSON objects from the raw output using multiple strategies\n    25→    (line-by-line, multi-line, raw_decode) and extracts the 'result' or\n    26→    'result_text' field.  Returns the extracted text, or the original\n    27→    raw_output if extraction fails.\n    28→\n    29→    This is a shared utility that reduces duplication between\n    30→    task_discovery._discover_claude_ideas() and\n    31→    claude_runner._parse_json_response().\n    32→    \"\"\"\n    33→    def _text_from_dict(d: dict) -> str:\n    34→        for key in (\"result\", \"result_text\"):\n    35→            val = d.get(key)\n    36→            if isinstance(val, str) and val.strip():\n    37→                return val\n    38→        return \"\"\n    39→\n    40→    try:\n    41→        lines = raw_output.strip().splitlines()\n    42→\n    43→        # Strategy 1: Try each line individually as a complete JSON object\n    44→        for line in lines:\n    45→            stripped = line.strip()\n    46→            if not stripped.startswith(\"{\"):\n    47→                continue\n    48→            try:\n    49→                data = json.loads(stripped)\n    50→                if isinstance(data, dict):\n    51→                    text = _text_from_dict(data)\n    52→                    if text:\n    53→                        return text\n    54→            except (json.JSONDecodeError, TypeError):\n    55→                continue\n    56→\n    57→        # Strategy 2: Try multi-line JSON joining from each '{'-starting line\n    58→        for i, line in enumerate(lines):\n    59→            if not line.strip().startswith(\"{\"):\n    60→                continue\n    61→            try:\n    62→                data = json.loads(\"\\n\".join(lines[i:]))\n    63→                if isinstance(data, dict):\n    64→                    text = _text_from_dict(data)\n    65→                    if text:\n    66→                        return text\n    67→            except (json.JSONDecodeError, TypeError):\n    68→                continue\n    69→\n    70→        # Strategy 3: Use raw_decode to find JSON anywhere in the output\n    71→        decoder = json.JSONDecoder()\n    72→        for i, ch in enumerate(raw_output):\n    73→            if ch != \"{\":\n    74→                continue\n    75→            try:\n    76→                obj, _ = decoder.raw_decode(raw_output, i)\n    77→                if isinstance(obj, dict):\n    78→                    text = _text_from_dict(obj)\n    79→                    if text:\n    80→                        return text\n    81→            except (json.JSONDecodeError, TypeError):\n    82→                continue\n    83→    except Exception:\n    84→        pass\n    85→\n    86→    return raw_output\n    87→\n    88→\n    89→# Map file extensions to their comment prefix styles\n    90→_COMMENT_PREFIXES = {\n    91→    \".py\": (\"#\",), \".rb\": (\"#\",),\n    92→    \".js\": (\"//\", \"/*\"), \".ts\": (\"//\", \"/*\"),\n    93→    \".jsx\": (\"//\", \"/*\"), \".tsx\": (\"//\", \"/*\"),\n    94→    \".go\": (\"//\", \"/*\"), \".rs\": (\"//\", \"/*\"),\n    95→    \".java\": (\"//\", \"/*\"),\n    96→}\n    97→\n    98→# Regex to match string literals (double-quoted and single-quoted, with escapes)\n    99→_STRING_LITERAL_RE = re.compile(r'''\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^'\\\\]|\\\\.)*' '''.strip())\n   100→\n   101→MAX_TASK_DESCRIPTION_LENGTH = 2000\n   102→MAX_TASK_CONTEXT_LENGTH = 12000\n   103→\n   104→# Default timeout for _discover_todos file walk (seconds)\n   105→TODO_SCAN_TIMEOUT = 60\n   106→\n   107→_FILE_REF_RE = re.compile(\n   108→    r'`([a-zA-Z0-9_/.\\-]+\\.(?:py|js|ts|tsx|jsx|go|rs|java|rb|sh|yaml|yml|json|md|txt))'\n   109→    r'(?::(\\d+))?(?:-\\d+)?`'\n   110→)\n   111→_FILE_REF_FALLBACK_RE = re.compile(\n   112→    r'(?:in\\s+|for\\s+)([a-zA-Z0-9_/.\\-]+\\.(?:py|js|ts|tsx|jsx|go|rs|java|rb|sh|yaml|yml|json|md|txt))'\n   113→    r'(?::(\\d+))?'\n   114→)\n   115→\n   116→\n   117→def _sanitize_description(desc: str) -> str:\n   118→    \"\"\"Sanitize a task description: strip, collapse newlines, and truncate.\"\"\"\n   119→    desc = desc.strip()\n   120→    desc = desc.replace(\"\\n\", \" \").replace(\"\\r\", \" \")\n   121→    if len(desc) > MAX_TASK_DESCRIPTION_LENGTH:\n   122→        desc = desc[:MAX_TASK_DESCRIPTION_LENGTH] + \"...\"\n   123→    return desc\n   124→\n   125→\n   126→def _extract_comment_text(line: str, ext: str) -> Optional[str]:\n   127→    \"\"\"Strip string literals from *line*, then return the comment body if a\n   128→    comment prefix for *ext* is found.  Returns ``None`` when no comment is\n   129→    detected.\"\"\"\n   130→    prefixes = _COMMENT_PREFIXES.get(ext)\n   131→    if not prefixes:\n   132→        return None\n   133→\n   134→    # Remove string literals so that a '#' or '//' inside a string is ignored\n   135→    stripped = _STRING_LITERAL_RE.sub(\"\", line)\n   136→\n   137→    # Find the earliest comment prefix in the stripped line\n   138→    earliest_pos = None\n   139→    earliest_prefix = None\n   140→    for pfx in prefixes:\n   141→        pos = stripped.find(pfx)\n   142→        if pos != -1 and (earliest_pos is None or pos < earliest_pos):\n   143→            earliest_pos = pos\n   144→            earliest_prefix = pfx\n   145→\n   146→    if earliest_pos is None:\n   147→        return None\n   148→\n   149→    # Return the text after the comment prefix\n   150→    return stripped[earliest_pos + len(earliest_prefix):]\n   151→\n   152→\n   153→@dataclass\n   154→class Task:\n   155→    description: str\n   156→    priority: int  # 1 = highest (feedback), 5 = lowest (quality review)\n   157→    source: str  # \"test_failure\", \"lint\", \"todo\", \"coverage\", \"quality\", \"feedback\"\n   158→    source_file: Optional[str] = None  # file path for feedback tasks\n   159→    line_number: Optional[int] = None\n   160→    context: str = \"\"  # rich context: tracebacks, file snippets, error details\n   161→    task_id: str = \"\"\n   162→    depends_on: List[str] = field(default_factory=list)\n   163→\n   164→    def __post_init__(self):\n   165→        self.description = _sanitize_description(self.description)\n   166→        if len(self.context) > MAX_TASK_CONTEXT_LENGTH:\n   167→            self.context = self.context[:MAX_TASK_CONTEXT_LENGTH] + \"\\n... (truncated)\"\n   168→        if not self.task_id:\n   169→            self.task_id = self.task_key\n   170→\n   171→    @property\n   172→    def task_key(self) -> str:\n   173→        \"\"\"Stable dedup key — same underlying issue produces the same key.\"\"\"\n   174→        if self.source == \"todo\" and self.source_file:\n   175→            if self.line_number is not None:\n   176→                return f\"todo:{self.source_file}:{self.line_number}\"\n   177→            return f\"todo:{self.source_file}\"\n   178→\n   179→        if self.source in (\"lint\", \"test_failure\", \"quality\", \"coverage\") and self.source_file:\n   180→            return f\"{self.source}:{self.source_file}\"\n   181→\n   182→        if self.source == \"coverage\":\n   183→            match = re.search(r'for\\s+(\\S+)', self.description)\n   184→            if match:\n   185→                return f\"coverage:{match.group(1)}\"\n   186→\n   187→        if self.source == \"claude_idea\":\n   188→            match = _FILE_REF_RE.search(self.description)\n   189→            if match:\n   190→                return f\"claude_idea:{match.group(1)}\"\n   191→            match = _FILE_REF_FALLBACK_RE.search(self.description)\n   192→            if match:\n   193→                return f\"claude_idea:{match.group(1)}\"\n   194→            return f\"claude_idea:{self.description[:60]}\"\n   195→\n   196→        if self.source == \"feedback\" and self.source_file:\n   197→            return f\"feedback:{self.source_file}\"\n   198→\n   199→        if self.source == \"test_failure\":\n   200→            match = re.search(r'FAILED\\s+(\\S+)', self.description)\n   201→            if match:\n   202→                return f\"test_failure:{match.group(1)}\"\n   203→\n   204→        return f\"{self.source}:{self.description}\"\n   205→\n   206→\n   207→class TaskDiscovery:\n   208→    def __init__(self, config: Config, state_manager=None):\n   209→        self.config = config\n   210→        self.target_dir = config.target_dir\n   211→        self.state_manager = state_manager\n   212→        self._last_idea_discovery_time: float = 0.0\n   213→\n   214→    def discover_all(self) -> List[Task]:\n   215→        \"\"\"Run all enabled discovery strategies and return sorted tasks.\"\"\"\n   216→        tasks: List[Task] = []\n   217→        dc = self.config.discovery\n   218→\n   219→        if dc.enable_test_failures:\n   220→            tasks.extend(self._discover_test_failures())\n   221→\n   222→        if dc.enable_lint_errors:\n   223→            tasks.extend(self._discover_lint_errors())\n   224→\n   225→        if dc.enable_todos:\n   226→            tasks.extend(self._discover_todos())\n   227→\n   228→        if dc.enable_coverage:\n   229→            tasks.extend(self._discover_coverage_gaps())\n   230→\n   231→        if dc.enable_claude_ideas:\n   232→            tasks.extend(self._discover_claude_ideas())\n   233→\n   234→        if dc.enable_quality_review:\n   235→            tasks.extend(self._discover_quality_issues())\n   236→\n   237→        if dc.enable_complexity_check:\n   238→            tasks.extend(self._discover_complexity_issues())\n   239→\n   240→        if dc.enable_import_check:\n   241→            tasks.extend(self._discover_import_issues())\n   242→\n   243→        # Group related tasks to avoid duplicate work\n   244→        tasks = self._group_related_tasks(tasks)\n   245→\n   246→        # Boost priority for historically high-success-rate sources\n   247→        if self.state_manager and dc.adaptive_priority and tasks:\n   248→            try:\n   249→                performance = self.state_manager.get_strategy_performance(lookback_seconds=86400)\n   250→                if performance:\n   251→                    for task in tasks:\n   252→                        perf = performance.get(task.source)\n   253→                        if perf and perf.get(\"total\", 0) >= 2:\n   254→                            success_rate = perf.get(\"success_rate\", 0.0)\n   255→                            if success_rate > 0.5:\n   256→                                # Higher success rate -> lower priority number (higher priority)\n   257→                                # e.g., 90% success -> priority reduced by 2\n   258→                                boost = int(success_rate * 3)  # 0-3 boost\n   259→                                task.priority = max(1, task.priority - boost)\n   260→            except Exception as e:\n   261→                logger.debug(\"Strategy performance boosting failed: %s\", e)\n   262→\n   263→        # Sort by priority (lower number = higher priority)\n   264→        tasks.sort(key=lambda t: t.priority)\n   265→        return tasks\n   266→\n   267→    def _group_related_tasks(self, tasks: List[Task]) -> List[Task]:\n   268→        \"\"\"Group related tasks by file path to avoid duplicate work.\n   269→\n   270→        When multiple tasks share the same source file (e.g., multiple test\n   271→        failures in the same file, or multiple lint errors in the same file),\n   272→        they likely share a root cause. This method keeps only the first\n   273→        (highest-priority) task per file for each source type, reducing\n   274→        wasted cycles on tasks that will auto-resolve when the root cause\n   275→        is fixed.\n   276→\n   277→        Tasks without a source_file are always kept.\n   278→        \"\"\"\n   279→        from collections import defaultdict\n   280→\n   281→        # Group by (source, source_file) — only group when source_file is set\n   282→        grouped: dict = defaultdict(list)\n   283→        ungrouped: List[Task] = []\n   284→\n   285→        for task in tasks:\n   286→            if task.source_file and task.source in (\"test_failure\", \"lint\", \"todo\"):\n   287→                key = (task.source, task.source_file)\n   288→                grouped[key].append(task)\n   289→            else:\n   290→                ungrouped.append(task)\n   291→\n   292→        result: List[Task] = list(ungrouped)\n   293→        for key, group in grouped.items():\n   294→            # Sort by priority (lower = better), keep the representative task\n   295→            group.sort(key=lambda t: t.priority)\n   296→            representative = group[0]\n   297→            if len(group) > 1:\n   298→                # Enrich the representative's description with count\n   299→                representative.description = (\n   300→                    f\"{representative.description} \"\n   301→                    f\"(+{len(group) - 1} related in {key[1]})\"\n   302→                )\n   303→            result.append(representative)\n   304→\n   305→        return result\n   306→\n   307→    # Regex to extract file path and line number from pytest traceback lines\n   308→    # Matches patterns like \"tests/test_foo.py:5: AssertionError\"\n   309→    _TRACEBACK_LOC_RE = re.compile(\n   310→        r'^(\\S+\\.py):(\\d+):\\s+\\w+(?:Error|Exception|Warning)'\n   311→    )\n   312→\n   313→    def _extract_test_traceback(self, full_output: str, test_id: str) -> str:\n   314→        \"\"\"Extract the traceback section for a specific test from pytest output.\n   315→\n   316→        Includes assertion details (lines starting with 'E') and ensures the\n   317→        last 5 lines of the traceback are always present.\n   318→        \"\"\"\n   319→        if not test_id:\n   320→            return \"\"\n   321→        lines = full_output.split(\"\\n\")\n   322→        collecting = False\n   323→        result_lines: List[str] = []\n   324→        assertion_lines: List[str] = []\n   325→        for line in lines:\n   326→            if test_id in line and (\"FAILED\" in line or \"ERROR\" in line or \"___\" in line):\n   327→                collecting = True\n   328→                result_lines = [line]\n   329→                assertion_lines = []\n   330→                continue\n   331→            if collecting:\n   332→                if (line.startswith(\"___\") and test_id not in line) or \\\n   333→                   line.startswith(\"=\") or \\\n   334→                   (line.startswith(\"FAILED \") and test_id not in line):\n   335→                    break\n   336→                result_lines.append(line)\n   337→                # Collect assertion detail lines (pytest prefixes them with 'E')\n   338→                stripped = line.lstrip()\n   339→                if stripped.startswith(\"E \") or stripped.startswith(\"E\\t\"):\n   340→                    assertion_lines.append(line)\n   341→\n   342→        if not result_lines:\n   343→            return \"\"\n   344→\n   345→        # Ensure the last 5 lines of the traceback are included\n   346→        # (they typically contain the assertion and location info)\n   347→        traceback_text = \"\\n\".join(result_lines)\n   348→        if len(result_lines) > 5:\n   349→            last_5 = \"\\n\".join(result_lines[-5:])\n   350→            # If assertion lines exist but aren't in last 5 lines, append them\n   351→            if assertion_lines:\n   352→                for aline in assertion_lines:\n   353→                    if aline not in result_lines[-5:]:\n   354→                        traceback_text += \"\\n\" + aline\n   355→\n   356→        return traceback_text\n   357→\n   358→    def _extract_traceback_location(self, traceback_text: str) -> tuple:\n   359→        \"\"\"Extract file path and line number from a pytest traceback.\n   360→\n   361→        Returns (source_file, line_number) or (None, None) if not found.\n   362→        \"\"\"\n   363→        if not traceback_text:\n   364→            return None, None\n   365→        # Search for the last file:line pattern in the traceback\n   366→        # (the last one is typically the failing assertion location)\n   367→        last_match = None\n   368→        for line in traceback_text.split(\"\\n\"):\n   369→            line = line.strip()\n   370→            m = self._TRACEBACK_LOC_RE.match(line)\n   371→            if m:\n   372→                last_match = m\n   373→        if last_match:\n   374→            return last_match.group(1), int(last_match.group(2))\n   375→        return None, None\n   376→\n   377→    def _read_file_snippet(self, filepath: str, line_num: int, context_lines: int = 5) -> str:\n   378→        \"\"\"Read a snippet of a file around the given line number.\"\"\"\n   379→        try:\n   380→            fpath = Path(filepath)\n   381→            if not fpath.is_absolute():\n   382→                fpath = Path(self.target_dir) / filepath\n   383→            if not fpath.exists():\n   384→                return \"\"\n   385→            content = fpath.read_text(errors=\"ignore\")\n   386→            lines = content.split(\"\\n\")\n   387→            start = max(0, line_num - context_lines - 1)\n   388→            end = min(len(lines), line_num + context_lines)\n   389→            numbered = []\n   390→            for i, line in enumerate(lines[start:end], start + 1):\n   391→                marker = \" >> \" if i == line_num else \"    \"\n   392→                numbered.append(f\"{marker}{i:4d} | {line}\")\n   393→            return \"\\n\".join(numbered)\n   394→        except OSError:\n   395→            return \"\"\n   396→\n   397→    def _enrich_task_context(self, task: 'Task') -> None:\n   398→        \"\"\"Populate a task's context with code snippets from file references in its description.\"\"\"\n   399→        # Try primary regex, then fallback\n   400→        match = _FILE_REF_RE.search(task.description)\n   401→        if not match:\n   402→            match = _FILE_REF_FALLBACK_RE.search(task.description)\n   403→        if not match:\n   404→            return\n   405→\n   406→        filepath = match.group(1)\n   407→        line_num = int(match.group(2)) if match.group(2) else 1\n   408→        snippet = self._read_file_snippet(filepath, line_num, context_lines=5)\n   409→        if snippet:\n   410→            task.context = f\"File: {filepath}\\n{snippet}\"\n   411→            task.source_file = filepath\n   412→            if match.group(2):\n   413→                task.line_number = line_num\n   414→\n   415→    def _discover_test_failures(self) -> List[Task]:\n   416→        \"\"\"Run pytest and parse failures.\"\"\"\n   417→        test_cmd = self.config.validation.test_command\n   418→        if not test_cmd.strip():\n   419→            return []\n   420→\n   421→        try:\n   422→            result = run_with_group_kill(\n   423→                test_cmd,\n   424→                shell=True,\n   425→                cwd=self.target_dir,\n   426→                timeout=self.config.validation.test_timeout,\n   427→            )\n   428→        except OSError as e:\n   429→            logger.warning(\"Test discovery failed: %s\", e)\n   430→            return []\n   431→\n   432→        if result.timed_out:\n   433→            logger.warning(\"Test discovery timed out after %ds\", self.config.validation.test_timeout)\n   434→            return []\n   435→\n   436→        if result.returncode == 0:\n   437→            return []\n   438→\n   439→        # Capture full output for context\n   440→        full_output = result.stdout\n   441→        if result.stderr.strip():\n   442→            full_output += \"\\n\" + result.stderr\n   443→\n   444→        # Parse pytest output for FAILED lines\n   445→        tasks = []\n   446→        for line in result.stdout.split(\"\\n\"):\n   447→            line = line.strip()\n   448→            if line.startswith(\"FAILED\"):\n   449→                # e.g. \"FAILED tests/test_foo.py::test_bar - AssertionError: ...\"\n   450→                desc = f\"Fix test failure: {line}\"\n   451→                # Extract test identifier for per-test traceback\n   452→                parts = line.split()\n   453→                test_id = parts[1] if len(parts) > 1 else \"\"\n   454→                per_test_ctx = self._extract_test_traceback(full_output, test_id)\n   455→                # Extract file path and line number from the traceback\n   456→                src_file, src_line = self._extract_traceback_location(per_test_ctx)\n   457→                tasks.append(Task(\n   458→                    description=desc,\n   459→                    priority=2,\n   460→                    source=\"test_failure\",\n   461→                    source_file=src_file,\n   462→                    line_number=src_line,\n   463→                    context=per_test_ctx if per_test_ctx else full_output,\n   464→                ))\n   465→\n   466→        # If we got failures but couldn't parse individual ones, create a generic task\n   467→        if result.returncode != 0 and not tasks:\n   468→            tasks.append(Task(\n   469→                description=f\"Fix test failures (exit code {result.returncode})\",\n   470→                priority=2,\n   471→                source=\"test_failure\",\n   472→                context=full_output,\n   473→            ))\n   474→\n   475→        return tasks\n   476→\n   477→    def _discover_lint_errors(self) -> List[Task]:\n   478→        \"\"\"Run lint command and parse errors.\"\"\"\n   479→        lint_cmd = self.config.validation.lint_command\n   480→        if not lint_cmd.strip():\n   481→            return []\n   482→\n   483→        try:\n   484→            result = run_with_group_kill(\n   485→                lint_cmd,\n   486→                shell=True,\n   487→                cwd=self.target_dir,\n   488→                timeout=self.config.validation.lint_timeout,\n   489→            )\n   490→        except OSError as e:\n   491→            logger.warning(\"Lint discovery failed: %s\", e)\n   492→            return []\n   493→\n   494→        if result.timed_out:\n   495→            logger.warning(\"Lint discovery timed out after %ds\", self.config.validation.lint_timeout)\n   496→            return []\n   497→\n   498→        if result.returncode == 0:\n   499→            return []\n   500→\n   501→        # Try to parse ruff JSON output\n   502→        output = result.stdout.strip()\n   503→        try:\n   504→            errors = json.loads(output)\n   505→            if isinstance(errors, list):\n   506→                tasks = []\n   507→                for err in errors[:10]:  # Cap at 10 lint errors\n   508→                    filename = err.get(\"filename\", \"unknown\")\n   509→                    message = err.get(\"message\", \"lint error\")\n   510→                    code = err.get(\"code\", \"\")\n   511→                    line_num = err.get(\"location\", {}).get(\"row\", 0)\n   512→                    desc = f\"Fix lint error in {filename}: [{code}] {message}\"\n   513→                    # Build context: snippet around the error line\n   514→                    context = \"\"\n   515→                    if line_num > 0:\n   516→                        context = self._read_file_snippet(filename, line_num, context_lines=5)\n   517→                    tasks.append(Task(\n   518→                        description=desc,\n   519→                        priority=2,\n   520→                        source=\"lint\",\n   521→                        source_file=filename,\n   522→                        line_number=line_num if line_num > 0 else None,\n   523→                        context=context,\n   524→                    ))\n   525→                return tasks\n   526→        except (json.JSONDecodeError, TypeError):\n   527→            pass\n   528→\n   529→        # Fallback: generic lint error task\n   530→        return [Task(\n   531→            description=\"Fix lint errors\",\n   532→            priority=2,\n   533→            source=\"lint\",\n   534→        )]\n   535→\n   536→    def _discover_todos(self, timeout: int = TODO_SCAN_TIMEOUT) -> List[Task]:\n   537→        \"\"\"Scan source files for TODO/FIXME/HACK comments.\n   538→\n   539→        Args:\n   540→            timeout: Maximum time in seconds for the file walk operation.\n   541→                     If exceeded, returns whatever tasks were found so far.\n   542→        \"\"\"\n   543→        tasks = []\n   544→        patterns = self.config.discovery.todo_patterns\n   545→        exclude_dirs = set(self.config.discovery.exclude_dirs)\n   546→\n   547→        if not patterns:\n   548→            return []\n   549→\n   550→        escaped = \"|\".join(re.escape(p) for p in patterns)\n   551→        keyword_pat = r\"^\\s*(\" + escaped + r\")\\b\"\n   552→        keyword_re = re.compile(keyword_pat, re.IGNORECASE)\n   553→\n   554→        target = Path(self.target_dir)\n   555→        deadline = time.monotonic() + timeout\n   556→        timed_out = False\n   557→        files_scanned = 0\n   558→        for root, dirs, files in os.walk(target):\n   559→            # Check deadline at the start of each directory\n   560→            if time.monotonic() > deadline:\n   561→                timed_out = True\n   562→                break\n   563→\n   564→            # Filter out excluded directories\n   565→            dirs[:] = [d for d in dirs if d not in exclude_dirs]\n   566→\n   567→            for fname in files:\n   568→                # Check deadline periodically (every file)\n   569→                if time.monotonic() > deadline:\n   570→                    timed_out = True\n   571→                    break\n   572→\n   573→                ext = Path(fname).suffix\n   574→                if ext not in _COMMENT_PREFIXES:\n   575→                    continue\n   576→\n   577→                fpath = Path(root) / fname\n   578→                rel_path = str(fpath.relative_to(target))\n   579→\n   580→                try:\n   581→                    content = fpath.read_text(errors=\"ignore\")\n   582→                except OSError:\n   583→                    continue\n   584→\n   585→                files_scanned += 1\n   586→\n   587→                for i, line in enumerate(content.split(\"\\n\"), 1):\n   588→                    comment_text = _extract_comment_text(line, ext)\n   589→                    if comment_text is None:\n   590→                        continue\n   591→                    match = keyword_re.search(comment_text)\n   592→                    if match:\n   593→                        comment = line.strip()\n   594→                        if len(comment) > 120:\n   595→                            comment = comment[:120] + \"...\"\n   596→                        desc = f\"Address {match.group(1)} in {rel_path}:{i}: {comment}\"\n   597→                        context = self._read_file_snippet(str(fpath), i, context_lines=5)\n   598→                        tasks.append(Task(\n   599→                            description=desc,\n   600→                            priority=3,\n   601→                            source=\"todo\",\n   602→                            source_file=rel_path,\n   603→                            line_number=i,\n   604→                            context=context,\n   605→                        ))\n   606→\n   607→            if timed_out:\n   608→                break\n   609→\n   610→        if timed_out:\n   611→            logger.warning(\n   612→                \"TODO scan timed out after %ds (scanned %d files, found %d tasks)\",\n   613→                timeout, files_scanned, len(tasks),\n   614→            )\n   615→\n   616→        return tasks[:self.config.discovery.max_todo_tasks]\n   617→\n   618→    def _discover_claude_ideas(self) -> List[Task]:\n   619→        \"\"\"Use Claude to analyze the codebase and suggest improvement ideas.\n   620→\n   621→        Invokes Claude CLI in read-only analysis mode with a low max-turns\n   622→        to keep cost down. Parses the response for actionable improvement tasks.\n   623→        \"\"\"\n   624→        # Enforce idea generation cooldown to prevent excessive API costs\n   625→        cooldown = self.config.discovery.idea_cooldown_seconds\n   626→        if cooldown > 0:\n   627→            elapsed = time.time() - self._last_idea_discovery_time\n   628→            if self._last_idea_discovery_time > 0 and elapsed < cooldown:\n   629→                logger.debug(\n   630→                    \"Skipping claude_ideas discovery: %.0fs since last run, \"\n   631→                    \"cooldown is %ds\",\n   632→                    elapsed, cooldown,\n   633→                )\n   634→                return []\n   635→\n   636→        cc = self.config.claude\n   637→        if self.config.discovery.discovery_prompt:\n   638→            focus_section = self.config.discovery.discovery_prompt\n   639→        else:\n   640→            focus_section = (\n   641→                \"- New features or functionality that would add value\\n\"\n   642→                \"- Missing tests for important functionality\\n\"\n   643→                \"- Bug risks or edge cases that could cause failures\\n\"\n   644→                \"- Performance improvements\\n\"\n   645→                \"- Code clarity or maintainability improvements\\n\"\n   646→            )\n   647→\n   648→        history_section = \"\"\n   649→        if self.state_manager:\n   650→            recent = self.state_manager.get_recent_task_summaries(\n   651→                lookback_seconds=86400, max_items=15,\n   652→            )\n   653→            if recent:\n   654→                history_section = (\n   655→                    \"\\nRECENTLY COMPLETED TASKS (do NOT suggest similar improvements):\\n\"\n   656→                    + \"\\n\".join(recent)\n   657→                    + \"\\n\\nFocus on NEW areas that haven't been addressed recently.\\n\"\n   658→                )\n   659→\n   660→        prompt = (\n   661→            \"Analyze the codebase in the current directory. Identify up to 5 concrete, \"\n   662→            \"actionable improvements. Focus on:\\n\"\n   663→            + focus_section\n   664→            + history_section\n   665→            + \"\\nFor each improvement, output EXACTLY one line in this format:\\n\"\n   666→            \"IDEA: <one-sentence description of the improvement>\\n\\n\"\n   667→            \"Do NOT make any changes. Do NOT run git commands. Only analyze and output IDEA lines.\"\n   668→        )\n   669→\n   670→        cmd = [\n   671→            cc.command, \"-p\", prompt,\n   672→            \"--model\", self.config.discovery.discovery_model or self.config.claude.resolved_model,\n   673→            \"--max-turns\", str(self.config.discovery.discovery_max_turns),\n   674→            \"--output-format\", \"json\",\n   675→        ]\n   676→\n   677→        try:\n   678→            result = run_with_group_kill(\n   679→                cmd,\n   680→                cwd=self.target_dir,\n   681→                timeout=self.config.discovery.discovery_timeout,\n   682→            )\n   683→        except (FileNotFoundError, OSError) as e:\n   684→            logger.warning(\"Claude idea discovery failed: %s\", e)\n   685→            return []\n   686→\n   687→        if result is None:\n   688→            logger.warning(\"Claude idea discovery returned no result\")\n   689→            return []\n   690→\n   691→        if result.timed_out:\n   692→            logger.warning(\"Claude idea discovery timed out after %ds\",\n   693→                           self.config.discovery.discovery_timeout)\n   694→            return []\n   695→\n   696→        if result.returncode != 0:\n   697→            logger.warning(\"Claude idea discovery exited with code %d\", result.returncode)\n   698→            return []\n   699→\n   700→        # Parse JSON response to get result text\n   701→        result_text = result.stdout\n   702→\n   703→        # Check for error_max_turns in any JSON line\n   704→        try:\n   705→            for line in result_text.strip().splitlines():\n   706→                stripped = line.strip()\n   707→                if not stripped.startswith(\"{\"):\n   708→                    continue\n   709→                try:\n   710→                    data = json.loads(stripped)\n   711→                    if isinstance(data, dict) and data.get(\"subtype\") == \"error_max_turns\":\n   712→                        logger.warning(\n   713→                            \"Claude idea discovery hit max turns (%d); \"\n   714→                            \"increase discovery.discovery_max_turns\",\n   715→                            self.config.discovery.discovery_max_turns,\n   716→                        )\n   717→                        break\n   718→                except (json.JSONDecodeError, TypeError):\n   719→                    continue\n   720→        except Exception:\n   721→            pass\n   722→\n   723→        # Extract text content from JSON response\n   724→        result_text = _extract_json_text(result_text)\n   725→\n   726→        # Warn if we couldn't extract text from a JSON response\n   727→        if result_text == result.stdout and result.stdout.strip()[:1] in (\"{\", \"[\"):\n   728→            logger.warning(\n   729→                \"Claude idea response contained JSON but no text content \"\n   730→                \"could be extracted — falling back to raw text extraction\"\n   731→            )\n   732→\n   733→        # Extract IDEA lines\n   734→        MIN_IDEA_LENGTH = 10\n   735→        tasks = []\n   736→        for line in result_text.split(\"\\n\"):\n   737→            line = line.strip()\n   738→            if line.upper().startswith(\"IDEA:\"):\n   739→                desc = line[5:].strip()\n   740→                if desc and len(desc) >= MIN_IDEA_LENGTH:\n   741→                    tasks.append(Task(\n   742→                        description=desc,\n   743→                        priority=4,\n   744→                        source=\"claude_idea\",\n   745→                    ))\n   746→                elif desc:\n   747→                    logger.debug(\"Skipping short IDEA line: %r\", desc)\n   748→\n   749→        # Enrich tasks with file context from their descriptions\n   750→        for task in tasks:\n   751→            self._enrich_task_context(task)\n   752→\n   753→        logger.info(\"Claude discovered %d improvement ideas\", len(tasks))\n   754→        if not tasks and result_text.strip():\n   755→            # Attempt fallback extraction from analysis-format text\n   756→            lines = [l.strip() for l in result_text.split(\"\\n\") if l.strip()]\n   757→            for line in lines:\n   758→                # Match numbered items: \"1. ...\", \"2) ...\"\n   759→                m = re.match(r'^\\d+[.)]\\s+(.+)', line)\n   760→                if not m:\n   761→                    # Match bullet items: \"- ...\", \"* ...\", \"• ...\"\n   762→                    m = re.match(r'^[-*•]\\s+(.+)', line)\n   763→                if m:\n   764→                    desc = m.group(1).strip()\n   765→                    if desc and len(desc) >= MIN_IDEA_LENGTH:\n   766→                        tasks.append(Task(\n   767→                            description=desc,\n   768→                            priority=4,\n   769→                            source=\"claude_idea\",\n   770→                        ))\n   771→            # Enrich fallback tasks with file context\n   772→            for task in tasks:\n   773→                self._enrich_task_context(task)\n   774→            if tasks:\n   775→                logger.info(\n   776→                    \"Extracted %d tasks from analysis-format text \"\n   777→                    \"(no IDEA: prefixed lines found, used numbered/bullet fallback).\",\n   778→                    len(tasks),\n   779→                )\n   780→            else:\n   781→                logger.debug(\n   782→                    \"Claude response contained no IDEA lines and no extractable \"\n   783→                    \"analysis-format items (%d non-empty lines)\",\n   784→                    len(lines),\n   785→                )\n   786→        self._last_idea_discovery_time = time.time()\n   787→        return tasks[:5]\n   788→\n   789→    def _discover_coverage_gaps(self) -> List[Task]:\n   790→        \"\"\"Discover files with low test coverage (optional, requires pytest-cov).\"\"\"\n   791→        try:\n   792→            result = run_with_group_kill(\n   793→                \"python3 -m pytest --cov --cov-report=json --cov-report=term -q\",\n   794→                shell=True,\n   795→                cwd=self.target_dir,\n   796→                timeout=self.config.validation.test_timeout,\n   797→            )\n   798→        except OSError:\n   799→            return []\n   800→\n   801→        if result.timed_out:\n   802→            return []\n   803→\n   804→        cov_file = Path(self.target_dir) / \"coverage.json\"\n   805→        if not cov_file.exists():\n   806→            return []\n   807→\n   808→        try:\n   809→            data = json.loads(cov_file.read_text())\n   810→            files = data.get(\"files\", {})\n   811→            tasks = []\n   812→            for fname, info in files.items():\n   813→                pct = info.get(\"summary\", {}).get(\"percent_covered\", 100)\n   814→                if pct < 50:\n   815→                    desc = f\"Improve test coverage for {fname} (currently {pct:.0f}%)\"\n   816→                    tasks.append(Task(\n   817→                        description=desc,\n   818→                        priority=4,\n   819→                        source=\"coverage\",\n   820→                        source_file=fname,\n   821→                    ))\n   822→            return tasks[:10]\n   823→        except (json.JSONDecodeError, OSError):\n   824→            return []\n   825→\n   826→    def _discover_quality_issues(self) -> List[Task]:\n   827→        \"\"\"Review source files for general quality issues.\"\"\"\n   828→        tasks = []\n   829→        target = Path(self.target_dir)\n   830→        exclude_dirs = set(self.config.discovery.exclude_dirs)\n   831→\n   832→        for root, dirs, files in os.walk(target):\n   833→            dirs[:] = [d for d in dirs if d not in exclude_dirs]\n   834→\n   835→            for fname in files:\n   836→                if not fname.endswith(\".py\"):\n   837→                    continue\n   838→\n   839→                fpath = Path(root) / fname\n   840→                rel_path = str(fpath.relative_to(target))\n   841→\n   842→                try:\n   843→                    content = fpath.read_text(errors=\"ignore\")\n   844→                except OSError:\n   845→                    continue\n   846→\n   847→                lines = content.split(\"\\n\")\n   848→                # Flag very long files\n   849→                if len(lines) > 500:\n   850→                    tasks.append(Task(\n   851→                        description=f\"Review and potentially refactor {rel_path} ({len(lines)} lines)\",\n   852→                        priority=5,\n   853→                        source=\"quality\",\n   854→                        source_file=rel_path,\n   855→                    ))\n   856→\n   857→        return tasks[:5]\n   858→\n   859→    def _discover_import_issues(self) -> List[Task]:\n   860→        \"\"\"Scan Python files for unused imports using ast.parse.\n   861→\n   862→        Creates lint tasks with priority 3 for files with unused imports.\n   863→        Only scans files not in exclude_dirs.\n   864→        \"\"\"\n   865→        tasks: List[Task] = []\n   866→        target = Path(self.target_dir)\n   867→        exclude_dirs = set(self.config.discovery.exclude_dirs)\n   868→\n   869→        for root, dirs, files in os.walk(target):\n   870→            dirs[:] = [d for d in dirs if d not in exclude_dirs]\n   871→\n   872→            for fname in files:\n   873→                if not fname.endswith(\".py\"):\n   874→                    continue\n   875→\n   876→                fpath = Path(root) / fname\n   877→                rel_path = str(fpath.relative_to(target))\n   878→\n   879→                try:\n   880→                    source = fpath.read_text(errors=\"ignore\")\n   881→                    tree = ast.parse(source, filename=rel_path)\n   882→                except (OSError, SyntaxError):\n   883→                    continue\n   884→\n   885→                unused = self._find_unused_imports(tree)\n   886→                if unused:\n   887→                    import_list = \", \".join(unused[:5])\n   888→                    if len(unused) > 5:\n   889→                        import_list += f\" (+{len(unused) - 5} more)\"\n   890→                    desc = (\n   891→                        f\"Remove {len(unused)} unused import(s) in \"\n   892→                        f\"`{rel_path}`: {import_list}\"\n   893→                    )\n   894→                    # Use the line number of the first unused import\n   895→                    first_line = None\n   896→                    for node in ast.walk(tree):\n   897→                        if isinstance(node, (ast.Import, ast.ImportFrom)):\n   898→                            for alias in node.names:\n   899→                                name = alias.asname if alias.asname else alias.name\n   900→                                if name in unused:\n   901→                                    first_line = node.lineno\n   902→                                    break\n   903→                        if first_line:\n   904→                            break\n   905→                    tasks.append(Task(\n   906→                        description=desc,\n   907→                        priority=3,\n   908→                        source=\"lint\",\n   909→                        source_file=rel_path,\n   910→                        line_number=first_line,\n   911→                    ))\n   912→\n   913→                if len(tasks) >= 10:\n   914→                    return tasks[:10]\n   915→\n   916→        return tasks[:10]\n   917→\n   918→    def _find_unused_imports(self, tree: ast.AST) -> List[str]:\n   919→        \"\"\"Find imported names that are never used in the module body.\n   920→\n   921→        Returns a list of unused import names. Skips __all__ exports,\n   922→        __init__.py re-exports, and names used in type annotations.\n   923→        \"\"\"\n   924→        imported: dict = {}  # name -> ast node\n   925→\n   926→        for node in ast.iter_child_nodes(tree):\n   927→            if isinstance(node, ast.Import):\n   928→                for alias in node.names:\n   929→                    name = alias.asname if alias.asname else alias.name\n   930→                    # For dotted imports like 'os.path', the bound name is 'os'\n   931→                    if \".\" in name and not alias.asname:\n   932→                        name = name.split(\".\")[0]\n   933→                    imported[name] = node\n   934→            elif isinstance(node, ast.ImportFrom):\n   935→                # Skip 'from __future__ import ...'\n   936→                if node.module and node.module == \"__future__\":\n   937→                    continue\n   938→                for alias in node.names:\n   939→                    if alias.name == \"*\":\n   940→                        continue\n   941→                    name = alias.asname if alias.asname else alias.name\n   942→                    imported[name] = node\n   943→\n   944→        if not imported:\n   945→            return []\n   946→\n   947→        # Check if __all__ is defined — if so, exports count as usage\n   948→        for node in ast.iter_child_nodes(tree):\n   949→            if isinstance(node, ast.Assign):\n   950→                for target in node.targets:\n   951→                    if isinstance(target, ast.Name) and target.id == \"__all__\":\n   952→                        # All imports could be re-exports; skip this file\n   953→                        return []\n   954→\n   955→        # Collect all names used in the module (excluding the import statements)\n   956→        used_names: set = set()\n   957→        for node in ast.walk(tree):\n   958→            if isinstance(node, ast.Name):\n   959→                used_names.add(node.id)\n   960→            elif isinstance(node, ast.Attribute):\n   961→                # For 'os.path.join', the Name node 'os' is already captured\n   962→                pass\n   963→\n   964→        # An import is unused if its bound name never appears as a Name node\n   965→        # outside the import statement itself\n   966→        unused = []\n   967→        for name in imported:\n   968→            if name not in used_names:\n   969→                unused.append(name)\n   970→\n   971→        return sorted(unused)\n   972→\n   973→    def _discover_complexity_issues(self) -> List[Task]:\n   974→        \"\"\"Scan Python files for functions longer than 50 lines using ast.parse.\"\"\"\n   975→        tasks: List[Task] = []\n   976→        target = Path(self.target_dir)\n   977→        exclude_dirs = set(self.config.discovery.exclude_dirs)\n   978→\n   979→        for root, dirs, files in os.walk(target):\n   980→            dirs[:] = [d for d in dirs if d not in exclude_dirs]\n   981→\n   982→            for fname in files:\n   983→                if not fname.endswith(\".py\"):\n   984→                    continue\n   985→\n   986→                fpath = Path(root) / fname\n   987→                rel_path = str(fpath.relative_to(target))\n   988→\n   989→                try:\n   990→                    source = fpath.read_text(errors=\"ignore\")\n   991→                    tree = ast.parse(source, filename=rel_path)\n   992→                except (OSError, SyntaxError):\n   993→                    continue\n   994→\n   995→                for node in ast.walk(tree):\n   996→                    if not isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):\n   997→                        continue\n   998→                    start = node.lineno\n   999→                    end = node.end_lineno\n  1000→                    if end is None:\n  1001→                        continue\n  1002→                    line_count = end - start + 1\n  1003→                    if line_count > 50:\n  1004→                        desc = (\n  1005→                            f\"Refactor long function `{node.name}` in \"\n  1006→                            f\"`{rel_path}:{start}` ({line_count} lines)\"\n  1007→                        )\n  1008→                        tasks.append(Task(\n  1009→                            description=desc,\n  1010→                            priority=5,\n  1011→                            source=\"quality\",\n  1012→                            source_file=rel_path,\n  1013→                            line_number=start,\n  1014→                        ))\n  1015→\n  1016→                if len(tasks) >= 5:\n  1017→                    return tasks[:5]\n  1018→\n  1019→        return tasks[:5]\n  1020→"}]},"parent_tool_use_id":null,"session_id":"d9fba966-4860-4119-b801-4c04b623dcec","uuid":"0dfab23a-e172-4ebc-b452-34a62af95fc0","tool_use_result":{"type":"text","file":{"filePath":"/Users/sameertkhanna/Documents/auto_claude_code/task_discovery.py","content":"\"\"\"Auto-discover tasks from the target project (test failures, lint, TODOs, etc.).\"\"\"\n\nfrom __future__ import annotations\n\nimport ast\nimport json\nimport logging\nimport os\nimport re\nimport time\nfrom dataclasses import dataclass, field\nfrom pathlib import Path\nfrom typing import List, Optional\n\nfrom config_schema import Config\nfrom process_utils import run_with_group_kill\n\nlogger = logging.getLogger(__name__)\n\n\ndef _extract_json_text(raw_output: str) -> str:\n    \"\"\"Extract text content from Claude CLI JSON output.\n\n    Parses JSON objects from the raw output using multiple strategies\n    (line-by-line, multi-line, raw_decode) and extracts the 'result' or\n    'result_text' field.  Returns the extracted text, or the original\n    raw_output if extraction fails.\n\n    This is a shared utility that reduces duplication between\n    task_discovery._discover_claude_ideas() and\n    claude_runner._parse_json_response().\n    \"\"\"\n    def _text_from_dict(d: dict) -> str:\n        for key in (\"result\", \"result_text\"):\n            val = d.get(key)\n            if isinstance(val, str) and val.strip():\n                return val\n        return \"\"\n\n    try:\n        lines = raw_output.strip().splitlines()\n\n        # Strategy 1: Try each line individually as a complete JSON object\n        for line in lines:\n            stripped = line.strip()\n            if not stripped.startswith(\"{\"):\n                continue\n            try:\n                data = json.loads(stripped)\n                if isinstance(data, dict):\n                    text = _text_from_dict(data)\n                    if text:\n                        return text\n            except (json.JSONDecodeError, TypeError):\n                continue\n\n        # Strategy 2: Try multi-line JSON joining from each '{'-starting line\n        for i, line in enumerate(lines):\n            if not line.strip().startswith(\"{\"):\n                continue\n            try:\n                data = json.loads(\"\\n\".join(lines[i:]))\n                if isinstance(data, dict):\n                    text = _text_from_dict(data)\n                    if text:\n                        return text\n            except (json.JSONDecodeError, TypeError):\n                continue\n\n        # Strategy 3: Use raw_decode to find JSON anywhere in the output\n        decoder = json.JSONDecoder()\n        for i, ch in enumerate(raw_output):\n            if ch != \"{\":\n                continue\n            try:\n                obj, _ = decoder.raw_decode(raw_output, i)\n                if isinstance(obj, dict):\n                    text = _text_from_dict(obj)\n                    if text:\n                        return text\n            except (json.JSONDecodeError, TypeError):\n                continue\n    except Exception:\n        pass\n\n    return raw_output\n\n\n# Map file extensions to their comment prefix styles\n_COMMENT_PREFIXES = {\n    \".py\": (\"#\",), \".rb\": (\"#\",),\n    \".js\": (\"//\", \"/*\"), \".ts\": (\"//\", \"/*\"),\n    \".jsx\": (\"//\", \"/*\"), \".tsx\": (\"//\", \"/*\"),\n    \".go\": (\"//\", \"/*\"), \".rs\": (\"//\", \"/*\"),\n    \".java\": (\"//\", \"/*\"),\n}\n\n# Regex to match string literals (double-quoted and single-quoted, with escapes)\n_STRING_LITERAL_RE = re.compile(r'''\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^'\\\\]|\\\\.)*' '''.strip())\n\nMAX_TASK_DESCRIPTION_LENGTH = 2000\nMAX_TASK_CONTEXT_LENGTH = 12000\n\n# Default timeout for _discover_todos file walk (seconds)\nTODO_SCAN_TIMEOUT = 60\n\n_FILE_REF_RE = re.compile(\n    r'`([a-zA-Z0-9_/.\\-]+\\.(?:py|js|ts|tsx|jsx|go|rs|java|rb|sh|yaml|yml|json|md|txt))'\n    r'(?::(\\d+))?(?:-\\d+)?`'\n)\n_FILE_REF_FALLBACK_RE = re.compile(\n    r'(?:in\\s+|for\\s+)([a-zA-Z0-9_/.\\-]+\\.(?:py|js|ts|tsx|jsx|go|rs|java|rb|sh|yaml|yml|json|md|txt))'\n    r'(?::(\\d+))?'\n)\n\n\ndef _sanitize_description(desc: str) -> str:\n    \"\"\"Sanitize a task description: strip, collapse newlines, and truncate.\"\"\"\n    desc = desc.strip()\n    desc = desc.replace(\"\\n\", \" \").replace(\"\\r\", \" \")\n    if len(desc) > MAX_TASK_DESCRIPTION_LENGTH:\n        desc = desc[:MAX_TASK_DESCRIPTION_LENGTH] + \"...\"\n    return desc\n\n\ndef _extract_comment_text(line: str, ext: str) -> Optional[str]:\n    \"\"\"Strip string literals from *line*, then return the comment body if a\n    comment prefix for *ext* is found.  Returns ``None`` when no comment is\n    detected.\"\"\"\n    prefixes = _COMMENT_PREFIXES.get(ext)\n    if not prefixes:\n        return None\n\n    # Remove string literals so that a '#' or '//' inside a string is ignored\n    stripped = _STRING_LITERAL_RE.sub(\"\", line)\n\n    # Find the earliest comment prefix in the stripped line\n    earliest_pos = None\n    earliest_prefix = None\n    for pfx in prefixes:\n        pos = stripped.find(pfx)\n        if pos != -1 and (earliest_pos is None or pos < earliest_pos):\n            earliest_pos = pos\n            earliest_prefix = pfx\n\n    if earliest_pos is None:\n        return None\n\n    # Return the text after the comment prefix\n    return stripped[earliest_pos + len(earliest_prefix):]\n\n\n@dataclass\nclass Task:\n    description: str\n    priority: int  # 1 = highest (feedback), 5 = lowest (quality review)\n    source: str  # \"test_failure\", \"lint\", \"todo\", \"coverage\", \"quality\", \"feedback\"\n    source_file: Optional[str] = None  # file path for feedback tasks\n    line_number: Optional[int] = None\n    context: str = \"\"  # rich context: tracebacks, file snippets, error details\n    task_id: str = \"\"\n    depends_on: List[str] = field(default_factory=list)\n\n    def __post_init__(self):\n        self.description = _sanitize_description(self.description)\n        if len(self.context) > MAX_TASK_CONTEXT_LENGTH:\n            self.context = self.context[:MAX_TASK_CONTEXT_LENGTH] + \"\\n... (truncated)\"\n        if not self.task_id:\n            self.task_id = self.task_key\n\n    @property\n    def task_key(self) -> str:\n        \"\"\"Stable dedup key — same underlying issue produces the same key.\"\"\"\n        if self.source == \"todo\" and self.source_file:\n            if self.line_number is not None:\n                return f\"todo:{self.source_file}:{self.line_number}\"\n            return f\"todo:{self.source_file}\"\n\n        if self.source in (\"lint\", \"test_failure\", \"quality\", \"coverage\") and self.source_file:\n            return f\"{self.source}:{self.source_file}\"\n\n        if self.source == \"coverage\":\n            match = re.search(r'for\\s+(\\S+)', self.description)\n            if match:\n                return f\"coverage:{match.group(1)}\"\n\n        if self.source == \"claude_idea\":\n            match = _FILE_REF_RE.search(self.description)\n            if match:\n                return f\"claude_idea:{match.group(1)}\"\n            match = _FILE_REF_FALLBACK_RE.search(self.description)\n            if match:\n                return f\"claude_idea:{match.group(1)}\"\n            return f\"claude_idea:{self.description[:60]}\"\n\n        if self.source == \"feedback\" and self.source_file:\n            return f\"feedback:{self.source_file}\"\n\n        if self.source == \"test_failure\":\n            match = re.search(r'FAILED\\s+(\\S+)', self.description)\n            if match:\n                return f\"test_failure:{match.group(1)}\"\n\n        return f\"{self.source}:{self.description}\"\n\n\nclass TaskDiscovery:\n    def __init__(self, config: Config, state_manager=None):\n        self.config = config\n        self.target_dir = config.target_dir\n        self.state_manager = state_manager\n        self._last_idea_discovery_time: float = 0.0\n\n    def discover_all(self) -> List[Task]:\n        \"\"\"Run all enabled discovery strategies and return sorted tasks.\"\"\"\n        tasks: List[Task] = []\n        dc = self.config.discovery\n\n        if dc.enable_test_failures:\n            tasks.extend(self._discover_test_failures())\n\n        if dc.enable_lint_errors:\n            tasks.extend(self._discover_lint_errors())\n\n        if dc.enable_todos:\n            tasks.extend(self._discover_todos())\n\n        if dc.enable_coverage:\n            tasks.extend(self._discover_coverage_gaps())\n\n        if dc.enable_claude_ideas:\n            tasks.extend(self._discover_claude_ideas())\n\n        if dc.enable_quality_review:\n            tasks.extend(self._discover_quality_issues())\n\n        if dc.enable_complexity_check:\n            tasks.extend(self._discover_complexity_issues())\n\n        if dc.enable_import_check:\n            tasks.extend(self._discover_import_issues())\n\n        # Group related tasks to avoid duplicate work\n        tasks = self._group_related_tasks(tasks)\n\n        # Boost priority for historically high-success-rate sources\n        if self.state_manager and dc.adaptive_priority and tasks:\n            try:\n                performance = self.state_manager.get_strategy_performance(lookback_seconds=86400)\n                if performance:\n                    for task in tasks:\n                        perf = performance.get(task.source)\n                        if perf and perf.get(\"total\", 0) >= 2:\n                            success_rate = perf.get(\"success_rate\", 0.0)\n                            if success_rate > 0.5:\n                                # Higher success rate -> lower priority number (higher priority)\n                                # e.g., 90% success -> priority reduced by 2\n                                boost = int(success_rate * 3)  # 0-3 boost\n                                task.priority = max(1, task.priority - boost)\n            except Exception as e:\n                logger.debug(\"Strategy performance boosting failed: %s\", e)\n\n        # Sort by priority (lower number = higher priority)\n        tasks.sort(key=lambda t: t.priority)\n        return tasks\n\n    def _group_related_tasks(self, tasks: List[Task]) -> List[Task]:\n        \"\"\"Group related tasks by file path to avoid duplicate work.\n\n        When multiple tasks share the same source file (e.g., multiple test\n        failures in the same file, or multiple lint errors in the same file),\n        they likely share a root cause. This method keeps only the first\n        (highest-priority) task per file for each source type, reducing\n        wasted cycles on tasks that will auto-resolve when the root cause\n        is fixed.\n\n        Tasks without a source_file are always kept.\n        \"\"\"\n        from collections import defaultdict\n\n        # Group by (source, source_file) — only group when source_file is set\n        grouped: dict = defaultdict(list)\n        ungrouped: List[Task] = []\n\n        for task in tasks:\n            if task.source_file and task.source in (\"test_failure\", \"lint\", \"todo\"):\n                key = (task.source, task.source_file)\n                grouped[key].append(task)\n            else:\n                ungrouped.append(task)\n\n        result: List[Task] = list(ungrouped)\n        for key, group in grouped.items():\n            # Sort by priority (lower = better), keep the representative task\n            group.sort(key=lambda t: t.priority)\n            representative = group[0]\n            if len(group) > 1:\n                # Enrich the representative's description with count\n                representative.description = (\n                    f\"{representative.description} \"\n                    f\"(+{len(group) - 1} related in {key[1]})\"\n                )\n            result.append(representative)\n\n        return result\n\n    # Regex to extract file path and line number from pytest traceback lines\n    # Matches patterns like \"tests/test_foo.py:5: AssertionError\"\n    _TRACEBACK_LOC_RE = re.compile(\n        r'^(\\S+\\.py):(\\d+):\\s+\\w+(?:Error|Exception|Warning)'\n    )\n\n    def _extract_test_traceback(self, full_output: str, test_id: str) -> str:\n        \"\"\"Extract the traceback section for a specific test from pytest output.\n\n        Includes assertion details (lines starting with 'E') and ensures the\n        last 5 lines of the traceback are always present.\n        \"\"\"\n        if not test_id:\n            return \"\"\n        lines = full_output.split(\"\\n\")\n        collecting = False\n        result_lines: List[str] = []\n        assertion_lines: List[str] = []\n        for line in lines:\n            if test_id in line and (\"FAILED\" in line or \"ERROR\" in line or \"___\" in line):\n                collecting = True\n                result_lines = [line]\n                assertion_lines = []\n                continue\n            if collecting:\n                if (line.startswith(\"___\") and test_id not in line) or \\\n                   line.startswith(\"=\") or \\\n                   (line.startswith(\"FAILED \") and test_id not in line):\n                    break\n                result_lines.append(line)\n                # Collect assertion detail lines (pytest prefixes them with 'E')\n                stripped = line.lstrip()\n                if stripped.startswith(\"E \") or stripped.startswith(\"E\\t\"):\n                    assertion_lines.append(line)\n\n        if not result_lines:\n            return \"\"\n\n        # Ensure the last 5 lines of the traceback are included\n        # (they typically contain the assertion and location info)\n        traceback_text = \"\\n\".join(result_lines)\n        if len(result_lines) > 5:\n            last_5 = \"\\n\".join(result_lines[-5:])\n            # If assertion lines exist but aren't in last 5 lines, append them\n            if assertion_lines:\n                for aline in assertion_lines:\n                    if aline not in result_lines[-5:]:\n                        traceback_text += \"\\n\" + aline\n\n        return traceback_text\n\n    def _extract_traceback_location(self, traceback_text: str) -> tuple:\n        \"\"\"Extract file path and line number from a pytest traceback.\n\n        Returns (source_file, line_number) or (None, None) if not found.\n        \"\"\"\n        if not traceback_text:\n            return None, None\n        # Search for the last file:line pattern in the traceback\n        # (the last one is typically the failing assertion location)\n        last_match = None\n        for line in traceback_text.split(\"\\n\"):\n            line = line.strip()\n            m = self._TRACEBACK_LOC_RE.match(line)\n            if m:\n                last_match = m\n        if last_match:\n            return last_match.group(1), int(last_match.group(2))\n        return None, None\n\n    def _read_file_snippet(self, filepath: str, line_num: int, context_lines: int = 5) -> str:\n        \"\"\"Read a snippet of a file around the given line number.\"\"\"\n        try:\n            fpath = Path(filepath)\n            if not fpath.is_absolute():\n                fpath = Path(self.target_dir) / filepath\n            if not fpath.exists():\n                return \"\"\n            content = fpath.read_text(errors=\"ignore\")\n            lines = content.split(\"\\n\")\n            start = max(0, line_num - context_lines - 1)\n            end = min(len(lines), line_num + context_lines)\n            numbered = []\n            for i, line in enumerate(lines[start:end], start + 1):\n                marker = \" >> \" if i == line_num else \"    \"\n                numbered.append(f\"{marker}{i:4d} | {line}\")\n            return \"\\n\".join(numbered)\n        except OSError:\n            return \"\"\n\n    def _enrich_task_context(self, task: 'Task') -> None:\n        \"\"\"Populate a task's context with code snippets from file references in its description.\"\"\"\n        # Try primary regex, then fallback\n        match = _FILE_REF_RE.search(task.description)\n        if not match:\n            match = _FILE_REF_FALLBACK_RE.search(task.description)\n        if not match:\n            return\n\n        filepath = match.group(1)\n        line_num = int(match.group(2)) if match.group(2) else 1\n        snippet = self._read_file_snippet(filepath, line_num, context_lines=5)\n        if snippet:\n            task.context = f\"File: {filepath}\\n{snippet}\"\n            task.source_file = filepath\n            if match.group(2):\n                task.line_number = line_num\n\n    def _discover_test_failures(self) -> List[Task]:\n        \"\"\"Run pytest and parse failures.\"\"\"\n        test_cmd = self.config.validation.test_command\n        if not test_cmd.strip():\n            return []\n\n        try:\n            result = run_with_group_kill(\n                test_cmd,\n                shell=True,\n                cwd=self.target_dir,\n                timeout=self.config.validation.test_timeout,\n            )\n        except OSError as e:\n            logger.warning(\"Test discovery failed: %s\", e)\n            return []\n\n        if result.timed_out:\n            logger.warning(\"Test discovery timed out after %ds\", self.config.validation.test_timeout)\n            return []\n\n        if result.returncode == 0:\n            return []\n\n        # Capture full output for context\n        full_output = result.stdout\n        if result.stderr.strip():\n            full_output += \"\\n\" + result.stderr\n\n        # Parse pytest output for FAILED lines\n        tasks = []\n        for line in result.stdout.split(\"\\n\"):\n            line = line.strip()\n            if line.startswith(\"FAILED\"):\n                # e.g. \"FAILED tests/test_foo.py::test_bar - AssertionError: ...\"\n                desc = f\"Fix test failure: {line}\"\n                # Extract test identifier for per-test traceback\n                parts = line.split()\n                test_id = parts[1] if len(parts) > 1 else \"\"\n                per_test_ctx = self._extract_test_traceback(full_output, test_id)\n                # Extract file path and line number from the traceback\n                src_file, src_line = self._extract_traceback_location(per_test_ctx)\n                tasks.append(Task(\n                    description=desc,\n                    priority=2,\n                    source=\"test_failure\",\n                    source_file=src_file,\n                    line_number=src_line,\n                    context=per_test_ctx if per_test_ctx else full_output,\n                ))\n\n        # If we got failures but couldn't parse individual ones, create a generic task\n        if result.returncode != 0 and not tasks:\n            tasks.append(Task(\n                description=f\"Fix test failures (exit code {result.returncode})\",\n                priority=2,\n                source=\"test_failure\",\n                context=full_output,\n            ))\n\n        return tasks\n\n    def _discover_lint_errors(self) -> List[Task]:\n        \"\"\"Run lint command and parse errors.\"\"\"\n        lint_cmd = self.config.validation.lint_command\n        if not lint_cmd.strip():\n            return []\n\n        try:\n            result = run_with_group_kill(\n                lint_cmd,\n                shell=True,\n                cwd=self.target_dir,\n                timeout=self.config.validation.lint_timeout,\n            )\n        except OSError as e:\n            logger.warning(\"Lint discovery failed: %s\", e)\n            return []\n\n        if result.timed_out:\n            logger.warning(\"Lint discovery timed out after %ds\", self.config.validation.lint_timeout)\n            return []\n\n        if result.returncode == 0:\n            return []\n\n        # Try to parse ruff JSON output\n        output = result.stdout.strip()\n        try:\n            errors = json.loads(output)\n            if isinstance(errors, list):\n                tasks = []\n                for err in errors[:10]:  # Cap at 10 lint errors\n                    filename = err.get(\"filename\", \"unknown\")\n                    message = err.get(\"message\", \"lint error\")\n                    code = err.get(\"code\", \"\")\n                    line_num = err.get(\"location\", {}).get(\"row\", 0)\n                    desc = f\"Fix lint error in {filename}: [{code}] {message}\"\n                    # Build context: snippet around the error line\n                    context = \"\"\n                    if line_num > 0:\n                        context = self._read_file_snippet(filename, line_num, context_lines=5)\n                    tasks.append(Task(\n                        description=desc,\n                        priority=2,\n                        source=\"lint\",\n                        source_file=filename,\n                        line_number=line_num if line_num > 0 else None,\n                        context=context,\n                    ))\n                return tasks\n        except (json.JSONDecodeError, TypeError):\n            pass\n\n        # Fallback: generic lint error task\n        return [Task(\n            description=\"Fix lint errors\",\n            priority=2,\n            source=\"lint\",\n        )]\n\n    def _discover_todos(self, timeout: int = TODO_SCAN_TIMEOUT) -> List[Task]:\n        \"\"\"Scan source files for TODO/FIXME/HACK comments.\n\n        Args:\n            timeout: Maximum time in seconds for the file walk operation.\n                     If exceeded, returns whatever tasks were found so far.\n        \"\"\"\n        tasks = []\n        patterns = self.config.discovery.todo_patterns\n        exclude_dirs = set(self.config.discovery.exclude_dirs)\n\n        if not patterns:\n            return []\n\n        escaped = \"|\".join(re.escape(p) for p in patterns)\n        keyword_pat = r\"^\\s*(\" + escaped + r\")\\b\"\n        keyword_re = re.compile(keyword_pat, re.IGNORECASE)\n\n        target = Path(self.target_dir)\n        deadline = time.monotonic() + timeout\n        timed_out = False\n        files_scanned = 0\n        for root, dirs, files in os.walk(target):\n            # Check deadline at the start of each directory\n            if time.monotonic() > deadline:\n                timed_out = True\n                break\n\n            # Filter out excluded directories\n            dirs[:] = [d for d in dirs if d not in exclude_dirs]\n\n            for fname in files:\n                # Check deadline periodically (every file)\n                if time.monotonic() > deadline:\n                    timed_out = True\n                    break\n\n                ext = Path(fname).suffix\n                if ext not in _COMMENT_PREFIXES:\n                    continue\n\n                fpath = Path(root) / fname\n                rel_path = str(fpath.relative_to(target))\n\n                try:\n                    content = fpath.read_text(errors=\"ignore\")\n                except OSError:\n                    continue\n\n                files_scanned += 1\n\n                for i, line in enumerate(content.split(\"\\n\"), 1):\n                    comment_text = _extract_comment_text(line, ext)\n                    if comment_text is None:\n                        continue\n                    match = keyword_re.search(comment_text)\n                    if match:\n                        comment = line.strip()\n                        if len(comment) > 120:\n                            comment = comment[:120] + \"...\"\n                        desc = f\"Address {match.group(1)} in {rel_path}:{i}: {comment}\"\n                        context = self._read_file_snippet(str(fpath), i, context_lines=5)\n                        tasks.append(Task(\n                            description=desc,\n                            priority=3,\n                            source=\"todo\",\n                            source_file=rel_path,\n                            line_number=i,\n                            context=context,\n                        ))\n\n            if timed_out:\n                break\n\n        if timed_out:\n            logger.warning(\n                \"TODO scan timed out after %ds (scanned %d files, found %d tasks)\",\n                timeout, files_scanned, len(tasks),\n            )\n\n        return tasks[:self.config.discovery.max_todo_tasks]\n\n    def _discover_claude_ideas(self) -> List[Task]:\n        \"\"\"Use Claude to analyze the codebase and suggest improvement ideas.\n\n        Invokes Claude CLI in read-only analysis mode with a low max-turns\n        to keep cost down. Parses the response for actionable improvement tasks.\n        \"\"\"\n        # Enforce idea generation cooldown to prevent excessive API costs\n        cooldown = self.config.discovery.idea_cooldown_seconds\n        if cooldown > 0:\n            elapsed = time.time() - self._last_idea_discovery_time\n            if self._last_idea_discovery_time > 0 and elapsed < cooldown:\n                logger.debug(\n                    \"Skipping claude_ideas discovery: %.0fs since last run, \"\n                    \"cooldown is %ds\",\n                    elapsed, cooldown,\n                )\n                return []\n\n        cc = self.config.claude\n        if self.config.discovery.discovery_prompt:\n            focus_section = self.config.discovery.discovery_prompt\n        else:\n            focus_section = (\n                \"- New features or functionality that would add value\\n\"\n                \"- Missing tests for important functionality\\n\"\n                \"- Bug risks or edge cases that could cause failures\\n\"\n                \"- Performance improvements\\n\"\n                \"- Code clarity or maintainability improvements\\n\"\n            )\n\n        history_section = \"\"\n        if self.state_manager:\n            recent = self.state_manager.get_recent_task_summaries(\n                lookback_seconds=86400, max_items=15,\n            )\n            if recent:\n                history_section = (\n                    \"\\nRECENTLY COMPLETED TASKS (do NOT suggest similar improvements):\\n\"\n                    + \"\\n\".join(recent)\n                    + \"\\n\\nFocus on NEW areas that haven't been addressed recently.\\n\"\n                )\n\n        prompt = (\n            \"Analyze the codebase in the current directory. Identify up to 5 concrete, \"\n            \"actionable improvements. Focus on:\\n\"\n            + focus_section\n            + history_section\n            + \"\\nFor each improvement, output EXACTLY one line in this format:\\n\"\n            \"IDEA: <one-sentence description of the improvement>\\n\\n\"\n            \"Do NOT make any changes. Do NOT run git commands. Only analyze and output IDEA lines.\"\n        )\n\n        cmd = [\n            cc.command, \"-p\", prompt,\n            \"--model\", self.config.discovery.discovery_model or self.config.claude.resolved_model,\n            \"--max-turns\", str(self.config.discovery.discovery_max_turns),\n            \"--output-format\", \"json\",\n        ]\n\n        try:\n            result = run_with_group_kill(\n                cmd,\n                cwd=self.target_dir,\n                timeout=self.config.discovery.discovery_timeout,\n            )\n        except (FileNotFoundError, OSError) as e:\n            logger.warning(\"Claude idea discovery failed: %s\", e)\n            return []\n\n        if result is None:\n            logger.warning(\"Claude idea discovery returned no result\")\n            return []\n\n        if result.timed_out:\n            logger.warning(\"Claude idea discovery timed out after %ds\",\n                           self.config.discovery.discovery_timeout)\n            return []\n\n        if result.returncode != 0:\n            logger.warning(\"Claude idea discovery exited with code %d\", result.returncode)\n            return []\n\n        # Parse JSON response to get result text\n        result_text = result.stdout\n\n        # Check for error_max_turns in any JSON line\n        try:\n            for line in result_text.strip().splitlines():\n                stripped = line.strip()\n                if not stripped.startswith(\"{\"):\n                    continue\n                try:\n                    data = json.loads(stripped)\n                    if isinstance(data, dict) and data.get(\"subtype\") == \"error_max_turns\":\n                        logger.warning(\n                            \"Claude idea discovery hit max turns (%d); \"\n                            \"increase discovery.discovery_max_turns\",\n                            self.config.discovery.discovery_max_turns,\n                        )\n                        break\n                except (json.JSONDecodeError, TypeError):\n                    continue\n        except Exception:\n            pass\n\n        # Extract text content from JSON response\n        result_text = _extract_json_text(result_text)\n\n        # Warn if we couldn't extract text from a JSON response\n        if result_text == result.stdout and result.stdout.strip()[:1] in (\"{\", \"[\"):\n            logger.warning(\n                \"Claude idea response contained JSON but no text content \"\n                \"could be extracted — falling back to raw text extraction\"\n            )\n\n        # Extract IDEA lines\n        MIN_IDEA_LENGTH = 10\n        tasks = []\n        for line in result_text.split(\"\\n\"):\n            line = line.strip()\n            if line.upper().startswith(\"IDEA:\"):\n                desc = line[5:].strip()\n                if desc and len(desc) >= MIN_IDEA_LENGTH:\n                    tasks.append(Task(\n                        description=desc,\n                        priority=4,\n                        source=\"claude_idea\",\n                    ))\n                elif desc:\n                    logger.debug(\"Skipping short IDEA line: %r\", desc)\n\n        # Enrich tasks with file context from their descriptions\n        for task in tasks:\n            self._enrich_task_context(task)\n\n        logger.info(\"Claude discovered %d improvement ideas\", len(tasks))\n        if not tasks and result_text.strip():\n            # Attempt fallback extraction from analysis-format text\n            lines = [l.strip() for l in result_text.split(\"\\n\") if l.strip()]\n            for line in lines:\n                # Match numbered items: \"1. ...\", \"2) ...\"\n                m = re.match(r'^\\d+[.)]\\s+(.+)', line)\n                if not m:\n                    # Match bullet items: \"- ...\", \"* ...\", \"• ...\"\n                    m = re.match(r'^[-*•]\\s+(.+)', line)\n                if m:\n                    desc = m.group(1).strip()\n                    if desc and len(desc) >= MIN_IDEA_LENGTH:\n                        tasks.append(Task(\n                            description=desc,\n                            priority=4,\n                            source=\"claude_idea\",\n                        ))\n            # Enrich fallback tasks with file context\n            for task in tasks:\n                self._enrich_task_context(task)\n            if tasks:\n                logger.info(\n                    \"Extracted %d tasks from analysis-format text \"\n                    \"(no IDEA: prefixed lines found, used numbered/bullet fallback).\",\n                    len(tasks),\n                )\n            else:\n                logger.debug(\n                    \"Claude response contained no IDEA lines and no extractable \"\n                    \"analysis-format items (%d non-empty lines)\",\n                    len(lines),\n                )\n        self._last_idea_discovery_time = time.time()\n        return tasks[:5]\n\n    def _discover_coverage_gaps(self) -> List[Task]:\n        \"\"\"Discover files with low test coverage (optional, requires pytest-cov).\"\"\"\n        try:\n            result = run_with_group_kill(\n                \"python3 -m pytest --cov --cov-report=json --cov-report=term -q\",\n                shell=True,\n                cwd=self.target_dir,\n                timeout=self.config.validation.test_timeout,\n            )\n        except OSError:\n            return []\n\n        if result.timed_out:\n            return []\n\n        cov_file = Path(self.target_dir) / \"coverage.json\"\n        if not cov_file.exists():\n            return []\n\n        try:\n            data = json.loads(cov_file.read_text())\n            files = data.get(\"files\", {})\n            tasks = []\n            for fname, info in files.items():\n                pct = info.get(\"summary\", {}).get(\"percent_covered\", 100)\n                if pct < 50:\n                    desc = f\"Improve test coverage for {fname} (currently {pct:.0f}%)\"\n                    tasks.append(Task(\n                        description=desc,\n                        priority=4,\n                        source=\"coverage\",\n                        source_file=fname,\n                    ))\n            return tasks[:10]\n        except (json.JSONDecodeError, OSError):\n            return []\n\n    def _discover_quality_issues(self) -> List[Task]:\n        \"\"\"Review source files for general quality issues.\"\"\"\n        tasks = []\n        target = Path(self.target_dir)\n        exclude_dirs = set(self.config.discovery.exclude_dirs)\n\n        for root, dirs, files in os.walk(target):\n            dirs[:] = [d for d in dirs if d not in exclude_dirs]\n\n            for fname in files:\n                if not fname.endswith(\".py\"):\n                    continue\n\n                fpath = Path(root) / fname\n                rel_path = str(fpath.relative_to(target))\n\n                try:\n                    content = fpath.read_text(errors=\"ignore\")\n                except OSError:\n                    continue\n\n                lines = content.split(\"\\n\")\n                # Flag very long files\n                if len(lines) > 500:\n                    tasks.append(Task(\n                        description=f\"Review and potentially refactor {rel_path} ({len(lines)} lines)\",\n                        priority=5,\n                        source=\"quality\",\n                        source_file=rel_path,\n                    ))\n\n        return tasks[:5]\n\n    def _discover_import_issues(self) -> List[Task]:\n        \"\"\"Scan Python files for unused imports using ast.parse.\n\n        Creates lint tasks with priority 3 for files with unused imports.\n        Only scans files not in exclude_dirs.\n        \"\"\"\n        tasks: List[Task] = []\n        target = Path(self.target_dir)\n        exclude_dirs = set(self.config.discovery.exclude_dirs)\n\n        for root, dirs, files in os.walk(target):\n            dirs[:] = [d for d in dirs if d not in exclude_dirs]\n\n            for fname in files:\n                if not fname.endswith(\".py\"):\n                    continue\n\n                fpath = Path(root) / fname\n                rel_path = str(fpath.relative_to(target))\n\n                try:\n                    source = fpath.read_text(errors=\"ignore\")\n                    tree = ast.parse(source, filename=rel_path)\n                except (OSError, SyntaxError):\n                    continue\n\n                unused = self._find_unused_imports(tree)\n                if unused:\n                    import_list = \", \".join(unused[:5])\n                    if len(unused) > 5:\n                        import_list += f\" (+{len(unused) - 5} more)\"\n                    desc = (\n                        f\"Remove {len(unused)} unused import(s) in \"\n                        f\"`{rel_path}`: {import_list}\"\n                    )\n                    # Use the line number of the first unused import\n                    first_line = None\n                    for node in ast.walk(tree):\n                        if isinstance(node, (ast.Import, ast.ImportFrom)):\n                            for alias in node.names:\n                                name = alias.asname if alias.asname else alias.name\n                                if name in unused:\n                                    first_line = node.lineno\n                                    break\n                        if first_line:\n                            break\n                    tasks.append(Task(\n                        description=desc,\n                        priority=3,\n                        source=\"lint\",\n                        source_file=rel_path,\n                        line_number=first_line,\n                    ))\n\n                if len(tasks) >= 10:\n                    return tasks[:10]\n\n        return tasks[:10]\n\n    def _find_unused_imports(self, tree: ast.AST) -> List[str]:\n        \"\"\"Find imported names that are never used in the module body.\n\n        Returns a list of unused import names. Skips __all__ exports,\n        __init__.py re-exports, and names used in type annotations.\n        \"\"\"\n        imported: dict = {}  # name -> ast node\n\n        for node in ast.iter_child_nodes(tree):\n            if isinstance(node, ast.Import):\n                for alias in node.names:\n                    name = alias.asname if alias.asname else alias.name\n                    # For dotted imports like 'os.path', the bound name is 'os'\n                    if \".\" in name and not alias.asname:\n                        name = name.split(\".\")[0]\n                    imported[name] = node\n            elif isinstance(node, ast.ImportFrom):\n                # Skip 'from __future__ import ...'\n                if node.module and node.module == \"__future__\":\n                    continue\n                for alias in node.names:\n                    if alias.name == \"*\":\n                        continue\n                    name = alias.asname if alias.asname else alias.name\n                    imported[name] = node\n\n        if not imported:\n            return []\n\n        # Check if __all__ is defined — if so, exports count as usage\n        for node in ast.iter_child_nodes(tree):\n            if isinstance(node, ast.Assign):\n                for target in node.targets:\n                    if isinstance(target, ast.Name) and target.id == \"__all__\":\n                        # All imports could be re-exports; skip this file\n                        return []\n\n        # Collect all names used in the module (excluding the import statements)\n        used_names: set = set()\n        for node in ast.walk(tree):\n            if isinstance(node, ast.Name):\n                used_names.add(node.id)\n            elif isinstance(node, ast.Attribute):\n                # For 'os.path.join', the Name node 'os' is already captured\n                pass\n\n        # An import is unused if its bound name never appears as a Name node\n        # outside the import statement itself\n        unused = []\n        for name in imported:\n            if name not in used_names:\n                unused.append(name)\n\n        return sorted(unused)\n\n    def _discover_complexity_issues(self) -> List[Task]:\n        \"\"\"Scan Python files for functions longer than 50 lines using ast.parse.\"\"\"\n        tasks: List[Task] = []\n        target = Path(self.target_dir)\n        exclude_dirs = set(self.config.discovery.exclude_dirs)\n\n        for root, dirs, files in os.walk(target):\n            dirs[:] = [d for d in dirs if d not in exclude_dirs]\n\n            for fname in files:\n                if not fname.endswith(\".py\"):\n                    continue\n\n                fpath = Path(root) / fname\n                rel_path = str(fpath.relative_to(target))\n\n                try:\n                    source = fpath.read_text(errors=\"ignore\")\n                    tree = ast.parse(source, filename=rel_path)\n                except (OSError, SyntaxError):\n                    continue\n\n                for node in ast.walk(tree):\n                    if not isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):\n                        continue\n                    start = node.lineno\n                    end = node.end_lineno\n                    if end is None:\n                        continue\n                    line_count = end - start + 1\n                    if line_count > 50:\n                        desc = (\n                            f\"Refactor long function `{node.name}` in \"\n                            f\"`{rel_path}:{start}` ({line_count} lines)\"\n                        )\n                        tasks.append(Task(\n                            description=desc,\n                            priority=5,\n                            source=\"quality\",\n                            source_file=rel_path,\n                            line_number=start,\n                        ))\n\n                if len(tasks) >= 5:\n                    return tasks[:5]\n\n        return tasks[:5]\n","numLines":1020,"startLine":1,"totalLines":1020}}}
