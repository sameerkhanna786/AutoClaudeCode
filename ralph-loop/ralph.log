{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_vrtx_013kJwyGJkj7erJuHSioZXV9","type":"tool_result","content":"     1→\"\"\"Invoke the Claude CLI and parse JSON responses.\"\"\"\n     2→\n     3→from __future__ import annotations\n     4→\n     5→import json\n     6→import logging\n     7→import os\n     8→import signal\n     9→import subprocess\n    10→import threading\n    11→import time\n    12→from dataclasses import dataclass, field\n    13→from pathlib import Path\n    14→from typing import Any, Callable, Dict, List, Optional\n    15→\n    16→from config_schema import Config\n    17→from process_utils import kill_process_group\n    18→\n    19→logger = logging.getLogger(__name__)\n    20→\n    21→# Circuit breaker defaults\n    22→CB_FAILURE_THRESHOLD = 5  # consecutive failures before opening\n    23→CB_RECOVERY_TIMEOUT = 300  # seconds to wait before half-open\n    24→CB_HALF_OPEN_MAX_CALLS = 1  # max calls allowed in half-open state\n    25→\n    26→# Default context window size for token usage percentage calculation\n    27→_DEFAULT_CONTEXT_WINDOW = 200_000\n    28→\n    29→# Stderr patterns that count toward circuit breaker (rate limits, server errors)\n    30→_CB_ERROR_PATTERNS = (\n    31→    \"rate limit\",\n    32→    \"429\",\n    33→    \"too many requests\",\n    34→    \"500\",\n    35→    \"502\",\n    36→    \"503\",\n    37→    \"504\",\n    38→    \"internal server error\",\n    39→    \"bad gateway\",\n    40→    \"service unavailable\",\n    41→    \"gateway timeout\",\n    42→    \"overloaded\",\n    43→    \"server error\",\n    44→)\n    45→\n    46→\n    47→class CircuitBreaker:\n    48→    \"\"\"Circuit breaker to temporarily disable API calls after repeated failures.\n    49→\n    50→    States:\n    51→      - CLOSED: normal operation, calls are allowed\n    52→      - OPEN: calls are blocked, returns failure immediately\n    53→      - HALF_OPEN: allows a limited number of probe calls to test recovery\n    54→\n    55→    Thread-safe via a threading.Lock.\n    56→    \"\"\"\n    57→\n    58→    STATE_CLOSED = \"closed\"\n    59→    STATE_OPEN = \"open\"\n    60→    STATE_HALF_OPEN = \"half_open\"\n    61→\n    62→    def __init__(\n    63→        self,\n    64→        failure_threshold: int = CB_FAILURE_THRESHOLD,\n    65→        recovery_timeout: float = CB_RECOVERY_TIMEOUT,\n    66→        half_open_max_calls: int = CB_HALF_OPEN_MAX_CALLS,\n    67→        on_open: Optional[Callable[[int, float], None]] = None,\n    68→        max_recovery_timeout: float = 0,\n    69→        jitter_factor: float = 0.25,\n    70→    ):\n    71→        self.failure_threshold = failure_threshold\n    72→        self.recovery_timeout = recovery_timeout\n    73→        self._base_recovery_timeout = recovery_timeout\n    74→        self._max_recovery_timeout = max_recovery_timeout if max_recovery_timeout > 0 else recovery_timeout * 4\n    75→        self._jitter_factor = jitter_factor\n    76→        self._open_count = 0\n    77→        self.half_open_max_calls = half_open_max_calls\n    78→        self._on_open = on_open\n    79→        self._state = self.STATE_CLOSED\n    80→        self._consecutive_failures = 0\n    81→        self._opened_at: float = 0.0\n    82→        self._half_open_calls = 0\n    83→        self._lock = threading.Lock()\n    84→\n    85→    @property\n    86→    def state(self) -> str:\n    87→        with self._lock:\n    88→            return self._get_state()\n    89→\n    90→    def _get_state(self) -> str:\n    91→        \"\"\"Return current state, transitioning OPEN -> HALF_OPEN if recovery timeout elapsed.\"\"\"\n    92→        if self._state == self.STATE_OPEN:\n    93→            if time.monotonic() - self._opened_at >= self.recovery_timeout:\n    94→                self._state = self.STATE_HALF_OPEN\n    95→                self._half_open_calls = 0\n    96→                logger.info(\n    97→                    \"Circuit breaker transitioning from OPEN to HALF_OPEN \"\n    98→                    \"after %.0fs recovery timeout\",\n    99→                    self.recovery_timeout,\n   100→                )\n   101→        return self._state\n   102→\n   103→    def _compute_recovery_timeout(self) -> float:\n   104→        \"\"\"Compute recovery timeout with exponential backoff and jitter.\n   105→\n   106→        Each time the circuit breaker opens, the recovery timeout increases\n   107→        exponentially (base * 2^open_count) up to a maximum. Random jitter\n   108→        is added to prevent thundering herd when multiple workers recover\n   109→        simultaneously.\n   110→        \"\"\"\n   111→        import random\n   112→        # Exponential backoff: base * 2^(open_count - 1), capped at max\n   113→        # First open uses base timeout (2^0=1x), subsequent re-opens escalate\n   114→        exponent = max(0, self._open_count - 1)\n   115→        backoff = min(\n   116→            self._base_recovery_timeout * (2 ** exponent),\n   117→            self._max_recovery_timeout,\n   118→        )\n   119→        # Add jitter: +/- jitter_factor of the backoff value\n   120→        jitter = backoff * self._jitter_factor * (2 * random.random() - 1)\n   121→        return max(self._base_recovery_timeout, backoff + jitter)\n   122→\n   123→    def allow_request(self) -> bool:\n   124→        \"\"\"Check if a request is allowed through the circuit breaker.\"\"\"\n   125→        with self._lock:\n   126→            state = self._get_state()\n   127→            if state == self.STATE_CLOSED:\n   128→                return True\n   129→            if state == self.STATE_HALF_OPEN:\n   130→                if self._half_open_calls < self.half_open_max_calls:\n   131→                    self._half_open_calls += 1\n   132→                    return True\n   133→                return False\n   134→            # STATE_OPEN\n   135→            return False\n   136→\n   137→    def record_success(self) -> None:\n   138→        \"\"\"Record a successful call — resets the circuit breaker to CLOSED.\"\"\"\n   139→        with self._lock:\n   140→            if self._state != self.STATE_CLOSED:\n   141→                logger.info(\n   142→                    \"Circuit breaker resetting to CLOSED after successful call \"\n   143→                    \"(was %s, had %d consecutive failures)\",\n   144→                    self._state, self._consecutive_failures,\n   145→                )\n   146→            self._consecutive_failures = 0\n   147→            self._state = self.STATE_CLOSED\n   148→            self._half_open_calls = 0\n   149→            self._open_count = 0\n   150→            self.recovery_timeout = self._base_recovery_timeout\n   151→\n   152→    def record_failure(self) -> None:\n   153→        \"\"\"Record a failed call — may trip the circuit breaker to OPEN.\"\"\"\n   154→        notify = False\n   155→        with self._lock:\n   156→            self._consecutive_failures += 1\n   157→            if self._state == self.STATE_HALF_OPEN:\n   158→                # Failed during probe — re-open\n   159→                self._open_count += 1\n   160→                self.recovery_timeout = self._compute_recovery_timeout()\n   161→                self._state = self.STATE_OPEN\n   162→                self._opened_at = time.monotonic()\n   163→                notify = True\n   164→                logger.warning(\n   165→                    \"Circuit breaker re-opening after failed probe call \"\n   166→                    \"(%d consecutive failures, recovery_timeout=%.0fs)\",\n   167→                    self._consecutive_failures, self.recovery_timeout,\n   168→                )\n   169→            elif (\n   170→                self._state == self.STATE_CLOSED\n   171→                and self._consecutive_failures >= self.failure_threshold\n   172→            ):\n   173→                self._open_count += 1\n   174→                self.recovery_timeout = self._compute_recovery_timeout()\n   175→                self._state = self.STATE_OPEN\n   176→                self._opened_at = time.monotonic()\n   177→                notify = True\n   178→                logger.warning(\n   179→                    \"Circuit breaker OPEN after %d consecutive failures. \"\n   180→                    \"API calls blocked for %.0fs (backoff level %d).\",\n   181→                    self._consecutive_failures, self.recovery_timeout,\n   182→                    self._open_count,\n   183→                )\n   184→        # Fire notification callback outside the lock to avoid deadlocks\n   185→        if notify and self._on_open is not None:\n   186→            try:\n   187→                self._on_open(self._consecutive_failures, self.recovery_timeout)\n   188→            except Exception:\n   189→                logger.debug(\"Circuit breaker on_open callback raised\", exc_info=True)\n   190→\n   191→    def reset(self) -> None:\n   192→        \"\"\"Manually reset the circuit breaker to CLOSED state.\"\"\"\n   193→        with self._lock:\n   194→            self._state = self.STATE_CLOSED\n   195→            self._consecutive_failures = 0\n   196→            self._half_open_calls = 0\n   197→            self._open_count = 0\n   198→            self.recovery_timeout = self._base_recovery_timeout\n   199→\n   200→\n   201→@dataclass\n   202→class ClaudeResult:\n   203→    success: bool\n   204→    result_text: str = \"\"\n   205→    cost_usd: float = 0.0\n   206→    duration_seconds: float = 0.0\n   207→    raw_json: Optional[Dict[str, Any]] = None\n   208→    error: str = \"\"\n   209→    input_tokens: int = 0\n   210→    output_tokens: int = 0\n   211→    context_window_pct: float = 0.0\n   212→\n   213→\n   214→class ClaudeRunner:\n   215→\n   216→    def __init__(self, config: Config):\n   217→        self.config = config\n   218→        self.max_retries = config.claude.max_retries\n   219→        self.retry_delays = config.claude.retry_delays\n   220→        self.rate_limit_base_delay = config.claude.rate_limit_base_delay\n   221→        self.rate_limit_multiplier = config.claude.rate_limit_multiplier\n   222→        self._current_process: subprocess.Popen | None = None\n   223→        self._process_lock = threading.Lock()\n   224→        self._terminated = False  # Set by terminate() to stop retry loop\n   225→        self.circuit_breaker = CircuitBreaker(\n   226→            on_open=self._on_circuit_breaker_open,\n   227→        )\n   228→\n   229→    def _build_command(self, prompt: str) -> List[str]:\n   230→        \"\"\"Build the CLI command list.\"\"\"\n   231→        cc = self.config.claude\n   232→        model = cc.resolved_model or cc.model\n   233→        cmd = [\n   234→            cc.command,\n   235→            \"-p\", prompt,\n   236→            \"--model\", model,\n   237→            \"--max-turns\", str(cc.max_turns),\n   238→            \"--output-format\", \"json\",\n   239→        ]\n   240→        return cmd\n   241→\n   242→    def _on_circuit_breaker_open(self, failures: int, recovery_timeout: float) -> None:\n   243→        \"\"\"Notification callback invoked when the circuit breaker opens.\n   244→\n   245→        Writes a notification file to the state directory so external\n   246→        monitoring tools and users can detect the outage.\n   247→        \"\"\"\n   248→        import datetime as dt\n   249→        state_dir = Path(self.config.paths.state_dir)\n   250→        state_dir.mkdir(parents=True, exist_ok=True)\n   251→        notification_file = state_dir / \"circuit_breaker_open\"\n   252→        try:\n   253→            notification_file.write_text(\n   254→                f\"Circuit breaker OPEN\\n\"\n   255→                f\"Timestamp: {dt.datetime.now(dt.timezone.utc).isoformat()}\\n\"\n   256→                f\"Consecutive failures: {failures}\\n\"\n   257→                f\"Recovery timeout: {recovery_timeout}s\\n\"\n   258→                f\"API calls are blocked until recovery.\\n\"\n   259→            )\n   260→            logger.warning(\n   261→                \"Circuit breaker notification written to %s\",\n   262→                notification_file,\n   263→            )\n   264→        except OSError as e:\n   265→            logger.debug(\"Failed to write circuit breaker notification: %s\", e)\n   266→\n   267→    @staticmethod\n   268→    def _kill_process(proc: subprocess.Popen) -> None:\n   269→        \"\"\"Kill a subprocess and its entire process group.\"\"\"\n   270→        kill_process_group(proc)\n   271→\n   272→    @staticmethod\n   273→    def _is_circuit_breaker_error(stderr: str) -> bool:\n   274→        \"\"\"Check if stderr indicates a rate limit or server error.\"\"\"\n   275→        stderr_lower = stderr.lower()\n   276→        return any(pat in stderr_lower for pat in _CB_ERROR_PATTERNS)\n   277→\n   278→    def terminate(self) -> None:\n   279→        \"\"\"Terminate any currently running Claude subprocess.\n   280→\n   281→        Thread-safe: can be called from a different thread than the one\n   282→        executing run().  Also sets _terminated to prevent the retry loop\n   283→        from spawning new processes after the kill.\n   284→        \"\"\"\n   285→        self._terminated = True\n   286→        with self._process_lock:\n   287→            proc = self._current_process\n   288→        if proc is not None:\n   289→            logger.warning(\"Terminating running Claude subprocess (pid=%s)\", proc.pid)\n   290→            self._kill_process(proc)\n   291→\n   292→    @staticmethod\n   293→    def _try_parse_json(text: str) -> Optional[Dict[str, Any]]:\n   294→        \"\"\"Try to extract a JSON dict from *text* using multiple strategies.\n   295→\n   296→        1. Lines that start with '{' (most common case).\n   297→        2. JSON embedded mid-line (after banner text).\n   298→        3. raw_decode on the full text for multi-line JSON.\n   299→\n   300→        Returns ``None`` when no valid JSON object is found.\n   301→        \"\"\"\n   302→        lines = text.splitlines()\n   303→\n   304→        # Strategy 1: lines starting with '{'\n   305→        for line in lines:\n   306→            stripped = line.strip()\n   307→            if not stripped or not stripped.startswith(\"{\"):\n   308→                continue\n   309→            try:\n   310→                obj = json.loads(stripped)\n   311→                if isinstance(obj, dict):\n   312→                    return obj\n   313→            except json.JSONDecodeError:\n   314→                pass\n   315→\n   316→        # Strategy 2: JSON embedded mid-line\n   317→        for line in lines:\n   318→            stripped = line.strip()\n   319→            pos = stripped.find(\"{\")\n   320→            if pos <= 0:\n   321→                continue\n   322→            while pos != -1:\n   323→                try:\n   324→                    obj = json.loads(stripped[pos:])\n   325→                    if isinstance(obj, dict):\n   326→                        return obj\n   327→                except json.JSONDecodeError:\n   328→                    pass\n   329→                pos = stripped.find(\"{\", pos + 1)\n   330→\n   331→        # Strategy 3: raw_decode for multi-line JSON\n   332→        decoder = json.JSONDecoder()\n   333→        for i, ch in enumerate(text):\n   334→            if ch != \"{\":\n   335→                continue\n   336→            try:\n   337→                obj, _ = decoder.raw_decode(text, i)\n   338→                if isinstance(obj, dict):\n   339→                    return obj\n   340→            except json.JSONDecodeError:\n   341→                pass\n   342→\n   343→        return None\n   344→\n   345→    def _parse_json_response(self, stdout: str) -> Dict[str, Any]:\n   346→        \"\"\"Parse JSON from Claude CLI output.\n   347→\n   348→        The CLI may print banner/info lines before the actual JSON,\n   349→        and log/warning lines after it. We extract only the first\n   350→        valid top-level JSON object.\n   351→        \"\"\"\n   352→        if not stdout or not stdout.strip():\n   353→            raise ValueError(\"Claude CLI produced empty output (no JSON to parse)\")\n   354→\n   355→        result = self._try_parse_json(stdout)\n   356→        if result is not None:\n   357→            return result\n   358→\n   359→        raise ValueError(\"No JSON object found in Claude CLI output\")\n   360→\n   361→    def run(self, prompt: str,\n   362→            add_dirs: Optional[List[str]] = None) -> ClaudeResult:\n   363→        \"\"\"Run Claude CLI with the given prompt and return parsed result.\"\"\"\n   364→        self._terminated = False  # Reset on each new run\n   365→        cmd = self._build_command(prompt)\n   366→        # Always use the main project dir as cwd (macOS sandbox restriction:\n   367→        # sandbox_apply fails with exit 71 when cwd is outside the project).\n   368→        cwd = self.config.target_dir\n   369→        if add_dirs:\n   370→            for d in add_dirs:\n   371→                cmd.extend([\"--add-dir\", str(Path(d).resolve())])\n   372→\n   373→        logger.info(\"Running Claude CLI in %s\", cwd)\n   374→        logger.debug(\"Command: %s\", \" \".join(cmd))\n   375→\n   376→        # Check circuit breaker before attempting the call\n   377→        if not self.circuit_breaker.allow_request():\n   378→            logger.warning(\n   379→                \"Circuit breaker is OPEN — blocking Claude API call to prevent \"\n   380→                \"further cost accumulation\"\n   381→            )\n   382→            return ClaudeResult(\n   383→                success=False,\n   384→                error=\"Circuit breaker is open: too many consecutive API failures. \"\n   385→                      \"Will automatically retry after recovery timeout.\",\n   386→            )\n   387→\n   388→        for attempt in range(self.max_retries + 1):\n   389→            # If terminate() was called (e.g. signal handler), stop retrying\n   390→            if self._terminated:\n   391→                return ClaudeResult(\n   392→                    success=False,\n   393→                    error=\"Terminated by signal — aborting retries\",\n   394→                )\n   395→            try:\n   396→                popen_proc = subprocess.Popen(\n   397→                    cmd,\n   398→                    cwd=cwd,\n   399→                    stdout=subprocess.PIPE,\n   400→                    stderr=subprocess.PIPE,\n   401→                    text=True,\n   402→                    start_new_session=True,\n   403→                )\n   404→                with self._process_lock:\n   405→                    self._current_process = popen_proc\n   406→                try:\n   407→                    stdout, stderr = popen_proc.communicate(\n   408→                        timeout=self.config.claude.timeout_seconds,\n   409→                    )\n   410→                except subprocess.TimeoutExpired:\n   411→                    self._kill_process(popen_proc)\n   412→                    raise\n   413→                finally:\n   414→                    with self._process_lock:\n   415→                        self._current_process = None\n   416→\n   417→                # Build a CompletedProcess-like namespace for downstream code\n   418→                class _ProcResult:\n   419→                    pass\n   420→                proc = _ProcResult()\n   421→                proc.returncode = popen_proc.returncode\n   422→                proc.stdout = stdout\n   423→                proc.stderr = stderr\n   424→            except subprocess.TimeoutExpired:\n   425→                if attempt < self.max_retries:\n   426→                    delay = self.retry_delays[min(attempt, len(self.retry_delays) - 1)]\n   427→                    logger.warning(\n   428→                        \"Claude CLI timed out (attempt %d/%d), retrying in %ds\",\n   429→                        attempt + 1, self.max_retries + 1, delay,\n   430→                    )\n   431→                    time.sleep(delay)\n   432→                    continue\n   433→                self.circuit_breaker.record_failure()\n   434→                return ClaudeResult(\n   435→                    success=False,\n   436→                    error=f\"Claude CLI timed out after {self.config.claude.timeout_seconds}s\",\n   437→                )\n   438→            except FileNotFoundError:\n   439→                return ClaudeResult(\n   440→                    success=False,\n   441→                    error=f\"Claude CLI command not found: {self.config.claude.command}\",\n   442→                )\n   443→            except OSError as e:\n   444→                if attempt < self.max_retries:\n   445→                    delay = self.retry_delays[min(attempt, len(self.retry_delays) - 1)]\n   446→                    logger.warning(\n   447→                        \"Claude CLI OS error (attempt %d/%d): %s, retrying in %ds\",\n   448→                        attempt + 1, self.max_retries + 1, e, delay,\n   449→                    )\n   450→                    time.sleep(delay)\n   451→                    continue\n   452→                return ClaudeResult(\n   453→                    success=False,\n   454→                    error=f\"Failed to run Claude CLI: {e}\",\n   455→                )\n   456→\n   457→            if proc.returncode != 0:\n   458→                if attempt < self.max_retries:\n   459→                    stderr_lower = proc.stderr.lower()\n   460→                    if \"rate limit\" in stderr_lower or \"429\" in stderr_lower or \"too many requests\" in stderr_lower:\n   461→                        delay = self.rate_limit_base_delay * (self.rate_limit_multiplier ** attempt)\n   462→                        logger.warning(\n   463→                            \"Rate limited (attempt %d/%d), backing off %ds\",\n   464→                            attempt + 1, self.max_retries + 1, delay,\n   465→                        )\n   466→                    else:\n   467→                        delay = self.retry_delays[min(attempt, len(self.retry_delays) - 1)]\n   468→                        logger.warning(\n   469→                            \"Claude CLI exited with code %d (attempt %d/%d), retrying in %ds\",\n   470→                            proc.returncode, attempt + 1, self.max_retries + 1, delay,\n   471→                        )\n   472→                    time.sleep(delay)\n   473→                    continue\n   474→                # All retries exhausted — update circuit breaker if the error\n   475→                # matches rate-limit or server-error patterns.\n   476→                if self._is_circuit_breaker_error(proc.stderr):\n   477→                    self.circuit_breaker.record_failure()\n   478→                return ClaudeResult(\n   479→                    success=False,\n   480→                    error=f\"Claude CLI exited with code {proc.returncode}: {proc.stderr.strip()}\",\n   481→                )\n   482→\n   483→            # Parse JSON before exiting the loop — retry on truncated output\n   484→            try:\n   485→                data = self._parse_json_response(proc.stdout)\n   486→            except (ValueError, json.JSONDecodeError) as e:\n   487→                stdout_stripped = proc.stdout.strip()\n   488→                looks_truncated = \"{\" in stdout_stripped and not stdout_stripped.endswith(\"}\")\n   489→                if looks_truncated and attempt < self.max_retries:\n   490→                    delay = self.retry_delays[min(attempt, len(self.retry_delays) - 1)]\n   491→                    logger.warning(\n   492→                        \"Output appears truncated (attempt %d/%d), retrying in %ds\",\n   493→                        attempt + 1, self.max_retries + 1, delay,\n   494→                    )\n   495→                    time.sleep(delay)\n   496→                    continue\n   497→                return ClaudeResult(\n   498→                    success=False,\n   499→                    error=f\"Failed to parse Claude CLI output: {e}\",\n   500→                    result_text=proc.stdout,\n   501→                )\n   502→\n   503→            break  # successful parse — exit retry loop\n   504→\n   505→        # Successful API call — reset circuit breaker\n   506→        self.circuit_breaker.record_success()\n   507→\n   508→        if \"result\" not in data:\n   509→            logger.warning(\n   510→                \"Claude CLI JSON response missing 'result' field; \"\n   511→                \"keys present: %s\", sorted(data.keys()),\n   512→            )\n   513→\n   514→        result_text = data.get(\"result\", \"\")\n   515→        cost_usd = data.get(\"total_cost_usd\", data.get(\"cost_usd\", 0.0))\n   516→        duration_ms = data.get(\"duration_ms\", 0)\n   517→        duration = duration_ms / 1000.0 if duration_ms else data.get(\"duration_seconds\", 0.0)\n   518→\n   519→        # Extract token usage for context window tracking\n   520→        usage = data.get(\"usage\", {})\n   521→        input_tokens = usage.get(\"input_tokens\", 0)\n   522→        output_tokens = usage.get(\"output_tokens\", 0)\n   523→        total_tokens = input_tokens + output_tokens\n   524→        context_window_pct = (total_tokens / _DEFAULT_CONTEXT_WINDOW) * 100 if total_tokens else 0.0\n   525→\n   526→        # Detect error_max_turns: Claude ran out of turns before producing\n   527→        # a final result.  Still return success=True because the subprocess\n   528→        # completed normally and may have made useful file changes, but\n   529→        # include a warning in the error field so callers can decide whether\n   530→        # to trust result_text (which may be empty).\n   531→        error_msg = \"\"\n   532→        subtype = data.get(\"subtype\", \"\")\n   533→        if subtype == \"error_max_turns\":\n   534→            error_msg = \"Claude hit max_turns without producing a final result\"\n   535→            logger.warning(\n   536→                \"Claude hit max_turns (%s); result_text may be empty or incomplete\",\n   537→                self.config.claude.max_turns,\n   538→            )\n   539→\n   540→        return ClaudeResult(\n   541→            success=True,\n   542→            result_text=result_text,\n   543→            cost_usd=cost_usd,\n   544→            duration_seconds=duration,\n   545→            raw_json=data,\n   546→            error=error_msg,\n   547→            input_tokens=input_tokens,\n   548→            output_tokens=output_tokens,\n   549→            context_window_pct=context_window_pct,\n   550→        )\n   551→"}]},"parent_tool_use_id":null,"session_id":"21c85918-88f1-4130-b6e5-113fcd6c0d29","uuid":"2615737b-2866-458f-9e94-df9bb550fecb","tool_use_result":{"type":"text","file":{"filePath":"/Users/sameertkhanna/Documents/auto_claude_code/claude_runner.py","content":"\"\"\"Invoke the Claude CLI and parse JSON responses.\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport logging\nimport os\nimport signal\nimport subprocess\nimport threading\nimport time\nfrom dataclasses import dataclass, field\nfrom pathlib import Path\nfrom typing import Any, Callable, Dict, List, Optional\n\nfrom config_schema import Config\nfrom process_utils import kill_process_group\n\nlogger = logging.getLogger(__name__)\n\n# Circuit breaker defaults\nCB_FAILURE_THRESHOLD = 5  # consecutive failures before opening\nCB_RECOVERY_TIMEOUT = 300  # seconds to wait before half-open\nCB_HALF_OPEN_MAX_CALLS = 1  # max calls allowed in half-open state\n\n# Default context window size for token usage percentage calculation\n_DEFAULT_CONTEXT_WINDOW = 200_000\n\n# Stderr patterns that count toward circuit breaker (rate limits, server errors)\n_CB_ERROR_PATTERNS = (\n    \"rate limit\",\n    \"429\",\n    \"too many requests\",\n    \"500\",\n    \"502\",\n    \"503\",\n    \"504\",\n    \"internal server error\",\n    \"bad gateway\",\n    \"service unavailable\",\n    \"gateway timeout\",\n    \"overloaded\",\n    \"server error\",\n)\n\n\nclass CircuitBreaker:\n    \"\"\"Circuit breaker to temporarily disable API calls after repeated failures.\n\n    States:\n      - CLOSED: normal operation, calls are allowed\n      - OPEN: calls are blocked, returns failure immediately\n      - HALF_OPEN: allows a limited number of probe calls to test recovery\n\n    Thread-safe via a threading.Lock.\n    \"\"\"\n\n    STATE_CLOSED = \"closed\"\n    STATE_OPEN = \"open\"\n    STATE_HALF_OPEN = \"half_open\"\n\n    def __init__(\n        self,\n        failure_threshold: int = CB_FAILURE_THRESHOLD,\n        recovery_timeout: float = CB_RECOVERY_TIMEOUT,\n        half_open_max_calls: int = CB_HALF_OPEN_MAX_CALLS,\n        on_open: Optional[Callable[[int, float], None]] = None,\n        max_recovery_timeout: float = 0,\n        jitter_factor: float = 0.25,\n    ):\n        self.failure_threshold = failure_threshold\n        self.recovery_timeout = recovery_timeout\n        self._base_recovery_timeout = recovery_timeout\n        self._max_recovery_timeout = max_recovery_timeout if max_recovery_timeout > 0 else recovery_timeout * 4\n        self._jitter_factor = jitter_factor\n        self._open_count = 0\n        self.half_open_max_calls = half_open_max_calls\n        self._on_open = on_open\n        self._state = self.STATE_CLOSED\n        self._consecutive_failures = 0\n        self._opened_at: float = 0.0\n        self._half_open_calls = 0\n        self._lock = threading.Lock()\n\n    @property\n    def state(self) -> str:\n        with self._lock:\n            return self._get_state()\n\n    def _get_state(self) -> str:\n        \"\"\"Return current state, transitioning OPEN -> HALF_OPEN if recovery timeout elapsed.\"\"\"\n        if self._state == self.STATE_OPEN:\n            if time.monotonic() - self._opened_at >= self.recovery_timeout:\n                self._state = self.STATE_HALF_OPEN\n                self._half_open_calls = 0\n                logger.info(\n                    \"Circuit breaker transitioning from OPEN to HALF_OPEN \"\n                    \"after %.0fs recovery timeout\",\n                    self.recovery_timeout,\n                )\n        return self._state\n\n    def _compute_recovery_timeout(self) -> float:\n        \"\"\"Compute recovery timeout with exponential backoff and jitter.\n\n        Each time the circuit breaker opens, the recovery timeout increases\n        exponentially (base * 2^open_count) up to a maximum. Random jitter\n        is added to prevent thundering herd when multiple workers recover\n        simultaneously.\n        \"\"\"\n        import random\n        # Exponential backoff: base * 2^(open_count - 1), capped at max\n        # First open uses base timeout (2^0=1x), subsequent re-opens escalate\n        exponent = max(0, self._open_count - 1)\n        backoff = min(\n            self._base_recovery_timeout * (2 ** exponent),\n            self._max_recovery_timeout,\n        )\n        # Add jitter: +/- jitter_factor of the backoff value\n        jitter = backoff * self._jitter_factor * (2 * random.random() - 1)\n        return max(self._base_recovery_timeout, backoff + jitter)\n\n    def allow_request(self) -> bool:\n        \"\"\"Check if a request is allowed through the circuit breaker.\"\"\"\n        with self._lock:\n            state = self._get_state()\n            if state == self.STATE_CLOSED:\n                return True\n            if state == self.STATE_HALF_OPEN:\n                if self._half_open_calls < self.half_open_max_calls:\n                    self._half_open_calls += 1\n                    return True\n                return False\n            # STATE_OPEN\n            return False\n\n    def record_success(self) -> None:\n        \"\"\"Record a successful call — resets the circuit breaker to CLOSED.\"\"\"\n        with self._lock:\n            if self._state != self.STATE_CLOSED:\n                logger.info(\n                    \"Circuit breaker resetting to CLOSED after successful call \"\n                    \"(was %s, had %d consecutive failures)\",\n                    self._state, self._consecutive_failures,\n                )\n            self._consecutive_failures = 0\n            self._state = self.STATE_CLOSED\n            self._half_open_calls = 0\n            self._open_count = 0\n            self.recovery_timeout = self._base_recovery_timeout\n\n    def record_failure(self) -> None:\n        \"\"\"Record a failed call — may trip the circuit breaker to OPEN.\"\"\"\n        notify = False\n        with self._lock:\n            self._consecutive_failures += 1\n            if self._state == self.STATE_HALF_OPEN:\n                # Failed during probe — re-open\n                self._open_count += 1\n                self.recovery_timeout = self._compute_recovery_timeout()\n                self._state = self.STATE_OPEN\n                self._opened_at = time.monotonic()\n                notify = True\n                logger.warning(\n                    \"Circuit breaker re-opening after failed probe call \"\n                    \"(%d consecutive failures, recovery_timeout=%.0fs)\",\n                    self._consecutive_failures, self.recovery_timeout,\n                )\n            elif (\n                self._state == self.STATE_CLOSED\n                and self._consecutive_failures >= self.failure_threshold\n            ):\n                self._open_count += 1\n                self.recovery_timeout = self._compute_recovery_timeout()\n                self._state = self.STATE_OPEN\n                self._opened_at = time.monotonic()\n                notify = True\n                logger.warning(\n                    \"Circuit breaker OPEN after %d consecutive failures. \"\n                    \"API calls blocked for %.0fs (backoff level %d).\",\n                    self._consecutive_failures, self.recovery_timeout,\n                    self._open_count,\n                )\n        # Fire notification callback outside the lock to avoid deadlocks\n        if notify and self._on_open is not None:\n            try:\n                self._on_open(self._consecutive_failures, self.recovery_timeout)\n            except Exception:\n                logger.debug(\"Circuit breaker on_open callback raised\", exc_info=True)\n\n    def reset(self) -> None:\n        \"\"\"Manually reset the circuit breaker to CLOSED state.\"\"\"\n        with self._lock:\n            self._state = self.STATE_CLOSED\n            self._consecutive_failures = 0\n            self._half_open_calls = 0\n            self._open_count = 0\n            self.recovery_timeout = self._base_recovery_timeout\n\n\n@dataclass\nclass ClaudeResult:\n    success: bool\n    result_text: str = \"\"\n    cost_usd: float = 0.0\n    duration_seconds: float = 0.0\n    raw_json: Optional[Dict[str, Any]] = None\n    error: str = \"\"\n    input_tokens: int = 0\n    output_tokens: int = 0\n    context_window_pct: float = 0.0\n\n\nclass ClaudeRunner:\n\n    def __init__(self, config: Config):\n        self.config = config\n        self.max_retries = config.claude.max_retries\n        self.retry_delays = config.claude.retry_delays\n        self.rate_limit_base_delay = config.claude.rate_limit_base_delay\n        self.rate_limit_multiplier = config.claude.rate_limit_multiplier\n        self._current_process: subprocess.Popen | None = None\n        self._process_lock = threading.Lock()\n        self._terminated = False  # Set by terminate() to stop retry loop\n        self.circuit_breaker = CircuitBreaker(\n            on_open=self._on_circuit_breaker_open,\n        )\n\n    def _build_command(self, prompt: str) -> List[str]:\n        \"\"\"Build the CLI command list.\"\"\"\n        cc = self.config.claude\n        model = cc.resolved_model or cc.model\n        cmd = [\n            cc.command,\n            \"-p\", prompt,\n            \"--model\", model,\n            \"--max-turns\", str(cc.max_turns),\n            \"--output-format\", \"json\",\n        ]\n        return cmd\n\n    def _on_circuit_breaker_open(self, failures: int, recovery_timeout: float) -> None:\n        \"\"\"Notification callback invoked when the circuit breaker opens.\n\n        Writes a notification file to the state directory so external\n        monitoring tools and users can detect the outage.\n        \"\"\"\n        import datetime as dt\n        state_dir = Path(self.config.paths.state_dir)\n        state_dir.mkdir(parents=True, exist_ok=True)\n        notification_file = state_dir / \"circuit_breaker_open\"\n        try:\n            notification_file.write_text(\n                f\"Circuit breaker OPEN\\n\"\n                f\"Timestamp: {dt.datetime.now(dt.timezone.utc).isoformat()}\\n\"\n                f\"Consecutive failures: {failures}\\n\"\n                f\"Recovery timeout: {recovery_timeout}s\\n\"\n                f\"API calls are blocked until recovery.\\n\"\n            )\n            logger.warning(\n                \"Circuit breaker notification written to %s\",\n                notification_file,\n            )\n        except OSError as e:\n            logger.debug(\"Failed to write circuit breaker notification: %s\", e)\n\n    @staticmethod\n    def _kill_process(proc: subprocess.Popen) -> None:\n        \"\"\"Kill a subprocess and its entire process group.\"\"\"\n        kill_process_group(proc)\n\n    @staticmethod\n    def _is_circuit_breaker_error(stderr: str) -> bool:\n        \"\"\"Check if stderr indicates a rate limit or server error.\"\"\"\n        stderr_lower = stderr.lower()\n        return any(pat in stderr_lower for pat in _CB_ERROR_PATTERNS)\n\n    def terminate(self) -> None:\n        \"\"\"Terminate any currently running Claude subprocess.\n\n        Thread-safe: can be called from a different thread than the one\n        executing run().  Also sets _terminated to prevent the retry loop\n        from spawning new processes after the kill.\n        \"\"\"\n        self._terminated = True\n        with self._process_lock:\n            proc = self._current_process\n        if proc is not None:\n            logger.warning(\"Terminating running Claude subprocess (pid=%s)\", proc.pid)\n            self._kill_process(proc)\n\n    @staticmethod\n    def _try_parse_json(text: str) -> Optional[Dict[str, Any]]:\n        \"\"\"Try to extract a JSON dict from *text* using multiple strategies.\n\n        1. Lines that start with '{' (most common case).\n        2. JSON embedded mid-line (after banner text).\n        3. raw_decode on the full text for multi-line JSON.\n\n        Returns ``None`` when no valid JSON object is found.\n        \"\"\"\n        lines = text.splitlines()\n\n        # Strategy 1: lines starting with '{'\n        for line in lines:\n            stripped = line.strip()\n            if not stripped or not stripped.startswith(\"{\"):\n                continue\n            try:\n                obj = json.loads(stripped)\n                if isinstance(obj, dict):\n                    return obj\n            except json.JSONDecodeError:\n                pass\n\n        # Strategy 2: JSON embedded mid-line\n        for line in lines:\n            stripped = line.strip()\n            pos = stripped.find(\"{\")\n            if pos <= 0:\n                continue\n            while pos != -1:\n                try:\n                    obj = json.loads(stripped[pos:])\n                    if isinstance(obj, dict):\n                        return obj\n                except json.JSONDecodeError:\n                    pass\n                pos = stripped.find(\"{\", pos + 1)\n\n        # Strategy 3: raw_decode for multi-line JSON\n        decoder = json.JSONDecoder()\n        for i, ch in enumerate(text):\n            if ch != \"{\":\n                continue\n            try:\n                obj, _ = decoder.raw_decode(text, i)\n                if isinstance(obj, dict):\n                    return obj\n            except json.JSONDecodeError:\n                pass\n\n        return None\n\n    def _parse_json_response(self, stdout: str) -> Dict[str, Any]:\n        \"\"\"Parse JSON from Claude CLI output.\n\n        The CLI may print banner/info lines before the actual JSON,\n        and log/warning lines after it. We extract only the first\n        valid top-level JSON object.\n        \"\"\"\n        if not stdout or not stdout.strip():\n            raise ValueError(\"Claude CLI produced empty output (no JSON to parse)\")\n\n        result = self._try_parse_json(stdout)\n        if result is not None:\n            return result\n\n        raise ValueError(\"No JSON object found in Claude CLI output\")\n\n    def run(self, prompt: str,\n            add_dirs: Optional[List[str]] = None) -> ClaudeResult:\n        \"\"\"Run Claude CLI with the given prompt and return parsed result.\"\"\"\n        self._terminated = False  # Reset on each new run\n        cmd = self._build_command(prompt)\n        # Always use the main project dir as cwd (macOS sandbox restriction:\n        # sandbox_apply fails with exit 71 when cwd is outside the project).\n        cwd = self.config.target_dir\n        if add_dirs:\n            for d in add_dirs:\n                cmd.extend([\"--add-dir\", str(Path(d).resolve())])\n\n        logger.info(\"Running Claude CLI in %s\", cwd)\n        logger.debug(\"Command: %s\", \" \".join(cmd))\n\n        # Check circuit breaker before attempting the call\n        if not self.circuit_breaker.allow_request():\n            logger.warning(\n                \"Circuit breaker is OPEN — blocking Claude API call to prevent \"\n                \"further cost accumulation\"\n            )\n            return ClaudeResult(\n                success=False,\n                error=\"Circuit breaker is open: too many consecutive API failures. \"\n                      \"Will automatically retry after recovery timeout.\",\n            )\n\n        for attempt in range(self.max_retries + 1):\n            # If terminate() was called (e.g. signal handler), stop retrying\n            if self._terminated:\n                return ClaudeResult(\n                    success=False,\n                    error=\"Terminated by signal — aborting retries\",\n                )\n            try:\n                popen_proc = subprocess.Popen(\n                    cmd,\n                    cwd=cwd,\n                    stdout=subprocess.PIPE,\n                    stderr=subprocess.PIPE,\n                    text=True,\n                    start_new_session=True,\n                )\n                with self._process_lock:\n                    self._current_process = popen_proc\n                try:\n                    stdout, stderr = popen_proc.communicate(\n                        timeout=self.config.claude.timeout_seconds,\n                    )\n                except subprocess.TimeoutExpired:\n                    self._kill_process(popen_proc)\n                    raise\n                finally:\n                    with self._process_lock:\n                        self._current_process = None\n\n                # Build a CompletedProcess-like namespace for downstream code\n                class _ProcResult:\n                    pass\n                proc = _ProcResult()\n                proc.returncode = popen_proc.returncode\n                proc.stdout = stdout\n                proc.stderr = stderr\n            except subprocess.TimeoutExpired:\n                if attempt < self.max_retries:\n                    delay = self.retry_delays[min(attempt, len(self.retry_delays) - 1)]\n                    logger.warning(\n                        \"Claude CLI timed out (attempt %d/%d), retrying in %ds\",\n                        attempt + 1, self.max_retries + 1, delay,\n                    )\n                    time.sleep(delay)\n                    continue\n                self.circuit_breaker.record_failure()\n                return ClaudeResult(\n                    success=False,\n                    error=f\"Claude CLI timed out after {self.config.claude.timeout_seconds}s\",\n                )\n            except FileNotFoundError:\n                return ClaudeResult(\n                    success=False,\n                    error=f\"Claude CLI command not found: {self.config.claude.command}\",\n                )\n            except OSError as e:\n                if attempt < self.max_retries:\n                    delay = self.retry_delays[min(attempt, len(self.retry_delays) - 1)]\n                    logger.warning(\n                        \"Claude CLI OS error (attempt %d/%d): %s, retrying in %ds\",\n                        attempt + 1, self.max_retries + 1, e, delay,\n                    )\n                    time.sleep(delay)\n                    continue\n                return ClaudeResult(\n                    success=False,\n                    error=f\"Failed to run Claude CLI: {e}\",\n                )\n\n            if proc.returncode != 0:\n                if attempt < self.max_retries:\n                    stderr_lower = proc.stderr.lower()\n                    if \"rate limit\" in stderr_lower or \"429\" in stderr_lower or \"too many requests\" in stderr_lower:\n                        delay = self.rate_limit_base_delay * (self.rate_limit_multiplier ** attempt)\n                        logger.warning(\n                            \"Rate limited (attempt %d/%d), backing off %ds\",\n                            attempt + 1, self.max_retries + 1, delay,\n                        )\n                    else:\n                        delay = self.retry_delays[min(attempt, len(self.retry_delays) - 1)]\n                        logger.warning(\n                            \"Claude CLI exited with code %d (attempt %d/%d), retrying in %ds\",\n                            proc.returncode, attempt + 1, self.max_retries + 1, delay,\n                        )\n                    time.sleep(delay)\n                    continue\n                # All retries exhausted — update circuit breaker if the error\n                # matches rate-limit or server-error patterns.\n                if self._is_circuit_breaker_error(proc.stderr):\n                    self.circuit_breaker.record_failure()\n                return ClaudeResult(\n                    success=False,\n                    error=f\"Claude CLI exited with code {proc.returncode}: {proc.stderr.strip()}\",\n                )\n\n            # Parse JSON before exiting the loop — retry on truncated output\n            try:\n                data = self._parse_json_response(proc.stdout)\n            except (ValueError, json.JSONDecodeError) as e:\n                stdout_stripped = proc.stdout.strip()\n                looks_truncated = \"{\" in stdout_stripped and not stdout_stripped.endswith(\"}\")\n                if looks_truncated and attempt < self.max_retries:\n                    delay = self.retry_delays[min(attempt, len(self.retry_delays) - 1)]\n                    logger.warning(\n                        \"Output appears truncated (attempt %d/%d), retrying in %ds\",\n                        attempt + 1, self.max_retries + 1, delay,\n                    )\n                    time.sleep(delay)\n                    continue\n                return ClaudeResult(\n                    success=False,\n                    error=f\"Failed to parse Claude CLI output: {e}\",\n                    result_text=proc.stdout,\n                )\n\n            break  # successful parse — exit retry loop\n\n        # Successful API call — reset circuit breaker\n        self.circuit_breaker.record_success()\n\n        if \"result\" not in data:\n            logger.warning(\n                \"Claude CLI JSON response missing 'result' field; \"\n                \"keys present: %s\", sorted(data.keys()),\n            )\n\n        result_text = data.get(\"result\", \"\")\n        cost_usd = data.get(\"total_cost_usd\", data.get(\"cost_usd\", 0.0))\n        duration_ms = data.get(\"duration_ms\", 0)\n        duration = duration_ms / 1000.0 if duration_ms else data.get(\"duration_seconds\", 0.0)\n\n        # Extract token usage for context window tracking\n        usage = data.get(\"usage\", {})\n        input_tokens = usage.get(\"input_tokens\", 0)\n        output_tokens = usage.get(\"output_tokens\", 0)\n        total_tokens = input_tokens + output_tokens\n        context_window_pct = (total_tokens / _DEFAULT_CONTEXT_WINDOW) * 100 if total_tokens else 0.0\n\n        # Detect error_max_turns: Claude ran out of turns before producing\n        # a final result.  Still return success=True because the subprocess\n        # completed normally and may have made useful file changes, but\n        # include a warning in the error field so callers can decide whether\n        # to trust result_text (which may be empty).\n        error_msg = \"\"\n        subtype = data.get(\"subtype\", \"\")\n        if subtype == \"error_max_turns\":\n            error_msg = \"Claude hit max_turns without producing a final result\"\n            logger.warning(\n                \"Claude hit max_turns (%s); result_text may be empty or incomplete\",\n                self.config.claude.max_turns,\n            )\n\n        return ClaudeResult(\n            success=True,\n            result_text=result_text,\n            cost_usd=cost_usd,\n            duration_seconds=duration,\n            raw_json=data,\n            error=error_msg,\n            input_tokens=input_tokens,\n            output_tokens=output_tokens,\n            context_window_pct=context_window_pct,\n        )\n","numLines":551,"startLine":1,"totalLines":551}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_vrtx_01HTW8xE1axRSAcKns1BiN35","type":"tool_result","content":"     1→\"\"\"Tests for claude_runner module.\"\"\"\n     2→\n     3→import json\n     4→import subprocess\n     5→import time\n     6→from unittest.mock import MagicMock, patch\n     7→\n     8→import pytest\n     9→\n    10→from claude_runner import CircuitBreaker, ClaudeResult, ClaudeRunner\n    11→from config_schema import Config\n    12→\n    13→\n    14→@pytest.fixture\n    15→def runner(default_config):\n    16→    return ClaudeRunner(default_config)\n    17→\n    18→\n    19→class TestBuildCommand:\n    20→    def test_basic_command(self, runner):\n    21→        cmd = runner._build_command(\"Fix the bug\")\n    22→        assert cmd[0] == \"claude\"\n    23→        assert \"-p\" in cmd\n    24→        assert \"Fix the bug\" in cmd\n    25→        assert \"--model\" in cmd\n    26→        assert \"opus\" in cmd\n    27→        assert \"--max-turns\" in cmd\n    28→        assert \"25\" in cmd\n    29→        assert \"--output-format\" in cmd\n    30→        assert \"json\" in cmd\n    31→\n    32→    def test_build_command_uses_resolved_model(self):\n    33→        config = Config()\n    34→        config.claude.resolved_model = \"claude-opus-4-6\"\n    35→        runner = ClaudeRunner(config)\n    36→        cmd = runner._build_command(\"test\")\n    37→        model_idx = cmd.index(\"--model\") + 1\n    38→        assert cmd[model_idx] == \"claude-opus-4-6\"\n    39→\n    40→    def test_build_command_falls_back_to_alias(self):\n    41→        config = Config()\n    42→        config.claude.resolved_model = \"\"\n    43→        runner = ClaudeRunner(config)\n    44→        cmd = runner._build_command(\"test\")\n    45→        model_idx = cmd.index(\"--model\") + 1\n    46→        assert cmd[model_idx] == \"opus\"\n    47→\n    48→\n    49→class TestParseJsonResponse:\n    50→    def test_clean_json(self, runner):\n    51→        stdout = '{\"result\": \"Fixed it\", \"cost_usd\": 0.05}'\n    52→        data = runner._parse_json_response(stdout)\n    53→        assert data[\"result\"] == \"Fixed it\"\n    54→        assert data[\"cost_usd\"] == 0.05\n    55→\n    56→    def test_json_with_banner_lines(self, runner):\n    57→        stdout = (\n    58→            \"Claude Code v1.0\\n\"\n    59→            \"Loading...\\n\"\n    60→            '{\"result\": \"Done\", \"cost_usd\": 0.01}\\n'\n    61→        )\n    62→        data = runner._parse_json_response(stdout)\n    63→        assert data[\"result\"] == \"Done\"\n    64→\n    65→    def test_no_json_raises(self, runner):\n    66→        stdout = \"No JSON here\\nJust text\\n\"\n    67→        with pytest.raises(ValueError, match=\"No JSON\"):\n    68→            runner._parse_json_response(stdout)\n    69→\n    70→    def test_invalid_json_raises(self, runner):\n    71→        stdout = \"{not valid json}\"\n    72→        with pytest.raises(ValueError, match=\"No JSON\"):\n    73→            runner._parse_json_response(stdout)\n    74→\n    75→    def test_json_with_trailing_output(self, runner):\n    76→        stdout = '{\"result\": \"Done\"}\\nSome warning log\\nAnother line\\n'\n    77→        data = runner._parse_json_response(stdout)\n    78→        assert data[\"result\"] == \"Done\"\n    79→\n    80→    def test_json_with_banner_and_trailing_output(self, runner):\n    81→        stdout = 'Banner\\n{\"result\": \"Done\"}\\nTrailing log\\n'\n    82→        data = runner._parse_json_response(stdout)\n    83→        assert data[\"result\"] == \"Done\"\n    84→\n    85→    def test_json_with_nested_braces(self, runner):\n    86→        stdout = '{\"result\": \"Done\", \"meta\": {\"key\": \"val\"}}\\nlog line\\n'\n    87→        data = runner._parse_json_response(stdout)\n    88→        assert data[\"result\"] == \"Done\"\n    89→        assert data[\"meta\"] == {\"key\": \"val\"}\n    90→\n    91→    def test_json_with_braces_in_strings(self, runner):\n    92→        stdout = '{\"result\": \"Fixed {thing}\"}\\nwarning\\n'\n    93→        data = runner._parse_json_response(stdout)\n    94→        assert data[\"result\"] == \"Fixed {thing}\"\n    95→\n    96→    def test_incomplete_json_raises(self, runner):\n    97→        stdout = '{\"result\": \"Done\"'\n    98→        with pytest.raises(ValueError, match=\"No JSON\"):\n    99→            runner._parse_json_response(stdout)\n   100→\n   101→    def test_json_with_array_of_objects(self, runner):\n   102→        stdout = '{\"result\": \"Done\", \"items\": [{\"a\": 1}, {\"b\": 2}]}\\n'\n   103→        data = runner._parse_json_response(stdout)\n   104→        assert data[\"items\"] == [{\"a\": 1}, {\"b\": 2}]\n   105→\n   106→    def test_json_with_unicode_escape_quote(self, runner):\n   107→        stdout = '{\"result\": \"value with \\\\u0022quoted\\\\u0022 text\"}\\n'\n   108→        data = runner._parse_json_response(stdout)\n   109→        assert data[\"result\"] == 'value with \"quoted\" text'\n   110→\n   111→    def test_json_with_deeply_nested_structure(self, runner):\n   112→        stdout = '{\"a\": {\"b\": {\"c\": {\"d\": [1, 2, {\"e\": 3}]}}}}\\ntrailing\\n'\n   113→        data = runner._parse_json_response(stdout)\n   114→        assert data[\"a\"][\"b\"][\"c\"][\"d\"] == [1, 2, {\"e\": 3}]\n   115→\n   116→    def test_json_with_braces_in_banner(self, runner):\n   117→        stdout = 'Info: config={debug: true}\\n{\"result\": \"Done\"}\\n'\n   118→        data = runner._parse_json_response(stdout)\n   119→        assert data[\"result\"] == \"Done\"\n   120→\n   121→    def test_json_after_array_line(self, runner):\n   122→        stdout = '[{\"status\": \"ok\"}, {\"status\": \"done\"}]\\n{\"result\": \"Done\"}\\n'\n   123→        data = runner._parse_json_response(stdout)\n   124→        assert data[\"result\"] == \"Done\"\n   125→\n   126→    def test_json_after_nested_object_in_banner(self, runner):\n   127→        stdout = 'Progress: {\"step\": 1, \"total\": 3}\\n{\"result\": \"Done\", \"cost_usd\": 0.01}\\n'\n   128→        data = runner._parse_json_response(stdout)\n   129→        assert data[\"result\"] == \"Done\"\n   130→\n   131→    def test_multiline_json_object(self, runner):\n   132→        stdout = 'Banner\\n{\\n  \"result\": \"Done\",\\n  \"cost_usd\": 0.01\\n}\\nTrailing\\n'\n   133→        data = runner._parse_json_response(stdout)\n   134→        assert data[\"result\"] == \"Done\"\n   135→\n   136→    def test_json_mid_line_with_prefix_text(self, runner):\n   137→        stdout = 'Some info: {\"result\": \"Done\", \"cost_usd\": 0.01}\\n'\n   138→        data = runner._parse_json_response(stdout)\n   139→        assert data[\"result\"] == \"Done\"\n   140→        assert data[\"cost_usd\"] == 0.01\n   141→\n   142→    def test_json_mid_line_with_banner_and_prefix(self, runner):\n   143→        stdout = 'Banner line\\nProgress: {\"result\": \"Done\"}\\nTrailing\\n'\n   144→        data = runner._parse_json_response(stdout)\n   145→        assert data[\"result\"] == \"Done\"\n   146→\n   147→    def test_multiline_json_starting_mid_line(self, runner):\n   148→        stdout = 'Prefix text {\\n  \"result\": \"Done\",\\n  \"cost_usd\": 0.01\\n}\\n'\n   149→        data = runner._parse_json_response(stdout)\n   150→        assert data[\"result\"] == \"Done\"\n   151→        assert data[\"cost_usd\"] == 0.01\n   152→\n   153→    def test_mid_line_json_prefers_valid_object(self, runner):\n   154→        stdout = 'bad {stuff\\n{\"result\": \"Done\"}\\n'\n   155→        data = runner._parse_json_response(stdout)\n   156→        assert data[\"result\"] == \"Done\"\n   157→\n   158→    def test_multiline_json_with_multi_line_preceding_text(self, runner):\n   159→        stdout = 'Banner line 1\\nBanner line 2\\nMore text {\\n  \"result\": \"Done\",\\n  \"cost_usd\": 0.01\\n}\\n'\n   160→        data = runner._parse_json_response(stdout)\n   161→        assert data[\"result\"] == \"Done\"\n   162→        assert data[\"cost_usd\"] == 0.01\n   163→\n   164→    def test_json_with_object_literal_in_string_value(self, runner):\n   165→        \"\"\"JSON with escaped braces and quotes inside string values.\"\"\"\n   166→        stdout = '{\"result\": \"Use {\\\\\"key\\\\\": \\\\\"val\\\\\"} syntax\", \"cost_usd\": 0.01}\\n'\n   167→        data = runner._parse_json_response(stdout)\n   168→        assert data[\"result\"] == 'Use {\"key\": \"val\"} syntax'\n   169→        assert data[\"cost_usd\"] == 0.01\n   170→\n   171→    def test_multiline_json_with_braces_in_strings(self, runner):\n   172→        \"\"\"Multiline JSON where string values contain unmatched braces.\"\"\"\n   173→        stdout = (\n   174→            'Banner\\n'\n   175→            '{\\n'\n   176→            '  \"result\": \"Fixed {broken} stuff\",\\n'\n   177→            '  \"details\": \"Replaced { with }\",\\n'\n   178→            '  \"cost_usd\": 0.02\\n'\n   179→            '}\\n'\n   180→        )\n   181→        data = runner._parse_json_response(stdout)\n   182→        assert data[\"result\"] == \"Fixed {broken} stuff\"\n   183→        assert data[\"details\"] == \"Replaced { with }\"\n   184→        assert data[\"cost_usd\"] == 0.02\n   185→\n   186→\n   187→def _make_popen_mock(returncode=0, stdout=\"\", stderr=\"\", communicate_effect=None):\n   188→    \"\"\"Create a mock subprocess.Popen that behaves like the real thing.\"\"\"\n   189→    mock_proc = MagicMock()\n   190→    mock_proc.pid = 12345\n   191→    mock_proc.returncode = returncode\n   192→    if communicate_effect is not None:\n   193→        mock_proc.communicate.side_effect = communicate_effect\n   194→    else:\n   195→        mock_proc.communicate.return_value = (stdout, stderr)\n   196→    return mock_proc\n   197→\n   198→\n   199→class TestRun:\n   200→    @patch(\"claude_runner.subprocess.Popen\")\n   201→    def test_successful_run(self, mock_popen, runner):\n   202→        mock_popen.return_value = _make_popen_mock(\n   203→            returncode=0,\n   204→            stdout='{\"result\": \"Fixed bug\", \"cost_usd\": 0.03, \"duration_seconds\": 12.5}',\n   205→        )\n   206→        result = runner.run(\"Fix the bug\")\n   207→        assert result.success is True\n   208→        assert result.result_text == \"Fixed bug\"\n   209→        assert result.cost_usd == 0.03\n   210→        assert result.duration_seconds == 12.5\n   211→\n   212→    @patch(\"claude_runner.subprocess.Popen\")\n   213→    def test_cwd_always_uses_target_dir(self, mock_popen, runner):\n   214→        \"\"\"cwd should always be config.target_dir.\"\"\"\n   215→        mock_popen.return_value = _make_popen_mock(\n   216→            returncode=0,\n   217→            stdout='{\"result\": \"Done\", \"cost_usd\": 0.01}',\n   218→        )\n   219→        runner.run(\"Fix the bug\")\n   220→        popen_call = mock_popen.call_args\n   221→        assert popen_call.kwargs[\"cwd\"] == runner.config.target_dir\n   222→\n   223→    @patch(\"claude_runner.subprocess.Popen\")\n   224→    def test_add_dirs_appends_flags(self, mock_popen, runner):\n   225→        \"\"\"add_dirs should append --add-dir flags to the command.\"\"\"\n   226→        mock_popen.return_value = _make_popen_mock(\n   227→            returncode=0,\n   228→            stdout='{\"result\": \"Done\", \"cost_usd\": 0.01}',\n   229→        )\n   230→        runner.run(\"Fix the bug\", add_dirs=[\"/tmp/worktree-0\", \"/tmp/worktree-1\"])\n   231→        cmd = mock_popen.call_args[0][0]\n   232→        # Find all --add-dir flags\n   233→        add_dir_indices = [i for i, x in enumerate(cmd) if x == \"--add-dir\"]\n   234→        assert len(add_dir_indices) == 2\n   235→        dirs = [cmd[i + 1] for i in add_dir_indices]\n   236→        assert \"/tmp/worktree-0\" in dirs[0]\n   237→        assert \"/tmp/worktree-1\" in dirs[1]\n   238→\n   239→    @patch(\"claude_runner.subprocess.Popen\")\n   240→    def test_add_dirs_none_no_flags(self, mock_popen, runner):\n   241→        \"\"\"When add_dirs is None, no --add-dir flags should be added.\"\"\"\n   242→        mock_popen.return_value = _make_popen_mock(\n   243→            returncode=0,\n   244→            stdout='{\"result\": \"Done\", \"cost_usd\": 0.01}',\n   245→        )\n   246→        runner.run(\"Fix the bug\")\n   247→        cmd = mock_popen.call_args[0][0]\n   248→        assert \"--add-dir\" not in cmd\n   249→\n   250→    @patch(\"claude_runner.subprocess.Popen\")\n   251→    def test_timeout(self, mock_popen, runner):\n   252→        mock_popen.return_value = _make_popen_mock(\n   253→            communicate_effect=subprocess.TimeoutExpired(cmd=\"claude\", timeout=300),\n   254→        )\n   255→        result = runner.run(\"Fix the bug\")\n   256→        assert result.success is False\n   257→        assert \"timed out\" in result.error\n   258→\n   259→    @patch(\"claude_runner.subprocess.Popen\")\n   260→    def test_command_not_found(self, mock_popen, runner):\n   261→        mock_popen.side_effect = FileNotFoundError()\n   262→        result = runner.run(\"Fix the bug\")\n   263→        assert result.success is False\n   264→        assert \"not found\" in result.error\n   265→\n   266→    @patch(\"claude_runner.subprocess.Popen\")\n   267→    def test_nonzero_exit(self, mock_popen, runner):\n   268→        mock_popen.return_value = _make_popen_mock(\n   269→            returncode=1,\n   270→            stderr=\"Error occurred\",\n   271→        )\n   272→        result = runner.run(\"Fix the bug\")\n   273→        assert result.success is False\n   274→        assert \"exited with code 1\" in result.error\n   275→\n   276→    @patch(\"claude_runner.subprocess.Popen\")\n   277→    def test_unparseable_output(self, mock_popen, runner):\n   278→        mock_popen.return_value = _make_popen_mock(\n   279→            returncode=0,\n   280→            stdout=\"Not JSON at all\",\n   281→        )\n   282→        result = runner.run(\"Fix the bug\")\n   283→        assert result.success is False\n   284→        assert \"parse\" in result.error.lower()\n   285→\n   286→\n   287→class TestRetryLogic:\n   288→    @patch(\"claude_runner.time.sleep\")\n   289→    @patch(\"claude_runner.subprocess.Popen\")\n   290→    def test_retry_on_timeout(self, mock_popen, mock_sleep, runner):\n   291→        \"\"\"Retries on TimeoutExpired, succeeds on third attempt.\"\"\"\n   292→        mock_popen.side_effect = [\n   293→            _make_popen_mock(communicate_effect=subprocess.TimeoutExpired(cmd=\"claude\", timeout=300)),\n   294→            _make_popen_mock(communicate_effect=subprocess.TimeoutExpired(cmd=\"claude\", timeout=300)),\n   295→            _make_popen_mock(returncode=0, stdout='{\"result\": \"Done\", \"cost_usd\": 0.01}'),\n   296→        ]\n   297→        result = runner.run(\"Fix the bug\")\n   298→        assert result.success is True\n   299→        assert result.result_text == \"Done\"\n   300→        assert mock_popen.call_count == 3\n   301→        assert mock_sleep.call_count == 2\n   302→        mock_sleep.assert_any_call(2)\n   303→        mock_sleep.assert_any_call(8)\n   304→\n   305→    @patch(\"claude_runner.time.sleep\")\n   306→    @patch(\"claude_runner.subprocess.Popen\")\n   307→    def test_retry_on_nonzero_exit(self, mock_popen, mock_sleep, runner):\n   308→        \"\"\"Retries on non-zero exit code, succeeds on third attempt.\"\"\"\n   309→        mock_popen.side_effect = [\n   310→            _make_popen_mock(returncode=1, stderr=\"rate limited\"),\n   311→            _make_popen_mock(returncode=1, stderr=\"rate limited\"),\n   312→            _make_popen_mock(returncode=0, stdout='{\"result\": \"Fixed\", \"cost_usd\": 0.02}'),\n   313→        ]\n   314→        result = runner.run(\"Fix the bug\")\n   315→        assert result.success is True\n   316→        assert result.result_text == \"Fixed\"\n   317→        assert mock_popen.call_count == 3\n   318→\n   319→    @patch(\"claude_runner.time.sleep\")\n   320→    @patch(\"claude_runner.subprocess.Popen\")\n   321→    def test_no_retry_on_file_not_found(self, mock_popen, mock_sleep, runner):\n   322→        \"\"\"FileNotFoundError is not retryable — returns immediately.\"\"\"\n   323→        mock_popen.side_effect = FileNotFoundError()\n   324→        result = runner.run(\"Fix the bug\")\n   325→        assert result.success is False\n   326→        assert \"not found\" in result.error\n   327→        assert mock_popen.call_count == 1\n   328→        mock_sleep.assert_not_called()\n   329→\n   330→    @patch(\"claude_runner.time.sleep\")\n   331→    @patch(\"claude_runner.subprocess.Popen\")\n   332→    def test_no_retry_on_json_parse_failure(self, mock_popen, mock_sleep, runner):\n   333→        \"\"\"JSON parse failure is not retryable — CLI ran fine, output was bad.\"\"\"\n   334→        mock_popen.return_value = _make_popen_mock(\n   335→            returncode=0,\n   336→            stdout=\"Not JSON at all\",\n   337→        )\n   338→        result = runner.run(\"Fix the bug\")\n   339→        assert result.success is False\n   340→        assert \"parse\" in result.error.lower()\n   341→        assert mock_popen.call_count == 1\n   342→        mock_sleep.assert_not_called()\n   343→\n   344→    @patch(\"claude_runner.time.sleep\")\n   345→    @patch(\"claude_runner.subprocess.Popen\")\n   346→    def test_all_retries_exhausted(self, mock_popen, mock_sleep, runner):\n   347→        \"\"\"All retries exhausted returns failure.\"\"\"\n   348→        mock_popen.side_effect = [\n   349→            _make_popen_mock(communicate_effect=subprocess.TimeoutExpired(cmd=\"claude\", timeout=300))\n   350→            for _ in range(4)\n   351→        ]\n   352→        result = runner.run(\"Fix the bug\")\n   353→        assert result.success is False\n   354→        assert \"timed out\" in result.error\n   355→        assert mock_popen.call_count == 4  # 1 initial + 3 retries\n   356→        assert mock_sleep.call_count == 3\n   357→\n   358→    @patch(\"claude_runner.time.sleep\")\n   359→    @patch(\"claude_runner.subprocess.Popen\")\n   360→    def test_retry_delays_are_exponential(self, mock_popen, mock_sleep, runner):\n   361→        \"\"\"Verify exponential backoff delays: 2, 8, 32.\"\"\"\n   362→        mock_popen.side_effect = [\n   363→            _make_popen_mock(communicate_effect=subprocess.TimeoutExpired(cmd=\"claude\", timeout=300))\n   364→            for _ in range(4)\n   365→        ]\n   366→        runner.run(\"Fix the bug\")\n   367→        delays = [call.args[0] for call in mock_sleep.call_args_list]\n   368→        assert delays == [2, 8, 32]\n   369→\n   370→    @patch(\"claude_runner.time.sleep\")\n   371→    @patch(\"claude_runner.subprocess.Popen\")\n   372→    def test_retry_on_os_error(self, mock_popen, mock_sleep, runner):\n   373→        \"\"\"Retries on OSError, succeeds on second attempt.\"\"\"\n   374→        mock_popen.side_effect = [\n   375→            OSError(\"Connection reset\"),\n   376→            _make_popen_mock(returncode=0, stdout='{\"result\": \"Done\", \"cost_usd\": 0.01}'),\n   377→        ]\n   378→        result = runner.run(\"Fix the bug\")\n   379→        assert result.success is True\n   380→        assert mock_popen.call_count == 2\n   381→        mock_sleep.assert_called_once_with(2)\n   382→\n   383→\n   384→class TestRateLimitBackoff:\n   385→    @patch(\"claude_runner.time.sleep\")\n   386→    @patch(\"claude_runner.subprocess.Popen\")\n   387→    def test_rate_limit_exponential_backoff(self, mock_popen, mock_sleep, runner):\n   388→        \"\"\"Rate limit errors should use exponential backoff (5, 15, 45) not fixed delays.\"\"\"\n   389→        mock_popen.side_effect = [\n   390→            _make_popen_mock(returncode=1, stderr=\"rate limit exceeded\"),\n   391→            _make_popen_mock(returncode=1, stderr=\"rate limit exceeded\"),\n   392→            _make_popen_mock(returncode=1, stderr=\"rate limit exceeded\"),\n   393→            _make_popen_mock(returncode=1, stderr=\"rate limit exceeded\"),\n   394→        ]\n   395→        result = runner.run(\"Fix the bug\")\n   396→        assert result.success is False\n   397→        delays = [call.args[0] for call in mock_sleep.call_args_list]\n   398→        # Exponential: 5 * 3^0 = 5, 5 * 3^1 = 15, 5 * 3^2 = 45\n   399→        assert delays == [5, 15, 45]\n   400→\n   401→    @patch(\"claude_runner.time.sleep\")\n   402→    @patch(\"claude_runner.subprocess.Popen\")\n   403→    def test_non_rate_limit_uses_fixed_delays(self, mock_popen, mock_sleep, runner):\n   404→        \"\"\"Non-rate-limit errors should still use the fixed delays (2, 8, 32).\"\"\"\n   405→        mock_popen.side_effect = [\n   406→            _make_popen_mock(returncode=1, stderr=\"some other error\"),\n   407→            _make_popen_mock(returncode=1, stderr=\"some other error\"),\n   408→            _make_popen_mock(returncode=1, stderr=\"some other error\"),\n   409→            _make_popen_mock(returncode=1, stderr=\"some other error\"),\n   410→        ]\n   411→        result = runner.run(\"Fix the bug\")\n   412→        assert result.success is False\n   413→        delays = [call.args[0] for call in mock_sleep.call_args_list]\n   414→        assert delays == [2, 8, 32]\n   415→\n   416→    @patch(\"claude_runner.time.sleep\")\n   417→    @patch(\"claude_runner.subprocess.Popen\")\n   418→    def test_rate_limit_429_detected(self, mock_popen, mock_sleep, runner):\n   419→        \"\"\"429 in stderr should trigger rate limit backoff.\"\"\"\n   420→        mock_popen.side_effect = [\n   421→            _make_popen_mock(returncode=1, stderr=\"HTTP 429 Too Many Requests\"),\n   422→            _make_popen_mock(returncode=0, stdout='{\"result\": \"Done\", \"cost_usd\": 0.01}'),\n   423→        ]\n   424→        result = runner.run(\"Fix the bug\")\n   425→        assert result.success is True\n   426→        mock_sleep.assert_called_once_with(5)  # 5 * 3^0 = 5\n   427→\n   428→\n   429→class TestCostParsing:\n   430→    \"\"\"Test that cost_usd and duration_seconds are parsed correctly from CLI output.\"\"\"\n   431→\n   432→    @patch(\"claude_runner.subprocess.Popen\")\n   433→    def test_new_field_names(self, mock_popen, runner):\n   434→        \"\"\"total_cost_usd and duration_ms are the actual CLI field names.\"\"\"\n   435→        mock_popen.return_value = _make_popen_mock(\n   436→            returncode=0,\n   437→            stdout='{\"result\": \"Done\", \"total_cost_usd\": 0.037, \"duration_ms\": 2467}',\n   438→        )\n   439→        result = runner.run(\"Fix\")\n   440→        assert result.success is True\n   441→        assert result.cost_usd == 0.037\n   442→        assert abs(result.duration_seconds - 2.467) < 0.001\n   443→\n   444→    @patch(\"claude_runner.subprocess.Popen\")\n   445→    def test_old_field_names_fallback(self, mock_popen, runner):\n   446→        \"\"\"Falls back to cost_usd and duration_seconds for backward compat.\"\"\"\n   447→        mock_popen.return_value = _make_popen_mock(\n   448→            returncode=0,\n   449→            stdout='{\"result\": \"Done\", \"cost_usd\": 0.05, \"duration_seconds\": 12.5}',\n   450→        )\n   451→        result = runner.run(\"Fix\")\n   452→        assert result.success is True\n   453→        assert result.cost_usd == 0.05\n   454→        assert result.duration_seconds == 12.5\n   455→\n   456→    @patch(\"claude_runner.subprocess.Popen\")\n   457→    def test_new_fields_take_precedence(self, mock_popen, runner):\n   458→        \"\"\"When both old and new fields are present, new ones win.\"\"\"\n   459→        mock_popen.return_value = _make_popen_mock(\n   460→            returncode=0,\n   461→            stdout='{\"result\": \"Done\", \"total_cost_usd\": 0.1, \"cost_usd\": 0.05, \"duration_ms\": 5000, \"duration_seconds\": 2.0}',\n   462→        )\n   463→        result = runner.run(\"Fix\")\n   464→        assert result.success is True\n   465→        assert result.cost_usd == 0.1\n   466→        assert result.duration_seconds == 5.0\n   467→\n   468→    @patch(\"claude_runner.subprocess.Popen\")\n   469→    def test_missing_cost_fields_default_to_zero(self, mock_popen, runner):\n   470→        \"\"\"When no cost/duration fields, defaults to 0.\"\"\"\n   471→        mock_popen.return_value = _make_popen_mock(\n   472→            returncode=0,\n   473→            stdout='{\"result\": \"Done\"}',\n   474→        )\n   475→        result = runner.run(\"Fix\")\n   476→        assert result.success is True\n   477→        assert result.cost_usd == 0.0\n   478→        assert result.duration_seconds == 0.0\n   479→\n   480→    @patch(\"claude_runner.subprocess.Popen\")\n   481→    def test_duration_ms_zero_falls_back_to_seconds(self, mock_popen, runner):\n   482→        \"\"\"duration_ms=0 should fall back to duration_seconds.\"\"\"\n   483→        mock_popen.return_value = _make_popen_mock(\n   484→            returncode=0,\n   485→            stdout='{\"result\": \"Done\", \"duration_ms\": 0, \"duration_seconds\": 3.5}',\n   486→        )\n   487→        result = runner.run(\"Fix\")\n   488→        assert result.success is True\n   489→        assert result.duration_seconds == 3.5\n   490→\n   491→\n   492→class TestMissingResultField:\n   493→    \"\"\"Test handling of JSON responses missing the 'result' field.\"\"\"\n   494→\n   495→    @patch(\"claude_runner.subprocess.Popen\")\n   496→    def test_missing_result_field_logs_warning(self, mock_popen, runner, caplog):\n   497→        \"\"\"JSON without 'result' key should log a warning.\"\"\"\n   498→        import logging\n   499→        mock_popen.return_value = _make_popen_mock(\n   500→            returncode=0,\n   501→            stdout='{\"cost_usd\": 0.05}',\n   502→        )\n   503→        with caplog.at_level(logging.WARNING):\n   504→            result = runner.run(\"Fix\")\n   505→        assert result.success is True\n   506→        assert result.result_text == \"\"\n   507→        assert any(\"missing 'result' field\" in r.message for r in caplog.records)\n   508→\n   509→    @patch(\"claude_runner.subprocess.Popen\")\n   510→    def test_missing_result_field_returns_success(self, mock_popen, runner):\n   511→        \"\"\"Result should still be success=True with empty result_text when 'result' is missing.\"\"\"\n   512→        mock_popen.return_value = _make_popen_mock(\n   513→            returncode=0,\n   514→            stdout='{\"total_cost_usd\": 0.03, \"duration_ms\": 1000}',\n   515→        )\n   516→        result = runner.run(\"Fix\")\n   517→        assert result.success is True\n   518→        assert result.result_text == \"\"\n   519→        assert result.cost_usd == 0.03\n   520→        assert result.duration_seconds == 1.0\n   521→\n   522→\n   523→class TestCircuitBreaker:\n   524→    \"\"\"Test circuit breaker state transitions and recovery behavior.\"\"\"\n   525→\n   526→    def test_initial_state_is_closed(self):\n   527→        cb = CircuitBreaker()\n   528→        assert cb.state == CircuitBreaker.STATE_CLOSED\n   529→\n   530→    def test_allow_request_when_closed(self):\n   531→        cb = CircuitBreaker()\n   532→        assert cb.allow_request() is True\n   533→\n   534→    def test_stays_closed_below_threshold(self):\n   535→        cb = CircuitBreaker(failure_threshold=5)\n   536→        for _ in range(4):\n   537→            cb.record_failure()\n   538→        assert cb.state == CircuitBreaker.STATE_CLOSED\n   539→        assert cb.allow_request() is True\n   540→\n   541→    def test_opens_at_failure_threshold(self):\n   542→        cb = CircuitBreaker(failure_threshold=3)\n   543→        for _ in range(3):\n   544→            cb.record_failure()\n   545→        assert cb.state == CircuitBreaker.STATE_OPEN\n   546→        assert cb.allow_request() is False\n   547→\n   548→    def test_blocks_requests_when_open(self):\n   549→        cb = CircuitBreaker(failure_threshold=2)\n   550→        cb.record_failure()\n   551→        cb.record_failure()\n   552→        assert cb.state == CircuitBreaker.STATE_OPEN\n   553→        assert cb.allow_request() is False\n   554→        assert cb.allow_request() is False\n   555→\n   556→    def test_transitions_to_half_open_after_recovery_timeout(self):\n   557→        cb = CircuitBreaker(failure_threshold=2, recovery_timeout=1, jitter_factor=0)\n   558→        cb.record_failure()\n   559→        cb.record_failure()\n   560→        assert cb.state == CircuitBreaker.STATE_OPEN\n   561→        # Wait for recovery timeout\n   562→        time.sleep(1.1)\n   563→        assert cb.state == CircuitBreaker.STATE_HALF_OPEN\n   564→\n   565→    def test_half_open_allows_limited_calls(self):\n   566→        cb = CircuitBreaker(failure_threshold=2, recovery_timeout=0, half_open_max_calls=1)\n   567→        cb.record_failure()\n   568→        cb.record_failure()\n   569→        # Recovery timeout is 0, should immediately transition\n   570→        assert cb.state == CircuitBreaker.STATE_HALF_OPEN\n   571→        # First call allowed\n   572→        assert cb.allow_request() is True\n   573→        # Second call blocked (max=1)\n   574→        assert cb.allow_request() is False\n   575→\n   576→    def test_half_open_success_resets_to_closed(self):\n   577→        cb = CircuitBreaker(failure_threshold=2, recovery_timeout=0)\n   578→        cb.record_failure()\n   579→        cb.record_failure()\n   580→        # Force transition to HALF_OPEN\n   581→        assert cb.state == CircuitBreaker.STATE_HALF_OPEN\n   582→        cb.record_success()\n   583→        assert cb.state == CircuitBreaker.STATE_CLOSED\n   584→        assert cb.allow_request() is True\n   585→\n   586→    def test_half_open_failure_reopens(self):\n   587→        cb = CircuitBreaker(failure_threshold=2, recovery_timeout=0, half_open_max_calls=1)\n   588→        cb.record_failure()\n   589→        cb.record_failure()\n   590→        # Force transition to HALF_OPEN (recovery_timeout=0 means immediate transition)\n   591→        _ = cb.state  # triggers transition\n   592→        assert cb.allow_request() is True  # probe call\n   593→        cb.record_failure()\n   594→        # record_failure sets state to OPEN, but with recovery_timeout=0 the\n   595→        # .state property immediately transitions back to HALF_OPEN.\n   596→        # Verify the internal state was set to OPEN by record_failure:\n   597→        assert cb._state == CircuitBreaker.STATE_OPEN\n   598→        # And that accessing .state triggers the immediate recovery transition:\n   599→        assert cb.state == CircuitBreaker.STATE_HALF_OPEN\n   600→\n   601→    def test_half_open_failure_reopens_with_timeout(self):\n   602→        \"\"\"Verify that a failure during HALF_OPEN re-opens the circuit with a real timeout.\"\"\"\n   603→        cb = CircuitBreaker(failure_threshold=2, recovery_timeout=300, half_open_max_calls=1)\n   604→        cb.record_failure()\n   605→        cb.record_failure()\n   606→        # Manually transition to HALF_OPEN for testing\n   607→        cb._state = CircuitBreaker.STATE_HALF_OPEN\n   608→        cb._half_open_calls = 0\n   609→        assert cb.allow_request() is True  # probe call\n   610→        cb.record_failure()\n   611→        assert cb.state == CircuitBreaker.STATE_OPEN\n   612→\n   613→    def test_success_resets_failure_count(self):\n   614→        cb = CircuitBreaker(failure_threshold=5)\n   615→        for _ in range(4):\n   616→            cb.record_failure()\n   617→        cb.record_success()\n   618→        assert cb.state == CircuitBreaker.STATE_CLOSED\n   619→        # Need 5 more failures to open again\n   620→        for _ in range(4):\n   621→            cb.record_failure()\n   622→        assert cb.state == CircuitBreaker.STATE_CLOSED\n   623→\n   624→    def test_manual_reset(self):\n   625→        cb = CircuitBreaker(failure_threshold=2)\n   626→        cb.record_failure()\n   627→        cb.record_failure()\n   628→        assert cb.state == CircuitBreaker.STATE_OPEN\n   629→        cb.reset()\n   630→        assert cb.state == CircuitBreaker.STATE_CLOSED\n   631→        assert cb.allow_request() is True\n   632→\n   633→    def test_custom_parameters(self):\n   634→        cb = CircuitBreaker(failure_threshold=10, recovery_timeout=600, half_open_max_calls=3)\n   635→        assert cb.failure_threshold == 10\n   636→        assert cb.recovery_timeout == 600\n   637→        assert cb.half_open_max_calls == 3\n   638→\n   639→\n   640→class TestCircuitBreakerIntegration:\n   641→    \"\"\"Test circuit breaker integration with ClaudeRunner.\"\"\"\n   642→\n   643→    @patch(\"claude_runner.subprocess.Popen\")\n   644→    def test_run_blocked_by_open_circuit_breaker(self, mock_popen, runner):\n   645→        \"\"\"When circuit breaker is open, run() should return failure without calling subprocess.\"\"\"\n   646→        runner.circuit_breaker._state = CircuitBreaker.STATE_OPEN\n   647→        runner.circuit_breaker._opened_at = time.monotonic()  # recent, so won't auto-transition\n   648→        result = runner.run(\"Fix the bug\")\n   649→        assert result.success is False\n   650→        assert \"Circuit breaker\" in result.error\n   651→        mock_popen.assert_not_called()\n   652→\n   653→    def test_is_circuit_breaker_error_patterns(self):\n   654→        \"\"\"Verify all expected error patterns are detected.\"\"\"\n   655→        assert ClaudeRunner._is_circuit_breaker_error(\"rate limit exceeded\") is True\n   656→        assert ClaudeRunner._is_circuit_breaker_error(\"HTTP 429 Too Many Requests\") is True\n   657→        assert ClaudeRunner._is_circuit_breaker_error(\"Error 500 Internal\") is True\n   658→        assert ClaudeRunner._is_circuit_breaker_error(\"502 Bad Gateway\") is True\n   659→        assert ClaudeRunner._is_circuit_breaker_error(\"503 Service Unavailable\") is True\n   660→        assert ClaudeRunner._is_circuit_breaker_error(\"504 Gateway Timeout\") is True\n   661→        assert ClaudeRunner._is_circuit_breaker_error(\"server is overloaded\") is True\n   662→        assert ClaudeRunner._is_circuit_breaker_error(\"normal error\") is False\n   663→        assert ClaudeRunner._is_circuit_breaker_error(\"success\") is False\n   664→"}]},"parent_tool_use_id":null,"session_id":"21c85918-88f1-4130-b6e5-113fcd6c0d29","uuid":"e615754b-4e63-4a9e-b67b-78cce37d9f43","tool_use_result":{"type":"text","file":{"filePath":"/Users/sameertkhanna/Documents/auto_claude_code/tests/test_claude_runner.py","content":"\"\"\"Tests for claude_runner module.\"\"\"\n\nimport json\nimport subprocess\nimport time\nfrom unittest.mock import MagicMock, patch\n\nimport pytest\n\nfrom claude_runner import CircuitBreaker, ClaudeResult, ClaudeRunner\nfrom config_schema import Config\n\n\n@pytest.fixture\ndef runner(default_config):\n    return ClaudeRunner(default_config)\n\n\nclass TestBuildCommand:\n    def test_basic_command(self, runner):\n        cmd = runner._build_command(\"Fix the bug\")\n        assert cmd[0] == \"claude\"\n        assert \"-p\" in cmd\n        assert \"Fix the bug\" in cmd\n        assert \"--model\" in cmd\n        assert \"opus\" in cmd\n        assert \"--max-turns\" in cmd\n        assert \"25\" in cmd\n        assert \"--output-format\" in cmd\n        assert \"json\" in cmd\n\n    def test_build_command_uses_resolved_model(self):\n        config = Config()\n        config.claude.resolved_model = \"claude-opus-4-6\"\n        runner = ClaudeRunner(config)\n        cmd = runner._build_command(\"test\")\n        model_idx = cmd.index(\"--model\") + 1\n        assert cmd[model_idx] == \"claude-opus-4-6\"\n\n    def test_build_command_falls_back_to_alias(self):\n        config = Config()\n        config.claude.resolved_model = \"\"\n        runner = ClaudeRunner(config)\n        cmd = runner._build_command(\"test\")\n        model_idx = cmd.index(\"--model\") + 1\n        assert cmd[model_idx] == \"opus\"\n\n\nclass TestParseJsonResponse:\n    def test_clean_json(self, runner):\n        stdout = '{\"result\": \"Fixed it\", \"cost_usd\": 0.05}'\n        data = runner._parse_json_response(stdout)\n        assert data[\"result\"] == \"Fixed it\"\n        assert data[\"cost_usd\"] == 0.05\n\n    def test_json_with_banner_lines(self, runner):\n        stdout = (\n            \"Claude Code v1.0\\n\"\n            \"Loading...\\n\"\n            '{\"result\": \"Done\", \"cost_usd\": 0.01}\\n'\n        )\n        data = runner._parse_json_response(stdout)\n        assert data[\"result\"] == \"Done\"\n\n    def test_no_json_raises(self, runner):\n        stdout = \"No JSON here\\nJust text\\n\"\n        with pytest.raises(ValueError, match=\"No JSON\"):\n            runner._parse_json_response(stdout)\n\n    def test_invalid_json_raises(self, runner):\n        stdout = \"{not valid json}\"\n        with pytest.raises(ValueError, match=\"No JSON\"):\n            runner._parse_json_response(stdout)\n\n    def test_json_with_trailing_output(self, runner):\n        stdout = '{\"result\": \"Done\"}\\nSome warning log\\nAnother line\\n'\n        data = runner._parse_json_response(stdout)\n        assert data[\"result\"] == \"Done\"\n\n    def test_json_with_banner_and_trailing_output(self, runner):\n        stdout = 'Banner\\n{\"result\": \"Done\"}\\nTrailing log\\n'\n        data = runner._parse_json_response(stdout)\n        assert data[\"result\"] == \"Done\"\n\n    def test_json_with_nested_braces(self, runner):\n        stdout = '{\"result\": \"Done\", \"meta\": {\"key\": \"val\"}}\\nlog line\\n'\n        data = runner._parse_json_response(stdout)\n        assert data[\"result\"] == \"Done\"\n        assert data[\"meta\"] == {\"key\": \"val\"}\n\n    def test_json_with_braces_in_strings(self, runner):\n        stdout = '{\"result\": \"Fixed {thing}\"}\\nwarning\\n'\n        data = runner._parse_json_response(stdout)\n        assert data[\"result\"] == \"Fixed {thing}\"\n\n    def test_incomplete_json_raises(self, runner):\n        stdout = '{\"result\": \"Done\"'\n        with pytest.raises(ValueError, match=\"No JSON\"):\n            runner._parse_json_response(stdout)\n\n    def test_json_with_array_of_objects(self, runner):\n        stdout = '{\"result\": \"Done\", \"items\": [{\"a\": 1}, {\"b\": 2}]}\\n'\n        data = runner._parse_json_response(stdout)\n        assert data[\"items\"] == [{\"a\": 1}, {\"b\": 2}]\n\n    def test_json_with_unicode_escape_quote(self, runner):\n        stdout = '{\"result\": \"value with \\\\u0022quoted\\\\u0022 text\"}\\n'\n        data = runner._parse_json_response(stdout)\n        assert data[\"result\"] == 'value with \"quoted\" text'\n\n    def test_json_with_deeply_nested_structure(self, runner):\n        stdout = '{\"a\": {\"b\": {\"c\": {\"d\": [1, 2, {\"e\": 3}]}}}}\\ntrailing\\n'\n        data = runner._parse_json_response(stdout)\n        assert data[\"a\"][\"b\"][\"c\"][\"d\"] == [1, 2, {\"e\": 3}]\n\n    def test_json_with_braces_in_banner(self, runner):\n        stdout = 'Info: config={debug: true}\\n{\"result\": \"Done\"}\\n'\n        data = runner._parse_json_response(stdout)\n        assert data[\"result\"] == \"Done\"\n\n    def test_json_after_array_line(self, runner):\n        stdout = '[{\"status\": \"ok\"}, {\"status\": \"done\"}]\\n{\"result\": \"Done\"}\\n'\n        data = runner._parse_json_response(stdout)\n        assert data[\"result\"] == \"Done\"\n\n    def test_json_after_nested_object_in_banner(self, runner):\n        stdout = 'Progress: {\"step\": 1, \"total\": 3}\\n{\"result\": \"Done\", \"cost_usd\": 0.01}\\n'\n        data = runner._parse_json_response(stdout)\n        assert data[\"result\"] == \"Done\"\n\n    def test_multiline_json_object(self, runner):\n        stdout = 'Banner\\n{\\n  \"result\": \"Done\",\\n  \"cost_usd\": 0.01\\n}\\nTrailing\\n'\n        data = runner._parse_json_response(stdout)\n        assert data[\"result\"] == \"Done\"\n\n    def test_json_mid_line_with_prefix_text(self, runner):\n        stdout = 'Some info: {\"result\": \"Done\", \"cost_usd\": 0.01}\\n'\n        data = runner._parse_json_response(stdout)\n        assert data[\"result\"] == \"Done\"\n        assert data[\"cost_usd\"] == 0.01\n\n    def test_json_mid_line_with_banner_and_prefix(self, runner):\n        stdout = 'Banner line\\nProgress: {\"result\": \"Done\"}\\nTrailing\\n'\n        data = runner._parse_json_response(stdout)\n        assert data[\"result\"] == \"Done\"\n\n    def test_multiline_json_starting_mid_line(self, runner):\n        stdout = 'Prefix text {\\n  \"result\": \"Done\",\\n  \"cost_usd\": 0.01\\n}\\n'\n        data = runner._parse_json_response(stdout)\n        assert data[\"result\"] == \"Done\"\n        assert data[\"cost_usd\"] == 0.01\n\n    def test_mid_line_json_prefers_valid_object(self, runner):\n        stdout = 'bad {stuff\\n{\"result\": \"Done\"}\\n'\n        data = runner._parse_json_response(stdout)\n        assert data[\"result\"] == \"Done\"\n\n    def test_multiline_json_with_multi_line_preceding_text(self, runner):\n        stdout = 'Banner line 1\\nBanner line 2\\nMore text {\\n  \"result\": \"Done\",\\n  \"cost_usd\": 0.01\\n}\\n'\n        data = runner._parse_json_response(stdout)\n        assert data[\"result\"] == \"Done\"\n        assert data[\"cost_usd\"] == 0.01\n\n    def test_json_with_object_literal_in_string_value(self, runner):\n        \"\"\"JSON with escaped braces and quotes inside string values.\"\"\"\n        stdout = '{\"result\": \"Use {\\\\\"key\\\\\": \\\\\"val\\\\\"} syntax\", \"cost_usd\": 0.01}\\n'\n        data = runner._parse_json_response(stdout)\n        assert data[\"result\"] == 'Use {\"key\": \"val\"} syntax'\n        assert data[\"cost_usd\"] == 0.01\n\n    def test_multiline_json_with_braces_in_strings(self, runner):\n        \"\"\"Multiline JSON where string values contain unmatched braces.\"\"\"\n        stdout = (\n            'Banner\\n'\n            '{\\n'\n            '  \"result\": \"Fixed {broken} stuff\",\\n'\n            '  \"details\": \"Replaced { with }\",\\n'\n            '  \"cost_usd\": 0.02\\n'\n            '}\\n'\n        )\n        data = runner._parse_json_response(stdout)\n        assert data[\"result\"] == \"Fixed {broken} stuff\"\n        assert data[\"details\"] == \"Replaced { with }\"\n        assert data[\"cost_usd\"] == 0.02\n\n\ndef _make_popen_mock(returncode=0, stdout=\"\", stderr=\"\", communicate_effect=None):\n    \"\"\"Create a mock subprocess.Popen that behaves like the real thing.\"\"\"\n    mock_proc = MagicMock()\n    mock_proc.pid = 12345\n    mock_proc.returncode = returncode\n    if communicate_effect is not None:\n        mock_proc.communicate.side_effect = communicate_effect\n    else:\n        mock_proc.communicate.return_value = (stdout, stderr)\n    return mock_proc\n\n\nclass TestRun:\n    @patch(\"claude_runner.subprocess.Popen\")\n    def test_successful_run(self, mock_popen, runner):\n        mock_popen.return_value = _make_popen_mock(\n            returncode=0,\n            stdout='{\"result\": \"Fixed bug\", \"cost_usd\": 0.03, \"duration_seconds\": 12.5}',\n        )\n        result = runner.run(\"Fix the bug\")\n        assert result.success is True\n        assert result.result_text == \"Fixed bug\"\n        assert result.cost_usd == 0.03\n        assert result.duration_seconds == 12.5\n\n    @patch(\"claude_runner.subprocess.Popen\")\n    def test_cwd_always_uses_target_dir(self, mock_popen, runner):\n        \"\"\"cwd should always be config.target_dir.\"\"\"\n        mock_popen.return_value = _make_popen_mock(\n            returncode=0,\n            stdout='{\"result\": \"Done\", \"cost_usd\": 0.01}',\n        )\n        runner.run(\"Fix the bug\")\n        popen_call = mock_popen.call_args\n        assert popen_call.kwargs[\"cwd\"] == runner.config.target_dir\n\n    @patch(\"claude_runner.subprocess.Popen\")\n    def test_add_dirs_appends_flags(self, mock_popen, runner):\n        \"\"\"add_dirs should append --add-dir flags to the command.\"\"\"\n        mock_popen.return_value = _make_popen_mock(\n            returncode=0,\n            stdout='{\"result\": \"Done\", \"cost_usd\": 0.01}',\n        )\n        runner.run(\"Fix the bug\", add_dirs=[\"/tmp/worktree-0\", \"/tmp/worktree-1\"])\n        cmd = mock_popen.call_args[0][0]\n        # Find all --add-dir flags\n        add_dir_indices = [i for i, x in enumerate(cmd) if x == \"--add-dir\"]\n        assert len(add_dir_indices) == 2\n        dirs = [cmd[i + 1] for i in add_dir_indices]\n        assert \"/tmp/worktree-0\" in dirs[0]\n        assert \"/tmp/worktree-1\" in dirs[1]\n\n    @patch(\"claude_runner.subprocess.Popen\")\n    def test_add_dirs_none_no_flags(self, mock_popen, runner):\n        \"\"\"When add_dirs is None, no --add-dir flags should be added.\"\"\"\n        mock_popen.return_value = _make_popen_mock(\n            returncode=0,\n            stdout='{\"result\": \"Done\", \"cost_usd\": 0.01}',\n        )\n        runner.run(\"Fix the bug\")\n        cmd = mock_popen.call_args[0][0]\n        assert \"--add-dir\" not in cmd\n\n    @patch(\"claude_runner.subprocess.Popen\")\n    def test_timeout(self, mock_popen, runner):\n        mock_popen.return_value = _make_popen_mock(\n            communicate_effect=subprocess.TimeoutExpired(cmd=\"claude\", timeout=300),\n        )\n        result = runner.run(\"Fix the bug\")\n        assert result.success is False\n        assert \"timed out\" in result.error\n\n    @patch(\"claude_runner.subprocess.Popen\")\n    def test_command_not_found(self, mock_popen, runner):\n        mock_popen.side_effect = FileNotFoundError()\n        result = runner.run(\"Fix the bug\")\n        assert result.success is False\n        assert \"not found\" in result.error\n\n    @patch(\"claude_runner.subprocess.Popen\")\n    def test_nonzero_exit(self, mock_popen, runner):\n        mock_popen.return_value = _make_popen_mock(\n            returncode=1,\n            stderr=\"Error occurred\",\n        )\n        result = runner.run(\"Fix the bug\")\n        assert result.success is False\n        assert \"exited with code 1\" in result.error\n\n    @patch(\"claude_runner.subprocess.Popen\")\n    def test_unparseable_output(self, mock_popen, runner):\n        mock_popen.return_value = _make_popen_mock(\n            returncode=0,\n            stdout=\"Not JSON at all\",\n        )\n        result = runner.run(\"Fix the bug\")\n        assert result.success is False\n        assert \"parse\" in result.error.lower()\n\n\nclass TestRetryLogic:\n    @patch(\"claude_runner.time.sleep\")\n    @patch(\"claude_runner.subprocess.Popen\")\n    def test_retry_on_timeout(self, mock_popen, mock_sleep, runner):\n        \"\"\"Retries on TimeoutExpired, succeeds on third attempt.\"\"\"\n        mock_popen.side_effect = [\n            _make_popen_mock(communicate_effect=subprocess.TimeoutExpired(cmd=\"claude\", timeout=300)),\n            _make_popen_mock(communicate_effect=subprocess.TimeoutExpired(cmd=\"claude\", timeout=300)),\n            _make_popen_mock(returncode=0, stdout='{\"result\": \"Done\", \"cost_usd\": 0.01}'),\n        ]\n        result = runner.run(\"Fix the bug\")\n        assert result.success is True\n        assert result.result_text == \"Done\"\n        assert mock_popen.call_count == 3\n        assert mock_sleep.call_count == 2\n        mock_sleep.assert_any_call(2)\n        mock_sleep.assert_any_call(8)\n\n    @patch(\"claude_runner.time.sleep\")\n    @patch(\"claude_runner.subprocess.Popen\")\n    def test_retry_on_nonzero_exit(self, mock_popen, mock_sleep, runner):\n        \"\"\"Retries on non-zero exit code, succeeds on third attempt.\"\"\"\n        mock_popen.side_effect = [\n            _make_popen_mock(returncode=1, stderr=\"rate limited\"),\n            _make_popen_mock(returncode=1, stderr=\"rate limited\"),\n            _make_popen_mock(returncode=0, stdout='{\"result\": \"Fixed\", \"cost_usd\": 0.02}'),\n        ]\n        result = runner.run(\"Fix the bug\")\n        assert result.success is True\n        assert result.result_text == \"Fixed\"\n        assert mock_popen.call_count == 3\n\n    @patch(\"claude_runner.time.sleep\")\n    @patch(\"claude_runner.subprocess.Popen\")\n    def test_no_retry_on_file_not_found(self, mock_popen, mock_sleep, runner):\n        \"\"\"FileNotFoundError is not retryable — returns immediately.\"\"\"\n        mock_popen.side_effect = FileNotFoundError()\n        result = runner.run(\"Fix the bug\")\n        assert result.success is False\n        assert \"not found\" in result.error\n        assert mock_popen.call_count == 1\n        mock_sleep.assert_not_called()\n\n    @patch(\"claude_runner.time.sleep\")\n    @patch(\"claude_runner.subprocess.Popen\")\n    def test_no_retry_on_json_parse_failure(self, mock_popen, mock_sleep, runner):\n        \"\"\"JSON parse failure is not retryable — CLI ran fine, output was bad.\"\"\"\n        mock_popen.return_value = _make_popen_mock(\n            returncode=0,\n            stdout=\"Not JSON at all\",\n        )\n        result = runner.run(\"Fix the bug\")\n        assert result.success is False\n        assert \"parse\" in result.error.lower()\n        assert mock_popen.call_count == 1\n        mock_sleep.assert_not_called()\n\n    @patch(\"claude_runner.time.sleep\")\n    @patch(\"claude_runner.subprocess.Popen\")\n    def test_all_retries_exhausted(self, mock_popen, mock_sleep, runner):\n        \"\"\"All retries exhausted returns failure.\"\"\"\n        mock_popen.side_effect = [\n            _make_popen_mock(communicate_effect=subprocess.TimeoutExpired(cmd=\"claude\", timeout=300))\n            for _ in range(4)\n        ]\n        result = runner.run(\"Fix the bug\")\n        assert result.success is False\n        assert \"timed out\" in result.error\n        assert mock_popen.call_count == 4  # 1 initial + 3 retries\n        assert mock_sleep.call_count == 3\n\n    @patch(\"claude_runner.time.sleep\")\n    @patch(\"claude_runner.subprocess.Popen\")\n    def test_retry_delays_are_exponential(self, mock_popen, mock_sleep, runner):\n        \"\"\"Verify exponential backoff delays: 2, 8, 32.\"\"\"\n        mock_popen.side_effect = [\n            _make_popen_mock(communicate_effect=subprocess.TimeoutExpired(cmd=\"claude\", timeout=300))\n            for _ in range(4)\n        ]\n        runner.run(\"Fix the bug\")\n        delays = [call.args[0] for call in mock_sleep.call_args_list]\n        assert delays == [2, 8, 32]\n\n    @patch(\"claude_runner.time.sleep\")\n    @patch(\"claude_runner.subprocess.Popen\")\n    def test_retry_on_os_error(self, mock_popen, mock_sleep, runner):\n        \"\"\"Retries on OSError, succeeds on second attempt.\"\"\"\n        mock_popen.side_effect = [\n            OSError(\"Connection reset\"),\n            _make_popen_mock(returncode=0, stdout='{\"result\": \"Done\", \"cost_usd\": 0.01}'),\n        ]\n        result = runner.run(\"Fix the bug\")\n        assert result.success is True\n        assert mock_popen.call_count == 2\n        mock_sleep.assert_called_once_with(2)\n\n\nclass TestRateLimitBackoff:\n    @patch(\"claude_runner.time.sleep\")\n    @patch(\"claude_runner.subprocess.Popen\")\n    def test_rate_limit_exponential_backoff(self, mock_popen, mock_sleep, runner):\n        \"\"\"Rate limit errors should use exponential backoff (5, 15, 45) not fixed delays.\"\"\"\n        mock_popen.side_effect = [\n            _make_popen_mock(returncode=1, stderr=\"rate limit exceeded\"),\n            _make_popen_mock(returncode=1, stderr=\"rate limit exceeded\"),\n            _make_popen_mock(returncode=1, stderr=\"rate limit exceeded\"),\n            _make_popen_mock(returncode=1, stderr=\"rate limit exceeded\"),\n        ]\n        result = runner.run(\"Fix the bug\")\n        assert result.success is False\n        delays = [call.args[0] for call in mock_sleep.call_args_list]\n        # Exponential: 5 * 3^0 = 5, 5 * 3^1 = 15, 5 * 3^2 = 45\n        assert delays == [5, 15, 45]\n\n    @patch(\"claude_runner.time.sleep\")\n    @patch(\"claude_runner.subprocess.Popen\")\n    def test_non_rate_limit_uses_fixed_delays(self, mock_popen, mock_sleep, runner):\n        \"\"\"Non-rate-limit errors should still use the fixed delays (2, 8, 32).\"\"\"\n        mock_popen.side_effect = [\n            _make_popen_mock(returncode=1, stderr=\"some other error\"),\n            _make_popen_mock(returncode=1, stderr=\"some other error\"),\n            _make_popen_mock(returncode=1, stderr=\"some other error\"),\n            _make_popen_mock(returncode=1, stderr=\"some other error\"),\n        ]\n        result = runner.run(\"Fix the bug\")\n        assert result.success is False\n        delays = [call.args[0] for call in mock_sleep.call_args_list]\n        assert delays == [2, 8, 32]\n\n    @patch(\"claude_runner.time.sleep\")\n    @patch(\"claude_runner.subprocess.Popen\")\n    def test_rate_limit_429_detected(self, mock_popen, mock_sleep, runner):\n        \"\"\"429 in stderr should trigger rate limit backoff.\"\"\"\n        mock_popen.side_effect = [\n            _make_popen_mock(returncode=1, stderr=\"HTTP 429 Too Many Requests\"),\n            _make_popen_mock(returncode=0, stdout='{\"result\": \"Done\", \"cost_usd\": 0.01}'),\n        ]\n        result = runner.run(\"Fix the bug\")\n        assert result.success is True\n        mock_sleep.assert_called_once_with(5)  # 5 * 3^0 = 5\n\n\nclass TestCostParsing:\n    \"\"\"Test that cost_usd and duration_seconds are parsed correctly from CLI output.\"\"\"\n\n    @patch(\"claude_runner.subprocess.Popen\")\n    def test_new_field_names(self, mock_popen, runner):\n        \"\"\"total_cost_usd and duration_ms are the actual CLI field names.\"\"\"\n        mock_popen.return_value = _make_popen_mock(\n            returncode=0,\n            stdout='{\"result\": \"Done\", \"total_cost_usd\": 0.037, \"duration_ms\": 2467}',\n        )\n        result = runner.run(\"Fix\")\n        assert result.success is True\n        assert result.cost_usd == 0.037\n        assert abs(result.duration_seconds - 2.467) < 0.001\n\n    @patch(\"claude_runner.subprocess.Popen\")\n    def test_old_field_names_fallback(self, mock_popen, runner):\n        \"\"\"Falls back to cost_usd and duration_seconds for backward compat.\"\"\"\n        mock_popen.return_value = _make_popen_mock(\n            returncode=0,\n            stdout='{\"result\": \"Done\", \"cost_usd\": 0.05, \"duration_seconds\": 12.5}',\n        )\n        result = runner.run(\"Fix\")\n        assert result.success is True\n        assert result.cost_usd == 0.05\n        assert result.duration_seconds == 12.5\n\n    @patch(\"claude_runner.subprocess.Popen\")\n    def test_new_fields_take_precedence(self, mock_popen, runner):\n        \"\"\"When both old and new fields are present, new ones win.\"\"\"\n        mock_popen.return_value = _make_popen_mock(\n            returncode=0,\n            stdout='{\"result\": \"Done\", \"total_cost_usd\": 0.1, \"cost_usd\": 0.05, \"duration_ms\": 5000, \"duration_seconds\": 2.0}',\n        )\n        result = runner.run(\"Fix\")\n        assert result.success is True\n        assert result.cost_usd == 0.1\n        assert result.duration_seconds == 5.0\n\n    @patch(\"claude_runner.subprocess.Popen\")\n    def test_missing_cost_fields_default_to_zero(self, mock_popen, runner):\n        \"\"\"When no cost/duration fields, defaults to 0.\"\"\"\n        mock_popen.return_value = _make_popen_mock(\n            returncode=0,\n            stdout='{\"result\": \"Done\"}',\n        )\n        result = runner.run(\"Fix\")\n        assert result.success is True\n        assert result.cost_usd == 0.0\n        assert result.duration_seconds == 0.0\n\n    @patch(\"claude_runner.subprocess.Popen\")\n    def test_duration_ms_zero_falls_back_to_seconds(self, mock_popen, runner):\n        \"\"\"duration_ms=0 should fall back to duration_seconds.\"\"\"\n        mock_popen.return_value = _make_popen_mock(\n            returncode=0,\n            stdout='{\"result\": \"Done\", \"duration_ms\": 0, \"duration_seconds\": 3.5}',\n        )\n        result = runner.run(\"Fix\")\n        assert result.success is True\n        assert result.duration_seconds == 3.5\n\n\nclass TestMissingResultField:\n    \"\"\"Test handling of JSON responses missing the 'result' field.\"\"\"\n\n    @patch(\"claude_runner.subprocess.Popen\")\n    def test_missing_result_field_logs_warning(self, mock_popen, runner, caplog):\n        \"\"\"JSON without 'result' key should log a warning.\"\"\"\n        import logging\n        mock_popen.return_value = _make_popen_mock(\n            returncode=0,\n            stdout='{\"cost_usd\": 0.05}',\n        )\n        with caplog.at_level(logging.WARNING):\n            result = runner.run(\"Fix\")\n        assert result.success is True\n        assert result.result_text == \"\"\n        assert any(\"missing 'result' field\" in r.message for r in caplog.records)\n\n    @patch(\"claude_runner.subprocess.Popen\")\n    def test_missing_result_field_returns_success(self, mock_popen, runner):\n        \"\"\"Result should still be success=True with empty result_text when 'result' is missing.\"\"\"\n        mock_popen.return_value = _make_popen_mock(\n            returncode=0,\n            stdout='{\"total_cost_usd\": 0.03, \"duration_ms\": 1000}',\n        )\n        result = runner.run(\"Fix\")\n        assert result.success is True\n        assert result.result_text == \"\"\n        assert result.cost_usd == 0.03\n        assert result.duration_seconds == 1.0\n\n\nclass TestCircuitBreaker:\n    \"\"\"Test circuit breaker state transitions and recovery behavior.\"\"\"\n\n    def test_initial_state_is_closed(self):\n        cb = CircuitBreaker()\n        assert cb.state == CircuitBreaker.STATE_CLOSED\n\n    def test_allow_request_when_closed(self):\n        cb = CircuitBreaker()\n        assert cb.allow_request() is True\n\n    def test_stays_closed_below_threshold(self):\n        cb = CircuitBreaker(failure_threshold=5)\n        for _ in range(4):\n            cb.record_failure()\n        assert cb.state == CircuitBreaker.STATE_CLOSED\n        assert cb.allow_request() is True\n\n    def test_opens_at_failure_threshold(self):\n        cb = CircuitBreaker(failure_threshold=3)\n        for _ in range(3):\n            cb.record_failure()\n        assert cb.state == CircuitBreaker.STATE_OPEN\n        assert cb.allow_request() is False\n\n    def test_blocks_requests_when_open(self):\n        cb = CircuitBreaker(failure_threshold=2)\n        cb.record_failure()\n        cb.record_failure()\n        assert cb.state == CircuitBreaker.STATE_OPEN\n        assert cb.allow_request() is False\n        assert cb.allow_request() is False\n\n    def test_transitions_to_half_open_after_recovery_timeout(self):\n        cb = CircuitBreaker(failure_threshold=2, recovery_timeout=1, jitter_factor=0)\n        cb.record_failure()\n        cb.record_failure()\n        assert cb.state == CircuitBreaker.STATE_OPEN\n        # Wait for recovery timeout\n        time.sleep(1.1)\n        assert cb.state == CircuitBreaker.STATE_HALF_OPEN\n\n    def test_half_open_allows_limited_calls(self):\n        cb = CircuitBreaker(failure_threshold=2, recovery_timeout=0, half_open_max_calls=1)\n        cb.record_failure()\n        cb.record_failure()\n        # Recovery timeout is 0, should immediately transition\n        assert cb.state == CircuitBreaker.STATE_HALF_OPEN\n        # First call allowed\n        assert cb.allow_request() is True\n        # Second call blocked (max=1)\n        assert cb.allow_request() is False\n\n    def test_half_open_success_resets_to_closed(self):\n        cb = CircuitBreaker(failure_threshold=2, recovery_timeout=0)\n        cb.record_failure()\n        cb.record_failure()\n        # Force transition to HALF_OPEN\n        assert cb.state == CircuitBreaker.STATE_HALF_OPEN\n        cb.record_success()\n        assert cb.state == CircuitBreaker.STATE_CLOSED\n        assert cb.allow_request() is True\n\n    def test_half_open_failure_reopens(self):\n        cb = CircuitBreaker(failure_threshold=2, recovery_timeout=0, half_open_max_calls=1)\n        cb.record_failure()\n        cb.record_failure()\n        # Force transition to HALF_OPEN (recovery_timeout=0 means immediate transition)\n        _ = cb.state  # triggers transition\n        assert cb.allow_request() is True  # probe call\n        cb.record_failure()\n        # record_failure sets state to OPEN, but with recovery_timeout=0 the\n        # .state property immediately transitions back to HALF_OPEN.\n        # Verify the internal state was set to OPEN by record_failure:\n        assert cb._state == CircuitBreaker.STATE_OPEN\n        # And that accessing .state triggers the immediate recovery transition:\n        assert cb.state == CircuitBreaker.STATE_HALF_OPEN\n\n    def test_half_open_failure_reopens_with_timeout(self):\n        \"\"\"Verify that a failure during HALF_OPEN re-opens the circuit with a real timeout.\"\"\"\n        cb = CircuitBreaker(failure_threshold=2, recovery_timeout=300, half_open_max_calls=1)\n        cb.record_failure()\n        cb.record_failure()\n        # Manually transition to HALF_OPEN for testing\n        cb._state = CircuitBreaker.STATE_HALF_OPEN\n        cb._half_open_calls = 0\n        assert cb.allow_request() is True  # probe call\n        cb.record_failure()\n        assert cb.state == CircuitBreaker.STATE_OPEN\n\n    def test_success_resets_failure_count(self):\n        cb = CircuitBreaker(failure_threshold=5)\n        for _ in range(4):\n            cb.record_failure()\n        cb.record_success()\n        assert cb.state == CircuitBreaker.STATE_CLOSED\n        # Need 5 more failures to open again\n        for _ in range(4):\n            cb.record_failure()\n        assert cb.state == CircuitBreaker.STATE_CLOSED\n\n    def test_manual_reset(self):\n        cb = CircuitBreaker(failure_threshold=2)\n        cb.record_failure()\n        cb.record_failure()\n        assert cb.state == CircuitBreaker.STATE_OPEN\n        cb.reset()\n        assert cb.state == CircuitBreaker.STATE_CLOSED\n        assert cb.allow_request() is True\n\n    def test_custom_parameters(self):\n        cb = CircuitBreaker(failure_threshold=10, recovery_timeout=600, half_open_max_calls=3)\n        assert cb.failure_threshold == 10\n        assert cb.recovery_timeout == 600\n        assert cb.half_open_max_calls == 3\n\n\nclass TestCircuitBreakerIntegration:\n    \"\"\"Test circuit breaker integration with ClaudeRunner.\"\"\"\n\n    @patch(\"claude_runner.subprocess.Popen\")\n    def test_run_blocked_by_open_circuit_breaker(self, mock_popen, runner):\n        \"\"\"When circuit breaker is open, run() should return failure without calling subprocess.\"\"\"\n        runner.circuit_breaker._state = CircuitBreaker.STATE_OPEN\n        runner.circuit_breaker._opened_at = time.monotonic()  # recent, so won't auto-transition\n        result = runner.run(\"Fix the bug\")\n        assert result.success is False\n        assert \"Circuit breaker\" in result.error\n        mock_popen.assert_not_called()\n\n    def test_is_circuit_breaker_error_patterns(self):\n        \"\"\"Verify all expected error patterns are detected.\"\"\"\n        assert ClaudeRunner._is_circuit_breaker_error(\"rate limit exceeded\") is True\n        assert ClaudeRunner._is_circuit_breaker_error(\"HTTP 429 Too Many Requests\") is True\n        assert ClaudeRunner._is_circuit_breaker_error(\"Error 500 Internal\") is True\n        assert ClaudeRunner._is_circuit_breaker_error(\"502 Bad Gateway\") is True\n        assert ClaudeRunner._is_circuit_breaker_error(\"503 Service Unavailable\") is True\n        assert ClaudeRunner._is_circuit_breaker_error(\"504 Gateway Timeout\") is True\n        assert ClaudeRunner._is_circuit_breaker_error(\"server is overloaded\") is True\n        assert ClaudeRunner._is_circuit_breaker_error(\"normal error\") is False\n        assert ClaudeRunner._is_circuit_breaker_error(\"success\") is False\n","numLines":664,"startLine":1,"totalLines":664}}}
