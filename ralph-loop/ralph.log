{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_vrtx_017bGDrjkgUMK28KepJzZdpG","type":"tool_result","content":"     1→\"\"\"Auto-discover tasks from the target project (test failures, lint, TODOs, etc.).\"\"\"\n     2→\n     3→from __future__ import annotations\n     4→\n     5→import json\n     6→import logging\n     7→import os\n     8→import re\n     9→import time\n    10→from dataclasses import dataclass, field\n    11→from pathlib import Path\n    12→from typing import List, Optional\n    13→\n    14→from config_schema import Config\n    15→from process_utils import run_with_group_kill\n    16→\n    17→logger = logging.getLogger(__name__)\n    18→\n    19→# Map file extensions to their comment prefix styles\n    20→_COMMENT_PREFIXES = {\n    21→    \".py\": (\"#\",), \".rb\": (\"#\",),\n    22→    \".js\": (\"//\", \"/*\"), \".ts\": (\"//\", \"/*\"),\n    23→    \".jsx\": (\"//\", \"/*\"), \".tsx\": (\"//\", \"/*\"),\n    24→    \".go\": (\"//\", \"/*\"), \".rs\": (\"//\", \"/*\"),\n    25→    \".java\": (\"//\", \"/*\"),\n    26→}\n    27→\n    28→# Regex to match string literals (double-quoted and single-quoted, with escapes)\n    29→_STRING_LITERAL_RE = re.compile(r'''\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^'\\\\]|\\\\.)*' '''.strip())\n    30→\n    31→MAX_TASK_DESCRIPTION_LENGTH = 2000\n    32→MAX_TASK_CONTEXT_LENGTH = 12000\n    33→\n    34→# Default timeout for _discover_todos file walk (seconds)\n    35→TODO_SCAN_TIMEOUT = 60\n    36→\n    37→_FILE_REF_RE = re.compile(\n    38→    r'`([a-zA-Z0-9_/.\\-]+\\.(?:py|js|ts|tsx|jsx|go|rs|java|rb|sh|yaml|yml|json|md|txt))'\n    39→    r'(?::(\\d+))?(?:-\\d+)?`'\n    40→)\n    41→_FILE_REF_FALLBACK_RE = re.compile(\n    42→    r'(?:in\\s+|for\\s+)([a-zA-Z0-9_/.\\-]+\\.(?:py|js|ts|tsx|jsx|go|rs|java|rb|sh|yaml|yml|json|md|txt))'\n    43→    r'(?::(\\d+))?'\n    44→)\n    45→\n    46→\n    47→def _sanitize_description(desc: str) -> str:\n    48→    \"\"\"Sanitize a task description: strip, collapse newlines, and truncate.\"\"\"\n    49→    desc = desc.strip()\n    50→    desc = desc.replace(\"\\n\", \" \").replace(\"\\r\", \" \")\n    51→    if len(desc) > MAX_TASK_DESCRIPTION_LENGTH:\n    52→        desc = desc[:MAX_TASK_DESCRIPTION_LENGTH] + \"...\"\n    53→    return desc\n    54→\n    55→\n    56→def _extract_comment_text(line: str, ext: str) -> Optional[str]:\n    57→    \"\"\"Strip string literals from *line*, then return the comment body if a\n    58→    comment prefix for *ext* is found.  Returns ``None`` when no comment is\n    59→    detected.\"\"\"\n    60→    prefixes = _COMMENT_PREFIXES.get(ext)\n    61→    if not prefixes:\n    62→        return None\n    63→\n    64→    # Remove string literals so that a '#' or '//' inside a string is ignored\n    65→    stripped = _STRING_LITERAL_RE.sub(\"\", line)\n    66→\n    67→    # Find the earliest comment prefix in the stripped line\n    68→    earliest_pos = None\n    69→    earliest_prefix = None\n    70→    for pfx in prefixes:\n    71→        pos = stripped.find(pfx)\n    72→        if pos != -1 and (earliest_pos is None or pos < earliest_pos):\n    73→            earliest_pos = pos\n    74→            earliest_prefix = pfx\n    75→\n    76→    if earliest_pos is None:\n    77→        return None\n    78→\n    79→    # Return the text after the comment prefix\n    80→    return stripped[earliest_pos + len(earliest_prefix):]\n    81→\n    82→\n    83→@dataclass\n    84→class Task:\n    85→    description: str\n    86→    priority: int  # 1 = highest (feedback), 5 = lowest (quality review)\n    87→    source: str  # \"test_failure\", \"lint\", \"todo\", \"coverage\", \"quality\", \"feedback\"\n    88→    source_file: Optional[str] = None  # file path for feedback tasks\n    89→    line_number: Optional[int] = None\n    90→    context: str = \"\"  # rich context: tracebacks, file snippets, error details\n    91→    task_id: str = \"\"\n    92→    depends_on: List[str] = field(default_factory=list)\n    93→\n    94→    def __post_init__(self):\n    95→        self.description = _sanitize_description(self.description)\n    96→        if len(self.context) > MAX_TASK_CONTEXT_LENGTH:\n    97→            self.context = self.context[:MAX_TASK_CONTEXT_LENGTH] + \"\\n... (truncated)\"\n    98→        if not self.task_id:\n    99→            self.task_id = self.task_key\n   100→\n   101→    @property\n   102→    def task_key(self) -> str:\n   103→        \"\"\"Stable dedup key — same underlying issue produces the same key.\"\"\"\n   104→        if self.source == \"todo\" and self.source_file:\n   105→            if self.line_number is not None:\n   106→                return f\"todo:{self.source_file}:{self.line_number}\"\n   107→            return f\"todo:{self.source_file}\"\n   108→\n   109→        if self.source in (\"lint\", \"test_failure\", \"quality\", \"coverage\") and self.source_file:\n   110→            return f\"{self.source}:{self.source_file}\"\n   111→\n   112→        if self.source == \"coverage\":\n   113→            match = re.search(r'for\\s+(\\S+)', self.description)\n   114→            if match:\n   115→                return f\"coverage:{match.group(1)}\"\n   116→\n   117→        if self.source == \"claude_idea\":\n   118→            match = _FILE_REF_RE.search(self.description)\n   119→            if match:\n   120→                return f\"claude_idea:{match.group(1)}\"\n   121→            match = _FILE_REF_FALLBACK_RE.search(self.description)\n   122→            if match:\n   123→                return f\"claude_idea:{match.group(1)}\"\n   124→            return f\"claude_idea:{self.description[:60]}\"\n   125→\n   126→        if self.source == \"feedback\" and self.source_file:\n   127→            return f\"feedback:{self.source_file}\"\n   128→\n   129→        if self.source == \"test_failure\":\n   130→            match = re.search(r'FAILED\\s+(\\S+)', self.description)\n   131→            if match:\n   132→                return f\"test_failure:{match.group(1)}\"\n   133→\n   134→        return f\"{self.source}:{self.description}\"\n   135→\n   136→\n   137→class TaskDiscovery:\n   138→    def __init__(self, config: Config, state_manager=None):\n   139→        self.config = config\n   140→        self.target_dir = config.target_dir\n   141→        self.state_manager = state_manager\n   142→        self._last_idea_discovery_time: float = 0.0\n   143→\n   144→    def discover_all(self) -> List[Task]:\n   145→        \"\"\"Run all enabled discovery strategies and return sorted tasks.\"\"\"\n   146→        tasks: List[Task] = []\n   147→        dc = self.config.discovery\n   148→\n   149→        if dc.enable_test_failures:\n   150→            tasks.extend(self._discover_test_failures())\n   151→\n   152→        if dc.enable_lint_errors:\n   153→            tasks.extend(self._discover_lint_errors())\n   154→\n   155→        if dc.enable_todos:\n   156→            tasks.extend(self._discover_todos())\n   157→\n   158→        if dc.enable_coverage:\n   159→            tasks.extend(self._discover_coverage_gaps())\n   160→\n   161→        if dc.enable_claude_ideas:\n   162→            tasks.extend(self._discover_claude_ideas())\n   163→\n   164→        if dc.enable_quality_review:\n   165→            tasks.extend(self._discover_quality_issues())\n   166→\n   167→        # Group related tasks to avoid duplicate work\n   168→        tasks = self._group_related_tasks(tasks)\n   169→\n   170→        # Boost priority for historically high-success-rate sources\n   171→        if self.state_manager and dc.adaptive_priority and tasks:\n   172→            try:\n   173→                performance = self.state_manager.get_strategy_performance(lookback_seconds=86400)\n   174→                if performance:\n   175→                    for task in tasks:\n   176→                        perf = performance.get(task.source)\n   177→                        if perf and perf.get(\"total\", 0) >= 2:\n   178→                            success_rate = perf.get(\"success_rate\", 0.0)\n   179→                            if success_rate > 0.5:\n   180→                                # Higher success rate -> lower priority number (higher priority)\n   181→                                # e.g., 90% success -> priority reduced by 2\n   182→                                boost = int(success_rate * 3)  # 0-3 boost\n   183→                                task.priority = max(1, task.priority - boost)\n   184→            except Exception as e:\n   185→                logger.debug(\"Strategy performance boosting failed: %s\", e)\n   186→\n   187→        # Sort by priority (lower number = higher priority)\n   188→        tasks.sort(key=lambda t: t.priority)\n   189→        return tasks\n   190→\n   191→    def _group_related_tasks(self, tasks: List[Task]) -> List[Task]:\n   192→        \"\"\"Group related tasks by file path to avoid duplicate work.\n   193→\n   194→        When multiple tasks share the same source file (e.g., multiple test\n   195→        failures in the same file, or multiple lint errors in the same file),\n   196→        they likely share a root cause. This method keeps only the first\n   197→        (highest-priority) task per file for each source type, reducing\n   198→        wasted cycles on tasks that will auto-resolve when the root cause\n   199→        is fixed.\n   200→\n   201→        Tasks without a source_file are always kept.\n   202→        \"\"\"\n   203→        from collections import defaultdict\n   204→\n   205→        # Group by (source, source_file) — only group when source_file is set\n   206→        grouped: dict = defaultdict(list)\n   207→        ungrouped: List[Task] = []\n   208→\n   209→        for task in tasks:\n   210→            if task.source_file and task.source in (\"test_failure\", \"lint\", \"todo\"):\n   211→                key = (task.source, task.source_file)\n   212→                grouped[key].append(task)\n   213→            else:\n   214→                ungrouped.append(task)\n   215→\n   216→        result: List[Task] = list(ungrouped)\n   217→        for key, group in grouped.items():\n   218→            # Sort by priority (lower = better), keep the representative task\n   219→            group.sort(key=lambda t: t.priority)\n   220→            representative = group[0]\n   221→            if len(group) > 1:\n   222→                # Enrich the representative's description with count\n   223→                representative.description = (\n   224→                    f\"{representative.description} \"\n   225→                    f\"(+{len(group) - 1} related in {key[1]})\"\n   226→                )\n   227→            result.append(representative)\n   228→\n   229→        return result\n   230→\n   231→    # Regex to extract file path and line number from pytest traceback lines\n   232→    # Matches patterns like \"tests/test_foo.py:5: AssertionError\"\n   233→    _TRACEBACK_LOC_RE = re.compile(\n   234→        r'^(\\S+\\.py):(\\d+):\\s+\\w+(?:Error|Exception|Warning)'\n   235→    )\n   236→\n   237→    def _extract_test_traceback(self, full_output: str, test_id: str) -> str:\n   238→        \"\"\"Extract the traceback section for a specific test from pytest output.\n   239→\n   240→        Includes assertion details (lines starting with 'E') and ensures the\n   241→        last 5 lines of the traceback are always present.\n   242→        \"\"\"\n   243→        if not test_id:\n   244→            return \"\"\n   245→        lines = full_output.split(\"\\n\")\n   246→        collecting = False\n   247→        result_lines: List[str] = []\n   248→        assertion_lines: List[str] = []\n   249→        for line in lines:\n   250→            if test_id in line and (\"FAILED\" in line or \"ERROR\" in line or \"___\" in line):\n   251→                collecting = True\n   252→                result_lines = [line]\n   253→                assertion_lines = []\n   254→                continue\n   255→            if collecting:\n   256→                if (line.startswith(\"___\") and test_id not in line) or \\\n   257→                   line.startswith(\"=\") or \\\n   258→                   (line.startswith(\"FAILED \") and test_id not in line):\n   259→                    break\n   260→                result_lines.append(line)\n   261→                # Collect assertion detail lines (pytest prefixes them with 'E')\n   262→                stripped = line.lstrip()\n   263→                if stripped.startswith(\"E \") or stripped.startswith(\"E\\t\"):\n   264→                    assertion_lines.append(line)\n   265→\n   266→        if not result_lines:\n   267→            return \"\"\n   268→\n   269→        # Ensure the last 5 lines of the traceback are included\n   270→        # (they typically contain the assertion and location info)\n   271→        traceback_text = \"\\n\".join(result_lines)\n   272→        if len(result_lines) > 5:\n   273→            last_5 = \"\\n\".join(result_lines[-5:])\n   274→            # If assertion lines exist but aren't in last 5 lines, append them\n   275→            if assertion_lines:\n   276→                for aline in assertion_lines:\n   277→                    if aline not in result_lines[-5:]:\n   278→                        traceback_text += \"\\n\" + aline\n   279→\n   280→        return traceback_text\n   281→\n   282→    def _extract_traceback_location(self, traceback_text: str) -> tuple:\n   283→        \"\"\"Extract file path and line number from a pytest traceback.\n   284→\n   285→        Returns (source_file, line_number) or (None, None) if not found.\n   286→        \"\"\"\n   287→        if not traceback_text:\n   288→            return None, None\n   289→        # Search for the last file:line pattern in the traceback\n   290→        # (the last one is typically the failing assertion location)\n   291→        last_match = None\n   292→        for line in traceback_text.split(\"\\n\"):\n   293→            line = line.strip()\n   294→            m = self._TRACEBACK_LOC_RE.match(line)\n   295→            if m:\n   296→                last_match = m\n   297→        if last_match:\n   298→            return last_match.group(1), int(last_match.group(2))\n   299→        return None, None\n   300→\n   301→    def _read_file_snippet(self, filepath: str, line_num: int, context_lines: int = 5) -> str:\n   302→        \"\"\"Read a snippet of a file around the given line number.\"\"\"\n   303→        try:\n   304→            fpath = Path(filepath)\n   305→            if not fpath.is_absolute():\n   306→                fpath = Path(self.target_dir) / filepath\n   307→            if not fpath.exists():\n   308→                return \"\"\n   309→            content = fpath.read_text(errors=\"ignore\")\n   310→            lines = content.split(\"\\n\")\n   311→            start = max(0, line_num - context_lines - 1)\n   312→            end = min(len(lines), line_num + context_lines)\n   313→            numbered = []\n   314→            for i, line in enumerate(lines[start:end], start + 1):\n   315→                marker = \" >> \" if i == line_num else \"    \"\n   316→                numbered.append(f\"{marker}{i:4d} | {line}\")\n   317→            return \"\\n\".join(numbered)\n   318→        except OSError:\n   319→            return \"\"\n   320→\n   321→    def _enrich_task_context(self, task: 'Task') -> None:\n   322→        \"\"\"Populate a task's context with code snippets from file references in its description.\"\"\"\n   323→        # Try primary regex, then fallback\n   324→        match = _FILE_REF_RE.search(task.description)\n   325→        if not match:\n   326→            match = _FILE_REF_FALLBACK_RE.search(task.description)\n   327→        if not match:\n   328→            return\n   329→\n   330→        filepath = match.group(1)\n   331→        line_num = int(match.group(2)) if match.group(2) else 1\n   332→        snippet = self._read_file_snippet(filepath, line_num, context_lines=5)\n   333→        if snippet:\n   334→            task.context = f\"File: {filepath}\\n{snippet}\"\n   335→            task.source_file = filepath\n   336→            if match.group(2):\n   337→                task.line_number = line_num\n   338→\n   339→    def _discover_test_failures(self) -> List[Task]:\n   340→        \"\"\"Run pytest and parse failures.\"\"\"\n   341→        test_cmd = self.config.validation.test_command\n   342→        if not test_cmd.strip():\n   343→            return []\n   344→\n   345→        try:\n   346→            result = run_with_group_kill(\n   347→                test_cmd,\n   348→                shell=True,\n   349→                cwd=self.target_dir,\n   350→                timeout=self.config.validation.test_timeout,\n   351→            )\n   352→        except OSError as e:\n   353→            logger.warning(\"Test discovery failed: %s\", e)\n   354→            return []\n   355→\n   356→        if result.timed_out:\n   357→            logger.warning(\"Test discovery timed out after %ds\", self.config.validation.test_timeout)\n   358→            return []\n   359→\n   360→        if result.returncode == 0:\n   361→            return []\n   362→\n   363→        # Capture full output for context\n   364→        full_output = result.stdout\n   365→        if result.stderr.strip():\n   366→            full_output += \"\\n\" + result.stderr\n   367→\n   368→        # Parse pytest output for FAILED lines\n   369→        tasks = []\n   370→        for line in result.stdout.split(\"\\n\"):\n   371→            line = line.strip()\n   372→            if line.startswith(\"FAILED\"):\n   373→                # e.g. \"FAILED tests/test_foo.py::test_bar - AssertionError: ...\"\n   374→                desc = f\"Fix test failure: {line}\"\n   375→                # Extract test identifier for per-test traceback\n   376→                parts = line.split()\n   377→                test_id = parts[1] if len(parts) > 1 else \"\"\n   378→                per_test_ctx = self._extract_test_traceback(full_output, test_id)\n   379→                # Extract file path and line number from the traceback\n   380→                src_file, src_line = self._extract_traceback_location(per_test_ctx)\n   381→                tasks.append(Task(\n   382→                    description=desc,\n   383→                    priority=2,\n   384→                    source=\"test_failure\",\n   385→                    source_file=src_file,\n   386→                    line_number=src_line,\n   387→                    context=per_test_ctx if per_test_ctx else full_output,\n   388→                ))\n   389→\n   390→        # If we got failures but couldn't parse individual ones, create a generic task\n   391→        if result.returncode != 0 and not tasks:\n   392→            tasks.append(Task(\n   393→                description=f\"Fix test failures (exit code {result.returncode})\",\n   394→                priority=2,\n   395→                source=\"test_failure\",\n   396→                context=full_output,\n   397→            ))\n   398→\n   399→        return tasks\n   400→\n   401→    def _discover_lint_errors(self) -> List[Task]:\n   402→        \"\"\"Run lint command and parse errors.\"\"\"\n   403→        lint_cmd = self.config.validation.lint_command\n   404→        if not lint_cmd.strip():\n   405→            return []\n   406→\n   407→        try:\n   408→            result = run_with_group_kill(\n   409→                lint_cmd,\n   410→                shell=True,\n   411→                cwd=self.target_dir,\n   412→                timeout=self.config.validation.lint_timeout,\n   413→            )\n   414→        except OSError as e:\n   415→            logger.warning(\"Lint discovery failed: %s\", e)\n   416→            return []\n   417→\n   418→        if result.timed_out:\n   419→            logger.warning(\"Lint discovery timed out after %ds\", self.config.validation.lint_timeout)\n   420→            return []\n   421→\n   422→        if result.returncode == 0:\n   423→            return []\n   424→\n   425→        # Try to parse ruff JSON output\n   426→        output = result.stdout.strip()\n   427→        try:\n   428→            errors = json.loads(output)\n   429→            if isinstance(errors, list):\n   430→                tasks = []\n   431→                for err in errors[:10]:  # Cap at 10 lint errors\n   432→                    filename = err.get(\"filename\", \"unknown\")\n   433→                    message = err.get(\"message\", \"lint error\")\n   434→                    code = err.get(\"code\", \"\")\n   435→                    line_num = err.get(\"location\", {}).get(\"row\", 0)\n   436→                    desc = f\"Fix lint error in {filename}: [{code}] {message}\"\n   437→                    # Build context: snippet around the error line\n   438→                    context = \"\"\n   439→                    if line_num > 0:\n   440→                        context = self._read_file_snippet(filename, line_num, context_lines=5)\n   441→                    tasks.append(Task(\n   442→                        description=desc,\n   443→                        priority=2,\n   444→                        source=\"lint\",\n   445→                        source_file=filename,\n   446→                        line_number=line_num if line_num > 0 else None,\n   447→                        context=context,\n   448→                    ))\n   449→                return tasks\n   450→        except (json.JSONDecodeError, TypeError):\n   451→            pass\n   452→\n   453→        # Fallback: generic lint error task\n   454→        return [Task(\n   455→            description=\"Fix lint errors\",\n   456→            priority=2,\n   457→            source=\"lint\",\n   458→        )]\n   459→\n   460→    def _discover_todos(self, timeout: int = TODO_SCAN_TIMEOUT) -> List[Task]:\n   461→        \"\"\"Scan source files for TODO/FIXME/HACK comments.\n   462→\n   463→        Args:\n   464→            timeout: Maximum time in seconds for the file walk operation.\n   465→                     If exceeded, returns whatever tasks were found so far.\n   466→        \"\"\"\n   467→        tasks = []\n   468→        patterns = self.config.discovery.todo_patterns\n   469→        exclude_dirs = set(self.config.discovery.exclude_dirs)\n   470→\n   471→        if not patterns:\n   472→            return []\n   473→\n   474→        escaped = \"|\".join(re.escape(p) for p in patterns)\n   475→        keyword_pat = r\"^\\s*(\" + escaped + r\")\\b\"\n   476→        keyword_re = re.compile(keyword_pat, re.IGNORECASE)\n   477→\n   478→        target = Path(self.target_dir)\n   479→        deadline = time.monotonic() + timeout\n   480→        timed_out = False\n   481→        files_scanned = 0\n   482→        for root, dirs, files in os.walk(target):\n   483→            # Check deadline at the start of each directory\n   484→            if time.monotonic() > deadline:\n   485→                timed_out = True\n   486→                break\n   487→\n   488→            # Filter out excluded directories\n   489→            dirs[:] = [d for d in dirs if d not in exclude_dirs]\n   490→\n   491→            for fname in files:\n   492→                # Check deadline periodically (every file)\n   493→                if time.monotonic() > deadline:\n   494→                    timed_out = True\n   495→                    break\n   496→\n   497→                ext = Path(fname).suffix\n   498→                if ext not in _COMMENT_PREFIXES:\n   499→                    continue\n   500→\n   501→                fpath = Path(root) / fname\n   502→                rel_path = str(fpath.relative_to(target))\n   503→\n   504→                try:\n   505→                    content = fpath.read_text(errors=\"ignore\")\n   506→                except OSError:\n   507→                    continue\n   508→\n   509→                files_scanned += 1\n   510→\n   511→                for i, line in enumerate(content.split(\"\\n\"), 1):\n   512→                    comment_text = _extract_comment_text(line, ext)\n   513→                    if comment_text is None:\n   514→                        continue\n   515→                    match = keyword_re.search(comment_text)\n   516→                    if match:\n   517→                        comment = line.strip()\n   518→                        if len(comment) > 120:\n   519→                            comment = comment[:120] + \"...\"\n   520→                        desc = f\"Address {match.group(1)} in {rel_path}:{i}: {comment}\"\n   521→                        context = self._read_file_snippet(str(fpath), i, context_lines=5)\n   522→                        tasks.append(Task(\n   523→                            description=desc,\n   524→                            priority=3,\n   525→                            source=\"todo\",\n   526→                            source_file=rel_path,\n   527→                            line_number=i,\n   528→                            context=context,\n   529→                        ))\n   530→\n   531→            if timed_out:\n   532→                break\n   533→\n   534→        if timed_out:\n   535→            logger.warning(\n   536→                \"TODO scan timed out after %ds (scanned %d files, found %d tasks)\",\n   537→                timeout, files_scanned, len(tasks),\n   538→            )\n   539→\n   540→        return tasks[:self.config.discovery.max_todo_tasks]\n   541→\n   542→    def _discover_claude_ideas(self) -> List[Task]:\n   543→        \"\"\"Use Claude to analyze the codebase and suggest improvement ideas.\n   544→\n   545→        Invokes Claude CLI in read-only analysis mode with a low max-turns\n   546→        to keep cost down. Parses the response for actionable improvement tasks.\n   547→        \"\"\"\n   548→        # Enforce idea generation cooldown to prevent excessive API costs\n   549→        cooldown = self.config.discovery.idea_cooldown_seconds\n   550→        if cooldown > 0:\n   551→            elapsed = time.time() - self._last_idea_discovery_time\n   552→            if self._last_idea_discovery_time > 0 and elapsed < cooldown:\n   553→                logger.debug(\n   554→                    \"Skipping claude_ideas discovery: %.0fs since last run, \"\n   555→                    \"cooldown is %ds\",\n   556→                    elapsed, cooldown,\n   557→                )\n   558→                return []\n   559→\n   560→        cc = self.config.claude\n   561→        if self.config.discovery.discovery_prompt:\n   562→            focus_section = self.config.discovery.discovery_prompt\n   563→        else:\n   564→            focus_section = (\n   565→                \"- New features or functionality that would add value\\n\"\n   566→                \"- Missing tests for important functionality\\n\"\n   567→                \"- Bug risks or edge cases that could cause failures\\n\"\n   568→                \"- Performance improvements\\n\"\n   569→                \"- Code clarity or maintainability improvements\\n\"\n   570→            )\n   571→\n   572→        history_section = \"\"\n   573→        if self.state_manager:\n   574→            recent = self.state_manager.get_recent_task_summaries(\n   575→                lookback_seconds=86400, max_items=15,\n   576→            )\n   577→            if recent:\n   578→                history_section = (\n   579→                    \"\\nRECENTLY COMPLETED TASKS (do NOT suggest similar improvements):\\n\"\n   580→                    + \"\\n\".join(recent)\n   581→                    + \"\\n\\nFocus on NEW areas that haven't been addressed recently.\\n\"\n   582→                )\n   583→\n   584→        prompt = (\n   585→            \"Analyze the codebase in the current directory. Identify up to 5 concrete, \"\n   586→            \"actionable improvements. Focus on:\\n\"\n   587→            + focus_section\n   588→            + history_section\n   589→            + \"\\nFor each improvement, output EXACTLY one line in this format:\\n\"\n   590→            \"IDEA: <one-sentence description of the improvement>\\n\\n\"\n   591→            \"Do NOT make any changes. Do NOT run git commands. Only analyze and output IDEA lines.\"\n   592→        )\n   593→\n   594→        cmd = [\n   595→            cc.command, \"-p\", prompt,\n   596→            \"--model\", self.config.discovery.discovery_model or self.config.claude.resolved_model,\n   597→            \"--max-turns\", str(self.config.discovery.discovery_max_turns),\n   598→            \"--output-format\", \"json\",\n   599→        ]\n   600→\n   601→        try:\n   602→            result = run_with_group_kill(\n   603→                cmd,\n   604→                cwd=self.target_dir,\n   605→                timeout=self.config.discovery.discovery_timeout,\n   606→            )\n   607→        except (FileNotFoundError, OSError) as e:\n   608→            logger.warning(\"Claude idea discovery failed: %s\", e)\n   609→            return []\n   610→\n   611→        if result is None:\n   612→            logger.warning(\"Claude idea discovery returned no result\")\n   613→            return []\n   614→\n   615→        if result.timed_out:\n   616→            logger.warning(\"Claude idea discovery timed out after %ds\",\n   617→                           self.config.discovery.discovery_timeout)\n   618→            return []\n   619→\n   620→        if result.returncode != 0:\n   621→            logger.warning(\"Claude idea discovery exited with code %d\", result.returncode)\n   622→            return []\n   623→\n   624→        # Parse JSON response to get result text\n   625→        result_text = result.stdout\n   626→        try:\n   627→            # Helper: extract text content from a parsed JSON dict.\n   628→            # The Claude CLI uses \"result\" for successful runs and may use\n   629→            # \"result_text\" in some versions.\n   630→            def _extract_text(d: dict) -> str:\n   631→                for key in (\"result\", \"result_text\"):\n   632→                    val = d.get(key)\n   633→                    if isinstance(val, str) and val.strip():\n   634→                        return val\n   635→                return \"\"\n   636→\n   637→            # Strategy 1: Try each line individually as a complete JSON object\n   638→            for line in result_text.strip().split(\"\\n\"):\n   639→                line = line.strip()\n   640→                if not line.startswith(\"{\"):\n   641→                    continue\n   642→                try:\n   643→                    data = json.loads(line)\n   644→                    if isinstance(data, dict):\n   645→                        # Check for error_max_turns — Claude ran out of turns\n   646→                        if data.get(\"subtype\") == \"error_max_turns\":\n   647→                            logger.warning(\n   648→                                \"Claude idea discovery hit max turns (%d); \"\n   649→                                \"increase discovery.discovery_max_turns\",\n   650→                                self.config.discovery.discovery_max_turns,\n   651→                            )\n   652→                            text = _extract_text(data)\n   653→                            if text:\n   654→                                result_text = text\n   655→                            break\n   656→                        text = _extract_text(data)\n   657→                        if text:\n   658→                            result_text = text\n   659→                            break\n   660→                except (json.JSONDecodeError, TypeError):\n   661→                    continue\n   662→            else:\n   663→                # Strategy 2: Try multi-line JSON joining from each '{'-starting line\n   664→                lines = result_text.strip().split(\"\\n\")\n   665→                for i, line in enumerate(lines):\n   666→                    if not line.strip().startswith(\"{\"):\n   667→                        continue\n   668→                    try:\n   669→                        data = json.loads(\"\\n\".join(lines[i:]))\n   670→                        if isinstance(data, dict):\n   671→                            if data.get(\"subtype\") == \"error_max_turns\":\n   672→                                logger.warning(\n   673→                                    \"Claude idea discovery hit max turns (%d); \"\n   674→                                    \"increase discovery.discovery_max_turns\",\n   675→                                    self.config.discovery.discovery_max_turns,\n   676→                                )\n   677→                                text = _extract_text(data)\n   678→                                if text:\n   679→                                    result_text = text\n   680→                                break\n   681→                            text = _extract_text(data)\n   682→                            if text:\n   683→                                result_text = text\n   684→                                break\n   685→                    except (json.JSONDecodeError, TypeError):\n   686→                        continue\n   687→                else:\n   688→                    # Strategy 3: Use raw_decode to find JSON anywhere in the output\n   689→                    decoder = json.JSONDecoder()\n   690→                    for i, ch in enumerate(result_text):\n   691→                        if ch != \"{\":\n   692→                            continue\n   693→                        try:\n   694→                            obj, end = decoder.raw_decode(result_text, i)\n   695→                            if isinstance(obj, dict):\n   696→                                text = _extract_text(obj)\n   697→                                if text:\n   698→                                    result_text = text\n   699→                                    break\n   700→                        except (json.JSONDecodeError, TypeError):\n   701→                            continue\n   702→        except Exception:\n   703→            pass\n   704→\n   705→        # Warn if we couldn't extract text from a JSON response\n   706→        if result_text is result.stdout and result.stdout.strip()[:1] in (\"{\", \"[\"):\n   707→            logger.warning(\n   708→                \"Claude idea response contained JSON but no text content \"\n   709→                \"could be extracted — falling back to raw text extraction\"\n   710→            )\n   711→\n   712→        # Extract IDEA lines\n   713→        MIN_IDEA_LENGTH = 10\n   714→        tasks = []\n   715→        for line in result_text.split(\"\\n\"):\n   716→            line = line.strip()\n   717→            if line.upper().startswith(\"IDEA:\"):\n   718→                desc = line[5:].strip()\n   719→                if desc and len(desc) >= MIN_IDEA_LENGTH:\n   720→                    tasks.append(Task(\n   721→                        description=desc,\n   722→                        priority=4,\n   723→                        source=\"claude_idea\",\n   724→                    ))\n   725→                elif desc:\n   726→                    logger.debug(\"Skipping short IDEA line: %r\", desc)\n   727→\n   728→        # Enrich tasks with file context from their descriptions\n   729→        for task in tasks:\n   730→            self._enrich_task_context(task)\n   731→\n   732→        logger.info(\"Claude discovered %d improvement ideas\", len(tasks))\n   733→        if not tasks and result_text.strip():\n   734→            # Attempt fallback extraction from analysis-format text\n   735→            lines = [l.strip() for l in result_text.split(\"\\n\") if l.strip()]\n   736→            for line in lines:\n   737→                # Match numbered items: \"1. ...\", \"2) ...\"\n   738→                m = re.match(r'^\\d+[.)]\\s+(.+)', line)\n   739→                if not m:\n   740→                    # Match bullet items: \"- ...\", \"* ...\", \"• ...\"\n   741→                    m = re.match(r'^[-*•]\\s+(.+)', line)\n   742→                if m:\n   743→                    desc = m.group(1).strip()\n   744→                    if desc and len(desc) >= MIN_IDEA_LENGTH:\n   745→                        tasks.append(Task(\n   746→                            description=desc,\n   747→                            priority=4,\n   748→                            source=\"claude_idea\",\n   749→                        ))\n   750→            # Enrich fallback tasks with file context\n   751→            for task in tasks:\n   752→                self._enrich_task_context(task)\n   753→            if tasks:\n   754→                logger.info(\n   755→                    \"Extracted %d tasks from analysis-format text \"\n   756→                    \"(no IDEA: prefixed lines found, used numbered/bullet fallback).\",\n   757→                    len(tasks),\n   758→                )\n   759→            else:\n   760→                logger.debug(\n   761→                    \"Claude response contained no IDEA lines and no extractable \"\n   762→                    \"analysis-format items (%d non-empty lines)\",\n   763→                    len(lines),\n   764→                )\n   765→        self._last_idea_discovery_time = time.time()\n   766→        return tasks[:5]\n   767→\n   768→    def _discover_coverage_gaps(self) -> List[Task]:\n   769→        \"\"\"Discover files with low test coverage (optional, requires pytest-cov).\"\"\"\n   770→        try:\n   771→            result = run_with_group_kill(\n   772→                \"python3 -m pytest --cov --cov-report=json --cov-report=term -q\",\n   773→                shell=True,\n   774→                cwd=self.target_dir,\n   775→                timeout=self.config.validation.test_timeout,\n   776→            )\n   777→        except OSError:\n   778→            return []\n   779→\n   780→        if result.timed_out:\n   781→            return []\n   782→\n   783→        cov_file = Path(self.target_dir) / \"coverage.json\"\n   784→        if not cov_file.exists():\n   785→            return []\n   786→\n   787→        try:\n   788→            data = json.loads(cov_file.read_text())\n   789→            files = data.get(\"files\", {})\n   790→            tasks = []\n   791→            for fname, info in files.items():\n   792→                pct = info.get(\"summary\", {}).get(\"percent_covered\", 100)\n   793→                if pct < 50:\n   794→                    desc = f\"Improve test coverage for {fname} (currently {pct:.0f}%)\"\n   795→                    tasks.append(Task(\n   796→                        description=desc,\n   797→                        priority=4,\n   798→                        source=\"coverage\",\n   799→                        source_file=fname,\n   800→                    ))\n   801→            return tasks[:10]\n   802→        except (json.JSONDecodeError, OSError):\n   803→            return []\n   804→\n   805→    def _discover_quality_issues(self) -> List[Task]:\n   806→        \"\"\"Review source files for general quality issues.\"\"\"\n   807→        tasks = []\n   808→        target = Path(self.target_dir)\n   809→        exclude_dirs = set(self.config.discovery.exclude_dirs)\n   810→\n   811→        for root, dirs, files in os.walk(target):\n   812→            dirs[:] = [d for d in dirs if d not in exclude_dirs]\n   813→\n   814→            for fname in files:\n   815→                if not fname.endswith(\".py\"):\n   816→                    continue\n   817→\n   818→                fpath = Path(root) / fname\n   819→                rel_path = str(fpath.relative_to(target))\n   820→\n   821→                try:\n   822→                    content = fpath.read_text(errors=\"ignore\")\n   823→                except OSError:\n   824→                    continue\n   825→\n   826→                lines = content.split(\"\\n\")\n   827→                # Flag very long files\n   828→                if len(lines) > 500:\n   829→                    tasks.append(Task(\n   830→                        description=f\"Review and potentially refactor {rel_path} ({len(lines)} lines)\",\n   831→                        priority=5,\n   832→                        source=\"quality\",\n   833→                        source_file=rel_path,\n   834→                    ))\n   835→\n   836→        return tasks[:5]\n   837→"}]},"parent_tool_use_id":null,"session_id":"9d4f0c9c-36f2-4b4d-8aee-0098214ea98c","uuid":"130a0796-2c57-42b2-8a30-652aa9596512","tool_use_result":{"type":"text","file":{"filePath":"/Users/sameertkhanna/Documents/auto_claude_code/task_discovery.py","content":"\"\"\"Auto-discover tasks from the target project (test failures, lint, TODOs, etc.).\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport logging\nimport os\nimport re\nimport time\nfrom dataclasses import dataclass, field\nfrom pathlib import Path\nfrom typing import List, Optional\n\nfrom config_schema import Config\nfrom process_utils import run_with_group_kill\n\nlogger = logging.getLogger(__name__)\n\n# Map file extensions to their comment prefix styles\n_COMMENT_PREFIXES = {\n    \".py\": (\"#\",), \".rb\": (\"#\",),\n    \".js\": (\"//\", \"/*\"), \".ts\": (\"//\", \"/*\"),\n    \".jsx\": (\"//\", \"/*\"), \".tsx\": (\"//\", \"/*\"),\n    \".go\": (\"//\", \"/*\"), \".rs\": (\"//\", \"/*\"),\n    \".java\": (\"//\", \"/*\"),\n}\n\n# Regex to match string literals (double-quoted and single-quoted, with escapes)\n_STRING_LITERAL_RE = re.compile(r'''\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^'\\\\]|\\\\.)*' '''.strip())\n\nMAX_TASK_DESCRIPTION_LENGTH = 2000\nMAX_TASK_CONTEXT_LENGTH = 12000\n\n# Default timeout for _discover_todos file walk (seconds)\nTODO_SCAN_TIMEOUT = 60\n\n_FILE_REF_RE = re.compile(\n    r'`([a-zA-Z0-9_/.\\-]+\\.(?:py|js|ts|tsx|jsx|go|rs|java|rb|sh|yaml|yml|json|md|txt))'\n    r'(?::(\\d+))?(?:-\\d+)?`'\n)\n_FILE_REF_FALLBACK_RE = re.compile(\n    r'(?:in\\s+|for\\s+)([a-zA-Z0-9_/.\\-]+\\.(?:py|js|ts|tsx|jsx|go|rs|java|rb|sh|yaml|yml|json|md|txt))'\n    r'(?::(\\d+))?'\n)\n\n\ndef _sanitize_description(desc: str) -> str:\n    \"\"\"Sanitize a task description: strip, collapse newlines, and truncate.\"\"\"\n    desc = desc.strip()\n    desc = desc.replace(\"\\n\", \" \").replace(\"\\r\", \" \")\n    if len(desc) > MAX_TASK_DESCRIPTION_LENGTH:\n        desc = desc[:MAX_TASK_DESCRIPTION_LENGTH] + \"...\"\n    return desc\n\n\ndef _extract_comment_text(line: str, ext: str) -> Optional[str]:\n    \"\"\"Strip string literals from *line*, then return the comment body if a\n    comment prefix for *ext* is found.  Returns ``None`` when no comment is\n    detected.\"\"\"\n    prefixes = _COMMENT_PREFIXES.get(ext)\n    if not prefixes:\n        return None\n\n    # Remove string literals so that a '#' or '//' inside a string is ignored\n    stripped = _STRING_LITERAL_RE.sub(\"\", line)\n\n    # Find the earliest comment prefix in the stripped line\n    earliest_pos = None\n    earliest_prefix = None\n    for pfx in prefixes:\n        pos = stripped.find(pfx)\n        if pos != -1 and (earliest_pos is None or pos < earliest_pos):\n            earliest_pos = pos\n            earliest_prefix = pfx\n\n    if earliest_pos is None:\n        return None\n\n    # Return the text after the comment prefix\n    return stripped[earliest_pos + len(earliest_prefix):]\n\n\n@dataclass\nclass Task:\n    description: str\n    priority: int  # 1 = highest (feedback), 5 = lowest (quality review)\n    source: str  # \"test_failure\", \"lint\", \"todo\", \"coverage\", \"quality\", \"feedback\"\n    source_file: Optional[str] = None  # file path for feedback tasks\n    line_number: Optional[int] = None\n    context: str = \"\"  # rich context: tracebacks, file snippets, error details\n    task_id: str = \"\"\n    depends_on: List[str] = field(default_factory=list)\n\n    def __post_init__(self):\n        self.description = _sanitize_description(self.description)\n        if len(self.context) > MAX_TASK_CONTEXT_LENGTH:\n            self.context = self.context[:MAX_TASK_CONTEXT_LENGTH] + \"\\n... (truncated)\"\n        if not self.task_id:\n            self.task_id = self.task_key\n\n    @property\n    def task_key(self) -> str:\n        \"\"\"Stable dedup key — same underlying issue produces the same key.\"\"\"\n        if self.source == \"todo\" and self.source_file:\n            if self.line_number is not None:\n                return f\"todo:{self.source_file}:{self.line_number}\"\n            return f\"todo:{self.source_file}\"\n\n        if self.source in (\"lint\", \"test_failure\", \"quality\", \"coverage\") and self.source_file:\n            return f\"{self.source}:{self.source_file}\"\n\n        if self.source == \"coverage\":\n            match = re.search(r'for\\s+(\\S+)', self.description)\n            if match:\n                return f\"coverage:{match.group(1)}\"\n\n        if self.source == \"claude_idea\":\n            match = _FILE_REF_RE.search(self.description)\n            if match:\n                return f\"claude_idea:{match.group(1)}\"\n            match = _FILE_REF_FALLBACK_RE.search(self.description)\n            if match:\n                return f\"claude_idea:{match.group(1)}\"\n            return f\"claude_idea:{self.description[:60]}\"\n\n        if self.source == \"feedback\" and self.source_file:\n            return f\"feedback:{self.source_file}\"\n\n        if self.source == \"test_failure\":\n            match = re.search(r'FAILED\\s+(\\S+)', self.description)\n            if match:\n                return f\"test_failure:{match.group(1)}\"\n\n        return f\"{self.source}:{self.description}\"\n\n\nclass TaskDiscovery:\n    def __init__(self, config: Config, state_manager=None):\n        self.config = config\n        self.target_dir = config.target_dir\n        self.state_manager = state_manager\n        self._last_idea_discovery_time: float = 0.0\n\n    def discover_all(self) -> List[Task]:\n        \"\"\"Run all enabled discovery strategies and return sorted tasks.\"\"\"\n        tasks: List[Task] = []\n        dc = self.config.discovery\n\n        if dc.enable_test_failures:\n            tasks.extend(self._discover_test_failures())\n\n        if dc.enable_lint_errors:\n            tasks.extend(self._discover_lint_errors())\n\n        if dc.enable_todos:\n            tasks.extend(self._discover_todos())\n\n        if dc.enable_coverage:\n            tasks.extend(self._discover_coverage_gaps())\n\n        if dc.enable_claude_ideas:\n            tasks.extend(self._discover_claude_ideas())\n\n        if dc.enable_quality_review:\n            tasks.extend(self._discover_quality_issues())\n\n        # Group related tasks to avoid duplicate work\n        tasks = self._group_related_tasks(tasks)\n\n        # Boost priority for historically high-success-rate sources\n        if self.state_manager and dc.adaptive_priority and tasks:\n            try:\n                performance = self.state_manager.get_strategy_performance(lookback_seconds=86400)\n                if performance:\n                    for task in tasks:\n                        perf = performance.get(task.source)\n                        if perf and perf.get(\"total\", 0) >= 2:\n                            success_rate = perf.get(\"success_rate\", 0.0)\n                            if success_rate > 0.5:\n                                # Higher success rate -> lower priority number (higher priority)\n                                # e.g., 90% success -> priority reduced by 2\n                                boost = int(success_rate * 3)  # 0-3 boost\n                                task.priority = max(1, task.priority - boost)\n            except Exception as e:\n                logger.debug(\"Strategy performance boosting failed: %s\", e)\n\n        # Sort by priority (lower number = higher priority)\n        tasks.sort(key=lambda t: t.priority)\n        return tasks\n\n    def _group_related_tasks(self, tasks: List[Task]) -> List[Task]:\n        \"\"\"Group related tasks by file path to avoid duplicate work.\n\n        When multiple tasks share the same source file (e.g., multiple test\n        failures in the same file, or multiple lint errors in the same file),\n        they likely share a root cause. This method keeps only the first\n        (highest-priority) task per file for each source type, reducing\n        wasted cycles on tasks that will auto-resolve when the root cause\n        is fixed.\n\n        Tasks without a source_file are always kept.\n        \"\"\"\n        from collections import defaultdict\n\n        # Group by (source, source_file) — only group when source_file is set\n        grouped: dict = defaultdict(list)\n        ungrouped: List[Task] = []\n\n        for task in tasks:\n            if task.source_file and task.source in (\"test_failure\", \"lint\", \"todo\"):\n                key = (task.source, task.source_file)\n                grouped[key].append(task)\n            else:\n                ungrouped.append(task)\n\n        result: List[Task] = list(ungrouped)\n        for key, group in grouped.items():\n            # Sort by priority (lower = better), keep the representative task\n            group.sort(key=lambda t: t.priority)\n            representative = group[0]\n            if len(group) > 1:\n                # Enrich the representative's description with count\n                representative.description = (\n                    f\"{representative.description} \"\n                    f\"(+{len(group) - 1} related in {key[1]})\"\n                )\n            result.append(representative)\n\n        return result\n\n    # Regex to extract file path and line number from pytest traceback lines\n    # Matches patterns like \"tests/test_foo.py:5: AssertionError\"\n    _TRACEBACK_LOC_RE = re.compile(\n        r'^(\\S+\\.py):(\\d+):\\s+\\w+(?:Error|Exception|Warning)'\n    )\n\n    def _extract_test_traceback(self, full_output: str, test_id: str) -> str:\n        \"\"\"Extract the traceback section for a specific test from pytest output.\n\n        Includes assertion details (lines starting with 'E') and ensures the\n        last 5 lines of the traceback are always present.\n        \"\"\"\n        if not test_id:\n            return \"\"\n        lines = full_output.split(\"\\n\")\n        collecting = False\n        result_lines: List[str] = []\n        assertion_lines: List[str] = []\n        for line in lines:\n            if test_id in line and (\"FAILED\" in line or \"ERROR\" in line or \"___\" in line):\n                collecting = True\n                result_lines = [line]\n                assertion_lines = []\n                continue\n            if collecting:\n                if (line.startswith(\"___\") and test_id not in line) or \\\n                   line.startswith(\"=\") or \\\n                   (line.startswith(\"FAILED \") and test_id not in line):\n                    break\n                result_lines.append(line)\n                # Collect assertion detail lines (pytest prefixes them with 'E')\n                stripped = line.lstrip()\n                if stripped.startswith(\"E \") or stripped.startswith(\"E\\t\"):\n                    assertion_lines.append(line)\n\n        if not result_lines:\n            return \"\"\n\n        # Ensure the last 5 lines of the traceback are included\n        # (they typically contain the assertion and location info)\n        traceback_text = \"\\n\".join(result_lines)\n        if len(result_lines) > 5:\n            last_5 = \"\\n\".join(result_lines[-5:])\n            # If assertion lines exist but aren't in last 5 lines, append them\n            if assertion_lines:\n                for aline in assertion_lines:\n                    if aline not in result_lines[-5:]:\n                        traceback_text += \"\\n\" + aline\n\n        return traceback_text\n\n    def _extract_traceback_location(self, traceback_text: str) -> tuple:\n        \"\"\"Extract file path and line number from a pytest traceback.\n\n        Returns (source_file, line_number) or (None, None) if not found.\n        \"\"\"\n        if not traceback_text:\n            return None, None\n        # Search for the last file:line pattern in the traceback\n        # (the last one is typically the failing assertion location)\n        last_match = None\n        for line in traceback_text.split(\"\\n\"):\n            line = line.strip()\n            m = self._TRACEBACK_LOC_RE.match(line)\n            if m:\n                last_match = m\n        if last_match:\n            return last_match.group(1), int(last_match.group(2))\n        return None, None\n\n    def _read_file_snippet(self, filepath: str, line_num: int, context_lines: int = 5) -> str:\n        \"\"\"Read a snippet of a file around the given line number.\"\"\"\n        try:\n            fpath = Path(filepath)\n            if not fpath.is_absolute():\n                fpath = Path(self.target_dir) / filepath\n            if not fpath.exists():\n                return \"\"\n            content = fpath.read_text(errors=\"ignore\")\n            lines = content.split(\"\\n\")\n            start = max(0, line_num - context_lines - 1)\n            end = min(len(lines), line_num + context_lines)\n            numbered = []\n            for i, line in enumerate(lines[start:end], start + 1):\n                marker = \" >> \" if i == line_num else \"    \"\n                numbered.append(f\"{marker}{i:4d} | {line}\")\n            return \"\\n\".join(numbered)\n        except OSError:\n            return \"\"\n\n    def _enrich_task_context(self, task: 'Task') -> None:\n        \"\"\"Populate a task's context with code snippets from file references in its description.\"\"\"\n        # Try primary regex, then fallback\n        match = _FILE_REF_RE.search(task.description)\n        if not match:\n            match = _FILE_REF_FALLBACK_RE.search(task.description)\n        if not match:\n            return\n\n        filepath = match.group(1)\n        line_num = int(match.group(2)) if match.group(2) else 1\n        snippet = self._read_file_snippet(filepath, line_num, context_lines=5)\n        if snippet:\n            task.context = f\"File: {filepath}\\n{snippet}\"\n            task.source_file = filepath\n            if match.group(2):\n                task.line_number = line_num\n\n    def _discover_test_failures(self) -> List[Task]:\n        \"\"\"Run pytest and parse failures.\"\"\"\n        test_cmd = self.config.validation.test_command\n        if not test_cmd.strip():\n            return []\n\n        try:\n            result = run_with_group_kill(\n                test_cmd,\n                shell=True,\n                cwd=self.target_dir,\n                timeout=self.config.validation.test_timeout,\n            )\n        except OSError as e:\n            logger.warning(\"Test discovery failed: %s\", e)\n            return []\n\n        if result.timed_out:\n            logger.warning(\"Test discovery timed out after %ds\", self.config.validation.test_timeout)\n            return []\n\n        if result.returncode == 0:\n            return []\n\n        # Capture full output for context\n        full_output = result.stdout\n        if result.stderr.strip():\n            full_output += \"\\n\" + result.stderr\n\n        # Parse pytest output for FAILED lines\n        tasks = []\n        for line in result.stdout.split(\"\\n\"):\n            line = line.strip()\n            if line.startswith(\"FAILED\"):\n                # e.g. \"FAILED tests/test_foo.py::test_bar - AssertionError: ...\"\n                desc = f\"Fix test failure: {line}\"\n                # Extract test identifier for per-test traceback\n                parts = line.split()\n                test_id = parts[1] if len(parts) > 1 else \"\"\n                per_test_ctx = self._extract_test_traceback(full_output, test_id)\n                # Extract file path and line number from the traceback\n                src_file, src_line = self._extract_traceback_location(per_test_ctx)\n                tasks.append(Task(\n                    description=desc,\n                    priority=2,\n                    source=\"test_failure\",\n                    source_file=src_file,\n                    line_number=src_line,\n                    context=per_test_ctx if per_test_ctx else full_output,\n                ))\n\n        # If we got failures but couldn't parse individual ones, create a generic task\n        if result.returncode != 0 and not tasks:\n            tasks.append(Task(\n                description=f\"Fix test failures (exit code {result.returncode})\",\n                priority=2,\n                source=\"test_failure\",\n                context=full_output,\n            ))\n\n        return tasks\n\n    def _discover_lint_errors(self) -> List[Task]:\n        \"\"\"Run lint command and parse errors.\"\"\"\n        lint_cmd = self.config.validation.lint_command\n        if not lint_cmd.strip():\n            return []\n\n        try:\n            result = run_with_group_kill(\n                lint_cmd,\n                shell=True,\n                cwd=self.target_dir,\n                timeout=self.config.validation.lint_timeout,\n            )\n        except OSError as e:\n            logger.warning(\"Lint discovery failed: %s\", e)\n            return []\n\n        if result.timed_out:\n            logger.warning(\"Lint discovery timed out after %ds\", self.config.validation.lint_timeout)\n            return []\n\n        if result.returncode == 0:\n            return []\n\n        # Try to parse ruff JSON output\n        output = result.stdout.strip()\n        try:\n            errors = json.loads(output)\n            if isinstance(errors, list):\n                tasks = []\n                for err in errors[:10]:  # Cap at 10 lint errors\n                    filename = err.get(\"filename\", \"unknown\")\n                    message = err.get(\"message\", \"lint error\")\n                    code = err.get(\"code\", \"\")\n                    line_num = err.get(\"location\", {}).get(\"row\", 0)\n                    desc = f\"Fix lint error in {filename}: [{code}] {message}\"\n                    # Build context: snippet around the error line\n                    context = \"\"\n                    if line_num > 0:\n                        context = self._read_file_snippet(filename, line_num, context_lines=5)\n                    tasks.append(Task(\n                        description=desc,\n                        priority=2,\n                        source=\"lint\",\n                        source_file=filename,\n                        line_number=line_num if line_num > 0 else None,\n                        context=context,\n                    ))\n                return tasks\n        except (json.JSONDecodeError, TypeError):\n            pass\n\n        # Fallback: generic lint error task\n        return [Task(\n            description=\"Fix lint errors\",\n            priority=2,\n            source=\"lint\",\n        )]\n\n    def _discover_todos(self, timeout: int = TODO_SCAN_TIMEOUT) -> List[Task]:\n        \"\"\"Scan source files for TODO/FIXME/HACK comments.\n\n        Args:\n            timeout: Maximum time in seconds for the file walk operation.\n                     If exceeded, returns whatever tasks were found so far.\n        \"\"\"\n        tasks = []\n        patterns = self.config.discovery.todo_patterns\n        exclude_dirs = set(self.config.discovery.exclude_dirs)\n\n        if not patterns:\n            return []\n\n        escaped = \"|\".join(re.escape(p) for p in patterns)\n        keyword_pat = r\"^\\s*(\" + escaped + r\")\\b\"\n        keyword_re = re.compile(keyword_pat, re.IGNORECASE)\n\n        target = Path(self.target_dir)\n        deadline = time.monotonic() + timeout\n        timed_out = False\n        files_scanned = 0\n        for root, dirs, files in os.walk(target):\n            # Check deadline at the start of each directory\n            if time.monotonic() > deadline:\n                timed_out = True\n                break\n\n            # Filter out excluded directories\n            dirs[:] = [d for d in dirs if d not in exclude_dirs]\n\n            for fname in files:\n                # Check deadline periodically (every file)\n                if time.monotonic() > deadline:\n                    timed_out = True\n                    break\n\n                ext = Path(fname).suffix\n                if ext not in _COMMENT_PREFIXES:\n                    continue\n\n                fpath = Path(root) / fname\n                rel_path = str(fpath.relative_to(target))\n\n                try:\n                    content = fpath.read_text(errors=\"ignore\")\n                except OSError:\n                    continue\n\n                files_scanned += 1\n\n                for i, line in enumerate(content.split(\"\\n\"), 1):\n                    comment_text = _extract_comment_text(line, ext)\n                    if comment_text is None:\n                        continue\n                    match = keyword_re.search(comment_text)\n                    if match:\n                        comment = line.strip()\n                        if len(comment) > 120:\n                            comment = comment[:120] + \"...\"\n                        desc = f\"Address {match.group(1)} in {rel_path}:{i}: {comment}\"\n                        context = self._read_file_snippet(str(fpath), i, context_lines=5)\n                        tasks.append(Task(\n                            description=desc,\n                            priority=3,\n                            source=\"todo\",\n                            source_file=rel_path,\n                            line_number=i,\n                            context=context,\n                        ))\n\n            if timed_out:\n                break\n\n        if timed_out:\n            logger.warning(\n                \"TODO scan timed out after %ds (scanned %d files, found %d tasks)\",\n                timeout, files_scanned, len(tasks),\n            )\n\n        return tasks[:self.config.discovery.max_todo_tasks]\n\n    def _discover_claude_ideas(self) -> List[Task]:\n        \"\"\"Use Claude to analyze the codebase and suggest improvement ideas.\n\n        Invokes Claude CLI in read-only analysis mode with a low max-turns\n        to keep cost down. Parses the response for actionable improvement tasks.\n        \"\"\"\n        # Enforce idea generation cooldown to prevent excessive API costs\n        cooldown = self.config.discovery.idea_cooldown_seconds\n        if cooldown > 0:\n            elapsed = time.time() - self._last_idea_discovery_time\n            if self._last_idea_discovery_time > 0 and elapsed < cooldown:\n                logger.debug(\n                    \"Skipping claude_ideas discovery: %.0fs since last run, \"\n                    \"cooldown is %ds\",\n                    elapsed, cooldown,\n                )\n                return []\n\n        cc = self.config.claude\n        if self.config.discovery.discovery_prompt:\n            focus_section = self.config.discovery.discovery_prompt\n        else:\n            focus_section = (\n                \"- New features or functionality that would add value\\n\"\n                \"- Missing tests for important functionality\\n\"\n                \"- Bug risks or edge cases that could cause failures\\n\"\n                \"- Performance improvements\\n\"\n                \"- Code clarity or maintainability improvements\\n\"\n            )\n\n        history_section = \"\"\n        if self.state_manager:\n            recent = self.state_manager.get_recent_task_summaries(\n                lookback_seconds=86400, max_items=15,\n            )\n            if recent:\n                history_section = (\n                    \"\\nRECENTLY COMPLETED TASKS (do NOT suggest similar improvements):\\n\"\n                    + \"\\n\".join(recent)\n                    + \"\\n\\nFocus on NEW areas that haven't been addressed recently.\\n\"\n                )\n\n        prompt = (\n            \"Analyze the codebase in the current directory. Identify up to 5 concrete, \"\n            \"actionable improvements. Focus on:\\n\"\n            + focus_section\n            + history_section\n            + \"\\nFor each improvement, output EXACTLY one line in this format:\\n\"\n            \"IDEA: <one-sentence description of the improvement>\\n\\n\"\n            \"Do NOT make any changes. Do NOT run git commands. Only analyze and output IDEA lines.\"\n        )\n\n        cmd = [\n            cc.command, \"-p\", prompt,\n            \"--model\", self.config.discovery.discovery_model or self.config.claude.resolved_model,\n            \"--max-turns\", str(self.config.discovery.discovery_max_turns),\n            \"--output-format\", \"json\",\n        ]\n\n        try:\n            result = run_with_group_kill(\n                cmd,\n                cwd=self.target_dir,\n                timeout=self.config.discovery.discovery_timeout,\n            )\n        except (FileNotFoundError, OSError) as e:\n            logger.warning(\"Claude idea discovery failed: %s\", e)\n            return []\n\n        if result is None:\n            logger.warning(\"Claude idea discovery returned no result\")\n            return []\n\n        if result.timed_out:\n            logger.warning(\"Claude idea discovery timed out after %ds\",\n                           self.config.discovery.discovery_timeout)\n            return []\n\n        if result.returncode != 0:\n            logger.warning(\"Claude idea discovery exited with code %d\", result.returncode)\n            return []\n\n        # Parse JSON response to get result text\n        result_text = result.stdout\n        try:\n            # Helper: extract text content from a parsed JSON dict.\n            # The Claude CLI uses \"result\" for successful runs and may use\n            # \"result_text\" in some versions.\n            def _extract_text(d: dict) -> str:\n                for key in (\"result\", \"result_text\"):\n                    val = d.get(key)\n                    if isinstance(val, str) and val.strip():\n                        return val\n                return \"\"\n\n            # Strategy 1: Try each line individually as a complete JSON object\n            for line in result_text.strip().split(\"\\n\"):\n                line = line.strip()\n                if not line.startswith(\"{\"):\n                    continue\n                try:\n                    data = json.loads(line)\n                    if isinstance(data, dict):\n                        # Check for error_max_turns — Claude ran out of turns\n                        if data.get(\"subtype\") == \"error_max_turns\":\n                            logger.warning(\n                                \"Claude idea discovery hit max turns (%d); \"\n                                \"increase discovery.discovery_max_turns\",\n                                self.config.discovery.discovery_max_turns,\n                            )\n                            text = _extract_text(data)\n                            if text:\n                                result_text = text\n                            break\n                        text = _extract_text(data)\n                        if text:\n                            result_text = text\n                            break\n                except (json.JSONDecodeError, TypeError):\n                    continue\n            else:\n                # Strategy 2: Try multi-line JSON joining from each '{'-starting line\n                lines = result_text.strip().split(\"\\n\")\n                for i, line in enumerate(lines):\n                    if not line.strip().startswith(\"{\"):\n                        continue\n                    try:\n                        data = json.loads(\"\\n\".join(lines[i:]))\n                        if isinstance(data, dict):\n                            if data.get(\"subtype\") == \"error_max_turns\":\n                                logger.warning(\n                                    \"Claude idea discovery hit max turns (%d); \"\n                                    \"increase discovery.discovery_max_turns\",\n                                    self.config.discovery.discovery_max_turns,\n                                )\n                                text = _extract_text(data)\n                                if text:\n                                    result_text = text\n                                break\n                            text = _extract_text(data)\n                            if text:\n                                result_text = text\n                                break\n                    except (json.JSONDecodeError, TypeError):\n                        continue\n                else:\n                    # Strategy 3: Use raw_decode to find JSON anywhere in the output\n                    decoder = json.JSONDecoder()\n                    for i, ch in enumerate(result_text):\n                        if ch != \"{\":\n                            continue\n                        try:\n                            obj, end = decoder.raw_decode(result_text, i)\n                            if isinstance(obj, dict):\n                                text = _extract_text(obj)\n                                if text:\n                                    result_text = text\n                                    break\n                        except (json.JSONDecodeError, TypeError):\n                            continue\n        except Exception:\n            pass\n\n        # Warn if we couldn't extract text from a JSON response\n        if result_text is result.stdout and result.stdout.strip()[:1] in (\"{\", \"[\"):\n            logger.warning(\n                \"Claude idea response contained JSON but no text content \"\n                \"could be extracted — falling back to raw text extraction\"\n            )\n\n        # Extract IDEA lines\n        MIN_IDEA_LENGTH = 10\n        tasks = []\n        for line in result_text.split(\"\\n\"):\n            line = line.strip()\n            if line.upper().startswith(\"IDEA:\"):\n                desc = line[5:].strip()\n                if desc and len(desc) >= MIN_IDEA_LENGTH:\n                    tasks.append(Task(\n                        description=desc,\n                        priority=4,\n                        source=\"claude_idea\",\n                    ))\n                elif desc:\n                    logger.debug(\"Skipping short IDEA line: %r\", desc)\n\n        # Enrich tasks with file context from their descriptions\n        for task in tasks:\n            self._enrich_task_context(task)\n\n        logger.info(\"Claude discovered %d improvement ideas\", len(tasks))\n        if not tasks and result_text.strip():\n            # Attempt fallback extraction from analysis-format text\n            lines = [l.strip() for l in result_text.split(\"\\n\") if l.strip()]\n            for line in lines:\n                # Match numbered items: \"1. ...\", \"2) ...\"\n                m = re.match(r'^\\d+[.)]\\s+(.+)', line)\n                if not m:\n                    # Match bullet items: \"- ...\", \"* ...\", \"• ...\"\n                    m = re.match(r'^[-*•]\\s+(.+)', line)\n                if m:\n                    desc = m.group(1).strip()\n                    if desc and len(desc) >= MIN_IDEA_LENGTH:\n                        tasks.append(Task(\n                            description=desc,\n                            priority=4,\n                            source=\"claude_idea\",\n                        ))\n            # Enrich fallback tasks with file context\n            for task in tasks:\n                self._enrich_task_context(task)\n            if tasks:\n                logger.info(\n                    \"Extracted %d tasks from analysis-format text \"\n                    \"(no IDEA: prefixed lines found, used numbered/bullet fallback).\",\n                    len(tasks),\n                )\n            else:\n                logger.debug(\n                    \"Claude response contained no IDEA lines and no extractable \"\n                    \"analysis-format items (%d non-empty lines)\",\n                    len(lines),\n                )\n        self._last_idea_discovery_time = time.time()\n        return tasks[:5]\n\n    def _discover_coverage_gaps(self) -> List[Task]:\n        \"\"\"Discover files with low test coverage (optional, requires pytest-cov).\"\"\"\n        try:\n            result = run_with_group_kill(\n                \"python3 -m pytest --cov --cov-report=json --cov-report=term -q\",\n                shell=True,\n                cwd=self.target_dir,\n                timeout=self.config.validation.test_timeout,\n            )\n        except OSError:\n            return []\n\n        if result.timed_out:\n            return []\n\n        cov_file = Path(self.target_dir) / \"coverage.json\"\n        if not cov_file.exists():\n            return []\n\n        try:\n            data = json.loads(cov_file.read_text())\n            files = data.get(\"files\", {})\n            tasks = []\n            for fname, info in files.items():\n                pct = info.get(\"summary\", {}).get(\"percent_covered\", 100)\n                if pct < 50:\n                    desc = f\"Improve test coverage for {fname} (currently {pct:.0f}%)\"\n                    tasks.append(Task(\n                        description=desc,\n                        priority=4,\n                        source=\"coverage\",\n                        source_file=fname,\n                    ))\n            return tasks[:10]\n        except (json.JSONDecodeError, OSError):\n            return []\n\n    def _discover_quality_issues(self) -> List[Task]:\n        \"\"\"Review source files for general quality issues.\"\"\"\n        tasks = []\n        target = Path(self.target_dir)\n        exclude_dirs = set(self.config.discovery.exclude_dirs)\n\n        for root, dirs, files in os.walk(target):\n            dirs[:] = [d for d in dirs if d not in exclude_dirs]\n\n            for fname in files:\n                if not fname.endswith(\".py\"):\n                    continue\n\n                fpath = Path(root) / fname\n                rel_path = str(fpath.relative_to(target))\n\n                try:\n                    content = fpath.read_text(errors=\"ignore\")\n                except OSError:\n                    continue\n\n                lines = content.split(\"\\n\")\n                # Flag very long files\n                if len(lines) > 500:\n                    tasks.append(Task(\n                        description=f\"Review and potentially refactor {rel_path} ({len(lines)} lines)\",\n                        priority=5,\n                        source=\"quality\",\n                        source_file=rel_path,\n                    ))\n\n        return tasks[:5]\n","numLines":837,"startLine":1,"totalLines":837}}}
