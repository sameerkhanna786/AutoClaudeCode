{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_vrtx_01PxwAgcb1CPiWBDPMQDnhJt","type":"tool_result","content":"     1→\"\"\"Tests for session_manager.py — session recovery and resume.\"\"\"\n     2→\n     3→from __future__ import annotations\n     4→\n     5→import json\n     6→import tempfile\n     7→import unittest\n     8→from pathlib import Path\n     9→from unittest.mock import MagicMock, patch\n    10→\n    11→from session_manager import SessionManager, SessionState\n    12→\n    13→\n    14→class TestSessionState(unittest.TestCase):\n    15→\n    16→    def test_round_trip(self):\n    17→        state = SessionState(\n    18→            session_id=\"test-123\",\n    19→            started_at=1000.0,\n    20→            tasks=[{\"task_id\": \"t1\", \"description\": \"Fix bug\"}],\n    21→            completed_task_ids=[\"t1\"],\n    22→            total_cost_usd=1.5,\n    23→            phase=\"validating\",\n    24→        )\n    25→        d = state.to_dict()\n    26→        restored = SessionState.from_dict(d)\n    27→        self.assertEqual(restored.session_id, \"test-123\")\n    28→        self.assertEqual(restored.started_at, 1000.0)\n    29→        self.assertEqual(len(restored.tasks), 1)\n    30→        self.assertEqual(restored.completed_task_ids, [\"t1\"])\n    31→        self.assertAlmostEqual(restored.total_cost_usd, 1.5)\n    32→        self.assertEqual(restored.phase, \"validating\")\n    33→\n    34→    def test_from_empty_dict(self):\n    35→        state = SessionState.from_dict({})\n    36→        self.assertEqual(state.session_id, \"\")\n    37→        self.assertEqual(state.tasks, [])\n    38→        self.assertEqual(state.phase, \"starting\")\n    39→\n    40→\n    41→class TestSessionManager(unittest.TestCase):\n    42→\n    43→    def test_save_and_load(self):\n    44→        with tempfile.TemporaryDirectory() as tmpdir:\n    45→            mgr = SessionManager(tmpdir)\n    46→            state = SessionState(\n    47→                session_id=\"s1\",\n    48→                started_at=100.0,\n    49→                tasks=[{\"task_id\": \"a\", \"description\": \"Do A\"}],\n    50→                phase=\"executing\",\n    51→            )\n    52→            mgr.save_session(state)\n    53→            loaded = mgr.load_session()\n    54→            self.assertIsNotNone(loaded)\n    55→            self.assertEqual(loaded.session_id, \"s1\")\n    56→            self.assertEqual(loaded.phase, \"executing\")\n    57→\n    58→    def test_clear_session(self):\n    59→        with tempfile.TemporaryDirectory() as tmpdir:\n    60→            mgr = SessionManager(tmpdir)\n    61→            state = SessionState(session_id=\"s1\", started_at=100.0)\n    62→            mgr.save_session(state)\n    63→            self.assertTrue(mgr.has_incomplete_session() is not None)\n    64→            mgr.clear_session()\n    65→            loaded = mgr.load_session()\n    66→            self.assertIsNone(loaded)\n    67→\n    68→    def test_has_incomplete_session_true(self):\n    69→        with tempfile.TemporaryDirectory() as tmpdir:\n    70→            mgr = SessionManager(tmpdir)\n    71→            state = SessionState(\n    72→                session_id=\"s1\",\n    73→                started_at=100.0,\n    74→                tasks=[\n    75→                    {\"task_id\": \"a\", \"task_key\": \"a\"},\n    76→                    {\"task_id\": \"b\", \"task_key\": \"b\"},\n    77→                ],\n    78→                completed_task_ids=[\"a\"],\n    79→            )\n    80→            mgr.save_session(state)\n    81→            self.assertTrue(mgr.has_incomplete_session())\n    82→\n    83→    def test_has_incomplete_session_false_all_complete(self):\n    84→        with tempfile.TemporaryDirectory() as tmpdir:\n    85→            mgr = SessionManager(tmpdir)\n    86→            state = SessionState(\n    87→                session_id=\"s1\",\n    88→                started_at=100