{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_vrtx_013QTEfoe34rgamWf599CZkY","type":"tool_result","content":"   495→\n   496→\n   497→# ---------------------------------------------------------------------------\n   498→# build_retry_prompt\n   499→# ---------------------------------------------------------------------------\n   500→\n   501→class TestBuildRetryPrompt(unittest.TestCase):\n   502→\n   503→    def test_with_attempt_info(self):\n   504→        task = Task(description=\"Fix bug\", priority=1, source=\"test_failure\")\n   505→        result = build_retry_prompt(\n   506→            [task], \"AssertionError: expected True\", [\"main.py\"],\n   507→            attempt=2, max_attempts=5,\n   508→        )\n   509→        self.assertIn(\"attempt 2 of 5\", result)\n   510→        self.assertIn(\"VALIDATION FAILURES\", result)\n   511→        self.assertIn(\"AssertionError\", result)\n   512→\n   513→    def test_long_output_truncation(self):\n   514→        task = Task(description=\"Fix bug\", priority=1, source=\"test_failure\")\n   515→        long_output = \"x\" * 10000\n   516→        result = build_retry_prompt([task], long_output, [\"main.py\"])\n   517→        self.assertIn(\"(truncated)\", result)\n   518→        # The original 10000 chars should be truncated\n   519→        self.assertLess(len(result), 10000 + 2000)  # prompt text + truncated output\n   520→\n   521→    def test_batch_retry(self):\n   522→        tasks = [\n   523→            Task(description=\"Fix A\", priority=1, source=\"lint\"),\n   524→            Task(description=\"Fix B\", priority=2, source=\"todo\"),\n   525→        ]\n   526→        result = build_retry_prompt(tasks, \"error output\", [\"main.py\"])\n   527→        self.assertIn(\"TASKS:\", result)\n   528→\n   529→\n   530→# ---------------------------------------------------------------------------\n   531→# _derive_todo_subject\n   532→# ---------------------------------------------------------------------------\n   533→\n   534→class TestDeriveTodoSubject(unittest.TestCase):\n   535→\n   536→    def test_full_regex_match(self):\n   537→        desc = \"Address TODO in shared.py:10: implement caching\"\n   538→        result = _derive_todo_subject(desc)\n   539→        self.assertEqual(result, \"Implement caching in shared.py\")\n   540→\n   541→    def test_partial_match_no_action(self):\n   542→        desc = \"Address TODO in shared.py:10: TODO: \"\n   543→        result = _derive_todo_subject(desc)\n   544→        self.assertEqual(result, \"Address TODO in shared.py\")\n   545→\n   546→    def test_fallback_no_match(self):\n   547→        desc = \"Some random todo description\"\n   548→        result = _derive_todo_subject(desc)\n   549→        self.assertEqual(result, \"Some random todo description\")\n   550→\n   551→    def test_fixme_stripped(self):\n   552→        desc = \"TODO in utils.py:5: FIXME: handle edge case\"\n   553→        result = _derive_todo_subject(desc)\n   554→        self.assertEqual(result, \"Handle edge case in utils.py\")"}]},"parent_tool_use_id":null,"session_id":"cdc88a14-e661-4229-849a-8b4c75790bc7","uuid":"f78898bc-1f9b-4e35-a789-c7edeb282434","tool_use_result":{"type":"text","file":{"filePath":"/Users/sameertkhanna/Documents/auto_claude_code/tests/test_shared.py","content":"\n\n# ---------------------------------------------------------------------------\n# build_retry_prompt\n# ---------------------------------------------------------------------------\n\nclass TestBuildRetryPrompt(unittest.TestCase):\n\n    def test_with_attempt_info(self):\n        task = Task(description=\"Fix bug\", priority=1, source=\"test_failure\")\n        result = build_retry_prompt(\n            [task], \"AssertionError: expected True\", [\"main.py\"],\n            attempt=2, max_attempts=5,\n        )\n        self.assertIn(\"attempt 2 of 5\", result)\n        self.assertIn(\"VALIDATION FAILURES\", result)\n        self.assertIn(\"AssertionError\", result)\n\n    def test_long_output_truncation(self):\n        task = Task(description=\"Fix bug\", priority=1, source=\"test_failure\")\n        long_output = \"x\" * 10000\n        result = build_retry_prompt([task], long_output, [\"main.py\"])\n        self.assertIn(\"(truncated)\", result)\n        # The original 10000 chars should be truncated\n        self.assertLess(len(result), 10000 + 2000)  # prompt text + truncated output\n\n    def test_batch_retry(self):\n        tasks = [\n            Task(description=\"Fix A\", priority=1, source=\"lint\"),\n            Task(description=\"Fix B\", priority=2, source=\"todo\"),\n        ]\n        result = build_retry_prompt(tasks, \"error output\", [\"main.py\"])\n        self.assertIn(\"TASKS:\", result)\n\n\n# ---------------------------------------------------------------------------\n# _derive_todo_subject\n# ---------------------------------------------------------------------------\n\nclass TestDeriveTodoSubject(unittest.TestCase):\n\n    def test_full_regex_match(self):\n        desc = \"Address TODO in shared.py:10: implement caching\"\n        result = _derive_todo_subject(desc)\n        self.assertEqual(result, \"Implement caching in shared.py\")\n\n    def test_partial_match_no_action(self):\n        desc = \"Address TODO in shared.py:10: TODO: \"\n        result = _derive_todo_subject(desc)\n        self.assertEqual(result, \"Address TODO in shared.py\")\n\n    def test_fallback_no_match(self):\n        desc = \"Some random todo description\"\n        result = _derive_todo_subject(desc)\n        self.assertEqual(result, \"Some random todo description\")\n\n    def test_fixme_stripped(self):\n        desc = \"TODO in utils.py:5: FIXME: handle edge case\"\n        result = _derive_todo_subject(desc)\n        self.assertEqual(result, \"Handle edge case in utils.py\")","numLines":60,"startLine":495,"totalLines":617}}}
