 105→            (\"lint\", vc.lint_command, vc.lint_timeout),\n   106→            (\"tests\", vc.test_command, vc.test_timeout),\n   107→            (\"build\", vc.build_command, vc.build_timeout),\n   108→        ]\n   109→\n   110→        for name, command, timeout in commands:\n   111→            step = self._run_command(name, command, timeout, cwd)\n   112→            steps.append(step)\n   113→            if not step.passed and command.strip():\n   114→                logger.warning(\"%s failed (rc=%d)\", name, step.return_code)\n   115→                return ValidationResult(passed=False, steps=steps)\n   116→\n   117→        return ValidationResult(passed=True, steps=steps)\n   118→\n   119→    # Regex to parse pytest FAILED lines, e.g.:\n   120→    # FAILED tests/test_foo.py::TestBar::test_baz - AssertionError: ...\n   121→    _FAILED_LINE_RE = re.compile(r'^FAILED\\s+(\\S+)', re.MULTILINE)\n   122→\n   123→    def capture_baseline(self, working_dir: Optional[str] = None) -> Set[str]:\n   124→        \"\"\"Run the test suite and return the set of already-failing test IDs.\n   125→\n   126→        Returns an empty set if all tests pass or on parse error.\n   127→        \"\"\"\n   128→        cwd = working_dir or self.config.target_dir\n   129→        vc = self.config.validation\n   130→        test_cmd = vc.test_command.strip()\n   131→        if not test_cmd:\n   132→            return set()\n   133→\n   134→        # Append --tb=line for faster output\n   135→        baseline_cmd = f\"{test_cmd} --tb=line\"\n   136→        step = self._run_command(\"baseline\", baseline_cmd, vc.test_timeout, cwd)\n   137→\n   138→        if step.passed:\n   139→            logger.info(\"Baseline: all tests pass\")\n   140→            return set()\n   141→\n   142→        failures = set(self._FAILED_LINE_RE.findall(step.output))\n   143→        if failures:\n   144→            logger.info(\"Baseline: %d pre-existing test failure(s)\", len(failures))\n   145→        else:\n   146→            logger.warning(\n   147→                \"Baseline: tests failed (rc=%d) but no FAILED lines parsed\",\n   148→                step.return_code,\n   149→            )\n   150→        return failures\n   151→\n   152→    def validate_with_baseline(\n   153→        self,\n   154→        working_dir: Optional[str] = None,\n   155→        baseline_failures: Optional[Set[str]] = None,\n   156→    ) -> ValidationResult:\n   157→        \"\"\"Like validate(), but pre-existing test failures are ignored.\n   158→\n   159→        If baseline_failures is None or empty, behaves identically to validate().\n   160→        \"\"\"\n   161→        if not baseline_failures:\n   162→            return self.validate(working_dir)\n   163→\n   164→        cwd = working_dir or self.config.target_dir\n   165→        vc = self.config.validation\n   166→        steps: List[ValidationStep] = []\n   167→\n   168→        # Run lint first\n   169→        lint_step = self._run_command(\"lint\", vc.lint_command, vc.lint_timeout, cwd)\n   170→        steps.append(lint_step)\n   171→        if not lint_step.passed and vc.lint_command.strip():\n   172→            logger.warning(\"lint failed (rc=%d)\", lint_step.return_code)\n   173→            return ValidationResult(passed=False, steps=steps)\n   174→\n   175→        # Run tests — strip -x when baseline is active so all failures are visible\n   176→        test_cmd = vc.test_command\n   177→        if baseline_failures and \" -x \" in f\" {test_cmd} \":\n   178→            test_cmd = test_cmd.replace(\" -x \", \" \").replace(\" -x\", \"\").strip()\n   179→            logger.debug(\"Removed -x from test command for baseline comparison\")\n   180→        test_step = self._run_command(\"tests\", test_cmd, vc.test_timeout, cwd)\n   181→        if test_step.passed:\n   182→            steps.append(test_step)\n   183→        else:\n   184→            # Parse current failures and subtract baseline\n   185→            current_failures = set(self._FAILED_LINE_RE.findall(test_step.output))\n   186→\n   187→            if not current_failures:\n   188→                # Tests failed but we couldn't parse any FAILED lines —\n   189→                # could be a collection error, import error, segfault, etc.\n   190→                # Treat as a genuine failure rather than silently passing.\n   191→                logger.warning(\n   192→                    \"Tests failed (rc=%d) but no FAILED lines parsed, \"\n   193→                    \"treating as genuine failure\",\n   194→                    test_step.return_code,\n   195→                )\n   196→                steps.append(test_step)\n   197→                return ValidationResult(passed=False, steps=steps)\n   198→\n   199→            new_failures = current_failures - baseline_failures\n   200→            ignored = current_failures & baseline_failures\n   201→\n   202→            if ignored:\n   203→                logger.warning(\n   204→                    \"Ignoring %d pre-existing test failure(s): %s\",\n   205→                    len(ignored), sorted(ignored),\n   206→                )\n   207→\n   208→            if new_failures:\n   209→                # Real new failures — report as FAIL\n   210→                logger.warning(\n   211→                    \"New test failures (not in baseline): %s\",\n   212→                    sorted(new_failures),\n   213→                )\n   214→                steps.append(test_step)\n   215→                return ValidationResult(passed=False, steps=steps)\n   216→            else:\n   217→                # All failures are pre-existing — treat as PASS\n   218→                logger.info(\n   219→                    \"All %d test failure(s) are pre-existing, treating tests as passed\",\n   220→                    len(current_failures),\n   221→                )\n   222→                steps.append(ValidationStep(\n   223→                    name=\"tests\",\n   224→                    command=test_step.command,\n   225→                    passed=True,\n   226→                    output=test_step.output,\n   227→                    return_code=test_step.return_code,\n   228→                ))\n   229→\n   230→        # Run build\n   231→        build_step = self._run_command(\"build\", vc.build_command, vc.build_timeout, cwd)\n   232→        steps.append(build_step)\n   233→        if not build_step.passed and vc.build_command.strip():\n   234→            logger.warning(\"build failed (rc=%d)\", build_step.return_code)\n   235→            return ValidationResult(passed=False, steps=steps)\n   236→\n   237→        return ValidationResult(passed=True, steps=steps)\n   238→\n   239→    def _map_changed_to_test_files(\n   240→        self, changed_files: List[str], working_dir: str,\n   241→    ) -> List[str]:\n   242→        \"\"\"Map changed .py files to their likely test files.\n   243→\n   244→        For each changed file like `foo.py`, looks for `test_foo.py` or\n   245→        `tests/test_foo.py`. Also includes any changed test files directly.\n   246→        Returns test file paths relative to working_dir.\n   247→        \"\"\"\n   248→        test_files = []\n   249→        wd = Path(working_dir)\n   250→\n   251→        for f in changed_files:\n   252→            if not f.endswith(\".py\"):\n   253→                continue\n   254→\n   255→            p = Path(f)\n   256→            basename = p.stem  # e.g., \"foo\" from \"foo.py\"\n   257→\n   258→            # If it's already a test file, include it directly\n   259→            if basename.startswith(\"test_\"):\n   260→                if (wd / f).exists():\n   261→                    test_files.append(f)\n   262→                continue\n   263→\n   264→            # Look for test_<basename>.py in common locations\n   265→            candidates = [\n   266→                p.parent / f\"test_{basename}.py\",\n   267→                Path(\"tests\") / f\"test_{basename}.py\",\n   268→                Path(\"test\") / f\"test_{basename}.py\",\n   269→            ]\n   270→\n   271→            for candidate in candidates:\n   272→                full = wd / candidate\n   273→                if full.exists():\n   274→                    test_files.append(str(candidate))\n   275→                    break\n   276→\n   277→        return list(set(test_files))\n   278→\n   279→    def validate_incremental(\n   280→        self, working_dir: str, changed_files: List[str],\n   281→    ) -> ValidationResult:\n   282→        \"\"\"Run targeted tests for changed files, then full suite on success.\n   283→\n   284→        1. Maps changed files to test files.\n   285→        2. Runs only those tests first (fast feedback).\n   286→        3. If targeted tests pass, runs the full test suite as final check.\n   287→        4. Falls back to full validation if no test files can be mapped.\n   288→        \"\"\"\n   289→        cwd = working_dir or self.config.target_dir\n   290→        vc = self.config.validation\n   291→\n   292→        if not vc.test_command.strip():\n   293→            return self.validate(working_dir)\n   294→\n   295→        test_files = self._map_changed_to_test_files(changed_files, cwd)\n   296→        if not test_files:\n   297→            # Can't determine affected tests, fall back to full suite\n   298→            return self.validate(working_dir)\n   299→\n   300→        # Phase 1: Run targeted tests\n   301→        targeted_cmd = f\"python3 -m pytest {' '.join(shlex.quote(f) for f in test_files)} -x -q\"\n   302→        steps: List[ValidationStep] = []\n   303→\n   304→        # Run lint first\n   305→        lint_step = self._run_command(\"lint\", vc.lint_command, vc.lint_timeout, cwd)\n   306→        steps.append(lint_step)\n   307→        if not lint_step.passed and vc.lint_command.strip():\n   308→            return ValidationResult(passed=False, steps=steps)\n   309→\n   310→        # Run targeted tests\n   311→        targeted_step = self._run_command(\n   312→            \"tests (targeted)\", targeted_cmd, vc.test_timeout, cwd,\n   313→        )\n   314→        steps.append(targeted_step)\n   315→        if not targeted_step.passed:\n   316→            return ValidationResult(passed=False, steps=steps)\n   317→\n   318→        # Phase 2: Run full test suite to catch regressions\n   319→        full_step = self._run_command(\n   320→            \"tests (full)\", vc.test_command, vc.test_timeout, cwd,\n   321→        )\n   322→        steps.append(full_step)\n   323→        if not full_step.passed:\n   324→            return ValidationResult(passed=False, steps=steps)\n   325→\n   326→        # Run build\n   327→        build_step = self._run_command(\"build\", vc.build_command, vc.build_timeout, cwd)\n   328→        steps.append(build_step)\n   329→        if not build_step.passed and vc.build_command.strip():\n   330→            return ValidationResult(passed=False, steps=steps)\n   331→\n   332→        return ValidationResult(passed=True, steps=steps)\n   333→"}]},"parent_tool_use_id":null,"session_id":"5465e065-cccf-455f-a60c-6e459f19d53c","uuid":"ac6784e5-7078-485c-aad4-be953de6facb","tool_use_result":{"type":"text","file":{"filePath":"/Users/sameertkhanna/Documents/auto_claude_code/validator.py","content":"\"\"\"Run validation commands (tests, lint, build) and report results.\"\"\"\n\nfrom __future__ import annotations\n\nimport logging\nimport os\nimport re\nimport shlex\nimport subprocess\nfrom dataclasses import dataclass, field\nfrom pathlib import Path\nfrom typing import List, Optional, Set\n\nfrom config_schema import Config\nfrom process_utils import run_with_group_kill\n\nlogger = logging.getLogger(__name__)\n\n\n@dataclass\nclass ValidationStep:\n    name: str\n    command: str\n    passed: bool\n    output: str = \"\"\n    return_code: int = 0\n\n\n@dataclass\nclass ValidationResult:\n    passed: bool\n    steps: List[ValidationStep] = field(default_factory=list)\n\n    @property\n    def summary(self) -> str:\n        parts = []\n        for s in self.steps:\n            status = \"PASS\" if s.passed else \"FAIL\"\n            parts.append(f\"{s.name}: {status}\")\n        return \", \".join(parts) if parts else \"no validations run\"\n\n\nclass Validator:\n    def __init__(self, config: Config):\n        self.config = config\n\n    def _run_command(self, name: str, command: str, timeout: int, cwd: str) -> ValidationStep:\n        \"\"\"Run a single validation command.\"\"\"\n        if not command.strip():\n            return ValidationStep(name=name, command=\"\", passed=True, output=\"skipped\")\n\n        logger.info(\"Running %s: %s\", name, command)\n        try:\n            result = run_with_group_kill(\n                command,\n                shell=True,\n                cwd=cwd,\n                timeout=timeout,\n            )\n            if result.timed_out:\n                return ValidationStep(\n                    name=name,\n                    command=command,\n                    passed=False,\n                    output=f\"Timed out after {timeout}s\",\n                    return_code=-1,\n                )\n            passed = result.returncode == 0\n            output = result.stdout + result.stderr\n            return ValidationStep(\n                name=name,\n                command=command,\n                passed=passed,\n                output=output.strip(),\n                return_code=result.returncode,\n            )\n        except OSError as e:\n            return ValidationStep(\n                name=name,\n                command=command,\n                passed=False,\n                output=str(e),\n                return_code=-1,\n            )\n        except Exception as e:\n            logger.warning(\"Unexpected error running %s: %s\", name, e)\n            return ValidationStep(\n                name=name,\n                command=command,\n                passed=False,\n                output=f\"Unexpected error: {e}\",\n                return_code=-1,\n            )\n\n    def validate(self, working_dir: Optional[str] = None) -> ValidationResult:\n        \"\"\"Run test, lint, build commands sequentially.\n\n        Short-circuits on first failure.\n        \"\"\"\n        cwd = working_dir or self.config.target_dir\n        vc = self.config.validation\n        steps: List[ValidationStep] = []\n\n        commands = [\n            (\"lint\", vc.lint_command, vc.lint_timeout),\n            (\"tests\", vc.test_command, vc.test_timeout),\n            (\"build\", vc.build_command, vc.build_timeout),\n        ]\n\n        for name, command, timeout in commands:\n            step = self._run_command(name, command, timeout, cwd)\n            steps.append(step)\n            if not step.passed and command.strip():\n                logger.warning(\"%s failed (rc=%d)\", name, step.return_code)\n                return ValidationResult(passed=False, steps=steps)\n\n        return ValidationResult(passed=True, steps=steps)\n\n    # Regex to parse pytest FAILED lines, e.g.:\n    # FAILED tests/test_foo.py::TestBar::test_baz - AssertionError: ...\n    _FAILED_LINE_RE = re.compile(r'^FAILED\\s+(\\S+)', re.MULTILINE)\n\n    def capture_baseline(self, working_dir: Optional[str] = None) -> Set[str]:\n        \"\"\"Run the test suite and return the set of already-failing test IDs.\n\n        Returns an empty set if all tests pass or on parse error.\n        \"\"\"\n        cwd = working_dir or self.config.target_dir\n        vc = self.config.validation\n        test_cmd = vc.test_command.strip()\n        if not test_cmd:\n            return set()\n\n        # Append --tb=line for faster output\n        baseline_cmd = f\"{test_cmd} --tb=line\"\n        step = self._run_command(\"baseline\", baseline_cmd, vc.test_timeout, cwd)\n\n        if step.passed:\n            logger.info(\"Baseline: all tests pass\")\n            return set()\n\n        failures = set(self._FAILED_LINE_RE.findall(step.output))\n        if failures:\n            logger.info(\"Baseline: %d pre-existing test failure(s)\", len(failures))\n        else:\n            logger.warning(\n                \"Baseline: tests failed (rc=%d) but no FAILED lines parsed\",\n                step.return_code,\n            )\n        return failures\n\n    def validate_with_baseline(\n        self,\n        working_dir: Optional[str] = None,\n        baseline_failures: Optional[Set[str]] = None,\n    ) -> ValidationResult:\n        \"\"\"Like validate(), but pre-existing test failures are ignored.\n\n        If baseline_failures is None or empty, behaves identically to validate().\n        \"\"\"\n        if not baseline_failures:\n            return self.validate(working_dir)\n\n        cwd = working_dir or self.config.target_dir\n        vc = self.config.validation\n        steps: List[ValidationStep] = []\n\n        # Run lint first\n        lint_step = self._run_command(\"lint\", vc.lint_command, vc.lint_timeout, cwd)\n        steps.append(lint_step)\n        if not lint_step.passed and vc.lint_command.strip():\n            logger.warning(\"lint failed (rc=%d)\", lint_step.return_code)\n            return ValidationResult(passed=False, steps=steps)\n\n        # Run tests — strip -x when baseline is active so all failures are visible\n        test_cmd = vc.test_command\n        if baseline_failures and \" -x \" in f\" {test_cmd} \":\n            test_cmd = test_cmd.replace(\" -x \", \" \").replace(\" -x\", \"\").strip()\n            logger.debug(\"Removed -x from test command for baseline comparison\")\n        test_step = self._run_command(\"tests\", test_cmd, vc.test_timeout, cwd)\n        if test_step.passed:\n            steps.append(test_step)\n        else:\n            # Parse current failures and subtract baseline\n            current_failures = set(self._FAILED_LINE_RE.findall(test_step.output))\n\n            if not current_failures:\n                # Tests failed but we couldn't parse any FAILED lines —\n                # could be a collection error, import error, segfault, etc.\n                # Treat as a genuine failure rather than silently passing.\n                logger.warning(\n                    \"Tests failed (rc=%d) but no FAILED lines parsed, \"\n                    \"treating as genuine failure\",\n                    test_step.return_code,\n                )\n                steps.append(test_step)\n                return ValidationResult(passed=False, steps=steps)\n\n            new_failures = current_failures - baseline_failures\n            ignored = current_failures & baseline_failures\n\n            if ignored:\n                logger.warning(\n                    \"Ignoring %d pre-existing test failure(s): %s\",\n                    len(ignored), sorted(ignored),\n                )\n\n            if new_failures:\n                # Real new failures — report as FAIL\n                logger.warning(\n                    \"New test failures (not in baseline): %s\",\n                    sorted(new_failures),\n                )\n                steps.append(test_step)\n                return ValidationResult(passed=False, steps=steps)\n            else:\n                # All failures are pre-existing — treat as PASS\n                logger.info(\n                    \"All %d test failure(s) are pre-existing, treating tests as passed\",\n                    len(current_failures),\n                )\n                steps.append(ValidationStep(\n                    name=\"tests\",\n                    command=test_step.command,\n                    passed=True,\n                    output=test_step.output,\n                    return_code=test_step.return_code,\n                ))\n\n        # Run build\n        build_step = self._run_command(\"build\", vc.build_command, vc.build_timeout, cwd)\n        steps.append(build_step)\n        if not build_step.passed and vc.build_command.strip():\n            logger.warning(\"build failed (rc=%d)\", build_step.return_code)\n            return ValidationResult(passed=False, steps=steps)\n\n        return ValidationResult(passed=True, steps=steps)\n\n    def _map_changed_to_test_files(\n        self, changed_files: List[str], working_dir: str,\n    ) -> List[str]:\n        \"\"\"Map changed .py files to their likely test files.\n\n        For each changed file like `foo.py`, looks for `test_foo.py` or\n        `tests/test_foo.py`. Also includes any changed test files directly.\n        Returns test file paths relative to working_dir.\n        \"\"\"\n        test_files = []\n        wd = Path(working_dir)\n\n        for f in changed_files:\n            if not f.endswith(\".py\"):\n                continue\n\n            p = Path(f)\n            basename = p.stem  # e.g., \"foo\" from \"foo.py\"\n\n            # If it's already a test file, include it directly\n            if basename.startswith(\"test_\"):\n                if (wd / f).exists():\n                    test_files.append(f)\n                continue\n\n            # Look for test_<basename>.py in common locations\n            candidates = [\n                p.parent / f\"test_{basename}.py\",\n                Path(\"tests\") / f\"test_{basename}.py\",\n                Path(\"test\") / f\"test_{basename}.py\",\n            ]\n\n            for candidate in candidates:\n                full = wd / candidate\n                if full.exists():\n                    test_files.append(str(candidate))\n                    break\n\n        return list(set(test_files))\n\n    def validate_incremental(\n        self, working_dir: str, changed_files: List[str],\n    ) -> ValidationResult:\n        \"\"\"Run targeted tests for changed files, then full suite on success.\n\n        1. Maps changed files to test files.\n        2. Runs only those tests first (fast feedback).\n        3. If targeted tests pass, runs the full test suite as final check.\n        4. Falls back to full validation if no test files can be mapped.\n        \"\"\"\n        cwd = working_dir or self.config.target_dir\n        vc = self.config.validation\n\n        if not vc.test_command.strip():\n            return self.validate(working_dir)\n\n        test_files = self._map_changed_to_test_files(changed_files, cwd)\n        if not test_files:\n            # Can't determine affected tests, fall back to full suite\n            return self.validate(working_dir)\n\n        # Phase 1: Run targeted tests\n        targeted_cmd = f\"python3 -m pytest {' '.join(shlex.quote(f) for f in test_files)} -x -q\"\n        steps: List[ValidationStep] = []\n\n        # Run lint first\n        lint_step = self._run_command(\"lint\", vc.lint_command, vc.lint_timeout, cwd)\n        steps.append(lint_step)\n        if not lint_step.passed and vc.lint_command.strip():\n            return ValidationResult(passed=False, steps=steps)\n\n        # Run targeted tests\n        targeted_step = self._run_command(\n            \"tests (targeted)\", targeted_cmd, vc.test_timeout, cwd,\n        )\n        steps.append(targeted_step)\n        if not targeted_step.passed:\n            return ValidationResult(passed=False, steps=steps)\n\n        # Phase 2: Run full test suite to catch regressions\n        full_step = self._run_command(\n            \"tests (full)\", vc.test_command, vc.test_timeout, cwd,\n        )\n        steps.append(full_step)\n        if not full_step.passed:\n            return ValidationResult(passed=False, steps=steps)\n\n        # Run build\n        build_step = self._run_command(\"build\", vc.build_command, vc.build_timeout, cwd)\n        steps.append(build_step)\n        if not build_step.passed and vc.build_command.strip():\n            return ValidationResult(passed=False, steps=steps)\n\n        return ValidationResult(passed=True, steps=steps)\n","numLines":333,"startLine":1,"totalLines":333}}}
