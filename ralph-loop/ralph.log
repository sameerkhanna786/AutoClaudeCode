{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_vrtx_01LjfyRGcnmbRF3A7vMAVsHh","type":"tool_result","content":"     1→\"\"\"Invoke the Claude CLI and parse JSON responses.\"\"\"\n     2→\n     3→from __future__ import annotations\n     4→\n     5→import json\n     6→import logging\n     7→import os\n     8→import signal\n     9→import subprocess\n    10→import threading\n    11→import time\n    12→from dataclasses import dataclass, field\n    13→from pathlib import Path\n    14→from typing import Any, Callable, Dict, List, Optional\n    15→\n    16→from config_schema import Config\n    17→from process_utils import kill_process_group\n    18→\n    19→logger = logging.getLogger(__name__)\n    20→\n    21→# Circuit breaker defaults\n    22→CB_FAILURE_THRESHOLD = 5  # consecutive failures before opening\n    23→CB_RECOVERY_TIMEOUT = 300  # seconds to wait before half-open\n    24→CB_HALF_OPEN_MAX_CALLS = 1  # max calls allowed in half-open state\n    25→\n    26→# Default context window size for token usage percentage calculation\n    27→_DEFAULT_CONTEXT_WINDOW = 200_000\n    28→\n    29→# Stderr patterns that count toward circuit breaker (rate limits, server errors)\n    30→_CB_ERROR_PATTERNS = (\n    31→    \"rate limit\",\n    32→    \"429\",\n    33→    \"too many requests\",\n    34→    \"500\",\n    35→    \"502\",\n    36→    \"503\",\n    37→    \"504\",\n    38→    \"internal server error\",\n    39→    \"bad gateway\",\n    40→    \"service unavailable\",\n    41→    \"gateway timeout\",\n    42→    \"overloaded\",\n    43→    \"server error\",\n    44→)\n    45→\n    46→\n    47→class CircuitBreaker:\n    48→    \"\"\"Circuit breaker to temporarily disable API calls after repeated failures.\n    49→\n    50→    States:\n    51→      - CLOSED: normal operation, calls are allowed\n    52→      - OPEN: calls are blocked, returns failure immediately\n    53→      - HALF_OPEN: allows a limited number of probe calls to test recovery\n    54→\n    55→    Thread-safe via a threading.Lock.\n    56→    \"\"\"\n    57→\n    58→    STATE_CLOSED = \"closed\"\n    59→    STATE_OPEN = \"open\"\n    60→    STATE_HALF_OPEN = \"half_open\"\n    61→\n    62→    def __init__(\n    63→        self,\n    64→        failure_threshold: int = CB_FAILURE_THRESHOLD,\n    65→        recovery_timeout: float = CB_RECOVERY_TIMEOUT,\n    66→        half_open_max_calls: int = CB_HALF_OPEN_MAX_CALLS,\n    67→        on_open: Optional[Callable[[int, float], None]] = None,\n    68→        max_recovery_timeout: float = 0,\n    69→        jitter_factor: float = 0.25,\n    70→    ):\n    71→        self.failure_threshold = failure_threshold\n    72→        self.recovery_timeout = recovery_timeout\n    73→        self._base_recovery_timeout = recovery_timeout\n    74→        self._max_recovery_timeout = max_recovery_timeout if max_recovery_timeout > 0 else recovery_timeout * 4\n    75→        self._jitter_factor = jitter_factor\n    76→        self._open_count = 0\n    77→        self.half_open_max_calls = half_open_max_calls\n    78→        self._on_open = on_open\n    79→        self._state = self.STATE_CLOSED\n    80→        self._consecutive_failures = 0\n    81→        self._opened_at: float = 0.0\n    82→        self._half_open_calls = 0\n    83→        self._lock = threading.Lock()\n    84→\n    85→    @property\n    86→    def state(self) -> str:\n    87→        with self._lock:\n    88→            return self._get_state()\n    89→\n    90→    def _get_state(self) -> str:\n    91→        \"\"\"Return current state, transitioning OPEN -> HALF_OPEN if recovery timeout elapsed.\"\"\"\n    92→        if self._state == self.STATE_OPEN:\n    93→            if time.monotonic() - self._opened_at >= self.recovery_timeout:\n    94→                self._state = self.STATE_HALF_OPEN\n    95→                self._half_open_calls = 0\n    96→                logger.info(\n    97→                    \"Circuit breaker transitioning from OPEN to HALF_OPEN \"\n    98→                    \"after %.0fs recovery timeout\",\n    99→                    self.recovery_timeout,\n   100→                )\n   101→        return self._state\n   102→\n   103→    def _compute_recovery_timeout(self) -> float:\n   104→        \"\"\"Compute recovery timeout with exponential backoff and jitter.\n   105→\n   106→        Each time the circuit breaker opens, the recovery timeout increases\n   107→        exponentially (base * 2^open_count) up to a maximum. Random jitter\n   108→        is added to prevent thundering herd when multiple workers recover\n   109→        simultaneously.\n   110→        \"\"\"\n   111→        import random\n   112→        # Exponential backoff: base * 2^(open_count - 1), capped at max\n   113→        # First open uses base timeout (2^0=1x), subsequent re-opens escalate\n   114→        exponent = max(0, self._open_count - 1)\n   115→        backoff = min(\n   116→            self._base_recovery_timeout * (2 ** exponent),\n   117→            self._max_recovery_timeout,\n   118→        )\n   119→        # Add jitter: +/- jitter_factor of the backoff value\n   120→        jitter = backoff * self._jitter_factor * (2 * random.random() - 1)\n   121→        return max(self._base_recovery_timeout, backoff + jitter)\n   122→\n   123→    def allow_request(self) -> bool:\n   124→        \"\"\"Check if a request is allowed through the circuit breaker.\"\"\"\n   125→        with self._lock:\n   126→            state = self._get_state()\n   127→            if state == self.STATE_CLOSED:\n   128→                return True\n   129→            if state == self.STATE_HALF_OPEN:\n   130→                if self._half_open_calls < self.half_open_max_calls:\n   131→                    self._half_open_calls += 1\n   132→                    return True\n   133→                return False\n   134→            # STATE_OPEN\n   135→            return False\n   136→\n   137→    def record_success(self) -> None:\n   138→        \"\"\"Record a successful call — resets the circuit breaker to CLOSED.\"\"\"\n   139→        with self._lock:\n   140→            if self._state != self.STATE_CLOSED:\n   141→                logger.info(\n   142→                    \"Circuit breaker resetting to CLOSED after successful call \"\n   143→                    \"(was %s, had %d consecutive failures)\",\n   144→                    self._state, self._consecutive_failures,\n   145→                )\n   146→            self._consecutive_failures = 0\n   147→            self._state = self.STATE_CLOSED\n   148→            self._half_open_calls = 0\n   149→            self._open_count = 0\n   150→            self.recovery_timeout = self._base_recovery_timeout\n   151→\n   152→    def record_failure(self) -> None:\n   153→        \"\"\"Record a failed call — may trip the circuit breaker to OPEN.\"\"\"\n   154→        notify = False\n   155→        with self._lock:\n   156→            self._consecutive_failures += 1\n   157→            if self._state == self.STATE_HALF_OPEN:\n   158→                # Failed during probe — re-open\n   159→                self._open_count += 1\n   160→                self.recovery_timeout = self._compute_recovery_timeout()\n   161→                self._state = self.STATE_OPEN\n   162→                self._opened_at = time.monotonic()\n   163→                notify = True\n   164→                logger.warning(\n   165→                    \"Circuit breaker re-opening after failed probe call \"\n   166→                    \"(%d consecutive failures, recovery_timeout=%.0fs)\",\n   167→                    self._consecutive_failures, self.recovery_timeout,\n   168→                )\n   169→            elif (\n   170→                self._state == self.STATE_CLOSED\n   171→                and self._consecutive_failures >= self.failure_threshold\n   172→            ):\n   173→                self._open_count += 1\n   174→                self.recovery_timeout = self._compute_recovery_timeout()\n   175→                self._state = self.STATE_OPEN\n   176→                self._opened_at = time.monotonic()\n   177→                notify = True\n   178→                logger.warning(\n   179→                    \"Circuit breaker OPEN after %d consecutive failures. \"\n   180→                    \"API calls blocked for %.0fs (backoff level %d).\",\n   181→                    self._consecutive_failures, self.recovery_timeout,\n   182→                    self._open_count,\n   183→                )\n   184→        # Fire notification callback outside the lock to avoid deadlocks\n   185→        if notify and self._on_open is not None:\n   186→            try:\n   187→                self._on_open(self._consecutive_failures, self.recovery_timeout)\n   188→            except Exception:\n   189→                logger.debug(\"Circuit breaker on_open callback raised\", exc_info=True)\n   190→\n   191→    def reset(self) -> None:\n   192→        \"\"\"Manually reset the circuit breaker to CLOSED state.\"\"\"\n   193→        with self._lock:\n   194→            self._state = self.STATE_CLOSED\n   195→            self._consecutive_failures = 0\n   196→            self._half_open_calls = 0\n   197→            self._open_count = 0\n   198→            self.recovery_timeout = self._base_recovery_timeout\n   199→\n   200→\n   201→@dataclass\n   202→class ClaudeResult:\n   203→    success: bool\n   204→    result_text: str = \"\"\n   205→    cost_usd: float = 0.0\n   206→    duration_seconds: float = 0.0\n   207→    raw_json: Optional[Dict[str, Any]] = None\n   208→    error: str = \"\"\n   209→    input_tokens: int = 0\n   210→    output_tokens: int = 0\n   211→    context_window_pct: float = 0.0\n   212→\n   213→\n   214→class ClaudeRunner:\n   215→\n   216→    def __init__(self, config: Config):\n   217→        self.config = config\n   218→        self.max_retries = config.claude.max_retries\n   219→        self.retry_delays = config.claude.retry_delays\n   220→        self.rate_limit_base_delay = config.claude.rate_limit_base_delay\n   221→        self.rate_limit_multiplier = config.claude.rate_limit_multiplier\n   222→        self._current_process: subprocess.Popen | None = None\n   223→        self._process_lock = threading.Lock()\n   224→        self._terminated = False  # Set by terminate() to stop retry loop\n   225→        self.circuit_breaker = CircuitBreaker(\n   226→            on_open=self._on_circuit_breaker_open,\n   227→        )\n   228→\n   229→    def _build_command(self, prompt: str) -> List[str]:\n   230→        \"\"\"Build the CLI command list.\"\"\"\n   231→        cc = self.config.claude\n   232→        model = cc.resolved_model or cc.model\n   233→        cmd = [\n   234→            cc.command,\n   235→            \"-p\", prompt,\n   236→            \"--model\", model,\n   237→            \"--max-turns\", str(cc.max_turns),\n   238→            \"--output-format\", \"json\",\n   239→        ]\n   240→        return cmd\n   241→\n   242→    def _on_circuit_breaker_open(self, failures: int, recovery_timeout: float) -> None:\n   243→        \"\"\"Notification callback invoked when the circuit breaker opens.\n   244→\n   245→        Writes a notification file to the state directory so external\n   246→        monitoring tools and users can detect the outage.\n   247→        \"\"\"\n   248→        import datetime as dt\n   249→        state_dir = Path(self.config.paths.state_dir)\n   250→        state_dir.mkdir(parents=True, exist_ok=True)\n   251→        notification_file = state_dir / \"circuit_breaker_open\"\n   252→        try:\n   253→            notification_file.write_text(\n   254→                f\"Circuit breaker OPEN\\n\"\n   255→                f\"Timestamp: {dt.datetime.now(dt.timezone.utc).isoformat()}\\n\"\n   256→                f\"Consecutive failures: {failures}\\n\"\n   257→                f\"Recovery timeout: {recovery_timeout}s\\n\"\n   258→                f\"API calls are blocked until recovery.\\n\"\n   259→            )\n   260→            logger.warning(\n   261→                \"Circuit breaker notification written to %s\",\n   262→                notification_file,\n   263→            )\n   264→        except OSError as e:\n   265→            logger.debug(\"Failed to write circuit breaker notification: %s\", e)\n   266→\n   267→    @staticmethod\n   268→    def _kill_process(proc: subprocess.Popen) -> None:\n   269→        \"\"\"Kill a subprocess and its entire process group.\"\"\"\n   270→        kill_process_group(proc)\n   271→\n   272→    @staticmethod\n   273→    def _is_circuit_breaker_error(stderr: str) -> bool:\n   274→        \"\"\"Check if stderr indicates a rate limit or server error.\"\"\"\n   275→        stderr_lower = stderr.lower()\n   276→        return any(pat in stderr_lower for pat in _CB_ERROR_PATTERNS)\n   277→\n   278→    def terminate(self) -> None:\n   279→        \"\"\"Terminate any currently running Claude subprocess.\n   280→\n   281→        Thread-safe: can be called from a different thread than the one\n   282→        executing run().  Also sets _terminated to prevent the retry loop\n   283→        from spawning new processes after the kill.\n   284→        \"\"\"\n   285→        self._terminated = True\n   286→        with self._process_lock:\n   287→            proc = self._current_process\n   288→        if proc is not None:\n   289→            logger.warning(\"Terminating running Claude subprocess (pid=%s)\", proc.pid)\n   290→            self._kill_process(proc)\n   291→\n   292→    def _parse_json_response(self, stdout: str) -> Dict[str, Any]:\n   293→        \"\"\"Parse JSON from Claude CLI output.\n   294→\n   295→        The CLI may print banner/info lines before the actual JSON,\n   296→        and log/warning lines after it. We extract only the first\n   297→        valid top-level JSON object.\n   298→        \"\"\"\n   299→        if not stdout or not stdout.strip():\n   300→            raise ValueError(\"Claude CLI produced empty output (no JSON to parse)\")\n   301→\n   302→        # Strategy 1a: Try each line as a complete JSON object starting with '{'.\n   303→        # This handles the common case where the JSON is on its own line.\n   304→        for line in stdout.splitlines():\n   305→            line = line.strip()\n   306→            if not line or not line.startswith(\"{\"):\n   307→                continue\n   308→            try:\n   309→                obj = json.loads(line)\n   310→                if isinstance(obj, dict):\n   311→                    return obj\n   312→            except json.JSONDecodeError:\n   313→                pass\n   314→\n   315→        # Strategy 1b: Try finding JSON mid-line (preceded by text on the same line).\n   316→        for line in stdout.splitlines():\n   317→            line = line.strip()\n   318→            brace_pos = line.find(\"{\")\n   319→            if brace_pos <= 0:\n   320→                continue\n   321→            # Try from each '{' position after the start of the line\n   322→            while brace_pos != -1:\n   323→                candidate = line[brace_pos:]\n   324→                try:\n   325→                    obj = json.loads(candidate)\n   326→                    if isinstance(obj, dict):\n   327→                        return obj\n   328→                except json.JSONDecodeError:\n   329→                    pass\n   330→                brace_pos = line.find(\"{\", brace_pos + 1)\n   331→\n   332→        # Strategy 2: Fall back to raw_decode for multi-line JSON.\n   333→        # Try parsing from any '{' position to handle JSON starting mid-line.\n   334→        decoder = json.JSONDecoder()\n   335→        for i, ch in enumerate(stdout):\n   336→            if ch != \"{\":\n   337→                continue\n   338→            try:\n   339→                obj, end = decoder.raw_decode(stdout, i)\n   340→                if isinstance(obj, dict):\n   341→                    return obj\n   342→            except json.JSONDecodeError:\n   343→                pass\n   344→\n   345→        raise ValueError(\"No JSON object found in Claude CLI output\")\n   346→\n   347→    def run(self, prompt: str,\n   348→            add_dirs: Optional[List[str]] = None) -> ClaudeResult:\n   349→        \"\"\"Run Claude CLI with the given prompt and return parsed result.\"\"\"\n   350→        self._terminated = False  # Reset on each new run\n   351→        cmd = self._build_command(prompt)\n   352→        # Always use the main project dir as cwd (macOS sandbox restriction:\n   353→        # sandbox_apply fails with exit 71 when cwd is outside the project).\n   354→        cwd = self.config.target_dir\n   355→        if add_dirs:\n   356→            for d in add_dirs:\n   357→                cmd.extend([\"--add-dir\", str(Path(d).resolve())])\n   358→\n   359→        logger.info(\"Running Claude CLI in %s\", cwd)\n   360→        logger.debug(\"Command: %s\", \" \".join(cmd))\n   361→\n   362→        # Check circuit breaker before attempting the call\n   363→        if not self.circuit_breaker.allow_request():\n   364→            logger.warning(\n   365→                \"Circuit breaker is OPEN — blocking Claude API call to prevent \"\n   366→                \"further cost accumulation\"\n   367→            )\n   368→            return ClaudeResult(\n   369→                success=False,\n   370→                error=\"Circuit breaker is open: too many consecutive API failures. \"\n   371→                      \"Will automatically retry after recovery timeout.\",\n   372→            )\n   373→\n   374→        for attempt in range(self.max_retries + 1):\n   375→            # If terminate() was called (e.g. signal handler), stop retrying\n   376→            if self._terminated:\n   377→                return ClaudeResult(\n   378→                    success=False,\n   379→                    error=\"Terminated by signal — aborting retries\",\n   380→                )\n   381→            try:\n   382→                popen_proc = subprocess.Popen(\n   383→                    cmd,\n   384→                    cwd=cwd,\n   385→                    stdout=subprocess.PIPE,\n   386→                    stderr=subprocess.PIPE,\n   387→                    text=True,\n   388→                    start_new_session=True,\n   389→                )\n   390→                with self._process_lock:\n   391→                    self._current_process = popen_proc\n   392→                try:\n   393→                    stdout, stderr = popen_proc.communicate(\n   394→                        timeout=self.config.claude.timeout_seconds,\n   395→                    )\n   396→                except subprocess.TimeoutExpired:\n   397→                    self._kill_process(popen_proc)\n   398→                    raise\n   399→                finally:\n   400→                    with self._process_lock:\n   401→                        self._current_process = None\n   402→\n   403→                # Build a CompletedProcess-like namespace for downstream code\n   404→                class _ProcResult:\n   405→                    pass\n   406→                proc = _ProcResult()\n   407→                proc.returncode = popen_proc.returncode\n   408→                proc.stdout = stdout\n   409→                proc.stderr = stderr\n   410→            except subprocess.TimeoutExpired:\n   411→                if attempt < self.max_retries:\n   412→                    delay = self.retry_delays[min(attempt, len(self.retry_delays) - 1)]\n   413→                    logger.warning(\n   414→                        \"Claude CLI timed out (attempt %d/%d), retrying in %ds\",\n   415→                        attempt + 1, self.max_retries + 1, delay,\n   416→                    )\n   417→                    time.sleep(delay)\n   418→                    continue\n   419→                self.circuit_breaker.record_failure()\n   420→                return ClaudeResult(\n   421→                    success=False,\n   422→                    error=f\"Claude CLI timed out after {self.config.claude.timeout_seconds}s\",\n   423→                )\n   424→            except FileNotFoundError:\n   425→                return ClaudeResult(\n   426→                    success=False,\n   427→                    error=f\"Claude CLI command not found: {self.config.claude.command}\",\n   428→                )\n   429→            except OSError as e:\n   430→                if attempt < self.max_retries:\n   431→                    delay = self.retry_delays[min(attempt, len(self.retry_delays) - 1)]\n   432→                    logger.warning(\n   433→                        \"Claude CLI OS error (attempt %d/%d): %s, retrying in %ds\",\n   434→                        attempt + 1, self.max_retries + 1, e, delay,\n   435→                    )\n   436→                    time.sleep(delay)\n   437→                    continue\n   438→                return ClaudeResult(\n   439→                    success=False,\n   440→                    error=f\"Failed to run Claude CLI: {e}\",\n   441→                )\n   442→\n   443→            if proc.returncode != 0:\n   444→                if attempt < self.max_retries:\n   445→                    stderr_lower = proc.stderr.lower()\n   446→                    if \"rate limit\" in stderr_lower or \"429\" in stderr_lower or \"too many requests\" in stderr_lower:\n   447→                        delay = self.rate_limit_base_delay * (self.rate_limit_multiplier ** attempt)\n   448→                        logger.warning(\n   449→                            \"Rate limited (attempt %d/%d), backing off %ds\",\n   450→                            attempt + 1, self.max_retries + 1, delay,\n   451→                        )\n   452→                    else:\n   453→                        delay = self.retry_delays[min(attempt, len(self.retry_delays) - 1)]\n   454→                        logger.warning(\n   455→                            \"Claude CLI exited with code %d (attempt %d/%d), retrying in %ds\",\n   456→                            proc.returncode, attempt + 1, self.max_retries + 1, delay,\n   457→                        )\n   458→                    time.sleep(delay)\n   459→                    continue\n   460→                # All retries exhausted — update circuit breaker if the error\n   461→                # matches rate-limit or server-error patterns.\n   462→                if self._is_circuit_breaker_error(proc.stderr):\n   463→                    self.circuit_breaker.record_failure()\n   464→                return ClaudeResult(\n   465→                    success=False,\n   466→                    error=f\"Claude CLI exited with code {proc.returncode}: {proc.stderr.strip()}\",\n   467→                )\n   468→\n   469→            # Parse JSON before exiting the loop — retry on truncated output\n   470→            try:\n   471→                data = self._parse_json_response(proc.stdout)\n   472→            except (ValueError, json.JSONDecodeError) as e:\n   473→                stdout_stripped = proc.stdout.strip()\n   474→                looks_truncated = \"{\" in stdout_stripped and not stdout_stripped.endswith(\"}\")\n   475→                if looks_truncated and attempt < self.max_retries:\n   476→                    delay = self.retry_delays[min(attempt, len(self.retry_delays) - 1)]\n   477→                    logger.warning(\n   478→                        \"Output appears truncated (attempt %d/%d), retrying in %ds\",\n   479→                        attempt + 1, self.max_retries + 1, delay,\n   480→                    )\n   481→                    time.sleep(delay)\n   482→                    continue\n   483→                return ClaudeResult(\n   484→                    success=False,\n   485→                    error=f\"Failed to parse Claude CLI output: {e}\",\n   486→                    result_text=proc.stdout,\n   487→                )\n   488→\n   489→            break  # successful parse — exit retry loop\n   490→\n   491→        # Successful API call — reset circuit breaker\n   492→        self.circuit_breaker.record_success()\n   493→\n   494→        if \"result\" not in data:\n   495→            logger.warning(\n   496→                \"Claude CLI JSON response missing 'result' field; \"\n   497→                \"keys present: %s\", sorted(data.keys()),\n   498→            )\n   499→\n   500→        result_text = data.get(\"result\", \"\")\n   501→        cost_usd = data.get(\"total_cost_usd\", data.get(\"cost_usd\", 0.0))\n   502→        duration_ms = data.get(\"duration_ms\", 0)\n   503→        duration = duration_ms / 1000.0 if duration_ms else data.get(\"duration_seconds\", 0.0)\n   504→\n   505→        # Extract token usage for context window tracking\n   506→        usage = data.get(\"usage\", {})\n   507→        input_tokens = usage.get(\"input_tokens\", 0)\n   508→        output_tokens = usage.get(\"output_tokens\", 0)\n   509→        total_tokens = input_tokens + output_tokens\n   510→        context_window_pct = (total_tokens / _DEFAULT_CONTEXT_WINDOW) * 100 if total_tokens else 0.0\n   511→\n   512→        # Detect error_max_turns: Claude ran out of turns before producing\n   513→        # a final result.  Still return success=True because the subprocess\n   514→        # completed normally and may have made useful file changes, but\n   515→        # include a warning in the error field so callers can decide whether\n   516→        # to trust result_text (which may be empty).\n   517→        error_msg = \"\"\n   518→        subtype = data.get(\"subtype\", \"\")\n   519→        if subtype == \"error_max_turns\":\n   520→            error_msg = \"Claude hit max_turns without producing a final result\"\n   521→            logger.warning(\n   522→                \"Claude hit max_turns (%s); result_text may be empty or incomplete\",\n   523→                self.config.claude.max_turns,\n   524→            )\n   525→\n   526→        return ClaudeResult(\n   527→            success=True,\n   528→            result_text=result_text,\n   529→            cost_usd=cost_usd,\n   530→            duration_seconds=duration,\n   531→            raw_json=data,\n   532→            error=error_msg,\n   533→            input_tokens=input_tokens,\n   534→            output_tokens=output_tokens,\n   535→            context_window_pct=context_window_pct,\n   536→        )\n   537→"}]},"parent_tool_use_id":null,"session_id":"c76965ae-1578-455c-93ed-be9aaeaa84e9","uuid":"547ac653-d5bd-4c1b-9f8d-8f469add8f36","tool_use_result":{"type":"text","file":{"filePath":"/Users/sameertkhanna/Documents/auto_claude_code/claude_runner.py","content":"\"\"\"Invoke the Claude CLI and parse JSON responses.\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport logging\nimport os\nimport signal\nimport subprocess\nimport threading\nimport time\nfrom dataclasses import dataclass, field\nfrom pathlib import Path\nfrom typing import Any, Callable, Dict, List, Optional\n\nfrom config_schema import Config\nfrom process_utils import kill_process_group\n\nlogger = logging.getLogger(__name__)\n\n# Circuit breaker defaults\nCB_FAILURE_THRESHOLD = 5  # consecutive failures before opening\nCB_RECOVERY_TIMEOUT = 300  # seconds to wait before half-open\nCB_HALF_OPEN_MAX_CALLS = 1  # max calls allowed in half-open state\n\n# Default context window size for token usage percentage calculation\n_DEFAULT_CONTEXT_WINDOW = 200_000\n\n# Stderr patterns that count toward circuit breaker (rate limits, server errors)\n_CB_ERROR_PATTERNS = (\n    \"rate limit\",\n    \"429\",\n    \"too many requests\",\n    \"500\",\n    \"502\",\n    \"503\",\n    \"504\",\n    \"internal server error\",\n    \"bad gateway\",\n    \"service unavailable\",\n    \"gateway timeout\",\n    \"overloaded\",\n    \"server error\",\n)\n\n\nclass CircuitBreaker:\n    \"\"\"Circuit breaker to temporarily disable API calls after repeated failures.\n\n    States:\n      - CLOSED: normal operation, calls are allowed\n      - OPEN: calls are blocked, returns failure immediately\n      - HALF_OPEN: allows a limited number of probe calls to test recovery\n\n    Thread-safe via a threading.Lock.\n    \"\"\"\n\n    STATE_CLOSED = \"closed\"\n    STATE_OPEN = \"open\"\n    STATE_HALF_OPEN = \"half_open\"\n\n    def __init__(\n        self,\n        failure_threshold: int = CB_FAILURE_THRESHOLD,\n        recovery_timeout: float = CB_RECOVERY_TIMEOUT,\n        half_open_max_calls: int = CB_HALF_OPEN_MAX_CALLS,\n        on_open: Optional[Callable[[int, float], None]] = None,\n        max_recovery_timeout: float = 0,\n        jitter_factor: float = 0.25,\n    ):\n        self.failure_threshold = failure_threshold\n        self.recovery_timeout = recovery_timeout\n        self._base_recovery_timeout = recovery_timeout\n        self._max_recovery_timeout = max_recovery_timeout if max_recovery_timeout > 0 else recovery_timeout * 4\n        self._jitter_factor = jitter_factor\n        self._open_count = 0\n        self.half_open_max_calls = half_open_max_calls\n        self._on_open = on_open\n        self._state = self.STATE_CLOSED\n        self._consecutive_failures = 0\n        self._opened_at: float = 0.0\n        self._half_open_calls = 0\n        self._lock = threading.Lock()\n\n    @property\n    def state(self) -> str:\n        with self._lock:\n            return self._get_state()\n\n    def _get_state(self) -> str:\n        \"\"\"Return current state, transitioning OPEN -> HALF_OPEN if recovery timeout elapsed.\"\"\"\n        if self._state == self.STATE_OPEN:\n            if time.monotonic() - self._opened_at >= self.recovery_timeout:\n                self._state = self.STATE_HALF_OPEN\n                self._half_open_calls = 0\n                logger.info(\n                    \"Circuit breaker transitioning from OPEN to HALF_OPEN \"\n                    \"after %.0fs recovery timeout\",\n                    self.recovery_timeout,\n                )\n        return self._state\n\n    def _compute_recovery_timeout(self) -> float:\n        \"\"\"Compute recovery timeout with exponential backoff and jitter.\n\n        Each time the circuit breaker opens, the recovery timeout increases\n        exponentially (base * 2^open_count) up to a maximum. Random jitter\n        is added to prevent thundering herd when multiple workers recover\n        simultaneously.\n        \"\"\"\n        import random\n        # Exponential backoff: base * 2^(open_count - 1), capped at max\n        # First open uses base timeout (2^0=1x), subsequent re-opens escalate\n        exponent = max(0, self._open_count - 1)\n        backoff = min(\n            self._base_recovery_timeout * (2 ** exponent),\n            self._max_recovery_timeout,\n        )\n        # Add jitter: +/- jitter_factor of the backoff value\n        jitter = backoff * self._jitter_factor * (2 * random.random() - 1)\n        return max(self._base_recovery_timeout, backoff + jitter)\n\n    def allow_request(self) -> bool:\n        \"\"\"Check if a request is allowed through the circuit breaker.\"\"\"\n        with self._lock:\n            state = self._get_state()\n            if state == self.STATE_CLOSED:\n                return True\n            if state == self.STATE_HALF_OPEN:\n                if self._half_open_calls < self.half_open_max_calls:\n                    self._half_open_calls += 1\n                    return True\n                return False\n            # STATE_OPEN\n            return False\n\n    def record_success(self) -> None:\n        \"\"\"Record a successful call — resets the circuit breaker to CLOSED.\"\"\"\n        with self._lock:\n            if self._state != self.STATE_CLOSED:\n                logger.info(\n                    \"Circuit breaker resetting to CLOSED after successful call \"\n                    \"(was %s, had %d consecutive failures)\",\n                    self._state, self._consecutive_failures,\n                )\n            self._consecutive_failures = 0\n            self._state = self.STATE_CLOSED\n            self._half_open_calls = 0\n            self._open_count = 0\n            self.recovery_timeout = self._base_recovery_timeout\n\n    def record_failure(self) -> None:\n        \"\"\"Record a failed call — may trip the circuit breaker to OPEN.\"\"\"\n        notify = False\n        with self._lock:\n            self._consecutive_failures += 1\n            if self._state == self.STATE_HALF_OPEN:\n                # Failed during probe — re-open\n                self._open_count += 1\n                self.recovery_timeout = self._compute_recovery_timeout()\n                self._state = self.STATE_OPEN\n                self._opened_at = time.monotonic()\n                notify = True\n                logger.warning(\n                    \"Circuit breaker re-opening after failed probe call \"\n                    \"(%d consecutive failures, recovery_timeout=%.0fs)\",\n                    self._consecutive_failures, self.recovery_timeout,\n                )\n            elif (\n                self._state == self.STATE_CLOSED\n                and self._consecutive_failures >= self.failure_threshold\n            ):\n                self._open_count += 1\n                self.recovery_timeout = self._compute_recovery_timeout()\n                self._state = self.STATE_OPEN\n                self._opened_at = time.monotonic()\n                notify = True\n                logger.warning(\n                    \"Circuit breaker OPEN after %d consecutive failures. \"\n                    \"API calls blocked for %.0fs (backoff level %d).\",\n                    self._consecutive_failures, self.recovery_timeout,\n                    self._open_count,\n                )\n        # Fire notification callback outside the lock to avoid deadlocks\n        if notify and self._on_open is not None:\n            try:\n                self._on_open(self._consecutive_failures, self.recovery_timeout)\n            except Exception:\n                logger.debug(\"Circuit breaker on_open callback raised\", exc_info=True)\n\n    def reset(self) -> None:\n        \"\"\"Manually reset the circuit breaker to CLOSED state.\"\"\"\n        with self._lock:\n            self._state = self.STATE_CLOSED\n            self._consecutive_failures = 0\n            self._half_open_calls = 0\n            self._open_count = 0\n            self.recovery_timeout = self._base_recovery_timeout\n\n\n@dataclass\nclass ClaudeResult:\n    success: bool\n    result_text: str = \"\"\n    cost_usd: float = 0.0\n    duration_seconds: float = 0.0\n    raw_json: Optional[Dict[str, Any]] = None\n    error: str = \"\"\n    input_tokens: int = 0\n    output_tokens: int = 0\n    context_window_pct: float = 0.0\n\n\nclass ClaudeRunner:\n\n    def __init__(self, config: Config):\n        self.config = config\n        self.max_retries = config.claude.max_retries\n        self.retry_delays = config.claude.retry_delays\n        self.rate_limit_base_delay = config.claude.rate_limit_base_delay\n        self.rate_limit_multiplier = config.claude.rate_limit_multiplier\n        self._current_process: subprocess.Popen | None = None\n        self._process_lock = threading.Lock()\n        self._terminated = False  # Set by terminate() to stop retry loop\n        self.circuit_breaker = CircuitBreaker(\n            on_open=self._on_circuit_breaker_open,\n        )\n\n    def _build_command(self, prompt: str) -> List[str]:\n        \"\"\"Build the CLI command list.\"\"\"\n        cc = self.config.claude\n        model = cc.resolved_model or cc.model\n        cmd = [\n            cc.command,\n            \"-p\", prompt,\n            \"--model\", model,\n            \"--max-turns\", str(cc.max_turns),\n            \"--output-format\", \"json\",\n        ]\n        return cmd\n\n    def _on_circuit_breaker_open(self, failures: int, recovery_timeout: float) -> None:\n        \"\"\"Notification callback invoked when the circuit breaker opens.\n\n        Writes a notification file to the state directory so external\n        monitoring tools and users can detect the outage.\n        \"\"\"\n        import datetime as dt\n        state_dir = Path(self.config.paths.state_dir)\n        state_dir.mkdir(parents=True, exist_ok=True)\n        notification_file = state_dir / \"circuit_breaker_open\"\n        try:\n            notification_file.write_text(\n                f\"Circuit breaker OPEN\\n\"\n                f\"Timestamp: {dt.datetime.now(dt.timezone.utc).isoformat()}\\n\"\n                f\"Consecutive failures: {failures}\\n\"\n                f\"Recovery timeout: {recovery_timeout}s\\n\"\n                f\"API calls are blocked until recovery.\\n\"\n            )\n            logger.warning(\n                \"Circuit breaker notification written to %s\",\n                notification_file,\n            )\n        except OSError as e:\n            logger.debug(\"Failed to write circuit breaker notification: %s\", e)\n\n    @staticmethod\n    def _kill_process(proc: subprocess.Popen) -> None:\n        \"\"\"Kill a subprocess and its entire process group.\"\"\"\n        kill_process_group(proc)\n\n    @staticmethod\n    def _is_circuit_breaker_error(stderr: str) -> bool:\n        \"\"\"Check if stderr indicates a rate limit or server error.\"\"\"\n        stderr_lower = stderr.lower()\n        return any(pat in stderr_lower for pat in _CB_ERROR_PATTERNS)\n\n    def terminate(self) -> None:\n        \"\"\"Terminate any currently running Claude subprocess.\n\n        Thread-safe: can be called from a different thread than the one\n        executing run().  Also sets _terminated to prevent the retry loop\n        from spawning new processes after the kill.\n        \"\"\"\n        self._terminated = True\n        with self._process_lock:\n            proc = self._current_process\n        if proc is not None:\n            logger.warning(\"Terminating running Claude subprocess (pid=%s)\", proc.pid)\n            self._kill_process(proc)\n\n    def _parse_json_response(self, stdout: str) -> Dict[str, Any]:\n        \"\"\"Parse JSON from Claude CLI output.\n\n        The CLI may print banner/info lines before the actual JSON,\n        and log/warning lines after it. We extract only the first\n        valid top-level JSON object.\n        \"\"\"\n        if not stdout or not stdout.strip():\n            raise ValueError(\"Claude CLI produced empty output (no JSON to parse)\")\n\n        # Strategy 1a: Try each line as a complete JSON object starting with '{'.\n        # This handles the common case where the JSON is on its own line.\n        for line in stdout.splitlines():\n            line = line.strip()\n            if not line or not line.startswith(\"{\"):\n                continue\n            try:\n                obj = json.loads(line)\n                if isinstance(obj, dict):\n                    return obj\n            except json.JSONDecodeError:\n                pass\n\n        # Strategy 1b: Try finding JSON mid-line (preceded by text on the same line).\n        for line in stdout.splitlines():\n            line = line.strip()\n            brace_pos = line.find(\"{\")\n            if brace_pos <= 0:\n                continue\n            # Try from each '{' position after the start of the line\n            while brace_pos != -1:\n                candidate = line[brace_pos:]\n                try:\n                    obj = json.loads(candidate)\n                    if isinstance(obj, dict):\n                        return obj\n                except json.JSONDecodeError:\n                    pass\n                brace_pos = line.find(\"{\", brace_pos + 1)\n\n        # Strategy 2: Fall back to raw_decode for multi-line JSON.\n        # Try parsing from any '{' position to handle JSON starting mid-line.\n        decoder = json.JSONDecoder()\n        for i, ch in enumerate(stdout):\n            if ch != \"{\":\n                continue\n            try:\n                obj, end = decoder.raw_decode(stdout, i)\n                if isinstance(obj, dict):\n                    return obj\n            except json.JSONDecodeError:\n                pass\n\n        raise ValueError(\"No JSON object found in Claude CLI output\")\n\n    def run(self, prompt: str,\n            add_dirs: Optional[List[str]] = None) -> ClaudeResult:\n        \"\"\"Run Claude CLI with the given prompt and return parsed result.\"\"\"\n        self._terminated = False  # Reset on each new run\n        cmd = self._build_command(prompt)\n        # Always use the main project dir as cwd (macOS sandbox restriction:\n        # sandbox_apply fails with exit 71 when cwd is outside the project).\n        cwd = self.config.target_dir\n        if add_dirs:\n            for d in add_dirs:\n                cmd.extend([\"--add-dir\", str(Path(d).resolve())])\n\n        logger.info(\"Running Claude CLI in %s\", cwd)\n        logger.debug(\"Command: %s\", \" \".join(cmd))\n\n        # Check circuit breaker before attempting the call\n        if not self.circuit_breaker.allow_request():\n            logger.warning(\n                \"Circuit breaker is OPEN — blocking Claude API call to prevent \"\n                \"further cost accumulation\"\n            )\n            return ClaudeResult(\n                success=False,\n                error=\"Circuit breaker is open: too many consecutive API failures. \"\n                      \"Will automatically retry after recovery timeout.\",\n            )\n\n        for attempt in range(self.max_retries + 1):\n            # If terminate() was called (e.g. signal handler), stop retrying\n            if self._terminated:\n                return ClaudeResult(\n                    success=False,\n                    error=\"Terminated by signal — aborting retries\",\n                )\n            try:\n                popen_proc = subprocess.Popen(\n                    cmd,\n                    cwd=cwd,\n                    stdout=subprocess.PIPE,\n                    stderr=subprocess.PIPE,\n                    text=True,\n                    start_new_session=True,\n                )\n                with self._process_lock:\n                    self._current_process = popen_proc\n                try:\n                    stdout, stderr = popen_proc.communicate(\n                        timeout=self.config.claude.timeout_seconds,\n                    )\n                except subprocess.TimeoutExpired:\n                    self._kill_process(popen_proc)\n                    raise\n                finally:\n                    with self._process_lock:\n                        self._current_process = None\n\n                # Build a CompletedProcess-like namespace for downstream code\n                class _ProcResult:\n                    pass\n                proc = _ProcResult()\n                proc.returncode = popen_proc.returncode\n                proc.stdout = stdout\n                proc.stderr = stderr\n            except subprocess.TimeoutExpired:\n                if attempt < self.max_retries:\n                    delay = self.retry_delays[min(attempt, len(self.retry_delays) - 1)]\n                    logger.warning(\n                        \"Claude CLI timed out (attempt %d/%d), retrying in %ds\",\n                        attempt + 1, self.max_retries + 1, delay,\n                    )\n                    time.sleep(delay)\n                    continue\n                self.circuit_breaker.record_failure()\n                return ClaudeResult(\n                    success=False,\n                    error=f\"Claude CLI timed out after {self.config.claude.timeout_seconds}s\",\n                )\n            except FileNotFoundError:\n                return ClaudeResult(\n                    success=False,\n                    error=f\"Claude CLI command not found: {self.config.claude.command}\",\n                )\n            except OSError as e:\n                if attempt < self.max_retries:\n                    delay = self.retry_delays[min(attempt, len(self.retry_delays) - 1)]\n                    logger.warning(\n                        \"Claude CLI OS error (attempt %d/%d): %s, retrying in %ds\",\n                        attempt + 1, self.max_retries + 1, e, delay,\n                    )\n                    time.sleep(delay)\n                    continue\n                return ClaudeResult(\n                    success=False,\n                    error=f\"Failed to run Claude CLI: {e}\",\n                )\n\n            if proc.returncode != 0:\n                if attempt < self.max_retries:\n                    stderr_lower = proc.stderr.lower()\n                    if \"rate limit\" in stderr_lower or \"429\" in stderr_lower or \"too many requests\" in stderr_lower:\n                        delay = self.rate_limit_base_delay * (self.rate_limit_multiplier ** attempt)\n                        logger.warning(\n                            \"Rate limited (attempt %d/%d), backing off %ds\",\n                            attempt + 1, self.max_retries + 1, delay,\n                        )\n                    else:\n                        delay = self.retry_delays[min(attempt, len(self.retry_delays) - 1)]\n                        logger.warning(\n                            \"Claude CLI exited with code %d (attempt %d/%d), retrying in %ds\",\n                            proc.returncode, attempt + 1, self.max_retries + 1, delay,\n                        )\n                    time.sleep(delay)\n                    continue\n                # All retries exhausted — update circuit breaker if the error\n                # matches rate-limit or server-error patterns.\n                if self._is_circuit_breaker_error(proc.stderr):\n                    self.circuit_breaker.record_failure()\n                return ClaudeResult(\n                    success=False,\n                    error=f\"Claude CLI exited with code {proc.returncode}: {proc.stderr.strip()}\",\n                )\n\n            # Parse JSON before exiting the loop — retry on truncated output\n            try:\n                data = self._parse_json_response(proc.stdout)\n            except (ValueError, json.JSONDecodeError) as e:\n                stdout_stripped = proc.stdout.strip()\n                looks_truncated = \"{\" in stdout_stripped and not stdout_stripped.endswith(\"}\")\n                if looks_truncated and attempt < self.max_retries:\n                    delay = self.retry_delays[min(attempt, len(self.retry_delays) - 1)]\n                    logger.warning(\n                        \"Output appears truncated (attempt %d/%d), retrying in %ds\",\n                        attempt + 1, self.max_retries + 1, delay,\n                    )\n                    time.sleep(delay)\n                    continue\n                return ClaudeResult(\n                    success=False,\n                    error=f\"Failed to parse Claude CLI output: {e}\",\n                    result_text=proc.stdout,\n                )\n\n            break  # successful parse — exit retry loop\n\n        # Successful API call — reset circuit breaker\n        self.circuit_breaker.record_success()\n\n        if \"result\" not in data:\n            logger.warning(\n                \"Claude CLI JSON response missing 'result' field; \"\n                \"keys present: %s\", sorted(data.keys()),\n            )\n\n        result_text = data.get(\"result\", \"\")\n        cost_usd = data.get(\"total_cost_usd\", data.get(\"cost_usd\", 0.0))\n        duration_ms = data.get(\"duration_ms\", 0)\n        duration = duration_ms / 1000.0 if duration_ms else data.get(\"duration_seconds\", 0.0)\n\n        # Extract token usage for context window tracking\n        usage = data.get(\"usage\", {})\n        input_tokens = usage.get(\"input_tokens\", 0)\n        output_tokens = usage.get(\"output_tokens\", 0)\n        total_tokens = input_tokens + output_tokens\n        context_window_pct = (total_tokens / _DEFAULT_CONTEXT_WINDOW) * 100 if total_tokens else 0.0\n\n        # Detect error_max_turns: Claude ran out of turns before producing\n        # a final result.  Still return success=True because the subprocess\n        # completed normally and may have made useful file changes, but\n        # include a warning in the error field so callers can decide whether\n        # to trust result_text (which may be empty).\n        error_msg = \"\"\n        subtype = data.get(\"subtype\", \"\")\n        if subtype == \"error_max_turns\":\n            error_msg = \"Claude hit max_turns without producing a final result\"\n            logger.warning(\n                \"Claude hit max_turns (%s); result_text may be empty or incomplete\",\n                self.config.claude.max_turns,\n            )\n\n        return ClaudeResult(\n            success=True,\n            result_text=result_text,\n            cost_usd=cost_usd,\n            duration_seconds=duration,\n            raw_json=data,\n            error=error_msg,\n            input_tokens=input_tokens,\n            output_tokens=output_tokens,\n            context_window_pct=context_window_pct,\n        )\n","numLines":537,"startLine":1,"totalLines":537}}}
