{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_vrtx_01MMoAFuSZS5sMeuWTAZQP65","type":"tool_result","content":"   200→        return shared_build_task_prompt(tasks, self.config.safety.protected_files)\n   201→\n   202→    # ------------------------------------------------------------------\n   203→    # Commit-message helpers\n   204→    # ------------------------------------------------------------------\n   205→\n   206→    def _build_commit_message(self, task: Task) -> str:\n   207→        \"\"\"Build a conventional, human-style commit message for a single task.\"\"\"\n   208→        return build_commit_message(task)\n   209→\n   210→    def _build_batch_commit_message(self, tasks: List[Task]) -> str:\n   211→        \"\"\"Build a natural commit message summarizing a batch of tasks.\"\"\"\n   212→        return build_batch_commit_message(tasks)\n   213→\n   214→    def _format_validation_errors(self, validation: ValidationResult) -> str:\n   215→        \"\"\"Extract failure details from ValidationResult for the retry prompt.\"\"\"\n   216→        include_full = self.config.orchestrator.retry_include_full_output\n   217→        parts = []\n   218→        for step in validation.steps:\n   219→            if not step.passed:\n   220→                parts.append(f\"--- {step.name} FAILED (exit code {step.return_code}) ---\")\n   221→                parts.append(f\"Command: {step.command}\")\n   222→                if include_full and step.output:\n   223→                    output = step.output[:8000]\n   224→                    if len(step.output) > 8000:\n   225→                        output += \"\\n... (truncated)\"\n   226→                    parts.append(output)\n   227→                parts.append(\"\")\n   228→        return \"\\n\".join(parts) if parts else validation.summary\n   229→\n   230→    def _build_retry_prompt(self, tasks: List[Task], validation: ValidationResult,\n   231→                            attempt: int, max_attempts: int) -> str:\n   232→        \"\"\"Build a prompt for retrying after validation failure.\"\"\"\n   233→        errors = self._format_validation_errors(validation)\n   234→        task_history = self.state.get_task_success_history(\n   235→            tasks[0].description,\n   236→            task_key=tasks[0].task_key,\n   237→        )\n   238→        return shared_build_retry_prompt(\n   239→            tasks, errors, self.config.safety.protected_files,\n   240→            attempt=attempt, max_attempts=max_attempts,\n   241→            task_history=task_history,\n   242→        )\n   243→\n   244→    def _validate_with_retries(\n   245→        self, tasks: List[Task], snapshot, pre_existing_files,\n   246→        total_cost: float, total_duration: float,\n   247→        is_batch: bool, extra_record_kwargs: Optional[dict] = None,\n   248→    ) -> None:\n   249→        \"\"\"Validate changes, retrying with Claude on failure.\n   250→\n   251→        On validation failure, re-invokes Claude with the failure output so it can\n   252→        fix the issue in-place. Rollback only happens if all fix attempts are exhausted\n   253→        or a non-retryable error occurs (safety check, syntax error).\n   254→\n   255→        Uses a single loop counter (attempt) to avoid dual-counter confusion.\n   256→        Clamps max_retries to [0, 50] to prevent runaway loops from misconfiguration.\n   257→        \"\"\"\n   258→        max_retries = max(0, min(self.config.orchestrator.max_validation_retries, 50))\n   259→        extra = extra_record_kwargs or {}\n   260→        retry_count = 0\n   261→\n   262→        # Fast path: if no files changed before we even enter the retry loop,\n   263→        # skip the loop entirely to avoid unnecessary overhead.\n   264→        changed_files = self.git.get_new_changed_files(pre_existing_files)\n   265→        if not changed_files:\n   266→            logger.info(\"No files changed, skipping validation\")\n   267→            self.state.record_cycle(self._make_cycle_record(\n   268→                tasks, success=False,\n   269→                cost_usd=total_cost, duration_seconds=total_duration,\n   270→                error=\"No files changed\",\n   271→                validation_retry_count=0, **extra,\n   272→            ))\n   273→            return\n   274→\n   275→        for attempt in range(max_retries + 1):\n   276→            # Re-capture changed files (may differ after retry)\n   277→            changed_files = self.git.get_new_changed_files(pre_existing_files)\n   278→            if not changed_files:\n   279→                logger.info(\"No files changed, skipping\")\n   280→                self.state.record_cycle(self._make_cycle_record(\n   281→                    tasks, success=False,\n   282→                    cost_usd=total_cost, duration_seconds=total_duration,\n   283→                    error=\"No files changed\",\n   284→                    validation_retry_count=retry_count, **extra,\n   285→                ))\n   286→                return\n   287→\n   288→            # Safety checks (non-retryable — immediate rollback)\n   289→            try:\n   290→                self.safety.post_claude_checks(changed_files)\n   291→            except SafetyError as e:\n   292→                logger.warning(\"Post-Claude safety check failed: %s\", e)\n   293→                self.git.rollback(snapshot, allowed_dirty=pre_existing_files)\n   294→                self.state.record_cycle(self._make_cycle_record(\n   295→                    tasks, success=False,\n   296→                    cost_usd=total_cost, duration_seconds=total_duration,\n   297→                    error=str(e),\n   298→                    validation_retry_count=retry_count, **extra,\n   299→                ))\n   300→                return\n   301→\n   302→            # Syntax check (non-retryable)\n   303→            syntax_err = self._syntax_check_files(changed_files)\n   304→            if syntax_err:\n   305→                logger.warning(\"Syntax check failed: %s\", syntax_err)\n   306→                self.git.rollback(snapshot, allowed_dirty=pre_existing_files)\n   307→                self.state.record_cycle(self._make_cycle_record(\n   308→                    tasks, success=False,\n   309→                    cost_usd=total_cost, duration_seconds=total_duration,\n   310→                    error=syntax_err,\n   311→                    validation_retry_count=retry_count, **extra,\n   312→                ))\n   313→                return\n   314→\n   315→            # Validate\n   316→            if self.config.validation.incremental_tests:\n   317→                validation = self.validator.validate_incremental(\n   318→                    self.config.target_dir, changed_files,\n   319→                )\n   320→            else:\n   321→                validation = self.validator.validate(self.config.target_dir)\n   322→\n   323→            if validation.passed:\n   324→                # LLM Judge evaluation (before commit)\n   325→                if self.config.judges.enabled:\n   326→                    from llm_judges import JudgePanel\n   327→                    panel = JudgePanel(self.config)\n   328→                    diff_text = self.git.get_diff()\n   329→                    panel_result = panel.evaluate(\n   330→                        changed_files, diff_text,\n   331→                        tasks[0].description,\n   332→                    )\n   333→                    total_cost += panel_result.total_cost_usd\n   334→                    total_duration += panel_result.total_duration_seconds\n   335→                    if not panel_result.passed:\n   336→                        if self.config.judges.fail_action == \"retry\" and attempt < max_retries:\n   337→                            retry_count += 1\n   338→                            retry_prompt = shared_build_retry_prompt(\n   339→                                tasks, panel_result.blocking_feedback,\n   340→                                self.config.safety.protected_files,\n   341→                                attempt=attempt + 1, max_attempts=max_retries + 1,\n   342→                            )\n   343→                            retry_result = self._run_claude_with_timeout(retry_prompt)\n   344→                            total_cost += retry_result.cost_usd\n   345→                            total_duration += retry_result.duration_seconds\n   346→                            continue  # re-validate\n   347→                        elif self.config.judges.fail_action == \"rollback\":\n   348→                            self.git.rollback(snapshot, allowed_dirty=pre_existing_files)\n   349→                            self.state.record_cycle(self._make_cycle_record(\n   350→                                tasks, success=False,\n   351→                                cost_usd=total_cost, duration_seconds=total_duration,\n   352→                                error=\"LLM judges rejected changes\",\n   353→                                validation_retry_count=retry_count, **extra,\n   354→                            ))\n   355→                            return\n   356→                        # else \"warn\": log and continue to commit\n   357→                        logger.warning(\n   358→                            \"LLM judges failed but fail_action=%s, continuing\",\n   359→                            self.config.judges.fail_action,\n   360→                        )\n   361→\n   362→                # Commit\n   363→                if is_batch:\n   364→                    commit_msg = self._build_batch_commit_message(tasks)\n   365→                else:\n   366→                    commit_msg = self._build_commit_message(tasks[0])\n   367→\n   368→                commit_hash = self.git.commit(commit_msg, files=changed_files)\n   369→\n   370→                if commit_hash is None:\n   371→                    # Git command itself failed (distinct from \"nothing staged\")\n   372→                    logger.error(\"git commit command failed\")\n   373→                    self.git.rollback(snapshot, allowed_dirty=pre_existing_files)\n   374→                    self.state.record_cycle(self._make_cycle_record(\n   375→                        tasks, success=False,\n   376→                        cost_usd=total_cost, duration_seconds=total_duration,\n   377→                        error=\"git commit command failed\",\n   378→                        validation_retry_count=retry_count, **extra,\n   379→                    ))\n   380→                    return\n   381→\n   382→                logger.info(\"Cycle succeeded: %s\", commit_msg.split(\"\\n\")[0])\n   383→\n   384→                # Periodic git gc to clean up loose objects\n   385→                self._successful_commits += 1\n   386→                if self._successful_commits % self.config.orchestrator.gc_interval == 0:\n   387→                    self.git.gc_auto()\n   388→\n   389→                # Run config tuner\n   390→                try:\n   391→                    from config_tuner import ConfigTuner\n   392→                    tuner = ConfigTuner(str(Path(self.config.paths.state_dir)))\n   393→                    recs = tuner.analyze(self.state.load_history(), self.config)\n   394→                    if recs:\n   395→                        tuner.save_recommendations(recs)\n   396→                except Exception as e:\n   397→                    logger.debug(\"Config tuner failed: %s\", e)\n   398→\n   399→                if self.config.orchestrator.push_after_commit:\n   400→                    push_ok = self.git.push()\n   401→                    if not push_ok:\n   402→                        logger.error(\n   403→                            \"Push failed for commit %s — local commits may diverge from remote\",\n   404→                            commit_hash[:8],\n   405→                        )\n   406→                else:\n   407→                    push_ok = None\n   408→\n   409→                for t in tasks:\n   410→                    if t.source == \"feedback\" and t.source_file:\n   411→                        self.feedback.mark_done(t.source_file)\n   412→\n   413→                self.state.record_cycle(self._make_cycle_record(\n   414→                    tasks, success=True,\n   415→                    commit_hash=commit_hash,\n   416→                    cost_usd=total_cost, duration_seconds=total_duration,\n   417→                    validation_summary=validation.summary,\n   418→                    validation_retry_count=retry_count,\n   419→                    push_succeeded=push_ok,\n   420→                    **extra,\n   421→                ))\n   422→                self.notifier.notify(\"cycle_success\", {\n   423→                    \"tasks\": [t.description for t in tasks],\n   424→                    \"commit\": commit_hash,\n   425→                    \"cost_usd\": total_cost,\n   426→                })\n   427→                # Clear session on success\n   428→                if self._session_manager:\n   429→                    self._session_manager.clear_session()\n   430→                return\n   431→            if attempt < max_retries:\n   432→                # Cost guard: check accumulated cost against hourly budget\n   433→                hourly_cost = self.state.get_total_cost(lookback_seconds=3600)\n   434→                cost_limit = self.config.safety.max_cost_usd_per_hour\n   435→                if hourly_cost + total_cost >= cost_limit * 0.9:\n   436→                    logger.warning(\n   437→                        \"Cost guard: $%.2f accumulated (limit $%.2f), aborting retries\",\n   438→                        hourly_cost + total_cost, cost_limit,\n   439→                    )\n   440→                    self.git.rollback(snapshot, allowed_dirty=pre_existing_files)\n   441→                    self.state.record_cycle(self._make_cycle_record(\n   442→                        tasks, success=False,\n   443→                        cost_usd=total_cost, duration_seconds=total_duration,\n   444→                        validation_summary=validation.summary,\n   445→                        error=\"Validation failed; cost guard prevented retry\",\n   446→                        validation_retry_count=retry_count, **extra,\n   447→                    ))\n   448→                    return\n   449→\n   450→                retry_count += 1\n   451→                logger.info(\n   452→                    \"Validation failed (attempt %d/%d), retrying with failure output...\",\n   453→                    attempt + 1, max_retries + 1,\n   454→                )\n   455→                retry_prompt = self._build_retry_prompt(\n   456→                    tasks, validation, attempt + 1, max_retries + 1,\n   457→                )\n   458→                retry_result = self._run_claude_with_timeout(retry_prompt)\n   459→                total_cost += retry_result.cost_usd\n   460→                total_duration += retry_result.duration_seconds\n   461→                self.cycle_state.update(\n   462→                    accumulated_cost=total_cost,\n   463→                    retry_count=retry_count,\n   464→                    phase=\"retrying\",\n   465→                )\n   466→\n   467→                if not retry_result.success:\n   468→                    logger.warning(\"Retry Claude invocation failed: %s\", retry_result.error)\n   469→                    self.git.rollback(snapshot, allowed_dirty=pre_existing_files)\n   470→                    self.state.record_cycle(self._make_cycle_record(\n   471→                        tasks, success=False,\n   472→                        cost_usd=total_cost, duration_seconds=total_duration,\n   473→                        validation_summary=validation.summary,\n   474→                        error=f\"Retry failed: {retry_result.error}\",\n   475→                        validation_retry_count=retry_count, **extra,\n   476→                    ))\n   477→                    return\n   478→                # Loop back to re-validate\n   479→            else:\n   480→                # All attempts exhausted\n   481→                logger.warning(\"Validation failed after %d attempts: %s\",\n   482→                               max_retries + 1, validation.summary)\n   483→                self.git.rollback(snapshot, allowed_dirty=pre_existing_files)\n   484→                self.state.record_cycle(self._make_cycle_record(\n   485→                    tasks, success=False,\n   486→                    cost_usd=total_cost, duration_seconds=total_duration,\n   487→                    validation_summary=validation.summary,\n   488→                    error=\"Validation failed\",\n   489→                    validation_retry_count=retry_count, **extra,\n   490→                ))\n   491→                self.notifier.notify(\"cycle_failure\", {\n   492→                    \"tasks\": [t.description for t in tasks],\n   493→                    \"error\": validation.summary,\n   494→                    \"retry_count\": retry_count,\n   495→                })\n   496→                return\n   497→\n   498→    def _make_cycle_record(self, tasks: List[Task], **kwargs) -> CycleRecord:\n   499→        \"\"\"Construct a CycleRecord with both singular and batch list fields.\"\"\"\n   500→        primary = tasks[0] if tasks else Task(description=\"unknown\", priority=99, source=\"unknown\")\n   501→        record = CycleRecord(\n   502→            timestamp=kwargs.get(\"timestamp\", time.time()),\n   503→            task_description=primary.description,\n   504→            task_type=primary.source,\n   505→            success=kwargs.get(\"success\", False),\n   506→            commit_hash=kwargs.get(\"commit_hash\", \"\"),\n   507→            cost_usd=kwargs.get(\"cost_usd\", 0.0),\n   508→            duration_seconds=kwargs.get(\"duration_seconds\", 0.0),\n   509→            validation_summary=kwargs.get(\"validation_summary\", \"\"),\n   510→            error=kwargs.get(\"error\", \"\"),\n   511→            task_descriptions=[t.description for t in tasks],\n   512→            task_types=[t.source for t in tasks],\n   513→            batch_size=len(tasks),\n   514→            task_keys=[t.task_key for t in tasks],\n   515→            pipeline_mode=kwargs.get(\"pipeline_mode\", \"\"),\n   516→            pipeline_revision_count=kwargs.get(\"pipeline_revision_count\", 0),\n   517→            pipeline_review_approved=kwargs.get(\"pipeline_review_approved\", True),\n   518→            validation_retry_count=kwargs.get(\"validation_retry_count\", 0),\n   519→            push_succeeded=kwargs.get(\"push_succeeded\", None),\n   520→            task_source_files=[t.source_file or \"\" for t in tasks],\n   521→            task_line_numbers=[t.line_number for t in tasks],\n   522→        )\n   523→        return record\n   524→\n   525→    def _syntax_check_files(self, changed_files: List[str]) -> Optional[str]:\n   526→        \"\"\"If self_improve is on, syntax-check any modified .py files.\"\"\"\n   527→        if not self.config.orchestrator.self_improve:\n   528→            return None\n   529→        return syntax_check_files(changed_files, self.config.target_dir)\n   530→\n   531→    def _backup_orchestrator_files(self) -> None:\n   532→        \"\"\"If self_improve is on, back up key orchestrator files before a cycle.\n   533→\n   534→        Dynamically discovers all .py files in the project root (excluding\n   535→        main.py, test files, and non-project files) to ensure new modules\n   536→        are always included.\n   537→        \"\"\"\n   538→        if not self.config.orchestrator.self_improve:\n   539→            return\n   540→\n   541→        backup_dir = Path(self.config.paths.backup_dir)\n   542→        backup_dir.mkdir(parents=True, exist_ok=True)\n   543→\n   544→        target = Path(self.config.target_dir)\n   545→        for py_file in target.glob(\"*.py\"):\n   546→            # Skip main.py (protected), test files, and setup files\n   547→            if py_file.name in (\"main.py\", \"setup.py\"):\n   548→                continue\n   549→            if py_file.name.startswith(\"test_\"):\n   550→                continue\n   551→            try:\n   552→                dst = backup_dir / py_file.name\n   553→                shutil.copy2(str(py_file), str(dst))\n   554→            except OSError as e:\n   555→                logger.warning(\"Failed to backup %s: %s\", py_file.name, e)\n   556→\n   557→    def _run_claude_with_timeout(self, prompt: str, runner: Optional[ClaudeRunner] = None) -> ClaudeResult:\n   558→        \"\"\"Run Claude CLI with a cycle-level timeout safety net.\n   559→\n   560→        Wraps self.claude.run() in a thread pool with a configurable timeout\n   561→        to prevent indefinite hangs even if the subprocess timeout fails.\n   562→        On timeout, actively terminates the child process so neither the\n   563→        thread nor the subprocess leak.  Uses wait=False on shutdown to\n   564→        avoid blocking the main loop if the thread refuses to die.\n   565→        \"\"\"\n   566→        timeout = self.config.orchestrator.cycle_timeout_seconds\n   567→        actual_runner = runner or self.claude\n   568→        executor = concurrent.futures.ThreadPoolExecutor(max_workers=1)\n   569→        try:\n   570→            future = executor.submit(actual_runner.run, prompt)\n   571→            try:\n   572→                return future.result(timeout=timeout)\n   573→            except concurrent.futures.TimeoutError:\n   574→                logger.warning(\n   575→                    \"Claude CLI cycle timeout fired after %ds — killing subprocess\", timeout,\n   576→                )\n   577→                actual_runner.terminate()\n   578→                future.cancel()\n   579→                # Short secondary wait for the thread to finish\n   580→                try:\n   581→                    future.result(timeout=30)\n   582→                except (concurrent.futures.TimeoutError, concurrent.futures.CancelledError, Exception):\n   583→                    logger.error(\n   584→                        \"Claude thread still alive 30s after terminate — \"\n   585→                        \"continuing without blocking\"\n   586→                    )\n   587→                return ClaudeResult(\n   588→                    success=False,\n   589→                    error=f\"Cycle timeout after {timeout}s (Claude CLI hung)\",\n   590→                )\n   591→        finally:\n   592→            executor.shutdown(wait=False)\n   593→\n   594→    def _cycle(self) -> None:\n   595→        \"\"\"Run a single orchestration cycle.\"\"\"\n   596→        # 1. Pre-flight safety checks\n   597→        try:\n   598→            self.safety.pre_flight_checks()\n   599→        except SafetyError as e:"}]},"parent_tool_use_id":null,"session_id":"1a03c01c-3a23-4305-af58-24656a1d085b","uuid":"21c11af2-daff-4192-b404-04b60a19a997","tool_use_result":{"type":"text","file":{"filePath":"/Users/sameertkhanna/Documents/auto_claude_code/orchestrator.py","content":"        return shared_build_task_prompt(tasks, self.config.safety.protected_files)\n\n    # ------------------------------------------------------------------\n    # Commit-message helpers\n    # ------------------------------------------------------------------\n\n    def _build_commit_message(self, task: Task) -> str:\n        \"\"\"Build a conventional, human-style commit message for a single task.\"\"\"\n        return build_commit_message(task)\n\n    def _build_batch_commit_message(self, tasks: List[Task]) -> str:\n        \"\"\"Build a natural commit message summarizing a batch of tasks.\"\"\"\n        return build_batch_commit_message(tasks)\n\n    def _format_validation_errors(self, validation: ValidationResult) -> str:\n        \"\"\"Extract failure details from ValidationResult for the retry prompt.\"\"\"\n        include_full = self.config.orchestrator.retry_include_full_output\n        parts = []\n        for step in validation.steps:\n            if not step.passed:\n                parts.append(f\"--- {step.name} FAILED (exit code {step.return_code}) ---\")\n                parts.append(f\"Command: {step.command}\")\n                if include_full and step.output:\n                    output = step.output[:8000]\n                    if len(step.output) > 8000:\n                        output += \"\\n... (truncated)\"\n                    parts.append(output)\n                parts.append(\"\")\n        return \"\\n\".join(parts) if parts else validation.summary\n\n    def _build_retry_prompt(self, tasks: List[Task], validation: ValidationResult,\n                            attempt: int, max_attempts: int) -> str:\n        \"\"\"Build a prompt for retrying after validation failure.\"\"\"\n        errors = self._format_validation_errors(validation)\n        task_history = self.state.get_task_success_history(\n            tasks[0].description,\n            task_key=tasks[0].task_key,\n        )\n        return shared_build_retry_prompt(\n            tasks, errors, self.config.safety.protected_files,\n            attempt=attempt, max_attempts=max_attempts,\n            task_history=task_history,\n        )\n\n    def _validate_with_retries(\n        self, tasks: List[Task], snapshot, pre_existing_files,\n        total_cost: float, total_duration: float,\n        is_batch: bool, extra_record_kwargs: Optional[dict] = None,\n    ) -> None:\n        \"\"\"Validate changes, retrying with Claude on failure.\n\n        On validation failure, re-invokes Claude with the failure output so it can\n        fix the issue in-place. Rollback only happens if all fix attempts are exhausted\n        or a non-retryable error occurs (safety check, syntax error).\n\n        Uses a single loop counter (attempt) to avoid dual-counter confusion.\n        Clamps max_retries to [0, 50] to prevent runaway loops from misconfiguration.\n        \"\"\"\n        max_retries = max(0, min(self.config.orchestrator.max_validation_retries, 50))\n        extra = extra_record_kwargs or {}\n        retry_count = 0\n\n        # Fast path: if no files changed before we even enter the retry loop,\n        # skip the loop entirely to avoid unnecessary overhead.\n        changed_files = self.git.get_new_changed_files(pre_existing_files)\n        if not changed_files:\n            logger.info(\"No files changed, skipping validation\")\n            self.state.record_cycle(self._make_cycle_record(\n                tasks, success=False,\n                cost_usd=total_cost, duration_seconds=total_duration,\n                error=\"No files changed\",\n                validation_retry_count=0, **extra,\n            ))\n            return\n\n        for attempt in range(max_retries + 1):\n            # Re-capture changed files (may differ after retry)\n            changed_files = self.git.get_new_changed_files(pre_existing_files)\n            if not changed_files:\n                logger.info(\"No files changed, skipping\")\n                self.state.record_cycle(self._make_cycle_record(\n                    tasks, success=False,\n                    cost_usd=total_cost, duration_seconds=total_duration,\n                    error=\"No files changed\",\n                    validation_retry_count=retry_count, **extra,\n                ))\n                return\n\n            # Safety checks (non-retryable — immediate rollback)\n            try:\n                self.safety.post_claude_checks(changed_files)\n            except SafetyError as e:\n                logger.warning(\"Post-Claude safety check failed: %s\", e)\n                self.git.rollback(snapshot, allowed_dirty=pre_existing_files)\n                self.state.record_cycle(self._make_cycle_record(\n                    tasks, success=False,\n                    cost_usd=total_cost, duration_seconds=total_duration,\n                    error=str(e),\n                    validation_retry_count=retry_count, **extra,\n                ))\n                return\n\n            # Syntax check (non-retryable)\n            syntax_err = self._syntax_check_files(changed_files)\n            if syntax_err:\n                logger.warning(\"Syntax check failed: %s\", syntax_err)\n                self.git.rollback(snapshot, allowed_dirty=pre_existing_files)\n                self.state.record_cycle(self._make_cycle_record(\n                    tasks, success=False,\n                    cost_usd=total_cost, duration_seconds=total_duration,\n                    error=syntax_err,\n                    validation_retry_count=retry_count, **extra,\n                ))\n                return\n\n            # Validate\n            if self.config.validation.incremental_tests:\n                validation = self.validator.validate_incremental(\n                    self.config.target_dir, changed_files,\n                )\n            else:\n                validation = self.validator.validate(self.config.target_dir)\n\n            if validation.passed:\n                # LLM Judge evaluation (before commit)\n                if self.config.judges.enabled:\n                    from llm_judges import JudgePanel\n                    panel = JudgePanel(self.config)\n                    diff_text = self.git.get_diff()\n                    panel_result = panel.evaluate(\n                        changed_files, diff_text,\n                        tasks[0].description,\n                    )\n                    total_cost += panel_result.total_cost_usd\n                    total_duration += panel_result.total_duration_seconds\n                    if not panel_result.passed:\n                        if self.config.judges.fail_action == \"retry\" and attempt < max_retries:\n                            retry_count += 1\n                            retry_prompt = shared_build_retry_prompt(\n                                tasks, panel_result.blocking_feedback,\n                                self.config.safety.protected_files,\n                                attempt=attempt + 1, max_attempts=max_retries + 1,\n                            )\n                            retry_result = self._run_claude_with_timeout(retry_prompt)\n                            total_cost += retry_result.cost_usd\n                            total_duration += retry_result.duration_seconds\n                            continue  # re-validate\n                        elif self.config.judges.fail_action == \"rollback\":\n                            self.git.rollback(snapshot, allowed_dirty=pre_existing_files)\n                            self.state.record_cycle(self._make_cycle_record(\n                                tasks, success=False,\n                                cost_usd=total_cost, duration_seconds=total_duration,\n                                error=\"LLM judges rejected changes\",\n                                validation_retry_count=retry_count, **extra,\n                            ))\n                            return\n                        # else \"warn\": log and continue to commit\n                        logger.warning(\n                            \"LLM judges failed but fail_action=%s, continuing\",\n                            self.config.judges.fail_action,\n                        )\n\n                # Commit\n                if is_batch:\n                    commit_msg = self._build_batch_commit_message(tasks)\n                else:\n                    commit_msg = self._build_commit_message(tasks[0])\n\n                commit_hash = self.git.commit(commit_msg, files=changed_files)\n\n                if commit_hash is None:\n                    # Git command itself failed (distinct from \"nothing staged\")\n                    logger.error(\"git commit command failed\")\n                    self.git.rollback(snapshot, allowed_dirty=pre_existing_files)\n                    self.state.record_cycle(self._make_cycle_record(\n                        tasks, success=False,\n                        cost_usd=total_cost, duration_seconds=total_duration,\n                        error=\"git commit command failed\",\n                        validation_retry_count=retry_count, **extra,\n                    ))\n                    return\n\n                logger.info(\"Cycle succeeded: %s\", commit_msg.split(\"\\n\")[0])\n\n                # Periodic git gc to clean up loose objects\n                self._successful_commits += 1\n                if self._successful_commits % self.config.orchestrator.gc_interval == 0:\n                    self.git.gc_auto()\n\n                # Run config tuner\n                try:\n                    from config_tuner import ConfigTuner\n                    tuner = ConfigTuner(str(Path(self.config.paths.state_dir)))\n                    recs = tuner.analyze(self.state.load_history(), self.config)\n                    if recs:\n                        tuner.save_recommendations(recs)\n                except Exception as e:\n                    logger.debug(\"Config tuner failed: %s\", e)\n\n                if self.config.orchestrator.push_after_commit:\n                    push_ok = self.git.push()\n                    if not push_ok:\n                        logger.error(\n                            \"Push failed for commit %s — local commits may diverge from remote\",\n                            commit_hash[:8],\n                        )\n                else:\n                    push_ok = None\n\n                for t in tasks:\n                    if t.source == \"feedback\" and t.source_file:\n                        self.feedback.mark_done(t.source_file)\n\n                self.state.record_cycle(self._make_cycle_record(\n                    tasks, success=True,\n                    commit_hash=commit_hash,\n                    cost_usd=total_cost, duration_seconds=total_duration,\n                    validation_summary=validation.summary,\n                    validation_retry_count=retry_count,\n                    push_succeeded=push_ok,\n                    **extra,\n                ))\n                self.notifier.notify(\"cycle_success\", {\n                    \"tasks\": [t.description for t in tasks],\n                    \"commit\": commit_hash,\n                    \"cost_usd\": total_cost,\n                })\n                # Clear session on success\n                if self._session_manager:\n                    self._session_manager.clear_session()\n                return\n            if attempt < max_retries:\n                # Cost guard: check accumulated cost against hourly budget\n                hourly_cost = self.state.get_total_cost(lookback_seconds=3600)\n                cost_limit = self.config.safety.max_cost_usd_per_hour\n                if hourly_cost + total_cost >= cost_limit * 0.9:\n                    logger.warning(\n                        \"Cost guard: $%.2f accumulated (limit $%.2f), aborting retries\",\n                        hourly_cost + total_cost, cost_limit,\n                    )\n                    self.git.rollback(snapshot, allowed_dirty=pre_existing_files)\n                    self.state.record_cycle(self._make_cycle_record(\n                        tasks, success=False,\n                        cost_usd=total_cost, duration_seconds=total_duration,\n                        validation_summary=validation.summary,\n                        error=\"Validation failed; cost guard prevented retry\",\n                        validation_retry_count=retry_count, **extra,\n                    ))\n                    return\n\n                retry_count += 1\n                logger.info(\n                    \"Validation failed (attempt %d/%d), retrying with failure output...\",\n                    attempt + 1, max_retries + 1,\n                )\n                retry_prompt = self._build_retry_prompt(\n                    tasks, validation, attempt + 1, max_retries + 1,\n                )\n                retry_result = self._run_claude_with_timeout(retry_prompt)\n                total_cost += retry_result.cost_usd\n                total_duration += retry_result.duration_seconds\n                self.cycle_state.update(\n                    accumulated_cost=total_cost,\n                    retry_count=retry_count,\n                    phase=\"retrying\",\n                )\n\n                if not retry_result.success:\n                    logger.warning(\"Retry Claude invocation failed: %s\", retry_result.error)\n                    self.git.rollback(snapshot, allowed_dirty=pre_existing_files)\n                    self.state.record_cycle(self._make_cycle_record(\n                        tasks, success=False,\n                        cost_usd=total_cost, duration_seconds=total_duration,\n                        validation_summary=validation.summary,\n                        error=f\"Retry failed: {retry_result.error}\",\n                        validation_retry_count=retry_count, **extra,\n                    ))\n                    return\n                # Loop back to re-validate\n            else:\n                # All attempts exhausted\n                logger.warning(\"Validation failed after %d attempts: %s\",\n                               max_retries + 1, validation.summary)\n                self.git.rollback(snapshot, allowed_dirty=pre_existing_files)\n                self.state.record_cycle(self._make_cycle_record(\n                    tasks, success=False,\n                    cost_usd=total_cost, duration_seconds=total_duration,\n                    validation_summary=validation.summary,\n                    error=\"Validation failed\",\n                    validation_retry_count=retry_count, **extra,\n                ))\n                self.notifier.notify(\"cycle_failure\", {\n                    \"tasks\": [t.description for t in tasks],\n                    \"error\": validation.summary,\n                    \"retry_count\": retry_count,\n                })\n                return\n\n    def _make_cycle_record(self, tasks: List[Task], **kwargs) -> CycleRecord:\n        \"\"\"Construct a CycleRecord with both singular and batch list fields.\"\"\"\n        primary = tasks[0] if tasks else Task(description=\"unknown\", priority=99, source=\"unknown\")\n        record = CycleRecord(\n            timestamp=kwargs.get(\"timestamp\", time.time()),\n            task_description=primary.description,\n            task_type=primary.source,\n            success=kwargs.get(\"success\", False),\n            commit_hash=kwargs.get(\"commit_hash\", \"\"),\n            cost_usd=kwargs.get(\"cost_usd\", 0.0),\n            duration_seconds=kwargs.get(\"duration_seconds\", 0.0),\n            validation_summary=kwargs.get(\"validation_summary\", \"\"),\n            error=kwargs.get(\"error\", \"\"),\n            task_descriptions=[t.description for t in tasks],\n            task_types=[t.source for t in tasks],\n            batch_size=len(tasks),\n            task_keys=[t.task_key for t in tasks],\n            pipeline_mode=kwargs.get(\"pipeline_mode\", \"\"),\n            pipeline_revision_count=kwargs.get(\"pipeline_revision_count\", 0),\n            pipeline_review_approved=kwargs.get(\"pipeline_review_approved\", True),\n            validation_retry_count=kwargs.get(\"validation_retry_count\", 0),\n            push_succeeded=kwargs.get(\"push_succeeded\", None),\n            task_source_files=[t.source_file or \"\" for t in tasks],\n            task_line_numbers=[t.line_number for t in tasks],\n        )\n        return record\n\n    def _syntax_check_files(self, changed_files: List[str]) -> Optional[str]:\n        \"\"\"If self_improve is on, syntax-check any modified .py files.\"\"\"\n        if not self.config.orchestrator.self_improve:\n            return None\n        return syntax_check_files(changed_files, self.config.target_dir)\n\n    def _backup_orchestrator_files(self) -> None:\n        \"\"\"If self_improve is on, back up key orchestrator files before a cycle.\n\n        Dynamically discovers all .py files in the project root (excluding\n        main.py, test files, and non-project files) to ensure new modules\n        are always included.\n        \"\"\"\n        if not self.config.orchestrator.self_improve:\n            return\n\n        backup_dir = Path(self.config.paths.backup_dir)\n        backup_dir.mkdir(parents=True, exist_ok=True)\n\n        target = Path(self.config.target_dir)\n        for py_file in target.glob(\"*.py\"):\n            # Skip main.py (protected), test files, and setup files\n            if py_file.name in (\"main.py\", \"setup.py\"):\n                continue\n            if py_file.name.startswith(\"test_\"):\n                continue\n            try:\n                dst = backup_dir / py_file.name\n                shutil.copy2(str(py_file), str(dst))\n            except OSError as e:\n                logger.warning(\"Failed to backup %s: %s\", py_file.name, e)\n\n    def _run_claude_with_timeout(self, prompt: str, runner: Optional[ClaudeRunner] = None) -> ClaudeResult:\n        \"\"\"Run Claude CLI with a cycle-level timeout safety net.\n\n        Wraps self.claude.run() in a thread pool with a configurable timeout\n        to prevent indefinite hangs even if the subprocess timeout fails.\n        On timeout, actively terminates the child process so neither the\n        thread nor the subprocess leak.  Uses wait=False on shutdown to\n        avoid blocking the main loop if the thread refuses to die.\n        \"\"\"\n        timeout = self.config.orchestrator.cycle_timeout_seconds\n        actual_runner = runner or self.claude\n        executor = concurrent.futures.ThreadPoolExecutor(max_workers=1)\n        try:\n            future = executor.submit(actual_runner.run, prompt)\n            try:\n                return future.result(timeout=timeout)\n            except concurrent.futures.TimeoutError:\n                logger.warning(\n                    \"Claude CLI cycle timeout fired after %ds — killing subprocess\", timeout,\n                )\n                actual_runner.terminate()\n                future.cancel()\n                # Short secondary wait for the thread to finish\n                try:\n                    future.result(timeout=30)\n                except (concurrent.futures.TimeoutError, concurrent.futures.CancelledError, Exception):\n                    logger.error(\n                        \"Claude thread still alive 30s after terminate — \"\n                        \"continuing without blocking\"\n                    )\n                return ClaudeResult(\n                    success=False,\n                    error=f\"Cycle timeout after {timeout}s (Claude CLI hung)\",\n                )\n        finally:\n            executor.shutdown(wait=False)\n\n    def _cycle(self) -> None:\n        \"\"\"Run a single orchestration cycle.\"\"\"\n        # 1. Pre-flight safety checks\n        try:\n            self.safety.pre_flight_checks()\n        except SafetyError as e:","numLines":400,"startLine":200,"totalLines":1076}}}
