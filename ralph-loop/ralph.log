{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_vrtx_014MFKDchzwpe6CUJ6FSwYcv","type":"tool_result","content":"     1→\"\"\"Tests for safety module.\"\"\"\n     2→\n     3→import os\n     4→import time\n     5→from pathlib import Path\n     6→from unittest.mock import MagicMock, patch\n     7→\n     8→import pytest\n     9→\n    10→from config_schema import Config\n    11→from safety import SafetyError, SafetyGuard\n    12→from state import CycleRecord, StateManager\n    13→\n    14→\n    15→@pytest.fixture\n    16→def state_mgr(tmp_path, default_config):\n    17→    default_config.paths.history_file = str(tmp_path / \"history.json\")\n    18→    return StateManager(default_config)\n    19→\n    20→\n    21→@pytest.fixture\n    22→def guard(tmp_path, default_config, state_mgr):\n    23→    default_config.paths.lock_file = str(tmp_path / \"lock.pid\")\n    24→    return SafetyGuard(default_config, state_mgr)\n    25→\n    26→\n    27→class TestSafetyGuard:\n    28→    def test_acquire_and_release_lock(self, guard):\n    29→        guard.acquire_lock()\n    30→        assert guard._lock_fd is not None\n    31→        assert guard.lock_path.exists()\n    32→        guard.release_lock()\n    33→        assert guard._lock_fd is None\n    34→        # Lock file should persist after release (close releases flock)\n    35→        assert guard.lock_path.exists()\n    36→\n    37→    def test_double_lock_fails(self, guard, tmp_path, default_config, state_mgr):\n    38→        guard.acquire_lock()\n    39→        guard2 = SafetyGuard(default_config, state_mgr)\n    40→        with pytest.raises(SafetyError, match=\"already running\"):\n    41→            guard2.acquire_lock()\n    42→        guard.release_lock()\n    43→\n    44→    def test_check_disk_space_ok(self, guard):\n    45→        # Should not raise on a normal system\n    46→        guard.check_disk_space()\n    47→\n    48→    def test_check_disk_space_low(self, guard):\n    49→        guard.config.safety.min_disk_space_mb = 999_999_999\n    50→        with pytest.raises(SafetyError, match=\"disk space\"):\n    51→            guard.check_disk_space()\n    52→\n    53→    def test_check_rate_limit_ok(self, guard):\n    54→        guard.check_rate_limit()\n    55→\n    56→    def test_check_rate_limit_exceeded(self, guard, state_mgr):\n    57→        guard.config.safety.max_cycles_per_hour = 2\n    58→        now = time.time()\n    59→        state_mgr.record_cycle(CycleRecord(timestamp=now, task_description=\"A\"))\n    60→        state_mgr.record_cycle(CycleRecord(timestamp=now, task_description=\"B\"))\n    61→        with pytest.raises(SafetyError, match=\"Rate limit\"):\n    62→            guard.check_rate_limit()\n    63→\n    64→    def test_check_cost_limit_ok(self, guard):\n    65→        guard.check_cost_limit()\n    66→\n    67→    def test_check_cost_limit_exceeded(self, guard, state_mgr):\n    68→        guard.config.safety.max_cost_usd_per_hour = 0.10\n    69→        now = time.time()\n    70→        state_mgr.record_cycle(CycleRecord(\n    71→            timestamp=now, task_description=\"A\", cost_usd=0.15,\n    72→        ))\n    73→        with pytest.raises(SafetyError, match=\"Cost limit\"):\n    74→            guard.check_cost_limit()\n    75→\n    76→    def test_check_consecutive_failures_ok(self, guard):\n    77→        guard.check_consecutive_failures()\n    78→\n    79→    def test_check_consecutive_failures_exceeded(self, guard, state_mgr):\n    80→        guard.config.safety.max_consecutive_failures = 2\n    81→        now = time.time()\n    82→        state_mgr.record_cycle(CycleRecord(\n    83→            timestamp=now, task_description=\"A\", success=False,\n    84→        ))\n    85→        state_mgr.record_cycle(CycleRecord(\n    86→            timestamp=now, task_description=\"B\", success=False,\n    87→        ))\n    88→        with pytest.raises(SafetyError, match=\"consecutive failures\"):\n    89→            guard.check_consecutive_failures()\n    90→\n    91→    def test_check_protected_files(self, guard):\n    92→        guard.check_protected_files([\"foo.py\", \"bar.py\"])  # OK\n    93→\n    94→    def test_check_protected_files_violation(self, guard):\n    95→        with pytest.raises(SafetyError, match=\"Protected files\"):\n    96→            guard.check_protected_files([\"main.py\", \"other.py\"])\n    97→\n    98→    def test_check_protected_files_nested_path(self, guard):\n    99→        guard.check_protected_files([\"src/main.py\", \"other.py\"])  # OK, different file\n   100→\n   101→    def test_check_protected_files_deep_nested_path(self, guard):\n   102→        guard.check_protected_files([\"a/b/c/config.yaml\"])  # OK, different file\n   103→\n   104→    def test_check_protected_files_relative_path(self, guard):\n   105→        with pytest.raises(SafetyError, match=\"Protected files\"):\n   106→            guard.check_protected_files([\"./main.py\"])\n   107→\n   108→    def test_check_protected_files_safe_nested(self, guard):\n   109→        guard.check_protected_files([\"src/foo.py\"])  # OK, no false positive\n   110→\n   111→    def test_check_file_count_ok(self, guard):\n   112→        guard.check_file_count([\"a.py\", \"b.py\"])\n   113→\n   114→    def test_check_file_count_exceeded(self, guard):\n   115→        guard.config.orchestrator.max_changed_files = 2\n   116→        with pytest.raises(SafetyError, match=\"Too many files\"):\n   117→            guard.check_file_count([\"a.py\", \"b.py\", \"c.py\"])\n   118→\n   119→    def test_pre_flight_checks(self, guard):\n   120→        guard.pre_flight_checks()  # Should not raise with defaults\n   121→\n   122→    def test_post_claude_checks(self, guard):\n   123→        guard.post_claude_checks([\"foo.py\"])  # Should not raise\n   124→\n   125→    def test_lock_reacquire_after_release(self, guard):\n   126→        \"\"\"Lock can be re-acquired after release even though file persists.\"\"\"\n   127→        guard.acquire_lock()\n   128→        guard.release_lock()\n   129→        # File persists, but lock should be re-acquirable\n   130→        guard.acquire_lock()\n   131→        assert guard._lock_fd is not None\n   132→        guard.release_lock()\n   133→\n   134→    def test_check_protected_files_symlink(self, guard, tmp_path):\n   135→        \"\"\"Symlinks to protected files should be detected.\"\"\"\n   136→        guard.config.target_dir = str(tmp_path)\n   137→        (tmp_path / \"main.py\").write_text(\"# protected\\n\")\n   138→        (tmp_path / \"link_to_main.py\").symlink_to(tmp_path / \"main.py\")\n   139→        with pytest.raises(SafetyError, match=\"Protected files\"):\n   140→            guard.check_protected_files([\"link_to_main.py\"])\n   141→\n   142→    def test_check_protected_files_nonexistent_file(self, guard, tmp_path):\n   143→        \"\"\"When a changed file doesn't exist on disk, normpath comparison still catches it.\"\"\"\n   144→        guard.config.target_dir = str(tmp_path)\n   145→        # Neither file exists on disk, but normpath match should still detect it\n   146→        with pytest.raises(SafetyError, match=\"Protected files\"):\n   147→            guard.check_protected_files([\"./main.py\"])\n   148→\n   149→    def test_check_protected_files_samefile_false_skips_realpath(self, guard, tmp_path):\n   150→        \"\"\"When samefile returns False, realpath fallback should be skipped.\"\"\"\n   151→        guard.config.target_dir = str(tmp_path)\n   152→        # Create the changed file and all protected files so samefile can be used\n   153→        (tmp_path / \"changed.py\").write_text(\"# changed\\n\")\n   154→        for p in guard.config.safety.protected_files:\n   155→            (tmp_path / p).write_text(\"# protected\\n\")\n   156→        # Track whether realpath is called\n   157→        original_realpath = os.path.realpath\n   158→        realpath_calls = []\n   159→\n   160→        def tracking_realpath(p):\n   161→            realpath_calls.append(p)\n   162→            return original_realpath(p)\n   163→\n   164→        with patch(\"safety.os.path.realpath\", side_effect=tracking_realpath):\n   165→            guard.check_protected_files([\"changed.py\"])\n   166→        # samefile returned False for all protected files, so realpath should not be called\n   167→        assert len(realpath_calls) == 0\n   168→\n   169→\n   170→class TestFailureRecoveryGuard:\n   171→    def test_file_based_reset_trigger(self, guard, state_mgr, tmp_path):\n   172→        \"\"\"The state/reset_failures file clears lockout and gets deleted.\"\"\"\n   173→        guard.config.safety.max_consecutive_failures = 3\n   174→        guard.config.paths.state_dir = str(tmp_path)\n   175→        now = time.time()\n   176→        for i in range(3):\n   177→            state_mgr.record_cycle(CycleRecord(\n   178→                timestamp=now + i,\n   179→                task_description=f\"Fail {i}\",\n   180→                success=False,\n   181→            ))\n   182→        # Without reset file, should raise\n   183→        with pytest.raises(SafetyError, match=\"consecutive failures\"):\n   184→            guard.check_consecutive_failures()\n   185→\n   186→        # Create reset file\n   187→        reset_file = tmp_path / \"reset_failures\"\n   188→        reset_file.write_text(\"\")\n   189→\n   190→        # Now should NOT raise, and file should be deleted\n   191→        guard.check_consecutive_failures()\n   192→        assert not reset_file.exists()\n   193→        assert state_mgr.get_consecutive_failures() == 0\n   194→\n   195→    def test_time_based_auto_reset(self, guard, state_mgr):\n   196→        \"\"\"Auto-reset triggers when idle for 1+ hour.\"\"\"\n   197→        guard.config.safety.max_consecutive_failures = 3\n   198→        old_time = time.time() - 7200  # 2 hours ago\n   199→        for i in range(3):\n   200→            state_mgr.record_cycle(CycleRecord(\n   201→                timestamp=old_time + i,\n   202→                task_description=f\"Fail {i}\",\n   203→                success=False,\n   204→            ))\n   205→        # Should NOT raise because idle for > 1 hour\n   206→        guard.check_consecutive_failures()\n   207→        assert state_mgr.get_consecutive_failures() == 0\n   208→\n   209→    def test_no_auto_reset_when_recent(self, guard, state_mgr):\n   210→        \"\"\"No auto-reset when failures are recent.\"\"\"\n   211→        guard.config.safety.max_consecutive_failures = 3\n   212→        now = time.time()\n   213→        for i in range(3):\n   214→            state_mgr.record_cycle(CycleRecord(\n   215→                timestamp=now - 10 + i,  # Very recent\n   216→                task_description=f\"Fail {i}\",\n   217→                success=False,\n   218→            ))\n   219→        with pytest.raises(SafetyError, match=\"consecutive failures\"):\n   220→            guard.check_consecutive_failures()\n   221→\n   222→    def test_error_message_includes_reset_instructions(self, guard, state_mgr):\n   223→        \"\"\"Error message tells user how to reset.\"\"\"\n   224→        guard.config.safety.max_consecutive_failures = 2\n   225→        now = time.time()\n   226→        for i in range(2):\n   227→            state_mgr.record_cycle(CycleRecord(\n   228→                timestamp=now - 10 + i,\n   229→                task_description=f\"Fail {i}\",\n   230→                success=False,\n   231→            ))\n   232→        with pytest.raises(SafetyError, match=\"touch state/reset_failures\"):\n   233→            guard.check_consecutive_failures()\n   234→\n   235→\n   236→class TestMemoryCheck:\n   237→    def test_check_memory_ok_on_current_system(self, guard):\n   238→        \"\"\"Memory check should not raise on a system with sufficient RAM.\"\"\"\n   239→        guard.config.safety.min_memory_mb = 1  # 1 MB — any system has this\n   240→        guard.check_memory()\n   241→\n   242→    def test_check_memory_disabled_when_zero(self, guard):\n   243→        \"\"\"Memory check should be skipped when min_memory_mb is 0.\"\"\"\n   244→        guard.config.safety.min_memory_mb = 0\n   245→        guard.check_memory()  # Should not raise\n   246→\n   247→    @patch(\"platform.system\", return_value=\"Linux\")\n   248→    def test_check_memory_low_on_linux(self, mock_system, guard):\n   249→        \"\"\"Memory check raises SafetyError when available RAM is low (Linux).\"\"\"\n   250→        guard.config.safety.min_memory_mb = 999_999\n   251→        meminfo = \"MemTotal:       16384000 kB\\nMemAvailable:       1024 kB\\n\"\n   252→        with patch(\"builtins.open\", create=True) as mock_open:\n   253→            from unittest.mock import mock_open as _mock_open\n   254→            mock_open.return_value = _mock_open(read_data=meminfo)()\n   255→            with pytest.raises(SafetyError, match=\"Low memory\"):\n   256→                guard.check_memory()\n   257→\n   258→    @patch(\"platform.system\", return_value=\"Linux\")\n   259→    def test_check_memory_sufficient_on_linux(self, mock_system, guard):\n   260→        \"\"\"Memory check passes when available RAM exceeds minimum (Linux).\"\"\"\n   261→        guard.config.safety.min_memory_mb = 100\n   262→        meminfo = \"MemTotal:       16384000 kB\\nMemAvailable:       512000 kB\\n\"\n   263→        with patch(\"builtins.open\", create=True) as mock_open:\n   264→            from unittest.mock import mock_open as _mock_open\n   265→            mock_open.return_value = _mock_open(read_data=meminfo)()\n   266→            guard.check_memory()\n   267→\n   268→    @patch(\"platform.system\", return_value=\"Linux\")\n   269→    def test_check_memory_proc_unreadable(self, mock_system, guard):\n   270→        \"\"\"Memory check is skipped gracefully when /proc/meminfo is unreadable.\"\"\"\n   271→        guard.config.safety.min_memory_mb = 256\n   272→        with patch(\"builtins.open\", side_effect=OSError(\"Permission denied\")):\n   273→            guard.check_memory()  # Should not raise\n   274→\n   275→    @patch(\"platform.system\", return_value=\"Windows\")\n   276→    def test_check_memory_unsupported_platform(self, mock_system, guard):\n   277→        \"\"\"Memory check is skipped on unsupported platforms.\"\"\"\n   278→        guard.config.safety.min_memory_mb = 256\n   279→        guard.check_memory()  # Should not raise\n   280→\n   281→    @patch(\"platform.system\", return_value=\"Linux\")\n   282→    def test_check_memory_warning_threshold(self, mock_system, guard, caplog):\n   283→        \"\"\"Memory check logs warning when approaching minimum.\"\"\"\n   284→        import logging\n   285→        guard.config.safety.min_memory_mb = 300\n   286→        # 350 MB is between min (300) and 1.5x min (450), should warn\n   287→        meminfo = \"MemAvailable:       358400 kB\\n\"  # ~350 MB\n   288→        with patch(\"builtins.open\", create=True) as mock_open:\n   289→            from unittest.mock import mock_open as _mock_open\n   290→            mock_open.return_value = _mock_open(read_data=meminfo)()\n   291→            with caplog.at_level(logging.WARNING):\n   292→                guard.check_memory()\n   293→        assert any(\"approaching minimum\" in r.message for r in caplog.records)\n   294→\n   295→    def test_pre_flight_checks_includes_memory(self, guard):\n   296→        \"\"\"pre_flight_checks should call check_memory.\"\"\"\n   297→        guard.config.safety.min_memory_mb = 1\n   298→        with patch.object(guard, 'check_memory') as mock_mem:\n   299→            with patch.object(guard, 'check_disk_space'):\n   300→                with patch.object(guard, 'check_rate_limit'):\n   301→                    with patch.object(guard, 'check_cost_limit'):\n   302→                        with patch.object(guard, 'check_consecutive_failures'):\n   303→                            guard.pre_flight_checks()\n   304→            mock_mem.assert_called_once()\n   305→"}]},"parent_tool_use_id":null,"session_id":"c65566fb-ead9-49f5-afe9-3b595f066c68","uuid":"33146dd9-d46c-4127-8485-e470b0f48fcf","tool_use_result":{"type":"text","file":{"filePath":"/Users/sameertkhanna/Documents/auto_claude_code/tests/test_safety.py","content":"\"\"\"Tests for safety module.\"\"\"\n\nimport os\nimport time\nfrom pathlib import Path\nfrom unittest.mock import MagicMock, patch\n\nimport pytest\n\nfrom config_schema import Config\nfrom safety import SafetyError, SafetyGuard\nfrom state import CycleRecord, StateManager\n\n\n@pytest.fixture\ndef state_mgr(tmp_path, default_config):\n    default_config.paths.history_file = str(tmp_path / \"history.json\")\n    return StateManager(default_config)\n\n\n@pytest.fixture\ndef guard(tmp_path, default_config, state_mgr):\n    default_config.paths.lock_file = str(tmp_path / \"lock.pid\")\n    return SafetyGuard(default_config, state_mgr)\n\n\nclass TestSafetyGuard:\n    def test_acquire_and_release_lock(self, guard):\n        guard.acquire_lock()\n        assert guard._lock_fd is not None\n        assert guard.lock_path.exists()\n        guard.release_lock()\n        assert guard._lock_fd is None\n        # Lock file should persist after release (close releases flock)\n        assert guard.lock_path.exists()\n\n    def test_double_lock_fails(self, guard, tmp_path, default_config, state_mgr):\n        guard.acquire_lock()\n        guard2 = SafetyGuard(default_config, state_mgr)\n        with pytest.raises(SafetyError, match=\"already running\"):\n            guard2.acquire_lock()\n        guard.release_lock()\n\n    def test_check_disk_space_ok(self, guard):\n        # Should not raise on a normal system\n        guard.check_disk_space()\n\n    def test_check_disk_space_low(self, guard):\n        guard.config.safety.min_disk_space_mb = 999_999_999\n        with pytest.raises(SafetyError, match=\"disk space\"):\n            guard.check_disk_space()\n\n    def test_check_rate_limit_ok(self, guard):\n        guard.check_rate_limit()\n\n    def test_check_rate_limit_exceeded(self, guard, state_mgr):\n        guard.config.safety.max_cycles_per_hour = 2\n        now = time.time()\n        state_mgr.record_cycle(CycleRecord(timestamp=now, task_description=\"A\"))\n        state_mgr.record_cycle(CycleRecord(timestamp=now, task_description=\"B\"))\n        with pytest.raises(SafetyError, match=\"Rate limit\"):\n            guard.check_rate_limit()\n\n    def test_check_cost_limit_ok(self, guard):\n        guard.check_cost_limit()\n\n    def test_check_cost_limit_exceeded(self, guard, state_mgr):\n        guard.config.safety.max_cost_usd_per_hour = 0.10\n        now = time.time()\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now, task_description=\"A\", cost_usd=0.15,\n        ))\n        with pytest.raises(SafetyError, match=\"Cost limit\"):\n            guard.check_cost_limit()\n\n    def test_check_consecutive_failures_ok(self, guard):\n        guard.check_consecutive_failures()\n\n    def test_check_consecutive_failures_exceeded(self, guard, state_mgr):\n        guard.config.safety.max_consecutive_failures = 2\n        now = time.time()\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now, task_description=\"A\", success=False,\n        ))\n        state_mgr.record_cycle(CycleRecord(\n            timestamp=now, task_description=\"B\", success=False,\n        ))\n        with pytest.raises(SafetyError, match=\"consecutive failures\"):\n            guard.check_consecutive_failures()\n\n    def test_check_protected_files(self, guard):\n        guard.check_protected_files([\"foo.py\", \"bar.py\"])  # OK\n\n    def test_check_protected_files_violation(self, guard):\n        with pytest.raises(SafetyError, match=\"Protected files\"):\n            guard.check_protected_files([\"main.py\", \"other.py\"])\n\n    def test_check_protected_files_nested_path(self, guard):\n        guard.check_protected_files([\"src/main.py\", \"other.py\"])  # OK, different file\n\n    def test_check_protected_files_deep_nested_path(self, guard):\n        guard.check_protected_files([\"a/b/c/config.yaml\"])  # OK, different file\n\n    def test_check_protected_files_relative_path(self, guard):\n        with pytest.raises(SafetyError, match=\"Protected files\"):\n            guard.check_protected_files([\"./main.py\"])\n\n    def test_check_protected_files_safe_nested(self, guard):\n        guard.check_protected_files([\"src/foo.py\"])  # OK, no false positive\n\n    def test_check_file_count_ok(self, guard):\n        guard.check_file_count([\"a.py\", \"b.py\"])\n\n    def test_check_file_count_exceeded(self, guard):\n        guard.config.orchestrator.max_changed_files = 2\n        with pytest.raises(SafetyError, match=\"Too many files\"):\n            guard.check_file_count([\"a.py\", \"b.py\", \"c.py\"])\n\n    def test_pre_flight_checks(self, guard):\n        guard.pre_flight_checks()  # Should not raise with defaults\n\n    def test_post_claude_checks(self, guard):\n        guard.post_claude_checks([\"foo.py\"])  # Should not raise\n\n    def test_lock_reacquire_after_release(self, guard):\n        \"\"\"Lock can be re-acquired after release even though file persists.\"\"\"\n        guard.acquire_lock()\n        guard.release_lock()\n        # File persists, but lock should be re-acquirable\n        guard.acquire_lock()\n        assert guard._lock_fd is not None\n        guard.release_lock()\n\n    def test_check_protected_files_symlink(self, guard, tmp_path):\n        \"\"\"Symlinks to protected files should be detected.\"\"\"\n        guard.config.target_dir = str(tmp_path)\n        (tmp_path / \"main.py\").write_text(\"# protected\\n\")\n        (tmp_path / \"link_to_main.py\").symlink_to(tmp_path / \"main.py\")\n        with pytest.raises(SafetyError, match=\"Protected files\"):\n            guard.check_protected_files([\"link_to_main.py\"])\n\n    def test_check_protected_files_nonexistent_file(self, guard, tmp_path):\n        \"\"\"When a changed file doesn't exist on disk, normpath comparison still catches it.\"\"\"\n        guard.config.target_dir = str(tmp_path)\n        # Neither file exists on disk, but normpath match should still detect it\n        with pytest.raises(SafetyError, match=\"Protected files\"):\n            guard.check_protected_files([\"./main.py\"])\n\n    def test_check_protected_files_samefile_false_skips_realpath(self, guard, tmp_path):\n        \"\"\"When samefile returns False, realpath fallback should be skipped.\"\"\"\n        guard.config.target_dir = str(tmp_path)\n        # Create the changed file and all protected files so samefile can be used\n        (tmp_path / \"changed.py\").write_text(\"# changed\\n\")\n        for p in guard.config.safety.protected_files:\n            (tmp_path / p).write_text(\"# protected\\n\")\n        # Track whether realpath is called\n        original_realpath = os.path.realpath\n        realpath_calls = []\n\n        def tracking_realpath(p):\n            realpath_calls.append(p)\n            return original_realpath(p)\n\n        with patch(\"safety.os.path.realpath\", side_effect=tracking_realpath):\n            guard.check_protected_files([\"changed.py\"])\n        # samefile returned False for all protected files, so realpath should not be called\n        assert len(realpath_calls) == 0\n\n\nclass TestFailureRecoveryGuard:\n    def test_file_based_reset_trigger(self, guard, state_mgr, tmp_path):\n        \"\"\"The state/reset_failures file clears lockout and gets deleted.\"\"\"\n        guard.config.safety.max_consecutive_failures = 3\n        guard.config.paths.state_dir = str(tmp_path)\n        now = time.time()\n        for i in range(3):\n            state_mgr.record_cycle(CycleRecord(\n                timestamp=now + i,\n                task_description=f\"Fail {i}\",\n                success=False,\n            ))\n        # Without reset file, should raise\n        with pytest.raises(SafetyError, match=\"consecutive failures\"):\n            guard.check_consecutive_failures()\n\n        # Create reset file\n        reset_file = tmp_path / \"reset_failures\"\n        reset_file.write_text(\"\")\n\n        # Now should NOT raise, and file should be deleted\n        guard.check_consecutive_failures()\n        assert not reset_file.exists()\n        assert state_mgr.get_consecutive_failures() == 0\n\n    def test_time_based_auto_reset(self, guard, state_mgr):\n        \"\"\"Auto-reset triggers when idle for 1+ hour.\"\"\"\n        guard.config.safety.max_consecutive_failures = 3\n        old_time = time.time() - 7200  # 2 hours ago\n        for i in range(3):\n            state_mgr.record_cycle(CycleRecord(\n                timestamp=old_time + i,\n                task_description=f\"Fail {i}\",\n                success=False,\n            ))\n        # Should NOT raise because idle for > 1 hour\n        guard.check_consecutive_failures()\n        assert state_mgr.get_consecutive_failures() == 0\n\n    def test_no_auto_reset_when_recent(self, guard, state_mgr):\n        \"\"\"No auto-reset when failures are recent.\"\"\"\n        guard.config.safety.max_consecutive_failures = 3\n        now = time.time()\n        for i in range(3):\n            state_mgr.record_cycle(CycleRecord(\n                timestamp=now - 10 + i,  # Very recent\n                task_description=f\"Fail {i}\",\n                success=False,\n            ))\n        with pytest.raises(SafetyError, match=\"consecutive failures\"):\n            guard.check_consecutive_failures()\n\n    def test_error_message_includes_reset_instructions(self, guard, state_mgr):\n        \"\"\"Error message tells user how to reset.\"\"\"\n        guard.config.safety.max_consecutive_failures = 2\n        now = time.time()\n        for i in range(2):\n            state_mgr.record_cycle(CycleRecord(\n                timestamp=now - 10 + i,\n                task_description=f\"Fail {i}\",\n                success=False,\n            ))\n        with pytest.raises(SafetyError, match=\"touch state/reset_failures\"):\n            guard.check_consecutive_failures()\n\n\nclass TestMemoryCheck:\n    def test_check_memory_ok_on_current_system(self, guard):\n        \"\"\"Memory check should not raise on a system with sufficient RAM.\"\"\"\n        guard.config.safety.min_memory_mb = 1  # 1 MB — any system has this\n        guard.check_memory()\n\n    def test_check_memory_disabled_when_zero(self, guard):\n        \"\"\"Memory check should be skipped when min_memory_mb is 0.\"\"\"\n        guard.config.safety.min_memory_mb = 0\n        guard.check_memory()  # Should not raise\n\n    @patch(\"platform.system\", return_value=\"Linux\")\n    def test_check_memory_low_on_linux(self, mock_system, guard):\n        \"\"\"Memory check raises SafetyError when available RAM is low (Linux).\"\"\"\n        guard.config.safety.min_memory_mb = 999_999\n        meminfo = \"MemTotal:       16384000 kB\\nMemAvailable:       1024 kB\\n\"\n        with patch(\"builtins.open\", create=True) as mock_open:\n            from unittest.mock import mock_open as _mock_open\n            mock_open.return_value = _mock_open(read_data=meminfo)()\n            with pytest.raises(SafetyError, match=\"Low memory\"):\n                guard.check_memory()\n\n    @patch(\"platform.system\", return_value=\"Linux\")\n    def test_check_memory_sufficient_on_linux(self, mock_system, guard):\n        \"\"\"Memory check passes when available RAM exceeds minimum (Linux).\"\"\"\n        guard.config.safety.min_memory_mb = 100\n        meminfo = \"MemTotal:       16384000 kB\\nMemAvailable:       512000 kB\\n\"\n        with patch(\"builtins.open\", create=True) as mock_open:\n            from unittest.mock import mock_open as _mock_open\n            mock_open.return_value = _mock_open(read_data=meminfo)()\n            guard.check_memory()\n\n    @patch(\"platform.system\", return_value=\"Linux\")\n    def test_check_memory_proc_unreadable(self, mock_system, guard):\n        \"\"\"Memory check is skipped gracefully when /proc/meminfo is unreadable.\"\"\"\n        guard.config.safety.min_memory_mb = 256\n        with patch(\"builtins.open\", side_effect=OSError(\"Permission denied\")):\n            guard.check_memory()  # Should not raise\n\n    @patch(\"platform.system\", return_value=\"Windows\")\n    def test_check_memory_unsupported_platform(self, mock_system, guard):\n        \"\"\"Memory check is skipped on unsupported platforms.\"\"\"\n        guard.config.safety.min_memory_mb = 256\n        guard.check_memory()  # Should not raise\n\n    @patch(\"platform.system\", return_value=\"Linux\")\n    def test_check_memory_warning_threshold(self, mock_system, guard, caplog):\n        \"\"\"Memory check logs warning when approaching minimum.\"\"\"\n        import logging\n        guard.config.safety.min_memory_mb = 300\n        # 350 MB is between min (300) and 1.5x min (450), should warn\n        meminfo = \"MemAvailable:       358400 kB\\n\"  # ~350 MB\n        with patch(\"builtins.open\", create=True) as mock_open:\n            from unittest.mock import mock_open as _mock_open\n            mock_open.return_value = _mock_open(read_data=meminfo)()\n            with caplog.at_level(logging.WARNING):\n                guard.check_memory()\n        assert any(\"approaching minimum\" in r.message for r in caplog.records)\n\n    def test_pre_flight_checks_includes_memory(self, guard):\n        \"\"\"pre_flight_checks should call check_memory.\"\"\"\n        guard.config.safety.min_memory_mb = 1\n        with patch.object(guard, 'check_memory') as mock_mem:\n            with patch.object(guard, 'check_disk_space'):\n                with patch.object(guard, 'check_rate_limit'):\n                    with patch.object(guard, 'check_cost_limit'):\n                        with patch.object(guard, 'check_consecutive_failures'):\n                            guard.pre_flight_checks()\n            mock_mem.assert_called_once()\n","numLines":305,"startLine":1,"totalLines":305}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_vrtx_01HZJea2VpWwzjrbGG4RcnZv","type":"tool_result","content":"    40→class GracefulDegradation:\n    41→    \"\"\"Manages graceful degradation when approaching rate or cost limits.\n    42→\n    43→    Instead of hard-stopping, this reduces batch size and increases sleep\n    44→    intervals to allow the system to continue operating at reduced capacity.\n    45→    \"\"\"\n    46→\n    47→    def __init__(self, config: Config):\n    48→        self.config = config\n    49→        self._degraded = False\n    50→        self._degradation_level = 0  # 0=normal, 1=mild, 2=moderate, 3=severe\n    51→\n    52→    @property\n    53→    def is_degraded(self) -> bool:\n    54→        return self._degraded\n    55→\n    56→    @property\n    57→    def degradation_level(self) -> int:\n    58→        return self._degradation_level\n    59→\n    60→    def check_and_adjust(\n    61→        self,\n    62→        cycles_per_hour: int,\n    63→        cost_per_hour: float,\n    64→    ) -> dict:\n    65→        \"\"\"Check proximity to limits and compute adjustments.\n    66→\n    67→        Returns a dict with:\n    68→            - degraded: whether we're in degraded mode\n    69→            - level: 0-3 severity level\n    70→            - batch_size_factor: multiplier for batch size (0.25-1.0)\n    71→            - sleep_multiplier: multiplier for sleep interval (1.0-4.0)\n    72→            - reason: human-readable reason for degradation\n    73→        \"\"\"\n    74→        rate_limit = self.config.safety.max_cycles_per_hour\n    75→        cost_limit = self.config.safety.max_cost_usd_per_hour\n    76→\n    77→        rate_pct = (cycles_per_hour / rate_limit * 100) if rate_limit > 0 else 0\n    78→        cost_pct = (cost_per_hour / cost_limit * 100) if cost_limit > 0 else 0\n    79→\n    80→        max_pct = max(rate_pct, cost_pct)\n    81→\n    82→        reasons = []\n    83→        if rate_pct >= 70:\n    84→            reasons.append(f\"rate at {rate_pct:.0f}% of limit ({cycles_per_hour}/{rate_limit})\")\n    85→        if cost_pct >= 70:\n    86→            reasons.append(f\"cost at {cost_pct:.0f}% of limit (${cost_per_hour:.2f}/${cost_limit:.2f})\")\n    87→\n    88→        if max_pct >= 95:\n    89→            self._degradation_level = 3\n    90→            self._degraded = True\n    91→            return {\n    92→                \"degraded\": True,\n    93→                \"level\": 3,\n    94→                \"batch_size_factor\": 0.25,\n    95→                \"sleep_multiplier\": 4.0,\n    96→                \"reason\": \"Severe: \" + \"; \".join(reasons),\n    97→            }\n    98→        elif max_pct >= 85:\n    99→            self._degradation_level = 2\n   100→            self._degraded = True\n   101→            return {\n   102→                \"degraded\": True,\n   103→                \"level\": 2,\n   104→                \"batch_size_factor\": 0.5,\n   105→                \"sleep_multiplier\": 3.0,\n   106→                \"reason\": \"Moderate: \" + \"; \".join(reasons),\n   107→            }\n   108→        elif max_pct >= 70:\n   109→            self._degradation_level = 1\n   110→            self._degraded = True\n   111→            return {\n   112→                \"degraded\": True,\n   113→                \"level\": 1,\n   114→                \"batch_size_factor\": 0.75,\n   115→                \"sleep_multiplier\": 2.0,\n   116→                \"reason\": \"Mild: \" + \"; \".join(reasons),\n   117→            }\n   118→        else:\n   119→            self._degradation_level = 0"}]},"parent_tool_use_id":null,"session_id":"c65566fb-ead9-49f5-afe9-3b595f066c68","uuid":"6f3e5d23-67a2-49cc-abcd-7bbb7cc73506","tool_use_result":{"type":"text","file":{"filePath":"/Users/sameertkhanna/Documents/auto_claude_code/safety.py","content":"class GracefulDegradation:\n    \"\"\"Manages graceful degradation when approaching rate or cost limits.\n\n    Instead of hard-stopping, this reduces batch size and increases sleep\n    intervals to allow the system to continue operating at reduced capacity.\n    \"\"\"\n\n    def __init__(self, config: Config):\n        self.config = config\n        self._degraded = False\n        self._degradation_level = 0  # 0=normal, 1=mild, 2=moderate, 3=severe\n\n    @property\n    def is_degraded(self) -> bool:\n        return self._degraded\n\n    @property\n    def degradation_level(self) -> int:\n        return self._degradation_level\n\n    def check_and_adjust(\n        self,\n        cycles_per_hour: int,\n        cost_per_hour: float,\n    ) -> dict:\n        \"\"\"Check proximity to limits and compute adjustments.\n\n        Returns a dict with:\n            - degraded: whether we're in degraded mode\n            - level: 0-3 severity level\n            - batch_size_factor: multiplier for batch size (0.25-1.0)\n            - sleep_multiplier: multiplier for sleep interval (1.0-4.0)\n            - reason: human-readable reason for degradation\n        \"\"\"\n        rate_limit = self.config.safety.max_cycles_per_hour\n        cost_limit = self.config.safety.max_cost_usd_per_hour\n\n        rate_pct = (cycles_per_hour / rate_limit * 100) if rate_limit > 0 else 0\n        cost_pct = (cost_per_hour / cost_limit * 100) if cost_limit > 0 else 0\n\n        max_pct = max(rate_pct, cost_pct)\n\n        reasons = []\n        if rate_pct >= 70:\n            reasons.append(f\"rate at {rate_pct:.0f}% of limit ({cycles_per_hour}/{rate_limit})\")\n        if cost_pct >= 70:\n            reasons.append(f\"cost at {cost_pct:.0f}% of limit (${cost_per_hour:.2f}/${cost_limit:.2f})\")\n\n        if max_pct >= 95:\n            self._degradation_level = 3\n            self._degraded = True\n            return {\n                \"degraded\": True,\n                \"level\": 3,\n                \"batch_size_factor\": 0.25,\n                \"sleep_multiplier\": 4.0,\n                \"reason\": \"Severe: \" + \"; \".join(reasons),\n            }\n        elif max_pct >= 85:\n            self._degradation_level = 2\n            self._degraded = True\n            return {\n                \"degraded\": True,\n                \"level\": 2,\n                \"batch_size_factor\": 0.5,\n                \"sleep_multiplier\": 3.0,\n                \"reason\": \"Moderate: \" + \"; \".join(reasons),\n            }\n        elif max_pct >= 70:\n            self._degradation_level = 1\n            self._degraded = True\n            return {\n                \"degraded\": True,\n                \"level\": 1,\n                \"batch_size_factor\": 0.75,\n                \"sleep_multiplier\": 2.0,\n                \"reason\": \"Mild: \" + \"; \".join(reasons),\n            }\n        else:\n            self._degradation_level = 0","numLines":80,"startLine":40,"totalLines":546}}}
