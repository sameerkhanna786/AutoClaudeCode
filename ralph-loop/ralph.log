{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_vrtx_0118STMuz6JzH771BaDZAQ1z","type":"tool_result","content":"     1→\"\"\"Tests for conflict_resolver module and git conflict helpers.\"\"\"\n     2→\n     3→import subprocess\n     4→from pathlib import Path\n     5→from unittest.mock import MagicMock, patch, PropertyMock\n     6→\n     7→import pytest\n     8→\n     9→from claude_runner import ClaudeResult\n    10→from config_schema import Config\n    11→from conflict_resolver import ConflictResolver, CONFLICT_MARKER_RE\n    12→from git_manager import GitManager\n    13→\n    14→\n    15→# ---------------------------------------------------------------------------\n    16→# ConflictResolver._build_resolve_prompt\n    17→# ---------------------------------------------------------------------------\n    18→\n    19→class TestBuildResolvePrompt:\n    20→    def test_prompt_contains_file_path(self):\n    21→        prompt = ConflictResolver._build_resolve_prompt(\n    22→            \"src/app.py\", \"<<<<<<< HEAD\\nA\\n=======\\nB\\n>>>>>>> feat\",\n    23→            \"feat\", \"main\",\n    24→        )\n    25→        assert \"src/app.py\" in prompt\n    26→\n    27→    def test_prompt_contains_branches(self):\n    28→        prompt = ConflictResolver._build_resolve_prompt(\n    29→            \"f.py\", \"content\", \"feature-x\", \"main\",\n    30→        )\n    31→        assert \"feature-x\" in prompt\n    32→        assert \"main\" in prompt\n    33→\n    34→    def test_prompt_contains_conflicted_content(self):\n    35→        content = \"<<<<<<< HEAD\\nline_a\\n=======\\nline_b\\n>>>>>>> branch\"\n    36→        prompt = ConflictResolver._build_resolve_prompt(\n    37→            \"f.py\", content, \"branch\", \"main\",\n    38→        )\n    39→        assert content in prompt\n    40→\n    41→    def test_prompt_asks_for_code_block(self):\n    42→        prompt = ConflictResolver._build_resolve_prompt(\n    43→            \"f.py\", \"stuff\", \"b\", \"m\",\n    44→        )\n    45→        assert \"code block\" in prompt.lower()\n    46→\n    47→\n    48→# ---------------------------------------------------------------------------\n    49→# ConflictResolver._extract_resolved_content\n    50→# ---------------------------------------------------------------------------\n    51→\n    52→class TestExtractResolvedContent:\n    53→    def test_extracts_from_code_block(self):\n    54→        response = \"Here is the resolved file:\\n```python\\nresolved line\\n```\\nDone.\"\n    55→        result = ConflictResolver._extract_resolved_content(response)\n    56→        assert result == \"resolved line\\n\"\n    57→\n    58→    def test_returns_raw_text_without_code_block(self):\n    59→        response = \"resolved content here\"\n    60→        result = ConflictResolver._extract_resolved_content(response)\n    61→        assert result == \"resolved content here\"\n    62→\n    63→    def test_empty_response_returns_none(self):\n    64→        assert ConflictResolver._extract_resolved_content(\"\") is None\n    65→        assert ConflictResolver._extract_resolved_content(\"   \") is None\n    66→\n    67→    def test_none_response_returns_none(self):\n    68→        assert ConflictResolver._extract_resolved_content(None) is None\n    69→\n    70→    def test_extracts_first_code_block_when_multiple(self):\n    71→        response = \"```\\nfirst\\n```\\ntext\\n```\\nsecond\\n```\"\n    72→        result = ConflictResolver._extract_resolved_content(response)\n    73→        assert result == \"first\\n\"\n    74→\n    75→\n    76→# ---------------------------------------------------------------------------\n    77→# CONFLICT_MARKER_RE\n    78→# ---------------------------------------------------------------------------\n    79→\n    80→class TestConflictMarkerRegex:\n    81→    def test_detects_left_marker(self):\n    82→        assert CONFLICT_MARKER_RE.search(\"<<<<<<< HEAD\")\n    83→\n    84→    def test_detects_separator(self):\n    85→        assert CONFLICT_MARKER_RE.search(\"=======\")\n    86→\n    87→    def test_detects_right_marker(self):\n    88→        assert CONFLICT_MARKER_RE.search(\">>>>>>> branch\")\n    89→\n    90→    def test_clean_content_no_match(self):\n    91→        assert CONFLICT_MARKER_RE.search(\"normal code\\nmore code\") is None\n    92→\n    93→    def test_partial_markers_no_match(self):\n    94→        # Fewer than 7 characters should not match\n    95→        assert CONFLICT_MARKER_RE.search(\"<<<<<< HEAD\") is None\n    96→        assert CONFLICT_MARKER_RE.search(\"======\") is None\n    97→        assert CONFLICT_MARKER_RE.search(\">>>>>> branch\") is None\n    98→\n    99→\n   100→# ---------------------------------------------------------------------------\n   101→# ConflictResolver.resolve_conflicts (with mocked ClaudeRunner)\n   102→# ---------------------------------------------------------------------------\n   103→\n   104→class TestResolveConflicts:\n   105→    def _make_config(self, max_cost=2.0):\n   106→        config = Config()\n   107→        config.parallel.conflict_resolution_max_cost = max_cost\n   108→        return config\n   109→\n   110→    def test_successful_resolution(self, tmp_path):\n   111→        config = self._make_config()\n   112→        resolver = ConflictResolver(config)\n   113→\n   114→        # Create a conflicted file\n   115→        conflict_file = tmp_path / \"app.py\"\n   116→        conflict_file.write_text(\n   117→            \"<<<<<<< HEAD\\ndef main_version():\\n=======\\n\"\n   118→            \"def branch_version():\\n>>>>>>> feat\\n    pass\\n\"\n   119→        )\n   120→\n   121→        mock_result = ClaudeResult(\n   122→            success=True,\n   123→            result_text=\"```python\\ndef merged_version():\\n    pass\\n```\",\n   124→            cost_usd=0.05,\n   125→        )\n   126→        with patch.object(resolver, \"runner\") as mock_runner:\n   127→            mock_runner.run.return_value = mock_result\n   128→            success, cost = resolver.resolve_conflicts(\n   129→                str(tmp_path), [\"app.py\"], \"feat\", \"main\",\n   130→            )\n   131→\n   132→        assert success is True\n   133→        assert cost == 0.05\n   134→        resolved = conflict_file.read_text()\n   135→        assert \"merged_version\" in resolved\n   136→        assert \"<<<<<<\" not in resolved\n   137→\n   138→    def test_markers_in_response_rejected(self, tmp_path):\n   139→        config = self._make_config()\n   140→        resolver = ConflictResolver(config)\n   141→\n   142→        conflict_file = tmp_path / \"bad.py\"\n   143→        conflict_file.write_text(\"<<<<<<< HEAD\\nA\\n=======\\nB\\n>>>>>>> feat\\n\")\n   144→\n   145→        # Claude returns content that still has conflict markers\n   146→        mock_result = ClaudeResult(\n   147→            success=True,\n   148→            result_text=\"```\\n<<<<<<< HEAD\\nA\\n=======\\nB\\n>>>>>>> feat\\n```\",\n   149→            cost_usd=0.03,\n   150→        )\n   151→        with patch.object(resolver, \"runner\") as mock_runner:\n   152→            mock_runner.run.return_value = mock_result\n   153→            success, cost = resolver.resolve_conflicts(\n   154→                str(tmp_path), [\"bad.py\"], \"feat\", \"main\",\n   155→            )\n   156→\n   157→        assert success is False\n   158→        assert cost == 0.03\n   159→\n   160→    def test_empty_response_fails(self, tmp_path):\n   161→        config = self._make_config()\n   162→        resolver = ConflictResolver(config)\n   163→\n   164→        conflict_file = tmp_path / \"empty.py\"\n   165→        conflict_file.write_text(\"<<<<<<< HEAD\\nA\\n=======\\nB\\n>>>>>>> feat\\n\")\n   166→\n   167→        mock_result = ClaudeResult(\n   168→            success=True,\n   169→            result_text=\"\",\n   170→            cost_usd=0.01,\n   171→        )\n   172→        with patch.object(resolver, \"runner\") as mock_runner:\n   173→            mock_runner.run.return_value = mock_result\n   174→            success, cost = resolver.resolve_conflicts(\n   175→                str(tmp_path), [\"empty.py\"], \"feat\", \"main\",\n   176→            )\n   177→\n   178→        assert success is False\n   179→\n   180→    def test_claude_failure_fails(self, tmp_path):\n   181→        config = self._make_config()\n   182→        resolver = ConflictResolver(config)\n   183→\n   184→        conflict_file = tmp_path / \"fail.py\"\n   185→        conflict_file.write_text(\"<<<<<<< HEAD\\nA\\n=======\\nB\\n>>>>>>> feat\\n\")\n   186→\n   187→        mock_result = ClaudeResult(\n   188→            success=False,\n   189→            result_text=\"\",\n   190→            cost_usd=0.02,\n   191→            error=\"API error\",\n   192→        )\n   193→        with patch.object(resolver, \"runner\") as mock_runner:\n   194→            mock_runner.run.return_value = mock_result\n   195→            success, cost = resolver.resolve_conflicts(\n   196→                str(tmp_path), [\"fail.py\"], \"feat\", \"main\",\n   197→            )\n   198→\n   199→        assert success is False\n   200→        assert cost == 0.02\n   201→\n   202→    def test_cost_limit_enforced(self, tmp_path):\n   203→        config = self._make_config(max_cost=0.10)\n   204→        resolver = ConflictResolver(config)\n   205→        # Pre-load cost to exceed limit\n   206→        resolver._total_cost = 0.10\n   207→\n   208→        conflict_file = tmp_path / \"costly.py\"\n   209→        conflict_file.write_text(\"<<<<<<< HEAD\\nA\\n=======\\nB\\n>>>>>>> feat\\n\")\n   210→\n   211→        with patch.object(resolver, \"runner\") as mock_runner:\n   212→            success, cost = resolver.resolve_conflicts(\n   213→                str(tmp_path), [\"costly.py\"], \"feat\", \"main\",\n   214→            )\n   215→            # Runner should never be called because cost limit is already hit\n   216→            mock_runner.run.assert_not_called()\n   217→\n   218→        assert success is False\n   219→        assert cost == 0.10\n   220→\n   221→    def test_cost_accumulates_across_files(self, tmp_path):\n   222→        config = self._make_config(max_cost=0.10)\n   223→        resolver = ConflictResolver(config)\n   224→\n   225→        # Create two conflicted files\n   226→        (tmp_path / \"a.py\").write_text(\"<<<<<<< HEAD\\nA\\n=======\\nB\\n>>>>>>> feat\\n\")\n   227→        (tmp_path / \"b.py\").write_text(\"<<<<<<< HEAD\\nC\\n=======\\nD\\n>>>>>>> feat\\n\")\n   228→\n   229→        call_count = {\"n\": 0}\n   230→\n   231→        def mock_run(prompt):\n   232→            call_count[\"n\"] += 1\n   233→            if call_count[\"n\"] == 1:\n   234→                return ClaudeResult(\n   235→                    success=True,\n   236→                    result_text=\"```\\nresolved_a\\n```\",\n   237→                    cost_usd=0.08,\n   238→                )\n   239→            # Second call should not happen because 0.08 + anything > 0.10\n   240→            return ClaudeResult(\n   241→                success=True,\n   242→                result_text=\"```\\nresolved_b\\n```\",\n   243→                cost_usd=0.05,\n   244→            )\n   245→\n   246→        with patch.object(resolver, \"runner\") as mock_runner:\n   247→            mock_runner.run.side_effect = mock_run\n   248→            success, cost = resolver.resolve_conflicts(\n   249→                str(tmp_path), [\"a.py\", \"b.py\"], \"feat\", \"main\",\n   250→            )\n   251→\n   252→        # First file resolves (cost 0.08), then cost check fails for second (0.08 >= 0.10 is false,\n   253→        # so second file runs too) -- but our limit is 0.10 and 0.08 < 0.10 so second runs.\n   254→        # Actually 0.08 < 0.10, so the second file WILL be attempted.\n   255→        # The test validates cost tracking works correctly.\n   256→        assert cost == 0.08 + 0.05\n   257→        assert call_count[\"n\"] == 2\n   258→\n   259→    def test_missing_file_fails(self, tmp_path):\n   260→        config = self._make_config()\n   261→        resolver = ConflictResolver(config)\n   262→\n   263→        with patch.object(resolver, \"runner\") as mock_runner:\n   264→            success, cost = resolver.resolve_conflicts(\n   265→                str(tmp_path), [\"nonexistent.py\"], \"feat\", \"main\",\n   266→            )\n   267→            mock_runner.run.assert_not_called()\n   268→\n   269→        assert success is False\n   270→\n   271→\n   272→# ---------------------------------------------------------------------------\n   273→# Git helper tests (get_conflicted_files, mark_resolved_and_commit)\n   274→# ---------------------------------------------------------------------------\n   275→\n   276→class TestGetConflictedFiles:\n   277→    def test_returns_conflicted_files(self, tmp_git_repo):\n   278→        gm = GitManager(tmp_git_repo)\n   279→        # Mock _run to simulate git diff output\n   280→        mock_result = subprocess.CompletedProcess(\n   281→            args=[\"git\"], returncode=0,\n   282→            stdout=\"src/a.py\\nsrc/b.py\\n\", stderr=\"\",\n   283→        )\n   284→        with patch.object(gm, \"_run\", return_value=mock_result):\n   285→            files = gm.get_conflicted_files()\n   286→        assert files == [\"src/a.py\", \"src/b.py\"]\n   287→\n   288→    def test_returns_empty_on_failure(self, tmp_git_repo):\n   289→        gm = GitManager(tmp_git_repo)\n   290→        mock_result = subprocess.CompletedProcess(\n   291→            args=[\"git\"], returncode=1,\n   292→            stdout=\"\", stderr=\"error\",\n   293→        )\n   294→        with patch.object(gm, \"_run\", return_value=mock_result):\n   295→            files = gm.get_conflicted_files()\n   296→        assert files == []\n   297→\n   298→    def test_returns_empty_when_no_conflicts(self, tmp_git_repo):\n   299→        gm = GitManager(tmp_git_repo)\n   300→        mock_result = subprocess.CompletedProcess(\n   301→            args=[\"git\"], returncode=0,\n   302→            stdout=\"\\n\", stderr=\"\",\n   303→        )\n   304→        with patch.object(gm, \"_run\", return_value=mock_result):\n   305→            files = gm.get_conflicted_files()\n   306→        assert files == []\n   307→\n   308→    def test_strips_whitespace(self, tmp_git_repo):\n   309→        gm = GitManager(tmp_git_repo)\n   310→        mock_result = subprocess.CompletedProcess(\n   311→            args=[\"git\"], returncode=0,\n   312→            stdout=\"  file.py  \\n  other.py  \\n\", stderr=\"\",\n   313→        )\n   314→        with patch.object(gm, \"_run\", return_value=mock_result):\n   315→            files = gm.get_conflicted_files()\n   316→        assert files == [\"file.py\", \"other.py\"]\n   317→\n   318→\n   319→class TestMarkResolvedAndCommit:\n   320→    def test_empty_files_returns_empty_string(self, tmp_git_repo):\n   321→        gm = GitManager(tmp_git_repo)\n   322→        result = gm.mark_resolved_and_commit([], \"msg\")\n   323→        assert result == \"\"\n   324→\n   325→    @pytest.mark.requires_subprocess\n   326→    def test_successful_commit(self, tmp_git_repo):\n   327→        gm = GitManager(tmp_git_repo)\n   328→        # Create a file that can be staged\n   329→        Path(tmp_git_repo, \"resolved.py\").write_text(\"resolved content\")\n   330→\n   331→        calls = []\n   332→        original_run = gm._run\n   333→\n   334→        def tracking_run(*args, **kwargs):\n   335→            calls.append(args)\n   336→            return original_run(*args, **kwargs)\n   337→\n   338→        with patch.object(gm, \"_run\", side_effect=tracking_run):\n   339→            result = gm.mark_resolved_and_commit([\"resolved.py\"], \"Merge resolved\")\n   340→\n   341→        # Should have called git add, git commit, and git rev-parse\n   342→        assert result is not None\n   343→        assert len(result) == 40  # commit hash\n   344→\n   345→    def test_commit_failure_returns_none(self, tmp_git_repo):\n   346→        gm = GitManager(tmp_git_repo)\n   347→        Path(tmp_git_repo, \"file.py\").write_text(\"content\")\n   348→\n   349→        original_run = gm._run\n   350→\n   351→        def mock_run(*args, **kwargs):\n   352→            if args and args[0] == \"commit\":\n   353→                return subprocess.CompletedProcess(\n   354→                    args=[\"git\", \"commit\"], returncode=1,\n   355→                    stdout=\"\", stderr=\"commit failed\",\n   356→                )\n   357→            return original_run(*args, **kwargs)\n   358→\n   359→        with patch.object(gm, \"_run\", side_effect=mock_run):\n   360→            result = gm.mark_resolved_and_commit([\"file.py\"], \"msg\")\n   361→\n   362→        assert result is None\n   363→\n   364→\n   365→# ---------------------------------------------------------------------------\n   366→# Integration-style: real merge conflict in a git repo\n   367→# ---------------------------------------------------------------------------\n   368→\n   369→class TestGetConflictedFilesRealRepo:\n   370→    @pytest.mark.requires_subprocess\n   371→    def test_detects_real_merge_conflict(self, tmp_git_repo):\n   372→        \"\"\"Create a real merge conflict and verify get_conflicted_files detects it.\"\"\"\n   373→        gm = GitManager(tmp_git_repo)\n   374→        original_branch = gm.get_current_branch()\n   375→\n   376→        # Create a branch and modify README.md\n   377→        wt_path = str(Path(tmp_git_repo) / \".worktrees\" / \"conflict-test\")\n   378→        Path(wt_path).parent.mkdir(parents=True, exist_ok=True)\n   379→        gm.create_worktree(wt_path, \"conflict-branch\")\n   380→\n   381→        wt_gm = GitManager(wt_path)\n   382→        Path(wt_path, \"README.md\").write_text(\"# Branch version\\n\")\n   383→        wt_gm.commit(\"Branch change\", files=[\"README.md\"])\n   384→        gm.remove_worktree(wt_path, force=True)\n   385→\n   386→        # Modify the same file on main\n   387→        Path(tmp_git_repo, \"README.md\").write_text(\"# Main version\\n\")\n   388→        gm.commit(\"Main change\", files=[\"README.md\"])\n   389→\n   390→        # Attempt merge -- should conflict\n   391→        merge_result = gm._run(\"merge\", \"--no-commit\", \"--no-ff\", \"conflict-branch\", check=False)\n   392→        # The merge should fail or leave conflicts\n   393→        conflicted = gm.get_conflicted_files()\n   394→\n   395→        if conflicted:\n   396→            assert \"README.md\" in conflicted\n   397→\n   398→        # Clean up\n   399→        gm.abort_merge()\n   400→        gm._run(\"checkout\", \".\", check=False)\n   401→        gm._run(\"clean\", \"-fd\", check=False)\n   402→        gm.delete_branch(\"conflict-branch\", force=True)\n   403→"}]},"parent_tool_use_id":null,"session_id":"280e0b4d-1be2-481e-8af2-461e3680d862","uuid":"f1fa8441-ee19-45cd-a8f7-12bcbbb3257b","tool_use_result":{"type":"text","file":{"filePath":"/Users/sameertkhanna/Documents/auto_claude_code/tests/test_conflict_resolver.py","content":"\"\"\"Tests for conflict_resolver module and git conflict helpers.\"\"\"\n\nimport subprocess\nfrom pathlib import Path\nfrom unittest.mock import MagicMock, patch, PropertyMock\n\nimport pytest\n\nfrom claude_runner import ClaudeResult\nfrom config_schema import Config\nfrom conflict_resolver import ConflictResolver, CONFLICT_MARKER_RE\nfrom git_manager import GitManager\n\n\n# ---------------------------------------------------------------------------\n# ConflictResolver._build_resolve_prompt\n# ---------------------------------------------------------------------------\n\nclass TestBuildResolvePrompt:\n    def test_prompt_contains_file_path(self):\n        prompt = ConflictResolver._build_resolve_prompt(\n            \"src/app.py\", \"<<<<<<< HEAD\\nA\\n=======\\nB\\n>>>>>>> feat\",\n            \"feat\", \"main\",\n        )\n        assert \"src/app.py\" in prompt\n\n    def test_prompt_contains_branches(self):\n        prompt = ConflictResolver._build_resolve_prompt(\n            \"f.py\", \"content\", \"feature-x\", \"main\",\n        )\n        assert \"feature-x\" in prompt\n        assert \"main\" in prompt\n\n    def test_prompt_contains_conflicted_content(self):\n        content = \"<<<<<<< HEAD\\nline_a\\n=======\\nline_b\\n>>>>>>> branch\"\n        prompt = ConflictResolver._build_resolve_prompt(\n            \"f.py\", content, \"branch\", \"main\",\n        )\n        assert content in prompt\n\n    def test_prompt_asks_for_code_block(self):\n        prompt = ConflictResolver._build_resolve_prompt(\n            \"f.py\", \"stuff\", \"b\", \"m\",\n        )\n        assert \"code block\" in prompt.lower()\n\n\n# ---------------------------------------------------------------------------\n# ConflictResolver._extract_resolved_content\n# ---------------------------------------------------------------------------\n\nclass TestExtractResolvedContent:\n    def test_extracts_from_code_block(self):\n        response = \"Here is the resolved file:\\n```python\\nresolved line\\n```\\nDone.\"\n        result = ConflictResolver._extract_resolved_content(response)\n        assert result == \"resolved line\\n\"\n\n    def test_returns_raw_text_without_code_block(self):\n        response = \"resolved content here\"\n        result = ConflictResolver._extract_resolved_content(response)\n        assert result == \"resolved content here\"\n\n    def test_empty_response_returns_none(self):\n        assert ConflictResolver._extract_resolved_content(\"\") is None\n        assert ConflictResolver._extract_resolved_content(\"   \") is None\n\n    def test_none_response_returns_none(self):\n        assert ConflictResolver._extract_resolved_content(None) is None\n\n    def test_extracts_first_code_block_when_multiple(self):\n        response = \"```\\nfirst\\n```\\ntext\\n```\\nsecond\\n```\"\n        result = ConflictResolver._extract_resolved_content(response)\n        assert result == \"first\\n\"\n\n\n# ---------------------------------------------------------------------------\n# CONFLICT_MARKER_RE\n# ---------------------------------------------------------------------------\n\nclass TestConflictMarkerRegex:\n    def test_detects_left_marker(self):\n        assert CONFLICT_MARKER_RE.search(\"<<<<<<< HEAD\")\n\n    def test_detects_separator(self):\n        assert CONFLICT_MARKER_RE.search(\"=======\")\n\n    def test_detects_right_marker(self):\n        assert CONFLICT_MARKER_RE.search(\">>>>>>> branch\")\n\n    def test_clean_content_no_match(self):\n        assert CONFLICT_MARKER_RE.search(\"normal code\\nmore code\") is None\n\n    def test_partial_markers_no_match(self):\n        # Fewer than 7 characters should not match\n        assert CONFLICT_MARKER_RE.search(\"<<<<<< HEAD\") is None\n        assert CONFLICT_MARKER_RE.search(\"======\") is None\n        assert CONFLICT_MARKER_RE.search(\">>>>>> branch\") is None\n\n\n# ---------------------------------------------------------------------------\n# ConflictResolver.resolve_conflicts (with mocked ClaudeRunner)\n# ---------------------------------------------------------------------------\n\nclass TestResolveConflicts:\n    def _make_config(self, max_cost=2.0):\n        config = Config()\n        config.parallel.conflict_resolution_max_cost = max_cost\n        return config\n\n    def test_successful_resolution(self, tmp_path):\n        config = self._make_config()\n        resolver = ConflictResolver(config)\n\n        # Create a conflicted file\n        conflict_file = tmp_path / \"app.py\"\n        conflict_file.write_text(\n            \"<<<<<<< HEAD\\ndef main_version():\\n=======\\n\"\n            \"def branch_version():\\n>>>>>>> feat\\n    pass\\n\"\n        )\n\n        mock_result = ClaudeResult(\n            success=True,\n            result_text=\"```python\\ndef merged_version():\\n    pass\\n```\",\n            cost_usd=0.05,\n        )\n        with patch.object(resolver, \"runner\") as mock_runner:\n            mock_runner.run.return_value = mock_result\n            success, cost = resolver.resolve_conflicts(\n                str(tmp_path), [\"app.py\"], \"feat\", \"main\",\n            )\n\n        assert success is True\n        assert cost == 0.05\n        resolved = conflict_file.read_text()\n        assert \"merged_version\" in resolved\n        assert \"<<<<<<\" not in resolved\n\n    def test_markers_in_response_rejected(self, tmp_path):\n        config = self._make_config()\n        resolver = ConflictResolver(config)\n\n        conflict_file = tmp_path / \"bad.py\"\n        conflict_file.write_text(\"<<<<<<< HEAD\\nA\\n=======\\nB\\n>>>>>>> feat\\n\")\n\n        # Claude returns content that still has conflict markers\n        mock_result = ClaudeResult(\n            success=True,\n            result_text=\"```\\n<<<<<<< HEAD\\nA\\n=======\\nB\\n>>>>>>> feat\\n```\",\n            cost_usd=0.03,\n        )\n        with patch.object(resolver, \"runner\") as mock_runner:\n            mock_runner.run.return_value = mock_result\n            success, cost = resolver.resolve_conflicts(\n                str(tmp_path), [\"bad.py\"], \"feat\", \"main\",\n            )\n\n        assert success is False\n        assert cost == 0.03\n\n    def test_empty_response_fails(self, tmp_path):\n        config = self._make_config()\n        resolver = ConflictResolver(config)\n\n        conflict_file = tmp_path / \"empty.py\"\n        conflict_file.write_text(\"<<<<<<< HEAD\\nA\\n=======\\nB\\n>>>>>>> feat\\n\")\n\n        mock_result = ClaudeResult(\n            success=True,\n            result_text=\"\",\n            cost_usd=0.01,\n        )\n        with patch.object(resolver, \"runner\") as mock_runner:\n            mock_runner.run.return_value = mock_result\n            success, cost = resolver.resolve_conflicts(\n                str(tmp_path), [\"empty.py\"], \"feat\", \"main\",\n            )\n\n        assert success is False\n\n    def test_claude_failure_fails(self, tmp_path):\n        config = self._make_config()\n        resolver = ConflictResolver(config)\n\n        conflict_file = tmp_path / \"fail.py\"\n        conflict_file.write_text(\"<<<<<<< HEAD\\nA\\n=======\\nB\\n>>>>>>> feat\\n\")\n\n        mock_result = ClaudeResult(\n            success=False,\n            result_text=\"\",\n            cost_usd=0.02,\n            error=\"API error\",\n        )\n        with patch.object(resolver, \"runner\") as mock_runner:\n            mock_runner.run.return_value = mock_result\n            success, cost = resolver.resolve_conflicts(\n                str(tmp_path), [\"fail.py\"], \"feat\", \"main\",\n            )\n\n        assert success is False\n        assert cost == 0.02\n\n    def test_cost_limit_enforced(self, tmp_path):\n        config = self._make_config(max_cost=0.10)\n        resolver = ConflictResolver(config)\n        # Pre-load cost to exceed limit\n        resolver._total_cost = 0.10\n\n        conflict_file = tmp_path / \"costly.py\"\n        conflict_file.write_text(\"<<<<<<< HEAD\\nA\\n=======\\nB\\n>>>>>>> feat\\n\")\n\n        with patch.object(resolver, \"runner\") as mock_runner:\n            success, cost = resolver.resolve_conflicts(\n                str(tmp_path), [\"costly.py\"], \"feat\", \"main\",\n            )\n            # Runner should never be called because cost limit is already hit\n            mock_runner.run.assert_not_called()\n\n        assert success is False\n        assert cost == 0.10\n\n    def test_cost_accumulates_across_files(self, tmp_path):\n        config = self._make_config(max_cost=0.10)\n        resolver = ConflictResolver(config)\n\n        # Create two conflicted files\n        (tmp_path / \"a.py\").write_text(\"<<<<<<< HEAD\\nA\\n=======\\nB\\n>>>>>>> feat\\n\")\n        (tmp_path / \"b.py\").write_text(\"<<<<<<< HEAD\\nC\\n=======\\nD\\n>>>>>>> feat\\n\")\n\n        call_count = {\"n\": 0}\n\n        def mock_run(prompt):\n            call_count[\"n\"] += 1\n            if call_count[\"n\"] == 1:\n                return ClaudeResult(\n                    success=True,\n                    result_text=\"```\\nresolved_a\\n```\",\n                    cost_usd=0.08,\n                )\n            # Second call should not happen because 0.08 + anything > 0.10\n            return ClaudeResult(\n                success=True,\n                result_text=\"```\\nresolved_b\\n```\",\n                cost_usd=0.05,\n            )\n\n        with patch.object(resolver, \"runner\") as mock_runner:\n            mock_runner.run.side_effect = mock_run\n            success, cost = resolver.resolve_conflicts(\n                str(tmp_path), [\"a.py\", \"b.py\"], \"feat\", \"main\",\n            )\n\n        # First file resolves (cost 0.08), then cost check fails for second (0.08 >= 0.10 is false,\n        # so second file runs too) -- but our limit is 0.10 and 0.08 < 0.10 so second runs.\n        # Actually 0.08 < 0.10, so the second file WILL be attempted.\n        # The test validates cost tracking works correctly.\n        assert cost == 0.08 + 0.05\n        assert call_count[\"n\"] == 2\n\n    def test_missing_file_fails(self, tmp_path):\n        config = self._make_config()\n        resolver = ConflictResolver(config)\n\n        with patch.object(resolver, \"runner\") as mock_runner:\n            success, cost = resolver.resolve_conflicts(\n                str(tmp_path), [\"nonexistent.py\"], \"feat\", \"main\",\n            )\n            mock_runner.run.assert_not_called()\n\n        assert success is False\n\n\n# ---------------------------------------------------------------------------\n# Git helper tests (get_conflicted_files, mark_resolved_and_commit)\n# ---------------------------------------------------------------------------\n\nclass TestGetConflictedFiles:\n    def test_returns_conflicted_files(self, tmp_git_repo):\n        gm = GitManager(tmp_git_repo)\n        # Mock _run to simulate git diff output\n        mock_result = subprocess.CompletedProcess(\n            args=[\"git\"], returncode=0,\n            stdout=\"src/a.py\\nsrc/b.py\\n\", stderr=\"\",\n        )\n        with patch.object(gm, \"_run\", return_value=mock_result):\n            files = gm.get_conflicted_files()\n        assert files == [\"src/a.py\", \"src/b.py\"]\n\n    def test_returns_empty_on_failure(self, tmp_git_repo):\n        gm = GitManager(tmp_git_repo)\n        mock_result = subprocess.CompletedProcess(\n            args=[\"git\"], returncode=1,\n            stdout=\"\", stderr=\"error\",\n        )\n        with patch.object(gm, \"_run\", return_value=mock_result):\n            files = gm.get_conflicted_files()\n        assert files == []\n\n    def test_returns_empty_when_no_conflicts(self, tmp_git_repo):\n        gm = GitManager(tmp_git_repo)\n        mock_result = subprocess.CompletedProcess(\n            args=[\"git\"], returncode=0,\n            stdout=\"\\n\", stderr=\"\",\n        )\n        with patch.object(gm, \"_run\", return_value=mock_result):\n            files = gm.get_conflicted_files()\n        assert files == []\n\n    def test_strips_whitespace(self, tmp_git_repo):\n        gm = GitManager(tmp_git_repo)\n        mock_result = subprocess.CompletedProcess(\n            args=[\"git\"], returncode=0,\n            stdout=\"  file.py  \\n  other.py  \\n\", stderr=\"\",\n        )\n        with patch.object(gm, \"_run\", return_value=mock_result):\n            files = gm.get_conflicted_files()\n        assert files == [\"file.py\", \"other.py\"]\n\n\nclass TestMarkResolvedAndCommit:\n    def test_empty_files_returns_empty_string(self, tmp_git_repo):\n        gm = GitManager(tmp_git_repo)\n        result = gm.mark_resolved_and_commit([], \"msg\")\n        assert result == \"\"\n\n    @pytest.mark.requires_subprocess\n    def test_successful_commit(self, tmp_git_repo):\n        gm = GitManager(tmp_git_repo)\n        # Create a file that can be staged\n        Path(tmp_git_repo, \"resolved.py\").write_text(\"resolved content\")\n\n        calls = []\n        original_run = gm._run\n\n        def tracking_run(*args, **kwargs):\n            calls.append(args)\n            return original_run(*args, **kwargs)\n\n        with patch.object(gm, \"_run\", side_effect=tracking_run):\n            result = gm.mark_resolved_and_commit([\"resolved.py\"], \"Merge resolved\")\n\n        # Should have called git add, git commit, and git rev-parse\n        assert result is not None\n        assert len(result) == 40  # commit hash\n\n    def test_commit_failure_returns_none(self, tmp_git_repo):\n        gm = GitManager(tmp_git_repo)\n        Path(tmp_git_repo, \"file.py\").write_text(\"content\")\n\n        original_run = gm._run\n\n        def mock_run(*args, **kwargs):\n            if args and args[0] == \"commit\":\n                return subprocess.CompletedProcess(\n                    args=[\"git\", \"commit\"], returncode=1,\n                    stdout=\"\", stderr=\"commit failed\",\n                )\n            return original_run(*args, **kwargs)\n\n        with patch.object(gm, \"_run\", side_effect=mock_run):\n            result = gm.mark_resolved_and_commit([\"file.py\"], \"msg\")\n\n        assert result is None\n\n\n# ---------------------------------------------------------------------------\n# Integration-style: real merge conflict in a git repo\n# ---------------------------------------------------------------------------\n\nclass TestGetConflictedFilesRealRepo:\n    @pytest.mark.requires_subprocess\n    def test_detects_real_merge_conflict(self, tmp_git_repo):\n        \"\"\"Create a real merge conflict and verify get_conflicted_files detects it.\"\"\"\n        gm = GitManager(tmp_git_repo)\n        original_branch = gm.get_current_branch()\n\n        # Create a branch and modify README.md\n        wt_path = str(Path(tmp_git_repo) / \".worktrees\" / \"conflict-test\")\n        Path(wt_path).parent.mkdir(parents=True, exist_ok=True)\n        gm.create_worktree(wt_path, \"conflict-branch\")\n\n        wt_gm = GitManager(wt_path)\n        Path(wt_path, \"README.md\").write_text(\"# Branch version\\n\")\n        wt_gm.commit(\"Branch change\", files=[\"README.md\"])\n        gm.remove_worktree(wt_path, force=True)\n\n        # Modify the same file on main\n        Path(tmp_git_repo, \"README.md\").write_text(\"# Main version\\n\")\n        gm.commit(\"Main change\", files=[\"README.md\"])\n\n        # Attempt merge -- should conflict\n        merge_result = gm._run(\"merge\", \"--no-commit\", \"--no-ff\", \"conflict-branch\", check=False)\n        # The merge should fail or leave conflicts\n        conflicted = gm.get_conflicted_files()\n\n        if conflicted:\n            assert \"README.md\" in conflicted\n\n        # Clean up\n        gm.abort_merge()\n        gm._run(\"checkout\", \".\", check=False)\n        gm._run(\"clean\", \"-fd\", check=False)\n        gm.delete_branch(\"conflict-branch\", force=True)\n","numLines":403,"startLine":1,"totalLines":403}}}
