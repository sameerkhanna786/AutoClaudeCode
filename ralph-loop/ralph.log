{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_vrtx_01Y4H6pbgydYnYAR7Z64F7PD","type":"tool_result","content":"     1→\"\"\"Persist cycle history to state/history.json.\"\"\"\n     2→\n     3→from __future__ import annotations\n     4→\n     5→import errno\n     6→import json\n     7→import logging\n     8→import os\n     9→import random\n    10→import shutil\n    11→import tempfile\n    12→import time\n    13→from dataclasses import asdict, dataclass, field\n    14→from pathlib import Path\n    15→from typing import Any, Dict, List, Optional\n    16→\n    17→from config_schema import Config\n    18→\n    19→logger = logging.getLogger(__name__)\n    20→\n    21→\n    22→@dataclass\n    23→class CycleRecord:\n    24→    timestamp: float\n    25→    task_description: str\n    26→    task_type: str = \"unknown\"\n    27→    success: bool = False\n    28→    commit_hash: str = \"\"\n    29→    cost_usd: float = 0.0\n    30→    duration_seconds: float = 0.0\n    31→    validation_summary: str = \"\"\n    32→    error: str = \"\"\n    33→    task_descriptions: List[str] = field(default_factory=list)\n    34→    task_types: List[str] = field(default_factory=list)\n    35→    batch_size: int = 1\n    36→    task_keys: List[str] = field(default_factory=list)\n    37→    pipeline_mode: str = \"\"\n    38→    pipeline_revision_count: int = 0\n    39→    pipeline_review_approved: bool = True\n    40→    validation_retry_count: int = 0\n    41→    push_succeeded: Optional[bool] = None\n    42→    task_source_files: List[str] = field(default_factory=list)\n    43→    task_line_numbers: List[Optional[int]] = field(default_factory=list)\n    44→\n    45→\n    46→class StateManager:\n    47→    def __init__(self, config: Config):\n    48→        self.config = config\n    49→        self.history_file = Path(config.paths.history_file)\n    50→        self._cache: Optional[List[Dict[str, Any]]] = None\n    51→        self._cache_mtime: float = 0.0\n    52→        self._history_corrupt: bool = False\n    53→        self._ensure_dir()\n    54→\n    55→    def _ensure_dir(self) -> None:\n    56→        self.history_file.parent.mkdir(parents=True, exist_ok=True)\n    57→\n    58→    def _try_restore_from_backups(self) -> Optional[List[Dict[str, Any]]]:\n    59→        \"\"\"Attempt to restore history from .corrupt backup files.\n    60→\n    61→        Returns the parsed records from the most recent readable backup,\n    62→        or None if no backup can be parsed.\n    63→        \"\"\"\n    64→        parent = self.history_file.parent\n    65→        base_name = self.history_file.name\n    66→        backups = sorted(\n    67→            parent.glob(f\"{base_name}.corrupt*\"),\n    68→            key=lambda p: p.stat().st_mtime,\n    69→            reverse=True,\n    70→        )\n    71→        for backup in backups:\n    72→            try:\n    73→                text = backup.read_text().strip()\n    74→                if text:\n    75→                    records = json.loads(text)\n    76→                    if isinstance(records, list):\n    77→                        logger.info(\n    78→                            \"Restored %d history records from backup %s\",\n    79→                            len(records), backup,\n    80→                        )\n    81→                        return records\n    82→            except (json.JSONDecodeError, OSError):\n    83→                continue\n    84→        return None\n    85→\n    86→    def _load_history(self) -> List[Dict[str, Any]]:\n    87→        if not self.history_file.exists():\n    88→            self._cache = []\n    89→            self._cache_mtime = 0.0\n    90→            return []\n    91→        try:\n    92→            current_mtime = self.history_file.stat().st_mtime\n    93→            if self._cache is not None and current_mtime == self._cache_mtime:\n    94→                return self._cache\n    95→            text = self.history_file.read_text().strip()\n    96→            if not text:\n    97→                self._cache = []\n    98→                self._cache_mtime = current_mtime\n    99→                return []\n   100→            records = json.loads(text)\n   101→            self._history_corrupt = False\n   102→            self._cache = records\n   103→            self._cache_mtime = current_mtime\n   104→            return records\n   105→        except json.JSONDecodeError as e:\n   106→            logger.error(\"History file is corrupt: %s\", e)\n   107→            # Back up corrupted file so record_cycle won't overwrite it\n   108→            backup = str(self.history_file) + \".corrupt\"\n   109→            try:\n   110→                shutil.copy2(str(self.history_file), backup)\n   111→                logger.warning(\"Backed up corrupted history to %s\", backup)\n   112→            except OSError as backup_err:\n   113→                logger.warning(\"Could not back up corrupted history: %s\", backup_err)\n   114→\n   115→            # Attempt to restore from a previous backup\n   116→            restored = self._try_restore_from_backups()\n   117→            if restored is not None:\n   118→                self._cache = restored\n   119→                self._history_corrupt = False\n   120→            else:\n   121→                logger.warning(\n   122→                    \"No valid backup found. Corrupted history backed up. \"\n   123→                    \"Starting fresh — new cycles will write to a clean history file.\"\n   124→                )\n   125→                self._cache = []\n   126→                self._history_corrupt = False\n   127→            try:\n   128→                self._cache_mtime = self.history_file.stat().st_mtime\n   129→            except FileNotFoundError:\n   130→                self._cache_mtime = 0.0\n   131→            return self._cache\n   132→        except OSError as e:\n   133→            logger.warning(\"Failed to read history: %s\", e)\n   134→            return []\n   135→\n   136→    def _save_history(self, records: List[Dict[str, Any]]) -> None:\n   137→        \"\"\"Atomic write: write to temp file, then rename.\n   138→\n   139→        Refuses to overwrite the history file if it was flagged as corrupt\n   140→        and unrecoverable, to prevent data loss.\n   141→\n   142→        Pre-checks available disk space (10 MB threshold) before attempting\n   143→        to write, allowing graceful degradation when disk is near full.\n   144→        \"\"\"\n   145→        if self._history_corrupt:\n   146→            logger.error(\n   147→                \"Refusing to save history: file is corrupt and unrecoverable. \"\n   148→                \"Manually fix or remove %s to resume.\", self.history_file,\n   149→            )\n   150→            return\n   151→\n   152→        # Disk space pre-check: require at least 10 MB free\n   153→        _MIN_FREE_BYTES = 10 * 1024 * 1024\n   154→        try:\n   155→            usage = shutil.disk_usage(str(self.history_file.parent))\n   156→            if usage.free < _MIN_FREE_BYTES:\n   157→                logger.warning(\n   158→                    \"Low disk space: only %.1f MB free (need %.1f MB). \"\n   159→                    \"Skipping history save to prevent silent write failure.\",\n   160→                    usage.free / (1024 * 1024),\n   161→                    _MIN_FREE_BYTES / (1024 * 1024),\n   162→                )\n   163→                return\n   164→        except OSError as e:\n   165→            # If the disk check itself fails (e.g., path not mounted),\n   166→            # log and continue — don't block writes over a check failure\n   167→            logger.debug(\"Disk space check failed (continuing anyway): %s\", e)\n   168→\n   169→        self._ensure_dir()\n   170→        # Check for external modifications between read and write\n   171→        if self._cache_mtime > 0 and self.history_file.exists():\n   172→            try:\n   173→                current_mtime = self.history_file.stat().st_mtime\n   174→                if current_mtime != self._cache_mtime:\n   175→                    logger.warning(\n   176→                        \"History file was modified externally since last read \"\n   177→                        \"(expected mtime %.6f, got %.6f). Data from the external \"\n   178→                        \"modification may be lost.\",\n   179→                        self._cache_mtime, current_mtime,\n   180→                    )\n   181→            except OSError:\n   182→                pass  # File may have been deleted; proceed with write\n   183→        # Pre-check: verify records are JSON-serializable before writing.\n   184→        # This catches circular references, non-serializable types (e.g.,\n   185→        # unconverted dataclass instances with self-references), etc.\n   186→        try:\n   187→            json.dumps(records)\n   188→        except (TypeError, ValueError) as e:\n   189→            logger.error(\n   190→                \"Refusing to save history: records are not JSON-serializable: %s\", e,\n   191→            )\n   192→            return\n   193→        tmp_fd, tmp_path = tempfile.mkstemp(\n   194→            dir=str(self.history_file.parent), suffix=\".tmp\"\n   195→        )\n   196→        try:\n   197→            try:\n   198→                f = os.fdopen(tmp_fd, \"w\")\n   199→            except Exception:\n   200→                os.close(tmp_fd)\n   201→                raise\n   202→            with f:\n   203→                json.dump(records, f, indent=2)\n   204→            # os.replace can fail on Windows if target is open; retry with\n   205→            # exponential backoff and jitter for persistent filesystem contention\n   206→            _REPLACE_BASE_DELAY = 0.1\n   207→            _REPLACE_MULTIPLIER = 3\n   208→            _REPLACE_MAX_RETRIES = 7\n   209→            _REPLACE_MAX_DELAY = 30.0\n   210→            replaced = False\n   211→            last_err: Optional[OSError] = None\n   212→            for attempt in range(_REPLACE_MAX_RETRIES):\n   213→                try:\n   214→                    os.replace(tmp_path, str(self.history_file))\n   215→                    replaced = True\n   216→                    break\n   217→                except OSError as e:\n   218→                    last_err = e\n   219→                    if attempt < _REPLACE_MAX_RETRIES - 1:\n   220→                        delay = min(\n   221→                            _REPLACE_BASE_DELAY * (_REPLACE_MULTIPLIER ** attempt),\n   222→                            _REPLACE_MAX_DELAY,\n   223→                        )\n   224→                        delay *= 0.5 + random.random() * 0.5  # jitter\n   225→                        logger.debug(\n   226→                            \"os.replace failed (attempt %d/%d): %s — retrying in %.2fs\",\n   227→                            attempt + 1, _REPLACE_MAX_RETRIES, e, delay,\n   228→                        )\n   229→                        time.sleep(delay)\n   230→            if not replaced:\n   231→                if last_err is not None:\n   232→                    raise last_err\n   233→                raise OSError(\"os.replace failed: no retries were attempted\")\n   234→            self._cache = records\n   235→            self._cache_mtime = self.history_file.stat().st_mtime\n   236→        except OSError as e:\n   237→            # Clean up temp file on failure\n   238→            try:\n   239→                os.unlink(tmp_path)\n   240→            except OSError:\n   241→                pass\n   242→            # Graceful degradation: if disk is full, log a warning and\n   243→            # continue instead of crashing the orchestrator.\n   244→            if e.errno == errno.ENOSPC:\n   245→                logger.warning(\n   246→                    \"Disk full: unable to save cycle history. \"\n   247→                    \"Cycle data will be lost. Free disk space to resume normal operation.\"\n   248→                )\n   249→                return\n   250→            raise\n   251→        except Exception:\n   252→            # Clean up temp file on failure (non-OSError cases)\n   253→            try:\n   254→                os.unlink(tmp_path)\n   255→            except OSError:\n   256→                pass\n   257→            raise\n   258→\n   259→    def _prune_history(self, records: List[Dict[str, Any]]) -> List[Dict[str, Any]]:\n   260→        \"\"\"Prune history to the most recent max_history_records entries.\"\"\"\n   261→        max_records = self.config.safety.max_history_records\n   262→        if len(records) > max_records:\n   263→            return records[-max_records:]\n   264→        return records\n   265→\n   266→    def record_cycle(self, record: CycleRecord) -> None:\n   267→        \"\"\"Append a cycle record to history.\"\"\"\n   268→        records = list(self._load_history())\n   269→        records.append(asdict(record))\n   270→        records = self._prune_history(records)\n   271→        self._save_history(records)\n   272→        logger.info(\n   273→            \"Recorded cycle: %s (success=%s)\", record.task_description, record.success\n   274→        )\n   275→\n   276→    def was_recently_attempted(self, task_description: str, lookback_seconds: int = 3600, task_key: str = \"\") -> bool:\n   277→        \"\"\"Check if a task was attempted in the last lookback_seconds.\"\"\"\n   278→        cutoff = time.time() - lookback_seconds\n   279→        records = self._load_history()\n   280→        for r in records:\n   281→            if r.get(\"timestamp\", 0) >= cutoff:\n   282→                if r.get(\"task_description\") == task_description:\n   283→                    return True\n   284→                if task_description in r.get(\"task_descriptions\", []):\n   285→                    return True\n   286→                if task_key and task_key in r.get(\"task_keys\", []):\n   287→                    return True\n   288→        return False\n   289→\n   290→    def get_cycle_count_last_hour(self) -> int:\n   291→        \"\"\"Return number of cycles in the last hour.\"\"\"\n   292→        cutoff = time.time() - 3600\n   293→        records = self._load_history()\n   294→        return sum(1 for r in records if r.get(\"timestamp\", 0) >= cutoff)\n   295→\n   296→    def get_total_cost(self, lookback_seconds: int = 3600) -> float:\n   297→        \"\"\"Return total cost in USD over the lookback period.\"\"\"\n   298→        cutoff = time.time() - lookback_seconds\n   299→        records = self._load_history()\n   300→        return sum(\n   301→            r.get(\"cost_usd\", 0.0)\n   302→            for r in records\n   303→            if r.get(\"timestamp\", 0) >= cutoff\n   304→        )\n   305→\n   306→    def get_consecutive_failures(self) -> int:\n   307→        \"\"\"Return the number of consecutive failures at the end of history.\"\"\"\n   308→        records = self._load_history()\n   309→        count = 0\n   310→        for r in reversed(records):\n   311→            if r.get(\"success\", False):\n   312→                break\n   313→            count += 1\n   314→        return count\n   315→\n   316→    def compute_adaptive_batch_size(self) -> int:\n   317→        \"\"\"Replay recent history to compute adaptive batch size.\n   318→\n   319→        Cost-aware: successful cycles that exceed batch_cost_ceiling\n   320→        do not grow the batch size, preventing runaway cost growth.\n   321→        \"\"\"\n   322→        orch = self.config.orchestrator\n   323→        size = orch.initial_batch_size\n   324→        records = self._load_history()\n   325→        recent = records[-orch.adaptive_batch_window:]\n   326→\n   327→        for r in recent:\n   328→            if r.get(\"success\", False):\n   329→                # Cost-aware: don't grow if this cycle was expensive\n   330→                cost = r.get(\"cost_usd\", 0.0)\n   331→                if cost < orch.batch_cost_ceiling:\n   332→                    size += orch.batch_grow_step\n   333→                # else: success but expensive — hold steady\n   334→            else:\n   335→                size -= orch.batch_shrink_step\n   336→            size = max(orch.min_batch_size, min(orch.max_batch_size, size))\n   337→\n   338→        return size\n   339→\n   340→    def get_task_failure_count(self, task_description: str, task_type: str = \"\", task_key: str = \"\") -> int:\n   341→        \"\"\"Return the number of failed attempts for a specific task.\"\"\"\n   342→        records = self._load_history()\n   343→        count = 0\n   344→        for r in records:\n   345→            if r.get(\"success\", False):\n   346→                continue\n   347→            match = (r.get(\"task_description\") == task_description\n   348→                     or task_description in r.get(\"task_descriptions\", []))\n   349→            if not match and task_key:\n   350→                match = task_key in r.get(\"task_keys\", [])\n   351→            if match and (not task_type\n   352→                          or r.get(\"task_type\") == task_type\n   353→                          or task_type in r.get(\"task_types\", [])):\n   354→                count += 1\n   355→        return count\n   356→\n   357→    def reset_consecutive_failures(self, reason: str = \"manual reset\") -> None:\n   358→        \"\"\"Inject a synthetic success record to break the consecutive failure chain.\"\"\"\n   359→        record = CycleRecord(\n   360→            timestamp=time.time(),\n   361→            task_description=f\"System reset: {reason}\",\n   362→            task_type=\"system_reset\",\n   363→            success=True,\n   364→        )\n   365→        self.record_cycle(record)\n   366→        logger.info(\"Reset consecutive failures: %s\", reason)\n   367→\n   368→    def should_auto_reset_failures(self, min_idle_seconds: int = 3600) -> bool:\n   369→        \"\"\"Return True if consecutive failures >= max and system has been idle long enough.\"\"\"\n   370→        failures = self.get_consecutive_failures()\n   371→        limit = self.config.safety.max_consecutive_failures\n   372→        if failures < limit:\n   373→            return False\n   374→        records = self._load_history()\n   375→        if not records:\n   376→            return False\n   377→        last_timestamp = records[-1].get(\"timestamp\", 0)\n   378→        idle_seconds = time.time() - last_timestamp\n   379→        return idle_seconds >= min_idle_seconds\n   380→\n   381→    def get_recent_task_summaries(self, lookback_seconds: int = 86400, max_items: int = 20) -> List[str]:\n   382→        \"\"\"Return human-readable summaries of recent tasks for prompt injection.\"\"\"\n   383→        cutoff = time.time() - lookback_seconds\n   384→        records = self._load_history()\n   385→        summaries = []\n   386→        for r in records:\n   387→            if r.get(\"timestamp\", 0) >= cutoff:\n   388→                desc = r.get(\"task_description\", \"\")\n   389→                if len(desc) > 100:\n   390→                    desc = desc[:97] + \"...\"\n   391→                status = \"succeeded\" if r.get(\"success\") else \"failed\"\n   392→                summaries.append(f\"- {desc} ({status})\")\n   393→        return summaries[-max_items:]\n   394→\n   395→    def get_success_rate_by_type(self, lookback_seconds: int = 86400) -> Dict[str, float]:\n   396→        \"\"\"Compute success rates per task_type over the lookback window.\n   397→\n   398→        Returns a dict mapping task_type -> success_rate (0.0-1.0).\n   399→        Types with fewer than 2 attempts are not included.\n   400→        \"\"\"\n   401→        cutoff = time.time() - lookback_seconds\n   402→        records = self._load_history()\n   403→\n   404→        type_counts: Dict[str, Dict[str, int]] = {}  # type -> {total, successes}\n   405→        for r in records:\n   406→            if r.get(\"timestamp\", 0) < cutoff:\n   407→                continue\n   408→            task_type = r.get(\"task_type\", \"unknown\")\n   409→            if task_type not in type_counts:\n   410→                type_counts[task_type] = {\"total\": 0, \"successes\": 0}\n   411→            type_counts[task_type][\"total\"] += 1\n   412→            if r.get(\"success\", False):\n   413→                type_counts[task_type][\"successes\"] += 1\n   414→\n   415→        rates: Dict[str, float] = {}\n   416→        for task_type, counts in type_counts.items():\n   417→            if counts[\"total\"] >= 2:\n   418→                rates[task_type] = counts[\"successes\"] / counts[\"total\"]\n   419→\n   420→        return rates\n   421→\n   422→    def get_strategy_performance(self, lookback_seconds: int = 86400) -> Dict[str, Dict[str, Any]]:\n   423→        \"\"\"Return per-source performance metrics: source -> {total, successes, success_rate, avg_cost, avg_duration}\"\"\"\n   424→        cutoff = time.time() - lookback_seconds\n   425→        records = self._load_history()\n   426→        performance: Dict[str, Dict[str, Any]] = {}\n   427→        for r in records:\n   428→            if r.get(\"timestamp\", 0) < cutoff:\n   429→                continue\n   430→            source = r.get(\"task_type\", \"unknown\")\n   431→            if source not in performance:\n   432→                performance[source] = {\"total\": 0, \"successes\": 0, \"total_cost\": 0.0, \"total_duration\": 0.0}\n   433→            perf = performance[source]\n   434→            perf[\"total\"] += 1\n   435→            if r.get(\"success\", False):\n   436→                perf[\"successes\"] += 1\n   437→            perf[\"total_cost\"] += r.get(\"cost_usd\", 0.0)\n   438→            perf[\"total_duration\"] += r.get(\"duration_seconds\", 0.0)\n   439→        for source, perf in performance.items():\n   440→            total = perf[\"total\"]\n   441→            perf[\"success_rate\"] = perf[\"successes\"] / total if total > 0 else 0.0\n   442→            perf[\"avg_cost\"] = perf[\"total_cost\"] / total if total > 0 else 0.0\n   443→            perf[\"avg_duration\"] = perf[\"total_duration\"] / total if total > 0 else 0.0\n   444→        return performance\n   445→\n   446→    def get_productive_files(self, lookback_seconds: int = 86400) -> List[str]:\n   447→        \"\"\"Return files successfully modified most often, sorted by frequency.\"\"\"\n   448→        import re\n   449→        cutoff = time.time() - lookback_seconds\n   450→        records = self._load_history()\n   451→        file_counts: Dict[str, int] = {}\n   452→        for r in records:\n   453→            if r.get(\"timestamp\", 0) < cutoff or not r.get(\"success\", False):\n   454→                continue\n   455→            for task_desc in r.get(\"task_descriptions\", [r.get(\"task_description\", \"\")]):\n   456→                matches = re.findall(\n   457→                    r'([a-zA-Z0-9_/.\\-]+\\.(?:py|js|ts|tsx|jsx|go|rs|java|rb|sh|yaml|yml|json))',\n   458→                    task_desc,\n   459→                )\n   460→                for m in matches:\n   461→                    file_counts[m] = file_counts.get(m, 0) + 1\n   462→        return sorted(file_counts.keys(), key=lambda f: file_counts[f], reverse=True)\n   463→\n   464→    def load_history(self) -> List[Dict[str, Any]]:\n   465→        \"\"\"Public API for loading history (safe for external callers).\"\"\"\n   466→        return self._load_history()\n   467→"}]},"parent_tool_use_id":null,"session_id":"cdc88a14-e661-4229-849a-8b4c75790bc7","uuid":"dfb98620-830f-4d72-9c7a-670e5322fc82","tool_use_result":{"type":"text","file":{"filePath":"/Users/sameertkhanna/Documents/auto_claude_code/state.py","content":"\"\"\"Persist cycle history to state/history.json.\"\"\"\n\nfrom __future__ import annotations\n\nimport errno\nimport json\nimport logging\nimport os\nimport random\nimport shutil\nimport tempfile\nimport time\nfrom dataclasses import asdict, dataclass, field\nfrom pathlib import Path\nfrom typing import Any, Dict, List, Optional\n\nfrom config_schema import Config\n\nlogger = logging.getLogger(__name__)\n\n\n@dataclass\nclass CycleRecord:\n    timestamp: float\n    task_description: str\n    task_type: str = \"unknown\"\n    success: bool = False\n    commit_hash: str = \"\"\n    cost_usd: float = 0.0\n    duration_seconds: float = 0.0\n    validation_summary: str = \"\"\n    error: str = \"\"\n    task_descriptions: List[str] = field(default_factory=list)\n    task_types: List[str] = field(default_factory=list)\n    batch_size: int = 1\n    task_keys: List[str] = field(default_factory=list)\n    pipeline_mode: str = \"\"\n    pipeline_revision_count: int = 0\n    pipeline_review_approved: bool = True\n    validation_retry_count: int = 0\n    push_succeeded: Optional[bool] = None\n    task_source_files: List[str] = field(default_factory=list)\n    task_line_numbers: List[Optional[int]] = field(default_factory=list)\n\n\nclass StateManager:\n    def __init__(self, config: Config):\n        self.config = config\n        self.history_file = Path(config.paths.history_file)\n        self._cache: Optional[List[Dict[str, Any]]] = None\n        self._cache_mtime: float = 0.0\n        self._history_corrupt: bool = False\n        self._ensure_dir()\n\n    def _ensure_dir(self) -> None:\n        self.history_file.parent.mkdir(parents=True, exist_ok=True)\n\n    def _try_restore_from_backups(self) -> Optional[List[Dict[str, Any]]]:\n        \"\"\"Attempt to restore history from .corrupt backup files.\n\n        Returns the parsed records from the most recent readable backup,\n        or None if no backup can be parsed.\n        \"\"\"\n        parent = self.history_file.parent\n        base_name = self.history_file.name\n        backups = sorted(\n            parent.glob(f\"{base_name}.corrupt*\"),\n            key=lambda p: p.stat().st_mtime,\n            reverse=True,\n        )\n        for backup in backups:\n            try:\n                text = backup.read_text().strip()\n                if text:\n                    records = json.loads(text)\n                    if isinstance(records, list):\n                        logger.info(\n                            \"Restored %d history records from backup %s\",\n                            len(records), backup,\n                        )\n                        return records\n            except (json.JSONDecodeError, OSError):\n                continue\n        return None\n\n    def _load_history(self) -> List[Dict[str, Any]]:\n        if not self.history_file.exists():\n            self._cache = []\n            self._cache_mtime = 0.0\n            return []\n        try:\n            current_mtime = self.history_file.stat().st_mtime\n            if self._cache is not None and current_mtime == self._cache_mtime:\n                return self._cache\n            text = self.history_file.read_text().strip()\n            if not text:\n                self._cache = []\n                self._cache_mtime = current_mtime\n                return []\n            records = json.loads(text)\n            self._history_corrupt = False\n            self._cache = records\n            self._cache_mtime = current_mtime\n            return records\n        except json.JSONDecodeError as e:\n            logger.error(\"History file is corrupt: %s\", e)\n            # Back up corrupted file so record_cycle won't overwrite it\n            backup = str(self.history_file) + \".corrupt\"\n            try:\n                shutil.copy2(str(self.history_file), backup)\n                logger.warning(\"Backed up corrupted history to %s\", backup)\n            except OSError as backup_err:\n                logger.warning(\"Could not back up corrupted history: %s\", backup_err)\n\n            # Attempt to restore from a previous backup\n            restored = self._try_restore_from_backups()\n            if restored is not None:\n                self._cache = restored\n                self._history_corrupt = False\n            else:\n                logger.warning(\n                    \"No valid backup found. Corrupted history backed up. \"\n                    \"Starting fresh — new cycles will write to a clean history file.\"\n                )\n                self._cache = []\n                self._history_corrupt = False\n            try:\n                self._cache_mtime = self.history_file.stat().st_mtime\n            except FileNotFoundError:\n                self._cache_mtime = 0.0\n            return self._cache\n        except OSError as e:\n            logger.warning(\"Failed to read history: %s\", e)\n            return []\n\n    def _save_history(self, records: List[Dict[str, Any]]) -> None:\n        \"\"\"Atomic write: write to temp file, then rename.\n\n        Refuses to overwrite the history file if it was flagged as corrupt\n        and unrecoverable, to prevent data loss.\n\n        Pre-checks available disk space (10 MB threshold) before attempting\n        to write, allowing graceful degradation when disk is near full.\n        \"\"\"\n        if self._history_corrupt:\n            logger.error(\n                \"Refusing to save history: file is corrupt and unrecoverable. \"\n                \"Manually fix or remove %s to resume.\", self.history_file,\n            )\n            return\n\n        # Disk space pre-check: require at least 10 MB free\n        _MIN_FREE_BYTES = 10 * 1024 * 1024\n        try:\n            usage = shutil.disk_usage(str(self.history_file.parent))\n            if usage.free < _MIN_FREE_BYTES:\n                logger.warning(\n                    \"Low disk space: only %.1f MB free (need %.1f MB). \"\n                    \"Skipping history save to prevent silent write failure.\",\n                    usage.free / (1024 * 1024),\n                    _MIN_FREE_BYTES / (1024 * 1024),\n                )\n                return\n        except OSError as e:\n            # If the disk check itself fails (e.g., path not mounted),\n            # log and continue — don't block writes over a check failure\n            logger.debug(\"Disk space check failed (continuing anyway): %s\", e)\n\n        self._ensure_dir()\n        # Check for external modifications between read and write\n        if self._cache_mtime > 0 and self.history_file.exists():\n            try:\n                current_mtime = self.history_file.stat().st_mtime\n                if current_mtime != self._cache_mtime:\n                    logger.warning(\n                        \"History file was modified externally since last read \"\n                        \"(expected mtime %.6f, got %.6f). Data from the external \"\n                        \"modification may be lost.\",\n                        self._cache_mtime, current_mtime,\n                    )\n            except OSError:\n                pass  # File may have been deleted; proceed with write\n        # Pre-check: verify records are JSON-serializable before writing.\n        # This catches circular references, non-serializable types (e.g.,\n        # unconverted dataclass instances with self-references), etc.\n        try:\n            json.dumps(records)\n        except (TypeError, ValueError) as e:\n            logger.error(\n                \"Refusing to save history: records are not JSON-serializable: %s\", e,\n            )\n            return\n        tmp_fd, tmp_path = tempfile.mkstemp(\n            dir=str(self.history_file.parent), suffix=\".tmp\"\n        )\n        try:\n            try:\n                f = os.fdopen(tmp_fd, \"w\")\n            except Exception:\n                os.close(tmp_fd)\n                raise\n            with f:\n                json.dump(records, f, indent=2)\n            # os.replace can fail on Windows if target is open; retry with\n            # exponential backoff and jitter for persistent filesystem contention\n            _REPLACE_BASE_DELAY = 0.1\n            _REPLACE_MULTIPLIER = 3\n            _REPLACE_MAX_RETRIES = 7\n            _REPLACE_MAX_DELAY = 30.0\n            replaced = False\n            last_err: Optional[OSError] = None\n            for attempt in range(_REPLACE_MAX_RETRIES):\n                try:\n                    os.replace(tmp_path, str(self.history_file))\n                    replaced = True\n                    break\n                except OSError as e:\n                    last_err = e\n                    if attempt < _REPLACE_MAX_RETRIES - 1:\n                        delay = min(\n                            _REPLACE_BASE_DELAY * (_REPLACE_MULTIPLIER ** attempt),\n                            _REPLACE_MAX_DELAY,\n                        )\n                        delay *= 0.5 + random.random() * 0.5  # jitter\n                        logger.debug(\n                            \"os.replace failed (attempt %d/%d): %s — retrying in %.2fs\",\n                            attempt + 1, _REPLACE_MAX_RETRIES, e, delay,\n                        )\n                        time.sleep(delay)\n            if not replaced:\n                if last_err is not None:\n                    raise last_err\n                raise OSError(\"os.replace failed: no retries were attempted\")\n            self._cache = records\n            self._cache_mtime = self.history_file.stat().st_mtime\n        except OSError as e:\n            # Clean up temp file on failure\n            try:\n                os.unlink(tmp_path)\n            except OSError:\n                pass\n            # Graceful degradation: if disk is full, log a warning and\n            # continue instead of crashing the orchestrator.\n            if e.errno == errno.ENOSPC:\n                logger.warning(\n                    \"Disk full: unable to save cycle history. \"\n                    \"Cycle data will be lost. Free disk space to resume normal operation.\"\n                )\n                return\n            raise\n        except Exception:\n            # Clean up temp file on failure (non-OSError cases)\n            try:\n                os.unlink(tmp_path)\n            except OSError:\n                pass\n            raise\n\n    def _prune_history(self, records: List[Dict[str, Any]]) -> List[Dict[str, Any]]:\n        \"\"\"Prune history to the most recent max_history_records entries.\"\"\"\n        max_records = self.config.safety.max_history_records\n        if len(records) > max_records:\n            return records[-max_records:]\n        return records\n\n    def record_cycle(self, record: CycleRecord) -> None:\n        \"\"\"Append a cycle record to history.\"\"\"\n        records = list(self._load_history())\n        records.append(asdict(record))\n        records = self._prune_history(records)\n        self._save_history(records)\n        logger.info(\n            \"Recorded cycle: %s (success=%s)\", record.task_description, record.success\n        )\n\n    def was_recently_attempted(self, task_description: str, lookback_seconds: int = 3600, task_key: str = \"\") -> bool:\n        \"\"\"Check if a task was attempted in the last lookback_seconds.\"\"\"\n        cutoff = time.time() - lookback_seconds\n        records = self._load_history()\n        for r in records:\n            if r.get(\"timestamp\", 0) >= cutoff:\n                if r.get(\"task_description\") == task_description:\n                    return True\n                if task_description in r.get(\"task_descriptions\", []):\n                    return True\n                if task_key and task_key in r.get(\"task_keys\", []):\n                    return True\n        return False\n\n    def get_cycle_count_last_hour(self) -> int:\n        \"\"\"Return number of cycles in the last hour.\"\"\"\n        cutoff = time.time() - 3600\n        records = self._load_history()\n        return sum(1 for r in records if r.get(\"timestamp\", 0) >= cutoff)\n\n    def get_total_cost(self, lookback_seconds: int = 3600) -> float:\n        \"\"\"Return total cost in USD over the lookback period.\"\"\"\n        cutoff = time.time() - lookback_seconds\n        records = self._load_history()\n        return sum(\n            r.get(\"cost_usd\", 0.0)\n            for r in records\n            if r.get(\"timestamp\", 0) >= cutoff\n        )\n\n    def get_consecutive_failures(self) -> int:\n        \"\"\"Return the number of consecutive failures at the end of history.\"\"\"\n        records = self._load_history()\n        count = 0\n        for r in reversed(records):\n            if r.get(\"success\", False):\n                break\n            count += 1\n        return count\n\n    def compute_adaptive_batch_size(self) -> int:\n        \"\"\"Replay recent history to compute adaptive batch size.\n\n        Cost-aware: successful cycles that exceed batch_cost_ceiling\n        do not grow the batch size, preventing runaway cost growth.\n        \"\"\"\n        orch = self.config.orchestrator\n        size = orch.initial_batch_size\n        records = self._load_history()\n        recent = records[-orch.adaptive_batch_window:]\n\n        for r in recent:\n            if r.get(\"success\", False):\n                # Cost-aware: don't grow if this cycle was expensive\n                cost = r.get(\"cost_usd\", 0.0)\n                if cost < orch.batch_cost_ceiling:\n                    size += orch.batch_grow_step\n                # else: success but expensive — hold steady\n            else:\n                size -= orch.batch_shrink_step\n            size = max(orch.min_batch_size, min(orch.max_batch_size, size))\n\n        return size\n\n    def get_task_failure_count(self, task_description: str, task_type: str = \"\", task_key: str = \"\") -> int:\n        \"\"\"Return the number of failed attempts for a specific task.\"\"\"\n        records = self._load_history()\n        count = 0\n        for r in records:\n            if r.get(\"success\", False):\n                continue\n            match = (r.get(\"task_description\") == task_description\n                     or task_description in r.get(\"task_descriptions\", []))\n            if not match and task_key:\n                match = task_key in r.get(\"task_keys\", [])\n            if match and (not task_type\n                          or r.get(\"task_type\") == task_type\n                          or task_type in r.get(\"task_types\", [])):\n                count += 1\n        return count\n\n    def reset_consecutive_failures(self, reason: str = \"manual reset\") -> None:\n        \"\"\"Inject a synthetic success record to break the consecutive failure chain.\"\"\"\n        record = CycleRecord(\n            timestamp=time.time(),\n            task_description=f\"System reset: {reason}\",\n            task_type=\"system_reset\",\n            success=True,\n        )\n        self.record_cycle(record)\n        logger.info(\"Reset consecutive failures: %s\", reason)\n\n    def should_auto_reset_failures(self, min_idle_seconds: int = 3600) -> bool:\n        \"\"\"Return True if consecutive failures >= max and system has been idle long enough.\"\"\"\n        failures = self.get_consecutive_failures()\n        limit = self.config.safety.max_consecutive_failures\n        if failures < limit:\n            return False\n        records = self._load_history()\n        if not records:\n            return False\n        last_timestamp = records[-1].get(\"timestamp\", 0)\n        idle_seconds = time.time() - last_timestamp\n        return idle_seconds >= min_idle_seconds\n\n    def get_recent_task_summaries(self, lookback_seconds: int = 86400, max_items: int = 20) -> List[str]:\n        \"\"\"Return human-readable summaries of recent tasks for prompt injection.\"\"\"\n        cutoff = time.time() - lookback_seconds\n        records = self._load_history()\n        summaries = []\n        for r in records:\n            if r.get(\"timestamp\", 0) >= cutoff:\n                desc = r.get(\"task_description\", \"\")\n                if len(desc) > 100:\n                    desc = desc[:97] + \"...\"\n                status = \"succeeded\" if r.get(\"success\") else \"failed\"\n                summaries.append(f\"- {desc} ({status})\")\n        return summaries[-max_items:]\n\n    def get_success_rate_by_type(self, lookback_seconds: int = 86400) -> Dict[str, float]:\n        \"\"\"Compute success rates per task_type over the lookback window.\n\n        Returns a dict mapping task_type -> success_rate (0.0-1.0).\n        Types with fewer than 2 attempts are not included.\n        \"\"\"\n        cutoff = time.time() - lookback_seconds\n        records = self._load_history()\n\n        type_counts: Dict[str, Dict[str, int]] = {}  # type -> {total, successes}\n        for r in records:\n            if r.get(\"timestamp\", 0) < cutoff:\n                continue\n            task_type = r.get(\"task_type\", \"unknown\")\n            if task_type not in type_counts:\n                type_counts[task_type] = {\"total\": 0, \"successes\": 0}\n            type_counts[task_type][\"total\"] += 1\n            if r.get(\"success\", False):\n                type_counts[task_type][\"successes\"] += 1\n\n        rates: Dict[str, float] = {}\n        for task_type, counts in type_counts.items():\n            if counts[\"total\"] >= 2:\n                rates[task_type] = counts[\"successes\"] / counts[\"total\"]\n\n        return rates\n\n    def get_strategy_performance(self, lookback_seconds: int = 86400) -> Dict[str, Dict[str, Any]]:\n        \"\"\"Return per-source performance metrics: source -> {total, successes, success_rate, avg_cost, avg_duration}\"\"\"\n        cutoff = time.time() - lookback_seconds\n        records = self._load_history()\n        performance: Dict[str, Dict[str, Any]] = {}\n        for r in records:\n            if r.get(\"timestamp\", 0) < cutoff:\n                continue\n            source = r.get(\"task_type\", \"unknown\")\n            if source not in performance:\n                performance[source] = {\"total\": 0, \"successes\": 0, \"total_cost\": 0.0, \"total_duration\": 0.0}\n            perf = performance[source]\n            perf[\"total\"] += 1\n            if r.get(\"success\", False):\n                perf[\"successes\"] += 1\n            perf[\"total_cost\"] += r.get(\"cost_usd\", 0.0)\n            perf[\"total_duration\"] += r.get(\"duration_seconds\", 0.0)\n        for source, perf in performance.items():\n            total = perf[\"total\"]\n            perf[\"success_rate\"] = perf[\"successes\"] / total if total > 0 else 0.0\n            perf[\"avg_cost\"] = perf[\"total_cost\"] / total if total > 0 else 0.0\n            perf[\"avg_duration\"] = perf[\"total_duration\"] / total if total > 0 else 0.0\n        return performance\n\n    def get_productive_files(self, lookback_seconds: int = 86400) -> List[str]:\n        \"\"\"Return files successfully modified most often, sorted by frequency.\"\"\"\n        import re\n        cutoff = time.time() - lookback_seconds\n        records = self._load_history()\n        file_counts: Dict[str, int] = {}\n        for r in records:\n            if r.get(\"timestamp\", 0) < cutoff or not r.get(\"success\", False):\n                continue\n            for task_desc in r.get(\"task_descriptions\", [r.get(\"task_description\", \"\")]):\n                matches = re.findall(\n                    r'([a-zA-Z0-9_/.\\-]+\\.(?:py|js|ts|tsx|jsx|go|rs|java|rb|sh|yaml|yml|json))',\n                    task_desc,\n                )\n                for m in matches:\n                    file_counts[m] = file_counts.get(m, 0) + 1\n        return sorted(file_counts.keys(), key=lambda f: file_counts[f], reverse=True)\n\n    def load_history(self) -> List[Dict[str, Any]]:\n        \"\"\"Public API for loading history (safe for external callers).\"\"\"\n        return self._load_history()\n","numLines":467,"startLine":1,"totalLines":467}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_vrtx_01TdYym95A3yK96ZSPRqiw3Y","type":"tool_result","content":"     1→\"\"\"Shared utility functions used across orchestrator, coordinator, and worker.\"\"\"\n     2→\n     3→from __future__ import annotations\n     4→\n     5→import ast\n     6→import logging\n     7→import re\n     8→from pathlib import Path\n     9→from typing import Dict, List, Optional\n    10→\n    11→from task_discovery import Task\n    12→\n    13→logger = logging.getLogger(__name__)\n    14→\n    15→# Regex to extract file references from task descriptions and context.\n    16→# Matches backtick-quoted file paths like `foo.py:123` and unquoted paths\n    17→# preceded by \"in\" or \"for\".\n    18→_FILE_REF_RE = re.compile(\n    19→    r'`([a-zA-Z0-9_/.\\-]+\\.(?:py|js|ts|tsx|jsx|go|rs|java|rb|sh|yaml|yml|json|md|txt))'\n    20→    r'(?::(\\d+))?(?:-\\d+)?`'\n    21→)\n    22→_FILE_REF_FALLBACK_RE = re.compile(\n    23→    r'(?:in\\s+|for\\s+)([a-zA-Z0-9_/.\\-]+\\.(?:py|js|ts|tsx|jsx|go|rs|java|rb|sh|yaml|yml|json|md|txt))'\n    24→    r'(?::(\\d+))?'\n    25→)\n    26→\n    27→\n    28→def _extract_relevant_files(tasks: List[Task], max_files: int = 5) -> List[str]:\n    29→    \"\"\"Extract unique file references from task descriptions and context.\n    30→\n    31→    Returns up to *max_files* unique file paths, ordered by first appearance.\n    32→    \"\"\"\n    33→    seen: set = set()\n    34→    files: List[str] = []\n    35→\n    36→    for task in tasks:\n    37→        texts = [task.description]\n    38→        if task.context:\n    39→            texts.append(task.context)\n    40→        if task.source_file:\n    41→            path = task.source_file\n    42→            if path not in seen:\n    43→                seen.add(path)\n    44→                files.append(path)\n    45→\n    46→        for text in texts:\n    47→            for match in _FILE_REF_RE.finditer(text):\n    48→                path = match.group(1)\n    49→                if path not in seen:\n    50→                    seen.add(path)\n    51→                    files.append(path)\n    52→            for match in _FILE_REF_FALLBACK_RE.finditer(text):\n    53→                path = match.group(1)\n    54→                if path not in seen:\n    55→                    seen.add(path)\n    56→                    files.append(path)\n    57→\n    58→        if len(files) >= max_files:\n    59→            break\n    60→\n    61→    return files[:max_files]\n    62→\n    63→\n    64→# ------------------------------------------------------------------\n    65→# Task dependency ordering (DAG topological sort)\n    66→# ------------------------------------------------------------------\n    67→\n    68→def topological_sort_tasks(tasks: List[Task]) -> List[Task]:\n    69→    \"\"\"Topological sort using Kahn's algorithm with priority tie-breaking.\n    70→\n    71→    Raises ValueError if a dependency cycle is detected.\n    72→    \"\"\"\n    73→    task_map = {t.task_id: t for t in tasks}\n    74→    in_degree = {t.task_id: 0 for t in tasks}\n    75→    for t in tasks:\n    76→        for dep in t.depends_on:\n    77→            if dep in task_map:\n    78→                in_degree[t.task_id] += 1\n    79→    queue = sorted(\n    80→        [t for t in tasks if in_degree[t.task_id] == 0],\n    81→        key=lambda t: t.priority,\n    82→    )\n    83→    result: List[Task] = []\n    84→    while queue:\n    85→        task = queue.pop(0)\n    86→        result.append(task)\n    87→        for t in tasks:\n    88→            if task.task_id in t.depends_on:\n    89→                in_degree[t.task_id] -= 1\n    90→                if in_degree[t.task_id] == 0:\n    91→                    queue.append(t)\n    92→                    queue.sort(key=lambda x: x.priority)\n    93→    if len(result) != len(tasks):\n    94→        raise ValueError(\"Cycle detected in task dependencies\")\n    95→    return result\n    96→\n    97→\n    98→# ------------------------------------------------------------------\n    99→# Task-type-specific instructions appended to prompts\n   100→# ------------------------------------------------------------------\n   101→TASK_TYPE_INSTRUCTIONS = {\n   102→    \"test_failure\": \"\"\"\\\n   103→- Read the failing test(s) carefully. Understand what the test expects.\n   104→- The traceback in the CONTEXT section shows exactly where the failure occurs.\n   105→- Determine whether the bug is in the implementation or the test.\n   106→- Fix whichever side is wrong. You may fix the code, fix the tests, or both.\n   107→- Run the specific failing test to verify your fix.\"\"\",\n   108→\n   109→    \"lint\": \"\"\"\\\n   110→- The lint error details are in the CONTEXT section showing the exact line.\n   111→- Fix only the specific lint violations listed. Do not refactor unrelated code.\n   112→- For style issues (line length, whitespace), make minimal formatting changes.\n   113→- For semantic issues (unused imports, undefined names), fix the root cause.\"\"\",\n   114→\n   115→    \"todo\": \"\"\"\\\n   116→- The TODO/FIXME comment and surrounding code are in the CONTEXT section.\n   117→- Address the intent of the comment. Remove the TODO/FIXME marker when done.\n   118→- If the TODO requires significant design decisions, implement the simplest correct approach.\n   119→- Add or update tests if your change modifies behavior.\"\"\",\n   120→\n   121→    \"coverage\": \"\"\"\\\n   122→- Write tests for the uncovered code paths in the specified file.\n   123→- Focus on testing meaningful behavior, not just line coverage.\n   124→- Follow the existing test patterns in the project's test directory.\n   125→- Use descriptive test names that explain what scenario is being tested.\"\"\",\n   126→\n   127→    \"quality\": \"\"\"\\\n   128→- Focus on improving code clarity and maintainability.\n   129→- Break up overly long functions or files into logical units.\n   130→- Do NOT change behavior. All existing tests must continue to pass.\"\"\",\n   131→\n   132→    \"claude_idea\": \"\"\"\\\n   133→- Implement the improvement described above.\n   134→- Be thorough but conservative. Follow existing code patterns.\n   135→- Add tests for any new functionality you introduce.\"\"\",\n   136→\n   137→    \"feedback\": \"\"\"\\\n   138→- This task was written by a human developer. Follow it precisely.\n   139→- If the instructions are ambiguous, make the most reasonable interpretation.\n   140→- After implementing, verify that your changes match the developer's intent.\"\"\",\n   141→}\n   142→\n   143→\n   144→def format_task_list(tasks: List[Task]) -> str:\n   145→    \"\"\"Format tasks as a numbered list with source tags and context.\"\"\"\n   146→    lines = []\n   147→    for i, task in enumerate(tasks, 1):\n   148→        lines.append(f\"{i}. {task.description} [{task.source}]\")\n   149→        if task.context:\n   150→            lines.append(f\"   CONTEXT:\")\n   151→            for ctx_line in task.context.split(\"\\n\"):\n   152→                lines.append(f\"   {ctx_line}\")\n   153→    return \"\\n\".join(lines)\n   154→\n   155→\n   156→def syntax_check_files(changed_files: List[str], base_dir: str) -> Optional[str]:\n   157→    \"\"\"Syntax-check modified .py files under base_dir.\n   158→\n   159→    Returns an error string if a syntax error is found, None otherwise.\n   160→    \"\"\"\n   161→    for f in changed_files:\n   162→        if f.endswith(\".py\"):\n   163→            full_path = Path(base_dir) / f\n   164→            if full_path.exists():\n   165→                try:\n   166→                    source = full_path.read_text()\n   167→                    ast.parse(source, filename=f)\n   168→                except SyntaxError as e:\n   169→                    return f\"Syntax error in {f} at line {e.lineno}: {e.msg}\"\n   170→    return None\n   171→\n   172→\n   173→def gather_tasks(config, feedback_manager, state_manager, discovery,\n   174→                  dashboard_active: bool = False,\n   175→                  task_approval_queue=None) -> List[Task]:\n   176→    \"\"\"Gather all eligible tasks from feedback and auto-discovery.\n   177→\n   178→    Shared between Orchestrator and ParallelCoordinator.\n   179→    When config.discovery.adaptive_priority is True, task priorities are\n   180→    boosted based on historical success rates per task type.\n   181→\n   182→    When dashboard_active is True and task_approval_queue is provided and\n   183→    config.orchestrator.task_approval is True:\n   184→    - Feedback tasks are returned immediately (bypass approval gate)\n   185→    - Auto-discovered tasks are enqueued for approval and excluded from return\n   186→    - Previously approved tasks are included in the return list\n   187→    \"\"\"\n   188→    tasks: List[Task] = []\n   189→    approval_active = (\n   190→        dashboard_active\n   191→        and task_approval_queue is not None\n   192→        and getattr(config.orchestrator, 'task_approval', True)\n   193→    )\n   194→\n   195→    # Priority 1: developer feedback (always bypass approval gate)\n   196→    max_retries = config.orchestrator.max_feedback_retries\n   197→    for task in feedback_manager.get_pending_feedback():\n   198→        failure_count = state_manager.get_task_failure_count(\n   199→            task.description, \"feedback\", task_key=task.task_key,\n   200→        )\n   201→        if failure_count >= max_retries:\n   202→            logger.warning(\n   203→                \"Feedback task failed %d times, moving to failed/\",\n   204→                failure_count,\n   205→            )\n   206→            if task.source_file:\n   207→                feedback_manager.mark_failed(task.source_file)\n   208→            continue\n   209→        if not state_manager.was_recently_attempted(\n   210→            task.description, task_key=task.task_key,\n   211→        ):\n   212→            tasks.append(task)\n   213→\n   214→    # Auto-discovered tasks\n   215→    discovered = discovery.discover_all()\n   216→    discovered_eligible = []\n   217→    for task in discovered:\n   218→        if not state_manager.was_recently_attempted(\n   219→            task.description, task_key=task.task_key,\n   220→        ):\n   221→            discovered_eligible.append(task)\n   222→\n   223→    if approval_active:\n   224→        # Enqueue auto-discovered tasks for approval instead of returning them\n   225→        # Exception: test_failure tasks are always safe to attempt (the test\n   226→        # already exists and is already failing), so auto-approve them.\n   227→        cooldown = config.discovery.idea_cooldown_seconds\n   228→        enqueued_count = 0\n   229→        for task in discovered_eligible:\n   230→            if task.source == \"test_failure\":\n   231→                tasks.append(task)\n   232→            else:\n   233→                task_approval_queue.enqueue(task, cooldown_seconds=cooldown)\n   234→                enqueued_count += 1\n   235→\n   236→        # Include previously approved tasks\n   237→        approved = task_approval_queue.get_approved()\n   238→        tasks.extend(approved)\n   239→\n   240→        if enqueued_count and not approved:\n   241→            pending_total = task_approval_queue.pending_count() if hasattr(task_approval_queue, 'pending_count') else enqueued_count\n   242→            logger.info(\n   243→                \"Task approval gate active: %d task(s) pending approval in dashboard, \"\n   244→                \"0 approved. Approve tasks at the dashboard to proceed.\",\n   245→                pending_total,\n   246→            )\n   247→    else:\n   248→        # No approval gate — include all discovered tasks directly\n   249→        tasks.extend(discovered_eligible)\n   250→\n   251→    # Apply adaptive priority: boost tasks of types with high success rates\n   252→    if config.discovery.adaptive_priority and tasks:\n   253→        success_rates = state_manager.get_success_rate_by_type(lookback_seconds=86400)\n   254→        if success_rates:\n   255→            for task in tasks:\n   256→                rate = success_rates.get(task.source)\n   257→                if rate is not None and rate > 0:\n   258→                    # Higher success rate -> lower priority number (higher priority)\n   259→                    # Multiply priority by (1 - rate) to boost high-success types\n   260→                    # e.g., 80% success rate -> priority * 0.2\n   261→                    factor = max(0.1, 1.0 - rate)\n   262→                    task.priority = max(1, int(task.priority * factor))\n   263→\n   264→    # Apply topological sort if any tasks have dependencies\n   265→    if any(t.depends_on for t in tasks):\n   266→        try:\n   267→            tasks = topological_sort_tasks(tasks)\n   268→        except ValueError as e:\n   269→            logger.warning(\"Task dependency cycle: %s\", e)\n   270→            tasks.sort(key=lambda t: t.priority)\n   271→\n   272→    return tasks\n   273→# ------------------------------------------------------------------\n   274→# Commit-message helpers (shared between Orchestrator and Worker)\n   275→# ------------------------------------------------------------------\n   276→\n   277→# Verb prefix applied to the commit subject based on the task source.\n   278→_SOURCE_VERBS = {\n   279→    \"test_failure\": \"Fix\",\n   280→    \"lint\": \"Fix\",\n   281→    \"todo\": None,       # handled by _derive_todo_subject()\n   282→    \"feedback\": None,   # human-written, use as-is\n   283→    \"claude_idea\": None,  # already descriptive, use as-is\n   284→    \"coverage\": \"Add test coverage for\",\n   285→    \"quality\": \"Refactor\",\n   286→}\n   287→\n   288→# Prefixes commonly produced by task_discovery that should be stripped\n   289→_STRIP_PREFIXES = [\n   290→    \"Fix test failure: \",\n   291→    \"Fix test failure in \",\n   292→    \"FAILED \",\n   293→    \"Fix lint error in \",\n   294→    \"Fix lint error: \",\n   295→    \"Address TODO in \",\n   296→    \"Address TODO: \",\n   297→    \"IDEA: \",\n   298→]\n   299→\n   300→\n   301→def clean_description(desc: str) -> str:\n   302→    \"\"\"Clean an auto-generated task description for use in commit messages.\"\"\"\n   303→    text = desc.strip()\n   304→\n   305→    lower = text.lower()\n   306→    for pfx in _STRIP_PREFIXES:\n   307→        if lower.startswith(pfx.lower()):\n   308→            text = text[len(pfx):]\n   309→            break\n   310→\n   311→    text = text.replace(\"`\", \"\")\n   312→    text = re.sub(r'(\\.\\w+):\\d+(?:-\\d+)?', r'\\1', text)\n   313→    text = text.strip()\n   314→\n   315→    if text:\n   316→        text = text[0].upper() + text[1:]\n   317→\n   318→    return text\n   319→\n   320→\n   321→def _derive_todo_subject(description: str) -> str:\n   322→    \"\"\"Derive a commit subject from a TODO task description.\"\"\"\n   323→    text = description.strip()\n   324→\n   325→    m = re.match(\n   326→        r'(?:Address\\s+)?TODO\\s+in\\s+'\n   327→        r'([a-zA-Z0-9_/.\\-]+\\.\\w+)'\n   328→        r'(?::\\d+(?:-\\d+)?)?'\n   329→        r':\\s*(.+)',\n   330→        text, re.IGNORECASE,\n   331→    )\n   332→    if m:\n   333→        filepath = m.group(1)\n   334→        action = m.group(2).strip()\n   335→        action = re.sub(r'^(?:FIXME|TODO|XXX)\\s*:?\\s*', '', action, flags=re.IGNORECASE)\n   336→        if action:\n   337→            action = action[0].upper() + action[1:]\n   338→            return f\"{action} in {filepath}\"\n   339→        return f\"Address TODO in {filepath}\"\n   340→\n   341→    cleaned = clean_description(text)\n   342→    return cleaned if cleaned else \"Address TODO\"\n   343→\n   344→\n   345→def extract_file_names(tasks: List[Task]) -> List[str]:\n   346→    \"\"\"Extract file names mentioned in task descriptions.\"\"\"\n   347→    files = []\n   348→    for t in tasks:\n   349→        m = re.search(\n   350→            r'([a-zA-Z0-9_/.\\-]+\\.(?:py|js|ts|tsx|jsx|go|rs|java|rb|sh|yaml|yml|json|md|txt))',\n   351→            t.description,\n   352→        )\n   353→        if m:\n   354→            fname = m.group(1).split(\"/\")[-1]\n   355→            if fname not in files:\n   356→                files.append(fname)\n   357→    return files\n   358→\n   359→\n   360→def build_commit_message(task: Task) -> str:\n   361→    \"\"\"Build a conventional, human-style commit message for a single task.\"\"\"\n   362→    cleaned = clean_description(task.description)\n   363→    verb = _SOURCE_VERBS.get(task.source)\n   364→\n   365→    if task.source == \"todo\":\n   366→        subject = _derive_todo_subject(task.description)\n   367→    elif verb is None:\n   368→        subject = cleaned\n   369→    else:\n   370→        if cleaned.lower().startswith(verb.lower()):\n   371→            subject = cleaned\n   372→        else:\n   373→            subject = f\"{verb} {cleaned[0].lower() + cleaned[1:]}\" if cleaned else verb\n   374→\n   375→    if subject:\n   376→        subject = subject[0].upper() + subject[1:]\n   377→\n   378→    if len(subject) > 72:\n   379→        full_subject = subject\n   380→        truncated = subject[:69]\n   381→        last_space = truncated.rfind(\" \")\n   382→        if last_space > 40:\n   383→            truncated = truncated[:last_space]\n   384→        subject = truncated + \"...\"\n   385→        return subject + \"\\n\\n\" + full_subject\n   386→    return subject\n   387→\n   388→\n   389→def build_batch_commit_message(tasks: List[Task]) -> str:\n   390→    \"\"\"Build a natural commit message summarizing a batch of tasks.\"\"\"\n   391→    sources = set(t.source for t in tasks)\n   392→\n   393→    if len(sources) == 1:\n   394→        source = next(iter(sources))\n   395→        subject = _summarize_same_source(source, tasks)\n   396→    else:\n   397→        subject = _summarize_mixed_sources(sources, tasks)\n   398→\n   399→    if len(subject) > 72:\n   400→        truncated = subject[:69]\n   401→        last_space = truncated.rfind(\" \")\n   402→        if last_space > 40:\n   403→            truncated = truncated[:last_space]\n   404→        subject = truncated + \"...\"\n   405→\n   406→    body_lines = [f\"- {clean_description(t.description)}\" for t in tasks]\n   407→    return subject + \"\\n\\n\" + \"\\n\".join(body_lines)\n   408→\n   409→\n   410→def _summarize_same_source(source: str, tasks: List[Task]) -> str:\n   411→    \"\"\"Generate a summary subject when all tasks share the same source.\"\"\"\n   412→    count = len(tasks)\n   413→    files = extract_file_names(tasks)\n   414→\n   415→    if source == \"test_failure\":\n   416→        if files and len(files) <= 2:\n   417→            return f\"Fix test failures in {' and '.join(files)}\"\n   418→        return f\"Fix test failures in {count} files\"\n   419→\n   420→    if source == \"lint\":\n   421→        if files and len(files) <= 2:\n   422→            return f\"Fix lint errors in {' and '.join(files)}\"\n   423→        return f\"Fix lint errors in {count} files\"\n   424→\n   425→    if source == \"todo\":\n   426→        return f\"Address TODOs across {count} modules\"\n   427→\n   428→    if source == \"coverage\":\n   429→        return f\"Add test coverage for {count} modules\"\n   430→\n   431→    if source == \"quality\":\n   432→        return f\"Refactor {count} modules\"\n   433→\n   434→    if source == \"claude_idea\":\n   435→        cleaned = clean_description(tasks[0].description)\n   436→        if count > 1:\n   437→            return f\"{cleaned} and {count - 1} more improvements\"\n   438→        return cleaned\n   439→\n   440→    if source == \"feedback\":\n   441→        cleaned = clean_description(tasks[0].description)\n   442→        if count > 1:\n   443→            return f\"{cleaned} and {count - 1} more tasks\"\n   444→        return cleaned\n   445→\n   446→    return f\"Apply {count} changes\"\n   447→\n   448→\n   449→def _summarize_mixed_sources(sources: set, tasks: List[Task]) -> str:\n   450→    \"\"\"Generate a summary subject for tasks with mixed source types.\"\"\"\n   451→    parts = []\n   452→    source_groups = {}\n   453→    for t in tasks:\n   454→        source_groups.setdefault(t.source, []).append(t)\n   455→\n   456→    for src in [\"test_failure\", \"lint\", \"todo\", \"coverage\", \"quality\",\n   457→                 \"claude_idea\", \"feedback\"]:\n   458→        group = source_groups.get(src)\n   459→        if not group:\n   460→            continue\n   461→        if src == \"test_failure\":\n   462→            parts.append(\"fix test failures\")\n   463→        elif src == \"lint\":\n   464→            parts.append(\"fix lint errors\")\n   465→        elif src == \"todo\":\n   466→            parts.append(\"address TODOs\")\n   467→        elif src == \"coverage\":\n   468→            parts.append(\"add test coverage\")\n   469→        elif src == \"quality\":\n   470→            parts.append(\"refactor\")\n   471→        elif src in (\"claude_idea\", \"feedback\"):\n   472→            parts.append(clean_description(group[0].description).lower())\n   473→\n   474→    file_count = len(set().union(*(set(extract_file_names(source_groups[s]))\n   475→                                   for s in source_groups)))\n   476→    subject_parts = \" and \".join(parts[:2])\n   477→    if len(parts) > 2:\n   478→        subject_parts += f\" and {len(parts) - 2} more\"\n   479→\n   480→    subject = subject_parts[0].upper() + subject_parts[1:] if subject_parts else \"Apply changes\"\n   481→\n   482→    if file_count:\n   483→        subject += f\" in {file_count} files\"\n   484→\n   485→    return subject\n   486→\n   487→\n   488→# ------------------------------------------------------------------\n   489→# Shared prompt builders (used by both Orchestrator and Worker)\n   490→# ------------------------------------------------------------------\n   491→\n   492→def _working_dir_preamble(working_dir: Optional[str] = None) -> str:\n   493→    \"\"\"Build the working directory preamble for prompts.\n   494→\n   495→    When working_dir is set (worker mode), tells Claude to use absolute paths\n   496→    within that directory and to not modify files outside it.\n   497→    When None (orchestrator mode), uses simpler \"current directory\" phrasing.\n   498→    \"\"\"\n   499→    if working_dir:\n   500→        return (\n   501→            f\"You are working on the project at {working_dir}.\\n\"\n   502→            \"All file reads, writes, and edits MUST use absolute paths within that directory.\\n\"\n   503→            \"WARNING: Do NOT modify any files outside that directory. Do NOT use relative paths.\\n\"\n   504→        )\n   505→    return \"You are working on the project in the current directory.\\n\"\n   506→\n   507→\n   508→def build_task_prompt(\n   509→    tasks: List[Task],\n   510→    protected_files: List[str],\n   511→    working_dir: Optional[str] = None,\n   512→) -> str:\n   513→    \"\"\"Build a direct execution prompt for one or more tasks.\n   514→\n   515→    Args:\n   516→        tasks: The task(s) to include.\n   517→        protected_files: Files that must not be modified.\n   518→        working_dir: If set, absolute path used in worktree preamble.\n   519→    \"\"\"\n   520→    protected = \", \".join(protected_files)\n   521→    preamble = _working_dir_preamble(working_dir)\n   522→\n   523→    # Build RELEVANT FILES section from file references in tasks\n   524→    relevant = _extract_relevant_files(tasks)\n   525→    relevant_section = \"\"\n   526→    if relevant:\n   527→        lines = \"\\n\".join(f\"- {f}\" for f in relevant)\n   528→        relevant_section = f\"\\nRELEVANT FILES:\\n{lines}\\n\"\n   529→\n   530→    if len(tasks) > 1:\n   531→        task_list = format_task_list(tasks)\n   532→        return (\n   533→            f\"{preamble}\\n\"\n   534→            \"You have been given a batch of tasks to address in a single comprehensive change.\\n\\n\"\n   535→            f\"TASKS:\\n{task_list}\\n\"\n   536→            f\"{relevant_section}\\n\"\n   537→            \"INSTRUCTIONS:\\n\"\n   538→            \"- Make the minimal changes needed to complete ALL tasks above.\\n\"\n   539→            \"- Do NOT run git commands (add, commit, push). The orchestrator handles git.\\n\"\n   540→            f\"- Do NOT modify these protected files: {protected}\\n\"\n   541→            \"- Focus on correctness. Run tests if available.\\n\"\n   542→            \"- If a task is unclear or impossible, make your best effort and explain what you did.\\n\"\n   543→            \"- Use the CONTEXT provided with each task to understand the code and errors involved.\\n\"\n   544→            \"- Make your changes immediately. Do NOT spend turns exploring the codebase — go directly to editing files.\\n\"\n   545→        )\n   546→\n   547→    task = tasks[0]\n   548→    context_section = \"\"\n   549→    if task.context:\n   550→        context_section = f\"\\nCONTEXT:\\n{task.context}\\n\"\n   551→    specific_instructions = TASK_TYPE_INSTRUCTIONS.get(task.source, \"\")\n   552→    return (\n   553→        f\"{preamble}\\n\"\n   554→        f\"TASK: {task.description}\\n\"\n   555→        f\"{context_section}\"\n   556→        f\"{relevant_section}\\n\"\n   557→        \"INSTRUCTIONS:\\n\"\n   558→        \"- Make the minimal changes needed to complete this task.\\n\"\n   559→        \"- Do NOT run git commands (add, commit, push). The orchestrator handles git.\\n\"\n   560→        f\"- Do NOT modify these protected files: {protected}\\n\"\n   561→        \"- Focus on correctness. Run tests if available.\\n\"\n   562→        \"- If the task is unclear or impossible, make your best effort and explain what you did.\\n\"\n   563→        f\"{specific_instructions}\\n\"\n   564→        \"- Make your changes immediately. Do NOT spend turns exploring the codebase — go directly to editing files.\\n\"\n   565→    )\n   566→\n   567→\n   568→def build_plan_prompt(\n   569→    tasks: List[Task],\n   570→    protected_files: List[str],\n   571→    working_dir: Optional[str] = None,\n   572→) -> str:\n   573→    \"\"\"Build a planning-only prompt (no file changes).\n   574→\n   575→    Args:\n   576→        tasks: The task(s) to plan for.\n   577→        protected_files: Files that must not be modified.\n   578→        working_dir: If set, absolute path used in worktree preamble.\n   579→    \"\"\"\n   580→    protected = \", \".join(protected_files)\n   581→    preamble = _working_dir_preamble(working_dir)\n   582→\n   583→    if len(tasks) > 1:\n   584→        task_list = format_task_list(tasks)\n   585→        task_count = len(tasks) + 1\n   586→        task_count_plus1 = len(tasks) + 2\n   587→        return (\n   588→            f\"{preamble}\\n\"\n   589→            \"You have been given a batch of tasks to address in a single comprehensive change.\\n\\n\"\n   590→            f\"TASKS:\\n{task_list}\\n\\n\"\n   591→            f\"ADDITIONAL CHECKS (always perform these):\\n\"\n   592→            f\"{task_count}. Check whether any of the above changes require NEW tests to be added. \"\n   593→            \"If new functionality is introduced or existing behavior is changed, plan to add or update tests.\\n\"\n   594→            f\"{task_count_plus1}. Check whether README.md needs updating to reflect any of the above changes. \"\n   595→            \"If user-facing behavior, configuration options, or architecture changed, plan to update README.md.\\n\\n\"\n   596→            \"INSTRUCTIONS:\\n\"\n   597→            \"- Analyze the codebase and create a detailed, comprehensive plan that addresses ALL tasks above.\\n\"\n   598→            \"- Do NOT make any changes yet. Only output a plan.\\n\"\n   599→            \"- List every file you would modify and what changes you would make in each.\\n\"\n   600→            f\"- Do NOT modify these protected files: {protected}\\n\"\n   601→            \"- Be specific about the changes (function names, line numbers, etc.).\\n\"\n   602→            \"- Group related changes together where possible for clarity.\\n\"\n   603→            \"- Address the tasks in priority order but look for opportunities to combine related changes.\\n\"\n   604→            \"- Use the CONTEXT provided with each task to understand the code and errors involved.\\n\"\n   605→            \"- Output your complete plan within 5 turns. Do NOT spend turns reading files — focus on producing the plan.\\n\"\n   606→        )\n   607→\n   608→    task = tasks[0]\n   609→    context_section = \"\"\n   610→    if task.context:\n   611→        context_section = f\"\\nCONTEXT:\\n{task.context}\\n\"\n   612→    specific_instructions = TASK_TYPE_INSTRUCTIONS.get(task.source, \"\")\n   613→    return (\n   614→        f\"{preamble}\\n\"\n   615→        f\"TASK: {task.description}\\n\"\n   616→        f\"{context_section}\\n\"\n   617→        \"INSTRUCTIONS:\\n\"\n   618→        \"- Analyze the codebase and create a detailed plan to complete this task.\\n\"\n   619→        \"- Do NOT make any changes yet. Only output a plan.\\n\"\n   620→        \"- List the files you would modify and what changes you would make.\\n\"\n   621→        f\"- Do NOT modify these protected files: {protected}\\n\"\n   622→        \"- Be specific about the changes (function names, line numbers, etc.).\\n\"\n   623→        f\"{specific_instructions}\\n\"\n   624→        \"- Output your complete plan within 5 turns. Do NOT spend turns reading files — focus on producing the plan.\\n\"\n   625→    )\n   626→\n   627→\n   628→def build_execute_prompt(\n   629→    tasks: List[Task],\n   630→    plan_text: str,\n   631→    protected_files: List[str],\n   632→    working_dir: Optional[str] = None,\n   633→) -> str:\n   634→    \"\"\"Build an execution prompt that includes a pre-made plan.\n   635→\n   636→    Args:\n   637→        tasks: The task(s) to execute.\n   638→        plan_text: The plan generated by the planning phase.\n   639→        protected_files: Files that must not be modified.\n   640→        working_dir: If set, absolute path used in worktree preamble.\n   641→    \"\"\"\n   642→    protected = \", \".join(protected_files)\n   643→    preamble = _working_dir_preamble(working_dir)\n   644→\n   645→    if len(tasks) > 1:\n   646→        task_list = format_task_list(tasks)\n   647→        return (\n   648→            f\"{preamble}\\n\"\n   649→            \"You have been given a batch of tasks to address in a single comprehensive change.\\n\\n\"\n   650→            f\"TASKS:\\n{task_list}\\n\\n\"\n   651→            f\"PLAN TO EXECUTE:\\n{plan_text}\\n\\n\"\n   652→            \"INSTRUCTIONS:\\n\"\n   653→            \"- Execute the plan above by making ALL described changes.\\n\"\n   654→            \"- Do NOT run git commands (add, commit, push). The orchestrator handles git.\\n\"\n   655→            f\"- Do NOT modify these protected files: {protected}\\n\"\n   656→            \"- Focus on correctness. Run tests after making changes.\\n\"\n   657→            \"- Stick to the plan. Do not deviate unless the plan has an obvious error.\\n\"\n   658→            \"- Make ALL changes in this single session. This is a comprehensive revamp, not incremental.\\n\"\n   659→            \"- Use the CONTEXT provided with each task to understand the code and errors involved.\\n\"\n   660→            \"- Make your changes immediately. Do NOT spend turns exploring the codebase — go directly to editing files.\\n\"\n   661→        )\n   662→\n   663→    task = tasks[0]\n   664→    context_section = \"\"\n   665→    if task.context:\n   666→        context_section = f\"\\nCONTEXT:\\n{task.context}\\n\"\n   667→    specific_instructions = TASK_TYPE_INSTRUCTIONS.get(task.source, \"\")\n   668→    return (\n   669→        f\"{preamble}\\n\"\n   670→        f\"TASK: {task.description}\\n\"\n   671→        f\"{context_section}\\n\"\n   672→        f\"PLAN TO EXECUTE:\\n{plan_text}\\n\\n\"\n   673→        \"INSTRUCTIONS:\\n\"\n   674→        \"- Execute the plan above by making the described changes.\\n\"\n   675→        \"- Do NOT run git commands (add, commit, push). The orchestrator handles git.\\n\"\n   676→        f\"- Do NOT modify these protected files: {protected}\\n\"\n   677→        \"- Focus on correctness. Run tests if available.\\n\"\n   678→        \"- Stick to the plan. Do not deviate unless the plan has an obvious error.\\n\"\n   679→        f\"{specific_instructions}\\n\"\n   680→        \"- Make your changes immediately. Do NOT spend turns exploring the codebase — go directly to editing files.\\n\"\n   681→    )\n   682→\n   683→\n   684→_COMMON_FAILURE_PATTERNS: Dict[str, str] = {\n   685→    \"test_failure\": (\n   686→        \"- Wrong assertion value or outdated expected result\\n\"\n   687→        \"- Missing import in the module under test\\n\"\n   688→        \"- Function signature changed but callers not updated\\n\"\n   689→        \"- Fixture or mock not matching new behavior\\n\"\n   690→        \"- Off-by-one errors in boundary conditions\"\n   691→    ),\n   692→    \"lint\": (\n   693→        \"- Unused import not removed after refactoring\\n\"\n   694→        \"- Line too long (exceeds configured max length)\\n\"\n   695→        \"- Trailing whitespace or missing newline at end of file\\n\"\n   696→        \"- Variable assigned but never used\\n\"\n   697→        \"- Wrong import order (stdlib vs third-party vs local)\"\n   698→    ),\n   699→    \"todo\": (\n   700→        \"- Implementation incomplete — only part of the TODO was addressed\\n\"\n   701→        \"- New code introduced a test regression\\n\"\n   702→        \"- Missing error handling for edge cases mentioned in the TODO\"\n   703→    ),\n   704→    \"quality\": (\n   705→        \"- Refactoring changed behavior instead of just restructuring\\n\"\n   706→        \"- Extracted function has wrong parameter list or return value\\n\"\n   707→        \"- Existing tests rely on the old structure\"\n   708→    ),\n   709→    \"coverage\": (\n   710→        \"- New test imports the wrong module or function name\\n\"\n   711→        \"- Test assertions don't match actual function behavior\\n\"\n   712→        \"- Missing test fixtures or setup for the code under test\"\n   713→    ),\n   714→    \"claude_idea\": (\n   715→        \"- Change scope was too broad — unrelated code was affected\\n\"\n   716→        \"- New code conflicts with existing patterns or conventions\\n\"\n   717→        \"- Missing edge case handling that existing tests exercise\"\n   718→    ),\n   719→}\n   720→\n   721→\n   722→def _common_failure_patterns(tasks: List[Task]) -> str:\n   723→    \"\"\"Return a COMMON FAILURE PATTERNS section based on task types.\"\"\"\n   724→    sources = {t.source for t in tasks if t.source}\n   725→    tips = []\n   726→    for source in sorted(sources):\n   727→        patterns = _COMMON_FAILURE_PATTERNS.get(source)\n   728→        if patterns:\n   729→            tips.append(f\"For {source} tasks:\\n{patterns}\")\n   730→    if not tips:\n   731→        return \"\"\n   732→    return \"COMMON FAILURE PATTERNS:\\n\" + \"\\n\".join(tips) + \"\\n\"\n   733→\n   734→\n   735→def build_retry_prompt(\n   736→    tasks: List[Task],\n   737→    failure_output: str,\n   738→    protected_files: List[str],\n   739→    working_dir: Optional[str] = None,\n   740→    attempt: int = 0,\n   741→    max_attempts: int = 0,\n   742→) -> str:\n   743→    \"\"\"Build a retry prompt with validation failure output.\n   744→\n   745→    Args:\n   746→        tasks: The task(s) being retried.\n   747→        failure_output: The validation failure output.\n   748→        protected_files: Files that must not be modified.\n   749→        working_dir: If set, absolute path used in worktree preamble.\n   750→        attempt: Current attempt number (for orchestrator-style formatting).\n   751→        max_attempts: Total max attempts (for orchestrator-style formatting).\n   752→    \"\"\"\n   753→    protected = \", \".join(protected_files)\n   754→    preamble = _working_dir_preamble(working_dir)\n   755→\n   756→    # Truncate failure output to avoid exceeding prompt limits\n   757→    max_output = 8000\n   758→    if len(failure_output) > max_output:\n   759→        failure_output = failure_output[:max_output] + \"\\n... (truncated)\"\n   760→\n   761→    if len(tasks) > 1:\n   762→        task_list = format_task_list(tasks)\n   763→        task_section = f\"TASKS:\\n{task_list}\"\n   764→    else:\n   765→        task_section = f\"TASK: {tasks[0].description}\"\n   766→\n   767→    attempt_info = \"\"\n   768→    if attempt and max_attempts:\n   769→        attempt_info = f\" (attempt {attempt} of {max_attempts})\"\n   770→\n   771→    return (\n   772→        f\"{preamble}\\n\"\n   773→        f\"ORIGINAL {task_section}\\n\\n\"\n   774→        f\"YOUR PREVIOUS CHANGES FAILED VALIDATION{attempt_info}.\\n\\n\"\n   775→        f\"VALIDATION FAILURES:\\n\"\n   776→        f\"```\\n{failure_output}\\n```\\n\\n\"\n   777→        \"INSTRUCTIONS:\\n\"\n   778→        \"- Read the failure output above carefully.\\n\"\n   779→        \"- Determine whether the bug is in the code you changed or in the tests.\\n\"\n   780→        \"  Sometimes the test expectation is wrong (e.g., wrong return value asserted).\\n\"\n   781→        \"  Other times the implementation has the actual bug.\\n\"\n   782→        \"- Fix whichever side is wrong. You may fix the code, fix the tests, or both.\\n\"\n   783→        \"- Do NOT run git commands (add, commit, push). The orchestrator handles git.\\n\"\n   784→        f\"- Do NOT modify these protected files: {protected}\\n\"\n   785→        \"- Your previous changes are still in the working tree. Build on them, do not start over.\\n\"\n   786→        \"- Focus on making ALL validations pass.\\n\\n\"\n   787→        f\"{_common_failure_patterns(tasks)}\"\n   788→    )\n   789→"}]},"parent_tool_use_id":null,"session_id":"cdc88a14-e661-4229-849a-8b4c75790bc7","uuid":"b16abfa6-fe95-459d-b2e6-e0934eb58493","tool_use_result":{"type":"text","file":{"filePath":"/Users/sameertkhanna/Documents/auto_claude_code/shared.py","content":"\"\"\"Shared utility functions used across orchestrator, coordinator, and worker.\"\"\"\n\nfrom __future__ import annotations\n\nimport ast\nimport logging\nimport re\nfrom pathlib import Path\nfrom typing import Dict, List, Optional\n\nfrom task_discovery import Task\n\nlogger = logging.getLogger(__name__)\n\n# Regex to extract file references from task descriptions and context.\n# Matches backtick-quoted file paths like `foo.py:123` and unquoted paths\n# preceded by \"in\" or \"for\".\n_FILE_REF_RE = re.compile(\n    r'`([a-zA-Z0-9_/.\\-]+\\.(?:py|js|ts|tsx|jsx|go|rs|java|rb|sh|yaml|yml|json|md|txt))'\n    r'(?::(\\d+))?(?:-\\d+)?`'\n)\n_FILE_REF_FALLBACK_RE = re.compile(\n    r'(?:in\\s+|for\\s+)([a-zA-Z0-9_/.\\-]+\\.(?:py|js|ts|tsx|jsx|go|rs|java|rb|sh|yaml|yml|json|md|txt))'\n    r'(?::(\\d+))?'\n)\n\n\ndef _extract_relevant_files(tasks: List[Task], max_files: int = 5) -> List[str]:\n    \"\"\"Extract unique file references from task descriptions and context.\n\n    Returns up to *max_files* unique file paths, ordered by first appearance.\n    \"\"\"\n    seen: set = set()\n    files: List[str] = []\n\n    for task in tasks:\n        texts = [task.description]\n        if task.context:\n            texts.append(task.context)\n        if task.source_file:\n            path = task.source_file\n            if path not in seen:\n                seen.add(path)\n                files.append(path)\n\n        for text in texts:\n            for match in _FILE_REF_RE.finditer(text):\n                path = match.group(1)\n                if path not in seen:\n                    seen.add(path)\n                    files.append(path)\n            for match in _FILE_REF_FALLBACK_RE.finditer(text):\n                path = match.group(1)\n                if path not in seen:\n                    seen.add(path)\n                    files.append(path)\n\n        if len(files) >= max_files:\n            break\n\n    return files[:max_files]\n\n\n# ------------------------------------------------------------------\n# Task dependency ordering (DAG topological sort)\n# ------------------------------------------------------------------\n\ndef topological_sort_tasks(tasks: List[Task]) -> List[Task]:\n    \"\"\"Topological sort using Kahn's algorithm with priority tie-breaking.\n\n    Raises ValueError if a dependency cycle is detected.\n    \"\"\"\n    task_map = {t.task_id: t for t in tasks}\n    in_degree = {t.task_id: 0 for t in tasks}\n    for t in tasks:\n        for dep in t.depends_on:\n            if dep in task_map:\n                in_degree[t.task_id] += 1\n    queue = sorted(\n        [t for t in tasks if in_degree[t.task_id] == 0],\n        key=lambda t: t.priority,\n    )\n    result: List[Task] = []\n    while queue:\n        task = queue.pop(0)\n        result.append(task)\n        for t in tasks:\n            if task.task_id in t.depends_on:\n                in_degree[t.task_id] -= 1\n                if in_degree[t.task_id] == 0:\n                    queue.append(t)\n                    queue.sort(key=lambda x: x.priority)\n    if len(result) != len(tasks):\n        raise ValueError(\"Cycle detected in task dependencies\")\n    return result\n\n\n# ------------------------------------------------------------------\n# Task-type-specific instructions appended to prompts\n# ------------------------------------------------------------------\nTASK_TYPE_INSTRUCTIONS = {\n    \"test_failure\": \"\"\"\\\n- Read the failing test(s) carefully. Understand what the test expects.\n- The traceback in the CONTEXT section shows exactly where the failure occurs.\n- Determine whether the bug is in the implementation or the test.\n- Fix whichever side is wrong. You may fix the code, fix the tests, or both.\n- Run the specific failing test to verify your fix.\"\"\",\n\n    \"lint\": \"\"\"\\\n- The lint error details are in the CONTEXT section showing the exact line.\n- Fix only the specific lint violations listed. Do not refactor unrelated code.\n- For style issues (line length, whitespace), make minimal formatting changes.\n- For semantic issues (unused imports, undefined names), fix the root cause.\"\"\",\n\n    \"todo\": \"\"\"\\\n- The TODO/FIXME comment and surrounding code are in the CONTEXT section.\n- Address the intent of the comment. Remove the TODO/FIXME marker when done.\n- If the TODO requires significant design decisions, implement the simplest correct approach.\n- Add or update tests if your change modifies behavior.\"\"\",\n\n    \"coverage\": \"\"\"\\\n- Write tests for the uncovered code paths in the specified file.\n- Focus on testing meaningful behavior, not just line coverage.\n- Follow the existing test patterns in the project's test directory.\n- Use descriptive test names that explain what scenario is being tested.\"\"\",\n\n    \"quality\": \"\"\"\\\n- Focus on improving code clarity and maintainability.\n- Break up overly long functions or files into logical units.\n- Do NOT change behavior. All existing tests must continue to pass.\"\"\",\n\n    \"claude_idea\": \"\"\"\\\n- Implement the improvement described above.\n- Be thorough but conservative. Follow existing code patterns.\n- Add tests for any new functionality you introduce.\"\"\",\n\n    \"feedback\": \"\"\"\\\n- This task was written by a human developer. Follow it precisely.\n- If the instructions are ambiguous, make the most reasonable interpretation.\n- After implementing, verify that your changes match the developer's intent.\"\"\",\n}\n\n\ndef format_task_list(tasks: List[Task]) -> str:\n    \"\"\"Format tasks as a numbered list with source tags and context.\"\"\"\n    lines = []\n    for i, task in enumerate(tasks, 1):\n        lines.append(f\"{i}. {task.description} [{task.source}]\")\n        if task.context:\n            lines.append(f\"   CONTEXT:\")\n            for ctx_line in task.context.split(\"\\n\"):\n                lines.append(f\"   {ctx_line}\")\n    return \"\\n\".join(lines)\n\n\ndef syntax_check_files(changed_files: List[str], base_dir: str) -> Optional[str]:\n    \"\"\"Syntax-check modified .py files under base_dir.\n\n    Returns an error string if a syntax error is found, None otherwise.\n    \"\"\"\n    for f in changed_files:\n        if f.endswith(\".py\"):\n            full_path = Path(base_dir) / f\n            if full_path.exists():\n                try:\n                    source = full_path.read_text()\n                    ast.parse(source, filename=f)\n                except SyntaxError as e:\n                    return f\"Syntax error in {f} at line {e.lineno}: {e.msg}\"\n    return None\n\n\ndef gather_tasks(config, feedback_manager, state_manager, discovery,\n                  dashboard_active: bool = False,\n                  task_approval_queue=None) -> List[Task]:\n    \"\"\"Gather all eligible tasks from feedback and auto-discovery.\n\n    Shared between Orchestrator and ParallelCoordinator.\n    When config.discovery.adaptive_priority is True, task priorities are\n    boosted based on historical success rates per task type.\n\n    When dashboard_active is True and task_approval_queue is provided and\n    config.orchestrator.task_approval is True:\n    - Feedback tasks are returned immediately (bypass approval gate)\n    - Auto-discovered tasks are enqueued for approval and excluded from return\n    - Previously approved tasks are included in the return list\n    \"\"\"\n    tasks: List[Task] = []\n    approval_active = (\n        dashboard_active\n        and task_approval_queue is not None\n        and getattr(config.orchestrator, 'task_approval', True)\n    )\n\n    # Priority 1: developer feedback (always bypass approval gate)\n    max_retries = config.orchestrator.max_feedback_retries\n    for task in feedback_manager.get_pending_feedback():\n        failure_count = state_manager.get_task_failure_count(\n            task.description, \"feedback\", task_key=task.task_key,\n        )\n        if failure_count >= max_retries:\n            logger.warning(\n                \"Feedback task failed %d times, moving to failed/\",\n                failure_count,\n            )\n            if task.source_file:\n                feedback_manager.mark_failed(task.source_file)\n            continue\n        if not state_manager.was_recently_attempted(\n            task.description, task_key=task.task_key,\n        ):\n            tasks.append(task)\n\n    # Auto-discovered tasks\n    discovered = discovery.discover_all()\n    discovered_eligible = []\n    for task in discovered:\n        if not state_manager.was_recently_attempted(\n            task.description, task_key=task.task_key,\n        ):\n            discovered_eligible.append(task)\n\n    if approval_active:\n        # Enqueue auto-discovered tasks for approval instead of returning them\n        # Exception: test_failure tasks are always safe to attempt (the test\n        # already exists and is already failing), so auto-approve them.\n        cooldown = config.discovery.idea_cooldown_seconds\n        enqueued_count = 0\n        for task in discovered_eligible:\n            if task.source == \"test_failure\":\n                tasks.append(task)\n            else:\n                task_approval_queue.enqueue(task, cooldown_seconds=cooldown)\n                enqueued_count += 1\n\n        # Include previously approved tasks\n        approved = task_approval_queue.get_approved()\n        tasks.extend(approved)\n\n        if enqueued_count and not approved:\n            pending_total = task_approval_queue.pending_count() if hasattr(task_approval_queue, 'pending_count') else enqueued_count\n            logger.info(\n                \"Task approval gate active: %d task(s) pending approval in dashboard, \"\n                \"0 approved. Approve tasks at the dashboard to proceed.\",\n                pending_total,\n            )\n    else:\n        # No approval gate — include all discovered tasks directly\n        tasks.extend(discovered_eligible)\n\n    # Apply adaptive priority: boost tasks of types with high success rates\n    if config.discovery.adaptive_priority and tasks:\n        success_rates = state_manager.get_success_rate_by_type(lookback_seconds=86400)\n        if success_rates:\n            for task in tasks:\n                rate = success_rates.get(task.source)\n                if rate is not None and rate > 0:\n                    # Higher success rate -> lower priority number (higher priority)\n                    # Multiply priority by (1 - rate) to boost high-success types\n                    # e.g., 80% success rate -> priority * 0.2\n                    factor = max(0.1, 1.0 - rate)\n                    task.priority = max(1, int(task.priority * factor))\n\n    # Apply topological sort if any tasks have dependencies\n    if any(t.depends_on for t in tasks):\n        try:\n            tasks = topological_sort_tasks(tasks)\n        except ValueError as e:\n            logger.warning(\"Task dependency cycle: %s\", e)\n            tasks.sort(key=lambda t: t.priority)\n\n    return tasks\n# ------------------------------------------------------------------\n# Commit-message helpers (shared between Orchestrator and Worker)\n# ------------------------------------------------------------------\n\n# Verb prefix applied to the commit subject based on the task source.\n_SOURCE_VERBS = {\n    \"test_failure\": \"Fix\",\n    \"lint\": \"Fix\",\n    \"todo\": None,       # handled by _derive_todo_subject()\n    \"feedback\": None,   # human-written, use as-is\n    \"claude_idea\": None,  # already descriptive, use as-is\n    \"coverage\": \"Add test coverage for\",\n    \"quality\": \"Refactor\",\n}\n\n# Prefixes commonly produced by task_discovery that should be stripped\n_STRIP_PREFIXES = [\n    \"Fix test failure: \",\n    \"Fix test failure in \",\n    \"FAILED \",\n    \"Fix lint error in \",\n    \"Fix lint error: \",\n    \"Address TODO in \",\n    \"Address TODO: \",\n    \"IDEA: \",\n]\n\n\ndef clean_description(desc: str) -> str:\n    \"\"\"Clean an auto-generated task description for use in commit messages.\"\"\"\n    text = desc.strip()\n\n    lower = text.lower()\n    for pfx in _STRIP_PREFIXES:\n        if lower.startswith(pfx.lower()):\n            text = text[len(pfx):]\n            break\n\n    text = text.replace(\"`\", \"\")\n    text = re.sub(r'(\\.\\w+):\\d+(?:-\\d+)?', r'\\1', text)\n    text = text.strip()\n\n    if text:\n        text = text[0].upper() + text[1:]\n\n    return text\n\n\ndef _derive_todo_subject(description: str) -> str:\n    \"\"\"Derive a commit subject from a TODO task description.\"\"\"\n    text = description.strip()\n\n    m = re.match(\n        r'(?:Address\\s+)?TODO\\s+in\\s+'\n        r'([a-zA-Z0-9_/.\\-]+\\.\\w+)'\n        r'(?::\\d+(?:-\\d+)?)?'\n        r':\\s*(.+)',\n        text, re.IGNORECASE,\n    )\n    if m:\n        filepath = m.group(1)\n        action = m.group(2).strip()\n        action = re.sub(r'^(?:FIXME|TODO|XXX)\\s*:?\\s*', '', action, flags=re.IGNORECASE)\n        if action:\n            action = action[0].upper() + action[1:]\n            return f\"{action} in {filepath}\"\n        return f\"Address TODO in {filepath}\"\n\n    cleaned = clean_description(text)\n    return cleaned if cleaned else \"Address TODO\"\n\n\ndef extract_file_names(tasks: List[Task]) -> List[str]:\n    \"\"\"Extract file names mentioned in task descriptions.\"\"\"\n    files = []\n    for t in tasks:\n        m = re.search(\n            r'([a-zA-Z0-9_/.\\-]+\\.(?:py|js|ts|tsx|jsx|go|rs|java|rb|sh|yaml|yml|json|md|txt))',\n            t.description,\n        )\n        if m:\n            fname = m.group(1).split(\"/\")[-1]\n            if fname not in files:\n                files.append(fname)\n    return files\n\n\ndef build_commit_message(task: Task) -> str:\n    \"\"\"Build a conventional, human-style commit message for a single task.\"\"\"\n    cleaned = clean_description(task.description)\n    verb = _SOURCE_VERBS.get(task.source)\n\n    if task.source == \"todo\":\n        subject = _derive_todo_subject(task.description)\n    elif verb is None:\n        subject = cleaned\n    else:\n        if cleaned.lower().startswith(verb.lower()):\n            subject = cleaned\n        else:\n            subject = f\"{verb} {cleaned[0].lower() + cleaned[1:]}\" if cleaned else verb\n\n    if subject:\n        subject = subject[0].upper() + subject[1:]\n\n    if len(subject) > 72:\n        full_subject = subject\n        truncated = subject[:69]\n        last_space = truncated.rfind(\" \")\n        if last_space > 40:\n            truncated = truncated[:last_space]\n        subject = truncated + \"...\"\n        return subject + \"\\n\\n\" + full_subject\n    return subject\n\n\ndef build_batch_commit_message(tasks: List[Task]) -> str:\n    \"\"\"Build a natural commit message summarizing a batch of tasks.\"\"\"\n    sources = set(t.source for t in tasks)\n\n    if len(sources) == 1:\n        source = next(iter(sources))\n        subject = _summarize_same_source(source, tasks)\n    else:\n        subject = _summarize_mixed_sources(sources, tasks)\n\n    if len(subject) > 72:\n        truncated = subject[:69]\n        last_space = truncated.rfind(\" \")\n        if last_space > 40:\n            truncated = truncated[:last_space]\n        subject = truncated + \"...\"\n\n    body_lines = [f\"- {clean_description(t.description)}\" for t in tasks]\n    return subject + \"\\n\\n\" + \"\\n\".join(body_lines)\n\n\ndef _summarize_same_source(source: str, tasks: List[Task]) -> str:\n    \"\"\"Generate a summary subject when all tasks share the same source.\"\"\"\n    count = len(tasks)\n    files = extract_file_names(tasks)\n\n    if source == \"test_failure\":\n        if files and len(files) <= 2:\n            return f\"Fix test failures in {' and '.join(files)}\"\n        return f\"Fix test failures in {count} files\"\n\n    if source == \"lint\":\n        if files and len(files) <= 2:\n            return f\"Fix lint errors in {' and '.join(files)}\"\n        return f\"Fix lint errors in {count} files\"\n\n    if source == \"todo\":\n        return f\"Address TODOs across {count} modules\"\n\n    if source == \"coverage\":\n        return f\"Add test coverage for {count} modules\"\n\n    if source == \"quality\":\n        return f\"Refactor {count} modules\"\n\n    if source == \"claude_idea\":\n        cleaned = clean_description(tasks[0].description)\n        if count > 1:\n            return f\"{cleaned} and {count - 1} more improvements\"\n        return cleaned\n\n    if source == \"feedback\":\n        cleaned = clean_description(tasks[0].description)\n        if count > 1:\n            return f\"{cleaned} and {count - 1} more tasks\"\n        return cleaned\n\n    return f\"Apply {count} changes\"\n\n\ndef _summarize_mixed_sources(sources: set, tasks: List[Task]) -> str:\n    \"\"\"Generate a summary subject for tasks with mixed source types.\"\"\"\n    parts = []\n    source_groups = {}\n    for t in tasks:\n        source_groups.setdefault(t.source, []).append(t)\n\n    for src in [\"test_failure\", \"lint\", \"todo\", \"coverage\", \"quality\",\n                 \"claude_idea\", \"feedback\"]:\n        group = source_groups.get(src)\n        if not group:\n            continue\n        if src == \"test_failure\":\n            parts.append(\"fix test failures\")\n        elif src == \"lint\":\n            parts.append(\"fix lint errors\")\n        elif src == \"todo\":\n            parts.append(\"address TODOs\")\n        elif src == \"coverage\":\n            parts.append(\"add test coverage\")\n        elif src == \"quality\":\n            parts.append(\"refactor\")\n        elif src in (\"claude_idea\", \"feedback\"):\n            parts.append(clean_description(group[0].description).lower())\n\n    file_count = len(set().union(*(set(extract_file_names(source_groups[s]))\n                                   for s in source_groups)))\n    subject_parts = \" and \".join(parts[:2])\n    if len(parts) > 2:\n        subject_parts += f\" and {len(parts) - 2} more\"\n\n    subject = subject_parts[0].upper() + subject_parts[1:] if subject_parts else \"Apply changes\"\n\n    if file_count:\n        subject += f\" in {file_count} files\"\n\n    return subject\n\n\n# ------------------------------------------------------------------\n# Shared prompt builders (used by both Orchestrator and Worker)\n# ------------------------------------------------------------------\n\ndef _working_dir_preamble(working_dir: Optional[str] = None) -> str:\n    \"\"\"Build the working directory preamble for prompts.\n\n    When working_dir is set (worker mode), tells Claude to use absolute paths\n    within that directory and to not modify files outside it.\n    When None (orchestrator mode), uses simpler \"current directory\" phrasing.\n    \"\"\"\n    if working_dir:\n        return (\n            f\"You are working on the project at {working_dir}.\\n\"\n            \"All file reads, writes, and edits MUST use absolute paths within that directory.\\n\"\n            \"WARNING: Do NOT modify any files outside that directory. Do NOT use relative paths.\\n\"\n        )\n    return \"You are working on the project in the current directory.\\n\"\n\n\ndef build_task_prompt(\n    tasks: List[Task],\n    protected_files: List[str],\n    working_dir: Optional[str] = None,\n) -> str:\n    \"\"\"Build a direct execution prompt for one or more tasks.\n\n    Args:\n        tasks: The task(s) to include.\n        protected_files: Files that must not be modified.\n        working_dir: If set, absolute path used in worktree preamble.\n    \"\"\"\n    protected = \", \".join(protected_files)\n    preamble = _working_dir_preamble(working_dir)\n\n    # Build RELEVANT FILES section from file references in tasks\n    relevant = _extract_relevant_files(tasks)\n    relevant_section = \"\"\n    if relevant:\n        lines = \"\\n\".join(f\"- {f}\" for f in relevant)\n        relevant_section = f\"\\nRELEVANT FILES:\\n{lines}\\n\"\n\n    if len(tasks) > 1:\n        task_list = format_task_list(tasks)\n        return (\n            f\"{preamble}\\n\"\n            \"You have been given a batch of tasks to address in a single comprehensive change.\\n\\n\"\n            f\"TASKS:\\n{task_list}\\n\"\n            f\"{relevant_section}\\n\"\n            \"INSTRUCTIONS:\\n\"\n            \"- Make the minimal changes needed to complete ALL tasks above.\\n\"\n            \"- Do NOT run git commands (add, commit, push). The orchestrator handles git.\\n\"\n            f\"- Do NOT modify these protected files: {protected}\\n\"\n            \"- Focus on correctness. Run tests if available.\\n\"\n            \"- If a task is unclear or impossible, make your best effort and explain what you did.\\n\"\n            \"- Use the CONTEXT provided with each task to understand the code and errors involved.\\n\"\n            \"- Make your changes immediately. Do NOT spend turns exploring the codebase — go directly to editing files.\\n\"\n        )\n\n    task = tasks[0]\n    context_section = \"\"\n    if task.context:\n        context_section = f\"\\nCONTEXT:\\n{task.context}\\n\"\n    specific_instructions = TASK_TYPE_INSTRUCTIONS.get(task.source, \"\")\n    return (\n        f\"{preamble}\\n\"\n        f\"TASK: {task.description}\\n\"\n        f\"{context_section}\"\n        f\"{relevant_section}\\n\"\n        \"INSTRUCTIONS:\\n\"\n        \"- Make the minimal changes needed to complete this task.\\n\"\n        \"- Do NOT run git commands (add, commit, push). The orchestrator handles git.\\n\"\n        f\"- Do NOT modify these protected files: {protected}\\n\"\n        \"- Focus on correctness. Run tests if available.\\n\"\n        \"- If the task is unclear or impossible, make your best effort and explain what you did.\\n\"\n        f\"{specific_instructions}\\n\"\n        \"- Make your changes immediately. Do NOT spend turns exploring the codebase — go directly to editing files.\\n\"\n    )\n\n\ndef build_plan_prompt(\n    tasks: List[Task],\n    protected_files: List[str],\n    working_dir: Optional[str] = None,\n) -> str:\n    \"\"\"Build a planning-only prompt (no file changes).\n\n    Args:\n        tasks: The task(s) to plan for.\n        protected_files: Files that must not be modified.\n        working_dir: If set, absolute path used in worktree preamble.\n    \"\"\"\n    protected = \", \".join(protected_files)\n    preamble = _working_dir_preamble(working_dir)\n\n    if len(tasks) > 1:\n        task_list = format_task_list(tasks)\n        task_count = len(tasks) + 1\n        task_count_plus1 = len(tasks) + 2\n        return (\n            f\"{preamble}\\n\"\n            \"You have been given a batch of tasks to address in a single comprehensive change.\\n\\n\"\n            f\"TASKS:\\n{task_list}\\n\\n\"\n            f\"ADDITIONAL CHECKS (always perform these):\\n\"\n            f\"{task_count}. Check whether any of the above changes require NEW tests to be added. \"\n            \"If new functionality is introduced or existing behavior is changed, plan to add or update tests.\\n\"\n            f\"{task_count_plus1}. Check whether README.md needs updating to reflect any of the above changes. \"\n            \"If user-facing behavior, configuration options, or architecture changed, plan to update README.md.\\n\\n\"\n            \"INSTRUCTIONS:\\n\"\n            \"- Analyze the codebase and create a detailed, comprehensive plan that addresses ALL tasks above.\\n\"\n            \"- Do NOT make any changes yet. Only output a plan.\\n\"\n            \"- List every file you would modify and what changes you would make in each.\\n\"\n            f\"- Do NOT modify these protected files: {protected}\\n\"\n            \"- Be specific about the changes (function names, line numbers, etc.).\\n\"\n            \"- Group related changes together where possible for clarity.\\n\"\n            \"- Address the tasks in priority order but look for opportunities to combine related changes.\\n\"\n            \"- Use the CONTEXT provided with each task to understand the code and errors involved.\\n\"\n            \"- Output your complete plan within 5 turns. Do NOT spend turns reading files — focus on producing the plan.\\n\"\n        )\n\n    task = tasks[0]\n    context_section = \"\"\n    if task.context:\n        context_section = f\"\\nCONTEXT:\\n{task.context}\\n\"\n    specific_instructions = TASK_TYPE_INSTRUCTIONS.get(task.source, \"\")\n    return (\n        f\"{preamble}\\n\"\n        f\"TASK: {task.description}\\n\"\n        f\"{context_section}\\n\"\n        \"INSTRUCTIONS:\\n\"\n        \"- Analyze the codebase and create a detailed plan to complete this task.\\n\"\n        \"- Do NOT make any changes yet. Only output a plan.\\n\"\n        \"- List the files you would modify and what changes you would make.\\n\"\n        f\"- Do NOT modify these protected files: {protected}\\n\"\n        \"- Be specific about the changes (function names, line numbers, etc.).\\n\"\n        f\"{specific_instructions}\\n\"\n        \"- Output your complete plan within 5 turns. Do NOT spend turns reading files — focus on producing the plan.\\n\"\n    )\n\n\ndef build_execute_prompt(\n    tasks: List[Task],\n    plan_text: str,\n    protected_files: List[str],\n    working_dir: Optional[str] = None,\n) -> str:\n    \"\"\"Build an execution prompt that includes a pre-made plan.\n\n    Args:\n        tasks: The task(s) to execute.\n        plan_text: The plan generated by the planning phase.\n        protected_files: Files that must not be modified.\n        working_dir: If set, absolute path used in worktree preamble.\n    \"\"\"\n    protected = \", \".join(protected_files)\n    preamble = _working_dir_preamble(working_dir)\n\n    if len(tasks) > 1:\n        task_list = format_task_list(tasks)\n        return (\n            f\"{preamble}\\n\"\n            \"You have been given a batch of tasks to address in a single comprehensive change.\\n\\n\"\n            f\"TASKS:\\n{task_list}\\n\\n\"\n            f\"PLAN TO EXECUTE:\\n{plan_text}\\n\\n\"\n            \"INSTRUCTIONS:\\n\"\n            \"- Execute the plan above by making ALL described changes.\\n\"\n            \"- Do NOT run git commands (add, commit, push). The orchestrator handles git.\\n\"\n            f\"- Do NOT modify these protected files: {protected}\\n\"\n            \"- Focus on correctness. Run tests after making changes.\\n\"\n            \"- Stick to the plan. Do not deviate unless the plan has an obvious error.\\n\"\n            \"- Make ALL changes in this single session. This is a comprehensive revamp, not incremental.\\n\"\n            \"- Use the CONTEXT provided with each task to understand the code and errors involved.\\n\"\n            \"- Make your changes immediately. Do NOT spend turns exploring the codebase — go directly to editing files.\\n\"\n        )\n\n    task = tasks[0]\n    context_section = \"\"\n    if task.context:\n        context_section = f\"\\nCONTEXT:\\n{task.context}\\n\"\n    specific_instructions = TASK_TYPE_INSTRUCTIONS.get(task.source, \"\")\n    return (\n        f\"{preamble}\\n\"\n        f\"TASK: {task.description}\\n\"\n        f\"{context_section}\\n\"\n        f\"PLAN TO EXECUTE:\\n{plan_text}\\n\\n\"\n        \"INSTRUCTIONS:\\n\"\n        \"- Execute the plan above by making the described changes.\\n\"\n        \"- Do NOT run git commands (add, commit, push). The orchestrator handles git.\\n\"\n        f\"- Do NOT modify these protected files: {protected}\\n\"\n        \"- Focus on correctness. Run tests if available.\\n\"\n        \"- Stick to the plan. Do not deviate unless the plan has an obvious error.\\n\"\n        f\"{specific_instructions}\\n\"\n        \"- Make your changes immediately. Do NOT spend turns exploring the codebase — go directly to editing files.\\n\"\n    )\n\n\n_COMMON_FAILURE_PATTERNS: Dict[str, str] = {\n    \"test_failure\": (\n        \"- Wrong assertion value or outdated expected result\\n\"\n        \"- Missing import in the module under test\\n\"\n        \"- Function signature changed but callers not updated\\n\"\n        \"- Fixture or mock not matching new behavior\\n\"\n        \"- Off-by-one errors in boundary conditions\"\n    ),\n    \"lint\": (\n        \"- Unused import not removed after refactoring\\n\"\n        \"- Line too long (exceeds configured max length)\\n\"\n        \"- Trailing whitespace or missing newline at end of file\\n\"\n        \"- Variable assigned but never used\\n\"\n        \"- Wrong import order (stdlib vs third-party vs local)\"\n    ),\n    \"todo\": (\n        \"- Implementation incomplete — only part of the TODO was addressed\\n\"\n        \"- New code introduced a test regression\\n\"\n        \"- Missing error handling for edge cases mentioned in the TODO\"\n    ),\n    \"quality\": (\n        \"- Refactoring changed behavior instead of just restructuring\\n\"\n        \"- Extracted function has wrong parameter list or return value\\n\"\n        \"- Existing tests rely on the old structure\"\n    ),\n    \"coverage\": (\n        \"- New test imports the wrong module or function name\\n\"\n        \"- Test assertions don't match actual function behavior\\n\"\n        \"- Missing test fixtures or setup for the code under test\"\n    ),\n    \"claude_idea\": (\n        \"- Change scope was too broad — unrelated code was affected\\n\"\n        \"- New code conflicts with existing patterns or conventions\\n\"\n        \"- Missing edge case handling that existing tests exercise\"\n    ),\n}\n\n\ndef _common_failure_patterns(tasks: List[Task]) -> str:\n    \"\"\"Return a COMMON FAILURE PATTERNS section based on task types.\"\"\"\n    sources = {t.source for t in tasks if t.source}\n    tips = []\n    for source in sorted(sources):\n        patterns = _COMMON_FAILURE_PATTERNS.get(source)\n        if patterns:\n            tips.append(f\"For {source} tasks:\\n{patterns}\")\n    if not tips:\n        return \"\"\n    return \"COMMON FAILURE PATTERNS:\\n\" + \"\\n\".join(tips) + \"\\n\"\n\n\ndef build_retry_prompt(\n    tasks: List[Task],\n    failure_output: str,\n    protected_files: List[str],\n    working_dir: Optional[str] = None,\n    attempt: int = 0,\n    max_attempts: int = 0,\n) -> str:\n    \"\"\"Build a retry prompt with validation failure output.\n\n    Args:\n        tasks: The task(s) being retried.\n        failure_output: The validation failure output.\n        protected_files: Files that must not be modified.\n        working_dir: If set, absolute path used in worktree preamble.\n        attempt: Current attempt number (for orchestrator-style formatting).\n        max_attempts: Total max attempts (for orchestrator-style formatting).\n    \"\"\"\n    protected = \", \".join(protected_files)\n    preamble = _working_dir_preamble(working_dir)\n\n    # Truncate failure output to avoid exceeding prompt limits\n    max_output = 8000\n    if len(failure_output) > max_output:\n        failure_output = failure_output[:max_output] + \"\\n... (truncated)\"\n\n    if len(tasks) > 1:\n        task_list = format_task_list(tasks)\n        task_section = f\"TASKS:\\n{task_list}\"\n    else:\n        task_section = f\"TASK: {tasks[0].description}\"\n\n    attempt_info = \"\"\n    if attempt and max_attempts:\n        attempt_info = f\" (attempt {attempt} of {max_attempts})\"\n\n    return (\n        f\"{preamble}\\n\"\n        f\"ORIGINAL {task_section}\\n\\n\"\n        f\"YOUR PREVIOUS CHANGES FAILED VALIDATION{attempt_info}.\\n\\n\"\n        f\"VALIDATION FAILURES:\\n\"\n        f\"```\\n{failure_output}\\n```\\n\\n\"\n        \"INSTRUCTIONS:\\n\"\n        \"- Read the failure output above carefully.\\n\"\n        \"- Determine whether the bug is in the code you changed or in the tests.\\n\"\n        \"  Sometimes the test expectation is wrong (e.g., wrong return value asserted).\\n\"\n        \"  Other times the implementation has the actual bug.\\n\"\n        \"- Fix whichever side is wrong. You may fix the code, fix the tests, or both.\\n\"\n        \"- Do NOT run git commands (add, commit, push). The orchestrator handles git.\\n\"\n        f\"- Do NOT modify these protected files: {protected}\\n\"\n        \"- Your previous changes are still in the working tree. Build on them, do not start over.\\n\"\n        \"- Focus on making ALL validations pass.\\n\\n\"\n        f\"{_common_failure_patterns(tasks)}\"\n    )\n","numLines":789,"startLine":1,"totalLines":789}}}
