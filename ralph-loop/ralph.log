{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_vrtx_01TysjiovsJ7gJ6tLg2WHE7K","type":"tool_result","content":"     1→\"\"\"Session recovery: save/restore orchestrator state across crashes.\"\"\"\n     2→\n     3→from __future__ import annotations\n     4→\n     5→import json\n     6→import logging\n     7→import os\n     8→import subprocess\n     9→import tempfile\n    10→import time\n    11→from dataclasses import dataclass, field, asdict\n    12→from pathlib import Path\n    13→from typing import Any, Dict, List, Optional\n    14→\n    15→logger = logging.getLogger(__name__)\n    16→\n    17→SESSION_FILE = \"session.json\"\n    18→\n    19→\n    20→@dataclass\n    21→class SessionState:\n    22→    \"\"\"Persistent session state for crash recovery.\"\"\"\n    23→    session_id: str\n    24→    started_at: float\n    25→    tasks: List[Dict[str, Any]] = field(default_factory=list)\n    26→    completed_task_ids: List[str] = field(default_factory=list)\n    27→    worker_states: Dict[int, Dict] = field(default_factory=dict)\n    28→    total_cost_usd: float = 0.0\n    29→    phase: str = \"starting\"\n    30→\n    31→    def to_dict(self) -> Dict[str, Any]:\n    32→        return asdict(self)\n    33→\n    34→    @classmethod\n    35→    def from_dict(cls, data: Dict[str, Any]) -> SessionState:\n    36→        return cls(\n    37→            session_id=data.get(\"session_id\", \"\"),\n    38→            started_at=data.get(\"started_at\", 0.0),\n    39→            tasks=data.get(\"tasks\", []),\n    40→            completed_task_ids=data.get(\"completed_task_ids\", []),\n    41→            worker_states={int(k): v for k, v in data.get(\"worker_states\", {}).items()},\n    42→            total_cost_usd=data.get(\"total_cost_usd\", 0.0),\n    43→            phase=data.get(\"phase\", \"starting\"),\n    44→        )\n    45→\n    46→\n    47→class SessionManager:\n    48→    \"\"\"Manages session persistence for crash recovery.\n    49→\n    50→    Writes session state atomically to disk at key checkpoints so that\n    51→    the orchestrator can resume after a crash without losing progress.\n    52→    \"\"\"\n    53→\n    54→    def __init__(self, state_dir: str):\n    55→        self._state_dir = Path(state_dir)\n    56→        self._state_dir.mkdir(parents=True, exist_ok=True)\n    57→        self._session_path = self._state_dir / SESSION_FILE\n    58→\n    59→    def save_session(self, state: SessionState) -> None:\n    60→        \"\"\"Atomically save session state to disk.\"\"\"\n    61→        data = state.to_dict()\n    62→        try:\n    63→            fd, tmp_path = tempfile.mkstemp(\n    64→                dir=str(self._state_dir), suffix=\".tmp\",\n    65→            )\n    66→            try:\n    67→                with os.fdopen(fd, \"w\") as f:\n    68→                    json.dump(data, f, indent=2)\n    69→                os.replace(tmp_path, str(self._session_path))\n    70→            except Exception:\n    71→                try:\n    72→                    os.unlink(tmp_path)\n    73→                except OSError:\n    74→                    pass\n    75→                raise\n    76→        except OSError as e:\n    77→            logger.warning(\"Failed to save session state: %s\", e)\n    78→\n    79→    def load_session(self) -> Optional[SessionState]:\n    80→        \"\"\"Load session state from disk. Returns None if no session exists.\"\"\"\n    81→        if not self._session_path.exists():\n    82→            return None\n    83→        try:\n    84→            with open(self._session_path, \"r\") as f:\n    85→                data = json.load(f)\n    86→            if not isinstance(data, dict):\n    87→                return None\n    88→            return SessionState.from_dict(data)\n    89→        except (json.JSONDecodeError, OSError) as e:\n    90→            logger.warning(\"Failed to load session state: %s\", e)\n    91→            return None\n    92→\n    93→    def clear_session(self) -> None:\n    94→        \"\"\"Remove the session file (called on clean completion).\"\"\"\n    95→        try:\n    96→            if self._session_path.exists():\n    97→                self._session_path.unlink()\n    98→        except OSError as e:\n    99→            logger.warning(\"Failed to clear session state: %s\", e)\n   100→\n   101→    def has_incomplete_session(self) -> bool:\n   102→        \"\"\"Check if there's an incomplete session from a previous run.\"\"\"\n   103→        state = self.load_session()\n   104→        if state is None:\n   105→            return False\n   106→        # A session is incomplete if it has tasks but not all are completed\n   107→        if not state.tasks:\n   108→            return False\n   109→        task_ids = {t.get(\"task_id\", t.get(\"task_key\", \"\")) for t in state.tasks}\n   110→        completed = set(state.completed_task_ids)\n   111→        return not task_ids.issubset(completed)\n   112→\n   113→    def recover_orphaned_worktrees(self, repo_dir: str) -> List[Dict]:\n   114→        \"\"\"Detect and list orphaned worktrees from a crashed session.\n   115→\n   116→        Returns a list of dicts with worktree info (path, branch).\n   117→        \"\"\"\n   118→        orphaned = []\n   119→        try:\n   120→            result = subprocess.run(\n   121→                [\"git\", \"worktree\", \"list\", \"--porcelain\"],\n   122→                cwd=repo_dir,\n   123→                capture_output=True,\n   124→                text=True,\n   125→                timeout=30,\n   126→            )\n   127→            if result.returncode != 0:\n   128→                return orphaned\n   129→\n   130→            current_worktree: Dict[str, str] = {}\n   131→            for line in result.stdout.splitlines():\n   132→                line = line.strip()\n   133→                if not line:\n   134→                    if current_worktree and current_worktree.get(\"branch\", \"\").startswith(\"auto-claude/\"):\n   135→                        orphaned.append(current_worktree)\n   136→                    current_worktree = {}\n   137→                    continue\n   138→                if line.startswith(\"worktree \"):\n   139→                    current_worktree[\"path\"] = line[len(\"worktree \"):]\n   140→                elif line.startswith(\"branch \"):\n   141→                    branch = line[len(\"branch \"):]\n   142→                    # Strip refs/heads/ prefix\n   143→                    if branch.startswith(\"refs/heads/\"):\n   144→                        branch = branch[len(\"refs/heads/\"):]\n   145→                    current_worktree[\"branch\"] = branch\n   146→\n   147→            # Don't forget the last entry\n   148→            if current_worktree and current_worktree.get(\"branch\", \"\").startswith(\"auto-claude/\"):\n   149→                orphaned.append(current_worktree)\n   150→\n   151→        except (subprocess.TimeoutExpired, OSError) as e:\n   152→            logger.warning(\"Failed to list worktrees: %s\", e)\n   153→\n   154→        return orphaned\n   155→\n   156→    def create_session_id(self) -> str:\n   157→        \"\"\"Generate a unique session ID.\"\"\"\n   158→        return f\"session-{int(time.time())}-{os.getpid()}\"\n   159→"}]},"parent_tool_use_id":null,"session_id":"640b52e8-d739-4f76-a84a-7189ed2a386a","uuid":"1436d4b5-6b80-4dfe-a261-aa2a8591386a","tool_use_result":{"type":"text","file":{"filePath":"/Users/sameertkhanna/Documents/auto_claude_code/session_manager.py","content":"\"\"\"Session recovery: save/restore orchestrator state across crashes.\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport logging\nimport os\nimport subprocess\nimport tempfile\nimport time\nfrom dataclasses import dataclass, field, asdict\nfrom pathlib import Path\nfrom typing import Any, Dict, List, Optional\n\nlogger = logging.getLogger(__name__)\n\nSESSION_FILE = \"session.json\"\n\n\n@dataclass\nclass SessionState:\n    \"\"\"Persistent session state for crash recovery.\"\"\"\n    session_id: str\n    started_at: float\n    tasks: List[Dict[str, Any]] = field(default_factory=list)\n    completed_task_ids: List[str] = field(default_factory=list)\n    worker_states: Dict[int, Dict] = field(default_factory=dict)\n    total_cost_usd: float = 0.0\n    phase: str = \"starting\"\n\n    def to_dict(self) -> Dict[str, Any]:\n        return asdict(self)\n\n    @classmethod\n    def from_dict(cls, data: Dict[str, Any]) -> SessionState:\n        return cls(\n            session_id=data.get(\"session_id\", \"\"),\n            started_at=data.get(\"started_at\", 0.0),\n            tasks=data.get(\"tasks\", []),\n            completed_task_ids=data.get(\"completed_task_ids\", []),\n            worker_states={int(k): v for k, v in data.get(\"worker_states\", {}).items()},\n            total_cost_usd=data.get(\"total_cost_usd\", 0.0),\n            phase=data.get(\"phase\", \"starting\"),\n        )\n\n\nclass SessionManager:\n    \"\"\"Manages session persistence for crash recovery.\n\n    Writes session state atomically to disk at key checkpoints so that\n    the orchestrator can resume after a crash without losing progress.\n    \"\"\"\n\n    def __init__(self, state_dir: str):\n        self._state_dir = Path(state_dir)\n        self._state_dir.mkdir(parents=True, exist_ok=True)\n        self._session_path = self._state_dir / SESSION_FILE\n\n    def save_session(self, state: SessionState) -> None:\n        \"\"\"Atomically save session state to disk.\"\"\"\n        data = state.to_dict()\n        try:\n            fd, tmp_path = tempfile.mkstemp(\n                dir=str(self._state_dir), suffix=\".tmp\",\n            )\n            try:\n                with os.fdopen(fd, \"w\") as f:\n                    json.dump(data, f, indent=2)\n                os.replace(tmp_path, str(self._session_path))\n            except Exception:\n                try:\n                    os.unlink(tmp_path)\n                except OSError:\n                    pass\n                raise\n        except OSError as e:\n            logger.warning(\"Failed to save session state: %s\", e)\n\n    def load_session(self) -> Optional[SessionState]:\n        \"\"\"Load session state from disk. Returns None if no session exists.\"\"\"\n        if not self._session_path.exists():\n            return None\n        try:\n            with open(self._session_path, \"r\") as f:\n                data = json.load(f)\n            if not isinstance(data, dict):\n                return None\n            return SessionState.from_dict(data)\n        except (json.JSONDecodeError, OSError) as e:\n            logger.warning(\"Failed to load session state: %s\", e)\n            return None\n\n    def clear_session(self) -> None:\n        \"\"\"Remove the session file (called on clean completion).\"\"\"\n        try:\n            if self._session_path.exists():\n                self._session_path.unlink()\n        except OSError as e:\n            logger.warning(\"Failed to clear session state: %s\", e)\n\n    def has_incomplete_session(self) -> bool:\n        \"\"\"Check if there's an incomplete session from a previous run.\"\"\"\n        state = self.load_session()\n        if state is None:\n            return False\n        # A session is incomplete if it has tasks but not all are completed\n        if not state.tasks:\n            return False\n        task_ids = {t.get(\"task_id\", t.get(\"task_key\", \"\")) for t in state.tasks}\n        completed = set(state.completed_task_ids)\n        return not task_ids.issubset(completed)\n\n    def recover_orphaned_worktrees(self, repo_dir: str) -> List[Dict]:\n        \"\"\"Detect and list orphaned worktrees from a crashed session.\n\n        Returns a list of dicts with worktree info (path, branch).\n        \"\"\"\n        orphaned = []\n        try:\n            result = subprocess.run(\n                [\"git\", \"worktree\", \"list\", \"--porcelain\"],\n                cwd=repo_dir,\n                capture_output=True,\n                text=True,\n                timeout=30,\n            )\n            if result.returncode != 0:\n                return orphaned\n\n            current_worktree: Dict[str, str] = {}\n            for line in result.stdout.splitlines():\n                line = line.strip()\n                if not line:\n                    if current_worktree and current_worktree.get(\"branch\", \"\").startswith(\"auto-claude/\"):\n                        orphaned.append(current_worktree)\n                    current_worktree = {}\n                    continue\n                if line.startswith(\"worktree \"):\n                    current_worktree[\"path\"] = line[len(\"worktree \"):]\n                elif line.startswith(\"branch \"):\n                    branch = line[len(\"branch \"):]\n                    # Strip refs/heads/ prefix\n                    if branch.startswith(\"refs/heads/\"):\n                        branch = branch[len(\"refs/heads/\"):]\n                    current_worktree[\"branch\"] = branch\n\n            # Don't forget the last entry\n            if current_worktree and current_worktree.get(\"branch\", \"\").startswith(\"auto-claude/\"):\n                orphaned.append(current_worktree)\n\n        except (subprocess.TimeoutExpired, OSError) as e:\n            logger.warning(\"Failed to list worktrees: %s\", e)\n\n        return orphaned\n\n    def create_session_id(self) -> str:\n        \"\"\"Generate a unique session ID.\"\"\"\n        return f\"session-{int(time.time())}-{os.getpid()}\"\n","numLines":159,"startLine":1,"totalLines":159}}}
